                                        <i class="bx bx-money"></i>
                                        <span key="t-financial">Cấu hình Tài chính</span>
                                    </a>
                                </li>

                                <li>
                                    <a href="javascript: void(0);" class="has-arrow waves-effect">
                                        <i class="bx bx-list-ul"></i>
                                        <span key="t-attributes">Quản lý thuộc tính</span>
                                    </a>
                                    <ul class="sub-menu" aria-expanded="false">
                                        <li><a asp-area="Admin" asp-controller="Categories" asp-action="Index">Danh mục sản phẩm</a></li>
                                        <li><a asp-area="Admin" asp-controller="Colors" asp-action="Index">Màu sắc</a></li>
                                        <li><a asp-area="Admin" asp-controller="Sizes" asp-action="Index">Kích thước</a></li>
                                    </ul>
                                </li>
                            }

                            <li>
                                <a href="javascript: void(0);" class="has-arrow waves-effect">
                                    <i class="bx bx-detail"></i>
                                    <span key="t-blog">Quản lý Blog</span>
                                </a>
                                <ul class="sub-menu" aria-expanded="false">
                                    <li><a asp-area="Admin" asp-controller="Blog" asp-action="Index" key="t-blog-list">Danh sách bài viết</a></li>
                                    <li><a asp-area="Admin" asp-controller="Blog" asp-action="Create" key="t-add-post">Viết bài mới</a></li>
                                </ul>
                            </li>
                            
                             <li>
                                <a href="javascript: void(0);" class="has-arrow waves-effect">
                                    <i class="bx bxs-bar-chart-alt-2"></i>
                                    <span key="t-charts">Thống kê Chuyên sâu</span>
                                </a>
                                <ul class="sub-menu" aria-expanded="false">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a asp-area="Admin" asp-controller="SystemStatistics" asp-action="Admin">Phân tích Hệ thống (Admin)</a></li>
                                        <li><a asp-area="Admin" asp-controller="SystemStatistics" asp-action="FinancialReport">Báo cáo Tài chính</a></li>
                                    }
                                    @if (User.IsInRole("Shop"))
                                    {
                                        <li><a asp-area="Admin" asp-controller="SystemStatistics" asp-action="Seller">Phân tích Cửa hàng (Shop)</a></li>
                                        <li><a asp-area="Admin" asp-controller="SystemStatistics" asp-action="ProfitCalculator">Máy tính Lợi nhuận</a></li>
                                    }
                                </ul>
                            </li>
                        </ul>
                    </div>
                    <!-- Sidebar -->

                    <div class="mt-auto p-3 border-top">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light w-100 waves-effect waves-light">
                            <i class="bx bx-arrow-back font-size-16 align-middle me-2"></i>
                            <span>Quay lại trang người dùng</span>
                        </a>
                    </div>

                    </div>
                </div>
            </div>
            <!-- Left Sidebar End -->

            

            <!-- ============================================================== -->
            <!-- Start right Content here -->
            <!-- ============================================================== -->
            <div class="main-content">

                <div class="page-content">
                    <div class="container-fluid">
                        @RenderSection("AdminTopNotice", required: false)
                        
                        @if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
                        {
                            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                                <i class="bx bx-check-circle me-2 font-size-16 align-middle"></i>
                                @toast
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        
                        @if (TempData["AdminError"] is string error && !string.IsNullOrWhiteSpace(error))
                        {
                            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                                <i class="bx bx-error-circle me-2 font-size-16 align-middle"></i>
                                @error
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @RenderBody()

                    </div>
                </div>

            </div>

        </div>
        <!-- END layout-wrapper -->

        <!-- Right Sidebar -->
        <div class="right-bar">
            <div data-simplebar class="h-100">
                <div class="rightbar-title d-flex align-items-center px-3 py-4">
            
                    <h5 class="m-0 me-2">Settings</h5>

                    <a href="javascript:void(0);" class="right-bar-toggle ms-auto">
                        <i class="mdi mdi-close noti-icon"></i>
                    </a>
                </div>

                <!-- Settings -->
                <hr class="mt-0" />
                <h6 class="text-center mb-0">Choose Layouts</h6>

                <div class="p-4">
                    <div class="mb-2">
                        <img src="~/admin/assets/images/layouts/layout-1.jpg" class="img-thumbnail" alt="layout images">
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input theme-choice" type="checkbox" id="light-mode-switch" checked>
                        <label class="form-check-label" for="light-mode-switch">Light Mode</label>
                    </div>
    
                    <div class="mb-2">
                        <img src="~/admin/assets/images/layouts/layout-2.jpg" class="img-thumbnail" alt="layout images">
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input theme-choice" type="checkbox" id="dark-mode-switch">
                        <label class="form-check-label" for="dark-mode-switch">Dark Mode</label>
                    </div>
    
                    <div class="mb-2">
                        <img src="~/admin/assets/images/layouts/layout-3.jpg" class="img-thumbnail" alt="layout images">
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input theme-choice" type="checkbox" id="rtl-mode-switch">
                        <label class="form-check-label" for="rtl-mode-switch">RTL Mode</label>
                    </div>

                    <div class="mb-2">
                        <img src="~/admin/assets/images/layouts/layout-4.jpg" class="img-thumbnail" alt="layout images">
                    </div>
                    <div class="form-check form-switch mb-5">
                        <input class="form-check-input theme-choice" type="checkbox" id="dark-rtl-mode-switch">
                        <label class="form-check-label" for="dark-rtl-mode-switch">Dark RTL Mode</label>
                    </div>

            
                </div>

            </div> <!-- end slimscroll-menu-->
        </div>
        <!-- /Right-bar -->

        <!-- Right bar overlay-->
        <div class="rightbar-overlay"></div>

        <!-- JAVASCRIPT -->
        <script src="/admin/assets/libs/jquery/jquery.min.js"></script>
        <script src="/admin/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
        <script src="/admin/assets/libs/metismenu/metisMenu.min.js"></script>
        <script src="/admin/assets/libs/simplebar/simplebar.min.js"></script>
        <script src="/admin/assets/libs/node-waves/waves.min.js"></script>

        <!-- apexcharts -->
        <script src="/admin/assets/libs/apexcharts/apexcharts.min.js"></script>

        <!-- dashboard init -->
        <script src="/admin/assets/js/pages/dashboard.init.js"></script>

        <!-- App js -->
        <script src="/admin/assets/js/app.js"></script>

        <script>
            (function () {
                function normalizeUrl(url) {
                    if (!url) return url;
                    if (url.startsWith("assets/")) return "/" + url;
                    return url;
                }

                var bootstrapLink = document.getElementById("bootstrap-style");
                if (bootstrapLink) {
                    bootstrapLink.setAttribute("href", normalizeUrl(bootstrapLink.getAttribute("href")));
                }

                var appLink = document.getElementById("app-style");
                if (appLink) {
                    appLink.setAttribute("href", normalizeUrl(appLink.getAttribute("href")));
                }

                var headerLangImg = document.getElementById("header-lang-img");
                if (headerLangImg) {
                    headerLangImg.setAttribute("src", normalizeUrl(headerLangImg.getAttribute("src")));
                }
            })();
        </script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>