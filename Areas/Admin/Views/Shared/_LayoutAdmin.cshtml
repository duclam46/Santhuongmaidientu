                <div class="navbar-header">
                    <div class="d-flex align-items-center">
                        <!-- LOGO -->
                        <div class="navbar-brand-box">
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="logo logo-dark">
                                <span class="logo-sm">
