<!doctype html>
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject DOAN_BANHANG.Models.DataContext _db
@{
    var accountIdClaim = User.FindFirst("AccountId")?.Value ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(accountIdClaim, out var accId);
    var currentAccount = _db.Accounts.Include(a => a.Profile).FirstOrDefault(a => a.Id == accId);
    var displayName = currentAccount?.Profile?.ShopName ?? currentAccount?.Profile?.FullName ?? currentAccount?.Email ?? "Tài khoản";
    var avatarUrl = currentAccount?.Profile?.ShopLogoUrl ?? currentAccount?.Profile?.AvatarUrl ?? "/admin/assets/images/users/avatar-1.jpg";
    var isAdmin = User.IsInRole("Admin");
    var isShop = User.IsInRole("Shop");
}
<html lang="vi">

    <head>
        
        <meta charset="utf-8" />
        <title>Sellzy | @(ViewData["Title"] ?? "Trang chủ")</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta content="Hệ thống quản trị và kênh người bán Sellzy" name="description" />
        <meta content="Sellzy" name="author" />
        <!-- App favicon -->
        <link rel="shortcut icon" href="~/assets/images/favicon.png">

        <!-- Google Fonts Vietnamese -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

        <!-- Bootstrap Css -->
        <link href="/admin/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" />
        <!-- Icons Css -->
        <link href="/admin/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
        <!-- App Css-->
        <link href="/admin/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" />

        <style>
            :root {
                --sz-teal: #088178;
                --sz-teal-dark: #00262A;
                --sz-teal-mid: #04464C;
                --sz-gold: #FFEB69;
            }
            body {
                font-family: "Be Vietnam Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
                background-color: #F4F7F9 !important;
            }
