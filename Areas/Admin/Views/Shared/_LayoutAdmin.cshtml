        <script>
            (function () {
                function normalizeAdminAssetUrl(url) {
                    if (typeof url !== "string") return url;
                    if (url.startsWith("assets/")) return "/admin/" + url;
                    return url;
                }

                var originalSetAttribute = Element.prototype.setAttribute;
                Element.prototype.setAttribute = function (name, value) {
                    if ((name === "href" || name === "src") && typeof value === "string") {
                        value = normalizeAdminAssetUrl(value);
                    }
                    return originalSetAttribute.call(this, name, value);
                };

                function wrapProtoSetter(proto, propName) {
                    try {
                        var desc = Object.getOwnPropertyDescriptor(proto, propName);
                        if (!desc || !desc.set) return;

                        Object.defineProperty(proto, propName, {
                            get: desc.get,
                            set: function (value) {
                                return desc.set.call(this, normalizeAdminAssetUrl(value));
                            }
                        });
                    } catch (e) {
                        // ignore
                    }
                }

                if (typeof HTMLImageElement !== "undefined") wrapProtoSetter(HTMLImageElement.prototype, "src");
                if (typeof HTMLScriptElement !== "undefined") wrapProtoSetter(HTMLScriptElement.prototype, "src");
                if (typeof HTMLLinkElement !== "undefined") wrapProtoSetter(HTMLLinkElement.prototype, "href");

                if (window.jQuery && typeof window.jQuery.ajaxPrefilter === "function") {
                    window.jQuery.ajaxPrefilter(function (options) {
                        if (options && options.url) {
                            options.url = normalizeAdminAssetUrl(options.url);
                        }
                    });
                }
            })();
        </script>

