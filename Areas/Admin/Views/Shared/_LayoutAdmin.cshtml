                                </span>
                                <span class="logo-lg">
                                    <img src="~/assets/images/logo.png" alt="Sellzy" height="32">
                                </span>
                            </a>

                            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="logo logo-light">
                                <span class="logo-sm">
                                    <img src="/admin/assets/images/logo-light.svg" alt="Sellzy" height="22">
                                </span>
                                <span class="logo-lg">
                                    <img src="~/assets/images/logo.png" alt="Sellzy" height="32" style="filter: brightness(0) invert(1);">
                                </span>
                            </a>
                        </div>

                        <button type="button" class="btn btn-sm px-3 font-size-16 header-item waves-effect" id="vertical-menu-btn">
                            <i class="fa fa-fw fa-bars"></i>
                        </button>

                        <div class="d-none d-md-inline-flex align-items-center ms-2">
                            @if (isAdmin)
                            {
                                <span class="sz-role-badge is-admin">
