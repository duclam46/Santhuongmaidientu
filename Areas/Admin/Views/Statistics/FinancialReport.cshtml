@model DOAN_BANHANG.ViewModels.FinancialReportViewModel
@{
    ViewData["Title"] = "Báo cáo Tài chính Hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .card-revenue {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: white;
    }
    .card-commission {
        background: linear-gradient(135deg, #00b894 0%, #00d2c6 100%);
        color: white;
    }
    .card-tax {
        background: linear-gradient(135deg, #ff7675 0%, #d63031 100%);
        color: white;
    }
    .table-hover tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.02);
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Báo cáo Tài chính & Quyết toán Shop</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Thống kê</a></li>
                    <li class="breadcrumb-item active">Báo cáo Tài chính</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Summary Widgets -->
<div class="row">
    <div class="col-md-3">
        <div class="card card-revenue mini-stats-wid">
            <div class="card-body">
                <div class="d-flex">
                    <div class="flex-grow-1">
                        <p class="text-white-50 fw-medium">Tổng doanh thu (Gross)</p>
                        <h4 class="mb-0 text-white">@string.Format("{0:N0} ₫", Model.TotalGrossRevenue)</h4>
                    </div>
                    <div class="flex-shrink-0 align-self-center">
                        <div class="mini-stat-icon avatar-sm rounded-circle bg-white bg-opacity-25">
                            <span class="avatar-title">
                                <i class="bx bx-dollar font-size-24"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-white-50">@Model.TotalOrders đơn hàng thành công</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-commission mini-stats-wid">
            <div class="card-body">
                <div class="d-flex">
                    <div class="flex-grow-1">
                        <p class="text-white-50 fw-medium">Lợi nhuận Hệ thống (Commission)</p>
                        <h4 class="mb-0 text-white">@string.Format("{0:N0} ₫", Model.TotalCommission)</h4>
                    </div>
                    <div class="flex-shrink-0 align-self-center">
                        <div class="mini-stat-icon avatar-sm rounded-circle bg-white bg-opacity-25">
                            <span class="avatar-title">
                                <i class="bx bx-spreadsheet font-size-24"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-white-50">Chiết khấu 10% - 12% theo ngành</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-tax mini-stats-wid">
            <div class="card-body">
                <div class="d-flex">
                    <div class="flex-grow-1">
                        <p class="text-white-50 fw-medium">Thuế VAT thu hộ</p>
                        <h4 class="mb-0 text-white">@string.Format("{0:N0} ₫", Model.TotalVatCollected)</h4>
                    </div>
                    <div class="flex-shrink-0 align-self-center">
                        <div class="mini-stat-icon avatar-sm rounded-circle bg-white bg-opacity-25">
                            <span class="avatar-title">
                                <i class="bx bx-receipt font-size-24"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-white-50">Cố định 8% doanh thu sản phẩm</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white mini-stats-wid">
            <div class="card-body">
                <div class="d-flex">
                    <div class="flex-grow-1">
                        <p class="text-white-50 fw-medium">Thuế Shop (1.5%)</p>
                        <h4 class="mb-0 text-white">@string.Format("{0:N0} ₫", Model.TotalSellerTax)</h4>
                    </div>
                    <div class="flex-shrink-0 align-self-center">
                        <div class="mini-stat-icon avatar-sm rounded-circle bg-white bg-opacity-25">
                            <span class="avatar-title">
                                <i class="bx bx-building font-size-24"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-white-50">Thu hộ Nhà nước cho Shop > 500tr</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Table -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <h4 class="card-title flex-grow-1">Chi tiết Quyết toán từng Shop</h4>
                    <div class="flex-shrink-0">
                        <button class="btn btn-sm btn-outline-secondary"><i class="bx bx-export me-1"></i> Xuất Excel</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-nowrap align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Shop</th>
                                <th class="text-center">Số đơn</th>
                                <th class="text-end">Doanh số (Gross)</th>
                                <th class="text-end text-success">Commission</th>
                                <th class="text-end text-danger">VAT (8%)</th>
                                <th class="text-end text-warning">Thuế Shop</th>
                                <th class="text-end fw-bold">Thực trả (Payout)</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var shop in Model.Shops)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-xs me-3">
                                                <span class="avatar-title rounded-circle bg-primary bg-soft text-primary">
                                                    @shop.ShopName.Substring(0, 1).ToUpper()
                                                </span>
                                            </div>
                                            <div>
                                                <h5 class="text-truncate font-size-14 mb-1">@shop.ShopName</h5>
                                                <p class="text-muted mb-0">ID: #@shop.ShopId</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-pill badge-soft-info font-size-12">@shop.OrderCount</span>
                                    </td>
                                    <td class="text-end fw-medium">@string.Format("{0:N0} ₫", shop.TotalGrossSales)</td>
                                    <td class="text-end text-success">- @string.Format("{0:N0} ₫", shop.TotalCommission)</td>
                                    <td class="text-end text-danger">- @string.Format("{0:N0} ₫", shop.TotalVat)</td>
                                    <td class="text-end text-warning">- @string.Format("{0:N0} ₫", shop.TotalSellerTax)</td>
                                    <td class="text-end">
                                        <span class="text-primary fw-bold font-size-15">@string.Format("{0:N0} ₫", shop.TotalPayout)</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="dropdown">
                                            <a href="#" class="dropdown-toggle card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="mdi mdi-dots-horizontal font-size-18"></i>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                <a class="dropdown-item" href="#"><i class="bx bx-search-alt-2 me-1"></i> Xem chi tiết đơn</a>
                                                <a class="dropdown-item" href="#"><i class="bx bx-wallet me-1"></i> Lệnh chuyển tiền</a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
