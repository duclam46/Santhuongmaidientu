@model DOAN_BANHANG.ViewModels.AdminAccountListVm
@{
    ViewData["Title"] = "Quản lý khách hàng";

    var isSignedIn = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;

    var activeRole = string.IsNullOrWhiteSpace(Model.Query.Role) ? "Customer" : Model.Query.Role;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    (string label, string badgeClass, string icon) ResolveRoleUi(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "admin" => ("Admin", "badge bg-primary-subtle text-primary-emphasis border border-primary-subtle", "bx bx-shield"),
            "shop" => ("Shop", "badge bg-info-subtle text-info-emphasis border border-info-subtle", "bx bx-store"),
            "customer" => ("Customer", "badge bg-light text-dark border", "bx bx-user"),
            _ => (string.IsNullOrWhiteSpace(s) ? "(không rõ)" : s, "badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle", "bx bx-info-circle")
        };
    }

    (string label, string badgeClass, string icon) ResolveStatusUi(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "active" => ("Hoạt động", "badge bg-success-subtle text-success-emphasis border border-success-subtle", "bx bx-check-circle"),
            "pending" => ("Chờ duyệt", "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle", "bx bx-time-five"),
            "blocked" => ("Bị khóa", "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle", "bx bx-x-circle"),
            _ => (string.IsNullOrWhiteSpace(s) ? "(không rõ)" : s, "badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle", "bx bx-info-circle")
        };
    }
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 bg-light border rounded-3 p-3">
                <div>
                    <h4 class="mb-1"><i class="bx bx-user me-1"></i>Quản lý khách hàng</h4>
                    <div class="text-muted small">Danh sách Shop / Người dùng thường</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill px-3 py-2">
                        <i class="bx bx-layer me-1"></i>
                        Tổng: @Model.TotalItems
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-primary-subtle border-0 border-start border-4 border-primary">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-xs">
                            <span class="avatar-title rounded-circle bg-primary text-white">
                                <i class="bx bx-list-ul"></i>
                            </span>
                        </div>
                        <div>
                            <h5 class="mb-0">Danh sách tài khoản</h5>
                            <div class="text-muted small">Tìm theo email / họ tên, lọc theo role/status</div>
                        </div>
                    </div>
                    <span class="badge bg-primary text-white rounded-pill px-3 py-2">
                        <i class="bx bx-user me-1"></i>
                        @Model.TotalItems tài khoản
                    </span>
                </div>
            </div>
            <div class="card-body">
                @if (!isSignedIn)
                {
                    <div class="alert alert-warning mb-0">
                        Bạn chưa đăng nhập. Vui lòng đăng nhập tài khoản Admin.
                    </div>
                }
                else if (!isAdmin)
                {
                    <div class="alert alert-danger mb-0">
                        Tài khoản hiện tại không có quyền truy cập quản lý tài khoản.
                    </div>
                }
                else
                {
                    @if (TempData["AdminAccountSuccess"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
                    {
                        <div class="alert alert-success">
                            <i class="bx bx-check-circle me-1"></i>@okMsg
                        </div>
                    }
                    @if (TempData["AdminAccountError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
                    {
                        <div class="alert alert-danger">
                            <i class="bx bx-x-circle me-1"></i>@errMsg
                        </div>
                    }

                    <div class="mb-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="text-muted small">
                                <i class="bx bx-filter-alt me-1"></i>
                                Chọn danh sách cần xem
                            </div>
                        </div>

                        <div class="bg-light border rounded-pill p-1 mt-2">
                            <div class="nav nav-pills nav-fill gap-2" role="tablist" aria-label="Lọc theo loại tài khoản">
                                <a
                                    class="nav-link rounded-pill py-2 fw-semibold @(string.Equals(activeRole, "Customer", StringComparison.OrdinalIgnoreCase) ? "active" : "text-primary")"
                                    asp-area="Admin"
                                    asp-controller="Accounts"
                                    asp-action="Index"
                                    asp-route-Role="Customer"
                                    asp-route-Search="@Model.Query.Search"
                                    asp-route-Status="@Model.Query.Status"
                                >
                                    <i class="bx bx-user me-1"></i>
                                    Người dùng thường
                                </a>
                                <a
                                    class="nav-link rounded-pill py-2 fw-semibold @(string.Equals(activeRole, "Shop", StringComparison.OrdinalIgnoreCase) ? "active" : "text-primary")"
                                    asp-area="Admin"
                                    asp-controller="Accounts"
                                    asp-action="Index"
                                    asp-route-Role="Shop"
                                    asp-route-Search="@Model.Query.Search"
                                    asp-route-Status="@Model.Query.Status"
                                >
                                    <i class="bx bx-store me-1"></i>
                                    Shop
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="border rounded-3 p-3 bg-light mb-3">
                        <form method="get" class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label"><i class="bx bx-search-alt me-1"></i>Tìm kiếm</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bx bx-search-alt"></i></span>
                                    <input class="form-control" name="Search" value="@Model.Query.Search" placeholder="Email hoặc họ tên..." />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label"><i class="bx bx-badge-check me-1"></i>Status</label>
                                <select class="form-select" name="Status">
                                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Query.Status))">Tất cả</option>
                                    <option value="Active" selected="@(string.Equals(Model.Query.Status, "Active", StringComparison.OrdinalIgnoreCase))">Active</option>
                                    <option value="Pending" selected="@(string.Equals(Model.Query.Status, "Pending", StringComparison.OrdinalIgnoreCase))">Pending</option>
                                    <option value="Blocked" selected="@(string.Equals(Model.Query.Status, "Blocked", StringComparison.OrdinalIgnoreCase))">Blocked</option>
                                </select>
                            </div>
                            <div class="col-md-1 d-grid">
                                <input type="hidden" name="Role" value="@activeRole" />
                                <button class="btn btn-primary" type="submit"><i class="bx bx-filter-alt me-1"></i>Lọc</button>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;">ID</th>
                                    <th>Email</th>
                                    <th>Họ tên</th>
                                    <th>SĐT</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th style="width: 180px;">Thao tác</th>
                                    <th>Provider</th>
                                    <th>Ngày tạo</th>
                                    <th>Đăng nhập cuối</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Accounts is null || Model.Accounts.Count == 0)
                                {
                                    <tr>
                                        <td colspan="10" class="text-center text-muted py-4">Không có tài khoản phù hợp.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var a in Model.Accounts)
                                    {
                                        var roleUi = ResolveRoleUi(a.Role);
                                        var statusUi = ResolveStatusUi(a.Status);
                                        var isBlocked = string.Equals(a.Status, "Blocked", StringComparison.OrdinalIgnoreCase);

                                        <tr>
                                            <td class="fw-semibold">@a.Id</td>
                                            <td>@a.Email</td>
                                            <td>@(string.IsNullOrWhiteSpace(a.FullName) ? "-" : a.FullName)</td>
                                            <td>@(string.IsNullOrWhiteSpace(a.PhoneNumber) ? "-" : a.PhoneNumber)</td>
                                            <td>
                                                <span class="@roleUi.badgeClass"><i class="@roleUi.icon me-1"></i>@roleUi.label</span>
                                            </td>
                                            <td>
                                                <span class="@statusUi.badgeClass"><i class="@statusUi.icon me-1"></i>@statusUi.label</span>
                                            </td>
                                            <td>
                                                <form method="post" asp-area="Admin" asp-controller="Accounts" asp-action="ToggleLock" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Id" value="@a.Id" />
                                                    <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                                    <button type="submit" class="btn btn-sm @(isBlocked ? "btn-success" : "btn-danger")">
                                                        <i class="bx @(isBlocked ? "bx-lock-open" : "bx-lock") me-1"></i>
                                                        @(isBlocked ? "Mở khóa" : "Khóa")
                                                    </button>
                                                </form>
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(a.AuthProvider) ? "Local" : a.AuthProvider)</td>
                                            <td>@a.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@(a.LastLoginAt.HasValue ? a.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
