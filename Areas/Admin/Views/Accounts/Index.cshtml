@model DOAN_BANHANG.ViewModels.AdminAccountListVm
@{
    ViewData["Title"] = "Quản lý tài khoản & khách hàng";

    var isSignedIn = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;

    var activeRole = string.IsNullOrWhiteSpace(Model.Query.Role) ? "Customer" : Model.Query.Role;
    var isShopTab = string.Equals(activeRole, "Shop", StringComparison.OrdinalIgnoreCase);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    (string label, string badgeClass, string icon) ResolveStatusUi(string? raw)
    {
        var s = (raw ?? string.Empty).Trim().ToLowerInvariant();
        return s switch
        {
            "active" => ("Đang hoạt động", "badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-2.5 py-1", "bx bx-check-circle"),
            "pending" => ("Chờ kích hoạt", "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1", "bx bx-time-five"),
            "blocked" => ("Đang bị khóa", "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill px-2.5 py-1", "bx bx-lock-alt"),
            _ => ("Không rõ", "badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2.5 py-1", "bx bx-info-circle")
        };
    }

    string ResolveProviderLabel(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(s) || string.Equals(s, "Local", StringComparison.OrdinalIgnoreCase))
            return "Tài khoản hệ thống";
        return s;
    }
}

@section Styles {
    <style>
        .acc-hero {
            background: radial-gradient(circle at 88% 18%, rgba(255, 235, 105, 0.16) 0%, transparent 46%),
                        linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
            border-radius: 22px;
            padding: 26px 30px;
            color: #ffffff;
            margin-bottom: 24px;
            box-shadow: 0 18px 38px -16px rgba(0, 38, 42, 0.34);
        }
        .acc-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-top: 18px;
        }
        @@media (max-width: 991px) {
            .acc-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        .acc-kpi-card {
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 16px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .acc-kpi-ic {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: rgba(255, 235, 105, 0.18);
            color: #FFEB69;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
        .acc-tab-bar {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            background: #F1F5F9;
            padding: 6px;
            border-radius: 16px;
            margin-bottom: 18px;
        }
        .acc-tab-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 16px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            color: #475569;
            transition: all 0.2s ease;
            text-decoration: none !important;
        }
        .acc-tab-btn:hover {
            color: #088178;
            background: rgba(255, 255, 255, 0.6);
        }
        .acc-tab-btn.is-active {
            background: #088178;
            color: #ffffff !important;
            box-shadow: 0 6px 14px -6px rgba(8, 129, 120, 0.45);
        }
        .acc-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            overflow: hidden;
            flex-shrink: 0;
            background: linear-gradient(135deg, #088178 0%, #04464C 100%);
            color: #FFEB69;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
            border: 1px solid #E2E8F0;
        }
        .acc-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
}

<!-- HERO HEADER -->
<div class="acc-hero">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h4 class="text-white fw-bold mb-1">
                <i class="bx bxs-user-detail text-warning me-1"></i>Quản lý Khách hàng &amp; Đối tác Bán hàng
            </h4>
            <p class="mb-0 small" style="color: rgba(255,255,255,0.82);">
                Theo dõi toàn bộ tài khoản người mua, gian hàng đối tác (Sellzy Mall &amp; Shop Thường), trạng thái hoạt động và kiểm soát khóa/mở khóa tài khoản.
            </p>
        </div>
        <a asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index" asp-route-Status="Pending" class="btn btn-sm rounded-pill px-3 fw-bold" style="background: #FFEB69; color: #161C24;">
            <i class="bx bx-user-check me-1"></i>Duyệt hồ sơ đối tác
        </a>
    </div>

    <div class="acc-kpi-grid">
        <div class="acc-kpi-card">
            <span class="acc-kpi-ic"><i class="bx bx-user"></i></span>
            <div>
                <div class="fs-5 fw-bold text-white lh-1">@Model.TotalCustomers</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Khách hàng mua sắm</div>
            </div>
        </div>
        <div class="acc-kpi-card">
            <span class="acc-kpi-ic"><i class="bx bx-store-alt"></i></span>
            <div>
                <div class="fs-5 fw-bold text-white lh-1">@Model.TotalShops</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Đối tác bán hàng</div>
            </div>
        </div>
        <div class="acc-kpi-card">
            <span class="acc-kpi-ic"><i class="bx bxs-badge-check"></i></span>
            <div>
                <div class="fs-5 fw-bold lh-1" style="color: #FFEB69;">@Model.TotalMallShops</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Gian hàng Sellzy Mall</div>
            </div>
        </div>
        <div class="acc-kpi-card">
            <span class="acc-kpi-ic" style="background: rgba(248,113,113,0.22); color: #FCA5A5;"><i class="bx bx-lock-alt"></i></span>
            <div>
                <div class="fs-5 fw-bold text-white lh-1">@Model.TotalBlocked</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Tài khoản đang khóa</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-4">
        @if (!isSignedIn)
        {
            <div class="alert alert-warning mb-0">Bạn chưa đăng nhập. Vui lòng đăng nhập tài khoản Quản trị viên.</div>
        }
        else if (!isAdmin)
        {
            <div class="alert alert-danger mb-0">Tài khoản hiện tại không có quyền truy cập quản lý tài khoản.</div>
        }
        else
        {
            @if (TempData["AdminAccountSuccess"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                    <i class="bx bx-check-circle me-1"></i>@okMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["AdminAccountError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <i class="bx bx-error-circle me-1"></i>@errMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- CHỌN NHÓM TÀI KHOẢN -->
            <div class="acc-tab-bar">
                <a class="acc-tab-btn @(!isShopTab ? "is-active" : "")"
                   asp-area="Admin" asp-controller="Accounts" asp-action="Index"
                   asp-route-Role="Customer" asp-route-Search="@Model.Query.Search" asp-route-Status="@Model.Query.Status">
                    <i class="bx bx-user fs-5"></i>
                    <span>Khách hàng mua sắm</span>
                    <span class="badge rounded-pill @(!isShopTab ? "bg-white text-primary" : "bg-secondary-subtle text-dark")">@Model.TotalCustomers</span>
                </a>
                <a class="acc-tab-btn @(isShopTab ? "is-active" : "")"
                   asp-area="Admin" asp-controller="Accounts" asp-action="Index"
                   asp-route-Role="Shop" asp-route-Search="@Model.Query.Search" asp-route-Status="@Model.Query.Status">
                    <i class="bx bx-store-alt fs-5"></i>
                    <span>Đối tác bán hàng (Shop)</span>
                    <span class="badge rounded-pill @(isShopTab ? "bg-white text-primary" : "bg-secondary-subtle text-dark")">@Model.TotalShops</span>
                </a>
            </div>

            <!-- BỘ LỌC TÌM KIẾM -->
            <div class="border rounded-3 p-3 bg-light mb-4">
                <form method="get" class="row g-2 align-items-end">
                    <input type="hidden" name="Role" value="@activeRole" />
                    <div class="col-md-6">
                        <label class="form-label small fw-bold"><i class="bx bx-search-alt me-1"></i>Tìm kiếm nhanh</label>
                        <input class="form-control" name="Search" value="@Model.Query.Search"
                               placeholder="@(isShopTab ? "Nhập tên gian hàng, họ tên chủ shop, email hoặc SĐT..." : "Nhập họ tên khách hàng, email hoặc số điện thoại...")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold"><i class="bx bx-filter-alt me-1"></i>Trạng thái tài khoản</label>
                        <select class="form-select" name="Status">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Query.Status))">Tất cả trạng thái</option>
                            <option value="Active" selected="@(string.Equals(Model.Query.Status, "Active", StringComparison.OrdinalIgnoreCase))">Đang hoạt động</option>
                            <option value="Pending" selected="@(string.Equals(Model.Query.Status, "Pending", StringComparison.OrdinalIgnoreCase))">Chờ kích hoạt</option>
                            <option value="Blocked" selected="@(string.Equals(Model.Query.Status, "Blocked", StringComparison.OrdinalIgnoreCase))">Đang bị khóa</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button class="btn btn-primary flex-grow-1 fw-semibold" type="submit">
                            <i class="bx bx-filter-alt me-1"></i>Lọc danh sách
                        </button>
                        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Accounts" asp-action="Index" asp-route-Role="@activeRole" title="Đặt lại bộ lọc">
                            <i class="bx bx-reset"></i>
                        </a>
                    </div>
                </form>
            </div>

            <!-- BẢNG DANH SÁCH TÀI KHOẢN -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 65px;">#</th>
                            <th>@(isShopTab ? "Gian hàng & Chủ shop" : "Thông tin khách hàng")</th>
                            <th>@(isShopTab ? "Phân hạng & Quy mô" : "Hoạt động mua sắm")</th>
                            <th>Đăng nhập bằng</th>
                            <th>Trạng thái</th>
                            <th>Thời gian</th>
                            <th class="text-end" style="width: 190px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Accounts is null || Model.Accounts.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="bx @(isShopTab ? "bx-store-alt" : "bx-user-x") display-5 text-muted d-block mb-2"></i>
                                    <div class="fw-bold text-dark">
                                        @(isShopTab ? "Chưa có đối tác bán hàng nào phù hợp" : "Chưa có tài khoản khách hàng nào")
                                    </div>
                                    <div class="text-muted small mt-1">
                                        @(isShopTab
                                            ? "Hãy thử thay đổi từ khóa tìm kiếm hoặc kiểm tra mục Duyệt hồ sơ đối tác."
                                            : "Khi người dùng mới đăng ký mua sắm trên trang chủ, tài khoản sẽ xuất hiện tại đây.")
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var a in Model.Accounts)
                            {
                                var statusUi = ResolveStatusUi(a.Status);
                                var isBlocked = string.Equals(a.Status, "Blocked", StringComparison.OrdinalIgnoreCase);
                                var primaryName = isShopTab
                                    ? (!string.IsNullOrWhiteSpace(a.ShopName) ? a.ShopName : (a.FullName ?? a.Email))
                                    : (!string.IsNullOrWhiteSpace(a.FullName) ? a.FullName : a.Email);
                                var initial = !string.IsNullOrWhiteSpace(primaryName) ? primaryName.Trim()[0].ToString().ToUpperInvariant() : "U";

                                <tr>
                                    <td class="text-muted fw-semibold">#@a.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="acc-avatar">
                                                @if (!string.IsNullOrWhiteSpace(a.AvatarUrl))
                                                {
                                                    <img src="@a.AvatarUrl" alt="@primaryName" />
                                                }
                                                else
                                                {
                                                    <span>@initial</span>
                                                }
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@primaryName</div>
                                                <div class="small text-muted">
                                                    @a.Email
                                                    @if (!string.IsNullOrWhiteSpace(a.PhoneNumber))
                                                    {
                                                        <span> • @a.PhoneNumber</span>
                                                    }
                                                </div>
                                                @if (isShopTab && !string.IsNullOrWhiteSpace(a.FullName))
                                                {
                                                    <div class="small text-muted">Đại diện: <strong>@a.FullName</strong></div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (isShopTab)
                                        {
                                            if (a.IsMall)
                                            {
                                                <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #00262A; color: #FFEB69;">
                                                    <i class="bx bxs-badge-check me-1"></i>Sellzy Mall
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-1">
                                                    <i class="bx bx-store me-1"></i>Shop Thường
                                                </span>
                                            }
                                            <div class="small text-muted mt-1">@a.ProductCount sản phẩm đang quản lý</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1">
                                                <i class="bx bx-user me-1 text-primary"></i>Khách hàng
                                            </span>
                                            <div class="small text-muted mt-1">@a.OrderCount đơn hàng đã đặt</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="small fw-semibold text-secondary">@ResolveProviderLabel(a.AuthProvider)</span>
                                    </td>
                                    <td>
                                        <span class="@statusUi.badgeClass"><i class="@statusUi.icon me-1"></i>@statusUi.label</span>
                                    </td>
                                    <td>
                                        <div class="small text-dark">Tạo: @a.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                        <div class="small text-muted">
                                            Đăng nhập: @(a.LastLoginAt.HasValue ? a.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa đăng nhập")
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex align-items-center gap-1.5">
                                            @if (isShopTab && !string.IsNullOrWhiteSpace(a.ShopSlug))
                                            {
                                                <a href="/shop/@a.ShopSlug" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2.5" title="Xem gian hàng ngoài trang chủ">
                                                    <i class="bx bx-link-external"></i>
                                                </a>
                                            }
                                            <form method="post" asp-area="Admin" asp-controller="Accounts" asp-action="ToggleLock" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@a.Id" />
                                                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                                <button type="submit" class="btn btn-sm rounded-pill px-3 fw-semibold @(isBlocked ? "btn-success" : "btn-outline-danger")">
                                                    <i class="bx @(isBlocked ? "bx-lock-open" : "bx-lock-alt") me-1"></i>
                                                    @(isBlocked ? "Mở khóa" : "Khóa")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
