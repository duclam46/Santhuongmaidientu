@using DOAN_BANHANG.ViewModels
@model BlogPostEditVm

@{
    ViewData["Title"] = "Viết bài Blog mới";
}

@section Styles {
    <style>
        .bl-form-hero {
            background: radial-gradient(circle at 88% 18%, rgba(255, 235, 105, 0.16) 0%, transparent 46%),
                        linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
            border-radius: 22px;
            padding: 22px 28px;
            color: #ffffff;
            margin-bottom: 24px;
            box-shadow: 0 18px 38px -16px rgba(0, 38, 42, 0.34);
        }
        .ck-editor__editable_inline {
            min-height: 400px;
        }
        .border.dashed {
            border-style: dashed !important;
        }
        .selected-product-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            background: #F8FAFC;
        }
        .selected-product-item img {
            width: 40px;
            height: 40px;
            object-fit: cover;
            border-radius: 8px;
            flex-shrink: 0;
        }
    </style>
}

<!-- HERO HEADER -->
<div class="bl-form-hero">
    <a asp-action="Index" class="btn btn-sm rounded-pill px-3 mb-2" style="background: rgba(255,255,255,0.14); color: #ffffff; border: 1px solid rgba(255,255,255,0.22);">
        <i class="bx bx-left-arrow-alt me-1"></i>Danh sách bài viết
    </a>
    <h4 class="text-white fw-bold mb-1"><i class="bx bx-edit text-warning me-1"></i>Viết bài Blog mới</h4>
    <p class="mb-0 small" style="color: rgba(255,255,255,0.82);">Soạn thảo nội dung, tải ảnh bìa và gắn các sản phẩm liên quan để hiển thị trên chuyên mục Blog Sellzy.</p>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="blogForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bx bx-file text-primary me-2"></i>1. Nội dung bài viết</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề thu hút người đọc..." required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fw-semibold">Mô tả tóm tắt</label>
                        <textarea asp-for="Summary" class="form-control" rows="3" placeholder="Đoạn mở đầu ngắn gọn hiển thị ở danh sách bài viết..."></textarea>
                        <span asp-validation-for="Summary" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Content" class="form-label fw-semibold">Nội dung chi tiết</label>
                        <textarea asp-for="Content" id="editor"></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bx bx-cog text-primary me-2"></i>2. Xuất bản &amp; Ảnh bìa</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">Trạng thái hiển thị</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Draft">Lưu bản nháp</option>
                            <option value="Published">Xuất bản ngay</option>
                            <option value="Hidden">Tạm ẩn bài viết</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Ảnh bìa bài viết</label>
                        <div class="mb-2 rounded-3 overflow-hidden border bg-light">
                            <img id="imgPreview" src="/assets/images/no-image.png" class="w-100" style="max-height: 190px; object-fit: cover;" alt="Xem trước ảnh bìa" />
                        </div>
                        <input type="file" name="coverImage" id="fileInput" class="form-control" accept="image/*" />
                        <div class="form-text">Khuyến nghị ảnh ngang tỷ lệ 16:9, dung lượng tối đa 2MB.</div>
                    </div>

                    <hr class="my-3" />

                    <div class="mb-0">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="form-label fw-semibold mb-0">Sản phẩm liên kết</label>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 fw-semibold" data-bs-toggle="modal" data-bs-target="#productPickerModal">
                                <i class="bx bx-plus me-1"></i>Chọn sản phẩm
                            </button>
                        </div>
                        <div id="selectedProductsList" class="d-flex flex-column gap-2">
                            <p class="text-muted small text-center py-3 border rounded-3 dashed bg-light mb-0" id="noProductMsg">Chưa có sản phẩm nào được gắn vào bài viết.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">
                    <i class="bx bx-save me-1"></i>Lưu bài viết
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3 fw-semibold">Hủy bỏ</a>
            </div>
        </div>
    </div>
</form>

<!-- Modal Chọn sản phẩm liên kết -->
<div class="modal fade" id="productPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold"><i class="bx bx-link text-primary me-1"></i>Chọn sản phẩm liên kết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" id="productSearchInput" class="form-control" placeholder="Nhập tên sản phẩm cần tìm..." />
                    <button class="btn btn-primary" type="button" id="btnSearchProduct"><i class="bx bx-search"></i></button>
                </div>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 54px;">Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Giá bán</th>
                                <th class="text-end" style="width: 100px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="productListBody">
                            @foreach (var p in Model.AvailableProducts)
                            {
                                <tr>
                                    <td>
                                        <img src="@(p.ImageUrl ?? "/assets/images/no-image.png")" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" />
                                    </td>
                                    <td><div class="fw-semibold text-dark">@p.Name</div></td>
                                    <td class="fw-semibold text-primary">@p.Price.ToString("N0")₫</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 btn-add-product"
                                                data-id="@p.Id" data-name="@p.Name" data-img="@p.ImageUrl" data-price="@p.Price.ToString("N0")">
                                            Chọn
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            ClassicEditor
                .create(document.querySelector('#editor'), {
                    toolbar: [
                        'heading', '|',
                        'bold', 'italic', 'underline', '|',
                        'link', 'blockQuote', '|',
                        'bulletedList', 'numberedList', '|',
                        'insertImage', '|',
                        'undo', 'redo'
                    ],
                    image: {
                        toolbar: ['imageTextAlternative', 'imageStyle:inline', 'imageStyle:block', 'imageStyle:side'],
                        upload: { types: ['jpeg', 'png', 'gif', 'webp'] }
                    },
                    plugins: ClassicEditor.builtinPlugins,
                    language: 'vi'
                })
                .then(editor => {
                    window.blogEditor = editor;
                })
                .catch(error => {
                    console.error(error);
                });

            const fileInput = document.getElementById('fileInput');
            const imgPreview = document.getElementById('imgPreview');
            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) { imgPreview.src = e.target.result; };
                        reader.readAsDataURL(file);
                    }
                });
            }

            const selectedList = document.getElementById('selectedProductsList');
            const noMsg = document.getElementById('noProductMsg');

            function addProductToSelected(id, name, img, price) {
                if (selectedList.querySelector(`[data-pid="${id}"]`)) return;
                noMsg.classList.add('d-none');

                const item = document.createElement('div');
                item.className = 'selected-product-item';
                item.setAttribute('data-pid', id);
                item.innerHTML = `
                    <input type="hidden" name="SelectedProductIds" value="${id}" />
                    <img src="${img || '/assets/images/no-image.png'}" alt="" />
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="text-truncate fw-semibold small text-dark">${name}</div>
                        <div class="text-primary small fw-semibold">${price}₫</div>
                    </div>
                    <button type="button" class="btn btn-sm text-danger btn-remove-product" title="Gỡ sản phẩm"><i class="bx bx-x fs-5"></i></button>
                `;
                selectedList.appendChild(item);

                item.querySelector('.btn-remove-product').addEventListener('click', function () {
                    item.remove();
                    if (selectedList.querySelectorAll('.selected-product-item').length === 0) {
                        noMsg.classList.remove('d-none');
                    }
                });
            }

            document.querySelectorAll('.btn-add-product').forEach(btn => {
                btn.addEventListener('click', function () {
                    const d = this.dataset;
                    addProductToSelected(d.id, d.name, d.img, d.price);
                });
            });

            const searchInput = document.getElementById('productSearchInput');
            const searchBtn = document.getElementById('btnSearchProduct');
            const productListBody = document.getElementById('productListBody');

            async function performSearch() {
                const q = searchInput.value.trim();
                searchBtn.disabled = true;
                searchBtn.innerHTML = '<i class="bx bx-loader bx-spin"></i>';

                try {
                    const response = await fetch(`/Admin/Blog/SearchProducts?q=${encodeURIComponent(q)}`);
                    const data = await response.json();

                    productListBody.innerHTML = '';
                    if (data.length === 0) {
                        productListBody.innerHTML = '<tr><td colspan="4" class="text-center py-3 text-muted">Không tìm thấy sản phẩm phù hợp.</td></tr>';
                    } else {
                        data.forEach(p => {
                            const formattedPrice = new Intl.NumberFormat('vi-VN').format(p.price);
                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td><img src="${p.imageUrl || '/assets/images/no-image.png'}" class="rounded border" style="width: 40px; height: 40px; object-fit: cover;" /></td>
                                <td><div class="fw-semibold text-dark">${p.name}</div></td>
                                <td class="fw-semibold text-primary">${formattedPrice}₫</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 btn-add-product-ajax"
                                            data-id="${p.id}" data-name="${p.name}" data-img="${p.imageUrl || ''}" data-price="${formattedPrice}">
                                        Chọn
                                    </button>
                                </td>
                            `;
                            productListBody.appendChild(tr);

                            tr.querySelector('.btn-add-product-ajax').addEventListener('click', function () {
                                const d = this.dataset;
                                addProductToSelected(d.id, d.name, d.img, d.price);
                            });
                        });
                    }
                } catch (err) {
                    console.error(err);
                } finally {
                    searchBtn.disabled = false;
                    searchBtn.innerHTML = '<i class="bx bx-search"></i>';
                }
            }

            searchBtn.addEventListener('click', performSearch);
            searchInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') { e.preventDefault(); performSearch(); } });
        });
    </script>
}
