@model IEnumerable<DOAN_BANHANG.Models.Conversation>
@{
    ViewData["Title"] = "Quản lý Chat - Shop";
    var activeConv = ViewBag.ActiveConversation as DOAN_BANHANG.Models.Conversation;
    var currentAccountId = ViewBag.CurrentAccountId != null ? (int)ViewBag.CurrentAccountId : 0;
    var vouchers = ViewBag.Vouchers as List<DOAN_BANHANG.Models.Voucher>;
    var isAdmin = User.IsInRole("Admin");
}

<style>
    :root {
        --chat-primary: #4f46e5;
        --chat-primary-light: #e0e7ff;
        --chat-primary-dark: #3730a3;
        --chat-bg: #f8fafc;
        --chat-border: #e2e8f0;
        --chat-text-main: #1e293b;
        --chat-text-muted: #64748b;
    }

    .chat-wrapper {
        display: flex;
        height: calc(100vh - 140px);
        min-height: 600px;
        background: white;
        border-radius: 24px;
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.08);
        overflow: hidden;
        border: 1px solid rgba(226, 232, 240, 0.8);
        margin: -10px;
        font-family: 'Inter', sans-serif;
    }

    /* Sidebar */
    .chat-sidebar {
        width: 380px;
        background: #ffffff;
        border-right: 1px solid var(--chat-border);
        display: flex;
        flex-direction: column;
        z-index: 10;
    }

    .sidebar-header {
        padding: 24px;
        background: linear-gradient(to bottom, #ffffff, #f8fafc);
        border-bottom: 1px solid var(--chat-border);
    }

    .sidebar-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--chat-text-main);
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .sidebar-title i {
        background: var(--chat-primary-light);
        color: var(--chat-primary);
        padding: 8px;
        border-radius: 12px;
        font-size: 1.2rem;
    }

    .search-box {
        position: relative;
    }

    .search-box input {
        width: 100%;
        padding: 12px 16px 12px 44px;
        border-radius: 16px;
        border: 1px solid var(--chat-border);
        background: #f1f5f9;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        color: var(--chat-text-main);
    }

    .search-box input:focus {
        outline: none;
        border-color: var(--chat-primary);
        background: white;
        box-shadow: 0 0 0 4px var(--chat-primary-light);
    }

    .search-box i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--chat-text-muted);
        font-size: 1.1rem;
    }

    .conv-list {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .conv-list::-webkit-scrollbar { width: 6px; }
    .conv-list::-webkit-scrollbar-track { background: transparent; }
    .conv-list::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

    .conv-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px;
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none !important;
        position: relative;
        border: 1px solid transparent;
    }

    .conv-item:hover {
        background: #f8fafc;
    }

    .conv-item.active {
        background: var(--chat-primary-light);
        border-color: rgba(79, 70, 229, 0.2);
    }

    .conv-avatar {
        position: relative;
    }

    .conv-avatar img {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .status-badge {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 14px;
        height: 14px;
        background: #10b981;
        border: 3px solid white;
        border-radius: 50%;
    }

    .conv-details {
        flex: 1;
        min-width: 0;
    }

    .conv-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 4px;
    }

    .conv-name {
        font-weight: 700;
        color: var(--chat-text-main);
        font-size: 1.05rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .conv-time {
        font-size: 0.75rem;
        color: var(--chat-text-muted);
        font-weight: 600;
    }

    .conv-message {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .conv-text {
        font-size: 0.9rem;
        color: var(--chat-text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
        padding-right: 8px;
    }

    .conv-text.unread {
        color: var(--chat-text-main);
        font-weight: 700;
    }

    .unread-indicator {
        background: #ef4444;
        color: white;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 10px;
        box-shadow: 0 2px 5px rgba(239, 68, 68, 0.3);
    }

    /* Main Chat */
    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        position: relative;
    }

    .chat-header {
        padding: 20px 32px;
        border-bottom: 1px solid var(--chat-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        z-index: 5;
    }

    .chat-target-info {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .chat-target-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .chat-target-name {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--chat-text-main);
        margin-bottom: 2px;
    }

    .chat-target-status {
        font-size: 0.8rem;
        color: #10b981;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .chat-target-status::before {
        content: '';
        width: 6px;
        height: 6px;
        background: #10b981;
        border-radius: 50%;
        display: inline-block;
    }

    .chat-actions {
        display: flex;
        gap: 12px;
    }

    .btn-deal {
        background: linear-gradient(135deg, #f59e0b, #ea580c);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(234, 88, 12, 0.2);
        transition: all 0.3s;
    }

    .btn-deal:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(234, 88, 12, 0.3);
        color: white;
    }

    .msg-area {
        flex: 1;
        padding: 32px;
        overflow-y: auto;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .msg-area::-webkit-scrollbar { width: 6px; }
    .msg-area::-webkit-scrollbar-track { background: transparent; }
    .msg-area::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

    .msg-row {
        display: flex;
        gap: 12px;
        max-width: 75%;
    }

    .msg-row.me {
        align-self: flex-end;
        flex-direction: row-reverse;
    }

    .msg-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        margin-top: auto;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .msg-content-wrapper {
        display: flex;
        flex-direction: column;
    }

    .msg-bubble {
        padding: 14px 20px;
        border-radius: 20px;
        font-size: 0.95rem;
        line-height: 1.5;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        word-break: break-word;
    }

    .msg-row:not(.me) .msg-bubble {
        background: white;
        color: var(--chat-text-main);
        border-bottom-left-radius: 4px;
        border: 1px solid rgba(0,0,0,0.02);
    }

    .msg-row.me .msg-bubble {
        background: linear-gradient(135deg, var(--chat-primary), var(--chat-primary-dark));
        color: white;
        border-bottom-right-radius: 4px;
    }

    .msg-time {
        font-size: 0.75rem;
        color: var(--chat-text-muted);
        margin-top: 6px;
        font-weight: 500;
    }

    .msg-row.me .msg-time {
        text-align: right;
    }

    /* Product & Voucher Cards */
    .msg-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        width: 260px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: 1px solid var(--chat-border);
    }

    .msg-row.me .msg-card {
        border-color: rgba(255,255,255,0.2);
        background: rgba(255,255,255,0.1);
    }

    .msg-card-img {
        width: 100%;
        height: 140px;
        object-fit: cover;
        border-bottom: 1px solid var(--chat-border);
    }

    .msg-card-body {
        padding: 16px;
    }

    .msg-card-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--chat-text-main);
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .msg-row.me .msg-card-title { color: white; }

    .msg-card-price {
        color: var(--chat-primary);
        font-weight: 800;
        font-size: 1.1rem;
    }
    .msg-row.me .msg-card-price { color: #818cf8; }

    .msg-voucher {
        background: linear-gradient(135deg, #fffbeb, #fef3c7);
        border: 2px dashed #fcd34d;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        width: 260px;
        color: #b45309;
    }
    
    .msg-row.me .msg-voucher {
        background: linear-gradient(135deg, rgba(255,251,235,0.1), rgba(254,243,199,0.2));
        border-color: rgba(252,211,77,0.5);
        color: white;
    }

    /* Input Area */
    .chat-input-area {
        padding: 20px 32px;
        background: white;
        border-top: 1px solid var(--chat-border);
    }

    .input-wrapper {
        background: #f8fafc;
        border: 1px solid var(--chat-border);
        border-radius: 20px;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s;
    }

    .input-wrapper:focus-within {
        border-color: var(--chat-primary);
        box-shadow: 0 0 0 4px var(--chat-primary-light);
        background: white;
    }

    .action-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--chat-text-muted);
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        background: transparent;
        font-size: 1.2rem;
    }

    .action-icon:hover {
        background: var(--chat-primary-light);
        color: var(--chat-primary);
    }

    .chat-input {
        flex: 1;
        border: none;
        background: transparent;
        padding: 10px 0;
        font-size: 1rem;
        color: var(--chat-text-main);
    }

    .chat-input:focus { outline: none; }
    .chat-input::placeholder { color: #94a3b8; }

    .btn-send {
        background: var(--chat-primary);
        color: white;
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.3);
    }

    .btn-send:hover {
        background: var(--chat-primary-dark);
        transform: scale(1.05);
    }

    /* Empty State */
    .empty-state {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        color: var(--chat-text-muted);
    }

    .empty-state-icon {
        font-size: 5rem;
        color: #cbd5e1;
        margin-bottom: 24px;
    }

    .empty-state-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--chat-text-main);
        margin-bottom: 8px;
    }

    /* Toasts */
    .toast-container {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 1050;
    }

    .chat-toast {
        background: white;
        border-radius: 16px;
        padding: 16px 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 12px;
        border-left: 4px solid var(--chat-primary);
        animation: slideInRight 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

    .chat-toast img {
        width: 40px;
        height: 40px;
        border-radius: 10px;
    }

    .chat-toast-content h6 { margin: 0 0 4px 0; font-weight: 700; font-size: 0.95rem; }
    .chat-toast-content p { margin: 0; font-size: 0.85rem; color: var(--chat-text-muted); }

    @@keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
</style>

<div class="chat-wrapper">
    <!-- Sidebar -->
    <div class="chat-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-title">
                <i class="bx bx-chat"></i>
                Hộp thư Cửa hàng
            </div>
            <div class="search-box">
                <i class="bx bx-search"></i>
                <input type="text" id="searchInput" placeholder="Tìm kiếm khách hàng...">
            </div>
        </div>
        
        <div class="conv-list" id="convList">
            @foreach (var conv in Model)
            {
                var customerName = "Người dùng ẩn";
                if (conv.Customer != null) {
                    if (conv.Customer.Profile != null && !string.IsNullOrWhiteSpace(conv.Customer.Profile.FullName)) {
                        customerName = conv.Customer.Profile.FullName;
                    } else if (!string.IsNullOrWhiteSpace(conv.Customer.Email)) {
                        customerName = conv.Customer.Email.Split('@')[0];
                    }
                }
                var customerAvatar = conv.Customer?.Profile?.AvatarUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(customerName)}&background=random&color=fff&rounded=true&bold=true";
                var lastMsg = conv.Messages.OrderByDescending(m => m.CreatedAt).FirstOrDefault();
                var isActive = activeConv != null && activeConv.Id == conv.Id;
                var isUnread = lastMsg != null && lastMsg.SenderId != currentAccountId && !lastMsg.IsReadByShop;
                
                string msgPreview = "Chưa có tin nhắn";
                if(lastMsg != null) {
                    string prefix = lastMsg.SenderId == currentAccountId ? "Bạn: " : "";
                    if(lastMsg.MessageType == "image") msgPreview = prefix + "[Hình ảnh]";
                    else if(lastMsg.MessageType == "video") msgPreview = prefix + "[Video]";
                    else if(lastMsg.MessageType == "product_card") msgPreview = prefix + "[Sản phẩm]";
                    else if(lastMsg.MessageType == "voucher_card") msgPreview = prefix + "[Voucher]";
                    else msgPreview = prefix + lastMsg.Content;
                }

                <div class="conv-item @(isActive ? "active" : "")" data-id="@conv.Id" onclick="loadConversation(@conv.Id)">
                    <div class="conv-avatar">
                        <img src="@customerAvatar" alt="" onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(customerName)&background=random&color=fff&rounded=true&bold=true'">
                        <div class="status-badge"></div>
                    </div>
                    <div class="conv-details">
                        <div class="conv-header">
                            <div class="conv-name">@customerName</div>
                            <div class="conv-time">@(conv.LastMessageAt.ToString("HH:mm"))</div>
                        </div>
                        <div class="conv-message">
                            <div class="conv-text @(isUnread ? "unread" : "")">@msgPreview</div>
                            @if(isUnread) {
                                <div class="unread-indicator">Mới</div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Area -->
    <div class="chat-main" id="chatMain">
        <!-- Default State or Preloaded State will be injected here via JS if activeConv is null -->
        <div class="empty-state">
            <i class="bx bx-message-square-dots empty-state-icon"></i>
            <div class="empty-state-title">Trung tâm Hỗ trợ Khách hàng</div>
            <p>Chọn một cuộc hội thoại bên trái để bắt đầu chat.</p>
        </div>
    </div>
</div>

<!-- Modal Gửi Voucher -->
<div class="modal fade" id="sendVoucherModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 24px; border: none; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #f59e0b, #ea580c); color: white; padding: 20px; border: none;">
                <h5 class="modal-title font-bold flex items-center gap-2">
                    <i class="bx bxs-coupon text-xl"></i> Gửi Deal ưu đãi
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <div class="mb-4">
                    <label class="font-bold text-slate-700 mb-2 block">Chọn Voucher</label>
                    <select id="selectVoucher" class="form-select" style="border-radius: 12px; padding: 12px; border-color: #e2e8f0;">
                        <option value="">-- Chọn Voucher khả dụng --</option>
                        @if (vouchers != null)
                        {
                            foreach (var v in vouchers)
                            {
                                var txt = v.DiscountType == "Percent" ? $"{v.DiscountValue}%" : $"{v.DiscountValue:N0}đ";
                                <option value="@v.Id">Mã @v.Code - Giảm @txt (HSD: @v.EndDate.ToString("dd/MM"))</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="font-bold text-slate-700 mb-2 block">Lời nhắn đính kèm</label>
                    <textarea id="voucherMessage" rows="3" class="form-control" style="border-radius: 12px; padding: 12px; border-color: #e2e8f0;" placeholder="Ví dụ: Tặng bạn mã giảm giá độc quyền này nhé..."></textarea>
                </div>
            </div>
            <div class="modal-footer" style="border: none; padding: 0 24px 24px 24px;">
                <button type="button" class="btn btn-light" style="border-radius: 12px; padding: 10px 20px; font-weight: 600;" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnSendVoucher" class="btn" style="background: var(--chat-primary); color: white; border-radius: 12px; padding: 10px 24px; font-weight: 600;">Gửi ngay</button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const currentAccountId = @currentAccountId;
        let activeConversationId = null;
        let connection = null;

        document.addEventListener("DOMContentLoaded", function () {
            // Khởi tạo SignalR
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chathub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMessage", function (msg) {
                if (msg.conversationId === activeConversationId) {
                    appendMsgToChat(msg);
                    connection.invoke("MarkRead", activeConversationId).catch(console.error);
                }
                updateSidebarItem(msg.conversationId, msg, false);
            });

            // Lắng nghe thông báo tin nhắn mới để cập nhật sidebar real-time
            connection.on("NewMessageFromCustomer", function (data) {
                if(data.conversationId !== activeConversationId) {
                    showToast("Tin nhắn mới", data.content, data.conversationId);
                    updateSidebarPreview(data.conversationId, data.content, true);
                }
            });

            connection.start().then(() => {
                console.log("SignalR Connected in Admin Chat");
                @if (activeConv != null)
                {
                    <text>
                    loadConversation(@activeConv.Id);
                    </text>
                }
            }).catch(console.error);

            // Xử lý gửi Voucher
            document.getElementById("btnSendVoucher").addEventListener("click", function() {
                if(!activeConversationId) return;
                const vid = document.getElementById("selectVoucher").value;
                const msg = document.getElementById("voucherMessage").value;
                if(!vid) return alert("Vui lòng chọn voucher");
                connection.invoke("SendVoucherCard", activeConversationId, parseInt(vid), msg || null).then(() => {
                    bootstrap.Modal.getInstance(document.getElementById('sendVoucherModal')).hide();
                }).catch(console.error);
            });

            // Tìm kiếm
            document.getElementById("searchInput").addEventListener("input", function(e) {
                const term = e.target.value.toLowerCase();
                document.querySelectorAll(".conv-item").forEach(item => {
                    const name = item.querySelector(".conv-name").textContent.toLowerCase();
                    item.style.display = name.includes(term) ? "flex" : "none";
                });
            });
        });

        async function loadConversation(id) {
            // Update UI Active State
            document.querySelectorAll('.conv-item').forEach(el => el.classList.remove('active'));
            const activeItem = document.querySelector(`.conv-item[data-id="${id}"]`);
            if(activeItem) {
                activeItem.classList.add('active');
                const unreadInd = activeItem.querySelector('.unread-indicator');
                if(unreadInd) unreadInd.remove();
                const textElem = activeItem.querySelector('.conv-text');
                if(textElem) textElem.classList.remove('unread');
            }

            try {
                const res = await fetch('/Admin/Chat/GetMessages/' + id);
                if(!res.ok) throw new Error("Failed to load chat");
                const data = await res.json();
                
                activeConversationId = id;
                connection.invoke("JoinConversation", id).catch(console.error);
                renderChatMain(data.conversation, data.messages);
            } catch(e) {
                console.error(e);
                alert("Lỗi tải cuộc trò chuyện");
            }
        }

        function renderChatMain(conv, messages) {
            const chatMain = document.getElementById("chatMain");
            const avatar = conv.customerAvatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(conv.customerName)}&background=random&color=fff&rounded=true&bold=true`;
            
            let html = `
                <div class="chat-header">
                    <div class="chat-target-info">
                        <img src="${avatar}" class="chat-target-avatar" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(conv.customerName)}&background=random&color=fff&rounded=true&bold=true'">
                        <div>
                            <div class="chat-target-name">${escapeHtml(conv.customerName)}</div>
                            <div class="chat-target-status">Đang trực tuyến</div>
                        </div>
                    </div>
                    <div class="chat-actions">
                        <button type="button" data-bs-toggle="modal" data-bs-target="#sendVoucherModal" class="btn-deal">
                            <i class="bx bxs-coupon"></i> Gửi Deal
                        </button>
                    </div>
                </div>
                <div class="msg-area" id="msgArea">`;

            messages.forEach(msg => {
                html += generateMessageHtml(msg);
            });

            html += `</div>
                <div class="chat-input-area">
                    <form id="chatForm" onsubmit="handleSend(event)">
                        <div class="input-wrapper">
                            <button type="button" class="action-icon" onclick="document.getElementById('fileImage').click()"><i class="bx bx-image-add"></i></button>
                            <button type="button" class="action-icon" onclick="document.getElementById('fileVideo').click()"><i class="bx bx-video-plus"></i></button>
                            <input type="text" id="chatInput" class="chat-input" placeholder="Nhập tin nhắn của bạn..." autocomplete="off">
                            <button type="submit" class="btn-send"><i class="bx bxs-send font-size-20"></i></button>
                        </div>
                    </form>
                    <input type="file" id="fileImage" accept="image/*" class="d-none" onchange="uploadMedia(this.files[0], 'image')">
                    <input type="file" id="fileVideo" accept="video/*" class="d-none" onchange="uploadMedia(this.files[0], 'video')">
                </div>`;

            chatMain.innerHTML = html;
            scrollToBottom();
        }

        function generateMessageHtml(msg) {
            const isMe = msg.senderId === currentAccountId;
            let displaySenderName = msg.senderName || "Ẩn danh";
            if (displaySenderName.includes('@@')) {
                displaySenderName = displaySenderName.split('@@')[0];
            }
            const avatar = msg.senderAvatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(displaySenderName)}&background=random&color=fff&rounded=true&bold=true`;
            const time = new Date(msg.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            
            let content = '';
            if(msg.messageType === 'text') {
                content = `<div class="msg-bubble">${escapeHtml(msg.content)}</div>`;
            } else if(msg.messageType === 'image') {
                content = `<img src="${msg.content}" class="msg-bubble p-1 bg-white" style="max-width: 300px; max-height: 300px; object-fit: cover;">`;
            } else if(msg.messageType === 'video') {
                content = `<video controls src="${msg.content}" class="msg-bubble p-1 bg-white" style="max-width: 300px; max-height: 300px;"></video>`;
            } else if(msg.messageType === 'product_card' && msg.product) {
                const img = msg.product.imageUrl || '/assets/images/no-image.png';
                content = `
                    <div class="msg-card">
                        <img src="${img}" class="msg-card-img">
                        <div class="msg-card-body">
                            <div class="msg-card-title">${escapeHtml(msg.product.name)}</div>
                            <div class="msg-card-price">${msg.product.price.toLocaleString()}đ</div>
                        </div>
                    </div>`;
            } else if(msg.messageType === 'voucher_card' && msg.voucher) {
                const disc = msg.voucher.discountType === 'Percent' ? msg.voucher.discountValue + '%' : msg.voucher.discountValue.toLocaleString() + 'đ';
                content = `
                    <div class="msg-voucher">
                        <div style="font-weight: 800; font-size: 1.2rem; margin-bottom: 4px;">GIẢM ${disc}</div>
                        <div style="font-size: 0.8rem; font-weight: 700; margin-bottom: 12px; opacity: 0.8;">Mã: ${msg.voucher.code}</div>
                        <div style="background: white; color: #b45309; padding: 4px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 800; display: inline-block;">DEAL ĐỘC QUYỀN</div>
                    </div>`;
            }

            return `
                <div class="msg-row ${isMe ? 'me' : ''}">
                    <img src="${avatar}" class="msg-avatar" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(displaySenderName)}&background=random&color=fff&rounded=true&bold=true'">
                    <div class="msg-content-wrapper">
                        ${content}
                        <div class="msg-time">${time}</div>
                    </div>
                </div>`;
        }

        function appendMsgToChat(msg) {
            const msgArea = document.getElementById("msgArea");
            if(msgArea) {
                msgArea.insertAdjacentHTML('beforeend', generateMessageHtml(msg));
                scrollToBottom();
            }
        }

        function handleSend(e) {
            e.preventDefault();
            if(!activeConversationId) return;
            const input = document.getElementById("chatInput");
            const content = input.value.trim();
            if(!content) return;
            
            connection.invoke("SendTextMessage", activeConversationId, content).then(() => {
                input.value = "";
            }).catch(console.error);
        }

        async function uploadMedia(file, type) {
            if(!file || !activeConversationId) return;
            const formData = new FormData();
            formData.append('file', file);
            formData.append('conversationId', activeConversationId);
            
            try {
                const res = await fetch('/Chat/UploadMedia', { method: 'POST', body: formData });
                const data = await res.json();
                if(data.url) {
                    connection.invoke("SendMediaMessage", activeConversationId, data.url, type);
                }
            } catch(e) { console.error(e); }
        }

        function updateSidebarPreview(convId, textPreview, isUnread) {
            const item = document.querySelector(`.conv-item[data-id="${convId}"]`);
            if(item) {
                const textElem = item.querySelector('.conv-text');
                const timeElem = item.querySelector('.conv-time');
                if(textElem) {
                    textElem.textContent = textPreview;
                    if(isUnread) textElem.classList.add('unread');
                }
                if(timeElem) {
                    timeElem.textContent = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                }
                if(isUnread) {
                    let unreadInd = item.querySelector('.unread-indicator');
                    if(!unreadInd) {
                        item.querySelector('.conv-message').insertAdjacentHTML('beforeend', '<div class="unread-indicator">Mới</div>');
                    }
                }
                // Move to top
                const list = document.getElementById("convList");
                list.insertBefore(item, list.firstChild);
            }
        }

        function updateSidebarItem(convId, msg, isUnread) {
            let preview = "";
            let prefix = msg.senderId === currentAccountId ? "Bạn: " : "";
            if(msg.messageType === "text") preview = prefix + msg.content;
            else if(msg.messageType === "image") preview = prefix + "[Hình ảnh]";
            else if(msg.messageType === "video") preview = prefix + "[Video]";
            else if(msg.messageType === "product_card") preview = prefix + "[Sản phẩm]";
            else if(msg.messageType === "voucher_card") preview = prefix + "[Voucher]";
            updateSidebarPreview(convId, preview, isUnread);
        }

        function scrollToBottom() {
            const msgArea = document.getElementById("msgArea");
            if(msgArea) msgArea.scrollTop = msgArea.scrollHeight;
        }

        function escapeHtml(unsafe) {
            if(!unsafe) return '';
            return unsafe
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        }

        function showToast(title, msg, convId) {
            const container = document.getElementById('toastContainer');
            const id = 'toast_' + Date.now();
            const html = `
                <div class="chat-toast" id="${id}" onclick="loadConversation(${convId}); document.getElementById('${id}').remove()">
                    <div class="chat-toast-content">
                        <h6>${escapeHtml(title)}</h6>
                        <p>${escapeHtml(msg)}</p>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', html);
            setTimeout(() => {
                const el = document.getElementById(id);
                if(el) {
                    el.style.opacity = '0';
                    el.style.transform = 'translateY(20px)';
                    setTimeout(() => el.remove(), 300);
                }
            }, 5000);
        }
    </script>
}
