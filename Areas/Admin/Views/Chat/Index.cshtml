@model IEnumerable<DOAN_BANHANG.Models.Conversation>
@using DOAN_BANHANG.Helpers
@{
    ViewData["Title"] = "Kênh Chat Khách Hàng";
    var activeConv = ViewBag.ActiveConversation as DOAN_BANHANG.Models.Conversation;
    var messages = ViewBag.Messages as List<DOAN_BANHANG.Models.Message> ?? new List<DOAN_BANHANG.Models.Message>();
    var currentAccountId = ViewBag.CurrentAccountId != null ? (int)ViewBag.CurrentAccountId : 0;
    var unreadMap = ViewBag.UnreadByConv as Dictionary<int, int> ?? new Dictionary<int, int>();
    var onlineIds = ViewBag.OnlineIds as HashSet<int> ?? new HashSet<int>();
    var vouchers = ViewBag.Vouchers as List<DOAN_BANHANG.Models.Voucher> ?? new List<DOAN_BANHANG.Models.Voucher>();
}

<style>
    .seller-chat-wrap {
        display: flex; height: calc(100vh - 135px); min-height: 600px;
        background: #ffffff; border-radius: 26px; border: 1px solid #e6f0ef;
        box-shadow: 0 22px 54px -16px rgba(8, 129, 120, 0.14), 0 4px 16px rgba(15, 23, 42, 0.04);
        overflow: hidden; font-family: "Be Vietnam Pro", sans-serif;
    }

    /* Pane 1: Soft Mint-Slate Pastel Sidebar */
    .sc-pane-left { width: 325px; flex-shrink: 0; border-right: 1px solid #dbe9e7; display: flex; flex-direction: column; background: linear-gradient(180deg, #e7f6f3 0%, #f1f8f7 45%, #f8fafc 100%); }
    .sc-left-hd { padding: 20px 18px 14px; border-bottom: 1px solid #d7eae7; color: #0f172a; }
    .sc-left-title { font-size: 17px; font-weight: 800; color: #0f172a; margin: 0 0 12px; display: flex; align-items: center; justify-content: space-between; letter-spacing: -0.015em; }
    .sc-search { position: relative; margin-bottom: 10px; }
    .sc-search input { width: 100%; height: 38px; padding: 0 14px 0 36px; border-radius: 999px; border: 1px solid #cfe3e0; background: #ffffff; color: #0f172a; font-size: 13px; outline: none; transition: all 0.2s; }
    .sc-search input::placeholder { color: #94a3b8; }
    .sc-search input:focus { border-color: #088178; background: #ffffff; box-shadow: 0 0 0 3px rgba(8,129,120,0.12); }
    .sc-search i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #088178; font-size: 15px; }
    .sc-tabs { display: flex; gap: 4px; background: #d9ece9; padding: 4px; border-radius: 999px; }
    .sc-tab { flex: 1; padding: 6px 10px; border-radius: 999px; border: none; background: transparent; color: #335c58; font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.18s; }
    .sc-tab.is-active { background: #088178; color: #ffffff; box-shadow: 0 3px 10px rgba(8,129,120,0.22); }

    .sc-conv-list { flex: 1; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 6px; }
    .sc-conv-item { display: flex; align-items: center; gap: 11px; padding: 11px 12px; border-radius: 16px; cursor: pointer; border: 1px solid #e1efed; background: #ffffff; transition: all 0.18s; color: #0f172a; }
    .sc-conv-item:hover { border-color: #99f6e4; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(8,129,120,0.08); }
    .sc-conv-item.is-active { background: #ffffff; border: 1.5px solid #088178; box-shadow: 0 6px 16px rgba(8,129,120,0.12); }
    .sc-avt-box { position: relative; width: 43px; height: 43px; flex-shrink: 0; }
    .sc-avt { width: 43px; height: 43px; border-radius: 50%; object-fit: cover; background: linear-gradient(135deg, #14b8a6 0%, #088178 100%); color: #ffffff; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 2px solid #ffffff; box-shadow: 0 3px 8px rgba(8,129,120,0.16); }
    .sc-dot { position: absolute; right: 0; bottom: 0; width: 11px; height: 11px; border-radius: 50%; background: #cbd5e1; border: 2px solid #ffffff; }
    .sc-dot.is-online { background: #22c55e; }
    .sc-badge { min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: linear-gradient(135deg, #fb7185 0%, #e11d48 100%); color: #ffffff; font-size: 10.5px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }

    /* Pane 2: Center Clean Neutral Stream */
    .sc-pane-center { flex: 1; display: flex; flex-direction: column; min-width: 0; background: #f6f8fb; }
    .sc-center-hd { padding: 14px 20px; background: #ffffff; border-bottom: 1px solid #e5ecf2; display: flex; align-items: center; justify-content: space-between; }
    .sc-stream { flex: 1; overflow-y: auto; padding: 20px 22px; display: flex; flex-direction: column; gap: 11px; }
    .sc-date-sep { text-align: center; margin: 10px 0 4px; }
    .sc-date-sep span { padding: 4px 13px; border-radius: 999px; background: #e8eef3; color: #475569; font-size: 11px; font-weight: 600; }

    .sc-row { display: flex; flex-direction: column; max-width: 76%; }
    .sc-row.is-me { align-self: flex-end; align-items: flex-end; }
    .sc-row.is-other { align-self: flex-start; align-items: flex-start; }
    .sc-bubble { padding: 11px 15px; border-radius: 20px; font-size: 13.5px; line-height: 1.52; word-break: break-word; }
    .sc-row.is-me .sc-bubble { background: linear-gradient(135deg, #0d9488 0%, #088178 100%); color: #ffffff; border-bottom-right-radius: 6px; box-shadow: 0 6px 16px -4px rgba(8,129,120,0.28); }
    .sc-row.is-other .sc-bubble { background: #ffffff; color: #0f172a; border: 1px solid #e2e8f0; border-bottom-left-radius: 6px; box-shadow: 0 3px 10px -2px rgba(15,23,42,0.05); }
    .sc-foot { font-size: 11px; color: #94a3b8; margin-top: 3px; display: flex; align-items: center; gap: 6px; padding: 0 4px; }
    .sc-recall { opacity: 0; border: none; background: none; color: #94a3b8; font-size: 11px; cursor: pointer; padding: 0; }
    .sc-row:hover .sc-recall { opacity: 1; }
    .sc-recall:hover { color: #ef4444; text-decoration: underline; }

    .sc-prod-card { display: flex; align-items: center; gap: 10px; padding: 9px; border-radius: 14px; background: #ffffff; border: 1px solid #e2e8f0; color: #0f172a; text-decoration: none; margin-bottom: 6px; min-width: 230px; }
    .sc-prod-card img { width: 48px; height: 48px; border-radius: 10px; object-fit: cover; flex-shrink: 0; }
    .sc-voucher-card { padding: 10px 12px; border-radius: 14px; background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border: 1px dashed #f59e0b; color: #92400e; margin-bottom: 6px; min-width: 220px; }
    .sc-typing { padding: 0 22px 4px; font-size: 12px; color: #088178; font-style: italic; min-height: 18px; }

    .sc-quick-bar { padding: 6px 18px 8px; background: transparent; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
    .sc-quick-bar::-webkit-scrollbar { display: none; }
    .sc-quick-chip { white-space: nowrap; font-size: 11.5px; font-weight: 700; color: #065f5b; background: #ffffff; border: 1px solid #cfe5e2; border-radius: 999px; padding: 5px 12px; cursor: pointer; transition: all 0.18s; }
    .sc-quick-chip:hover { background: #088178; color: #ffffff; border-color: #088178; }

    .sc-composer { margin: 0 18px 16px; padding: 6px 7px 6px 9px; background: #ffffff; border: 1.5px solid #dbe4ee; border-radius: 999px; display: flex; align-items: center; gap: 8px; box-shadow: 0 8px 24px -6px rgba(15,23,42,0.07); transition: all 0.2s; }
    .sc-composer:focus-within { border-color: #088178; box-shadow: 0 10px 26px -6px rgba(8,129,120,0.18); }
    .sc-tool-btn { width: 36px; height: 36px; border-radius: 50%; border: none; background: #eaf6f4; color: #088178; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: all 0.18s; }
    .sc-tool-btn:hover { background: #088178; color: #ffffff; }
    .sc-composer input[type="text"] { flex: 1; height: 38px; padding: 0 10px; border: none; background: transparent; font-size: 13.5px; outline: none; }
    .sc-send-btn { height: 38px; padding: 0 20px; border-radius: 999px; border: none; background: linear-gradient(135deg, #0d9488 0%, #088178 100%); color: #ffffff; font-weight: 700; font-size: 13px; cursor: pointer; flex-shrink: 0; box-shadow: 0 5px 14px -3px rgba(8,129,120,0.34); }
    .sc-send-btn:hover { opacity: 0.94; }

    /* Pane 3: Right Customer Order & Dispute Context */
    .sc-pane-right { width: 305px; flex-shrink: 0; border-left: 1px solid #e2e8f0; background: #ffffff; display: flex; flex-direction: column; overflow-y: auto; padding: 16px; gap: 14px; }
    .sc-ctx-card { border: 1px solid #e2e8f0; border-radius: 18px; padding: 14px; background: #f8fafc; }
    .sc-ctx-title { font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #475569; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; }
    .sc-kpi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
    .sc-kpi-box { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 9px; text-align: center; }
    .sc-order-mini { display: block; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 10px 12px; margin-bottom: 8px; text-decoration: none; color: inherit; transition: all 0.18s; }
    .sc-order-mini:hover { border-color: #0284c7; background: #f0f9ff; transform: translateY(-1px); }
    .sc-status-pill { font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: #eff6ff; color: #1d4ed8; }

    .sc-lightbox { position: fixed; inset: 0; z-index: 100080; background: rgba(15,23,42,0.85); backdrop-filter: blur(6px); display: none; align-items: center; justify-content: center; cursor: zoom-out; }
    .sc-lightbox.is-open { display: flex; }
    .sc-lightbox img { max-width: 90vw; max-height: 88vh; border-radius: 18px; }

    @@media (max-width: 1180px) { .sc-pane-right { display: none; } }
</style>

<div class="seller-chat-wrap">
    <!-- CỘT 1: DANH SÁCH KHÁCH HÀNG -->
    <aside class="sc-pane-left">
        <div class="sc-left-hd">
            <div class="sc-left-title">
                <span>Kênh Chat Khách Hàng</span>
                <span class="sc-badge" id="sc-total-unread" style="display:@(unreadMap.Values.Sum() > 0 ? "inline-flex" : "none");">@unreadMap.Values.Sum()</span>
            </div>
            <div class="sc-search">
                <i class="bx bx-search"></i>
                <input type="text" id="sc-search-input" placeholder="Tìm tên khách hàng..." />
            </div>
            <div class="sc-tabs">
                <button type="button" class="sc-tab is-active" data-filter="all">Tất cả (@Model.Count())</button>
                <button type="button" class="sc-tab" data-filter="unread">Chưa đọc</button>
            </div>
        </div>

        <div class="sc-conv-list" id="sc-conv-list">
            @if (!Model.Any())
            {
                <div style="text-align:center; padding:36px 14px; color:#94a3b8; font-size:13px;">Chưa có tin nhắn nào từ khách hàng.</div>
            }
            else
            {
                foreach (var c in Model)
                {
                    var cust = c.Customer;
                    var custId = cust?.Id ?? 0;
                    var custName = cust?.Profile?.FullName ?? cust?.Email?.Split('@')[0] ?? "Khách hàng";
                    var custAvt = ImageUrlHelper.NormalizeStaticFileUrl(cust?.Profile?.AvatarUrl);
                    var unread = unreadMap.TryGetValue(c.Id, out var u) ? u : 0;
                    var isOnline = onlineIds.Contains(custId);
                    var lastMsg = c.Messages.FirstOrDefault();
                    var prevText = lastMsg == null ? "Chưa có tin nhắn"
                        : lastMsg.MessageType == "image" ? "[Hình ảnh]"
                        : lastMsg.MessageType == "video" ? "[Video]"
                        : lastMsg.MessageType == "product_card" ? "[Sản phẩm] " + lastMsg.Content
                        : lastMsg.MessageType == "voucher_card" ? "[Voucher] " + lastMsg.Content
                        : (lastMsg.Content ?? "");
                    bool isAct = activeConv != null && activeConv.Id == c.Id;

                    <div class="sc-conv-item @(isAct ? "is-active" : "") @(unread > 0 ? "has-unread" : "")"
                         data-conv-id="@c.Id"
                         data-customer-id="@custId"
                         data-search="@custName.ToLowerInvariant()">
                        <div class="sc-avt-box">
                            @if (!string.IsNullOrWhiteSpace(custAvt) && !custAvt.Contains("placeholder"))
                            {
                                <img class="sc-avt" src="@custAvt" alt="@custName" />
                            }
                            else
                            {
                                <div class="sc-avt">@(custName.Substring(0, 1).ToUpper())</div>
                            }
                            <span class="sc-dot @(isOnline ? "is-online" : "")" data-presence-user="@custId"></span>
                        </div>
                        <div style="flex:1; min-width:0;">
                            <div style="display:flex; justify-content:space-between; align-items:center; gap:6px;">
                                <strong style="font-size:13px; color:#0f172a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@custName</strong>
                                <span style="font-size:10.5px; color:#94a3b8; flex-shrink:0;">@c.LastMessageAt.AddHours(7).ToString("HH:mm")</span>
                            </div>
                            <div style="display:flex; justify-content:space-between; align-items:center; gap:6px; margin-top:2px;">
                                <span class="sc-preview" style="font-size:12px; color:#64748b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@prevText</span>
                                <span class="sc-badge" style="display:@(unread > 0 ? "inline-flex" : "none");">@unread</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </aside>

    <!-- CỘT 2: KHUNG CHAT REALTIME -->
    <main class="sc-pane-center">
        @if (activeConv == null)
        {
            <div style="flex:1; display:flex; align-items:center; justify-content:center; color:#94a3b8; font-size:14px;">
                Chọn một khách hàng ở cột bên trái để bắt đầu tư vấn.
            </div>
        }
        else
        {
            var actCust = activeConv.Customer;
            var actName = actCust?.Profile?.FullName ?? actCust?.Email?.Split('@')[0] ?? "Khách hàng";
            <div class="sc-center-hd">
                <div style="display:flex; align-items:center; gap:10px;">
                    <div>
                        <strong id="sc-hd-name" style="font-size:15px; color:#0f172a;">@actName</strong>
                        <div id="sc-hd-status" style="font-size:12px; color:@(onlineIds.Contains(activeConv.CustomerId) ? "#16a34a" : "#64748b"); font-weight:600;">
                            @(onlineIds.Contains(activeConv.CustomerId) ? "● Đang trực tuyến" : "○ Ngoại tuyến")
                        </div>
                    </div>
                </div>
                <div style="display:flex; gap:8px;">
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill" data-bs-toggle="modal" data-bs-target="#scProductModal">
                        <i class="bx bx-shopping-bag"></i> Gửi sản phẩm
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning rounded-pill" data-bs-toggle="modal" data-bs-target="#scVoucherModal">
                        <i class="bx bx-purchase-tag"></i> Gửi Voucher
                    </button>
                </div>
            </div>

            <div class="sc-stream" id="sc-stream"></div>
            <div class="sc-typing" id="sc-typing"></div>

            <div class="sc-quick-bar">
                <button type="button" class="sc-quick-chip" data-quick="Dạ sản phẩm hiện vẫn còn hàng sẵn ạ, bạn đặt đơn shop giao ngay nhé!">Còn hàng sẵn</button>
                <button type="button" class="sc-quick-chip" data-quick="Dạ đơn hàng dự kiến giao từ 2–3 ngày làm việc ạ.">Thời gian giao 2-3 ngày</button>
                <button type="button" class="sc-quick-chip" data-quick="Shop gửi bạn mã giảm giá ưu đãi riêng cho đơn này nhé!">Tặng mã ưu đãi</button>
                <button type="button" class="sc-quick-chip" data-quick="Cảm ơn bạn đã tin tưởng ủng hộ gian hàng trên Sellzy ạ!">Cảm ơn khách</button>
            </div>

            <div class="sc-composer">
                <input type="file" id="sc-file-input" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm" style="display:none;" />
                <button type="button" id="sc-upload-btn" class="sc-tool-btn" title="Gửi ảnh / video (hoặc dán Ctrl+V)"><i class="bx bx-image-add fs-5"></i></button>
                <input type="text" id="sc-msg-input" placeholder="Nhập phản hồi cho khách hàng (Enter để gửi, Ctrl+V dán ảnh)..." autocomplete="off" />
                <button type="button" id="sc-send-btn" class="sc-send-btn">Gửi</button>
            </div>
        }
    </main>

    <!-- CỘT 3 (PHƯƠNG ÁN 3): NGỮ CẢNH ĐƠN HÀNG & KHIẾU NẠI CỦA KHÁCH -->
    <aside class="sc-pane-right" id="sc-context-pane">
        <div class="sc-ctx-card">
            <div class="sc-ctx-title"><span>Hồ sơ khách hàng</span></div>
            <div style="font-weight:700; font-size:14.5px; color:#0f172a;" id="ctx-cust-name">—</div>
            <div style="font-size:12px; color:#64748b; margin-top:2px;" id="ctx-cust-email">—</div>
            <div style="font-size:12px; color:#64748b;" id="ctx-cust-phone">—</div>
            <div class="sc-kpi-grid">
                <div class="sc-kpi-box">
                    <div style="font-size:11px; color:#64748b;">Đơn tại Shop</div>
                    <div style="font-size:16px; font-weight:800; color:#088178;" id="ctx-total-orders">0</div>
                </div>
                <div class="sc-kpi-box">
                    <div style="font-size:11px; color:#64748b;">Tổng chi tiêu</div>
                    <div style="font-size:13.5px; font-weight:800; color:#0f172a;" id="ctx-total-spent">0đ</div>
                </div>
            </div>
        </div>

        <div class="sc-ctx-card">
            <div class="sc-ctx-title"><span>Đơn hàng gần nhất</span></div>
            <div id="ctx-orders-list" style="font-size:12.5px; color:#64748b;">Đang tải...</div>
        </div>

        <div class="sc-ctx-card">
            <div class="sc-ctx-title"><span>Khiếu nại đang mở</span></div>
            <div id="ctx-disputes-list" style="font-size:12.5px; color:#64748b;">Không có khiếu nại nào.</div>
        </div>
    </aside>
</div>

<!-- Modal Gửi Voucher -->
<div class="modal fade" id="scVoucherModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Gửi Voucher cho khách hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="max-height:380px; overflow-y:auto;">
                @if (!vouchers.Any())
                {
                    <div class="text-muted text-center py-3">Gian hàng chưa có mã Voucher nào đang hoạt động.</div>
                }
                else
                {
                    foreach (var v in vouchers)
                    {
                        var desc = v.DiscountType == "Percent" ? $"Giảm {v.DiscountValue:0.#}%" : $"Giảm {v.DiscountValue:N0}đ";
                        <div class="d-flex align-items-center justify-content-between p-3 mb-2 border rounded-3 bg-light">
                            <div>
                                <div class="fw-bold text-dark">@v.Code <span class="badge bg-success ms-1">@desc</span></div>
                                <small class="text-muted">Đơn tối thiểu @v.MinOrderValue.ToString("N0")đ • HSD: @v.EndDate.AddHours(7).ToString("dd/MM/yyyy")</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-success rounded-pill sc-send-voucher-btn" data-voucher-id="@v.Id" data-bs-dismiss="modal">Gửi</button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Tìm & Gửi Sản Phẩm -->
<div class="modal fade" id="scProductModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Gửi thẻ sản phẩm tư vấn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="sc-prod-search" class="form-control rounded-pill mb-3" placeholder="Nhập tên sản phẩm của Shop để tìm..." />
                <div id="sc-prod-results" style="max-height:340px; overflow-y:auto;"></div>
            </div>
        </div>
    </div>
</div>

<div class="sc-lightbox" id="sc-lightbox" onclick="this.classList.remove('is-open')">
    <img id="sc-lightbox-img" src="" alt="" />
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        (function () {
            const currentAccountId = @currentAccountId;
            let activeConvId = @(activeConv?.Id ?? 0);
            let activeCustomerId = @(activeConv?.CustomerId ?? 0);
            let typingTimer = null, isTypingSent = false, lastDate = null;

            const stream = document.getElementById('sc-stream');
            const input = document.getElementById('sc-msg-input');
            const typingEl = document.getElementById('sc-typing');

            function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
            function fmtMoney(v) { return Number(v || 0).toLocaleString('vi-VN') + 'đ'; }
            function fmtTime(iso) { return new Date(iso).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }); }
            function dateLbl(iso) {
                const d = new Date(iso).toLocaleDateString('vi-VN');
                const today = new Date().toLocaleDateString('vi-VN');
                const y = new Date(); y.setDate(y.getDate() - 1);
                if (d === today) return 'Hôm nay';
                if (d === y.toLocaleDateString('vi-VN')) return 'Hôm qua';
                return d;
            }

            function appendMsg(m) {
                if (!stream) return;
                const dl = dateLbl(m.createdAt);
                if (dl !== lastDate) {
                    lastDate = dl;
                    const sep = document.createElement('div');
                    sep.className = 'sc-date-sep';
                    sep.innerHTML = `<span>${esc(dl)}</span>`;
                    stream.appendChild(sep);
                }

                const isMe = m.senderId === currentAccountId;
                const row = document.createElement('div');
                row.className = 'sc-row ' + (isMe ? 'is-me' : 'is-other');
                row.setAttribute('data-msg-id', m.id);

                let inner = '';
                if (m.messageType === 'product_card' && m.product) {
                    inner += `<a href="/product/${encodeURIComponent(m.product.slug || '')}" target="_blank" class="sc-prod-card">
                        <img src="${esc(m.product.imageUrl || '/assets/images/placeholder.png')}" alt="" />
                        <div style="min-width:0; flex:1;">
                            <div style="font-size:12.5px; font-weight:700; color:#0f172a; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${esc(m.product.name)}</div>
                            <div style="font-size:12px; font-weight:800; color:#088178;">${fmtMoney(m.product.price)}</div>
                        </div>
                    </a>`;
                } else if (m.messageType === 'voucher_card' && m.voucher) {
                    const desc = m.voucher.discountType === 'Percent' ? `Giảm ${m.voucher.discountValue}%` : `Giảm ${fmtMoney(m.voucher.discountValue)}`;
                    inner += `<div class="sc-voucher-card"><strong>🎟️ ${esc(m.voucher.code)}</strong><div style="font-size:12px;">${desc} • HSD: ${esc(m.voucher.endDate)}</div></div>`;
                }

                if (m.messageType === 'image') {
                    inner += `<img src="${esc(m.content)}" style="max-width:220px; max-height:220px; border-radius:10px; cursor:zoom-in; display:block;" onclick="document.getElementById('sc-lightbox-img').src=this.src; document.getElementById('sc-lightbox').classList.add('is-open');" />`;
                } else if (m.messageType === 'video') {
                    inner += `<video src="${esc(m.content)}" controls style="max-width:240px; border-radius:10px; display:block;"></video>`;
                } else if (m.content) {
                    inner += `<div>${esc(m.content).replace(/\n/g, '<br/>')}</div>`;
                }

                const tick = isMe ? `<span class="sc-read-tick">${m.isReadByCustomer ? '✓✓ Đã xem' : '✓ Đã gửi'}</span>` : '';
                const canRecall = isMe && ((Date.now() - new Date(m.createdAt).getTime()) < 5 * 60 * 1000);
                const recall = canRecall ? `<button type="button" class="sc-recall" data-recall-id="${m.id}">Thu hồi</button>` : '';

                row.innerHTML = `<div class="sc-bubble">${inner}</div><div class="sc-foot">${fmtTime(m.createdAt)} ${tick} ${recall}</div>`;
                stream.appendChild(row);
                stream.scrollTop = stream.scrollHeight;
            }

            function renderContext(conv, ctx) {
                document.getElementById('ctx-cust-name').textContent = conv.customerName || 'Khách hàng';
                document.getElementById('ctx-cust-email').textContent = conv.customerEmail || '';
                document.getElementById('ctx-cust-phone').textContent = 'SĐT: ' + (conv.customerPhone || 'Chưa cập nhật');
                document.getElementById('ctx-total-orders').textContent = ctx.totalOrders ?? 0;
                document.getElementById('ctx-total-spent').textContent = fmtMoney(ctx.totalSpent ?? 0);

                const ordersBox = document.getElementById('ctx-orders-list');
                if (!ctx.recentOrders || ctx.recentOrders.length === 0) {
                    ordersBox.innerHTML = '<div class="text-muted">Khách chưa có đơn hàng nào với gian hàng.</div>';
                } else {
                    ordersBox.innerHTML = ctx.recentOrders.map(o => `
                        <a href="/Admin/Orders/Details/${o.id}" target="_blank" class="sc-order-mini">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <strong style="font-size:12.5px; color:#0f172a;">#${esc(o.orderCode)}</strong>
                                <span class="sc-status-pill">${esc(o.orderStatus)}</span>
                            </div>
                            <div style="font-size:12px; color:#088178; font-weight:700; margin-top:3px;">${fmtMoney(o.finalAmount)} <span style="color:#64748b; font-weight:500;">(${esc(o.paymentMethod)})</span></div>
                        </a>`).join('');
                }

                const dispBox = document.getElementById('ctx-disputes-list');
                if (!ctx.activeDisputes || ctx.activeDisputes.length === 0) {
                    dispBox.innerHTML = '<div class="text-muted">Không có khiếu nại nào.</div>';
                } else {
                    dispBox.innerHTML = ctx.activeDisputes.map(d => `
                        <a href="/Admin/Disputes/Details/${d.id}" target="_blank" class="sc-order-mini" style="border-color:#fecaca; background:#fef2f2;">
                            <div style="font-size:12px; font-weight:700; color:#b91c1c;">${esc(d.disputeCode)} (${esc(d.orderCode)})</div>
                            <div style="font-size:11.5px; color:#7f1d1d;">${esc(d.reasonTitle)}</div>
                            <div style="font-size:11px; color:#991b1b; margin-top:2px;">Trạng thái: <strong>${esc(d.status)}</strong></div>
                        </a>`).join('');
                }
            }

            async function loadConversation(convId) {
                if (!convId) return;
                const res = await fetch('/Admin/Chat/GetMessages/' + convId);
                if (!res.ok) return;
                const data = await res.json();
                activeCustomerId = data.conversation.customerId;

                document.getElementById('sc-hd-name').textContent = data.conversation.customerName;
                const st = document.getElementById('sc-hd-status');
                st.textContent = data.conversation.isOnline ? '● Đang trực tuyến' : '○ Ngoại tuyến';
                st.style.color = data.conversation.isOnline ? '#16a34a' : '#64748b';

                if (stream) {
                    stream.innerHTML = '';
                    lastDate = null;
                    if (!data.messages.length) {
                        stream.innerHTML = '<div style="text-align:center; color:#94a3b8; margin:auto;">Chưa có tin nhắn nào.</div>';
                    } else {
                        data.messages.forEach(appendMsg);
                    }
                }
                renderContext(data.conversation, data.customerContext);
            }

            // SignalR
            const conn = new signalR.HubConnectionBuilder().withUrl('/chathub').withAutomaticReconnect().build();

            conn.on('ReceiveMessage', m => {
                if (m.conversationId === activeConvId) {
                    appendMsg(m);
                    if (m.senderId !== currentAccountId) conn.invoke('MarkRead', activeConvId).catch(() => {});
                } else {
                    const item = document.querySelector(`.sc-conv-item[data-conv-id="${m.conversationId}"]`);
                    if (item) {
                        item.classList.add('has-unread');
                        const b = item.querySelector('.sc-badge');
                        if (b) { b.textContent = (parseInt(b.textContent || '0') || 0) + 1; b.style.display = 'inline-flex'; }
                        const p = item.querySelector('.sc-preview');
                        if (p) p.textContent = m.messageType === 'image' ? '[Hình ảnh]' : (m.content || '');
                    }
                }
            });

            conn.on('MessagesRead', p => {
                if (p.conversationId === activeConvId && p.readByAccountId !== currentAccountId) {
                    document.querySelectorAll('.sc-read-tick').forEach(el => el.textContent = '✓✓ Đã xem');
                }
            });

            conn.on('UserTyping', p => {
                if (p.conversationId === activeConvId && typingEl) {
                    typingEl.textContent = p.isTyping ? 'Khách hàng đang nhập tin nhắn...' : '';
                }
            });

            conn.on('UserPresenceChanged', p => {
                document.querySelectorAll(`[data-presence-user="${p.accountId}"]`).forEach(d => d.classList.toggle('is-online', p.isOnline));
                if (p.accountId === activeCustomerId) {
                    const st = document.getElementById('sc-hd-status');
                    if (st) { st.textContent = p.isOnline ? '● Đang trực tuyến' : '○ Ngoại tuyến'; st.style.color = p.isOnline ? '#16a34a' : '#64748b'; }
                }
            });

            conn.on('MessageRecalled', p => {
                if (p.conversationId === activeConvId) {
                    const row = document.querySelector(`.sc-row[data-msg-id="${p.messageId}"]`);
                    if (row) {
                        const b = row.querySelector('.sc-bubble');
                        if (b) { b.style.opacity = '0.6'; b.style.fontStyle = 'italic'; b.innerHTML = 'Tin nhắn đã được thu hồi'; }
                        row.querySelector('.sc-recall')?.remove();
                    }
                }
            });

            conn.start().then(async () => {
                if (activeConvId > 0) {
                    await loadConversation(activeConvId);
                    conn.invoke('JoinConversation', activeConvId).catch(() => {});
                }
            }).catch(console.error);

            // Chuyển hội thoại
            document.querySelectorAll('.sc-conv-item').forEach(item => {
                item.addEventListener('click', async function () {
                    const id = parseInt(this.getAttribute('data-conv-id'));
                    if (!id || id === activeConvId) return;
                    if (activeConvId > 0) conn.invoke('LeaveConversation', activeConvId).catch(() => {});
                    activeConvId = id;
                    document.querySelectorAll('.sc-conv-item').forEach(x => x.classList.remove('is-active'));
                    this.classList.add('is-active');
                    this.classList.remove('has-unread');
                    const b = this.querySelector('.sc-badge');
                    if (b) { b.textContent = '0'; b.style.display = 'none'; }
                    await loadConversation(activeConvId);
                    conn.invoke('JoinConversation', activeConvId).catch(() => {});
                });
            });

            // Gửi tin
            async function sendText() {
                if (!input || !activeConvId) return;
                const txt = input.value.trim();
                if (!txt) return;
                input.value = '';
                conn.invoke('SendTyping', activeConvId, false).catch(() => {});
                isTypingSent = false;
                await conn.invoke('SendTextMessage', activeConvId, txt);
            }
            document.getElementById('sc-send-btn')?.addEventListener('click', sendText);
            input?.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendText(); } });
            input?.addEventListener('input', () => {
                if (!activeConvId) return;
                if (!isTypingSent) { isTypingSent = true; conn.invoke('SendTyping', activeConvId, true).catch(() => {}); }
                clearTimeout(typingTimer);
                typingTimer = setTimeout(() => { isTypingSent = false; conn.invoke('SendTyping', activeConvId, false).catch(() => {}); }, 1500);
            });

            // Upload / Paste media
            async function uploadMedia(file) {
                if (!file || !activeConvId) return;
                const fd = new FormData(); fd.append('file', file);
                const res = await fetch('/Chat/UploadMedia', { method: 'POST', body: fd });
                const data = await res.json().catch(() => null);
                if (!res.ok) { alert(data?.error || 'Tải tệp thất bại.'); return; }
                await conn.invoke('SendMediaMessage', activeConvId, data.url, data.type);
            }
            document.getElementById('sc-upload-btn')?.addEventListener('click', () => document.getElementById('sc-file-input')?.click());
            document.getElementById('sc-file-input')?.addEventListener('change', async function () {
                if (this.files?.[0]) { await uploadMedia(this.files[0]); this.value = ''; }
            });
            input?.addEventListener('paste', async e => {
                for (const it of (e.clipboardData?.items || [])) {
                    if (it.type.startsWith('image/')) { e.preventDefault(); await uploadMedia(it.getAsFile()); break; }
                }
            });

            // Thu hồi
            stream?.addEventListener('click', e => {
                const btn = e.target.closest('.sc-recall');
                if (!btn) return;
                const id = parseInt(btn.getAttribute('data-recall-id'));
                if (id && confirm('Thu hồi tin nhắn này?')) conn.invoke('RecallMessage', id).catch(console.error);
            });

            // Quick Replies
            document.querySelectorAll('.sc-quick-chip').forEach(c => {
                c.addEventListener('click', () => { if (input) { input.value = c.getAttribute('data-quick'); sendText(); } });
            });

            // Gửi Voucher
            document.querySelectorAll('.sc-send-voucher-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const vid = parseInt(this.getAttribute('data-voucher-id'));
                    if (vid && activeConvId) await conn.invoke('SendVoucherCard', activeConvId, vid, null);
                });
            });

            // Tìm & gửi Sản phẩm của Shop
            async function loadShopProducts(q) {
                const box = document.getElementById('sc-prod-results');
                if (!box) return;
                box.innerHTML = '<div class="text-muted text-center py-3">Đang tải sản phẩm...</div>';
                const res = await fetch('/Admin/Chat/SearchProducts?q=' + encodeURIComponent(q || ''));
                if (!res.ok) return;
                const list = await res.json();
                if (!list.length) { box.innerHTML = '<div class="text-muted text-center py-3">Không tìm thấy sản phẩm nào.</div>'; return; }
                box.innerHTML = list.map(p => `
                    <div class="d-flex align-items-center justify-content-between p-2 mb-2 border rounded-3">
                        <div class="d-flex align-items-center gap-2" style="min-width:0;">
                            <img src="${esc(p.imageUrl || '/assets/images/placeholder.png')}" style="width:42px; height:42px; border-radius:8px; object-fit:cover;" />
                            <div style="min-width:0;">
                                <div class="fw-semibold text-truncate" style="font-size:13px; max-width:260px;">${esc(p.name)}</div>
                                <div style="font-size:12px; color:#088178; font-weight:700;">${fmtMoney(p.price)}</div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-success rounded-pill sc-pick-prod-btn" data-prod-id="${p.id}" data-bs-dismiss="modal">Gửi</button>
                    </div>`).join('');
            }
            document.getElementById('scProductModal')?.addEventListener('shown.bs.modal', () => loadShopProducts(''));
            document.getElementById('sc-prod-search')?.addEventListener('input', e => loadShopProducts(e.target.value));
            document.getElementById('sc-prod-results')?.addEventListener('click', async e => {
                const btn = e.target.closest('.sc-pick-prod-btn');
                if (!btn || !activeConvId) return;
                await conn.invoke('SendProductCard', activeConvId, parseInt(btn.getAttribute('data-prod-id')), null);
            });

            // Tìm kiếm & lọc Chưa đọc
            let filterMode = 'all';
            function applyFilter() {
                const q = (document.getElementById('sc-search-input')?.value || '').trim().toLowerCase();
                document.querySelectorAll('.sc-conv-item').forEach(el => {
                    const okText = !q || (el.getAttribute('data-search') || '').includes(q);
                    const okUnread = filterMode === 'all' || el.classList.contains('has-unread');
                    el.style.display = (okText && okUnread) ? 'flex' : 'none';
                });
            }
            document.getElementById('sc-search-input')?.addEventListener('input', applyFilter);
            document.querySelectorAll('.sc-tab').forEach(t => {
                t.addEventListener('click', function () {
                    document.querySelectorAll('.sc-tab').forEach(x => x.classList.remove('is-active'));
                    this.classList.add('is-active');
                    filterMode = this.getAttribute('data-filter');
                    applyFilter();
                });
            });
        })();
    </script>
}
