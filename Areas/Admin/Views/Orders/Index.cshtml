@model DOAN_BANHANG.ViewModels.AdminOrderListVm
@{
    ViewData["Title"] = "Quản lý đơn hàng";

    var isSignedIn = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;
    var isShop = User?.IsInRole("Shop") ?? false;

    var activeStatus = (Model.Query.Status ?? string.Empty).Trim();
    var statusTabs = new (string? status, string label)[]
    {
        (null, "Tất cả"),
        ("Pending", "Chờ xác nhận"),
        ("Confirmed", "Đã xác nhận"),
        ("Rejected", "Đã từ chối"),
        ("Cancelled", "Đã hủy")
    };

    (string label, string badgeClass, string icon) ResolveStatusUi(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "pending" => ("Chờ xác nhận", "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle", "bx bx-time-five"),
            "confirmed" => ("Đã xác nhận", "badge bg-success-subtle text-success-emphasis border border-success-subtle", "bx bx-check-circle"),
            "rejected" => ("Đã từ chối", "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle", "bx bx-x-circle"),
            "cancelled" or "canceled" => ("Đã hủy", "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle", "bx bx-x-circle"),
            _ => (string.IsNullOrWhiteSpace(s) ? "(không rõ)" : s, "badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle", "bx bx-info-circle")
        };
    }

    (string badgeClass, string icon) ResolvePaymentUi(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "paid" or "success" or "completed" => ("badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-3 py-2", "bx bx-check-circle"),
            "pending" or "unpaid" => ("badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2", "bx bx-time-five"),
            "failed" or "cancelled" or "canceled" => ("badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill px-3 py-2", "bx bx-x-circle"),
            _ => ("badge bg-light text-dark border rounded-pill px-3 py-2", "bx bx-wallet")
        };
    }

    (string label, string badgeClass, string icon) ResolvePaymentUiVn(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "paid" or "success" or "completed" => ("Đã thanh toán", "badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-3 py-2", "bx bx-check-circle"),
            "pending" => ("Đang xử lý", "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2", "bx bx-time-five"),
            "unpaid" => ("Chưa thanh toán", "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2", "bx bx-time-five"),
            "failed" => ("Thất bại", "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill px-3 py-2", "bx bx-x-circle"),
            "cancelled" or "canceled" => ("Đã hủy", "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill px-3 py-2", "bx bx-x-circle"),
            _ => (string.IsNullOrWhiteSpace(s) ? "(không rõ)" : s, "badge bg-light text-dark border rounded-pill px-3 py-2", "bx bx-wallet")
        };
    }

    string ResolveAccentBg(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "pending" => "bg-warning",
            "confirmed" => "bg-success",
            "rejected" => "bg-danger",
            "cancelled" or "canceled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    (string tabClass, string tabIcon) ResolveTabStyle(string? status)
    {
        var n = (status ?? string.Empty).Trim().Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "pending" => ("text-warning", "bx bx-time-five"),
            "confirmed" => ("text-success", "bx bx-check-circle"),
            "rejected" => ("text-danger", "bx bx-x-circle"),
            "cancelled" or "canceled" => ("text-danger", "bx bx-x-circle"),
            _ => ("text-primary", "bx bx-list-ul")
        };
    }
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 bg-light border rounded-3 p-3">
                <div>
                    <h4 class="mb-1"><i class="bx bx-receipt me-1"></i>Quản lý đơn hàng</h4>
                    <div class="text-muted small">Theo dõi trạng thái, thanh toán và chi tiết đơn</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill px-3 py-2">
                        <i class="bx bx-list-ul me-1"></i>
                        Tổng: @Model.TotalItems
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-primary-subtle border-0 border-start border-4 border-primary">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-xs">
                            <span class="avatar-title rounded-circle bg-primary text-white">
                                <i class="bx bx-list-check"></i>
                            </span>
                        </div>
                        <div>
                            <h5 class="mb-0">Danh sách đơn hàng</h5>
                            <div class="text-muted small">Lọc theo trạng thái và tìm theo mã đơn</div>
                        </div>
                    </div>
                    <span class="badge bg-primary text-white rounded-pill px-3 py-2">
                        <i class="bx bx-layer me-1"></i>
                        @Model.TotalItems đơn
                    </span>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
                {
                    <div class="alert alert-info d-flex align-items-start gap-2 rounded-3" role="alert">
                        <i class="bx bx-info-circle mt-1"></i>
                        <div>@toast</div>
                    </div>
                }

                @if (!isSignedIn)
                {
                    <div class="alert alert-warning mb-0">
                        Bạn chưa đăng nhập. Vui lòng đăng nhập tài khoản Shop/Admin để xem đơn hàng.
                    </div>
                }
                else if (!isAdmin && !isShop)
                {
                    <div class="alert alert-danger mb-0">
                        Tài khoản hiện tại không có quyền truy cập quản lý đơn hàng.
                    </div>
                }
                else
                {
                    <ul class="nav nav-pills mb-3 bg-light border rounded-3 p-2" role="tablist">
                        @foreach (var t in statusTabs)
                        {
                            var isActive = string.IsNullOrWhiteSpace(t.status)
                                ? string.IsNullOrWhiteSpace(activeStatus)
                                : string.Equals(activeStatus, t.status, StringComparison.OrdinalIgnoreCase);

                            var (tabClass, tabIcon) = ResolveTabStyle(t.status);

                            <li class="nav-item" role="presentation">
                                <a class="nav-link @(isActive ? "active fw-semibold" : string.Empty)"
                                   asp-area="Admin" asp-controller="Orders" asp-action="Index"
                                   asp-route-Status="@t.status"
                                   asp-route-Search="@Model.Query.Search">
                                    <i class="@tabIcon me-1 @(isActive ? string.Empty : tabClass)"></i>
                                    @t.label
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="border rounded-3 p-3 bg-light">
                        <form method="get" class="row g-2 align-items-end">
                            <div class="col-sm-5">
                                <label class="form-label"><i class="bx bx-search-alt me-1"></i>Tìm theo mã đơn</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bx bx-search-alt"></i></span>
                                    <input class="form-control" name="Search" value="@Model.Query.Search" placeholder="VD: DH2026..." />
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label"><i class="bx bx-filter-alt me-1"></i>Trạng thái</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bx bx-filter-alt"></i></span>
                                    <select class="form-select" name="Status">
                                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Query.Status))">Tất cả</option>
                                    <option value="Pending" selected="@(Model.Query.Status == "Pending")">Chờ xác nhận</option>
                                    <option value="Confirmed" selected="@(Model.Query.Status == "Confirmed")">Đã xác nhận</option>
                                    <option value="Rejected" selected="@(Model.Query.Status == "Rejected")">Đã từ chối</option>
                                    <option value="Cancelled" selected="@(Model.Query.Status == "Cancelled")">Đã hủy</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-3 d-flex gap-2">
                                <button class="btn btn-primary" type="submit"><i class="bx bx-filter me-1"></i>Lọc</button>
                                <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bx bx-reset me-1"></i>Reset</a>
                            </div>
                        </form>
                    </div>

                <div class="table-responsive mt-4">
                    <table class="table table-striped table-hover align-middle table-nowrap mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Trạng thái</th>
                                <th>Thanh toán</th>
                                <th>Khách nhận</th>
                                <th class="text-end">Tổng</th>
                                <th class="text-end">SP</th>
                                <th>Ngày tạo</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Orders.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Chưa có đơn hàng phù hợp.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var o in Model.Orders)
                            {
                                var ui = ResolveStatusUi(o.OrderStatus);
                                var pay = ResolvePaymentUiVn(o.PaymentStatus);
                                var accent = ResolveAccentBg(o.OrderStatus);

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-start gap-2">
                                            <span class="d-inline-block rounded-2 flex-shrink-0 @accent" style="width:6px;height:42px;"></span>
                                            <div>
                                                <a class="fw-semibold text-decoration-none" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">
                                                    @o.OrderCode
                                                </a>
                                                <div class="text-muted small">@o.CustomerEmail</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="@ui.badgeClass">
                                            <i class="@ui.icon me-1"></i>
                                            @ui.label
                                        </span>
                                    </td>
                                    <td>
                                        <span class="@pay.badgeClass">
                                            <i class="@pay.icon me-1"></i>
                                            @pay.label
                                        </span>
                                    </td>
                                    <td>
                                        <div>@o.RecipientName</div>
                                        <div class="text-muted small">@o.RecipientPhone</div>
                                    </td>
                                    <td class="text-end fw-semibold">@o.FinalAmount.ToString("n0")đ</td>
                                    <td class="text-end">
                                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill px-3 py-2">
                                            <i class="bx bx-package me-1"></i>
                                            @o.ItemCount
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                        <div class="text-muted small">@o.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">
                                            <i class="bx bx-show-alt me-1"></i>
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted">Tổng: @Model.TotalItems</div>
                    <div class="text-muted small">Trang @Model.Query.Page (PageSize @Model.Query.PageSize)</div>
                </div>

                }
            </div>
        </div>
    </div>
</div>
