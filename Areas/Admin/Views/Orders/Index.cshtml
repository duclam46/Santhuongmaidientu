@model DOAN_BANHANG.ViewModels.AdminOrderListVm
@{
    ViewData["Title"] = "Quản lý đơn hàng";

    var isSignedIn = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;
    var isShop = User?.IsInRole("Shop") ?? false;

    var activeStatus = (Model.Query.Status ?? string.Empty).Trim();
    var statusTabs = new (string? status, string label)[]
    {
        (null, "Tất cả"),
        ("Pending", "Chờ xác nhận"),
        ("Confirmed", "Đã xác nhận"),
        ("Rejected", "Đã từ chối"),
        ("Cancelled", "Đã hủy")
    };

    (string label, string badgeClass, string icon) ResolveStatusUi(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "pending" => ("Chờ xác nhận", "oi-pill oi-pill-warn", "bx bx-time-five"),
            "confirmed" => ("Đã xác nhận", "oi-pill oi-pill-ok", "bx bx-check-circle"),
            "shipping" or "delivering" => ("Đang giao", "oi-pill oi-pill-info", "bx bx-car"),
            "delivered" or "completed" => ("Hoàn tất", "oi-pill oi-pill-ok", "bx bx-check-double"),
            "rejected" => ("Đã từ chối", "oi-pill oi-pill-danger", "bx bx-x-circle"),
            "cancelled" or "canceled" => ("Đã hủy", "oi-pill oi-pill-danger", "bx bx-x-circle"),
            _ => (string.IsNullOrWhiteSpace(s) ? "(không rõ)" : s, "oi-pill oi-pill-muted", "bx bx-info-circle")
        };
    }

    (string label, string badgeClass, string icon) ResolvePaymentUiVn(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "paid" or "success" or "completed" => ("Đã thanh toán", "oi-pill oi-pill-ok", "bx bx-check-circle"),
            "pending" => ("Đang xử lý", "oi-pill oi-pill-warn", "bx bx-time-five"),
            "unpaid" => ("Chưa thanh toán", "oi-pill oi-pill-warn", "bx bx-time-five"),
            "failed" => ("Thất bại", "oi-pill oi-pill-danger", "bx bx-x-circle"),
            "cancelled" or "canceled" => ("Đã hủy", "oi-pill oi-pill-danger", "bx bx-x-circle"),
            _ => (string.IsNullOrWhiteSpace(s) ? "(không rõ)" : s, "oi-pill oi-pill-muted", "bx bx-wallet")
        };
    }

    string ResolveAccentColor(string? raw)
    {
        var n = (raw ?? string.Empty).Trim().Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "pending" => "#f59e0b",
            "confirmed" or "delivered" or "completed" => "#10b981",
            "rejected" or "cancelled" or "canceled" => "#ef4444",
            _ => "#94a3b8"
        };
    }

    (string tabClass, string tabIcon) ResolveTabStyle(string? status)
    {
        var n = (status ?? string.Empty).Trim().Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "pending" => ("text-warning", "bx bx-time-five"),
            "confirmed" => ("text-success", "bx bx-check-circle"),
            "rejected" => ("text-danger", "bx bx-x-circle"),
            "cancelled" or "canceled" => ("text-danger", "bx bx-x-circle"),
            _ => ("text-teal", "bx bx-list-ul")
        };
    }

    var totalPages = Model.Query.PageSize > 0
        ? (int)Math.Ceiling(Model.TotalItems / (double)Model.Query.PageSize)
        : 1;
}

<style>
    :root {
        --oi-teal: #0b5c56;
        --oi-teal-dark: #063532;
        --oi-border: #e2e8f0;
    }
    .text-teal { color: var(--oi-teal) !important; }

    .oi-hero {
        background: linear-gradient(135deg, #063532 0%, #0b5c56 58%, #0f766e 100%);
        border-radius: 18px;
        padding: 24px 28px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(6, 53, 50, 0.16);
        margin-bottom: 20px;
    }
    .oi-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -30px;
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.28) 0%, rgba(16, 185, 129, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .oi-hero-title { font-size: 1.45rem; font-weight: 800; color: #fff; margin-bottom: 4px; letter-spacing: -0.02em; }
    .oi-hero-sub { color: rgba(255,255,255,0.8); font-size: 0.88rem; }

    .oi-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--oi-border);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.035);
        overflow: hidden;
    }

    .oi-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 14px 22px 0 22px;
        border-bottom: 1px solid var(--oi-border);
        background: #fafcff;
    }
    .oi-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 16px;
        font-size: 0.86rem;
        font-weight: 600;
        color: #64748b;
        text-decoration: none;
        border-bottom: 2.5px solid transparent;
        margin-bottom: -1px;
        transition: all 0.18s;
    }
    .oi-tab:hover { color: var(--oi-teal); }
    .oi-tab.active {
        color: var(--oi-teal);
        border-bottom-color: var(--oi-teal);
        font-weight: 700;
    }

    .oi-filter-bar {
        padding: 18px 22px;
        border-bottom: 1px solid #f1f5f9;
        background: #fff;
    }
    .oi-search-wrap { position: relative; }
    .oi-search-wrap i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 1.05rem; }
    .oi-search-wrap input { padding-left: 38px; border-radius: 10px; border: 1px solid #cbd5e1; height: 40px; font-size: 0.88rem; }
    .oi-select { border-radius: 10px; border: 1px solid #cbd5e1; height: 40px; font-size: 0.88rem; }
    .oi-search-wrap input:focus, .oi-select:focus { border-color: var(--oi-teal); box-shadow: 0 0 0 3px rgba(11,92,86,0.12); }

    .oi-btn-primary {
        background: var(--oi-teal);
        color: #fff;
        border: none;
        border-radius: 10px;
        height: 40px;
        font-weight: 600;
        font-size: 0.86rem;
        padding: 0 18px;
    }
    .oi-btn-primary:hover { background: var(--oi-teal-dark); color: #fff; }

    .oi-table { margin-bottom: 0; }
    .oi-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 13px 16px;
        border-bottom: 1.5px solid var(--oi-border);
        white-space: nowrap;
    }
    .oi-table tbody td {
        padding: 14px 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }
    .oi-table tbody tr:hover td { background: #f8fafc; }

    .oi-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .oi-pill-ok { background: #ecfdf5; color: #047857; }
    .oi-pill-warn { background: #fffbeb; color: #b45309; }
    .oi-pill-danger { background: #fef2f2; color: #dc2626; }
    .oi-pill-info { background: #eff6ff; color: #1d4ed8; }
    .oi-pill-muted { background: #f1f5f9; color: #475569; }

    .oi-btn-detail {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 13px;
        border-radius: 9px;
        font-size: 0.82rem;
        font-weight: 600;
        background: rgba(11, 92, 86, 0.08);
        color: var(--oi-teal);
        border: 1px solid rgba(11, 92, 86, 0.18);
        text-decoration: none;
        transition: all 0.18s;
    }
    .oi-btn-detail:hover { background: var(--oi-teal); color: #fff; }
</style>

<!-- 1. HERO HEADER -->
<div class="oi-hero d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div style="position: relative; z-index: 2;">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge rounded-pill" style="background: rgba(255,255,255,0.16); color: #a7f3d0; font-weight: 700; font-size: 0.72rem;">
                <i class="bx bx-store-alt me-1"></i>KÊNH NGƯỜI BÁN
            </span>
            <span class="badge rounded-pill" style="background: rgba(16,185,129,0.22); color: #ecfdf5; font-weight: 700; font-size: 0.72rem;">
                @Model.TotalItems đơn hàng phù hợp
            </span>
        </div>
        <h3 class="oi-hero-title">
            <i class="bx bx-receipt me-2" style="color: #6ee7b7;"></i>Quản lý Đơn hàng
        </h3>
        <div class="oi-hero-sub">Theo dõi trạng thái xử lý, thanh toán, vận đơn GHN và in phiếu gửi hàng / hóa đơn VAT.</div>
    </div>
</div>

<!-- 2. MAIN CARD -->
<div class="oi-card">
    @if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
    {
        <div class="p-3 pb-0">
            <div class="alert alert-info d-flex align-items-start gap-2 rounded-3 mb-0" role="alert">
                <i class="bx bx-info-circle mt-1"></i>
                <div>@toast</div>
            </div>
        </div>
    }

    @if (!isSignedIn)
    {
        <div class="p-4">
            <div class="alert alert-warning mb-0 rounded-3">
                Bạn chưa đăng nhập. Vui lòng đăng nhập tài khoản Shop/Admin để xem đơn hàng.
            </div>
        </div>
    }
    else if (!isAdmin && !isShop)
    {
        <div class="p-4">
            <div class="alert alert-danger mb-0 rounded-3">
                Tài khoản hiện tại không có quyền truy cập quản lý đơn hàng.
            </div>
        </div>
    }
    else
    {
        <!-- Status Tabs -->
        <div class="oi-tabs" role="tablist">
            @foreach (var t in statusTabs)
            {
                var isActive = string.IsNullOrWhiteSpace(t.status)
                    ? string.IsNullOrWhiteSpace(activeStatus)
                    : string.Equals(activeStatus, t.status, StringComparison.OrdinalIgnoreCase);

                var (tabClass, tabIcon) = ResolveTabStyle(t.status);

                <a class="oi-tab @(isActive ? "active" : "")"
                   asp-area="Admin" asp-controller="Orders" asp-action="Index"
                   asp-route-Status="@t.status"
                   asp-route-Search="@Model.Query.Search">
                    <i class="@tabIcon @(isActive ? "" : tabClass)"></i>
                    <span>@t.label</span>
                </a>
            }
        </div>

        <!-- Filter Bar -->
        <div class="oi-filter-bar">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label text-muted fw-bold mb-1" style="font-size: 0.72rem;">TÌM KIẾM THEO MÃ ĐƠN</label>
                    <div class="oi-search-wrap">
                        <i class="bx bx-search"></i>
                        <input class="form-control" name="Search" value="@Model.Query.Search" placeholder="VD: DH2026..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted fw-bold mb-1" style="font-size: 0.72rem;">TRẠNG THÁI ĐƠN HÀNG</label>
                    <select class="form-select oi-select" name="Status">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Query.Status))">Tất cả trạng thái</option>
                        <option value="Pending" selected="@(Model.Query.Status == "Pending")">Chờ xác nhận</option>
                        <option value="Confirmed" selected="@(Model.Query.Status == "Confirmed")">Đã xác nhận</option>
                        <option value="Rejected" selected="@(Model.Query.Status == "Rejected")">Đã từ chối</option>
                        <option value="Cancelled" selected="@(Model.Query.Status == "Cancelled")">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="oi-btn-primary flex-grow-1" type="submit"><i class="bx bx-filter-alt me-1"></i>Lọc</button>
                    <a class="btn btn-light border d-inline-flex align-items-center justify-content-center"
                       asp-area="Admin" asp-controller="Orders" asp-action="Index"
                       style="border-radius: 10px; height: 40px; padding: 0 14px;" title="Đặt lại">
                        <i class="bx bx-refresh fs-5 text-muted"></i>
                    </a>
                </div>
            </form>
        </div>

        <!-- Bulk Action Bar -->
        <form id="js-bulk-confirm-form" method="post" asp-area="Admin" asp-controller="Orders" asp-action="BulkConfirm">
            @Html.AntiForgeryToken()
            <div id="js-bulk-orders-bar" class="px-4 py-2.5 border-bottom d-none align-items-center justify-content-between flex-wrap gap-2" style="background: #f0fdfa;">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge rounded-pill" style="background:#0b5c56; color:#fff; font-size:0.8rem;" id="js-bulk-selected-count">0</span>
                    <span class="fw-bold text-dark" style="font-size:0.86rem;">đơn hàng đang được chọn</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="submit" class="btn btn-sm text-white fw-bold px-3" style="background:#0b5c56; border-radius:9px;">
                        <i class="bx bx-check-double me-1"></i>Xác nhận hàng loạt (Đơn chờ)
                    </button>
                    <button type="button" onclick="openBulkPackingSlips()" class="btn btn-sm btn-outline-dark fw-bold px-3" style="border-radius:9px;">
                        <i class="bx bx-printer me-1"></i>In phiếu đóng gói hàng loạt
                    </button>
                </div>
            </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table oi-table table-nowrap align-middle">
                <thead>
                    <tr>
                        <th style="width: 42px;">
                            <input type="checkbox" class="form-check-input" id="js-chk-all-orders" title="Chọn tất cả" />
                        </th>
                        <th>Mã đơn &amp; Khách hàng</th>
                        <th>Trạng thái</th>
                        <th>Thanh toán</th>
                        <th>Người nhận</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">SL SP</th>
                        <th>Thời gian đặt</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5">
                            <div class="mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 16px; background: #f1f5f9; color: #94a3b8; font-size: 1.7rem;">
                                <i class="bx bx-receipt"></i>
                            </div>
                            <div class="fw-bold text-dark">Chưa có đơn hàng phù hợp</div>
                            <div class="text-muted small">Thử đổi tab trạng thái hoặc xóa bộ lọc tìm kiếm.</div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var o in Model.Orders)
                    {
                        var ui = ResolveStatusUi(o.OrderStatus);
                        var pay = ResolvePaymentUiVn(o.PaymentStatus);
                        var accentColor = ResolveAccentColor(o.OrderStatus);

                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input js-chk-order-row" name="orderIds" value="@o.Id" data-status="@o.OrderStatus" />
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-pill flex-shrink-0" style="width: 5px; height: 38px; background: @accentColor;"></span>
                                    <div>
                                        <a class="fw-bold text-dark text-decoration-none d-block" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">
                                            @o.OrderCode
                                        </a>
                                        <div class="text-muted small">@o.CustomerEmail</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="@ui.badgeClass">
                                    <i class="@ui.icon"></i>@ui.label
                                </span>
                            </td>
                            <td>
                                <span class="@pay.badgeClass">
                                    <i class="@pay.icon"></i>@pay.label
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@o.RecipientName</div>
                                <div class="text-muted small"><i class="bx bx-phone me-1"></i>@o.RecipientPhone</div>
                            </td>
                            <td class="text-end fw-bold text-dark" style="font-size: 0.96rem;">@o.FinalAmount.ToString("n0")₫</td>
                            <td class="text-center">
                                <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(11,92,86,0.1); color: #0b5c56; font-weight: 700;">
                                    @o.ItemCount SP
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                <div class="text-muted small">@o.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                            </td>
                            <td class="text-end">
                                <a class="oi-btn-detail" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">
                                    <i class="bx bx-show-alt"></i>Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        </form>

        <script>
            (function () {
                const chkAll = document.getElementById('js-chk-all-orders');
                const rowChks = Array.from(document.querySelectorAll('.js-chk-order-row'));
                const bar = document.getElementById('js-bulk-orders-bar');
                const countEl = document.getElementById('js-bulk-selected-count');

                function syncBar() {
                    const checked = rowChks.filter(c => c.checked);
                    if (countEl) countEl.textContent = String(checked.length);
                    if (bar) {
                        bar.classList.toggle('d-none', checked.length === 0);
                        bar.classList.toggle('d-flex', checked.length > 0);
                    }
                }

                if (chkAll) {
                    chkAll.addEventListener('change', function () {
                        rowChks.forEach(c => { c.checked = chkAll.checked; });
                        syncBar();
                    });
                }
                rowChks.forEach(c => c.addEventListener('change', syncBar));

                window.openBulkPackingSlips = function () {
                    const ids = rowChks.filter(c => c.checked).map(c => c.value);
                    if (ids.length === 0) return;
                    window.open('/Admin/Orders/BulkPrintPackingSlips?ids=' + encodeURIComponent(ids.join(',')), '_blank');
                };
            })();
        </script>

        <!-- Footer -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-4 py-3 border-top bg-light bg-opacity-50">
            <div class="text-muted small">
                Tổng cộng <strong class="text-dark">@Model.TotalItems</strong> đơn hàng • Trang <strong class="text-dark">@Model.Query.Page</strong> / <strong>@Math.Max(1, totalPages)</strong>
            </div>
            @if (totalPages > 1)
            {
                <div class="d-flex gap-1">
                    @if (Model.Query.Page > 1)
                    {
                        <a class="btn btn-sm btn-light border" style="border-radius: 8px;"
                           asp-area="Admin" asp-controller="Orders" asp-action="Index"
                           asp-route-Status="@Model.Query.Status" asp-route-Search="@Model.Query.Search"
                           asp-route-Page="@(Model.Query.Page - 1)" asp-route-PageSize="@Model.Query.PageSize">
                            <i class="bx bx-chevron-left"></i> Trước
                        </a>
                    }
                    @if (Model.Query.Page < totalPages)
                    {
                        <a class="btn btn-sm btn-light border" style="border-radius: 8px;"
                           asp-area="Admin" asp-controller="Orders" asp-action="Index"
                           asp-route-Status="@Model.Query.Status" asp-route-Search="@Model.Query.Search"
                           asp-route-Page="@(Model.Query.Page + 1)" asp-route-PageSize="@Model.Query.PageSize">
                            Sau <i class="bx bx-chevron-right"></i>
                        </a>
                    }
                </div>
            }
        </div>
    }
</div>
