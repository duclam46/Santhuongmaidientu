@model DOAN_BANHANG.ViewModels.AdminOrderDetailsVm
@inject DOAN_BANHANG.Models.DataContext _db
@{
    ViewData["Title"] = "Chi tiết đơn hàng";

    var isSignedIn = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;
    var isShop = User?.IsInRole("Shop") ?? false;

    var statusRaw = (Model.OrderStatus ?? string.Empty).Trim();
    var statusNorm = statusRaw.Replace(" ", string.Empty).ToLowerInvariant();

    var isCancelled = statusNorm is "cancelled" or "canceled";

    var (statusLabel, badgeClass, statusIcon) = statusNorm switch
    {
        "pending" => (
            "Chờ xác nhận",
            "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle",
            "bx bx-time-five"
        ),
        "confirmed" => (
            "Đã xác nhận",
            "badge bg-success-subtle text-success-emphasis border border-success-subtle",
            "bx bx-check-circle"
        ),
        "rejected" => (
            "Đã từ chối",
            "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle",
            "bx bx-x-circle"
        ),
        "cancelled" or "canceled" => (
            "Đã hủy",
            "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle",
            "bx bx-x-circle"
        ),
        "returnrequest" => (
            "Yêu cầu trả hàng",
            "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle",
            "bx bx-subdirectory-left"
        ),
        "returning" => (
            "Đang hoàn hàng",
            "badge bg-info-subtle text-info-emphasis border border-info-subtle",
            "bx bx-package"
        ),
        "returned" => (
            "Đã trả hàng",
            "badge bg-success-subtle text-success-emphasis border border-success-subtle",
            "bx bx-check-double"
        ),
        _ => (
            string.IsNullOrWhiteSpace(statusRaw) ? "(không rõ)" : statusRaw,
            "badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle",
            "bx bx-info-circle"
        )
    };

    var paymentRaw = (Model.PaymentStatus ?? string.Empty).Trim();
    var paymentNorm = paymentRaw.Replace(" ", string.Empty).ToLowerInvariant();
    var paymentBadgeClass = paymentNorm switch
    {
        "paid" or "success" or "completed" => "badge bg-success-subtle text-success-emphasis border border-success-subtle",
        "pending" or "unpaid" => "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        "failed" or "cancelled" or "canceled" => "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle",
        _ => "badge bg-light text-dark border"
    };

    var hasGhn = !string.IsNullOrWhiteSpace(Model.TrackingCode);

    var statusHeaderClass = statusNorm switch
    {
        "pending" => "bg-warning-subtle border-warning-subtle",
        "confirmed" => "bg-success-subtle border-success-subtle",
        "rejected" => "bg-danger-subtle border-danger-subtle",
        "cancelled" or "canceled" => "bg-danger-subtle border-danger-subtle",
        "returnrequest" => "bg-warning-subtle border-warning-subtle",
        "returning" => "bg-info-subtle border-info-subtle",
        "returned" => "bg-success-subtle border-success-subtle",
        _ => "bg-secondary-subtle border-secondary-subtle"
    };

    string FormatVnd(decimal amount) => string.Format("{0:n0}", amount);

    var returnReq = _db.ReturnRequests.FirstOrDefault(r => r.OrderId == Model.Id);
}

@section AdminTopNotice {
    @if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
    {
        <div class="alert alert-info d-flex align-items-start gap-2 rounded-3" role="alert">
            <i class="bx bx-info-circle mt-1"></i>
            <div>@toast</div>
        </div>
    }

    @if (returnReq is not null)
    {
        var alertBg = returnReq.Status == "Approved" ? "bg-success-subtle border-success-subtle text-success-emphasis"
            : returnReq.Status == "Rejected" ? "bg-danger-subtle border-danger-subtle text-danger-emphasis"
            : "bg-warning-subtle border-warning-subtle text-warning-emphasis";
        var alertBorder = returnReq.Status == "Approved" ? "border-success"
            : returnReq.Status == "Rejected" ? "border-danger"
            : "border-warning";
        var alertBadge = returnReq.Status == "Approved" ? "bg-success rounded-pill text-white"
            : returnReq.Status == "Rejected" ? "bg-danger rounded-pill text-white"
            : "bg-warning text-dark rounded-pill";
        var statusLabelText = returnReq.Status == "Approved" ? "Đã duyệt trả hàng"
            : returnReq.Status == "Rejected" ? "Đã từ chối trả hàng"
            : "Đang chờ duyệt trả hàng";

        <div class="alert @alertBg border border-start border-4 @alertBorder d-flex align-items-start gap-3 rounded-3 mb-3" role="alert">
            <div class="flex-shrink-0">
                <div class="avatar-xs">
                    <span class="avatar-title rounded-circle bg-warning text-dark">
                        <i class="bx bx-subdirectory-left"></i>
                    </span>
                </div>
            </div>
            <div class="w-100">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="fw-semibold fs-5">Yêu cầu trả hàng cho đơn này</div>
                    <span class="badge @alertBadge px-3 py-1">@statusLabelText</span>
                </div>
                <div class="mt-2">
                    <strong>Lý do từ khách hàng:</strong> @returnReq.Reason
                </div>
                @if (returnReq.Status == "Approved" && !string.IsNullOrWhiteSpace(returnReq.ReturnTrackingCode))
                {
                    <div class="mt-1 text-success-emphasis fw-semibold">
                        📦 Mã đơn hoàn GHN: @returnReq.ReturnTrackingCode
                        @if (!string.IsNullOrWhiteSpace(returnReq.EstimatedPickupTime))
                        {
                            <span> | Ca lấy: @returnReq.EstimatedPickupTime</span>
                        }
                    </div>
                }
                @if (returnReq.Status == "Rejected" && !string.IsNullOrWhiteSpace(returnReq.RejectionNote))
                {
                    <div class="mt-1 text-danger-emphasis fw-semibold">
                        ❌ Lý do từ chối của Shop: @returnReq.RejectionNote
                    </div>
                }
                <div class="mt-3">
                    <a href="@Url.Action("Details", "ReturnRequests", new { area = "Admin", id = returnReq.Id })" class="btn btn-sm btn-primary">
                        ➡️ Đi tới chi tiết Yêu cầu trả hàng
                    </a>
                </div>
            </div>
        </div>
    }

    @if (isCancelled)
    {
        <div class="alert bg-danger-subtle border border-danger-subtle border-start border-4 border-danger text-danger-emphasis d-flex align-items-start gap-3 rounded-3" role="alert">
            <div class="flex-shrink-0">
                <div class="avatar-xs">
                    <span class="avatar-title rounded-circle bg-danger text-white">
                        <i class="bx bx-x"></i>
                    </span>
                </div>
            </div>
            <div class="w-100">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="fw-semibold">Đơn hàng đã bị khách hàng hủy</div>
                    <span class="badge bg-danger rounded-pill">Dừng chuẩn bị</span>
                </div>
                <div class="mt-1">Shop không cần chuẩn bị hàng nữa.</div>
                <div class="small mt-2 text-danger-emphasis">
                    <span class="fw-semibold">Ghi chú:</span>
                    @(string.IsNullOrWhiteSpace(Model.CancellationNote) ? "Người mua hủy đơn hàng" : Model.CancellationNote)
                </div>
            </div>
        </div>
    }
}

<div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-3">
    <div class="card-header @statusHeaderClass border-0 border-start border-4">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
            <div class="min-w-0">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h4 class="mb-0 text-truncate">@Model.OrderCode</h4>

                    <span class="@badgeClass rounded-pill px-3 py-2">
                        <i class="@statusIcon me-1"></i>
                        @statusLabel
                    </span>
                    <span class="@paymentBadgeClass rounded-pill px-3 py-2">
                        <i class="bx bx-wallet me-1"></i>
                        @paymentRaw
                    </span>
                    @if (hasGhn)
                    {
                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-2">
                            <i class="bx bx-package me-1"></i>
                            GHN
                        </span>
                    }
                </div>

                <div class="text-muted small mt-2">
                    <i class="bx bx-calendar me-1"></i>
                    Tạo lúc @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    @if (Model.UpdatedAt > Model.CreatedAt)
                    {
                        <span>• Cập nhật @Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-dark-subtle text-dark border border-dark-subtle rounded-pill px-3 py-2 d-none d-sm-inline-flex">
                    <i class="bx bx-money me-1"></i>
                    @FormatVnd(Model.FinalAmount)đ
                </span>
                <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="bx bx-left-arrow-alt me-1"></i>
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-6">
        <div class="vstack gap-3">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-primary-subtle border-0 border-start border-4 border-primary rounded-top-3">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-xs">
                            <span class="avatar-title rounded-circle bg-primary text-white">
                                <i class="bx bx-map"></i>
                            </span>
                        </div>
                        <div>
                            <h5 class="mb-0">Giao hàng</h5>
                            <div class="text-muted small">Thông tin người nhận & vận chuyển</div>
                        </div>
                    </div>
                    @if (hasGhn)
                    {
                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-2">
                            <i class="bx bx-package me-1"></i>
                            GHN
                        </span>
                    }
                </div>
            </div>

            <div class="card-body">
                <div class="border rounded-3 bg-light border-start border-4 border-primary overflow-hidden">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item bg-transparent py-3">
                            <div class="text-muted small"><i class="bx bx-user me-1"></i>Người nhận</div>
                            <div class="fw-semibold text-truncate">@Model.RecipientName</div>
                        </div>
                        <div class="list-group-item bg-transparent py-3">
                            <div class="text-muted small"><i class="bx bx-phone-call me-1"></i>Số điện thoại</div>
                            <div class="fw-semibold text-truncate">@Model.RecipientPhone</div>
                        </div>
                        <div class="list-group-item bg-transparent py-3">
                            <div class="text-muted small"><i class="bx bx-home me-1"></i>Địa chỉ</div>
                            <div class="fw-semibold text-wrap">@Model.ShippingAddress</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                        {
                            <div class="list-group-item bg-transparent py-3">
                                <div class="text-muted small"><i class="bx bx-envelope me-1"></i>Email khách</div>
                                <div class="fw-semibold text-break">@Model.CustomerEmail</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="border rounded-3 bg-light border-start border-4 border-info overflow-hidden mt-3">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item bg-transparent py-3">
                            <div class="text-muted small"><i class="bx bx-package me-1"></i>Vận chuyển GHN</div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-2">
                                    <i class="bx bx-barcode-reader me-1"></i>
                                    @(string.IsNullOrWhiteSpace(Model.TrackingCode) ? "Chưa có mã" : Model.TrackingCode)
                                </span>
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                                    <i class="bx bx-time me-1"></i>
                                    @(string.IsNullOrWhiteSpace(Model.PickupShiftTitle) ? "Chưa có ca lấy" : Model.PickupShiftTitle)
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.TrackingCode))
                            {
                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <a class="btn btn-sm btn-primary" target="_blank"
                                       asp-area="Admin" asp-controller="Orders" asp-action="PrintLabel"
                                       asp-route-id="@Model.Id" asp-route-format="A5">
                                        <i class="bx bx-printer me-1"></i>
                                        A5
                                    </a>
                                    <a class="btn btn-sm btn-outline-primary" target="_blank"
                                       asp-area="Admin" asp-controller="Orders" asp-action="PrintLabel"
                                       asp-route-id="@Model.Id" asp-route-format="80x80">
                                        <i class="bx bx-printer me-1"></i>
                                        80x80
                                    </a>
                                    <a class="btn btn-sm btn-outline-primary" target="_blank"
                                       asp-area="Admin" asp-controller="Orders" asp-action="PrintLabel"
                                       asp-route-id="@Model.Id" asp-route-format="52x70">
                                        <i class="bx bx-printer me-1"></i>
                                        52x70
                                    </a>
                                </div>
                                <div class="text-muted small mt-2">
                                    <i class="bx bx-info-circle me-1"></i>
                                    Phiếu in GHN có hiệu lực ~30 phút sau khi sinh token.
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small mt-2">
                                    <i class="bx bx-info-circle me-1"></i>
                                    Chưa tạo vận đơn GHN cho đơn này.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (isSignedIn && (isAdmin || isShop) && Model.OrderStatus == "Pending")
        {
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-warning-subtle border-0 border-start border-4 border-warning rounded-top-3">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="avatar-xs">
                                <span class="avatar-title rounded-circle bg-warning text-dark">
                                    <i class="bx bx-bolt-circle"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-0">Xử lý đơn</h5>
                                <div class="text-muted small">Chỉ xử lý được khi đơn đang Pending</div>
                            </div>
                        </div>
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Pending</span>
                    </div>
                </div>

                <div class="card-body">
                    <form method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-12">
                            <label class="form-label">Ghi chú (tuỳ chọn)</label>
                            <textarea class="form-control" name="Note" rows="2" placeholder="VD: Đã kiểm tra tồn kho"></textarea>
                            <input type="hidden" name="Id" value="@Model.Id" />
                        </div>
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-success" formaction="@Url.Action("Confirm", "Orders", new { area = "Admin" })">
                                <i class="bx bx-check me-1"></i>
                                Xác nhận
                            </button>
                            <button type="submit" class="btn btn-danger" formaction="@Url.Action("Reject", "Orders", new { area = "Admin" })" onclick="return confirm('Bạn chắc chắn muốn từ chối đơn hàng này?');">
                                <i class="bx bx-x me-1"></i>
                                Từ chối
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="vstack gap-3">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-info-subtle border-0 border-start border-4 border-info rounded-top-3">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-xs">
                            <span class="avatar-title rounded-circle bg-info text-white">
                                <i class="bx bx-cart"></i>
                            </span>
                        </div>
                        <div>
                            <h5 class="mb-0">Sản phẩm</h5>
                            <div class="text-muted small">Danh sách sản phẩm trong đơn</div>
                        </div>
                    </div>
                    <span class="badge bg-dark-subtle text-dark border border-dark-subtle rounded-pill px-3 py-2">
                        <i class="bx bx-receipt me-1"></i>
                        @Model.Items.Count sp
                    </span>
                </div>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-striped table-hover align-middle mt-2 table-nowrap">
                        <thead>
                            <tr>
                                <th class="bg-light">Sản phẩm</th>
                                <th class="bg-light">Màu</th>
                                <th class="bg-light">Size</th>
                                <th class="bg-light text-end">Đơn giá</th>
                                <th class="bg-light text-end">SL</th>
                                <th class="bg-light text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var i in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-wrap">@i.ProductName</td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@((string.IsNullOrWhiteSpace(i.ColorName) ? "-" : i.ColorName))</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2">@((string.IsNullOrWhiteSpace(i.SizeName) ? "-" : i.SizeName))</span>
                                </td>
                                <td class="text-end">@FormatVnd(i.UnitPrice)đ</td>
                                <td class="text-end">
                                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill px-3 py-2">@i.Quantity</span>
                                </td>
                                <td class="text-end fw-semibold">@FormatVnd(i.LineTotal)đ</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <div class="text-muted small mt-3">
                    <i class="bx bx-info-circle me-1"></i>
                    Tổng tiền đã được hiển thị trong mục <span class="fw-semibold">Thanh toán</span>.
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-success-subtle border-0 border-start border-4 border-success rounded-top-3">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-xs">
                            <span class="avatar-title rounded-circle bg-success text-white">
                                <i class="bx bx-credit-card"></i>
                            </span>
                        </div>
                        <div>
                            <h5 class="mb-0">Thanh toán</h5>
                            <div class="text-muted small">Phương thức & tổng tiền</div>
                        </div>
                    </div>
                    <span class="@paymentBadgeClass rounded-pill px-3 py-2">
                        <i class="bx bx-wallet me-1"></i>
                        @Model.PaymentStatus
                    </span>
                </div>
            </div>

            <div class="card-body">
                <div class="border rounded-3 p-3 bg-light border-start border-4 border-success">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless mb-0 align-middle">
                            <tbody>
                                <tr>
                                    <td class="text-muted"><i class="bx bx-receipt me-1"></i>Phương thức</td>
                                    <td class="text-end fw-semibold">@Model.PaymentMethod</td>
                                </tr>
                                <tr>
                                    <td class="text-muted"><i class="bx bx-purchase-tag-alt me-1"></i>Tạm tính</td>
                                    <td class="text-end fw-semibold">@FormatVnd(Model.SubTotal)đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted"><i class="bx bx-car me-1"></i>Phí vận chuyển</td>
                                    <td class="text-end fw-semibold">@FormatVnd(Model.ShippingFee)đ</td>
                                </tr>
                                <tr>
                                    <td class="text-muted"><i class="bx bx-discount me-1"></i>Giảm giá</td>
                                    <td class="text-end fw-semibold">-@FormatVnd(Model.DiscountAmount)đ</td>
                                </tr>
                                @{
                                    var calcVat = Model.FinalAmount - Model.SubTotal - Model.ShippingFee + Model.DiscountAmount;
                                    if (calcVat < 0) calcVat = 0m;
                                    var calcVatRate = Model.SubTotal > 0 ? Math.Round(calcVat / Model.SubTotal * 100) : 0;
                                }
                                @if (calcVat > 0)
                                {
                                    <tr>
                                        <td class="text-muted"><i class="bx bx-receipt me-1"></i>VAT (@(calcVatRate)%)</td>
                                        <td class="text-end fw-semibold">@FormatVnd(calcVat)đ</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="2"><hr class="my-2" /></td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Thành tiền</td>
                                    <td class="text-end fw-bold fs-5">@FormatVnd(Model.FinalAmount)đ</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </div>
</div>
