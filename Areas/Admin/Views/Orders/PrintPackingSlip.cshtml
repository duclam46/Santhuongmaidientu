@model DOAN_BANHANG.ViewModels.AdminOrderDetailsVm
@{
    Layout = null;
    var shopName = ViewBag.SellerShopName as string ?? "GIAN HÀNG SELLZY";
    var shopPhone = ViewBag.SellerPhone as string ?? "1900 6868";
    var shopAddress = ViewBag.SellerAddress as string ?? "Kho Đối tác Sellzy";
    bool isCod = string.Equals(Model.PaymentMethod, "COD", StringComparison.OrdinalIgnoreCase) &&
                 !string.Equals(Model.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase);
    decimal codAmount = isCod ? Model.FinalAmount : 0m;
    int totalQty = Model.Items.Sum(i => i.Quantity);
    var trackingDisplay = string.IsNullOrWhiteSpace(Model.TrackingCode) ? Model.OrderCode : Model.TrackingCode;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Phiếu Gửi Hàng #@Model.OrderCode - Sellzy Express</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            background: #e2e8f0;
            margin: 0;
            padding: 24px 16px;
            color: #0f172a;
        }
        .toolbar {
            max-width: 560px;
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: #063532;
            padding: 12px 16px;
            border-radius: 14px;
            color: #fff;
            box-shadow: 0 8px 20px rgba(6, 53, 50, 0.2);
        }
        .toolbar-info { font-size: 12.5px; color: #a7f3d0; font-weight: 600; }
        .btn-print {
            background: #10b981;
            color: #fff;
            border: none;
            border-radius: 9px;
            padding: 9px 18px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
        }
        .btn-print:hover { background: #059669; }
        .btn-close {
            background: rgba(255,255,255,0.14);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.25);
            border-radius: 9px;
            padding: 8px 14px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
        }

        .label-sheet {
            max-width: 560px;
            margin: 0 auto;
            background: #ffffff;
            border: 2px solid #0f172a;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.14);
        }
        .label-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            background: #063532;
            color: #fff;
            border-bottom: 2px solid #0f172a;
        }
        .brand-box {
            font-size: 18px;
            font-weight: 900;
            letter-spacing: 0.6px;
            color: #fff;
        }
        .brand-sub { font-size: 11px; color: #a7f3d0; margin-top: 2px; }
        .carrier-pill {
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 11.5px;
            font-weight: 800;
            letter-spacing: 0.3px;
        }
        .pill-cod { background: #fbbf24; color: #0f172a; }
        .pill-paid { background: #10b981; color: #fff; }

        .barcode-sec {
            padding: 14px 18px;
            text-align: center;
            border-bottom: 2px dashed #0f172a;
            background: #f8fafc;
        }
        .barcode-bars {
            height: 48px;
            margin: 0 auto 8px;
            max-width: 390px;
            background: repeating-linear-gradient(
                90deg,
                #0f172a 0px, #0f172a 3px,
                transparent 3px, transparent 5px,
                #0f172a 5px, #0f172a 7px,
                transparent 7px, transparent 10px,
                #0f172a 10px, #0f172a 14px,
                transparent 14px, transparent 16px,
                #0f172a 16px, #0f172a 17px,
                transparent 17px, transparent 21px
            );
        }
        .tracking-code {
            font-family: "Consolas", "Courier New", monospace;
            font-size: 16px;
            font-weight: 900;
            letter-spacing: 1.4px;
            color: #0f172a;
        }
        .order-subcode { font-size: 12px; font-weight: 700; color: #475569; margin-top: 3px; }

        .addr-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-bottom: 2px solid #0f172a;
        }
        .addr-box {
            padding: 13px 16px;
            font-size: 12.5px;
            line-height: 1.45;
        }
        .addr-box:first-child { border-right: 1.5px solid #0f172a; }
        .addr-tag {
            display: inline-block;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 2px 7px;
            border-radius: 4px;
            background: #f1f5f9;
            color: #334155;
            margin-bottom: 6px;
        }

        .cod-banner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            border-bottom: 2px solid #0f172a;
        }
        .cod-banner.is-cod { background: #fffbeb; }
        .cod-banner.is-paid { background: #ecfdf5; }
        .cod-amount { font-size: 24px; font-weight: 900; letter-spacing: -0.5px; }

        .items-sec {
            padding: 13px 18px;
            border-bottom: 1.5px solid #0f172a;
        }
        .items-title {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #334155;
            margin-bottom: 8px;
        }
        .items-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .items-table th {
            background: #f1f5f9;
            padding: 6px 6px;
            text-align: left;
            font-size: 10.5px;
            text-transform: uppercase;
            border-bottom: 1.5px solid #cbd5e1;
        }
        .items-table td {
            padding: 7px 6px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: top;
        }
        .items-table tr:last-child td { border-bottom: none; }

        .footer-note {
            display: flex;
            align-items: stretch;
            justify-content: space-between;
            gap: 14px;
            padding: 13px 18px;
            font-size: 11px;
            color: #475569;
            background: #fafcff;
        }
        .sign-box {
            border: 1.5px dashed #64748b;
            border-radius: 8px;
            padding: 8px 14px;
            text-align: center;
            min-width: 155px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        @@media print {
            body { background: #fff; padding: 0; }
            .toolbar { display: none !important; }
            .label-sheet { box-shadow: none; max-width: 100%; border-radius: 0; }
            .label-head { background: #063532 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .cod-banner { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <div class="toolbar-info">Khổ in chuẩn A6 / A5 • Đơn #@Model.OrderCode</div>
        <div style="display: flex; gap: 8px;">
            <button type="button" class="btn-print" onclick="window.print()">In Tem Vận Đơn</button>
            <button type="button" class="btn-close" onclick="window.close()">Đóng</button>
        </div>
    </div>

    <div class="label-sheet">
        <div class="label-head">
            <div>
                <div class="brand-box">SELLZY EXPRESS • GHN</div>
                <div class="brand-sub">Ngày tạo: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <span class="carrier-pill @(isCod ? "pill-cod" : "pill-paid")">
                @(isCod ? "THU HỘ COD" : "ĐÃ THANH TOÁN")
            </span>
        </div>

        <div class="barcode-sec">
            <div class="barcode-bars"></div>
            <div class="tracking-code">MÃ VẬN ĐƠN: @trackingDisplay</div>
            <div class="order-subcode">Mã đơn sàn: #@Model.OrderCode</div>
        </div>

        <div class="addr-grid">
            <div class="addr-box">
                <div class="addr-tag">Từ: Người gửi (Shop)</div>
                <div style="font-weight: 800; font-size: 13.5px; color: #0f172a;">@shopName</div>
                <div style="font-weight: 700; color: #334155;">SĐT: @shopPhone</div>
                <div style="color: #475569; margin-top: 3px;">@shopAddress</div>
            </div>
            <div class="addr-box">
                <div class="addr-tag" style="background: #ecfdf5; color: #065f46;">Đến: Người nhận</div>
                <div style="font-weight: 800; font-size: 14px; color: #0f172a;">@Model.RecipientName</div>
                <div style="font-weight: 800; color: #0b5c56;">SĐT: @Model.RecipientPhone</div>
                <div style="color: #0f172a; font-weight: 600; margin-top: 3px;">@Model.ShippingAddress</div>
            </div>
        </div>

        <div class="cod-banner @(isCod ? "is-cod" : "is-paid")">
            <div>
                <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: @(isCod ? "#78350f" : "#065f46");">
                    Tiền thu hộ Shipper (COD)
                </div>
                <div style="font-size: 11.5px; color: @(isCod ? "#92400e" : "#047857"); margin-top: 2px;">
                    @(isCod ? "Thu tiền mặt trực tiếp khi giao hàng" : "Khách đã thanh toán trước — Không thu tiền")
                </div>
            </div>
            <div class="cod-amount" style="color: @(isCod ? "#b45309" : "#059669");">@codAmount.ToString("N0") ₫</div>
        </div>

        <div class="items-sec">
            <div class="items-title">
                Nội dung hàng hóa đóng gói (Tổng số lượng: @totalQty sản phẩm)
            </div>
            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width: 28px;">#</th>
                        <th>Tên sản phẩm &amp; Phân loại</th>
                        <th style="width: 48px; text-align: right;">SL</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        var it = Model.Items[i];
                        var varLabel = !string.IsNullOrWhiteSpace(it.VariantDescription)
                            ? it.VariantDescription
                            : string.Join(" / ", new[] { it.ColorName, it.SizeName }.Where(x => !string.IsNullOrWhiteSpace(x)));
                        <tr>
                            <td style="font-weight: 700; color: #64748b;">@(i + 1)</td>
                            <td>
                                <div style="font-weight: 700; color: #0f172a;">@it.ProductName</div>
                                @if (!string.IsNullOrWhiteSpace(varLabel))
                                {
                                    <div style="font-size: 11px; color: #475569; margin-top: 1px;">Phân loại: @varLabel</div>
                                }
                            </td>
                            <td style="text-align: right; font-weight: 800; font-size: 13px; color: #0f172a;">x@(it.Quantity)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="footer-note">
            <div style="line-height: 1.5;">
                <strong style="color: #0f172a;">Chỉ dẫn giao hàng:</strong><br />
                • Vui lòng gọi điện trước khi giao hàng.<br />
                • Khuyến khích khách quay video mở hộp để được bảo vệ quyền lợi đổi trả 100% trên sàn Sellzy.
            </div>
            <div class="sign-box">
                <div style="font-weight: 800; color: #0f172a;">Chữ ký người nhận</div>
                <div style="font-size: 10px; color: #64748b; margin-top: 26px;">(Ký &amp; ghi rõ họ tên)</div>
            </div>
        </div>
    </div>
</body>
</html>
