@model DOAN_BANHANG.ViewModels.AdminOrderDetailsVm
@{
    Layout = null;
    var sellerName = ViewBag.SellerShopName as string ?? "GIAN HÀNG SELLZY MARKETPLACE";
    var sellerEmail = ViewBag.SellerEmail as string ?? "support@sellzy.vn";
    var vatRate = 0.08m;
    var vatAmount = Math.Round(Model.SubTotal * vatRate);
    var invoiceNo = Model.Id.ToString("D7");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Hóa đơn GTGT #@invoiceNo - Đơn @Model.OrderCode</title>
    <style>
        * { box-sizing: border-box; }
        body {
            background: #e2e8f0;
            margin: 0;
            padding: 24px 16px;
            color: #111827;
            font-family: "Times New Roman", Times, serif;
        }
        .toolbar {
            max-width: 880px;
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: #063532;
            padding: 12px 18px;
            border-radius: 14px;
            color: #fff;
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            box-shadow: 0 8px 20px rgba(6, 53, 50, 0.2);
        }
        .toolbar-title { font-size: 13px; font-weight: 600; color: #a7f3d0; }
        .btn {
            padding: 9px 18px;
            border-radius: 9px;
            border: none;
            cursor: pointer;
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            font-weight: 700;
            font-size: 13px;
        }
        .btn-print { background: #10b981; color: #fff; }
        .btn-print:hover { background: #059669; }
        .btn-close { background: rgba(255,255,255,0.14); color: #fff; border: 1px solid rgba(255,255,255,0.25); }

        .invoice-box {
            max-width: 880px;
            margin: 0 auto;
            background: #fff;
            border: 3px double #991b1b;
            border-radius: 6px;
            padding: 36px 42px;
            position: relative;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.12);
            overflow: hidden;
        }
        .invoice-watermark {
            position: absolute;
            top: 52%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-24deg);
            font-size: 64px;
            font-weight: 900;
            color: rgba(153, 27, 27, 0.04);
            letter-spacing: 8px;
            white-space: nowrap;
            pointer-events: none;
            user-select: none;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #991b1b;
            padding-bottom: 16px;
            margin-bottom: 18px;
            position: relative;
            z-index: 1;
        }
        .brand-block { min-width: 195px; }
        .brand-logo {
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            font-weight: 900;
            color: #063532;
            font-size: 19px;
            letter-spacing: 0.5px;
        }
        .brand-sub { font-size: 12.5px; color: #4b5563; margin-top: 3px; }
        .title-block { text-align: center; flex: 1; }
        .title-block h1 {
            color: #991b1b;
            font-size: 25px;
            margin: 0 0 4px 0;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }
        .title-block .sub { color: #991b1b; font-style: italic; font-size: 14px; margin-bottom: 6px; }
        .meta-block { text-align: right; font-size: 14px; line-height: 1.65; min-width: 195px; }

        .info-panel {
            position: relative;
            z-index: 1;
            margin-bottom: 14px;
            padding: 12px 14px;
            border: 1px solid #fecaca;
            border-radius: 6px;
            background: #fffafa;
            font-size: 14.5px;
            line-height: 1.7;
        }
        .info-row { display: flex; gap: 10px; }
        .label { font-weight: bold; min-width: 195px; color: #374151; flex-shrink: 0; }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 18px 0;
            font-size: 14px;
            position: relative;
            z-index: 1;
        }
        th, td { border: 1px solid #b91c1c; padding: 9px 10px; }
        th { background: #fef2f2; color: #991b1b; text-align: center; font-weight: bold; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }

        .signatures {
            display: flex;
            justify-content: space-between;
            margin-top: 32px;
            text-align: center;
            position: relative;
            z-index: 1;
        }
        .sig-col { width: 45%; }
        .sig-stamp {
            margin-top: 14px;
            display: inline-block;
            border: 2px solid #059669;
            color: #065f46;
            padding: 9px 18px;
            font-weight: bold;
            font-size: 12.5px;
            border-radius: 6px;
            background: #ecfdf5;
            text-align: left;
            line-height: 1.5;
        }
        .footer-legal {
            margin-top: 28px;
            padding-top: 10px;
            border-top: 1px dashed #cbd5e1;
            text-align: center;
            font-size: 12px;
            color: #64748b;
            font-style: italic;
        }

        @@media print {
            body { background: #fff; padding: 0; }
            .toolbar { display: none !important; }
            .invoice-box { box-shadow: none; max-width: 100%; border-radius: 0; }
            th, .info-panel, .sig-stamp { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <div class="toolbar-title">Hóa đơn GTGT điện tử • Số @invoiceNo • Đơn @Model.OrderCode</div>
        <div style="display: flex; gap: 8px;">
            <button class="btn btn-print" onclick="window.print()">In Hóa đơn GTGT (PDF)</button>
            <button class="btn btn-close" onclick="window.close()">Đóng</button>
        </div>
    </div>

    <div class="invoice-box">
        <div class="invoice-watermark">SELLZY E-INVOICE</div>

        <div class="header">
            <div class="brand-block">
                <div class="brand-logo">SELLZY E-INVOICE</div>
                <div class="brand-sub">Sàn TMĐT Đa Ngành Sellzy</div>
                <div class="brand-sub">Chuẩn NĐ 123/2020/NĐ-CP</div>
            </div>
            <div class="title-block">
                <h1>HÓA ĐƠN GIÁ TRỊ GIA TĂNG</h1>
                <div class="sub">(Bản thể hiện của hóa đơn điện tử)</div>
                <div style="font-size: 14px;">
                    Ngày <strong>@Model.CreatedAt.ToLocalTime().ToString("dd")</strong>
                    tháng <strong>@Model.CreatedAt.ToLocalTime().ToString("MM")</strong>
                    năm <strong>@Model.CreatedAt.ToLocalTime().ToString("yyyy")</strong>
                </div>
            </div>
            <div class="meta-block">
                <div>Mẫu số: <strong>1/001</strong></div>
                <div>Ký hiệu: <strong>C26TSZ</strong></div>
                <div>Số: <strong style="color:#b91c1c; font-size:17px;">@invoiceNo</strong></div>
            </div>
        </div>

        <div class="info-panel">
            <div class="info-row"><span class="label">Đơn vị bán hàng:</span> <strong style="text-transform:uppercase; color:#991b1b;">@sellerName</strong></div>
            <div class="info-row"><span class="label">Mã đơn hàng gốc:</span> <span><strong>@Model.OrderCode</strong> — Email hỗ trợ: @sellerEmail</span></div>
            <div class="info-row"><span class="label">Hình thức thanh toán:</span> <span>@Model.PaymentMethod (@Model.PaymentStatus)</span></div>
        </div>

        <div class="info-panel" style="background: #fff; border-color: #e2e8f0;">
            <div class="info-row"><span class="label">Họ tên người mua hàng:</span> <span><strong>@Model.RecipientName</strong> (@Model.RecipientPhone)</span></div>
            <div class="info-row"><span class="label">Tên đơn vị (Công ty):</span> <strong style="text-transform:uppercase;">@(!string.IsNullOrWhiteSpace(Model.CompanyName) ? Model.CompanyName : Model.RecipientName)</strong></div>
            <div class="info-row"><span class="label">Mã số thuế (MST):</span> <strong style="color:#991b1b; letter-spacing:1px;">@(!string.IsNullOrWhiteSpace(Model.TaxCode) ? Model.TaxCode : "—")</strong></div>
            <div class="info-row"><span class="label">Địa chỉ xuất hóa đơn:</span> <span>@(!string.IsNullOrWhiteSpace(Model.CompanyAddress) ? Model.CompanyAddress : Model.ShippingAddress)</span></div>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width: 45px;">STT</th>
                    <th>Tên hàng hóa, dịch vụ</th>
                    <th style="width: 140px;">Phân loại</th>
                    <th style="width: 65px;">ĐVT</th>
                    <th style="width: 55px;">SL</th>
                    <th style="width: 120px;">Đơn giá (₫)</th>
                    <th style="width: 135px;">Thành tiền (₫)</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    var varLabel = !string.IsNullOrWhiteSpace(item.VariantDescription)
                        ? item.VariantDescription
                        : string.Join(" - ", new[] { item.ColorName, item.SizeName }.Where(x => !string.IsNullOrWhiteSpace(x)));
                    <tr>
                        <td class="text-center">@(i + 1)</td>
                        <td><strong>@item.ProductName</strong></td>
                        <td class="text-center">@(string.IsNullOrWhiteSpace(varLabel) ? "Tiêu chuẩn" : varLabel)</td>
                        <td class="text-center">@(Model.IsDigitalOrder ? "Gói/Mã" : "Cái")</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-right">@item.UnitPrice.ToString("N0")</td>
                        <td class="text-right"><strong>@item.LineTotal.ToString("N0")</strong></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="6" class="text-right"><strong>Cộng tiền hàng (Chưa thuế GTGT):</strong></td>
                    <td class="text-right"><strong>@Model.SubTotal.ToString("N0") ₫</strong></td>
                </tr>
                <tr>
                    <td colspan="6" class="text-right">Thuế suất GTGT (8%) — Tiền thuế GTGT:</td>
                    <td class="text-right">@vatAmount.ToString("N0") ₫</td>
                </tr>
                <tr>
                    <td colspan="6" class="text-right">Phí vận chuyển / Chiết khấu Voucher:</td>
                    <td class="text-right">+@Model.ShippingFee.ToString("N0") ₫ / -@Model.DiscountAmount.ToString("N0") ₫</td>
                </tr>
                <tr style="background:#fef2f2;">
                    <td colspan="6" class="text-right"><strong style="color:#991b1b; font-size:15.5px;">TỔNG CỘNG TIỀN THANH TOÁN:</strong></td>
                    <td class="text-right"><strong style="color:#991b1b; font-size:16px;">@Model.FinalAmount.ToString("N0") ₫</strong></td>
                </tr>
            </tfoot>
        </table>

        <div class="signatures">
            <div class="sig-col">
                <strong>Người mua hàng</strong>
                <div style="font-size:12px; font-style:italic; color:#6b7280;">(Ký, ghi rõ họ tên)</div>
            </div>
            <div class="sig-col">
                <strong>Người bán hàng</strong>
                <div style="font-size:12px; font-style:italic; color:#6b7280;">(Chữ ký số điện tử hợp lệ)</div>
                <div class="sig-stamp">
                    ✓ Signature Valid<br />
                    Ký bởi: @sellerName<br />
                    Ngày ký: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>

        <div class="footer-legal">
            Hóa đơn điện tử được khởi tạo từ hệ thống Sellzy Marketplace — Tra cứu trực tuyến bằng Mã đơn hàng @Model.OrderCode.
        </div>
    </div>
</body>
</html>
