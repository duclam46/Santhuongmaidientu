@model DOAN_BANHANG.ViewModels.AdminPartnerApplicationListVm
@{
    ViewData["Title"] = "Duyệt phiếu đăng ký đối tác";

    var isSignedIn = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;

    var activeStatus = (Model.Query.Status ?? string.Empty).Trim();
    var statusTabs = new (string? status, string label)[]
    {
        (null, "Tất cả"),
        ("Pending", "Chờ duyệt"),
        ("Approved", "Đã duyệt"),
        ("Rejected", "Đã từ chối")
    };

    (string label, string badgeClass, string icon) ResolveStatusUi(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "pending" => ("Chờ duyệt", "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle", "bx bx-time-five"),
            "approved" => ("Đã duyệt", "badge bg-success-subtle text-success-emphasis border border-success-subtle", "bx bx-check-circle"),
            "rejected" => ("Đã từ chối", "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle", "bx bx-x-circle"),
            _ => (string.IsNullOrWhiteSpace(s) ? "(không rõ)" : s, "badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle", "bx bx-info-circle")
        };
    }
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 bg-light border rounded-3 p-3">
                <div>
                    <h4 class="mb-1"><i class="bx bx-user-check me-1"></i>Duyệt phiếu đăng ký đối tác</h4>
                    <div class="text-muted small">Xét duyệt nâng cấp tài khoản thành nhà bán hàng</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill px-3 py-2">
                        <i class="bx bx-layer me-1"></i>
                        Tổng: @Model.TotalItems
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-primary-subtle border-0 border-start border-4 border-primary">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-xs">
                            <span class="avatar-title rounded-circle bg-primary text-white">
                                <i class="bx bx-list-check"></i>
                            </span>
                        </div>
                        <div>
                            <h5 class="mb-0">Danh sách phiếu</h5>
                            <div class="text-muted small">Lọc theo trạng thái, tìm theo email/tên shop</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
                {
                    <div class="alert alert-info d-flex align-items-start gap-2 rounded-3" role="alert">
                        <i class="bx bx-info-circle mt-1"></i>
                        <div>@toast</div>
                    </div>
                }

                @if (!isSignedIn)
                {
                    <div class="alert alert-warning mb-0">Bạn chưa đăng nhập. Vui lòng đăng nhập Admin để xét duyệt phiếu.</div>
                }
                else if (!isAdmin)
                {
                    <div class="alert alert-danger mb-0">Tài khoản hiện tại không có quyền xét duyệt phiếu đăng ký đối tác.</div>
                }
                else
                {
                    <ul class="nav nav-pills mb-3 bg-light border rounded-3 p-2" role="tablist">
                        @foreach (var t in statusTabs)
                        {
                            var isActive = string.IsNullOrWhiteSpace(t.status)
                                ? string.IsNullOrWhiteSpace(activeStatus)
                                : string.Equals(activeStatus, t.status, StringComparison.OrdinalIgnoreCase);

                            <li class="nav-item" role="presentation">
                                <a class="nav-link @(isActive ? "active fw-semibold" : string.Empty)"
                                   asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index"
                                   asp-route-Status="@t.status"
                                   asp-route-Search="@Model.Query.Search">
                                    @t.label
                                    @if (string.Equals(t.status, "Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge rounded-pill bg-warning text-dark ms-1">@Model.PendingItems</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="border rounded-3 p-3 bg-light">
                        <form method="get" class="row g-2 align-items-end">
                            <div class="col-sm-6">
                                <label class="form-label"><i class="bx bx-search-alt me-1"></i>Tìm kiếm</label>
                                <input class="form-control" name="Search" value="@Model.Query.Search" placeholder="Email / Tên shop / Họ tên" />
                            </div>
                            <div class="col-sm-3">
                                <label class="form-label"><i class="bx bx-filter-alt me-1"></i>Trạng thái</label>
                                <select class="form-select" name="Status">
                                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Query.Status))">Tất cả</option>
                                    <option value="Pending" selected="@(Model.Query.Status == "Pending")">Chờ duyệt</option>
                                    <option value="Approved" selected="@(Model.Query.Status == "Approved")">Đã duyệt</option>
                                    <option value="Rejected" selected="@(Model.Query.Status == "Rejected")">Đã từ chối</option>
                                </select>
                            </div>
                            <div class="col-sm-3 d-flex gap-2">
                                <button class="btn btn-primary" type="submit"><i class="bx bx-filter me-1"></i>Lọc</button>
                                <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index" asp-route-Status="Pending"><i class="bx bx-reset me-1"></i>Reset</a>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive mt-4">
                        <table class="table table-striped table-hover align-middle table-nowrap mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Trạng thái</th>
                                    <th>Email</th>
                                    <th>Họ tên</th>
                                    <th>Điện thoại</th>
                                    <th>Tên shop</th>
                                    <th>Ngày gửi</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">Không có phiếu nào.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var x in Model.Items)
                                {
                                    var (label, badgeClass, icon) = ResolveStatusUi(x.Status);
                                    <tr>
                                        <td class="text-muted">@x.Id</td>
                                        <td><span class="@badgeClass"><i class="@icon me-1"></i>@label</span></td>
                                        <td class="fw-semibold">@x.Email</td>
                                        <td>@(string.IsNullOrWhiteSpace(x.FullName) ? "-" : x.FullName)</td>
                                        <td>@(string.IsNullOrWhiteSpace(x.PhoneNumber) ? "-" : x.PhoneNumber)</td>
                                        <td>@(string.IsNullOrWhiteSpace(x.ShopName) ? "-" : x.ShopName)</td>
                                        <td>@x.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="PartnerApplications" asp-action="Details" asp-route-id="@x.Id">
                                                <i class="bx bx-detail me-1"></i>Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
