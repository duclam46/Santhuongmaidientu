@model DOAN_BANHANG.ViewModels.AdminPartnerApplicationListVm
@{
    ViewData["Title"] = "Xét duyệt Đối tác & Sellzy Mall";

    var isSignedIn = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;

    var activeStatus = (Model.Query.Status ?? string.Empty).Trim();
    var activeTier = (Model.Query.Tier ?? string.Empty).Trim();

    var statusTabs = new (string? status, string label, string icon, int count)[]
    {
        (null, "Tất cả hồ sơ", "bx bx-layer", Model.AllApplicationsCount),
        ("Pending", "Chờ xét duyệt", "bx bx-time-five", Model.PendingItems),
        ("Approved", "Đã phê duyệt", "bx bx-check-circle", Model.ApprovedItems),
        ("Rejected", "Đã từ chối", "bx bx-x-circle", Model.RejectedItems)
    };

    (string label, string badgeClass, string icon) ResolveStatusUi(string? raw)
    {
        var s = (raw ?? string.Empty).Trim().Replace(" ", string.Empty).ToLowerInvariant();
        return s switch
        {
            "pending" => ("Chờ xét duyệt", "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1", "bx bx-time-five"),
            "approved" => ("Đã phê duyệt", "badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-2.5 py-1", "bx bx-check-circle"),
            "rejected" => ("Đã từ chối", "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill px-2.5 py-1", "bx bx-x-circle"),
            _ => ("Không rõ", "badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-2.5 py-1", "bx bx-info-circle")
        };
    }
}

@section Styles {
    <style>
        .pa-hero {
            background: radial-gradient(circle at 88% 18%, rgba(255, 235, 105, 0.16) 0%, transparent 46%),
                        linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
            border-radius: 22px;
            padding: 26px 30px;
            color: #ffffff;
            margin-bottom: 24px;
            box-shadow: 0 18px 38px -16px rgba(0, 38, 42, 0.34);
        }
        .pa-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-top: 18px;
        }
        @@media (max-width: 991px) {
            .pa-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        .pa-kpi-card {
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 16px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .pa-kpi-ic {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: rgba(255, 235, 105, 0.18);
            color: #FFEB69;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
        .pa-tab-bar {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 8px;
            background: #F1F5F9;
            padding: 6px;
            border-radius: 16px;
            margin-bottom: 18px;
        }
        @@media (max-width: 767px) {
            .pa-tab-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        .pa-tab-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 10px 12px;
            border-radius: 12px;
            font-size: 13.5px;
            font-weight: 700;
            color: #475569;
            transition: all 0.2s ease;
            text-decoration: none !important;
        }
        .pa-tab-btn:hover {
            color: #088178;
            background: rgba(255, 255, 255, 0.65);
        }
        .pa-tab-btn.is-active {
            background: #088178;
            color: #ffffff !important;
            box-shadow: 0 6px 14px -6px rgba(8, 129, 120, 0.45);
        }
        .pa-tier-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .pa-tier-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid #CBD5E1;
            background: #ffffff;
            color: #334155;
            text-decoration: none !important;
            transition: all 0.18s ease;
        }
        .pa-tier-pill:hover {
            border-color: #088178;
            color: #088178;
        }
        .pa-tier-pill.is-active {
            background: #00262A;
            border-color: #00262A;
            color: #FFEB69 !important;
        }
        .pa-shop-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
        }
        .pa-shop-avatar.is-mall {
            background: linear-gradient(135deg, #00262A 0%, #065F58 100%);
            color: #FFEB69;
            border: 1px solid rgba(255, 235, 105, 0.45);
        }
        .pa-shop-avatar.is-std {
            background: #E6F4F3;
            color: #088178;
            border: 1px solid #B7E4E0;
        }
    </style>
}

<!-- HERO HEADER -->
<div class="pa-hero">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h4 class="text-white fw-bold mb-1">
                <i class="bx bx-shield-quarter text-warning me-1"></i>Xét duyệt Hồ sơ Đối tác &amp; Sellzy Mall
            </h4>
            <p class="mb-0 small" style="color: rgba(255,255,255,0.82);">
                Thẩm định hồ sơ mở mới <strong>Shop Thường</strong> và cấp chứng nhận gian hàng chính hãng <strong>Sellzy Mall</strong> trên toàn sàn.
            </p>
        </div>
        <a asp-area="Admin" asp-controller="Accounts" asp-action="Index" asp-route-Role="Shop" class="btn btn-sm rounded-pill px-3 fw-bold" style="background: #FFEB69; color: #161C24;">
            <i class="bx bx-store-alt me-1"></i>Danh sách đối tác
        </a>
    </div>

    <div class="pa-kpi-grid">
        <div class="pa-kpi-card">
            <span class="pa-kpi-ic"><i class="bx bx-folder-open"></i></span>
            <div>
                <div class="fs-5 fw-bold text-white lh-1">@Model.AllApplicationsCount</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Tổng hồ sơ đã nhận</div>
            </div>
        </div>
        <div class="pa-kpi-card">
            <span class="pa-kpi-ic" style="background: rgba(251,191,36,0.22); color: #FDE68A;"><i class="bx bx-time-five"></i></span>
            <div>
                <div class="fs-5 fw-bold text-white lh-1">@Model.PendingItems</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Đang chờ xét duyệt</div>
            </div>
        </div>
        <div class="pa-kpi-card">
            <span class="pa-kpi-ic"><i class="bx bxs-badge-check"></i></span>
            <div>
                <div class="fs-5 fw-bold lh-1" style="color: #FFEB69;">@Model.PendingMallItems</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Hồ sơ Mall chờ duyệt</div>
            </div>
        </div>
        <div class="pa-kpi-card">
            <span class="pa-kpi-ic" style="background: rgba(52,211,153,0.22); color: #6EE7B7;"><i class="bx bx-check-shield"></i></span>
            <div>
                <div class="fs-5 fw-bold text-white lh-1">@Model.ApprovedItems</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Hồ sơ đã phê duyệt</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-4">
        @if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
        {
            <div class="alert alert-info alert-dismissible fade show d-flex align-items-start gap-2 rounded-3" role="alert">
                <i class="bx bx-info-circle mt-1 fs-5"></i>
                <div>@toast</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!isSignedIn)
        {
            <div class="alert alert-warning mb-0">Bạn chưa đăng nhập. Vui lòng đăng nhập tài khoản Quản trị viên để xét duyệt hồ sơ.</div>
        }
        else if (!isAdmin)
        {
            <div class="alert alert-danger mb-0">Tài khoản hiện tại không có quyền xét duyệt hồ sơ đối tác.</div>
        }
        else
        {
            <!-- THANH CHUYỂN TRẠNG THÁI -->
            <div class="pa-tab-bar">
                @foreach (var t in statusTabs)
                {
                    var isActive = string.IsNullOrWhiteSpace(t.status)
                        ? string.IsNullOrWhiteSpace(activeStatus)
                        : string.Equals(activeStatus, t.status, StringComparison.OrdinalIgnoreCase);

                    <a class="pa-tab-btn @(isActive ? "is-active" : "")"
                       asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index"
                       asp-route-Status="@t.status"
                       asp-route-Tier="@Model.Query.Tier"
                       asp-route-Search="@Model.Query.Search">
                        <i class="@t.icon fs-6"></i>
                        <span>@t.label</span>
                        <span class="badge rounded-pill @(isActive ? "bg-white text-primary" : "bg-secondary-subtle text-dark")">@t.count</span>
                    </a>
                }
            </div>

            <!-- BỘ LỌC MÔ HÌNH & TÌM KIẾM -->
            <div class="border rounded-3 px-3 py-2.5 bg-light mb-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="small fw-bold text-secondary me-1">
                            <i class="bx bx-category me-1"></i>Phân hạng:
                        </span>
                        <div class="pa-tier-pills">
                            <a class="pa-tier-pill @(string.IsNullOrWhiteSpace(activeTier) ? "is-active" : "")"
                               asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index"
                               asp-route-Status="@Model.Query.Status" asp-route-Tier="" asp-route-Search="@Model.Query.Search">
                                Tất cả
                            </a>
                            <a class="pa-tier-pill @(activeTier == "Standard" ? "is-active" : "")"
                               asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index"
                               asp-route-Status="@Model.Query.Status" asp-route-Tier="Standard" asp-route-Search="@Model.Query.Search">
                                <i class="bx bx-store"></i>Shop Thường
                            </a>
                            <a class="pa-tier-pill @(activeTier == "Mall" ? "is-active" : "")"
                               asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index"
                               asp-route-Status="@Model.Query.Status" asp-route-Tier="Mall" asp-route-Search="@Model.Query.Search">
                                <i class="bx bxs-badge-check"></i>Sellzy Mall
                            </a>
                            <a class="pa-tier-pill @(activeTier == "MallUpgrade" ? "is-active" : "")"
                               asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index"
                               asp-route-Status="@Model.Query.Status" asp-route-Tier="MallUpgrade" asp-route-Search="@Model.Query.Search">
                                <i class="bx bx-trending-up"></i>Nâng cấp Mall
                            </a>
                        </div>
                    </div>

                    <form method="get" class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 460px;">
                        <input type="hidden" name="Status" value="@Model.Query.Status" />
                        <input type="hidden" name="Tier" value="@Model.Query.Tier" />
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bx bx-search"></i></span>
                            <input class="form-control border-start-0 ps-0" name="Search" value="@Model.Query.Search" placeholder="Tìm tên shop, email, công ty, MST..." />
                        </div>
                        <button class="btn btn-sm btn-primary px-3 fw-semibold text-nowrap" type="submit">
                            Tìm kiếm
                        </button>
                        <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index" title="Đặt lại bộ lọc">
                            <i class="bx bx-reset"></i>
                        </a>
                    </form>
                </div>
            </div>

            <!-- BẢNG HỒ SƠ ĐỐI TÁC -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 65px;">#</th>
                            <th>Gian hàng &amp; Thương hiệu</th>
                            <th>Phân hạng &amp; Loại hồ sơ</th>
                            <th>Pháp nhân / Mã số thuế</th>
                            <th>Đại diện &amp; Liên hệ</th>
                            <th>Trạng thái</th>
                            <th>Ngày gửi</th>
                            <th class="text-end" style="width: 145px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <i class="bx bx-folder-open display-5 text-muted d-block mb-2"></i>
                                    <div class="fw-bold text-dark">Không có hồ sơ đối tác nào phù hợp</div>
                                    <div class="text-muted small mt-1">Hãy thử chuyển sang tab trạng thái khác hoặc xóa từ khóa tìm kiếm.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var x in Model.Items)
                            {
                                var (label, badgeClass, icon) = ResolveStatusUi(x.Status);
                                var isMallReq = string.Equals(x.RequestedShopTier, "Mall", StringComparison.OrdinalIgnoreCase);
                                var isUpgrade = string.Equals(x.ApplicationType, "MallUpgrade", StringComparison.OrdinalIgnoreCase);
                                var isPending = string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase);
                                var shopLabel = string.IsNullOrWhiteSpace(x.ShopName) ? x.Email : x.ShopName;
                                var initial = !string.IsNullOrWhiteSpace(shopLabel) ? shopLabel.Trim()[0].ToString().ToUpperInvariant() : "S";

                                <tr>
                                    <td class="text-muted fw-semibold">#@x.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="pa-shop-avatar @(isMallReq ? "is-mall" : "is-std")">@initial</div>
                                            <div>
                                                <div class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(x.ShopName) ? "Chưa đặt tên gian hàng" : x.ShopName)</div>
                                                @if (!string.IsNullOrWhiteSpace(x.BrandName))
                                                {
                                                    <div class="small text-primary"><i class="bx bx-purchase-tag-alt me-1"></i>Thương hiệu: <strong>@x.BrandName</strong></div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (isMallReq)
                                        {
                                            <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #00262A; color: #FFEB69;">
                                                <i class="bx bxs-badge-check me-1"></i>Sellzy Mall
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-1">
                                                <i class="bx bx-store me-1"></i>Shop Thường
                                            </span>
                                        }
                                        <div class="small text-muted mt-1">
                                            @if (isUpgrade)
                                            {
                                                <i class="bx bx-trending-up text-warning me-1"></i><span>Xin nâng cấp lên Mall</span>
                                            }
                                            else
                                            {
                                                <i class="bx bx-plus-circle text-primary me-1"></i><span>Đăng ký mở gian hàng mới</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(x.BusinessName) || !string.IsNullOrWhiteSpace(x.BusinessTaxCode))
                                        {
                                            <div class="fw-semibold text-dark">@(x.BusinessName ?? "-")</div>
                                            <div class="small text-muted">Mã số thuế: <span class="font-monospace fw-semibold text-dark">@(x.BusinessTaxCode ?? "-")</span></div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border rounded-pill px-2.5 py-1">Cá nhân / Hộ kinh doanh</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(x.FullName) ? x.Email : x.FullName)</div>
                                        <div class="small text-muted">@x.Email</div>
                                        @if (!string.IsNullOrWhiteSpace(x.PhoneNumber))
                                        {
                                            <div class="small text-muted">SĐT: @x.PhoneNumber</div>
                                        }
                                    </td>
                                    <td><span class="@badgeClass"><i class="@icon me-1"></i>@label</span></td>
                                    <td>
                                        <div class="small text-dark fw-semibold">@x.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                        <div class="small text-muted">@x.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm rounded-pill px-3 fw-semibold @(isPending ? "btn-primary" : "btn-outline-secondary")"
                                           asp-area="Admin" asp-controller="PartnerApplications" asp-action="Details" asp-route-id="@x.Id">
                                            <i class="bx @(isPending ? "bx-check-shield" : "bx-show") me-1"></i>@(isPending ? "Thẩm định" : "Xem hồ sơ")
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
