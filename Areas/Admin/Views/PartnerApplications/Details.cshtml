@model DOAN_BANHANG.ViewModels.AdminPartnerApplicationDetailsVm
@{
    ViewData["Title"] = "Chi tiết phiếu đăng ký";

    var isAdmin = User?.IsInRole("Admin") ?? false;

    (string label, string badgeClass, string icon) ResolveStatusUi(string? raw)
    {
        var s = (raw ?? string.Empty).Trim();
        var n = s.Replace(" ", string.Empty).ToLowerInvariant();
        return n switch
        {
            "pending" => ("Chờ duyệt", "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle", "bx bx-time-five"),
            "approved" => ("Đã duyệt", "badge bg-success-subtle text-success-emphasis border border-success-subtle", "bx bx-check-circle"),
            "rejected" => ("Đã từ chối", "badge bg-danger-subtle text-danger-emphasis border border-danger-subtle", "bx bx-x-circle"),
            _ => (string.IsNullOrWhiteSpace(s) ? "(không rõ)" : s, "badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle", "bx bx-info-circle")
        };
    }

    var (statusLabel, statusBadge, statusIcon) = ResolveStatusUi(Model.Status);
    var isPending = string.Equals((Model.Status ?? string.Empty).Trim(), "Pending", StringComparison.OrdinalIgnoreCase);
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 bg-light border rounded-3 p-3">
                <div>
                    <h4 class="mb-1"><i class="bx bx-detail me-1"></i>Chi tiết phiếu #@Model.Id</h4>
                    <div class="text-muted small">@Model.Email</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="@statusBadge"><i class="@statusIcon me-1"></i>@statusLabel</span>
                    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="PartnerApplications" asp-action="Index" asp-route-Status="Pending">
                        <i class="bx bx-left-arrow-alt me-1"></i>Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
{
    <div class="alert alert-info d-flex align-items-start gap-2 rounded-3" role="alert">
        <i class="bx bx-info-circle mt-1"></i>
        <div>@toast</div>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-primary-subtle border-0 border-start border-4 border-primary">
                <h5 class="mb-0"><i class="bx bx-user me-1"></i>Thông tin đăng ký</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Họ tên</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Số điện thoại</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</div>
                    </div>
                    <div class="col-md-12">
                        <div class="text-muted small">Tên shop</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.ShopName) ? "-" : Model.ShopName)</div>
                    </div>
                    <div class="col-md-12">
                        <div class="text-muted small">Mô tả shop</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.ShopDescription) ? "-" : Model.ShopDescription)</div>
                    </div>
                    <div class="col-md-12">
                        <div class="text-muted small">Địa chỉ (GHN)</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</div>
                        <div class="text-muted small mt-1">Số nhà, tên đường: @(string.IsNullOrWhiteSpace(Model.StreetAddress) ? "-" : Model.StreetAddress)</div>
                        <div class="text-muted small">Phường/Xã: @(string.IsNullOrWhiteSpace(Model.WardName) ? "-" : Model.WardName) (@(string.IsNullOrWhiteSpace(Model.WardCode) ? "-" : Model.WardCode))</div>
                        <div class="text-muted small">Quận/Huyện: @(string.IsNullOrWhiteSpace(Model.DistrictName) ? "-" : Model.DistrictName) (@Model.DistrictId)</div>
                        <div class="text-muted small">Tỉnh/TP: @(string.IsNullOrWhiteSpace(Model.ProvinceName) ? "-" : Model.ProvinceName) (@Model.ProvinceId)</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Ngày gửi</div>
                        <div class="fw-semibold">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Quyết định lúc</div>
                        <div class="fw-semibold">@(Model.DecidedAt.HasValue ? Model.DecidedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                    {
                        <div class="col-12">
                            <div class="alert alert-danger mb-0">
                                <div class="fw-semibold">Lý do từ chối</div>
                                <div>@Model.RejectionReason</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-light border-0 border-start border-4 border-secondary">
                <h5 class="mb-0"><i class="bx bx-shield-quarter me-1"></i>Thao tác xét duyệt</h5>
            </div>
            <div class="card-body">
                @if (!isAdmin)
                {
                    <div class="alert alert-danger mb-0">Bạn không có quyền xét duyệt.</div>
                }
                else if (!isPending)
                {
                    <div class="alert alert-info mb-0">Phiếu đã được xử lý, không thể duyệt lại.</div>
                }
                else
                {
                    <form asp-area="Admin" asp-controller="PartnerApplications" asp-action="Approve" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <button class="btn btn-success w-100" type="submit">
                            <i class="bx bx-check-circle me-1"></i>Duyệt & nâng cấp thành Shop
                        </button>
                    </form>

                    <form asp-area="Admin" asp-controller="PartnerApplications" asp-action="Reject" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <label class="form-label">Lý do từ chối (tuỳ chọn)</label>
                        <textarea class="form-control" name="Reason" rows="4" placeholder="VD: Thiếu thông tin giấy phép kinh doanh..."></textarea>
                        <button class="btn btn-outline-danger w-100 mt-3" type="submit">
                            <i class="bx bx-x-circle me-1"></i>Từ chối phiếu
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
