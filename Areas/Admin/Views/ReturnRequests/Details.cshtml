@model DOAN_BANHANG.Models.ReturnRequest
@using System.Text.Json
@inject DOAN_BANHANG.Models.DataContext DbContext
@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "Chi tiết yêu cầu trả hàng #" + Model.Id;

    var mediaUrls = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.MediaUrlsJson))
    {
        try { mediaUrls = JsonSerializer.Deserialize<List<string>>(Model.MediaUrlsJson) ?? new(); }
        catch { }
    }

    bool isPending = Model.Status == "Pending";
    bool isApproved = Model.Status == "Approved";
    bool isCompleted = Model.Status == "Completed";
    bool isRejected = Model.Status == "Rejected";

    var (statusLabelText, heroPillStyle, statusIcon) = Model.Status switch
    {
        "Pending" => ("Chờ xét duyệt", "background: rgba(245,158,11,0.24); color: #fde68a;", "bx bx-time-five"),
        "Approved" => ("Đã duyệt thu hồi GHN", "background: rgba(59,130,246,0.26); color: #bfdbfe;", "bx bx-car"),
        "Completed" => ("Đã hoàn tiền về Ví Khách", "background: rgba(16,185,129,0.26); color: #a7f3d0;", "bx bx-check-double"),
        "Rejected" => ("Từ chối trả hàng", "background: rgba(239,68,68,0.28); color: #fecaca;", "bx bx-x-circle"),
        _ => (Model.Status ?? "Chưa rõ", "background: rgba(255,255,255,0.16); color: #e2e8f0;", "bx bx-info-circle")
    };
}

@section AdminTopNotice {
    @if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
    {
        var alertClass = toast.Contains("thất bại") || toast.Contains("Lỗi") ? "alert-danger" : "alert-success";
        var alertIcon = toast.Contains("thất bại") || toast.Contains("Lỗi") ? "bx bx-error-circle" : "bx bx-check-circle";
        <div class="alert @alertClass d-flex align-items-start gap-2 rounded-3 shadow-sm" role="alert">
            <i class="@alertIcon mt-0.5 fs-5"></i>
            <div class="fw-semibold">@toast</div>
        </div>
    }
}

<style>
    :root {
        --rrd-teal: #0b5c56;
        --rrd-teal-dark: #063532;
        --rrd-border: #e2e8f0;
    }

    .rrd-hero {
        background: linear-gradient(135deg, #063532 0%, #0b5c56 58%, #0f766e 100%);
        border-radius: 18px;
        padding: 22px 26px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 26px rgba(6, 53, 50, 0.16);
        margin-bottom: 20px;
    }
    .rrd-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -30px;
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.28) 0%, rgba(16, 185, 129, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .rrd-btn-ghost {
        background: rgba(255,255,255,0.14);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 10px;
        padding: 9px 15px;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .rrd-btn-ghost:hover { background: rgba(255,255,255,0.22); color: #fff; }

    .rrd-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--rrd-border);
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.035);
        overflow: hidden;
    }
    .rrd-card-head {
        padding: 15px 20px;
        background: #fafcff;
        border-bottom: 1px solid var(--rrd-border);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }
    .rrd-card-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

    .rrd-info-box {
        background: #f8fafc;
        border: 1px solid var(--rrd-border);
        border-radius: 12px;
        padding: 14px 16px;
    }
    .rrd-info-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px dashed #e2e8f0;
    }
    .rrd-info-row:first-child { padding-top: 0; }
    .rrd-info-row:last-child { border-bottom: none; padding-bottom: 0; }

    .rrd-quote {
        background: #f0fdfa;
        border-left: 4px solid var(--rrd-teal);
        border-radius: 10px;
        padding: 14px 16px;
        color: #1e293b;
        font-size: 0.9rem;
        line-height: 1.55;
        font-weight: 600;
    }

    .media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }
    .media-thumb {
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid #e2e8f0;
        aspect-ratio: 1;
        background: #f8fafc;
        cursor: pointer;
        position: relative;
        transition: all 0.2s;
    }
    .media-thumb:hover { transform: translateY(-2px); border-color: var(--rrd-teal); }
    .media-thumb img, .media-thumb video { width: 100%; height: 100%; object-fit: cover; }
    .media-overlay {
        position: absolute;
        inset: 0;
        background: rgba(6, 53, 50, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s;
        color: #fff;
        font-size: 1.35rem;
    }
    .media-thumb:hover .media-overlay { opacity: 1; }

    .tracking-code-badge {
        font-family: "Consolas", "Courier New", monospace;
        font-size: 0.95rem;
        font-weight: 800;
        background: #ecfdf5;
        color: #065f46;
        padding: 6px 14px;
        border-radius: 9px;
        border: 1.5px dashed #059669;
        display: inline-block;
        letter-spacing: 0.05em;
    }

    /* Timeline */
    .timeline-item { display: flex; gap: 12px; position: relative; padding-bottom: 14px; }
    .timeline-item:last-child { padding-bottom: 0; }
    .timeline-item::before {
        content: '';
        position: absolute;
        left: 14px;
        top: 28px;
        bottom: 0;
        width: 2px;
        background: #e2e8f0;
    }
    .timeline-item:last-child::before { display: none; }
    .timeline-node {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        flex-shrink: 0;
        font-size: 0.85rem;
        box-shadow: 0 0 0 4px #fff;
    }
    .timeline-content {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 14px;
        flex-grow: 1;
    }

    @@keyframes scaleUp {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
</style>

<!-- 1. HERO HEADER -->
<div class="rrd-hero d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div style="position: relative; z-index: 2;">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="@heroPillStyle font-size: 0.74rem;">
                <i class="@statusIcon me-1"></i>@statusLabelText
            </span>
            @if (Model.Order is not null)
            {
                <span class="badge rounded-pill" style="background: rgba(255,255,255,0.16); color: #ccfbf1; font-size: 0.73rem;">
                    Đơn gốc: @Model.Order.OrderCode
                </span>
            }
        </div>
        <h3 class="mb-1 fw-bold text-white" style="font-size: 1.4rem;">Chi tiết Yêu cầu Trả hàng #@Model.Id</h3>
        <div class="small" style="color: rgba(255,255,255,0.8);">
            <i class="bx bx-calendar me-1"></i>Gửi yêu cầu lúc @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2" style="position: relative; z-index: 2;">
        @if (Model.Order is not null)
        {
            <div class="px-3 py-2 rounded-3" style="background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.2);">
                <div style="font-size: 0.68rem; color: rgba(255,255,255,0.75); text-transform: uppercase; font-weight: 700;">Giá trị hoàn</div>
                <div class="fw-bold fs-5 text-white">@Model.Order.FinalAmount.ToString("N0")₫</div>
            </div>
        }
        <a class="rrd-btn-ghost" href="@Url.Action("Index", "ReturnRequests", new { area = "Admin" })">
            <i class="bx bx-arrow-back"></i>Quay lại danh sách
        </a>
    </div>
</div>

<!-- 2. TWO-COLUMN CONTENT -->
<div class="row g-4">
    <!-- Left Column: Customer Reason & Evidence -->
    <div class="col-12 col-lg-6">
        <div class="rrd-card h-100">
            <div class="rrd-card-head">
                <div class="d-flex align-items-center gap-2">
                    <span class="rrd-card-icon" style="background: rgba(11,92,86,0.1); color: #0b5c56;">
                        <i class="bx bx-subdirectory-left"></i>
                    </span>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">Nội dung Yêu cầu &amp; Minh chứng</h6>
                        <div class="text-muted small">Lý do khiếu nại và hình ảnh/video từ khách hàng</div>
                    </div>
                </div>
                @if (mediaUrls.Count > 0)
                {
                    <span class="badge rounded-pill bg-light text-dark border">@mediaUrls.Count tệp đính kèm</span>
                }
            </div>
            <div class="p-4">
                <div class="mb-4">
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="font-size: 0.72rem;">
                        <i class="bx bx-comment-detail me-1"></i>Lý do trả hàng từ khách
                    </div>
                    <div class="rrd-quote" style="white-space: pre-wrap;">@Model.Reason</div>
                </div>

                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="font-size: 0.72rem;">
                        <i class="bx bx-image-alt me-1"></i>Hình ảnh &amp; Video minh chứng
                    </div>
                    @if (mediaUrls.Count > 0)
                    {
                        <div class="media-grid">
                            @foreach (var url in mediaUrls)
                            {
                                var ext = System.IO.Path.GetExtension(url).ToLowerInvariant();
                                bool isVideo = ext is ".mp4" or ".mov" or ".avi" or ".webm";
                                <div class="media-thumb" onclick="showLightbox('@url', @(isVideo ? "true" : "false"))">
                                    @if (isVideo)
                                    {
                                        <video src="@url"></video>
                                        <div class="media-overlay"><i class="bx bx-play-circle"></i></div>
                                    }
                                    else
                                    {
                                        <img src="@url" alt="Evidence" loading="lazy" />
                                        <div class="media-overlay"><i class="bx bx-zoom-in"></i></div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small bg-light p-4 rounded-3 text-center border">
                            <i class="bx bx-info-circle me-1"></i>Không có tệp bằng chứng nào được khách tải lên.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Order Info & Actions/Status -->
    <div class="col-12 col-lg-6">
        <div class="vstack gap-4">
            <!-- Original Order Info -->
            <div class="rrd-card">
                <div class="rrd-card-head">
                    <div class="d-flex align-items-center gap-2">
                        <span class="rrd-card-icon" style="background: #eff6ff; color: #2563eb;">
                            <i class="bx bx-shopping-bag"></i>
                        </span>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Thông tin Đơn hàng gốc</h6>
                            <div class="text-muted small">Thông tin khách mua và địa chỉ thu hồi hàng</div>
                        </div>
                    </div>
                    @if (Model.Order is not null)
                    {
                        <a href="@Url.Action("Details", "Orders", new { area = "Admin", id = Model.Order.Id })" class="btn btn-sm btn-light border fw-semibold" style="border-radius: 8px;">
                            Mở đơn gốc <i class="bx bx-link-external ms-1"></i>
                        </a>
                    }
                </div>
                <div class="p-4">
                    <div class="rrd-info-box">
                        @if (Model.Order is not null)
                        {
                            <div class="rrd-info-row">
                                <span class="text-muted small">Mã đơn hàng</span>
                                <span class="fw-bold text-dark">@Model.Order.OrderCode <span class="badge bg-light text-dark border ms-1">@Model.Order.OrderStatus</span></span>
                            </div>
                            <div class="rrd-info-row">
                                <span class="text-muted small">Người nhận / SĐT</span>
                                <span class="fw-bold text-dark text-end">@Model.Order.RecipientName • @Model.Order.RecipientPhone</span>
                            </div>
                            <div class="rrd-info-row">
                                <span class="text-muted small">Địa chỉ thu hồi</span>
                                <span class="fw-semibold text-dark text-end" style="max-width: 68%;">@Model.Order.ShippingAddress</span>
                            </div>
                        }
                        else
                        {
                            <div class="text-danger small fw-bold">Không tìm thấy đơn hàng gốc tương ứng.</div>
                        }
                        <div class="rrd-info-row">
                            <span class="text-muted small">Tài khoản mua hàng</span>
                            <span class="fw-semibold text-dark text-end">@(Model.Customer?.Profile?.FullName ?? "—") <span class="text-muted small">(@Model.Customer?.Email)</span></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Approved: GHN Return Tracking & Complete Refund -->
            @if (isApproved)
            {
                var returnLogs = await DbContext.OrderTrackingLogs
                    .AsNoTracking()
                    .Where(x => x.OrderId == Model.OrderId && x.Note != null && x.Note.StartsWith("SIM_RET|"))
                    .OrderBy(x => x.CreatedAt)
                    .ToListAsync();

                <div class="rrd-card" style="border-color: #a7f3d0;">
                    <div class="rrd-card-head" style="background: #ecfdf5; border-bottom-color: #a7f3d0;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rrd-card-icon" style="background: #10b981; color: #fff;">
                                <i class="bx bx-package"></i>
                            </span>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">Vận đơn thu hồi GHN &amp; Giải ngân Hoàn tiền</h6>
                                <div class="text-muted small">Theo dõi hành trình hàng hoàn về Shop</div>
                            </div>
                        </div>
                        <span class="badge rounded-pill bg-success">Approved</span>
                    </div>
                    <div class="p-4">
                        <div class="rrd-info-box mb-3">
                            <div class="rrd-info-row">
                                <span class="text-muted small">Mã vận đơn hoàn GHN</span>
                                <span>
                                    @if (!string.IsNullOrWhiteSpace(Model.ReturnTrackingCode))
                                    {
                                        <span class="tracking-code-badge">@Model.ReturnTrackingCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small fw-bold">(Chưa có mã vận đơn)</span>
                                    }
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.EstimatedPickupTime))
                            {
                                <div class="rrd-info-row">
                                    <span class="text-muted small">Ca tài xế hẹn lấy</span>
                                    <span class="fw-bold text-success">@Model.EstimatedPickupTime</span>
                                </div>
                            }
                            <div class="rrd-info-row">
                                <span class="text-muted small">Ngày phê duyệt</span>
                                <span class="fw-semibold text-dark">@Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>

                        <div class="p-3 mb-3 rounded-3 border bg-success-subtle border-success-subtle d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="small text-dark">
                                <strong><i class="bx bx-wallet text-success me-1"></i>Xác nhận đã nhận hàng hoàn &amp; Hoàn tiền:</strong><br />
                                <span>Hoàn <strong>@((Model.Order?.FinalAmount ?? 0m).ToString("N0"))₫</strong> vào Ví Sellzy của khách và cộng lại tồn kho.</span>
                            </div>
                            <form method="post" action="@Url.Action("CompleteRefund", "ReturnRequests", new { area = "Admin", id = Model.Id })"
                                  onsubmit="return confirm('Xác nhận hoàn tiền @((Model.Order?.FinalAmount ?? 0m).ToString("N0"))₫ vào Ví Sellzy của khách hàng và cộng lại tồn kho?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-sm fw-bold rounded-pill px-3 py-2">
                                    <i class="bx bx-transfer-alt me-1"></i>Hoàn tiền ngay (@((Model.Order?.FinalAmount ?? 0m).ToString("N0"))₫)
                                </button>
                            </form>
                        </div>

                        @if (returnLogs.Count == 0)
                        {
                            <div class="text-center py-4 text-muted border rounded-3 bg-light">
                                <i class="bx bx-loader-alt bx-spin fs-4 text-primary mb-1"></i>
                                <div class="fw-semibold small text-dark">Chưa ghi nhận hành trình di chuyển</div>
                                <div class="small px-3">Sử dụng <strong>GhnSimulator</strong> để quét và cập nhật lộ trình đơn hoàn này.</div>
                            </div>
                        }
                        else
                        {
                            var isRefused = returnLogs.Any(x => x.Note != null && (x.Note.Contains("|e=refuse") || x.Note.Contains("Event: refuse")));
                            var isSuccessful = Model.Order?.OrderStatus == "Returned" && !isRefused;

                            <div class="p-2.5 mb-3 rounded-3 text-center border fw-bold small @(isSuccessful ? "bg-success-subtle border-success-subtle text-success" : (isRefused ? "bg-danger-subtle border-danger-subtle text-danger" : "bg-primary-subtle border-primary-subtle text-primary"))">
                                @(isSuccessful ? "ĐÃ THU HỒI & HOÀN GIAO VỀ SHOP THÀNH CÔNG" : (isRefused ? "HÀNG HOÀN BỊ SHOP TỪ CHỐI NHẬN" : "ĐƠN HOÀN ĐANG TRÊN ĐƯỜNG VẬN CHUYỂN"))
                            </div>

                            <div>
                                @foreach (var log in returnLogs)
                                {
                                    var displayMsg = log.Note;
                                    if (log.Note != null && log.Note.Contains(" - "))
                                    {
                                        displayMsg = log.Note.Substring(log.Note.IndexOf(" - ") + 3);
                                    }

                                    var isArrive = log.Note != null && log.Note.Contains("|e=arrive");
                                    var isDepart = log.Note != null && log.Note.Contains("|e=depart");
                                    var isRefuseEvent = log.Note != null && log.Note.Contains("|e=refuse");

                                    var stepIcon = isArrive ? "bx-log-in" : (isDepart ? "bx-log-out" : (isRefuseEvent ? "bx-x-circle" : "bx-git-commit"));
                                    var stepColor = isArrive ? "bg-primary text-white" : (isDepart ? "bg-success text-white" : (isRefuseEvent ? "bg-danger text-white" : "bg-secondary text-white"));

                                    <div class="timeline-item">
                                        <div class="timeline-node @stepColor"><i class="bx @stepIcon"></i></div>
                                        <div class="timeline-content">
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                                <span class="fw-bold text-dark small">@log.Status</span>
                                                <small class="text-muted"><i class="bx bx-time-five"></i> @log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                            </div>
                                            <div class="text-muted small">@displayMsg</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Rejected Info -->
            @if (isRejected)
            {
                <div class="rrd-card" style="border-color: #fecaca;">
                    <div class="rrd-card-head" style="background: #fef2f2; border-bottom-color: #fecaca;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rrd-card-icon" style="background: #dc2626; color: #fff;"><i class="bx bx-x-circle"></i></span>
                            <div>
                                <h6 class="mb-0 fw-bold text-danger">Đã từ chối yêu cầu trả hàng</h6>
                                <div class="text-muted small">Phản hồi từ Shop lúc @Model.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                    </div>
                    <div class="p-4">
                        <div class="p-3 rounded-3 bg-danger-subtle border border-danger-subtle text-danger fw-semibold small">
                            @(string.IsNullOrWhiteSpace(Model.RejectionNote) ? "Shop từ chối nhưng không ghi chú lý do." : Model.RejectionNote)
                        </div>
                    </div>
                </div>
            }

            <!-- Pending Action Panel -->
            @if (isPending)
            {
                <div class="rrd-card" style="border-color: #fde68a;">
                    <div class="rrd-card-head" style="background: #fffbeb; border-bottom-color: #fde68a;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rrd-card-icon" style="background: #f59e0b; color: #fff;"><i class="bx bx-bolt-circle"></i></span>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">Xử lý yêu cầu trả hàng</h6>
                                <div class="text-muted small">Chọn phương án duyệt thu hồi, hoàn tiền ngay hoặc từ chối</div>
                            </div>
                        </div>
                        <span class="badge rounded-pill bg-warning text-dark">Chờ duyệt</span>
                    </div>
                    <div class="p-4">
                        <div class="p-3 rounded-3 mb-3 small" style="background: #fffbeb; border: 1px solid #fde68a; color: #78350f; line-height: 1.55;">
                            <strong>Quy trình xử lý:</strong><br />
                            • <strong>Duyệt &amp; Tạo đơn GHN:</strong> Tạo vận đơn thu hồi hàng từ khách về Shop.<br />
                            • <strong>Hoàn tiền ngay:</strong> Hoàn <strong>@((Model.Order?.FinalAmount ?? 0m).ToString("N0"))₫</strong> trực tiếp vào Ví Sellzy của khách và cộng lại tồn kho.<br />
                            • <strong>Từ chối:</strong> Nhập lý do cụ thể gửi lại cho khách hàng.
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <form method="post" action="@Url.Action("Approve", "ReturnRequests", new { area = "Admin", id = Model.Id })"
                                  class="flex-fill d-inline-flex"
                                  onsubmit="return confirm('Bạn xác nhận DUYỆT yêu cầu trả hàng này và khởi tạo đơn hoàn GHN?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn fw-bold text-white w-100 py-2.5" style="background: #0b5c56; border-radius: 10px;">
                                    <i class="bx bx-check-shield me-1"></i>Duyệt &amp; Thu hồi GHN
                                </button>
                            </form>

                            <form method="post" action="@Url.Action("CompleteRefund", "ReturnRequests", new { area = "Admin", id = Model.Id })"
                                  class="flex-fill d-inline-flex"
                                  onsubmit="return confirm('Bạn xác nhận DUYỆT & HOÀN TIỀN NGAY @((Model.Order?.FinalAmount ?? 0m).ToString("N0"))₫ vào Ví Sellzy của khách hàng?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn fw-bold text-white w-100 py-2.5" style="background: #10b981; border-radius: 10px;">
                                    <i class="bx bx-wallet me-1"></i>Hoàn tiền ngay (@((Model.Order?.FinalAmount ?? 0m).ToString("N0"))₫)
                                </button>
                            </form>

                            <button type="button" class="btn btn-outline-danger fw-bold flex-fill py-2.5" style="border-radius: 10px;" onclick="openRejectModal()">
                                <i class="bx bx-x-circle me-1"></i>Từ chối
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Completed Info -->
            @if (isCompleted)
            {
                <div class="rrd-card" style="border-color: #a7f3d0;">
                    <div class="rrd-card-head" style="background: #ecfdf5; border-bottom-color: #a7f3d0;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rrd-card-icon" style="background: #059669; color: #fff;"><i class="bx bx-check-double"></i></span>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">Đã hoàn tất Hoàn tiền &amp; Nhập lại kho</h6>
                                <div class="text-muted small">Giao dịch hoàn tiền đã được ghi nhận vào Ví khách</div>
                            </div>
                        </div>
                        <span class="badge rounded-pill bg-success">Completed</span>
                    </div>
                    <div class="p-4">
                        <div class="p-3 rounded-3 bg-success-subtle border border-success-subtle text-success-emphasis fw-semibold small">
                            <i class="bx bx-check-circle me-1"></i>Đã hoàn trả <strong>@((Model.Order?.FinalAmount ?? 0m).ToString("N0"))₫</strong> trực tiếp vào Ví Sellzy của khách hàng và hoàn lại số lượng tồn kho cho các biến thể trong đơn.
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.55); backdrop-filter:blur(5px); z-index:9999; align-items:center; justify-content:center; padding:15px;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="width: 100%; max-width: 480px; animation: scaleUp 0.2s ease-out;">
        <div class="card-header bg-danger-subtle border-0 py-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bx bx-x-circle text-danger fs-4"></i>
                <h6 class="mb-0 text-danger fw-bold">Từ chối yêu cầu trả hàng</h6>
            </div>
            <button type="button" class="btn-close" onclick="closeRejectModal()"></button>
        </div>
        <div class="card-body p-4">
            <p class="text-muted small">Vui lòng cung cấp lý do chi tiết từ chối yêu cầu trả hàng để gửi tới khách hàng.</p>
            <form method="post" action="@Url.Action("Reject", "ReturnRequests", new { area = "Admin", id = Model.Id })" onsubmit="return validateRejectForm()">
                @Html.AntiForgeryToken()
                <textarea name="note" id="rejectNote" class="form-control rounded-3" rows="4"
                          placeholder="Ví dụ: Sản phẩm không có lỗi kỹ thuật hoặc khách hàng không cung cấp video mở hộp..."
                          maxlength="500"></textarea>

                <div class="d-flex gap-2 mt-4">
                    <button type="button" onclick="closeRejectModal()" class="btn btn-light border fw-semibold flex-fill" style="border-radius: 10px;">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="btn btn-danger fw-bold flex-fill" style="border-radius: 10px;">
                        Xác nhận từ chối
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Lightbox Modal -->
<div id="lightboxModal" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.9); backdrop-filter:blur(6px); z-index:99999; align-items:center; justify-content:center; padding:20px;" onclick="closeLightbox()">
    <button type="button" class="btn-close btn-close-white" style="position:absolute; top:20px; right:20px; font-size:24px;" onclick="closeLightbox()"></button>
    <div style="max-width:90%; max-height:90%; position:relative;" onclick="event.stopPropagation()">
        <img id="lightboxImage" src="" alt="Evidence Zoom" style="display:none; max-width:100%; max-height:85vh; border-radius:10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);" />
        <video id="lightboxVideo" src="" controls style="display:none; max-width:100%; max-height:85vh; border-radius:10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);"></video>
    </div>
</div>

<script>
function openRejectModal() {
    const m = document.getElementById('rejectModal');
    if (m) {
        m.style.display = 'flex';
        document.getElementById('rejectNote').focus();
    }
}
function closeRejectModal() {
    const m = document.getElementById('rejectModal');
    if (m) { m.style.display = 'none'; }
}
function validateRejectForm() {
    const note = document.getElementById('rejectNote').value.trim();
    if (!note) {
        alert('Vui lòng nhập lý do từ chối yêu cầu.');
        return false;
    }
    return true;
}
document.getElementById('rejectModal')?.addEventListener('click', function (e) {
    if (e.target === this) closeRejectModal();
});

function showLightbox(url, isVideo) {
    const modal = document.getElementById('lightboxModal');
    const img = document.getElementById('lightboxImage');
    const vid = document.getElementById('lightboxVideo');

    if (isVideo) {
        img.style.display = 'none';
        vid.src = url;
        vid.style.display = 'block';
        vid.play();
    } else {
        vid.style.display = 'none';
        vid.src = '';
        img.src = url;
        img.style.display = 'block';
    }
    modal.style.display = 'flex';
}
function closeLightbox() {
    const modal = document.getElementById('lightboxModal');
    const img = document.getElementById('lightboxImage');
    const vid = document.getElementById('lightboxVideo');

    vid.pause();
    vid.src = '';
    img.src = '';
    modal.style.display = 'none';
}
</script>
