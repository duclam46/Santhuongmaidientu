@model List<DOAN_BANHANG.Models.ReturnRequest>
@using System.Text.Json

@{
    ViewData["Title"] = "Quản lý Yêu cầu trả hàng";

    var totalCount = Model.Count;
    var pendingCount = Model.Count(r => r.Status == "Pending");
    var approvedCount = Model.Count(r => r.Status == "Approved");
    var completedCount = Model.Count(r => r.Status == "Completed");
    var rejectedCount = Model.Count(r => r.Status == "Rejected");
}

<style>
    :root {
        --rr-teal: #0b5c56;
        --rr-teal-dark: #063532;
        --rr-border: #e2e8f0;
    }

    .rr-hero {
        background: linear-gradient(135deg, #063532 0%, #0b5c56 58%, #0f766e 100%);
        border-radius: 18px;
        padding: 24px 28px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(6, 53, 50, 0.16);
        margin-bottom: 20px;
    }
    .rr-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -30px;
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.28) 0%, rgba(16, 185, 129, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .rr-hero-title { font-size: 1.45rem; font-weight: 800; color: #fff; margin-bottom: 4px; letter-spacing: -0.02em; }
    .rr-hero-sub { color: rgba(255,255,255,0.8); font-size: 0.88rem; }

    /* KPI Cards */
    .rr-kpi {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--rr-border);
        padding: 18px 20px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        height: 100%;
        transition: all 0.2s ease;
    }
    .rr-kpi:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06); }
    .rr-kpi-label { font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; margin-bottom: 4px; }
    .rr-kpi-val { font-size: 1.55rem; font-weight: 800; color: #0f172a; line-height: 1.15; }
    .rr-kpi-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.45rem; flex-shrink: 0; }

    /* Main Card */
    .rr-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--rr-border);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.035);
        overflow: hidden;
    }

    .rr-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 22px;
        border-bottom: 1px solid var(--rr-border);
        background: #fafcff;
    }

    .rr-filter-pill {
        cursor: pointer;
        padding: 7px 14px;
        border-radius: 10px;
        font-size: 0.83rem;
        font-weight: 600;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.18s;
    }
    .rr-filter-pill:hover { border-color: var(--rr-teal); color: var(--rr-teal); }
    .rr-filter-pill.active {
        background: var(--rr-teal);
        border-color: var(--rr-teal);
        color: #fff;
        box-shadow: 0 4px 10px rgba(11, 92, 86, 0.22);
    }

    .rr-search { position: relative; max-width: 300px; width: 100%; }
    .rr-search i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 1.05rem; }
    .rr-search input {
        padding-left: 38px;
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        height: 39px;
        font-size: 0.86rem;
    }
    .rr-search input:focus { border-color: var(--rr-teal); box-shadow: 0 0 0 3px rgba(11,92,86,0.12); }

    /* Table */
    .rr-table { width: 100%; margin: 0; }
    .rr-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 13px 16px;
        border-bottom: 1.5px solid var(--rr-border);
        white-space: nowrap;
    }
    .rr-table tbody td {
        padding: 14px 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }
    .rr-table tbody tr:hover td { background: #f8fafc; }

    .rr-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 800;
        font-size: 0.8rem;
        flex-shrink: 0;
    }

    .rr-reason {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 7px 11px;
        font-size: 0.8rem;
        color: #334155;
        line-height: 1.45;
        max-width: 280px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .rr-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .rr-pill-pending { background: #fffbeb; color: #b45309; }
    .rr-pill-approved { background: #eff6ff; color: #1d4ed8; }
    .rr-pill-completed { background: #ecfdf5; color: #047857; }
    .rr-pill-rejected { background: #fef2f2; color: #dc2626; }

    .rr-btn-detail {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 13px;
        border-radius: 9px;
        font-size: 0.82rem;
        font-weight: 600;
        background: rgba(11, 92, 86, 0.08);
        color: var(--rr-teal);
        border: 1px solid rgba(11, 92, 86, 0.18);
        text-decoration: none;
        transition: all 0.18s;
        white-space: nowrap;
    }
    .rr-btn-detail:hover { background: var(--rr-teal); color: #fff; }
</style>

<!-- 1. HERO HEADER -->
<div class="rr-hero d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div style="position: relative; z-index: 2;">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge rounded-pill" style="background: rgba(255,255,255,0.16); color: #a7f3d0; font-weight: 700; font-size: 0.72rem;">
                <i class="bx bx-shield-quarter me-1"></i>HẬU MÃI &amp; HOÀN TIỀN
            </span>
            @if (pendingCount > 0)
            {
                <span class="badge rounded-pill" style="background: rgba(245,158,11,0.26); color: #fde68a; font-weight: 700; font-size: 0.72rem;">
                    @pendingCount yêu cầu cần xét duyệt
                </span>
            }
        </div>
        <h3 class="rr-hero-title">
            <i class="bx bx-subdirectory-left me-2" style="color: #6ee7b7;"></i>Yêu cầu Trả hàng &amp; Hoàn tiền
        </h3>
        <div class="rr-hero-sub">Xét duyệt khiếu nại, tạo vận đơn thu hồi GHN tự động và hoàn tiền trực tiếp vào Ví Sellzy của khách.</div>
    </div>
</div>

@if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
{
    var alertClass = toast.Contains("thất bại") || toast.Contains("Lỗi") ? "alert-danger" : "alert-success";
    var alertIcon = toast.Contains("thất bại") || toast.Contains("Lỗi") ? "bx bx-error-circle" : "bx bx-check-circle";
    <div class="alert @alertClass d-flex align-items-start gap-2 rounded-3 shadow-sm mb-4" role="alert">
        <i class="@alertIcon fs-5 mt-0.5"></i>
        <div class="fw-semibold">@toast</div>
    </div>
}

<!-- 2. KPI CARDS -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="rr-kpi">
            <div>
                <div class="rr-kpi-label">Tổng yêu cầu</div>
                <div class="rr-kpi-val">@totalCount</div>
            </div>
            <div class="rr-kpi-icon" style="background: rgba(11,92,86,0.1); color: #0b5c56;">
                <i class="bx bx-list-ul"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="rr-kpi">
            <div>
                <div class="rr-kpi-label">Đang chờ duyệt</div>
                <div class="rr-kpi-val text-warning">@pendingCount</div>
            </div>
            <div class="rr-kpi-icon" style="background: #fffbeb; color: #d97706;">
                <i class="bx bx-time-five"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="rr-kpi">
            <div>
                <div class="rr-kpi-label">Đã duyệt / Hoàn tiền</div>
                <div class="rr-kpi-val text-success">@(approvedCount + completedCount)</div>
            </div>
            <div class="rr-kpi-icon" style="background: #ecfdf5; color: #059669;">
                <i class="bx bx-check-double"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="rr-kpi">
            <div>
                <div class="rr-kpi-label">Từ chối</div>
                <div class="rr-kpi-val text-danger">@rejectedCount</div>
            </div>
            <div class="rr-kpi-icon" style="background: #fef2f2; color: #dc2626;">
                <i class="bx bx-x-circle"></i>
            </div>
        </div>
    </div>
</div>

<!-- 3. MAIN TABLE CARD -->
<div class="rr-card">
    @if (totalCount == 0)
    {
        <div class="text-center py-5 px-3">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 68px; height: 68px; border-radius: 18px; background: #f1f5f9; color: #94a3b8; font-size: 2rem;">
                <i class="bx bx-package"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">Chưa có yêu cầu trả hàng nào</h5>
            <p class="text-muted small mb-0">Khi khách hàng gửi khiếu nại trả hàng / hoàn tiền, yêu cầu sẽ hiển thị tại đây.</p>
        </div>
    }
    else
    {
        <!-- Toolbar -->
        <div class="rr-toolbar">
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="status-filter rr-filter-pill active" data-status="all">
                    <i class="bx bx-grid-alt"></i> Tất cả (@totalCount)
                </button>
                <button type="button" class="status-filter rr-filter-pill" data-status="Pending">
                    <i class="bx bx-time-five text-warning"></i> Chờ duyệt (@pendingCount)
                </button>
                <button type="button" class="status-filter rr-filter-pill" data-status="Approved">
                    <i class="bx bx-car text-primary"></i> Thu hồi GHN (@approvedCount)
                </button>
                <button type="button" class="status-filter rr-filter-pill" data-status="Completed">
                    <i class="bx bx-check-double text-success"></i> Đã hoàn tiền (@completedCount)
                </button>
                <button type="button" class="status-filter rr-filter-pill" data-status="Rejected">
                    <i class="bx bx-x-circle text-danger"></i> Từ chối (@rejectedCount)
                </button>
            </div>

            <div class="rr-search">
                <i class="bx bx-search"></i>
                <input type="text" id="searchQuery" class="form-control" placeholder="Tìm mã đơn, tên khách, lý do..." />
            </div>
        </div>

        <div class="table-responsive">
            <table class="table rr-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 75px;">Mã YC</th>
                        <th>Đơn hàng gốc</th>
                        <th>Khách hàng</th>
                        <th>Lý do trả hàng</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Ngày gửi</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var custName = r.Customer?.Profile?.FullName ?? r.Customer?.Email ?? "Khách hàng";
                        var firstChar = string.IsNullOrEmpty(custName) ? 'K' : char.ToUpperInvariant(custName[0]);
                        var avatarBg = ((int)firstChar % 4) switch
                        {
                            0 => "#0b5c56",
                            1 => "#2563eb",
                            2 => "#059669",
                            _ => "#d97706"
                        };
                        var accentColor = r.Status switch
                        {
                            "Pending" => "#f59e0b",
                            "Approved" => "#2563eb",
                            "Completed" => "#10b981",
                            "Rejected" => "#ef4444",
                            _ => "#94a3b8"
                        };

                        <tr class="custom-row"
                            data-status="@r.Status"
                            data-order="@(r.Order?.OrderCode ?? "")"
                            data-customer="@(r.Customer?.Profile?.FullName ?? r.Customer?.Email ?? "")"
                            data-reason="@r.Reason">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-pill flex-shrink-0" style="width: 4px; height: 34px; background: @accentColor;"></span>
                                    <span class="fw-bold text-muted" style="font-family: monospace;">#@r.Id</span>
                                </div>
                            </td>
                            <td>
                                @if (r.Order is not null)
                                {
                                    <a href="@Url.Action("Details", "Orders", new { area = "Admin", id = r.Order.Id })" class="fw-bold text-dark text-decoration-none d-block">
                                        @r.Order.OrderCode
                                    </a>
                                    <div class="text-muted small">@r.Order.FinalAmount.ToString("N0")₫</div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rr-avatar" style="background: @avatarBg;">@firstChar</div>
                                    <div style="min-width: 0;">
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 170px;">@(r.Customer?.Profile?.FullName ?? "—")</div>
                                        <div class="text-muted small text-truncate" style="max-width: 170px;">@(r.Customer?.Email ?? "—")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="rr-reason" title="@r.Reason">@r.Reason</div>
                            </td>
                            <td class="text-center">
                                @if (r.Status == "Completed")
                                {
                                    <span class="rr-pill rr-pill-completed"><i class="bx bx-check-double"></i>Đã hoàn tiền</span>
                                }
                                else if (r.Status == "Approved")
                                {
                                    <span class="rr-pill rr-pill-approved"><i class="bx bx-car"></i>Đang thu hồi GHN</span>
                                }
                                else if (r.Status == "Rejected")
                                {
                                    <span class="rr-pill rr-pill-rejected"><i class="bx bx-x-circle"></i>Từ chối</span>
                                }
                                else
                                {
                                    <span class="rr-pill rr-pill-pending"><i class="bx bx-time-five"></i>Chờ duyệt</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                <div class="text-muted small">@r.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Details", "ReturnRequests", new { area = "Admin", id = r.Id })" class="rr-btn-detail">
                                    Xem chi tiết <i class="bx bx-right-arrow-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }

                    <tr id="noResultsRow" style="display: none;">
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="fw-bold text-dark mb-1">Không tìm thấy kết quả phù hợp</div>
                            <div class="small">Thử đổi từ khóa tìm kiếm hoặc bộ lọc trạng thái.</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchQuery');
    const statusFilters = document.querySelectorAll('.status-filter');
    const rows = document.querySelectorAll('.custom-row');

    let currentStatus = 'all';
    let searchQuery = '';

    function filterTable() {
        let visibleCount = 0;
        rows.forEach(row => {
            const status = (row.getAttribute('data-status') || '').toLowerCase();
            const orderCode = (row.getAttribute('data-order') || '').toLowerCase();
            const customer = (row.getAttribute('data-customer') || '').toLowerCase();
            const reason = (row.getAttribute('data-reason') || '').toLowerCase();

            const matchStatus = (currentStatus === 'all' || status === currentStatus);
            const matchSearch = (!searchQuery ||
                orderCode.includes(searchQuery) ||
                customer.includes(searchQuery) ||
                reason.includes(searchQuery)
            );

            if (matchStatus && matchSearch) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const noResults = document.getElementById('noResultsRow');
        if (noResults) {
            noResults.style.display = (visibleCount === 0) ? '' : 'none';
        }
    }

    if (searchInput) {
        searchInput.addEventListener('input', function () {
            searchQuery = this.value.trim().toLowerCase();
            filterTable();
        });
    }

    statusFilters.forEach(filter => {
        filter.addEventListener('click', function () {
            statusFilters.forEach(f => f.classList.remove('active'));
            this.classList.add('active');
            currentStatus = (this.getAttribute('data-status') || 'all').toLowerCase();
            filterTable();
        });
    });
});
</script>
