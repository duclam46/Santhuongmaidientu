@model DOAN_BANHANG.Models.Category
@using DOAN_BANHANG.Helpers

@{
    ViewData["Title"] = "Chỉnh sửa danh mục: " + Model.Name;
    var allCats = ViewBag.AllCategories as List<DOAN_BANHANG.Models.Category> ?? new List<DOAN_BANHANG.Models.Category>();
    var catMap = allCats.ToDictionary(c => c.Id, c => c);
    var resolvedPolicy = CommissionHelper.ResolveCategoryPolicy(Model.Id, catMap, 10m);
    var parentAttributes = ViewBag.ParentAttributes as List<DOAN_BANHANG.Models.CategoryAttribute> ?? new List<DOAN_BANHANG.Models.CategoryAttribute>();
}

@section Styles {
    <style>
        .cat-form-hero {
            background: radial-gradient(circle at 88% 18%, rgba(255, 235, 105, 0.16) 0%, transparent 46%),
                        linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
            border-radius: 22px;
            padding: 22px 28px;
            color: #ffffff;
            margin-bottom: 24px;
            box-shadow: 0 18px 38px -16px rgba(0, 38, 42, 0.34);
        }
        .cat-toggle-box {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-left: 4px solid #088178;
            border-radius: 14px;
            padding: 12px 14px;
        }
        .category-tree-selector {
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            background: #F8FAFC;
            padding: 14px 16px;
        }
        .tree-node .form-check-input:checked + .form-check-label {
            color: #088178;
            font-weight: 700;
        }
        .cursor-pointer { cursor: pointer; }
    </style>
}

<!-- HERO HEADER -->
<div class="cat-form-hero">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
        <div>
            <a asp-action="Index" class="btn btn-sm rounded-pill px-3 mb-2" style="background: rgba(255,255,255,0.14); color: #ffffff; border: 1px solid rgba(255,255,255,0.22);">
                <i class="bx bx-left-arrow-alt me-1"></i>Danh sách ngành hàng
            </a>
            <h4 class="text-white fw-bold mb-1">
                <i class="bx bx-edit text-warning me-1"></i>Cấu hình Ngành hàng: @Model.Name
            </h4>
            <p class="mb-0 small" style="color: rgba(255,255,255,0.82);">
                Đường dẫn: <span class="font-monospace" style="color: #FFEB69;">/@Model.Slug</span> • Điều chỉnh chiết khấu, cờ cấu hình và bộ thông số kỹ thuật sản phẩm.
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge rounded-pill px-3 py-2 fw-bold" style="background: #FFEB69; color: #00262A;">
                <i class="bx bx-calculator me-1"></i>Chiết khấu hiệu lực: @resolvedPolicy.CommissionRatePercent.ToString("0.##")%
                @(resolvedPolicy.InheritedFromCategoryName != null ? $" (Kế thừa từ {resolvedPolicy.InheritedFromCategoryName})" : "")
            </span>
        </div>
    </div>
</div>

@if (TempData["AdminToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm" role="alert">
        <i class="bx bx-check-circle fs-5"></i>
        <div>@toast</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["AdminError"] is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm" role="alert">
        <i class="bx bx-error-circle fs-5"></i>
        <div>@err</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- CỘT TRÁI: THÔNG TIN DANH MỤC & CHÍNH SÁCH -->
    <div class="col-lg-7">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SortOrder" />

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bx bx-info-circle text-primary me-2"></i>1. Thông tin &amp; Chính sách Chiết khấu
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Tên ngành hàng / danh mục <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger mt-1 small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CommissionRate" class="form-label fw-semibold">Tỷ lệ chiết khấu riêng (%)</label>
                            <div class="input-group">
                                <input asp-for="CommissionRate" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="Để trống = Kế thừa cấp cha" />
                                <span class="input-group-text fw-bold">%</span>
                            </div>
                            <div class="form-text">Để trống nếu muốn tự động lấy mức chiết khấu của danh mục cha gần nhất.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaxCommissionAmount" class="form-label fw-semibold">Trần phí tối đa / sản phẩm (₫)</label>
                            <div class="input-group">
                                <input asp-for="MaxCommissionAmount" type="number" step="1000" min="0" class="form-control" placeholder="Để trống nếu không giới hạn" />
                                <span class="input-group-text fw-bold">₫</span>
                            </div>
                            <div class="form-text">Ví dụ: 500.000₫ cho ngành Điện thoại / Máy tính.</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tải ảnh biểu tượng mới</label>
                            <input type="file" name="iconFile" class="form-control" accept="image/*" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IconUrl" class="form-label fw-semibold">Mã biểu tượng / Đường dẫn hiện tại</label>
                            <input asp-for="IconUrl" class="form-control" placeholder="Ví dụ: bx-mobile-alt hoặc /uploads/..." />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="cat-toggle-box h-100">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="HasSizeGuide">
                                    <label class="form-check-label fw-bold small" asp-for="HasSizeGuide">Bảng kích cỡ</label>
                                </div>
                                <div class="text-muted small mt-1">Hiện bảng quy đổi kích cỡ (Quần áo/Giày).</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="cat-toggle-box h-100">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsReturnableDefault">
                                    <label class="form-check-label fw-bold small" asp-for="IsReturnableDefault">Cho phép đổi trả</label>
                                </div>
                                <div class="text-muted small mt-1">Mặc định bật trả hàng cho sản phẩm thuộc ngành.</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="cat-toggle-box h-100">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                    <label class="form-check-label fw-bold small" asp-for="IsActive">Đang hiển thị</label>
                                </div>
                                <div class="text-muted small mt-1">Hiển thị danh mục này trên toàn sàn.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Vị trí danh mục cha</label>
                        <div class="category-tree-selector" style="max-height: 240px; overflow-y: auto;">
                            <div class="tree-node root-selection mb-2 pb-2 border-bottom">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ParentId" value="" id="parent_root" @(Model.ParentId == null ? "checked" : "")>
                                    <label class="form-check-label fw-bold text-primary" for="parent_root">
                                        <i class="bx bx-folder-open me-1"></i>Cấp cao nhất (Ngành hàng gốc)
                                    </label>
                                </div>
                            </div>
                            @{
                                var rootCats = allCats.Where(c => c.ParentId == null).ToList();
                                foreach (var cat in rootCats)
                                {
                                    await RenderCategoryRadioRecursive(cat, 0, allCats, Model.Id);
                                }
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">Quay lại</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold shadow-sm">
                            <i class="bx bx-save me-1"></i>Lưu thông tin danh mục
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- CỘT PHẢI: THUỘC TÍNH KỸ THUẬT CỦA NGÀNH -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="mb-0 fw-bold text-dark">
                    <i class="bx bx-slider-alt text-primary me-2"></i>2. Thông số kỹ thuật của ngành
                </h5>
                <p class="text-muted small mb-0 mt-1">Nhà bán hàng sẽ điền các thông số này khi đăng sản phẩm và khách hàng dùng để lọc sản phẩm.</p>
            </div>

            <div class="card-body p-4">
                <!-- Form thêm thuộc tính mới -->
                <form asp-action="AddAttribute" method="post" class="bg-light p-3 rounded-3 border mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="categoryId" value="@Model.Id" />
                    <div class="fw-bold small text-primary mb-2.5"><i class="bx bx-plus-circle me-1"></i>Thêm thông số kỹ thuật mới</div>

                    <div class="row g-2">
                        <div class="col-7">
                            <label class="form-label small fw-semibold mb-1">Tên thông số <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control form-control-sm" placeholder="VD: RAM, CPU, Xuất xứ, Hạn sử dụng..." required />
                        </div>
                        <div class="col-5">
                            <label class="form-label small fw-semibold mb-1">Đơn vị (nếu có)</label>
                            <input type="text" name="unit" class="form-control form-control-sm" placeholder="VD: GB, tháng, W..." />
                        </div>
                        <div class="col-7 d-flex align-items-center mt-2">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" name="isFilterable" value="true" id="newAttrFilterable" checked />
                                <label class="form-check-label small fw-semibold" for="newAttrFilterable">Cho phép lọc sản phẩm</label>
                            </div>
                        </div>
                        <div class="col-5 mt-2 text-end">
                            <button type="submit" class="btn btn-sm btn-primary w-100 fw-semibold rounded-3">
                                <i class="bx bx-plus me-1"></i>Thêm thông số
                            </button>
                        </div>
                    </div>
                </form>

                @if (parentAttributes.Count > 0)
                {
                    <div class="mb-4 p-3 rounded-3 bg-light border">
                        <div class="small fw-bold text-secondary mb-2">
                            <i class="bx bx-git-branch me-1"></i>Thông số kế thừa từ danh mục cha (@Model.Parent?.Name):
                        </div>
                        <div class="d-flex flex-wrap gap-1.5">
                            @foreach (var pa in parentAttributes)
                            {
                                <span class="badge bg-white text-dark border rounded-pill px-2.5 py-1">
                                    @pa.Name@(string.IsNullOrWhiteSpace(pa.Unit) ? "" : $" ({pa.Unit})")
                                    @if (pa.IsFilterable)
                                    {
                                        <i class="bx bx-filter-alt text-primary ms-1" title="Hiển thị trên bộ lọc khách hàng"></i>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                }

                <!-- Danh sách thuộc tính hiện tại -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h6 class="fw-bold mb-0 text-dark">Thông số riêng của danh mục này</h6>
                    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">@(Model.Attributes?.Count ?? 0) thông số</span>
                </div>

                @if (Model.Attributes == null || Model.Attributes.Count == 0)
                {
                    <div class="text-center py-4 text-muted border rounded-3 bg-light" style="border-style: dashed !important;">
                        <i class="bx bx-list-plus fs-2 mb-1 d-block"></i>
                        <div class="small">Chưa có thông số riêng nào cho danh mục này.</div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var attr in Model.Attributes.OrderBy(a => a.SortOrder).ThenBy(a => a.Id))
                        {
                            <div class="border rounded-3 p-2.5 bg-white">
                                <form asp-action="UpdateAttribute" method="post" class="row g-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@attr.Id" />
                                    <input type="hidden" name="categoryId" value="@Model.Id" />
                                    <input type="hidden" name="sortOrder" value="@attr.SortOrder" />

                                    <div class="col-5">
                                        <input type="text" name="name" value="@attr.Name" class="form-control form-control-sm fw-semibold" required />
                                    </div>
                                    <div class="col-3">
                                        <input type="text" name="unit" value="@attr.Unit" class="form-control form-control-sm" placeholder="Đơn vị" />
                                    </div>
                                    <div class="col-2 text-center" title="Hiển thị trên thanh lọc tìm kiếm">
                                        <div class="form-check form-switch d-inline-block mb-0">
                                            <input class="form-check-input" type="checkbox" name="isFilterable" value="true" @(attr.IsFilterable ? "checked" : "") />
                                        </div>
                                    </div>
                                    <div class="col-2 d-flex justify-content-end gap-1">
                                        <button type="submit" class="btn btn-sm btn-outline-success px-2" title="Lưu thay đổi">
                                            <i class="bx bx-check"></i>
                                        </button>
                                        <button type="submit" formaction="@Url.Action("DeleteAttribute", "Categories", new { area = "Admin", id = attr.Id, categoryId = Model.Id })"
                                                class="btn btn-sm btn-outline-danger px-2" title="Xóa thông số"
                                                onclick="return confirm('Xác nhận xóa thông số kỹ thuật @attr.Name?');">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    async Task RenderCategoryRadioRecursive(DOAN_BANHANG.Models.Category category, int level, List<DOAN_BANHANG.Models.Category> allCats, int excludeId)
    {
        if (category.Id == excludeId) return;

        var children = allCats.Where(c => c.ParentId == category.Id).ToList();
        var paddingLeft = level * 22;

        <div class="tree-node" style="padding-left: @(paddingLeft)px; margin-bottom: 0.45rem;">
            <div class="d-flex align-items-center">
                @if (children.Any())
                {
                    <i class="bx bx-chevron-right text-muted me-2 cursor-pointer fs-5" onclick="$(this).parent().next('.child-nodes').slideToggle(); $(this).toggleClass('bx-chevron-right bx-chevron-down');"></i>
                }
                else
                {
                    <i class="bx bx-minus text-muted me-2 fs-5" style="opacity: 0.3;"></i>
                }

                <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" name="ParentId" value="@category.Id" id="parent_@category.Id" @(Model.ParentId == category.Id ? "checked" : "")>
                    <label class="form-check-label" for="parent_@category.Id">
                        <i class="bx @(children.Any() ? "bx-folder text-warning" : "bx-file text-info") me-1"></i>
                        @category.Name
                        @if (category.CommissionRate.HasValue)
                        {
                            <span class="text-muted small ms-1">(@category.CommissionRate.Value.ToString("0.##")%)</span>
                        }
                    </label>
                </div>
            </div>

            @if (children.Any())
            {
                <div class="child-nodes mt-2" style="display: none;">
                    @{
                        foreach (var child in children)
                        {
                            await RenderCategoryRadioRecursive(child, level + 1, allCats, excludeId);
                        }
                    }
                </div>
            }
        </div>
    }
}
