@model DOAN_BANHANG.Models.Category

@{
    ViewData["Title"] = "Thêm danh mục";
}

<style>
    .card-premium {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .form-label {
        font-weight: 700;
        color: #4a5568;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border-radius: 10px;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
        transition: all 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #556ee6;
        box-shadow: 0 0 0 3px rgba(85, 110, 230, 0.1);
    }

    .btn-premium {
        padding: 0.75rem 2rem;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s;
    }

    .btn-primary-premium {
        background: linear-gradient(135deg, #556ee6 0%, #3b4cb8 100%);
        border: none;
        color: #fff;
    }

    .btn-primary-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(85, 110, 230, 0.3);
        color: #fff;
    }

    .info-box {
        background: #f8faff;
        border-radius: 15px;
        padding: 1.5rem;
        border-left: 4px solid #556ee6;
    }

    /* Custom Tree Selector */
    .category-tree-selector {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #fff;
        padding: 1rem;
        box-shadow: inset 0 2px 5px rgba(0,0,0,0.02);
    }
    
    .category-tree-selector::-webkit-scrollbar {
        width: 6px;
    }
    .category-tree-selector::-webkit-scrollbar-thumb {
        background: #cbd5e0;
        border-radius: 4px;
    }

    .tree-node .form-check-input:checked + .form-check-label {
        color: #556ee6;
        font-weight: 700;
    }

    .tree-node .form-check-label {
        cursor: pointer;
        user-select: none;
        transition: color 0.2s;
    }

    .tree-node .form-check-label:hover {
        color: #556ee6;
    }
    
    .cursor-pointer {
        cursor: pointer;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18 fw-bold">Thiết lập Danh mục Mới</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index">Danh mục</a></li>
                    <li class="breadcrumb-item active">Thêm mới</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-premium">
            <div class="card-header bg-white border-bottom p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-sm">
                        <span class="avatar-title rounded-circle bg-soft-primary text-primary fs-3">
                            <i class="bx bx-plus-circle"></i>
                        </span>
                    </div>
                    <div>
                        <h5 class="mb-1 fw-bold">Thông tin Danh mục</h5>
                        <p class="text-muted mb-0">Vui lòng điền đầy đủ các thông tin bên dưới</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">Tên danh mục <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bx bx-tag-alt"></i></span>
                            <input asp-for="Name" class="form-control border-start-0" placeholder="Ví dụ: Đồ dùng gia đình, Thời trang nam..." />
                        </div>
                        <span asp-validation-for="Name" class="text-danger mt-1 small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Danh mục cha</label>
                        <div class="category-tree-selector" style="max-height: 350px; overflow-y: auto;">
                            <!-- Option for Root -->
                            <div class="tree-node root-selection mb-3 pb-2 border-bottom">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ParentId" value="" id="parent_root" @(Model.ParentId == null ? "checked" : "")>
                                    <label class="form-check-label fw-bold text-primary" for="parent_root">
                                        <i class="bx bx-folder-open me-1"></i> — Cấp cao nhất (Root) —
                                    </label>
                                </div>
                            </div>
                            
                            <!-- Dynamic Tree -->
                            @{
                                var allCats = ViewBag.AllCategories as List<DOAN_BANHANG.Models.Category>;
                                if (allCats != null)
                                {
                                    var rootCats = allCats.Where(c => c.ParentId == null).ToList();
                                    foreach(var cat in rootCats)
                                    {
                                        await RenderCategoryRadioRecursive(cat, 0, allCats, Model.Id);
                                    }
                                }
                            }
                        </div>
                        <div class="form-text small mt-2"><i class="bx bx-info-circle me-1"></i> Chọn danh mục cha để tạo cấu trúc đa tầng. Có thể cuộn xuống để xem thêm.</div>
                    </div>

                    <div class="mb-4">
                        <div class="info-box">
                            <div class="form-check form-switch form-switch-lg">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                                <label class="form-check-label fw-bold" asp-for="IsActive">Kích hoạt danh mục này ngay lập tức</label>
                            </div>
                            <p class="text-muted mb-0 mt-2 small">Khi bị tắt, danh mục và các sản phẩm bên trong sẽ không hiển thị trên website.</p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-3">
                        <a asp-action="Index" class="btn btn-light btn-premium">Quay lại</a>
                        <button type="submit" class="btn btn-primary-premium btn-premium">
                            <i class="bx bx-save me-1"></i> Lưu danh mục
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="card card-premium bg-light border-0 shadow-none">
            <div class="card-body p-4">
                <h6 class="fw-bold text-primary mb-3"><i class="bx bx-info-circle me-1"></i> Mẹo nhỏ cho bạn</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-3 d-flex gap-2">
                        <i class="bx bx-check-circle text-success mt-1"></i>
                        <span><strong>SEO:</strong> Slug sẽ được tự động tạo thân thiện với công cụ tìm kiếm.</span>
                    </li>
                    <li class="mb-3 d-flex gap-2">
                        <i class="bx bx-check-circle text-success mt-1"></i>
                        <span><strong>Cấu trúc:</strong> Bạn có thể tạo vô số cấp độ danh mục con để phân loại sản phẩm tốt hơn.</span>
                    </li>
                    <li class="d-flex gap-2">
                        <i class="bx bx-check-circle text-success mt-1"></i>
                        <span><strong>Sắp xếp:</strong> Sau khi tạo, bạn có thể kéo thả để thay đổi vị trí tại trang danh sách.</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@functions {
    async Task RenderCategoryRadioRecursive(DOAN_BANHANG.Models.Category category, int level, List<DOAN_BANHANG.Models.Category> allCats, int excludeId)
    {
        if (category.Id == excludeId) return;

        var children = allCats.Where(c => c.ParentId == category.Id).ToList();
        var paddingLeft = level * 24;
        
        <div class="tree-node" style="padding-left: @(paddingLeft)px; margin-bottom: 0.5rem;">
            <div class="d-flex align-items-center">
                @if(children.Any()) {
                    <i class="bx bx-chevron-right text-muted me-2 cursor-pointer fs-5" onclick="$(this).parent().next('.child-nodes').slideToggle(); $(this).toggleClass('bx-chevron-right bx-chevron-down');"></i>
                } else {
                    <i class="bx bx-minus text-muted me-2 fs-5" style="opacity: 0.3;"></i>
                }
                
                <div class="form-check mb-0">
                    <input class="form-check-input" type="radio" name="ParentId" value="@category.Id" id="parent_@category.Id" @(Model.ParentId == category.Id ? "checked" : "")>
                    <label class="form-check-label" for="parent_@category.Id">
                        <i class="bx @(children.Any() ? "bx-folder text-warning" : "bx-file text-info") me-1"></i>
                        @category.Name
                    </label>
                </div>
            </div>
            
            @if(children.Any()) {
                <div class="child-nodes mt-2" style="display: none;">
                    @{
                        foreach(var child in children)
                        {
                            await RenderCategoryRadioRecursive(child, level + 1, allCats, excludeId);
                        }
                    }
                </div>
            }
        </div>
    }
}
