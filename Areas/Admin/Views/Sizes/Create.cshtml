@model DOAN_BANHANG.Models.Size

@{
    ViewData["Title"] = "Thêm kích thước";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Thêm kích thước mới</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index">Kích thước</a></li>
                    <li class="breadcrumb-item active">Thêm mới</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card" style="border-radius: 16px;">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Tên kích thước</label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: S, M, L, XL, 39, 40..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SortOrder" class="form-label">Thứ tự hiển thị</label>
                        <input asp-for="SortOrder" class="form-control" type="number" placeholder="0" />
                        <span asp-validation-for="SortOrder" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light btn-rounded">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-rounded px-4">Lưu kích thước</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
