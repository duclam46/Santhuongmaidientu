@model IEnumerable<DOAN_BANHANG.Models.Size>

@{
    ViewData["Title"] = "Quản lý Kích thước";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Quản lý Kích thước</h4>

            <div class="page-title-right">
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bx bx-plus-circle me-1"></i>Thêm mới
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <div class="text-muted mb-2">
                            <i class="bx bx-ruler" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="text-muted mb-0">Chưa có dữ liệu kích thước</h5>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 90px;" class="text-center">ID</th>
                                    <th>Tên size</th>
                                    <th style="width: 150px;" class="text-center">Thứ tự</th>
                                    <th style="width: 170px;" class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderBy(s => s.SortOrder).ThenBy(s => s.Name))
                                {
                                    <tr>
                                        <td class="text-center text-muted">#@item.Id</td>
                                        <td class="fw-semibold">@item.Name</td>
                                        <td class="text-center">@item.SortOrder</td>
                                        <td class="text-center">
                                            <div class="d-inline-flex gap-2">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm" title="Sửa">
                                                    <i class="bx bx-edit-alt"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xác nhận xóa kích thước này?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa">
                                                        <i class="bx bx-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
