@using DOAN_BANHANG.ViewModels
@model VoucherAdminUpsertVm
@{
    bool isEdit = Model.Id > 0;
    string actionName = isEdit ? "Edit" : "Create";
}

<form asp-action="@actionName" method="post" id="voucherForm">
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

    <!-- HỘP CƠ CHẾ HẠCH TOÁN TÀI CHÍNH CHUẨN SHOPEE -->
    <div class="alert border-0 rounded-4 p-3.5 mb-4 d-flex align-items-start gap-3 shadow-sm" style="background: @(Model.IsAdmin ? "#EFF6FF" : "#F0FDF4"); border-left: 5px solid @(Model.IsAdmin ? "#2563EB" : "#088178") !important;">
        <div class="p-2 rounded-3 text-white d-inline-flex mt-0.5" style="background: @(Model.IsAdmin ? "#2563EB" : "#088178");">
            <i class="bx @(Model.IsAdmin ? "bx-building-house" : "bx-wallet") fs-4"></i>
        </div>
        <div class="small">
            @if (Model.IsAdmin)
            {
                <div class="fw-bold text-dark fs-6 mb-0.5">Cơ chế Hạch toán Voucher Hệ thống (Admin Phát hành)</div>
                <div class="text-secondary">
                    Khoản giảm giá của mã này được <strong>trích 100% từ Quỹ Phí chiết khấu sàn thu của các Gian hàng</strong>. Khi khách hàng áp mã Hệ thống, <strong>Gian hàng vẫn nhận đủ doanh thu gốc</strong> (không bị trừ tiền Voucher của Sàn), và khoản trợ giá sẽ được khấu trừ vào Doanh thu Phí sàn Ròng trong Báo cáo Tài chính Admin.
                </div>
            }
            else
            {
                <div class="fw-bold text-dark fs-6 mb-0.5">Cơ chế Hạch toán Voucher Gian hàng (@Model.ShopName Tự Phát hành)</div>
                <div class="text-secondary">
                    Khoản giảm giá của mã này chỉ bị trừ khi <strong>khách hàng thực sự áp mã và đơn hàng hoàn tất</strong>, khấu trừ trực tiếp vào <strong>Tiền hàng Quyết toán về Ví Doanh thu của Shop</strong>. Đặc quyền kế toán chuẩn Shopee: <strong>Phí chiết khấu sàn (~@Model.ShopAvgCommissionPercent%) và Thuế Hộ KD được tính trên giá sau khi đã trừ Voucher của Shop</strong> (giúp Shop tiết kiệm phí sàn &amp; thuế).
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI -->
        <div class="col-lg-8">
            <!-- 1. THÔNG TIN CHUNG & MỨC ƯU ĐÃI -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bx bx-info-circle text-primary me-2"></i>1. Thiết lập Mã &amp; Mức Ưu đãi</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="DiscountType" class="form-label fw-semibold">Loại ưu đãi <span class="text-danger">*</span></label>
                            <select asp-for="DiscountType" class="form-select" id="discountTypeSelect">
                                <option value="Percent">Giảm theo phần trăm (%)</option>
                                <option value="FixedAmount">Giảm số tiền cố định (VNĐ)</option>
                                @if (Model.IsAdmin)
                                {
                                    <option value="FreeShipping">Miễn phí vận chuyển (Freeship Sàn)</option>
                                }
                                else
                                {
                                    <option value="FreeShipping">Trợ giá phí vận chuyển của Shop (Freeship Xtra)</option>
                                }
                            </select>
                            <span asp-validation-for="DiscountType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Code" class="form-label fw-semibold">Mã giảm giá (Code) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Code" id="voucherCodeInput" class="form-control font-monospace fw-bold" placeholder="VD: SELLZY50K, SHOPVIP..." style="text-transform: uppercase;" />
                                <button class="btn btn-outline-primary" type="button" onclick="generateCode()">
                                    <i class="bx bx-shuffle me-1"></i>Ngẫu nhiên
                                </button>
                            </div>
                            <span asp-validation-for="Code" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DiscountValue" class="form-label fw-semibold" id="lblDiscountValue">Mức giảm <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="DiscountValue" id="discountValueInput" type="number" step="any" class="form-control fw-bold" value="@Model.DiscountValue.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                                <span class="input-group-text fw-bold" id="discountUnit">%</span>
                            </div>
                            <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6" id="rowMaxDiscount">
                            <label asp-for="MaxDiscountValue" class="form-label fw-semibold">Mức giảm tối đa (Trần VNĐ)</label>
                            <div class="input-group">
                                <input asp-for="MaxDiscountValue" id="maxDiscountInput" type="number" step="1000" class="form-control" placeholder="Để trống nếu không giới hạn..." value="@(Model.MaxDiscountValue?.ToString("0", System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="MaxDiscountValue" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MinOrderValue" class="form-label fw-semibold">Giá trị đơn hàng tối thiểu (VNĐ)</label>
                            <div class="input-group">
                                <input asp-for="MinOrderValue" id="minOrderInput" type="number" step="1000" class="form-control fw-semibold" value="@Model.MinOrderValue.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="MinOrderValue" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="UsageLimit" class="form-label fw-semibold">Tổng lượt phát hành</label>
                            <input asp-for="UsageLimit" id="usageLimitInput" type="number" class="form-control" min="0" />
                            <div class="form-text">0 = Không giới hạn</div>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="MaxUsagePerUser" class="form-label fw-semibold">Tối đa / 1 Khách</label>
                            <input asp-for="MaxUsagePerUser" type="number" class="form-control" min="0" max="100" />
                            <div class="form-text">Chuẩn Shopee: 1 lần/khách</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. PHẠM VI HOẠT ĐỘNG & ĐỐI TƯỢNG ÁP DỤNG (CHUẨN SHOPEE) -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="bx bx-target-lock text-primary me-2"></i>2. Phạm vi Áp dụng @(Model.IsAdmin ? "Trên Sàn (Ngành hàng / Mall)" : "Trong Gian hàng (Sản phẩm / Danh mục)")
                    </h5>
                    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill px-2.5 py-1">Chuẩn Shopee Seller Centre</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="ScopeType" class="form-label fw-semibold">Phạm vi sản phẩm / ngành hàng được áp mã <span class="text-danger">*</span></label>
                            <select asp-for="ScopeType" id="scopeTypeSelect" class="form-select fw-semibold">
                                @if (Model.IsAdmin)
                                {
                                    <option value="All">🌐 Toàn sàn Sellzy (Mọi ngành hàng &amp; gian hàng)</option>
                                    <option value="ByCategory">🗂️ Chỉ áp dụng cho Ngành hàng được chọn</option>
                                    <option value="MallOnly">👑 Đặc quyền Gian hàng chính hãng Sellzy Mall</option>
                                }
                                else
                                {
                                    <option value="All">🏪 Toàn bộ sản phẩm của Gian hàng</option>
                                    <option value="SpecificProducts">📦 Chỉ áp dụng cho các Sản phẩm được chọn (Khuyên dùng)</option>
                                    <option value="ByCategory">🏷️ Theo Danh mục ngành hàng trong Shop</option>
                                }
                            </select>
                            <span asp-validation-for="ScopeType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="TargetAudience" class="form-label fw-semibold">Đối tượng khách hàng</label>
                            <select asp-for="TargetAudience" id="targetAudienceSelect" class="form-select">
                                <option value="Public">👥 Công khai cho mọi khách hàng</option>
                                <option value="NewBuyerOnly">🆕 Chỉ Khách hàng mới (Mua lần đầu)</option>
                                <option value="PrivateChatOnly">💬 Mã ẩn (Chỉ gửi riêng qua khung Chat)</option>
                            </select>
                        </div>
                    </div>

                    <!-- BỘ CHỌN NGÀNH HÀNG (CHO CẢ ADMIN VÀ SHOP KHI CHỌN ByCategory) -->
                    <div id="categoryScopeBox" class="border rounded-4 p-3 bg-light mb-3" style="display: none;">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2.5">
                            <div class="fw-bold text-dark small">
                                <i class="bx bx-category text-primary me-1"></i>Tích chọn các Ngành hàng được phép áp dụng mã này:
                            </div>
                            <div class="d-flex gap-1.5">
                                <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-0.5 small" onclick="$('.cat-scope-cb').prop('checked', true).trigger('change');">Chọn tất cả</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2.5 py-0.5 small" onclick="$('.cat-scope-cb').prop('checked', false).trigger('change');">Bỏ chọn</button>
                            </div>
                        </div>
                        <div class="row g-2">
                            @foreach (var cat in Model.AvailableCategories)
                            {
                                bool isChecked = Model.SelectedCategoryIds != null && Model.SelectedCategoryIds.Contains(cat.CategoryId);
                                <div class="col-md-6">
                                    <label class="d-flex align-items-center justify-content-between p-2.5 rounded-3 bg-white border cursor-pointer w-100 mb-0">
                                        <span class="d-flex align-items-center gap-2 small fw-semibold text-dark">
                                            <input type="checkbox" name="SelectedCategoryIds" value="@cat.CategoryId" class="form-check-input mt-0 cat-scope-cb" data-comm="@cat.CommissionRatePercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" @(isChecked ? "checked" : "") />
                                            <span>@cat.CategoryName</span>
                                        </span>
                                        <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill" style="font-size: 11px;">
                                            Phí sàn @cat.CommissionRatePercent.ToString("0.#")% • @cat.ProductCount SP
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- BỘ CHỌN SẢN PHẨM CỤ THỂ CỦA SHOP (KÈM NHÃN HỌC MÁY BCG & BIÊN LÃI RÒNG) -->
                    @if (!Model.IsAdmin)
                    {
                        <div id="productScopeBox" class="border rounded-4 p-3 bg-light mb-3" style="display: none;">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2.5">
                                <div>
                                    <div class="fw-bold text-dark small">
                                        <i class="bx bx-package text-primary me-1"></i>Chọn sản phẩm của Shop được áp mã (<span id="selectedProdCount">0</span> / @Model.AvailableProducts.Count SP):
                                    </div>
                                    <div class="text-muted" style="font-size: 11.5px;">AI tính sẵn biên lợi nhuận ròng sau giá vốn &amp; phí sàn để bạn không chọn nhầm mã biên mỏng.</div>
                                </div>
                                <div class="d-flex flex-wrap gap-1.5">
                                    <button type="button" class="btn btn-sm btn-warning text-dark rounded-pill px-2.5 py-1 fw-bold" style="font-size: 11.5px;" onclick="selectAiRecommendedProducts()">
                                        <i class="bx bxs-magic-wand me-1"></i>AI gợi ý: Chọn SP Biên lãi cao (≥22%) &amp; Không Flash Sale
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" style="font-size: 11.5px;" onclick="$('.prod-scope-cb').prop('checked', true).trigger('change');">Chọn tất cả</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" style="font-size: 11.5px;" onclick="$('.prod-scope-cb').prop('checked', false).trigger('change');">Bỏ chọn</button>
                                </div>
                            </div>

                            <div class="mb-2">
                                <input type="text" id="prodScopeSearch" class="form-control form-control-sm rounded-pill px-3" placeholder="Tìm nhanh theo tên sản phẩm hoặc ngành hàng..." />
                            </div>

                            <div class="table-responsive bg-white rounded-3 border" style="max-height: 310px; overflow-y: auto;">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr class="small text-muted">
                                            <th class="ps-3" style="width: 36px;">Chọn</th>
                                            <th>Sản phẩm</th>
                                            <th class="text-end">Giá bán</th>
                                            <th class="text-center">Biên lãi ròng</th>
                                            <th class="text-center">Tồn kho</th>
                                            <th class="pe-3">Nhãn AI BCG</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prod in Model.AvailableProducts)
                                        {
                                            bool isProdChecked = Model.SelectedProductIds != null && Model.SelectedProductIds.Contains(prod.ProductId);
                                            <tr class="prod-scope-row" data-search="@((prod.ProductName + " " + prod.CategoryName).ToLowerInvariant())">
                                                <td class="ps-3">
                                                    <input type="checkbox"
                                                           name="SelectedProductIds"
                                                           value="@prod.ProductId"
                                                           class="form-check-input prod-scope-cb"
                                                           data-margin="@prod.EstimatedNetMarginPercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                                                           data-flash="@(prod.IsInFlashSale ? "1" : "0")"
                                                           data-price="@prod.SellingPrice.ToString("0", System.Globalization.CultureInfo.InvariantCulture)"
                                                           @(isProdChecked ? "checked" : "") />
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (!string.IsNullOrWhiteSpace(prod.ImageUrl))
                                                        {
                                                            <img src="@prod.ImageUrl" class="rounded-2 border" style="width: 32px; height: 32px; object-fit: cover;" alt="" />
                                                        }
                                                        <div>
                                                            <div class="small fw-bold text-dark text-truncate" style="max-width: 210px;">@prod.ProductName</div>
                                                            <div class="text-muted" style="font-size: 11px;">#@prod.ProductId • @prod.CategoryName</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-end small fw-semibold">@prod.SellingPrice.ToString("N0")₫</td>
                                                <td class="text-center">
                                                    <span class="badge rounded-pill @(prod.EstimatedNetMarginPercent >= 22m ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">
                                                        @prod.EstimatedNetMarginPercent.ToString("F1")%
                                                    </span>
                                                </td>
                                                <td class="text-center small">@prod.CurrentStock ĐV</td>
                                                <td class="pe-3">
                                                    <span class="badge border rounded-pill @prod.BcgBadgeClass" style="font-size: 10.5px;">@prod.BcgTag</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <!-- CHỐNG LỖ KÉP FLASH SALE -->
                    <div class="p-3 rounded-3 border bg-white d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <label class="form-check-label fw-bold text-dark small" for="ExcludeFlashSaleSwitch">
                                <i class="bx bxs-bolt text-warning me-1"></i>Bảo vệ Chống lỗ kép khi trùng Flash Sale (Chuẩn Shopee)
                            </label>
                            <div class="text-muted" style="font-size: 12px;">
                                Tự động chặn không cho khách áp chồng mã giảm giá này lên các sản phẩm đang được giảm giá sâu trong khung giờ Flash Sale.
                            </div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input type="checkbox" class="form-check-input" id="ExcludeFlashSaleSwitch" asp-for="ExcludeFlashSaleItems" style="width: 42px; height: 22px;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: XEM TRƯỚC THẺ + AI KIỂM TRA AN TOÀN BIÊN LỢI NHUẬN & NGÂN SÁCH -->
        <div class="col-lg-4">
            <div class="vc-preview-ticket shadow-sm mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small text-uppercase fw-bold" style="color: rgba(255,255,255,0.72); letter-spacing: 0.6px;">
                        @(Model.IsAdmin ? "VOUCHER HỆ THỐNG SELLZY" : $"VOUCHER SHOP • {Model.ShopName.ToUpperInvariant()}")
                    </span>
                    <span class="badge rounded-pill" id="previewTypeBadge" style="background: rgba(255,235,105,0.2); color: #FFEB69;">Giảm giá</span>
                </div>
                <div class="vc-preview-code mb-2" id="previewCode">@(string.IsNullOrWhiteSpace(Model.Code) ? "SELLZY2026" : Model.Code)</div>
                <div class="fs-5 fw-bold text-white" id="previewHeadline">Giảm 0%</div>
                <div class="small mt-1" style="color: rgba(255,255,255,0.85);" id="previewCondition">Áp dụng cho mọi đơn hàng</div>
                <div class="small mt-1 pt-1 border-top border-white border-opacity-10" style="color: #A7F3D0; font-size: 11.5px;" id="previewScopeLine">
                    Phạm vi: Toàn bộ • Công khai
                </div>
            </div>

            <!-- HỘP CỐ VẤN AI KIỂM TRA AN TOÀN BIÊN LỢI NHUẬN & NGÂN SÁCH -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-3" style="border: 1px solid #CCE3DF !important;">
                <div class="card-header py-2.5 px-3.5 d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #00262A 0%, #088178 100%); color: #ffffff;">
                    <span class="small fw-bold"><i class="bx bx-brain text-warning me-1"></i>AI Kiểm tra Biên lãi &amp; Quỹ Voucher</span>
                    <span class="badge rounded-pill" style="background: rgba(255,235,105,0.2); color: #FFEB69; font-size: 10.5px;">Realtime Guard</span>
                </div>
                <div class="card-body p-3.5 small">
                    <div class="d-flex justify-content-between mb-1.5 pb-1.5 border-bottom">
                        <span class="text-muted">@(Model.IsAdmin ? "Biên phí sàn TB nhóm chọn:" : "Biên lãi ròng TB trước Voucher:")</span>
                        <strong class="text-dark" id="aiBaseMarginDisplay">@Model.ShopAvgNetMarginPercent.ToString("F1")%</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1.5 pb-1.5 border-bottom">
                        <span class="text-muted">Tỷ lệ giảm thực tế ước tính:</span>
                        <strong class="text-primary" id="aiEffectiveDiscDisplay">0%</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-1.5 border-bottom">
                        <span class="text-muted">Ngân sách cam kết tối đa:</span>
                        <strong class="text-danger" id="aiMaxBudgetDisplay">0₫</strong>
                    </div>
                    <div id="aiMarginVerdictBox" class="p-2.5 rounded-3 border" style="background: #F0FDF4; border-color: #BBF7D0; color: #166534;">
                        Đang phân tích cấu hình Voucher...
                    </div>
                </div>
            </div>

            <!-- 3. THỜI GIAN & HIỂN THỊ -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-3">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bx bx-time text-primary me-2"></i>3. Thời gian &amp; Trạng thái</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label fw-semibold">Thời gian bắt đầu <span class="text-danger">*</span></label>
                        <input type="datetime-local" asp-for="StartDate" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EndDate" class="form-label fw-semibold">Thời gian kết thúc <span class="text-danger">*</span></label>
                        <input type="datetime-local" asp-for="EndDate" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="IsActiveSwitch" asp-for="IsActive" />
                        <label class="form-check-label fw-semibold" for="IsActiveSwitch">Kích hoạt mã giảm giá</label>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">
                    <i class="bx bx-save me-1"></i>@(isEdit ? "Lưu thay đổi Voucher" : "Phát hành Mã giảm giá")
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3 fw-semibold">Quay lại danh sách</a>
            </div>
        </div>
    </div>
</form>
