@using DOAN_BANHANG.ViewModels
@model VoucherAdminUpsertVm

@{
    ViewData["Title"] = Model.IsAdmin ? "Tạo Voucher Hệ thống mới" : "Tạo Mã giảm giá Gian hàng";
}

@section Styles {
    <style>
        .vc-form-hero {
            background: radial-gradient(circle at 88% 18%, rgba(255, 235, 105, 0.16) 0%, transparent 46%),
                        linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
            border-radius: 22px;
            padding: 22px 28px;
            color: #ffffff;
            margin-bottom: 20px;
            box-shadow: 0 18px 38px -16px rgba(0, 38, 42, 0.34);
        }
        .vc-preview-ticket {
            background: linear-gradient(135deg, #00262A 0%, #065F58 100%);
            border-radius: 18px;
            padding: 20px;
            color: #ffffff;
            position: relative;
            overflow: hidden;
            border: 1px dashed rgba(255, 235, 105, 0.45);
        }
        .vc-preview-code {
            display: inline-block;
            background: rgba(255, 235, 105, 0.16);
            color: #FFEB69;
            border: 1px dashed rgba(255, 235, 105, 0.6);
            border-radius: 10px;
            padding: 6px 14px;
            font-family: monospace;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }
    </style>
}

<div class="vc-form-hero">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <a asp-action="Index" class="btn btn-sm rounded-pill px-3 mb-2" style="background: rgba(255,255,255,0.14); color: #ffffff; border: 1px solid rgba(255,255,255,0.22);">
                <i class="bx bx-left-arrow-alt me-1"></i>Danh sách mã giảm giá
            </a>
            <h4 class="text-white fw-bold mb-1">
                <i class="bx bx-plus-circle text-warning me-1"></i>@(Model.IsAdmin ? "Tạo Mã giảm giá Hệ thống (Toàn sàn / Ngành hàng / Mall)" : $"Tạo Mã giảm giá Gian hàng — {Model.ShopName}")
            </h4>
            <p class="mb-0 small" style="color: rgba(255,255,255,0.82);">
                Tích hợp bộ chọn phạm vi Đa tầng chuẩn Shopee, giới hạn lượt dùng mỗi khách và AI kiểm tra an toàn biên lợi nhuận theo thời gian thực.
            </p>
        </div>
    </div>
</div>

<partial name="_VoucherFormPartial" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_VoucherFormScriptsPartial" model="Model" />
}
