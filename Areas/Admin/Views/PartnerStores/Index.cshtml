@model DOAN_BANHANG.ViewModels.PartnerStoreManageVm
@{
    ViewData["Title"] = "Hồ sơ cửa hàng đối tác";
    var coverSrc = string.IsNullOrWhiteSpace(Model.ShopCoverUrl) ? "/admin/assets/images/profile-img.png" : Model.ShopCoverUrl;
    var logoSrc = string.IsNullOrWhiteSpace(Model.ShopLogoUrl) ? "/admin/assets/images/companies/img-1.png" : Model.ShopLogoUrl;
}

<style>
    :root {
        --ps-teal: #0b5c56;
        --ps-teal-dark: #063532;
        --ps-border: #e2e8f0;
    }

    /* Profile Hero Card */
    .ps-profile-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--ps-border);
        box-shadow: 0 6px 24px rgba(15, 23, 42, 0.05);
        overflow: hidden;
        margin-bottom: 22px;
    }
    .ps-cover-wrap {
        position: relative;
        height: 240px;
        background: linear-gradient(135deg, #063532 0%, #0b5c56 60%, #0f766e 100%);
        overflow: hidden;
    }
    .ps-cover-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 1;
    }
    .ps-cover-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(6, 53, 50, 0.45) 0%, rgba(6, 53, 50, 0.15) 45%, rgba(6, 53, 50, 0.72) 100%);
        z-index: 2;
    }
    .ps-cover-actions {
        position: absolute;
        top: 16px;
        right: 18px;
        z-index: 4;
        display: flex;
        gap: 8px;
    }
    .ps-cover-btn {
        background: rgba(6, 53, 50, 0.65);
        backdrop-filter: blur(8px);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 10px;
        padding: 7px 13px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.18s;
    }
    .ps-cover-btn:hover { background: rgba(6, 53, 50, 0.9); color: #fff; }

    .ps-profile-body {
        padding: 0 28px 24px 28px;
        position: relative;
        z-index: 3;
    }
    .ps-logo-wrap {
        position: relative;
        width: 118px;
        height: 118px;
        margin-top: -59px;
        flex-shrink: 0;
    }
    .store-logo-preview {
        width: 118px;
        height: 118px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #fff;
        background-color: #fff;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.16);
    }
    .ps-logo-cam {
        position: absolute;
        right: 2px;
        bottom: 2px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--ps-teal);
        color: #fff;
        border: 2.5px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.18);
        transition: all 0.18s;
    }
    .ps-logo-cam:hover { background: var(--ps-teal-dark); transform: scale(1.06); }

    .ps-mall-btn {
        background: #00262A;
        color: #FFEB69;
        border: none;
        border-radius: 10px;
        padding: 9px 16px;
        font-size: 0.84rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(0, 38, 42, 0.22);
        transition: all 0.18s;
    }
    .ps-mall-btn:hover { background: #063532; color: #FFEB69; transform: translateY(-1px); }

    /* Main Settings Card */
    .ps-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--ps-border);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.035);
        overflow: hidden;
    }

    .ps-tabs-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 14px 24px 0 24px;
        border-bottom: 1px solid var(--ps-border);
        background: #fafcff;
    }
    .ps-tabs-bar .nav-link {
        color: #64748b;
        background: transparent;
        border: none;
        border-bottom: 2.5px solid transparent;
        border-radius: 0;
        padding: 10px 16px;
        font-weight: 600;
        font-size: 0.88rem;
        margin-bottom: -1px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.18s;
    }
    .ps-tabs-bar .nav-link:hover { color: var(--ps-teal); }
    .ps-tabs-bar .nav-link.active {
        color: var(--ps-teal);
        border-bottom-color: var(--ps-teal);
        background: transparent;
        font-weight: 700;
    }

    .ps-section-box {
        background: #fafcff;
        border: 1px solid var(--ps-border);
        border-radius: 14px;
        padding: 20px;
    }
    .ps-label {
        font-size: 0.8rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: 6px;
    }
    .ps-input {
        border-radius: 10px;
        border-color: #cbd5e1;
        font-size: 0.9rem;
    }
    .ps-input:focus {
        border-color: var(--ps-teal);
        box-shadow: 0 0 0 3px rgba(11, 92, 86, 0.12);
    }

    .ps-upload-card {
        background: #fff;
        border: 1.5px dashed #cbd5e1;
        border-radius: 14px;
        padding: 18px;
        transition: all 0.2s;
        height: 100%;
    }
    .ps-upload-card:hover { border-color: var(--ps-teal); background: #f0fdfa; }

    .ps-btn-save {
        background: #0b5c56;
        color: #fff;
        border: none;
        border-radius: 11px;
        padding: 10px 24px;
        font-weight: 700;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        box-shadow: 0 6px 16px rgba(11, 92, 86, 0.25);
        transition: all 0.18s;
    }
    .ps-btn-save:hover { background: #063532; color: #fff; transform: translateY(-1px); }
</style>

<!-- 1. STOREFRONT IDENTITY HERO CARD -->
<div class="ps-profile-card">
    <div class="ps-cover-wrap">
        <img src="@coverSrc" alt="Ảnh bìa cửa hàng" class="ps-cover-img" id="header-cover" />
        <div class="ps-cover-overlay"></div>

        <div class="position-absolute top-0 start-0 p-4" style="z-index: 3;">
            <span class="badge rounded-pill mb-1" style="background: rgba(255,255,255,0.18); color: #a7f3d0; font-weight: 700; font-size: 0.72rem;">
                <i class="bx bx-store-alt me-1"></i>HỒ SƠ GIAN HÀNG ĐỐI TÁC
            </span>
            <h4 class="text-white fw-bold mb-1" style="text-shadow: 0 2px 6px rgba(0,0,0,0.45);">Quản lý thương hiệu &amp; Kho vận</h4>
            <p class="small mb-0" style="color: rgba(255,255,255,0.85);">Cập nhật thông tin gian hàng, địa chỉ lấy hàng GHN và hình ảnh nhận diện chuyên nghiệp.</p>
        </div>

        <div class="ps-cover-actions">
            <button type="button" class="ps-cover-btn" onclick="document.getElementById('input-cover-file').click()">
                <i class="bx bx-camera"></i>Đổi ảnh bìa
            </button>
            <a asp-area="Admin" asp-controller="PartnerStores" asp-action="Index" class="ps-cover-btn">
                <i class="bx bx-refresh"></i>Tải lại
            </a>
        </div>
    </div>

    <div class="ps-profile-body">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3">
            <div class="d-flex flex-wrap align-items-end gap-3">
                <div class="ps-logo-wrap">
                    <img src="@logoSrc" alt="Logo cửa hàng" class="store-logo-preview" id="header-logo" />
                    <button type="button" class="ps-logo-cam" title="Đổi logo cửa hàng" onclick="document.getElementById('input-logo-file').click()">
                        <i class="bx bx-camera fs-6"></i>
                    </button>
                </div>
                <div class="pt-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <h4 class="fw-bold text-dark mb-0" id="header-shop-name">@(string.IsNullOrWhiteSpace(Model.ShopName) ? "Chưa có tên" : Model.ShopName)</h4>
                        <span class="badge rounded-pill bg-success-subtle text-success fw-bold px-2.5 py-1">
                            <i class="bx bxs-circle me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>Đang hoạt động
                        </span>
                        @if (Model.IsMall)
                        {
                            <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: #00262A; color: #FFEB69;">
                                <i class="bx bxs-badge-check me-1"></i>Sellzy Mall Chính Hãng
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-light text-secondary border px-2.5 py-1 fw-semibold">
                                <i class="bx bx-store me-1"></i>Shop Tiêu chuẩn
                            </span>
                        }
                    </div>
                    <div class="text-muted small mt-1 d-flex flex-wrap align-items-center gap-3">
                        <span id="header-shop-slug"><i class="bx bx-link-alt me-1"></i>@Model.ShopSlug</span>
                        <span><i class="bx bx-envelope me-1"></i>@Model.Email</span>
                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                        {
                            <span><i class="bx bx-phone me-1"></i>@Model.PhoneNumber</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 pt-2">
                <a asp-area="Admin" asp-controller="PartnerStores" asp-action="MallUpgrade" class="ps-mall-btn">
                    <i class="bx bxs-badge-check fs-5"></i>@(Model.IsMall ? "Quyền lợi Sellzy Mall" : "Nâng cấp Sellzy Mall")
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Alerts -->
@if (TempData["PartnerStoreSuccess"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
        <i class="bx bx-check-circle me-1 fs-5 align-middle"></i> <strong>@okMsg</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["PartnerStoreError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
        <i class="bx bx-error-circle me-1 fs-5 align-middle"></i> <strong>@errMsg</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- 2. MAIN SETTINGS CARD -->
<div class="ps-card">
    <ul class="nav ps-tabs-bar" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-info" type="button" role="tab">
                <i class="bx bx-info-circle fs-5"></i>Thông tin cơ bản
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-address" type="button" role="tab">
                <i class="bx bx-map-pin fs-5"></i>Địa chỉ kho hàng (GHN)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-media" type="button" role="tab">
                <i class="bx bx-image-alt fs-5"></i>Nhận diện thương hiệu
            </button>
        </li>
    </ul>

    <form method="post" asp-area="Admin" asp-controller="PartnerStores" asp-action="Update" id="store-form" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="p-4">
            <div class="tab-content">
                <!-- TAB 1: THÔNG TIN CƠ BẢN -->
                <div class="tab-pane fade show active" id="tab-info" role="tabpanel">
                    <div class="ps-section-box mb-4">
                        <div class="fw-bold text-dark small mb-3"><i class="bx bx-lock-alt text-muted me-1"></i>Định danh tài khoản (Cố định)</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label ps-label">Email tài khoản</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bx bx-envelope text-muted"></i></span>
                                    <input class="form-control bg-light ps-input" value="@Model.Email" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label ps-label">Đường dẫn gian hàng (Shop Slug)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bx bx-link text-muted"></i></span>
                                    <input class="form-control bg-light ps-input" value="@Model.ShopSlug" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="ps-section-box">
                        <div class="fw-bold text-dark small mb-3"><i class="bx bx-store text-success me-1"></i>Thông tin hiển thị gian hàng</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label ps-label">Tên cửa hàng <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bx bx-store-alt text-success"></i></span>
                                    <input class="form-control ps-input fw-semibold" name="ShopName" id="input-shop-name" value="@Model.ShopName" placeholder="Nhập tên cửa hàng của bạn" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label ps-label">Số điện thoại liên hệ / CSKH</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bx bx-phone text-success"></i></span>
                                    <input class="form-control ps-input" name="PhoneNumber" value="@Model.PhoneNumber" placeholder="Số điện thoại CSKH" />
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label ps-label">Mô tả giới thiệu cửa hàng</label>
                                <textarea class="form-control ps-input" name="ShopDescription" id="input-shop-desc" rows="4" placeholder="Giới thiệu về cửa hàng, cam kết chính hãng, thời gian làm việc và chính sách bảo hành...">@Model.ShopDescription</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label ps-label"><i class="bx bx-message-rounded-dots text-success me-1"></i>Tin nhắn chào tự động khi khách nhắn Chat (Auto-Reply)</label>
                                <textarea class="form-control ps-input" name="AutoReplyMessage" rows="2" maxlength="1000" placeholder="VD: Cảm ơn bạn đã nhắn tin cho Shop! Nhân viên tư vấn sẽ phản hồi bạn trong ít phút ạ...">@Model.AutoReplyMessage</textarea>
                                <div class="form-text small">Tự động gửi ngay khi khách hàng bắt đầu cuộc trò chuyện mới (tối đa 1 lần / 12 giờ cho mỗi hội thoại). Để trống nếu muốn tắt.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: ĐỊA CHỈ GHN -->
                <div class="tab-pane fade" id="tab-address" role="tabpanel">
                    <div class="p-3 rounded-3 mb-4 d-flex align-items-start gap-2" style="background: #f0fdfa; border: 1px solid #99f6e4; color: #065f46;">
                        <i class="bx bx-package fs-5 mt-0.5"></i>
                        <div class="small">
                            <strong>Địa chỉ kho lấy hàng Giao Hàng Nhanh (GHN):</strong> Địa chỉ này được hệ thống dùng để tự động tính cước vận chuyển cho khách và tạo vận đơn khi bưu tá GHN tới lấy hàng.
                        </div>
                    </div>

                    <div class="ps-section-box">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label ps-label">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <select class="form-select ps-input" id="ghn_province">
                                    <option value="">Chọn Tỉnh/Thành phố</option>
                                </select>
                                <input type="hidden" name="ProvinceName" id="ghn_province_name" value="@Model.ProvinceName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label ps-label">Quận / Huyện <span class="text-danger">*</span></label>
                                <select class="form-select ps-input" id="ghn_district" disabled>
                                    <option value="">Chọn Quận/Huyện</option>
                                </select>
                                <input type="hidden" name="DistrictName" id="ghn_district_name" value="@Model.DistrictName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label ps-label">Phường / Xã <span class="text-danger">*</span></label>
                                <select class="form-select ps-input" id="ghn_ward" disabled>
                                    <option value="">Chọn Phường/Xã</option>
                                </select>
                                <input type="hidden" name="WardName" id="ghn_ward_name" value="@Model.WardName" />
                            </div>
                            <div class="col-12">
                                <label class="form-label ps-label">Số nhà, tên đường chi tiết <span class="text-danger">*</span></label>
                                <input class="form-control ps-input" name="StreetAddress" id="ghn_street_address" value="@Model.StreetAddress" placeholder="Ví dụ: 123 Đường Nguyễn Trãi..." />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: NHẬN DIỆN THƯƠNG HIỆU -->
                <div class="tab-pane fade" id="tab-media" role="tabpanel">
                    <div class="p-3 rounded-3 mb-4 d-flex align-items-start gap-2" style="background: #f0fdfa; border: 1px solid #99f6e4; color: #065f46;">
                        <i class="bx bx-image-alt fs-5 mt-0.5"></i>
                        <div class="small">
                            Ảnh chọn từ máy sẽ được <strong>xem trước trực tiếp</strong> ở phần đầu trang và ô xem trước bên dưới trước khi bạn bấm <strong>Lưu thay đổi</strong>.
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-5">
                            <div class="ps-upload-card d-flex flex-column justify-content-between">
                                <div>
                                    <div class="fw-bold text-dark mb-1"><i class="bx bx-user-circle text-success me-1"></i>Logo cửa hàng (1:1)</div>
                                    <div class="text-muted small mb-3">JPG, PNG, WEBP • Tối đa 5MB • Khuyên dùng ảnh vuông 400×400px.</div>
                                    <div class="text-center my-3">
                                        <img src="@logoSrc" id="media-logo-preview" alt="Logo preview" class="rounded-circle border shadow-sm" style="width: 110px; height: 110px; object-fit: cover;" />
                                    </div>
                                </div>
                                <div>
                                    <input type="hidden" name="ShopLogoUrl" id="input-logo-url" value="@Model.ShopLogoUrl" />
                                    <input type="file" class="form-control form-control-sm ps-input" name="ShopLogoFile" id="input-logo-file" accept="image/png, image/jpeg, image/webp" />
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="ps-upload-card d-flex flex-column justify-content-between">
                                <div>
                                    <div class="fw-bold text-dark mb-1"><i class="bx bx-landscape text-success me-1"></i>Ảnh bìa gian hàng (Cover 16:9)</div>
                                    <div class="text-muted small mb-3">JPG, PNG, WEBP • Tối đa 5MB • Khuyên dùng ảnh ngang 1200×400px.</div>
                                    <div class="my-3">
                                        <img src="@coverSrc" id="media-cover-preview" alt="Cover preview" class="w-100 rounded-3 border shadow-sm" style="height: 110px; object-fit: cover;" />
                                    </div>
                                </div>
                                <div>
                                    <input type="hidden" name="ShopCoverUrl" id="input-cover-url" value="@Model.ShopCoverUrl" />
                                    <input type="file" class="form-control form-control-sm ps-input" name="ShopCoverFile" id="input-cover-file" accept="image/png, image/jpeg, image/webp" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Action Bar -->
        <div class="px-4 py-3 border-top bg-light bg-opacity-50 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="text-muted small">
                <i class="bx bx-info-circle me-1"></i>Mọi thay đổi ở cả 3 tab sẽ được lưu cùng lúc khi bấm nút bên phải.
            </div>
            <button type="submit" class="ps-btn-save" id="btn-submit">
                <i class="bx bx-save fs-5"></i> Lưu thay đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentLogoUrl = $('#input-logo-url').val();
            let currentCoverUrl = $('#input-cover-url').val();

            const updatePreviewText = () => {
                const shopName = $('#input-shop-name').val() || 'Chưa có tên';
                $('#header-shop-name').text(shopName);
            };

            $('#input-shop-name').on('input', updatePreviewText);

            $('#input-logo-file').on('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (ev) {
                        $('#header-logo').attr('src', ev.target.result);
                        $('#media-logo-preview').attr('src', ev.target.result);
                    };
                    reader.readAsDataURL(file);
                } else {
                    const fallback = currentLogoUrl || '/admin/assets/images/companies/img-1.png';
                    $('#header-logo').attr('src', fallback);
                    $('#media-logo-preview').attr('src', fallback);
                }
            });

            $('#input-cover-file').on('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (ev) {
                        $('#header-cover').attr('src', ev.target.result);
                        $('#media-cover-preview').attr('src', ev.target.result);
                    };
                    reader.readAsDataURL(file);
                } else {
                    const fallback = currentCoverUrl || '/admin/assets/images/profile-img.png';
                    $('#header-cover').attr('src', fallback);
                    $('#media-cover-preview').attr('src', fallback);
                }
            });

            // GHN Address Logic
            const endpoints = {
                provinces: '/api/ghn/provinces',
                districts: (pId) => `/api/ghn/districts?provinceId=${pId}`,
                wards: (dId) => `/api/ghn/wards?districtId=${dId}`
            };

            const $prov = $('#ghn_province');
            const $dist = $('#ghn_district');
            const $ward = $('#ghn_ward');
            const $provName = $('#ghn_province_name');
            const $distName = $('#ghn_district_name');
            const $wardName = $('#ghn_ward_name');

            const initProvName = $provName.val();
            const initDistName = $distName.val();
            const initWardName = $wardName.val();

            const loadOptions = async (url, $select, placeholder, valueKey, textKey, defaultText = '') => {
                try {
                    const res = await fetch(url);
                    if (!res.ok) throw new Error();
                    const data = await res.json();

                    $select.empty().append(`<option value="">${placeholder}</option>`);
                    let selectedVal = '';

                    data.forEach(item => {
                        const isMatch = defaultText && (item[textKey] === defaultText || defaultText.includes(item[textKey]) || item[textKey].includes(defaultText));
                        if (isMatch) selectedVal = item[valueKey];
                        $select.append(`<option value="${item[valueKey]}" ${isMatch ? 'selected' : ''}>${item[textKey]}</option>`);
                    });

                    $select.prop('disabled', false);
                    return selectedVal;
                } catch (e) {
                    $select.empty().append(`<option value="">Lỗi tải dữ liệu</option>`).prop('disabled', true);
                    return null;
                }
            };

            const initGHN = async () => {
                const selectedProvId = await loadOptions(endpoints.provinces, $prov, 'Chọn Tỉnh/Thành phố', 'id', 'name', initProvName);

                if (selectedProvId) {
                    const selectedDistId = await loadOptions(endpoints.districts(selectedProvId), $dist, 'Chọn Quận/Huyện', 'id', 'name', initDistName);

                    if (selectedDistId) {
                        await loadOptions(endpoints.wards(selectedDistId), $ward, 'Chọn Phường/Xã', 'code', 'name', initWardName);
                    }
                }
            };

            $prov.on('change', async function () {
                const id = $(this).val();
                $provName.val(id ? $(this).find('option:selected').text() : '');
                $distName.val('');
                $wardName.val('');
                $dist.empty().append('<option value="">Chọn Quận/Huyện</option>').prop('disabled', true);
                $ward.empty().append('<option value="">Chọn Phường/Xã</option>').prop('disabled', true);

                if (id) {
                    await loadOptions(endpoints.districts(id), $dist, 'Chọn Quận/Huyện', 'id', 'name');
                }
            });

            $dist.on('change', async function () {
                const id = $(this).val();
                $distName.val(id ? $(this).find('option:selected').text() : '');
                $wardName.val('');
                $ward.empty().append('<option value="">Chọn Phường/Xã</option>').prop('disabled', true);

                if (id) {
                    await loadOptions(endpoints.wards(id), $ward, 'Chọn Phường/Xã', 'code', 'name');
                }
            });

            $ward.on('change', function () {
                $wardName.val($(this).val() ? $(this).find('option:selected').text() : '');
            });

            initGHN();

            $('#store-form').on('submit', function (e) {
                if (!$provName.val() || !$distName.val() || !$wardName.val()) {
                    e.preventDefault();
                    alert('Vui lòng chọn đầy đủ Tỉnh/Thành phố, Quận/Huyện và Phường/Xã!');
                    $('button[data-bs-target="#tab-address"]').tab('show');
                }
            });
        });
    </script>
}
