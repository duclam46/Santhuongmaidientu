    }
    .admin-color-name { font-weight: 600; font-size: 0.9rem; }

    .admin-size-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 0.5rem;
    }
    .admin-size-tile {
        display: flex; align-items: center; justify-content: center; padding: 0.6rem 0.5rem;
        border: 1px solid var(--bs-border-color); border-radius: 0.75rem;
