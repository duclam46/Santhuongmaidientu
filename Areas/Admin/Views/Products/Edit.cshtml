@model DOAN_BANHANG.ViewModels.ProductAdminUpsertVm
@using DOAN_BANHANG.Helpers

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm: " + Model.Name;
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body bg-info-subtle border-start border-4 border-info">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar-sm rounded bg-info text-white d-inline-flex align-items-center justify-content-center">
                            <i class="bx bx-edit font-size-18"></i>
                        </span>
                        <div>
                            <h4 class="mb-0">Chỉnh sửa sản phẩm</h4>
                            <div class="text-muted small">ID: #@Model.Id — Cập nhật thông tin, hình ảnh và biến thể</div>
                        </div>
                    </div>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                            <li class="breadcrumb-item active">Chỉnh sửa</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="vp-form" asp-area="Admin" asp-controller="Products" asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden sticky-top" style="top: 20px; z-index: 100;">
                <div class="card-header bg-info-subtle border-0 border-start border-4 border-info">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar-xs">
                            <span class="avatar-title rounded-circle bg-info text-white">
                                <i class="bx bx-cog"></i>
                            </span>
                        </span>
                        <div class="fw-semibold text-info-emphasis">Quản lý chỉnh sửa</div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="nav flex-column nav-pills gap-1" id="vp-menu" role="tablist">
                        <button type="button" data-tab="info" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2 active" role="tab">
                            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">1</span>
                            <i class="bx bx-info-circle"></i>
                            <span>Thông tin cơ bản</span>
                        </button>
                        <button type="button" data-tab="classify" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab">
                            <span class="badge rounded-pill bg-info-subtle text-info border border-info-subtle">2</span>
                            <i class="bx bx-category-alt"></i>
                            <span>Phân loại</span>
                        </button>
                        <button type="button" data-tab="images" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab">
                            <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle">3</span>
                            <i class="bx bx-image"></i>
                            <span>Hình ảnh</span>
                        </button>
                        <button type="button" data-tab="variants" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab">
                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">4</span>
                            <i class="bx bx-layer"></i>
                            <span>Biến thể & Tồn kho</span>
                        </button>
                        <button type="button" data-tab="specs" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab">
                            <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle">5</span>
                            <i class="bx bx-ruler"></i>
                            <span>Bảng size (Guide)</span>
                        </button>
                    </div>

                    <hr class="my-4" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary shadow-sm py-2 fw-bold">
                            <i class="bx bx-save me-1"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                            <i class="bx bx-show me-1"></i> Xem trước
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bx bx-arrow-back me-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Panes -->
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden min-vh-50">
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger mb-4 shadow-sm" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <!-- 1. INFO PANE -->
                    <div class="vp-pane" data-pane="info">
                        <div class="pane-header mb-4 bg-primary-subtle p-3 rounded-3 border-start border-4 border-primary">
                            <h5 class="mb-0 fw-bold"><i class="bx bx-info-circle me-1"></i> Thông tin cơ bản</h5>
                            <p class="text-muted small mb-0">Tên sản phẩm, slug và nội dung mô tả chi tiết</p>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control form-control-lg fw-semibold" placeholder="Nhập tên sản phẩm..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Đường dẫn (Slug)</label>
                                <input asp-for="Slug" class="form-control" placeholder="Tự tạo nếu bỏ trống..." />
                                <span asp-validation-for="Slug" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Giá niêm yết (₫)</label>
                                <div class="input-group">
                                    <input name="Price" id="Price" value="@Model.Price.ToString("G29")" class="form-control vn-money-input fw-bold" type="text" />
                                    <span class="input-group-text bg-light fw-bold">₫</span>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Giá khuyến mãi (₫)</label>
                                <div class="input-group">
                                    <input name="SalePrice" id="SalePrice" value="@Model.SalePrice?.ToString("G29")" class="form-control vn-money-input text-danger fw-bold" type="text" />
                                    <span class="input-group-text bg-danger-subtle text-danger fw-bold">₫</span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label">Mô tả sản phẩm</label>
                            <textarea asp-for="Description" class="form-control" rows="10" placeholder="Mô tả nội dung chi tiết..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- 2. CLASSIFY PANE -->
                    <div class="vp-pane d-none" data-pane="classify">
                        <div class="pane-header mb-4 bg-info-subtle p-3 rounded-3 border-start border-4 border-info">
                            <h5 class="mb-0 fw-bold"><i class="bx bx-category-alt me-1"></i> Phân loại & Trạng thái</h5>
                            <p class="text-muted small mb-0">Thiết lập ngành hàng và khả năng hiển thị</p>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Phân loại danh mục</label>
                            <input type="hidden" asp-for="CategoryId" id="finalCategoryId" />
                            <div id="categoryCascader" class="d-flex flex-wrap gap-2">
                                <!-- Selects will be generated here -->
                            </div>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                            <div class="mt-2 text-muted small" id="categoryBreadcrumb"></div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label">Trạng thái bán hàng</label>
                            <div class="row g-3">
                                @foreach (var s in Model.StatusOptions)
                                {
                                    <div class="col-md-4">
                                        <input type="radio" class="btn-check" name="Status" id="status_@s.ValueString" value="@s.ValueString" @(Model.Status == s.ValueString ? "checked" : "")>
                                        <label class="btn btn-outline-secondary w-100 py-3 fw-semibold shadow-sm" for="status_@s.ValueString">
                                            @if (s.ValueString == "Active") { <i class="bx bx-check-circle me-1"></i> }
                                            else if (s.ValueString == "Draft") { <i class="bx bx-edit me-1"></i> }
                                            else { <i class="bx bx-hide me-1"></i> }
                                            @s.Label
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 3. IMAGES PANE -->
                    <div class="vp-pane d-none" data-pane="images">
                        <div class="pane-header mb-4 bg-warning-subtle p-3 rounded-3 border-start border-4 border-warning">
                            <h5 class="mb-0 fw-bold"><i class="bx bx-image me-1"></i> Quản lý hình ảnh</h5>
                            <p class="text-muted small mb-0">Cập nhật ảnh chính và bộ sưu tập ảnh sản phẩm</p>
                        </div>

                        <div class="row mb-5">
                            <div class="col-lg-5 mb-4 mb-lg-0">
                                <label class="form-label fw-bold d-block mb-3">Ảnh đại diện chính</label>
                                <div class="admin-image-box mx-auto @(Model.Images.Any(i => i.IsPrimary) ? "has-image" : "")" id="primaryImageBox">
                                    @{ var primary = Model.Images.FirstOrDefault(i => i.IsPrimary); }
                                    <div class="admin-image-box__empty @(primary != null ? "d-none" : "")" id="primaryImageEmpty">
                                        <i class="bx bx-cloud-upload fs-1 text-warning mb-2"></i>
                                        <p class="mb-0 fw-semibold">Tải ảnh đại diện</p>
                                        <span class="text-muted smaller">Bấm để chọn file</span>
                                    </div>
                                    <img src="@primary?.ImageUrl" id="primaryImagePreviewImg" class="admin-image-box__img @(primary == null ? "d-none" : "")" />
                                    
                                    <div class="admin-image-box__overlay">
                                        <button type="button" class="btn btn-sm btn-light" id="primaryOverlayChangeBtn"><i class="bx bx-pencil"></i> Đổi ảnh</button>
                                        <button type="button" class="btn btn-sm btn-danger" id="primaryOverlayRemoveBtn"><i class="bx bx-trash"></i></button>
                                    </div>
                                    <input type="file" name="PrimaryImage" id="primaryImageInput" class="d-none" accept="image/*" />
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <label class="form-label fw-bold mb-0">Bộ sưu tập ảnh (Gallery)</label>
                                    <button type="button" class="btn btn-sm btn-soft-warning" onclick="document.getElementById('contentPickerMany').click()">
                                        <i class="bx bx-plus me-1"></i> Thêm nhiều ảnh
                                    </button>
                                </div>
                                <div class="admin-image-strip" id="contentImageSlots">
                                    @for (var i = 0; i < Model.Images.Count; i++)
                                    {
                                        if (Model.Images[i].IsPrimary) continue;
                                        <div class="admin-image-slot">
                                            <img src="@Model.Images[i].ImageUrl" class="admin-image-slot__img" />
                                            <div class="admin-image-slot__remove">
                                                <a href="@Url.Action("DeleteProductImage","Products",new{area="Admin",productId=Model.Id,imageId=Model.Images[i].ImageId})" 
                                                   class="btn btn-xs btn-danger shadow-sm rounded-circle" title="Xóa ảnh này">
                                                    <i class="bx bx-x"></i>
                                                </a>
                                            </div>
                                            <input type="hidden" name="Images[@i].ImageId" value="@Model.Images[i].ImageId" />
                                            <input type="hidden" name="Images[@i].ImageUrl" value="@Model.Images[i].ImageUrl" />
                                        </div>
                                    }
                                    <div class="admin-image-slot admin-image-slot--add" onclick="document.getElementById('contentPickerMany').click()" role="button">
                                        <i class="bx bx-plus fs-4"></i>
                                    </div>
                                </div>
                                <input type="file" name="ContentImages" id="contentPickerMany" class="d-none" multiple accept="image/*" />
                                <div class="form-text mt-3 bg-light p-2 rounded border-start border-3 border-warning">
                                    <i class="bx bx-info-circle text-warning me-1"></i> Mẹo: Chọn cùng lúc nhiều ảnh để tải lên nhanh hơn. Tỉ lệ khuyến nghị 1:1.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. VARIANTS PANE -->
                    <div class="vp-pane d-none" data-pane="variants">
                        <div class="pane-header mb-4 bg-success-subtle p-3 rounded-3 border-start border-4 border-success">
                            <h5 class="mb-0 fw-bold"><i class="bx bx-layer me-1"></i> Biến thể & Tồn kho</h5>
                            <p class="text-muted small mb-0">Quản lý các kết hợp Màu sắc x Kích cỡ và số lượng trong kho</p>
                        </div>

                        <div class="card border-0 shadow-none bg-light mb-4">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3"><i class="bx bx-plus-circle me-1"></i> Thêm hoặc đổi tổ hợp Màu sắc & Size</h6>
                                <p class="text-muted small">Tích chọn Màu và Size bên dưới để bảng tồn kho tự động cập nhật. Các tổ hợp đã có sẵn sẽ được giữ lại.</p>
                                
                                <div class="mb-4">
                                    <label class="form-label smaller text-uppercase fw-bold text-muted ls-1">Màu sắc hiện có</label>
                                    <div class="admin-color-grid" id="colorPickerGrid">
                                        @foreach (var c in Model.ColorOptions)
                                        {
                                            <div class="color-item">
                                                <input type="checkbox" class="btn-check color-checkbox" id="color_@c.Value" value="@c.Value" data-color-name="@c.Label">
                                                <label class="admin-color-tile" for="color_@c.Value">
                                                    @if (!string.IsNullOrEmpty(c.Hex))
                                                    {
                                                        <span class="admin-color-swatch" style="--swatch: @c.Hex"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bx bx-palette text-muted admin-color-icon"></i>
                                                    }
                                                    <span class="admin-color-name">@c.Label</span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label smaller text-uppercase fw-bold text-muted ls-1">Kích cỡ hiện có (Size)</label>
                                    <div class="btn-group admin-seg-toggle mb-3 shadow-sm border rounded-pill overflow-hidden" role="group">
                                        <input type="radio" class="btn-check" name="sizeMode" id="sizeOther" value="all" checked>
                                        <label class="btn btn-outline-success border-0 admin-seg-btn" for="sizeOther"><i class="bx bx-grid-alt"></i> Tất cả</label>

                                        <input type="radio" class="btn-check" name="sizeMode" id="sizeClothing" value="clothing">
                                        <label class="btn btn-outline-success border-0 admin-seg-btn" for="sizeClothing"><i class="bx bx-closet"></i> Quần áo</label>
                                        
                                        <input type="radio" class="btn-check" name="sizeMode" id="sizeShoe" value="shoe">
                                        <label class="btn btn-outline-success border-0 admin-seg-btn" for="sizeShoe"><i class="bx bx-run"></i> Giày dép</label>

                                        <input type="radio" class="btn-check" name="sizeMode" id="sizeVolume" value="volume">
                                        <label class="btn btn-outline-success border-0 admin-seg-btn" for="sizeVolume"><i class="bx bx-vial"></i> Dung tích</label>

                                        <input type="radio" class="btn-check" name="sizeMode" id="sizeWeight" value="weight">
                                        <label class="btn btn-outline-success border-0 admin-seg-btn" for="sizeWeight"><i class="bx bx-weight"></i> Khối lượng</label>
                                    </div>

                                    <div class="admin-size-grid" id="sizePickerGrid">
                                        @if (Model.SizeOptions != null)
                                        {
                                            foreach (var s in Model.SizeOptions)
                                            {
                                                var label = (s.Label ?? "").Trim().ToUpper();
                                                var kind = "other";
                                                
                                                // Volume
                                                if (label.Contains("ML") || label.Contains(" L") || label.EndsWith(" L") || (label.Length > 1 && label.EndsWith("L") && char.IsDigit(label[0]))) kind = "volume";
                                                // Weight
                                                else if (label.Contains("G") || label.Contains("KG")) kind = "weight";
                                                // Clothing Alpha
                                                else if (System.Text.RegularExpressions.Regex.IsMatch(label, @"\b(XXS|XS|S|M|L|XL|XXL|XXXL|FREESIZE|FS)\b")) kind = "clothing";
                                                // Numeric
                                                else if (double.TryParse(label, out var num))
                                                {
                                                    if (num >= 34 && num <= 48) kind = "shoe";
                                                    else if (num >= 26 && num <= 42) kind = "clothing";
                                                    else kind = "other";
                                                }
                                                
                                                <div class="size-item-wrapper" data-size-kind="@kind">
                                                    <input type="checkbox" class="btn-check size-checkbox" 
                                                           id="sz_@s.Value" value="@s.Label" data-size-id="@s.Value"
                                                           @(Model.Variants.Any(v => v.SizeId == s.Value) ? "checked" : "")>
                                                    <label class="admin-size-tile" for="sz_@s.Value">@s.Label</label>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- LIVE TABLE -->
                        <div class="table-responsive bg-white rounded-3 border shadow-sm">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light border-bottom">
                                    <tr>
                                        <th class="ps-3 py-3">Phân loại</th>
                                        <th>SKU (Mã)</th>
                                        <th style="width: 180px;">Giá bán (₫)</th>
                                        <th style="width: 120px; text-align:center;">Số lượng</th>
                                        <th style="width: 80px; text-align:center;">Bán?</th>
                                    </tr>
                                </thead>
                                <tbody id="variantStocksBody">
                                    <!-- Combinations (Old + New) appear here -->
                                </tbody>
                            </table>
                        </div>
                        <div id="variantEmptyPrompt" class="text-center py-5 text-muted bg-light rounded-3 mt-3 border border-dashed">
                            <i class="bx bx-layer fs-1 mb-2"></i>
                            <p class="mb-0">Chọn Màu sắc và Kích cỡ để quản lý tồn kho cho từng biến thể.</p>
                        </div>
                    </div>

                    <!-- 5. SIZE GUIDE PANE -->
                    <div class="vp-pane d-none" data-pane="specs">
                        <div class="pane-header mb-4 bg-secondary-subtle p-3 rounded-3 border-start border-4 border-secondary">
                            <h5 class="mb-0 fw-bold"><i class="bx bx-ruler me-1"></i> Bảng quy đổi kích cỡ (Size Guide)</h5>
                            <p class="text-muted small mb-0">Hướng dẫn khách hàng chọn size phù hợp dựa trên các số đo thực tế</p>
                        </div>

                        <div class="mb-3 d-flex align-items-center justify-content-between">
                            <label class="form-label mb-0 fw-bold">Loại bảng size áp dụng</label>
                            <select id="sizeGuideSchemeSelect" class="form-select form-select-sm" style="width: 200px;">
                                <option value="ao">Áo / Tops</option>
                                <option value="quan">Quần / Bottoms</option>
                                <option value="shoe">Giày / Dép</option>
                                <option value="all">Tất cả thông số</option>
                            </select>
                        </div>

                        <div class="table-responsive bg-white rounded-3 border shadow-sm" id="sizeGuideTableWrap">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3" style="width: 110px;">Size</th>
                                        <th class="sg-col-ao sg-col-quan sg-col-shared" style="width: 130px;">Cao (cm)</th>
                                        <th class="sg-col-ao sg-col-quan sg-col-shared" style="width: 130px;">Nặng (kg)</th>
                                        <th class="sg-col-ao" style="width: 110px;">Vai (cm)</th>
                                        <th class="sg-col-ao" style="width: 110px;">Ngực (cm)</th>
                                        <th class="sg-col-quan d-none" style="width: 110px;">Eo (cm)</th>
                                        <th class="sg-col-quan d-none" style="width: 110px;">Mông (cm)</th>
                                        <th class="sg-col-ao sg-col-quan sg-col-shared" style="width: 100px;">Dài (cm)</th>
                                        <th class="sg-col-shoe d-none" style="width: 140px;">Dài chân (cm)</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody id="sizeGuideBody">
                                    <!-- Dynamic rows for selected sizes -->
                                </tbody>
                            </table>
                        </div>
                        <div id="sizeGuideEmptyPrompt" class="alert alert-info mt-3 d-none">
                            <i class="bx bx-info-circle me-1"></i> Vui lòng chọn size ở bước <b>Biến thể & Tồn kho</b> để nhập thông số size guide.
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</form>

<!-- TEMPLATES -->
<template id="variantRowTemplate">
    <tr data-row data-color-id="__colorId__" data-size-id="__sizeId__" data-active="__activeValue__">
        <td class="ps-3">
            <input type="hidden" name="Variants[__index__].VariantId" value="__variantId__" />
            <input type="hidden" name="Variants[__index__].ColorId" value="__colorId__" />
            <input type="hidden" name="Variants[__index__].ColorName" value="__colorName__" />
            <input type="hidden" name="Variants[__index__].SizeId" value="__sizeId__" />
            <input type="hidden" name="Variants[__index__].SizeName" value="__sizeName__" />
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">__colorName__</span>
                <span class="fw-bold">__sizeName__</span>
                <span class="badge bg-emerald-subtle text-emerald __newBadgeClass__">MỚI</span>
            </div>
        </td>
        <td>
            <input name="Variants[__index__].Sku" value="__sku__" class="form-control form-control-sm" />
        </td>
        <td>
            <div class="input-group input-group-sm">
                <input name="Variants[__index__].Price" value="__price__" class="form-control vn-money-input fw-bold" type="text" />
                <span class="input-group-text bg-light fw-bold">₫</span>
            </div>
        </td>
        <td>
            <input name="Variants[__index__].StockQuantity" value="__stock__" type="number" min="0" class="form-control form-control-sm text-center fw-bold" />
        </td>
        <td class="text-center">
            <div class="form-check form-switch d-inline-flex align-items-center justify-content-center gap-2">
                <input class="form-check-input variant-active-checkbox" type="checkbox" name="Variants[__index__].IsActive" value="true" />
                <input type="hidden" name="Variants[__index__].IsActive" value="false" class="variant-active-false" />
                <span class="small fw-semibold variant-active-text">__activeText__</span>
            </div>
        </td>
    </tr>
</template>

<template id="sizeGuideRowTemplate">
    <tr data-sg-row data-size-label="__sizeLabel__">
        <td class="ps-3">
            <input type="hidden" name="SizeGuide[__index__].SizeLabel" value="__sizeLabel__" />
            <span class="fw-bold text-info">__sizeLabel__</span>
        </td>
        <td class="sg-col-ao sg-col-quan sg-col-shared"><input class="form-control form-control-sm" name="SizeGuide[__index__].HeightRange" value="__h__" placeholder="160-170" /></td>
        <td class="sg-col-ao sg-col-quan sg-col-shared"><input class="form-control form-control-sm" name="SizeGuide[__index__].WeightRange" value="__w__" placeholder="50-60" /></td>
        <td class="sg-col-ao"><input class="form-control form-control-sm" name="SizeGuide[__index__].ShoulderWidth" value="__sh__" /></td>
        <td class="sg-col-ao"><input class="form-control form-control-sm" name="SizeGuide[__index__].Bust" value="__bu__" /></td>
        <td class="sg-col-quan d-none"><input class="form-control form-control-sm" name="SizeGuide[__index__].Waist" value="__wa__" /></td>
        <td class="sg-col-quan d-none"><input class="form-control form-control-sm" name="SizeGuide[__index__].Hip" value="__hi__" /></td>
        <td class="sg-col-ao sg-col-quan sg-col-shared"><input class="form-control form-control-sm" name="SizeGuide[__index__].ClothingLength" value="__le__" /></td>
        <td class="sg-col-shoe d-none"><input class="form-control form-control-sm" name="SizeGuide[__index__].ShoeLength" value="__sl__" /></td>
        <td><input class="form-control form-control-sm" name="SizeGuide[__index__].Note" value="__no__" /></td>
    </tr>
</template>

<style>
    :root {
        --emerald: #10b981;
        --emerald-subtle: #d1fae5;
    }
    .text-emerald { color: var(--emerald); }
    .bg-emerald-subtle { background: var(--emerald-subtle); }
    .min-vh-50 { min-height: 50vh; }
    .ls-1 { letter-spacing: 0.5px; }
    .smaller { font-size: 0.75rem; }

    /* Admin UI aesthetics */
    #vp-menu .nav-link {
        padding: 0.8rem 1rem;
        border-radius: 0.75rem;
        color: var(--bs-body-color);
        transition: all 0.2s ease;
        border: 1px solid transparent;
        margin-bottom: 2px;
    }
    #vp-menu .nav-link:hover {
        background: var(--bs-light);
    }
    #vp-menu .nav-link.active {
        background: var(--bs-info-subtle);
        color: var(--bs-info-emphasis);
        border-color: var(--bs-info-subtle);
    }

    .admin-color-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 0.75rem;
    }
    .admin-color-tile {
        display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0.75rem;
        border: 1px solid var(--bs-border-color); border-radius: 0.75rem;
        background: white; cursor: pointer; user-select: none; transition: all 0.15s ease;
    }
    .color-checkbox:checked + .admin-color-tile {
        border-color: var(--bs-success); background: var(--bs-success-subtle);
