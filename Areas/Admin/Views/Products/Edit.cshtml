    .admin-seg-toggle .nav-link { flex: 1; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        const allSizesData = @Html.Raw(Json.Serialize(Model.SizeOptions ?? new List<DOAN_BANHANG.ViewModels.ProductAdminSelectOptionVm>()));
        const existingVariantsData = @Html.Raw(Json.Serialize(Model.Variants ?? new List<DOAN_BANHANG.ViewModels.ProductAdminVariantRowVm>()));
        const existingGuideData = @Html.Raw(Json.Serialize(Model.SizeGuide ?? new List<DOAN_BANHANG.ViewModels.ProductAdminSizeGuideRowVm>()));
    </script>

    <script>
    (() => {
        // ── Navigation ──
        const menuBtns = document.querySelectorAll('#vp-menu [data-tab]');
        const panes = document.querySelectorAll('.vp-pane');
        
        menuBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const target = btn.dataset.tab;
                menuBtns.forEach(b => b.classList.toggle('active', b === btn));
                panes.forEach(p => p.classList.toggle('d-none', p.dataset.pane !== target));
                
                // If switching to specs, force refresh size guide
                if (target === 'specs') refreshSizeGuide();
            });
        });

        // ── Data ──
        const allSizes = Array.isArray(allSizesData) ? allSizesData : [];
        const existingVariants = Array.isArray(existingVariantsData) ? existingVariantsData : [];
        const existingGuide = Array.isArray(existingGuideData) ? existingGuideData : [];

        // Map for quick access to existing data: "colorId-sizeId" -> variant
        const variantMap = new Map();
        existingVariants.forEach(v => {
            const cid = v.colorId || v.ColorId || 0;
            const sid = v.sizeId || v.SizeId || 0;
            variantMap.set(`${cid}-${sid}`, v);
        });

        // Map for guide data: "SizeName" -> row data
        const guideDataMap = new Map();
        existingGuide.forEach(g => {
            const label = g.sizeLabel || g.SizeLabel;
            if (label) guideDataMap.set(label, g);
        });

        // Cache for current UI inputs
        const currentInputs = new Map(); // "colorId-sizeId" -> { sku, price, stock, active }

        // ── Category Cascade ──
        const categoryCascader = document.getElementById('categoryCascader');
        const finalCategoryId = document.getElementById('finalCategoryId');
        const categoryBreadcrumb = document.getElementById('categoryBreadcrumb');
        let allCats = [];
        let catMap = new Map();

        function updateBreadcrumb(path) {
            const ids = Array.isArray(path) ? path : [];
            const names = ids
                .map(id => catMap.get(id))
                .filter(Boolean)
                .map(c => c.name);

            if (categoryBreadcrumb) {
                categoryBreadcrumb.textContent = names.length ? `Đã chọn: ${names.join(' / ')}` : '';
            }

            finalCategoryId.value = ids.length > 0 ? ids[ids.length - 1] : '';
        }

        async function initCategoryCascade() {
            try {
                const res = await fetch(`@Url.Action("AllCategories", "Products", new { area = "Admin" })`);
                allCats = await res.json();

                catMap = new Map();
                allCats.forEach(c => catMap.set(c.id, c));
                
                let currentId = parseInt(finalCategoryId.value) || 0;
                let path = [];
                while (currentId > 0 && catMap.has(currentId)) {
                    path.unshift(currentId);
                    currentId = catMap.get(currentId).parentId || 0;
                }
                
                renderCascader(path);
            } catch (err) {
                console.error("Lỗi khi tải danh mục", err);
            }
        }

        function renderCascader(path) {
            categoryCascader.innerHTML = '';
            
            let parentId = null;
            let currentLevel = 0;
            
            for (let i = 0; i < path.length; i++) {
                const selectedId = path[i];
                renderSelect(parentId, selectedId, currentLevel);
                parentId = selectedId;
                currentLevel++;
            }
            
            const hasChildren = allCats.some(c => c.parentId === parentId);
            if (hasChildren || path.length === 0) {
                renderSelect(parentId, "", currentLevel);
            }
            
            updateBreadcrumb(path);
        }

        function renderSelect(parentId, selectedValue, level) {
            const children = allCats.filter(c => c.parentId === parentId);
            if (children.length === 0) return;
            
            const select = document.createElement('select');
            select.className = 'form-select';
            select.style.flex = "1";
            select.style.minWidth = "180px";
            select.dataset.level = level;
            
            select.innerHTML = `<option value="">-- Chọn danh mục cấp ${level + 1} --</option>`;
            children.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id;
                opt.textContent = c.name;
                if (c.id == selectedValue) opt.selected = true;
                select.appendChild(opt);
            });
            
            select.addEventListener('change', (e) => {
                const newPath = [];
                const selects = Array.from(categoryCascader.querySelectorAll('select'));
                for (const s of selects) {
                    if (s.value) newPath.push(parseInt(s.value));
                    if (s === e.target) break;
                }
                
                finalCategoryId.value = newPath.length > 0 ? newPath[newPath.length - 1] : '';
                renderCascader(newPath);
                autoDetectScheme();
            });
            
            categoryCascader.appendChild(select);
        }

        // ── Images ──
        const pInp = document.getElementById('primaryImageInput');
        const pBox = document.getElementById('primaryImageBox');
        const pImg = document.getElementById('primaryImagePreviewImg');
        const pEmpty = document.getElementById('primaryImageEmpty');
        
        pBox?.addEventListener('click', e => {
            if (!e.target.closest('#primaryOverlayRemoveBtn')) pInp.click();
        });
        pInp?.addEventListener('change', () => {
            const f = pInp.files[0]; if (!f) return;
            if (pImg.src.startsWith('blob:')) URL.revokeObjectURL(pImg.src);
            pImg.src = URL.createObjectURL(f);
            pImg.classList.remove('d-none'); pEmpty.classList.add('d-none'); pBox.classList.add('has-image');
        });
        document.getElementById('primaryOverlayRemoveBtn')?.addEventListener('click', e => {
            e.stopPropagation(); pInp.value = '';
            if (pImg.src.startsWith('blob:')) URL.revokeObjectURL(pImg.src);
            pImg.src = ''; pImg.classList.add('d-none'); pEmpty.classList.remove('d-none'); pBox.classList.remove('has-image');
        });

        const mInp = document.getElementById('contentPickerMany');
        const mSlots = document.getElementById('contentImageSlots');
        mInp?.addEventListener('change', () => {
            const files = Array.from(mInp.files);
            mSlots.querySelectorAll('.gi-new').forEach(el => el.remove());
            const addBtn = mSlots.querySelector('.admin-image-slot--add');
            files.forEach(f => {
                const url = URL.createObjectURL(f);
                const div = document.createElement('div');
                div.className = 'admin-image-slot gi-new';
                div.innerHTML = `<img src="${url}" class="admin-image-slot__img" /><div class="admin-image-slot__remove"><button type="button" class="btn btn-xs btn-danger rounded-circle" onclick="this.closest('.gi-new').remove()"><i class="bx bx-x"></i></button></div>`;
                mSlots.insertBefore(div, addBtn);
            });
        });

        // ── Variants Logic ──
        const colorChecks = document.querySelectorAll('.color-checkbox');
        const sizePickerGrid = document.getElementById('sizePickerGrid');
        const variantBody = document.getElementById('variantStocksBody');
        const variantPrompt = document.getElementById('variantEmptyPrompt');
        const sizeModeRadios = document.querySelectorAll('input[name="sizeMode"]');

        function classify(name) {
            const s = (name || '').toString().trim().toUpperCase();
            if (!s) return 'all';

            const num = parseFloat(s);
            if (!isNaN(num)) {
                if (num >= 34 && num <= 48) return 'shoe';
                return 'clothing'; 
            }

            if (/\b(XXS|XS|S|M|L|XL|XXL|XXXL|FREESIZE|FS)\b/.test(s)) return 'clothing';
            return 'all';
        }

        function parseShoeNumber(name) {
            const raw = (name || '').trim().toUpperCase();
            if (!raw) return Number.NaN;
            const m = raw.match(/(\d+(?:\.\d+)?)/);
            return m ? parseFloat(m[1]) : Number.NaN;
        }

        function getSelectedColors() {
            return Array.from(colorChecks).filter(c => c.checked).map(c => ({
                id: c.value,
                name: c.getAttribute('data-color-name')
            }));
        }

        function getSelectedSizes() {
            return Array.from(sizePickerGrid.querySelectorAll('.size-checkbox:checked')).map(c => ({
                id: c.getAttribute('data-size-id'),
                name: c.value
            }));
        }

        function renderSizePicker() {
            const mode = Array.from(sizeModeRadios).find(r => r.checked)?.value || 'all';
            
            sizePickerGrid.querySelectorAll('.size-item-wrapper').forEach(wrapper => {
                const kind = wrapper.dataset.sizeKind;
                if (mode === 'all' || kind === mode) {
                    wrapper.classList.remove('d-none');
                } else {
                    wrapper.classList.add('d-none');
                }
            });
        }

        function saveCurrentTableData() {
            variantBody.querySelectorAll('tr[data-row]').forEach(tr => {
                const cid = tr.dataset.colorId;
                const sid = tr.dataset.sizeId;
                const sku = tr.querySelector('input[name$=".Sku"]')?.value || "";
                const price = tr.querySelector('input[name$=".Price"]')?.value || "";
                const stock = tr.querySelector('input[name$=".StockQuantity"]')?.value || "0";
                const cb = tr.querySelector('.variant-active-checkbox');
                const active = cb ? cb.checked : false;
                
                currentInputs.set(`${cid}-${sid}`, { sku, price, stock, active });
            });
        }

        function refreshVariants() {
            saveCurrentTableData();
            const colors = getSelectedColors();
            const sizes = getSelectedSizes();
            
            const colorList = colors.length > 0 ? colors : [{ id: "0", name: "Mặc định" }];
            
            variantBody.innerHTML = '';
            let index = 0;
            let visible = 0;

            const tpl = document.getElementById('variantRowTemplate');

            colorList.forEach(color => {
                sizes.forEach(size => {
                    const key = `${color.id}-${size.id}`;
                    const existing = variantMap.get(key);
                    const cached = currentInputs.get(key);

                    const variantId = existing ? (existing.variantId !== undefined ? existing.variantId : existing.VariantId) : "0";
                    const sku = cached ? cached.sku : (existing ? (existing.sku || existing.Sku || "") : "");
                    const price = cached ? cached.price : (existing ? (existing.price !== undefined ? existing.price : (existing.Price !== undefined ? existing.Price : document.getElementById('Price').value)) : document.getElementById('Price').value);
                    const stock = cached ? cached.stock : (existing ? (existing.stockQuantity !== undefined ? existing.stockQuantity : (existing.StockQuantity !== undefined ? existing.StockQuantity : "0")) : "0");
                    const activeRaw = cached ? cached.active : (existing ? (existing.isActive !== undefined ? existing.isActive : (existing.IsActive !== undefined ? existing.IsActive : undefined)) : undefined);
                    const activeStr = existing ? (existing.isActiveStr ?? existing.IsActiveStr) : undefined;
                    const active = (() => {
                        if (activeRaw === true || activeRaw === 'true' || activeRaw === 1 || activeRaw === '1') return true;
                        if (activeRaw === false || activeRaw === 'false' || activeRaw === 0 || activeRaw === '0') return false;
                        if (activeStr === true || activeStr === 'true' || activeStr === 1 || activeStr === '1') return true;
                        if (activeStr === false || activeStr === 'false' || activeStr === 0 || activeStr === '0') return false;
                        return true; // default for safety
                    })();

                    let html = tpl.innerHTML
                        .replaceAll('__index__', index)
                        .replaceAll('__variantId__', variantId)
                        .replaceAll('__colorId__', color.id)
                        .replaceAll('__colorName__', color.name)
                        .replaceAll('__sizeId__', size.id)
                        .replaceAll('__sizeName__', size.name)
                        .replaceAll('__sku__', sku)
                        .replaceAll('__price__', price)
                        .replaceAll('__stock__', stock)
                        .replaceAll('__activeValue__', active ? 'true' : 'false')
                        .replaceAll('__activeText__', active ? "Đang bật" : "Đang tắt")
                        .replaceAll('__newBadgeClass__', existing ? "d-none" : "d-inline-block");

                    const tr = document.createElement('tbody');
                    tr.innerHTML = html.trim();
                    variantBody.appendChild(tr.firstChild);
                    index++;
                    visible++;
                });
            });

            variantPrompt.classList.toggle('d-none', visible > 0);
            refreshSizeGuide();
            initMoneyInputs();
            wireVariantActiveToggles();
        }

        function wireVariantActiveToggles() {
            variantBody.querySelectorAll('tr[data-row]').forEach(tr => {
                const cb = tr.querySelector('.variant-active-checkbox');
                const hiddenFalse = tr.querySelector('.variant-active-false');
                const txt = tr.querySelector('.variant-active-text');
                if (!cb || !hiddenFalse || !txt) return;

                // Ensure initial checked state from dataset (server/DB-driven)
                const raw = tr.dataset.active;
                const isActive = raw === 'true' || raw === '1' || raw === 'True' || raw === 'TRUE';
                cb.checked = isActive;
                hiddenFalse.disabled = isActive;
                txt.textContent = isActive ? 'Đang bật' : 'Đang tắt';

                if (cb.dataset.wired === '1') return;
                cb.dataset.wired = '1';
                cb.addEventListener('change', () => {
                    hiddenFalse.disabled = cb.checked;
                    txt.textContent = cb.checked ? 'Đang bật' : 'Đang tắt';

                    const cid = tr.dataset.colorId;
                    const sid = tr.dataset.sizeId;
                    const key = `${cid}-${sid}`;
                    const prev = currentInputs.get(key) || {};
                    currentInputs.set(key, { ...prev, active: cb.checked });

                    // Keep row dataset in sync (useful if UI re-renders)
                    tr.dataset.active = cb.checked ? 'true' : 'false';
                });
            });
        }

        // ── Size Guide ──
        const sgBody = document.getElementById('sizeGuideBody');
        const sgPrompt = document.getElementById('sizeGuideEmptyPrompt');
        const sgTable = document.getElementById('sizeGuideTableWrap');
        const sgSel = document.getElementById('sizeGuideSchemeSelect');

        function refreshSizeGuide() {
            const sizes = getSelectedSizes();
            const tpl = document.getElementById('sizeGuideRowTemplate');
            
            // Save current guide inputs
            sgBody.querySelectorAll('tr[data-sg-row]').forEach(tr => {
                const label = tr.dataset.sizeLabel;
                const read = (suffix) => tr.querySelector(`input[name$=".${suffix}"]`)?.value || "";
                guideDataMap.set(label, {
                    sizeLabel: label,
                    heightRange: read('HeightRange'),
                    weightRange: read('WeightRange'),
                    shoulderWidth: read('ShoulderWidth'),
                    bust: read('Bust'),
                    waist: read('Waist'),
                    hip: read('Hip'),
                    clothingLength: read('ClothingLength'),
                    shoeLength: read('ShoeLength'),
                    note: read('Note')
                });
            });

            sgBody.innerHTML = '';
            if (sizes.length === 0) {
                sgPrompt.classList.remove('d-none');
                sgTable.classList.add('d-none');
                return;
            }
            sgPrompt.classList.add('d-none');
            sgTable.classList.remove('d-none');

            sizes.forEach((size, idx) => {
                const data = guideDataMap.get(size.name) || {};
                let html = tpl.innerHTML
                    .replaceAll('__index__', idx)
                    .replaceAll('__sizeLabel__', size.name)
                    .replaceAll('__h__', data.heightRange || data.HeightRange || "")
                    .replaceAll('__w__', data.weightRange || data.WeightRange || "")
                    .replaceAll('__sh__', data.shoulderWidth || data.ShoulderWidth || "")
                    .replaceAll('__bu__', data.bust || data.Bust || "")
                    .replaceAll('__wa__', data.waist || data.Waist || "")
                    .replaceAll('__hi__', data.hip || data.Hip || "")
                    .replaceAll('__le__', data.clothingLength || data.ClothingLength || "")
                    .replaceAll('__sl__', data.shoeLength || data.ShoeLength || "")
                    .replaceAll('__no__', data.note || data.Note || "");
                
                const tr = document.createElement('tbody');
                tr.innerHTML = html.trim();
                sgBody.appendChild(tr.firstChild);
            });
            updateSgColumns();
        }

        function updateSgColumns() {
            const m = sgSel.value;
            const cols = sgTable.querySelectorAll('[class*="sg-col-"]');
            cols.forEach(el => {
                if (m === 'all') el.classList.remove('d-none');
                else el.classList.toggle('d-none', !el.classList.contains(`sg-col-${m}`));
            });
        }

        function autoDetectScheme() {
            const selects = Array.from(document.getElementById('categoryCascader').querySelectorAll('select'));
            const full = selects.map(s => s.options[s.selectedIndex]?.text || "").join(" ").toLowerCase();
            
            let detectedMode = "all";
            
            // 1. Try detect from existing variants first
            const existingKinds = Array.from(sizePickerGrid.querySelectorAll('.size-checkbox:checked'))
                .map(cb => cb.closest('.size-item-wrapper').dataset.sizeKind);
            
            if (existingKinds.length > 0) {
                // Find most frequent kind
                const counts = {};
                existingKinds.forEach(k => counts[k] = (counts[k] || 0) + 1);
                detectedMode = Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b);
            } else {
                // 2. Fallback to category name
                if (full.includes("áo") || full.includes("quần") || full.includes("shirt") || full.includes("pants") || full.includes("thời trang")) detectedMode = "clothing";
                else if (full.includes("giày") || full.includes("dép") || full.includes("shoe")) detectedMode = "shoe";
                else if (full.includes("mỹ phẩm") || full.includes("nước hoa") || full.includes("dịch") || full.includes("kem")) detectedMode = "volume";
                else if (full.includes("thực phẩm") || full.includes("bột") || full.includes("hạt")) detectedMode = "weight";
            }
            
            let sgValue = "all";
            if (detectedMode === "clothing") {
                if (full.includes("quần") || full.includes("pants")) sgValue = "quan";
                else sgValue = "ao";
            } else if (detectedMode === "shoe") {
                sgValue = "shoe";
            }
            
            sgSel.value = sgValue;
            updateSgColumns();

            // Also update size picker mode
            const modeMap = { clothing: 'sizeClothing', shoe: 'sizeShoe', volume: 'sizeVolume', weight: 'sizeWeight', all: 'sizeOther' };
            const rbId = modeMap[detectedMode] || 'sizeOther';
            const rb = document.getElementById(rbId);
            if (rb) rb.checked = true;

            renderSizePicker();
            refreshVariants(); 
        }

        // ── Currency Logic ──
        function initMoneyInputs() {
            const fmt = v => {
                if (!v) return "";
                let pts = v.toString().split('.');
                pts[0] = pts[0].replace(/\D/g, "").replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                return pts.length > 1 ? pts[0] + "," + pts[1] : pts[0];
            };
            document.querySelectorAll('.vn-money-input').forEach(i => {
                if (i.dataset.init) return;
                i.dataset.init = "1";
                if (i.value) { i.dataset.original = i.value.replace(/\./g, "").replace(/,/g, "."); i.value = fmt(i.dataset.original); }
                i.addEventListener('input', function() {
                    let raw = this.value.replace(/\./g, "").replace(/,/g, ".");
                    this.dataset.original = raw;
                    let cursor = this.selectionStart, oldLen = this.value.length;
                    this.value = fmt(raw);
                    let newLen = this.value.length;
                    this.setSelectionRange(cursor + (newLen - oldLen), cursor + (newLen - oldLen));
                });
            });
        }

        // ── Init ──
        renderSizePicker();
        
        // Auto-check based on existing variants
        existingVariants.forEach(v => {
            const cid = v.colorId || v.ColorId;
            if (cid) {
                const cb = document.getElementById(`color_${cid}`);
                if (cb) cb.checked = true;
            }
        });

        colorChecks.forEach(c => c.addEventListener('change', refreshVariants));
        sizeModeRadios.forEach(r => r.addEventListener('change', renderSizePicker));
        sgSel.addEventListener('change', updateSgColumns);
        
        // Final Init Sequence
        initCategoryCascade().then(() => {
            autoDetectScheme(); // This calls renderSizePicker and refreshVariants
        });

        document.getElementById('vp-form').addEventListener('submit', () => {
            document.querySelectorAll('.vn-money-input').forEach(i => {
                i.value = i.dataset.original || i.value.replace(/\./g, "").replace(/,/g, ".");
            });
        });
    })();
    </script>
}
