@model DOAN_BANHANG.ViewModels.ProductAdminUpsertVm
@using DOAN_BANHANG.Helpers

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body bg-primary-subtle border-start border-4 border-primary">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar-sm rounded bg-primary text-white d-inline-flex align-items-center justify-content-center">
                            <i class="bx bx-plus-circle font-size-18"></i>
                        </span>
                        <div>
                            <h4 class="mb-0">Thêm sản phẩm mới (Đa ngành hàng)</h4>
                            <div class="text-muted small">Thiết lập thông tin, thương hiệu, thông số kỹ thuật EAV, phân loại biến thể 2 tầng và đóng gói GHN</div>
                        </div>
                    </div>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                            <li class="breadcrumb-item active">Thêm mới</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="admin-product-create-form" asp-area="Admin" asp-controller="Products" asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UseDynamicOptions" id="UseDynamicOptionsInput" value="true" />
    <input type="hidden" asp-for="HasSizeGuide" id="HasSizeGuideInput" />

    <div class="row">
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden sticky-top" style="top: 20px; z-index: 100;">
                <div class="card-header bg-primary-subtle border-0 border-start border-4 border-primary">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar-xs">
                            <span class="avatar-title rounded-circle bg-primary text-white">
                                <i class="bx bx-slider-alt"></i>
                            </span>
                        </span>
                        <div>
                            <div class="fw-semibold">Thiết lập sản phẩm</div>
                            <div class="text-muted small">Chọn bước để nhập dữ liệu</div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="nav flex-column nav-pills gap-1" id="admin-product-create-menu" role="tablist" aria-orientation="vertical">
                        <button type="button" data-tab="info" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2 active" role="tab" aria-selected="true">
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">1</span>
                            <i class="bx bx-info-circle"></i>
                            <span>Thông tin cơ bản</span>
                        </button>
                        <button type="button" data-tab="classify" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab" aria-selected="false">
                            <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle">2</span>
                            <i class="bx bx-category-alt"></i>
                            <span>Danh mục & Thông số</span>
                        </button>
                        <button type="button" data-tab="images" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab" aria-selected="false">
                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle">3</span>
                            <i class="bx bx-image"></i>
                            <span>Hình ảnh</span>
                        </button>
                        <button type="button" data-tab="variants" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab" aria-selected="false">
                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle">4</span>
                            <i class="bx bx-layer"></i>
                            <span>Biến thể & Giao vận</span>
                        </button>
                        <button type="button" data-tab="specs" id="tabBtnSizeGuide" class="nav-link text-start waves-effect fw-semibold align-items-center gap-2 @(Model.HasSizeGuide ? "d-flex" : "d-none")" role="tab" aria-selected="false">
                            <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">5</span>
                            <i class="bx bx-ruler"></i>
                            <span>Bảng Size Guide</span>
                        </button>
                    </div>

                    <hr class="my-4" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary fw-semibold py-2 shadow-sm">
                            <i class="bx bx-check-circle me-1"></i>Tạo sản phẩm
                        </button>
                        <a class="btn btn-soft-secondary" asp-area="Admin" asp-controller="Products" asp-action="Index">
                            <i class="bx bx-left-arrow-alt me-1"></i>Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger mb-3" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <!-- TAB 1: THÔNG TIN CƠ BẢN -->
                    <div class="admin-product-create-pane" data-pane="info">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-primary-subtle border border-primary-subtle rounded-3 p-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-xs">
                                    <span class="avatar-title rounded-circle bg-primary text-white">
                                        <i class="bx bx-info-circle"></i>
                                    </span>
                                </span>
                                <div>
                                    <h4 class="card-title mb-0 fs-5">Thông tin cơ bản & Chính sách</h4>
                                    <div class="text-muted small">Tên sản phẩm, thương hiệu, giá bán, bảo hành và chính sách đổi trả</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control form-control-lg fw-semibold" placeholder="Ví dụ: Điện thoại iPhone 16 Pro Max 256GB / Áo thun Polo nam..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Slug (URL)</label>
                                <input asp-for="Slug" class="form-control" placeholder="(Tự tạo nếu bỏ trống)" />
                                <span asp-validation-for="Slug" class="text-danger"></span>
                            </div>
                            <div class="col-md-8 mb-3">
                                <!-- HIỂN THỊ KHI LÀ SẢN PHẨM ĐƠN (1 BIẾN THỂ) -->
                                <div id="tab1SinglePriceWrap" class="row g-2 @(Model.HasSizeVariants ? "d-none" : "")">
                                    <div class="col-md-4">
                                        <label class="form-label">Giá niêm yết (₫) <span class="text-danger">*</span></label>
                                        <input asp-for="Price" id="BasePriceInput" class="form-control vn-money-input fw-bold" type="text" placeholder="Ví dụ: 250.000" />
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Giá vốn nhập kho (₫)</label>
                                        <input asp-for="SingleCostPrice" id="BaseCostPriceInput" class="form-control vn-money-input text-primary fw-bold" type="text" placeholder="Ví dụ: 150.000" />
                                        <span asp-validation-for="SingleCostPrice" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Giá khuyến mãi (₫)</label>
                                        <input asp-for="SalePrice" id="BaseSalePriceInput" class="form-control vn-money-input text-danger fw-bold" type="text" placeholder="Ví dụ: 199.000" />
                                        <span asp-validation-for="SalePrice" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- HIỂN THỊ KHI LÀ SẢN PHẨM NHIỀU BIẾN THỂ -->
                                <div id="tab1MultiPriceSummaryWrap" class="card border-success bg-success-subtle bg-opacity-25 shadow-none mb-0 @(!Model.HasSizeVariants ? "d-none" : "")">
                                    <div class="card-body py-2.5 px-3">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-success text-white"><i class="bx bx-git-branch me-1"></i>Đang bật Nhiều biến thể</span>
                                                    <span class="small fw-bold text-dark" id="tab1SummaryCountText">@Model.Variants.Count biến thể</span>
                                                </div>
                                                <div class="small text-muted mt-1">
                                                    Giá bán: <strong class="text-danger" id="tab1SummaryPriceRange">—</strong>
                                                    <span class="mx-1">•</span>
                                                    Giá vốn: <strong class="text-primary" id="tab1SummaryCostRange">—</strong>
                                                    <span class="mx-1">•</span>
                                                    Tổng kho: <strong class="text-dark" id="tab1SummaryTotalStock">0</strong>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-success fw-semibold" id="btnJumpToVariantsTab">
                                                <i class="bx bx-layer me-1"></i>Thiết lập giá từng biến thể (Mục 4)
                                            </button>
                                        </div>
                                        <div class="mt-2 pt-2 border-top border-success-subtle" id="tab1VariantMiniList" style="max-height: 155px; overflow-y: auto;"></div>
                                    </div>
                                </div>

                                <partial name="_LivePricingEstimator" />
                            </div>
                        </div>

                        <div class="row bg-light rounded-3 p-3 mb-3 border">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="form-label"><i class="bx bx-award text-primary me-1"></i>Thương hiệu (Brand)</label>
                                <select asp-for="BrandId" class="form-select">
                                    <option value="">-- Không có thương hiệu (No Brand) --</option>
                                    @foreach (var b in Model.BrandOptions)
                                    {
                                        <option value="@b.Value" selected="@(Model.BrandId == b.Value)">@b.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="form-label"><i class="bx bx-shield-quarter text-success me-1"></i>Thời hạn bảo hành (Tháng)</label>
                                <div class="input-group">
                                    <input asp-for="WarrantyMonths" type="number" min="0" max="120" class="form-control" placeholder="0 = Không BH" />
                                    <span class="input-group-text">tháng</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Hình thức bảo hành</label>
                                <input asp-for="WarrantyType" class="form-control" list="warrantyTypeSuggestions" placeholder="VD: Bảo hành điện tử chính hãng" />
                                <datalist id="warrantyTypeSuggestions">
                                    <option value="Bảo hành chính hãng"></option>
                                    <option value="Bảo hành điện tử"></option>
                                    <option value="Bảo hành tại Shop"></option>
                                    <option value="Không bảo hành"></option>
                                </datalist>
                            </div>
                            <div class="col-12 mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-semibold"><i class="bx bx-revision text-info me-1"></i>Chính sách Đổi trả / Hoàn tiền</div>
                                    <div class="text-muted small">Tắt tùy chọn này đối với thực phẩm tươi sống, hàng đặt riêng hoặc ngành hàng không hỗ trợ đổi trả.</div>
                                </div>
                                <div class="form-check form-switch fs-5 mb-0">
                                    <input asp-for="IsReturnable" class="form-check-input" type="checkbox" id="IsReturnableInput" />
                                    <label class="form-check-label fs-6 fw-semibold" for="IsReturnableInput">Cho phép trả hàng</label>
                                </div>
                            </div>
                        </div>

                        <!-- KHỐI ĐA NGÀNH MỞ RỘNG: SẢN PHẨM SỐ (E-VOUCHER), HẠN SỬ DỤNG & ĐIỀU KIỆN VẬN CHUYỂN -->
                        <div class="row bg-warning-subtle bg-opacity-25 rounded-3 p-3 mb-3 border border-warning-subtle">
                            <div class="col-12 mb-2 d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="fw-bold text-dark"><i class="bx bx-cloud-download text-primary me-1"></i>Sản phẩm số / E-Voucher / Dịch vụ (Không qua giao vận GHN)</div>
                                    <div class="text-muted small">Khi bật: Miễn phí ship (0₫), chặn COD, tự động hoàn tất đơn & gửi Mã kích hoạt / Link tải cho khách ngay khi thanh toán Ví hoặc VNPay.</div>
                                </div>
                                <div class="form-check form-switch fs-5 mb-0">
                                    <input asp-for="IsDigital" class="form-check-input" type="checkbox" id="IsDigitalInput" onchange="document.getElementById('digitalContentWrap').classList.toggle('d-none', !this.checked)" />
                                    <label class="form-check-label fs-6 fw-semibold text-primary" for="IsDigitalInput">Là Sản phẩm số</label>
                                </div>
                            </div>
                            <div class="col-12 mb-3 @(Model.IsDigital ? "" : "d-none")" id="digitalContentWrap">
                                <label class="form-label text-primary fw-bold">Mã Code / Link tải / Nội dung E-Voucher bàn giao tự động</label>
                                <input asp-for="DigitalContent" class="form-control border-primary" placeholder="VD: KEY-WIN11-PRO-XXXX hoặc https://drive.google.com/... (Tự động gửi vào Thông báo & Chi tiết đơn của khách)" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label"><i class="bx bx-package text-warning me-1"></i>Điều kiện vận chuyển GHN</label>
                                <select asp-for="ShippingCondition" class="form-select">
                                    <option value="Tiêu chuẩn">Tiêu chuẩn (Hàng thông thường)</option>
                                    <option value="Hàng dễ vỡ">Hàng dễ vỡ (Tự động gắn nhãn GHN)</option>
                                    <option value="Thực phẩm / Bảo quản mát">Thực phẩm khô / Bảo quản mát</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="bx bx-calendar text-secondary me-1"></i>Ngày sản xuất (NSX - Tùy chọn)</label>
                                <input asp-for="ManufacturingDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><i class="bx bx-time-five text-danger me-1"></i>Hạn sử dụng (HSD - Thực phẩm/Mỹ phẩm)</label>
                                <input asp-for="ExpiryDate" type="date" class="form-control" />
                                <div class="form-text small">Hệ thống sẽ cảnh báo xả kho Flash Sale trước 30 ngày.</div>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label">Mô tả chi tiết sản phẩm</label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Mô tả đặc điểm nổi bật, công dụng, hướng dẫn sử dụng..."></textarea>
                        </div>
                    </div>

                    <!-- TAB 2: DANH MỤC & THÔNG SỐ KỸ THUẬT EAV -->
                    <div class="admin-product-create-pane d-none" data-pane="classify">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-info-subtle border border-info-subtle rounded-3 p-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-xs">
                                    <span class="avatar-title rounded-circle bg-info text-white">
                                        <i class="bx bx-category-alt"></i>
                                    </span>
                                </span>
                                <div>
                                    <h4 class="card-title mb-0 fs-5">Danh mục Ngành hàng & Thông số kỹ thuật</h4>
                                    <div class="text-muted small">Chọn danh mục để hệ thống tự động tải bộ thuộc tính kỹ thuật của ngành</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Phân loại danh mục <span class="text-danger">*</span></label>
                            <input type="hidden" asp-for="CategoryId" id="finalCategoryId" />
                            <div id="categoryCascader" class="d-flex flex-wrap gap-2"></div>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                            <div class="mt-2 text-muted small" id="categoryBreadcrumb"></div>
                        </div>

                        <!-- BẢNG THÔNG SỐ KỸ THUẬT ĐỘNG (EAV) -->
                        <div class="card border shadow-none mb-4">
                            <div class="card-header bg-light d-flex align-items-center justify-content-between py-2">
                                <div class="fw-bold text-dark">
                                    <i class="bx bx-list-check text-primary me-1"></i>Thông số kỹ thuật theo ngành (Category Attributes)
                                </div>
                                <span class="badge bg-info-subtle text-info-emphasis" id="eavAttributeCountBadge">0 thuộc tính</span>
                            </div>
                            <div class="card-body" id="eavAttributesContainer">
                                <div class="text-muted small text-center py-3">
                                    Hãy chọn danh mục ngành hàng ở trên để hiển thị các ô nhập thông số kỹ thuật tương ứng (VD: RAM, CPU, Xuất xứ, Hạn sử dụng...).
                                </div>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label">Trạng thái hiển thị</label>
                            <select asp-for="Status" class="form-select">
                                @foreach (var s in Model.StatusOptions)
                                {
                                    if (!string.IsNullOrWhiteSpace(s.ValueString))
                                    {
                                        <option value="@s.ValueString" selected="@(Model.Status == s.ValueString)">@s.Label</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- TAB 3: HÌNH ẢNH -->
                    <div class="admin-product-create-pane d-none" data-pane="images">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-warning-subtle border border-warning-subtle rounded-3 p-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-xs">
                                    <span class="avatar-title rounded-circle bg-warning text-dark">
                                        <i class="bx bx-image"></i>
                                    </span>
                                </span>
                                <div>
                                    <h4 class="card-title mb-0 fs-5">Hình ảnh sản phẩm</h4>
                                    <div class="text-muted small">Ảnh đại diện chính và bộ sưu tập ảnh</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Ảnh chính</label>
                            <div class="row">
                                <div class="col-md-7 col-lg-5 mx-auto">
                                    <input class="d-none" type="file" name="PrimaryImage" id="primaryImageInput" accept="image/*" />
                                    <div class="admin-image-box" id="primaryImageBox" role="button" tabindex="0">
                                        <div class="admin-image-box__empty" id="primaryImageEmpty">
                                            <div class="fw-semibold">Chọn ảnh đại diện</div>
                                            <div class="text-muted small">Tỉ lệ khuyến nghị 1:1</div>
                                            <button type="button" class="btn btn-sm btn-soft-primary mt-2" id="primaryChooseBtn">Chọn ảnh</button>
                                        </div>
                                        <img id="primaryImagePreviewImg" class="admin-image-box__img d-none" alt="Primary preview" />
                                        <div class="admin-image-box__overlay" id="primaryImageOverlay">
                                            <button type="button" class="btn btn-sm btn-soft-light" id="primaryOverlayChangeBtn">Đổi</button>
                                            <button type="button" class="btn btn-sm btn-danger" id="primaryOverlayRemoveBtn">Xóa</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-0">
                            <div class="d-flex align-items-center justify-content-between">
                                <label class="form-label mb-0">Ảnh phụ (Gallery)</label>
                                <button type="button" class="btn btn-sm btn-soft-primary" id="contentAddManyBtn">Thêm nhiều ảnh</button>
                            </div>
                            <input class="d-none" type="file" name="ContentImages" id="contentImagesMaster" multiple accept="image/*" />
                            <input class="d-none" type="file" id="contentImagesPickerMany" multiple accept="image/*" />
                            <input class="d-none" type="file" id="contentImagesPickerSingle" accept="image/*" />
                            <div class="form-text mb-2">Bấm vào từng ô để thêm 1 ảnh, hoặc “Thêm nhiều ảnh” để chọn nhiều ảnh 1 lần.</div>
                            <div class="admin-image-strip" id="contentSlots"></div>
                        </div>
                    </div>

                    <!-- TAB 4: BIẾN THỂ ĐỘNG 2 TẦNG & ĐÓNG GÓI GHN -->
                    <div class="admin-product-create-pane d-none" data-pane="variants">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-success-subtle border border-success-subtle rounded-3 p-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar-xs">
                                    <span class="avatar-title rounded-circle bg-success text-white">
                                        <i class="bx bx-layer"></i>
                                    </span>
                                </span>
                                <div>
                                    <h4 class="card-title mb-0 fs-5">Phân loại Biến thể & Đóng gói Giao vận (GHN)</h4>
                                    <div class="text-muted small">Hỗ trợ sản phẩm đơn hoặc phân loại động 2 tầng (Màu sắc, Dung lượng, Hương vị, Kích cỡ...)</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Kiểu sản phẩm</label>
                            <div class="btn-group admin-seg-toggle" role="group">
