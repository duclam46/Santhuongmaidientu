@model DOAN_BANHANG.ViewModels.ProductAdminUpsertVm
@using DOAN_BANHANG.Helpers

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body bg-primary-subtle border-start border-4 border-primary">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar-sm rounded bg-primary text-white d-inline-flex align-items-center justify-content-center">
                            <i class="bx bx-plus-circle font-size-18"></i>
                        </span>
                        <div>
                            <h4 class="mb-0">Thêm sản phẩm mới</h4>
                            <div class="text-muted small">Nhập thông tin, phân loại, hình ảnh và tồn kho</div>
                        </div>
                    </div>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                            <li class="breadcrumb-item active">Thêm mới</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="admin-product-create-form" asp-area="Admin" asp-controller="Products" asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-primary-subtle border-0 border-start border-4 border-primary">
                    <div class="d-flex align-items-center gap-2">
                        <span class="avatar-xs">
                            <span class="avatar-title rounded-circle bg-primary text-white">
                                <i class="bx bx-slider-alt"></i>
                            </span>
                        </span>
                        <div>
                            <div class="fw-semibold">Thiết lập sản phẩm</div>
                            <div class="text-muted small">Chọn bước để nhập dữ liệu</div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="nav flex-column nav-pills gap-1" id="admin-product-create-menu" role="tablist" aria-orientation="vertical">
                        <button type="button" data-tab="info" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2 active" role="tab" aria-selected="true">
                            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis border border-primary-subtle">1</span>
                            <i class="bx bx-info-circle"></i>
                            <span>Thông tin</span>
                        </button>
                        <button type="button" data-tab="classify" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab" aria-selected="false">
                            <span class="badge rounded-pill bg-info-subtle text-info-emphasis border border-info-subtle">2</span>
                            <i class="bx bx-category-alt"></i>
                            <span>Phân loại</span>
                        </button>
                        <button type="button" data-tab="images" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab" aria-selected="false">
                            <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle">3</span>
                            <i class="bx bx-image"></i>
                            <span>Hình ảnh</span>
                        </button>
                        <button type="button" data-tab="variants" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab" aria-selected="false">
                            <span class="badge rounded-pill bg-success-subtle text-success-emphasis border border-success-subtle">4</span>
                            <i class="bx bx-layer"></i>
                            <span>Biến thể & tồn kho</span>
                        </button>
                        <button type="button" data-tab="specs" class="nav-link text-start waves-effect fw-semibold d-flex align-items-center gap-2" role="tab" aria-selected="false">
                            <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">5</span>
                            <i class="bx bx-ruler"></i>
                            <span>Size guide</span>
                        </button>
                    </div>

                    <hr class="my-4" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-soft-primary">
                            <i class="bx bx-check-circle me-1"></i>Tạo sản phẩm
                        </button>
                        <a class="btn btn-soft-secondary" asp-area="Admin" asp-controller="Products" asp-action="Index">
                            <i class="bx bx-left-arrow-alt me-1"></i>Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="avatar-xs">
                                <span class="avatar-title rounded-circle bg-light text-primary border border-primary-subtle">
                                    <i class="bx bx-edit-alt"></i>
                                </span>
                            </span>
                            <div class="fw-semibold">Nhập dữ liệu</div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill">Tạo mới</span>
                    </div>
                </div>
                <div class="card-body p-4">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="admin-product-create-pane" data-pane="info">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-primary-subtle border border-primary-subtle rounded-3 p-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar-xs">
                                            <span class="avatar-title rounded-circle bg-primary text-white">
                                                <i class="bx bx-info-circle"></i>
                                            </span>
                                        </span>
                                        <div>
                                            <h4 class="card-title mb-0 fs-4">Thông tin sản phẩm</h4>
                                            <div class="text-muted small">Tên, slug và mô tả</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Tên sản phẩm</label>
                                    <input asp-for="Name" class="form-control" placeholder="Ví dụ: Áo thun nam..." />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Slug</label>
                                        <input asp-for="Slug" class="form-control" placeholder="(Tự tạo nếu bỏ trống)" />
                                        <span asp-validation-for="Slug" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Giá bán (₫)</label>
                                        <input asp-for="Price" class="form-control vn-money-input" type="text" placeholder="Ví dụ: 250.000" />
                                        <span asp-validation-for="Price" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Giá giảm (₫)</label>
                                        <input asp-for="SalePrice" class="form-control vn-money-input" type="text" placeholder="Ví dụ: 199.000" />
                                        <span asp-validation-for="SalePrice" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="mb-0">
                                    <label class="form-label">Mô tả</label>
                                    <textarea asp-for="Description" class="form-control" rows="6" placeholder="Mô tả chi tiết..."></textarea>
                                </div>
                            </div>

                            <div class="admin-product-create-pane d-none" data-pane="classify">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-info-subtle border border-info-subtle rounded-3 p-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar-xs">
                                            <span class="avatar-title rounded-circle bg-info text-white">
                                                <i class="bx bx-category-alt"></i>
                                            </span>
                                        </span>
                                        <div>
                                            <h4 class="card-title mb-0 fs-4">Phân loại & trạng thái</h4>
                                            <div class="text-muted small">Danh mục và trạng thái hiển thị</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Phân loại danh mục</label>
                                    <input type="hidden" asp-for="CategoryId" id="finalCategoryId" />
                                    <div id="categoryCascader" class="d-flex flex-wrap gap-2">
                                        <!-- Selects will be generated here -->
                                    </div>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                    <div class="mt-2 text-muted small" id="categoryBreadcrumb"></div>
                                </div>

                                <div class="mb-0">
                                    <label class="form-label">Trạng thái</label>
                                    <select asp-for="Status" class="form-select">
                                        @foreach (var s in Model.StatusOptions)
                                        {
                                            if (!string.IsNullOrWhiteSpace(s.ValueString))
                                            {
                                                <option value="@s.ValueString" selected="@(Model.Status == s.ValueString)">@s.Label</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="admin-product-create-pane d-none" data-pane="images">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-warning-subtle border border-warning-subtle rounded-3 p-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar-xs">
                                            <span class="avatar-title rounded-circle bg-warning text-dark">
                                                <i class="bx bx-image"></i>
                                            </span>
                                        </span>
                                        <div>
                                            <h4 class="card-title mb-0 fs-4">Hình ảnh</h4>
                                            <div class="text-muted small">Ảnh chính và gallery</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Ảnh chính</label>
                                    <div class="row">
                                        <div class="col-md-7 col-lg-6 mx-auto">
                                            <input class="d-none" type="file" name="PrimaryImage" id="primaryImageInput" accept="image/*" />

                                            <div class="admin-image-box" id="primaryImageBox" role="button" tabindex="0" aria-label="Chọn ảnh chính">
                                                <div class="admin-image-box__empty" id="primaryImageEmpty">
                                                    <div class="fw-semibold">Chọn ảnh</div>
                                                    <div class="text-muted small">Ảnh đại diện sản phẩm</div>
                                                    <button type="button" class="btn btn-sm btn-soft-primary mt-2" id="primaryChooseBtn">Chọn ảnh</button>
                                                </div>
                                                <img id="primaryImagePreviewImg" class="admin-image-box__img d-none" alt="Primary preview" />

                                                <div class="admin-image-box__overlay" id="primaryImageOverlay">
                                                    <button type="button" class="btn btn-sm btn-soft-light" id="primaryOverlayChangeBtn">Đổi</button>
                                                    <button type="button" class="btn btn-sm btn-danger" id="primaryOverlayRemoveBtn">Xóa</button>
                                                </div>
                                            </div>

                                            <div class="form-text">Ảnh này hiển thị ở danh sách/thumbnail.</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-0">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <label class="form-label mb-0">Ảnh phụ (gallery)</label>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-soft-primary" id="contentAddManyBtn">Thêm nhiều ảnh</button>
                                        </div>
                                    </div>

                                    <input class="d-none" type="file" name="ContentImages" id="contentImagesMaster" multiple accept="image/*" />
                                    <input class="d-none" type="file" id="contentImagesPickerMany" multiple accept="image/*" />
                                    <input class="d-none" type="file" id="contentImagesPickerSingle" accept="image/*" />

                                    <div class="form-text mb-2">Bấm vào từng ô để thêm 1 ảnh, hoặc “Thêm nhiều ảnh” để chọn nhiều ảnh 1 lần.</div>

                                    <div class="admin-image-strip" id="contentSlots"></div>
                                </div>
                            </div>

                            <div class="admin-product-create-pane d-none" data-pane="variants">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 bg-success-subtle border border-success-subtle rounded-3 p-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar-xs">
                                            <span class="avatar-title rounded-circle bg-success text-white">
                                                <i class="bx bx-layer"></i>
                                            </span>
                                        </span>
                                        <div>
                                            <h4 class="card-title mb-0 fs-4">Biến thể & tồn kho</h4>
                                            <div class="text-muted small">Màu sắc, quy cách và số lượng</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Màu sắc</label>

                                    @if (Model.ColorOptions != null && Model.ColorOptions.Count > 0)
                                    {
                                        <div class="admin-color-grid" aria-label="Chọn màu sắc">
                                            @foreach (var opt in Model.ColorOptions)
                                            {
                                                var checkedColor = Model.SelectedColorIds != null && Model.SelectedColorIds.Contains(opt.Value);
                                                var hasIcon = ColorUi.TryGetColorIconUrl(opt.Label, out var iconUrl);
                                                var hex = string.IsNullOrWhiteSpace(opt.Hex) ? "#D0D5DD" : opt.Hex;

                                                <input class="btn-check" type="checkbox" name="SelectedColorIds" value="@opt.Value" id="color_@opt.Value" checked="@(checkedColor ? "checked" : null)" autocomplete="off" />
                                                <label class="admin-color-tile" for="color_@opt.Value" title="@opt.Label" data-color-name="@opt.Label">
                                                    @if (hasIcon)
                                                    {
                                                        <img src="@iconUrl" alt="@opt.Label" class="admin-color-icon" />
                                                    }
                                                    else
                                                    {
                                                        <span class="admin-color-swatch" style="--swatch:@hex" aria-hidden="true"></span>
                                                    }
                                                    <span class="admin-color-name">@opt.Label</span>
                                                </label>
                                            }
                                        </div>
                                        <div class="form-text">Nếu không chọn màu, hệ thống sẽ tạo biến thể không có màu (Màu -).</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">Chưa có màu. Hãy thêm dữ liệu vào bảng <span class="fw-semibold">Colors</span>.</div>
                                    }
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Kiểu biến thể / tồn kho</label>
                                    <div class="btn-group admin-seg-toggle" role="group" aria-label="Kiểu biến thể">
                                        <input class="btn-check" type="radio" asp-for="HasSizeVariants" id="HasSizeVariantsTrue" value="true" />
                                        <label class="btn btn-outline-primary admin-seg-btn" for="HasSizeVariantsTrue">Nhiều biến thể</label>

                                        <input class="btn-check" type="radio" asp-for="HasSizeVariants" id="HasSizeVariantsFalse" value="false" />
                                        <label class="btn btn-outline-primary admin-seg-btn" for="HasSizeVariantsFalse">Một biến thể</label>
                                    </div>
                                    <div class="form-text">SKU sẽ tự tạo theo dạng <span class="fw-semibold">ProductId-Option</span> (hoặc <span class="fw-semibold">ProductId</span> nếu 1 biến thể).</div>
                                </div>

                                <div class="mb-4" id="singleStockWrap">
                                    <label class="form-label">Số lượng tồn kho</label>
                                    <input asp-for="SingleStockQuantity" class="form-control" type="number" min="0" />
                                    <span asp-validation-for="SingleStockQuantity" class="text-danger"></span>
                                </div>

                                <div class="mb-3" id="sizeSchemeWrap">
                                    <label class="form-label">Quy cách (size / dung tích / khối lượng)</label>
                                    <select asp-for="SizeScheme" class="form-select" id="sizeSchemeSelect">
                                        <option value="clothing">Quần áo: size chữ (XS/S/M/L/XL...)</option>
                                        <option value="shoe">Giày dép: size số (38/39/40...)</option>
                                        <option value="volume">Mỹ phẩm dạng nước: ml (30ml/50ml...)</option>
                                        <option value="weight">Dạng bột/khối: g/kg (100g/1kg...)</option>
                                        <option value="all">Hiển thị tất cả</option>
                                    </select>
                                    <div class="form-text">Với quy cách <span class="fw-semibold">ml</span>, bạn có thể nhập theo từng dòng bên dưới (hệ thống sẽ tự tạo option nếu chưa có).</div>
                                </div>

                                <div class="mb-3 d-none" id="shoePickerWrap">
                                    <label class="form-label">Chọn size giày</label>
                                    <div class="d-flex flex-wrap gap-2" id="shoePickerGrid"></div>
                                    <div class="form-text">Chọn size trước, sau đó nhập số lượng cho các size đã chọn.</div>
                                </div>

                                <div class="mb-4 d-none" id="volumeOptionsWrap">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h5 class="mb-0" id="customOptionTitle">Tồn kho theo quy cách tùy chỉnh</h5>
                                        <button type="button" class="btn btn-sm btn-outline-primary" id="volumeAddRowBtn">Thêm dòng</button>
                                    </div>
                                    <div class="text-muted mb-2">Nhập ví dụ: 50ml, 100ml, 1kg... (SKU tự tạo theo dạng ProductId-Option)</div>

                                    <div class="mb-4" id="volumeSamples">
                                        <div class="fw-semibold small text-primary mb-2"><i class="bx bx-droplet me-1"></i>Gợi ý dung tích:</div>
                                        <div class="admin-size-grid mb-3">
                                            <button type="button" class="admin-size-tile" data-sample="30ml">30ml</button>
                                            <button type="button" class="admin-size-tile" data-sample="50ml">50ml</button>
                                            <button type="button" class="admin-size-tile" data-sample="100ml">100ml</button>
                                            <button type="button" class="admin-size-tile" data-sample="200ml">200ml</button>
                                            <button type="button" class="admin-size-tile" data-sample="500ml">500ml</button>
                                            <button type="button" class="admin-size-tile" data-sample="1L">1L</button>
                                        </div>
                                    </div>

                                    <div class="mb-4 d-none" id="weightSamples">
                                        <div class="fw-semibold small text-success mb-2"><i class="bx bx-package me-1"></i>Gợi ý khối lượng:</div>
                                        <div class="admin-size-grid mb-3">
                                            <button type="button" class="admin-size-tile" data-sample="100g">100g</button>
                                            <button type="button" class="admin-size-tile" data-sample="250g">250g</button>
                                            <button type="button" class="admin-size-tile" data-sample="500g">500g</button>
                                            <button type="button" class="admin-size-tile" data-sample="1kg">1kg</button>
                                            <button type="button" class="admin-size-tile" data-sample="2kg">2kg</button>
                                            <button type="button" class="admin-size-tile" data-sample="5kg">5kg</button>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 220px;">Dung tích</th>
                                                    <th>SKU</th>
                                                    <th style="width: 160px;">Số lượng</th>
                                                    <th style="width: 60px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody id="volumeOptionsBody">
                                                @if (Model.VolumeOptionStocks != null && Model.VolumeOptionStocks.Count > 0)
                                                {
                                                    for (var i = 0; i < Model.VolumeOptionStocks.Count; i++)
                                                    {
                                                        <tr data-volume-row>
                                                            <td>
                                                                <input asp-for="VolumeOptionStocks[i].OptionName" class="form-control form-control-sm" placeholder="VD: 50ml" />
                                                            </td>
                                                            <td>
                                                                <span class="text-muted">Tự tạo: <span class="fw-semibold">ID-OPTION</span></span>
                                                            </td>
                                                            <td>
                                                                <input asp-for="VolumeOptionStocks[i].StockQuantity" class="form-control form-control-sm" type="number" min="0" />
                                                            </td>
                                                            <td class="text-end">
                                                                <button type="button" class="btn btn-sm btn-outline-danger" data-volume-remove>×</button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr data-volume-row>
                                                        <td>
                                                            <input name="VolumeOptionStocks[0].OptionName" class="form-control form-control-sm" placeholder="VD: 50ml" />
                                                        </td>
                                                        <td>
                                                            <span class="text-muted">Tự tạo: <span class="fw-semibold">ID-OPTION</span></span>
                                                        </td>
                                                        <td>
                                                            <input name="VolumeOptionStocks[0].StockQuantity" class="form-control form-control-sm" type="number" min="0" value="0" />
                                                        </td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-sm btn-outline-danger" data-volume-remove>×</button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <template id="volumeOptionRowTemplate">
                                        <tr data-volume-row>
                                            <td>
                                                <input class="form-control form-control-sm" name="VolumeOptionStocks[__index__].OptionName" placeholder="VD: 50ml" />
                                            </td>
                                            <td>
                                                <span class="text-muted">Tự tạo: <span class="fw-semibold">ID-OPTION</span></span>
                                            </td>
                                            <td>
                                                <input class="form-control form-control-sm" type="number" min="0" name="VolumeOptionStocks[__index__].StockQuantity" value="0" />
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-volume-remove>×</button>
                                            </td>
                                        </tr>
                                    </template>

                                    <span asp-validation-for="VolumeOptionStocks" class="text-danger"></span>
                                </div>

                                <div class="mb-4" id="sizeStocksWrap">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h5 class="mb-0">Tồn kho theo quy cách</h5>
                                    </div>
                                    <div class="text-muted mb-2">Nhập số lượng theo quy cách (size số / size chữ / ml / g...). SKU tự tạo theo dạng ProductId-Option.</div>

                                    <div class="mb-3" id="sizePickerWrap">
                                        <label class="form-label mb-2">Chọn quy cách đang bán</label>
                                        <div class="admin-size-grid" id="sizePickerGrid" aria-label="Chọn size/quy cách"></div>
