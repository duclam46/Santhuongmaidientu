    </style>

    <script id="js-all-sizes-data" type="application/json">
        @Html.Raw(global::System.Text.Json.JsonSerializer.Serialize(Model.InitialSizeStocks ?? new List<DOAN_BANHANG.ViewModels.ProductAdminInitialSizeStockVm>(), new global::System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = global::System.Text.Json.JsonNamingPolicy.CamelCase }))
    </script>

    <script>
        (() => {
            const menu = document.getElementById('admin-product-create-menu');
            if (!menu) return;

            const buttons = Array.from(menu.querySelectorAll('button[data-tab]'));
            const panes = Array.from(document.querySelectorAll('.admin-product-create-pane[data-pane]'));

            function activate(key) {
                buttons.forEach(b => {
                    const isActive = b.getAttribute('data-tab') === key;
                    b.classList.toggle('active', isActive);
                    b.setAttribute('aria-selected', isActive ? 'true' : 'false');
                });

                panes.forEach(p => {
                    const isActive = p.getAttribute('data-pane') === key;
                    p.classList.toggle('d-none', !isActive);
                });
            }

            menu.addEventListener('click', (e) => {
                const t = e.target;
                if (!(t instanceof HTMLElement)) return;
                const btn = t.closest('button[data-tab]');
                if (!btn) return;
                const key = btn.getAttribute('data-tab') || '';
                if (!key) return;
                activate(key);
            });

            // Default open
            activate('info');

            // If the server returned validation errors, jump to the pane that contains the first error.
            const firstFieldError = Array.from(document.querySelectorAll('.field-validation-error'))
                .find(el => (el?.textContent || '').trim().length > 0);
            if (firstFieldError) {
                const pane = firstFieldError.closest('.admin-product-create-pane[data-pane]');
                const key = pane ? (pane.getAttribute('data-pane') || '') : '';
                if (key) activate(key);
            }
        })();

        // ── Category Cascade ──
        (() => {
            const categoryCascader = document.getElementById('categoryCascader');
            const finalCategoryId = document.getElementById('finalCategoryId');
            const categoryBreadcrumb = document.getElementById('categoryBreadcrumb');
            let allCats = [];

            async function initCategoryCascade() {
                try {
                    const res = await fetch(`@Url.Action("AllCategories", "Products", new { area = "Admin" })`);
                    allCats = await res.json();
                    
                    const catMap = new Map();
                    allCats.forEach(c => catMap.set(c.id, c));
                    
                    let currentId = parseInt(finalCategoryId.value) || 0;
                    let path = [];
                    while (currentId > 0 && catMap.has(currentId)) {
                        path.unshift(currentId);
                        currentId = catMap.get(currentId).parentId || 0;
                    }
                    
                    renderCascader(path);
                } catch (err) {
                    console.error("Lỗi khi tải danh mục", err);
                }
            }

            function renderCascader(path) {
                categoryCascader.innerHTML = '';
                
                let parentId = null;
                let currentLevel = 0;
                
                for (let i = 0; i < path.length; i++) {
                    const selectedId = path[i];
                    renderSelect(parentId, selectedId, currentLevel);
                    parentId = selectedId;
                    currentLevel++;
                }
                
                const hasChildren = allCats.some(c => c.parentId === parentId);
                if (hasChildren || path.length === 0) {
                    renderSelect(parentId, "", currentLevel);
                }
                
                updateBreadcrumb(path);
            }

            function renderSelect(parentId, selectedValue, level) {
                const children = allCats.filter(c => c.parentId === parentId);
                if (children.length === 0) return;
                
                const select = document.createElement('select');
                select.className = 'form-select';
                select.style.flex = "1";
                select.style.minWidth = "180px";
                select.dataset.level = level;
                
                select.innerHTML = `<option value="">-- Chọn danh mục cấp ${level + 1} --</option>`;
                children.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.textContent = c.name;
                    if (c.id == selectedValue) opt.selected = true;
                    select.appendChild(opt);
                });
                
                select.addEventListener('change', (e) => {
                    const newPath = [];
                    const selects = Array.from(categoryCascader.querySelectorAll('select'));
                    for (const s of selects) {
                        if (s.value) newPath.push(parseInt(s.value));
                        if (s === e.target) break;
                    }
                    
                    finalCategoryId.value = newPath.length > 0 ? newPath[newPath.length - 1] : '';
                    renderCascader(newPath);
                    if (typeof window.autoDetectScheme === 'function') window.autoDetectScheme();
                });
                
                categoryCascader.appendChild(select);
            }

            function updateBreadcrumb(path) {
                if (path.length === 0) {
                    categoryBreadcrumb.textContent = "Chưa chọn danh mục";
                    return;
                }
                const names = path.map(id => allCats.find(c => c.id === id)?.name || "");
                categoryBreadcrumb.innerHTML = "Đường dẫn: <b>" + names.join(" &rsaquo; ") + "</b>";
            }

            initCategoryCascade().then(() => {
                if (typeof window.autoDetectScheme === 'function') window.autoDetectScheme();
            });
        })();

        // Image pickers (primary + gallery slots)
        (() => {
            // Primary
            const primaryInput = document.getElementById('primaryImageInput');
            const primaryBox = document.getElementById('primaryImageBox');
            const primaryEmpty = document.getElementById('primaryImageEmpty');
            const primaryImg = document.getElementById('primaryImagePreviewImg');
            const primaryChooseBtn = document.getElementById('primaryChooseBtn');
            const primaryOverlayChangeBtn = document.getElementById('primaryOverlayChangeBtn');
            const primaryOverlayRemoveBtn = document.getElementById('primaryOverlayRemoveBtn');

            function openPrimaryPicker() {
                if (!primaryInput) return;
                primaryInput.click();
            }

            function renderPrimary() {
                const file = primaryInput?.files?.[0];
                if (!primaryImg || !primaryEmpty || !primaryBox) return;

                if (!file) {
                    primaryBox.classList.remove('has-image');
                    primaryImg.removeAttribute('src');
                    primaryImg.classList.add('d-none');
                    primaryEmpty.classList.remove('d-none');
                    return;
                }

                primaryImg.src = URL.createObjectURL(file);
                primaryImg.classList.remove('d-none');
                primaryEmpty.classList.add('d-none');
                primaryBox.classList.add('has-image');
            }

            function clearPrimary() {
                if (!primaryInput || !primaryImg || !primaryEmpty || !primaryBox) return;
                primaryInput.value = '';
                primaryImg.removeAttribute('src');
                primaryImg.classList.add('d-none');
                primaryEmpty.classList.remove('d-none');
                primaryBox.classList.remove('has-image');
            }

            if (primaryBox) {
                primaryBox.addEventListener('click', openPrimaryPicker);
                primaryBox.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') openPrimaryPicker();
                });
            }
            primaryChooseBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                openPrimaryPicker();
            });
            primaryOverlayChangeBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                openPrimaryPicker();
            });
            primaryOverlayRemoveBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                clearPrimary();
            });
            primaryInput?.addEventListener('change', renderPrimary);

            // In case browser restores selected file on refresh
            renderPrimary();

            // Gallery
            const contentMaster = document.getElementById('contentImagesMaster');
            const contentPickerMany = document.getElementById('contentImagesPickerMany');
            const contentPickerSingle = document.getElementById('contentImagesPickerSingle');
            const contentSlots = document.getElementById('contentSlots');
            const contentAddManyBtn = document.getElementById('contentAddManyBtn');

            let slotCount = 3;
            let pendingSingleIndex = -1;

            function getFiles() {
                return contentMaster?.files ? Array.from(contentMaster.files) : [];
            }

            function setFiles(files) {
                if (!contentMaster) return;
                const dt = new DataTransfer();
                for (const f of files) dt.items.add(f);
                contentMaster.files = dt.files;
            }

            function addFiles(newFiles) {
                const current = getFiles();
                setFiles(current.concat(newFiles));
            }

            function removeAt(index) {
                const current = getFiles();
                if (index < 0 || index >= current.length) return;
                current.splice(index, 1);
                setFiles(current);
            }

            function ensureSlotsFor(filesCount) {
                const minSlots = 3;
                slotCount = Math.max(slotCount, filesCount, minSlots);
            }

            function openManyPicker() {
                contentPickerMany?.click();
            }

            function openSinglePicker(slotIndex) {
                pendingSingleIndex = slotIndex;
                contentPickerSingle?.click();
            }

            function renderSlots() {
                if (!contentSlots) return;
                const files = getFiles();
                ensureSlotsFor(files.length);

                contentSlots.innerHTML = '';

                function renderAddTile() {
                    const addWrap = document.createElement('div');
                    addWrap.className = 'admin-image-slot admin-image-slot--add';
                    const addBtn = document.createElement('button');
                    addBtn.type = 'button';
                    addBtn.innerHTML = '<div class="fw-semibold">+</div><div class="text-muted small">Thêm ô</div>';
                    addBtn.addEventListener('click', () => {
                        slotCount += 1;
                        renderSlots();
                    });
                    addWrap.appendChild(addBtn);
                    contentSlots.appendChild(addWrap);
                }

                for (let i = 0; i < slotCount; i++) {
                    const wrap = document.createElement('div');
                    wrap.className = 'admin-image-slot';

                    if (i < files.length) {
                        const img = document.createElement('img');
                        img.className = 'admin-image-slot__img';
                        img.alt = 'Preview';
                        img.src = URL.createObjectURL(files[i]);
                        wrap.appendChild(img);

                        const removeBtn = document.createElement('button');
                        removeBtn.type = 'button';
                        removeBtn.className = 'btn btn-sm btn-danger admin-image-slot__remove';
                        removeBtn.textContent = '×';
                        removeBtn.addEventListener('click', (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            removeAt(i);
                            renderSlots();
                        });
                        wrap.appendChild(removeBtn);

                        const change = document.createElement('button');
                        change.type = 'button';
                        change.style.position = 'absolute';
                        change.style.inset = '0';
                        change.style.opacity = '0';
                        change.addEventListener('click', () => openSinglePicker(i));
                        wrap.appendChild(change);
                    } else {
                        wrap.classList.add('admin-image-slot--empty');
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.innerHTML = '<div class="fw-semibold">+</div><div class="text-muted small">Thêm ảnh</div>';
                        btn.addEventListener('click', () => openSinglePicker(i));
                        wrap.appendChild(btn);
                    }

                    contentSlots.appendChild(wrap);
                }

                // Add-slot tile (always at the end)
                renderAddTile();
            }

            contentAddManyBtn?.addEventListener('click', openManyPicker);

            contentPickerMany?.addEventListener('change', () => {
                const picked = contentPickerMany.files ? Array.from(contentPickerMany.files) : [];
                if (picked.length === 0) return;
                addFiles(picked);
                contentPickerMany.value = '';
                renderSlots();
            });

            contentPickerSingle?.addEventListener('change', () => {
                const picked = contentPickerSingle.files ? Array.from(contentPickerSingle.files) : [];
                if (picked.length === 0) return;
                const file = picked[0];
                const current = getFiles();

                if (pendingSingleIndex >= 0 && pendingSingleIndex < current.length) {
                    current[pendingSingleIndex] = file;
                    setFiles(current);
                } else {
                    addFiles([file]);
                }

                pendingSingleIndex = -1;
                contentPickerSingle.value = '';
                renderSlots();
            });

            // Initial render
            renderSlots();
        })();

        // Variant mode + scheme UI (size table vs shoe picker vs volume rows)
        (() => {
            const multi = document.getElementById('HasSizeVariantsTrue');
            const single = document.getElementById('HasSizeVariantsFalse');

            const singleWrap = document.getElementById('singleStockWrap');
            const schemeWrap = document.getElementById('sizeSchemeWrap');
            const schemeSelect = document.getElementById('sizeSchemeSelect');

            const sizeWrap = document.getElementById('sizeStocksWrap');
            const emptyAlert = document.getElementById('schemeEmptyAlert');

            const sizePickerWrap = document.getElementById('sizePickerWrap');
            const sizePickerGrid = document.getElementById('sizePickerGrid');

            const volumeWrap = document.getElementById('volumeOptionsWrap');
            const volumeBody = document.getElementById('volumeOptionsBody');
            const volumeAddRowBtn = document.getElementById('volumeAddRowBtn');
            const volumeTpl = document.getElementById('volumeOptionRowTemplate');

            // Size guide sync
            const sizeGuideBody = document.getElementById('sizeGuideBody');
            const sizeGuideTpl = document.getElementById('sizeGuideRowTemplate');
            const sizeGuideEmptyAlert = document.getElementById('sizeGuideEmptyAlert');
            const sizeGuideTableWrap = document.getElementById('sizeGuideTableWrap');

            if (!multi || !single || !singleWrap || !schemeWrap || !schemeSelect || !sizeWrap) return;

            let allSizes = [];
            try {
                const dataEl = document.getElementById('js-all-sizes-data');
                allSizes = JSON.parse(dataEl?.textContent || '[]');
            } catch(e) {
                console.error("Failed to parse sizes", e);
            }

            const selectedSizes = new Set();
            const stockCache = new Map(); // key: "colorId-sizeId", value: qty
            let lastPickerMode = null;

            function classify(name) {
                const s = (name || '').trim().toUpperCase();
                if (!s) return 'other';

                // volume
                if (/(\d+)\s*ML\b/.test(s) || /\bML\b/.test(s)) return 'volume';
                if (/(\d+(?:\.\d+)?)\s*L\b/.test(s)) return 'volume';

                // weight
                if (/(\d+)\s*G\b/.test(s) || /(\d+(?:\.\d+)?)\s*KG\b/.test(s)) return 'weight';

                // shoe numeric sizes
                if (/^\d+(?:\.\d+)?$/.test(s)) return 'shoe';
                if (/\bEU\s*\d+/.test(s)) return 'shoe';
                if (/\bSIZE\s*\d+/.test(s)) return 'shoe';
                if (/\b\d{2}(?:\.\d+)?\b/.test(s)) return 'shoe';

                // clothing alpha sizes
                if (/\b(XXS|XS|S|M|L|XL|XXL|XXXL)\b/.test(s)) return 'clothing';

                return 'other';
            }

            function parseShoeNumber(name) {
                const raw = (name || '').trim().toUpperCase();
                if (!raw) return Number.NaN;
                const m = raw.match(/(\d+(?:\.\d+)?)/);
                if (!m) return Number.NaN;
                return parseFloat(m[1]);
            }

            function getAllSizeRows() {
                return Array.from(sizeWrap.querySelectorAll('tbody tr[data-size-row]'));
            }

            function getRowSizeName(row) {
                const hiddenName = row.querySelector('input[type="hidden"][name$=".SizeName"]');
                if (hiddenName && hiddenName.value) return hiddenName.value;
                const nameEl = row.querySelector('.size-name');
                return nameEl ? (nameEl.textContent || '').trim() : '';
            }

            function getRowQtyInput(row) {
                return row.querySelector('input[type="number"]');
            }

            function getRowsForMode(mode) {
                // For the picker, we need a unique list of size names for that mode.
                // We'll use the 'allSizes' data instead of the DOM rows.
                const result = [];
                const seen = new Set();

                for (const s of allSizes) {
                    const sName = s.sizeName || s.SizeName;
                    if (seen.has(sName)) continue;
                    const kind = classify(sName);
                    if (mode === 'all' || kind === mode) {
                        result.push({ name: sName, kind });
                        seen.add(sName);
                    }
                }
                return result;
            }

            function seedSelectionFromQty(mode) {
                // This is less relevant now as we regenerate the table, 
                // but let's keep it to detect already selected sizes.
                selectedSizes.clear();
                const items = Array.from(sizeWrap.querySelectorAll('tbody tr[data-size-row]'));
                for (const row of items) {
                    const name = getRowSizeName(row);
                    const qtyEl = getRowQtyInput(row);
                    const qty = qtyEl ? parseInt(qtyEl.value || '0', 10) : 0;
                    if (qty > 0 && name) selectedSizes.add(name);
                }
            }

            function renderSizePicker(mode) {
                if (!sizePickerWrap || !sizePickerGrid) return;

                const items = getRowsForMode(mode);
                sizePickerGrid.innerHTML = '';

                for (let i = 0; i < items.length; i++) {
                    const it = items[i];
                    const id = `pick_size_${mode}_${i}`;

                    const input = document.createElement('input');
                    input.type = 'checkbox';
                    input.className = 'btn-check';
                    input.id = id;
                    input.autocomplete = 'off';
                    input.checked = selectedSizes.has(it.name);
                    input.setAttribute('data-size-pick', '1');
                    input.setAttribute('data-size-name', it.name);

                    input.addEventListener('change', () => {
                        if (input.checked) selectedSizes.add(it.name);
                        else selectedSizes.delete(it.name);

                        applySizeFiltering();
                        syncSizeGuideRows();
                    });

                    const label = document.createElement('label');
                    label.className = 'admin-size-tile';
                    label.setAttribute('for', id);
                    label.textContent = it.name;

                    sizePickerGrid.appendChild(input);
                    sizePickerGrid.appendChild(label);
                }
            }

            function syncPickerStates() {
                if (!sizePickerGrid) return;
                const inputs = Array.from(sizePickerGrid.querySelectorAll('input[data-size-pick="1"]'));
                for (const el of inputs) {
                    if (!(el instanceof HTMLInputElement)) continue;
                    const name = el.getAttribute('data-size-name') || '';
                    el.checked = !!name && selectedSizes.has(name);
                }
            }

            function updateStockCache() {
                const rows = Array.from(sizeWrap.querySelectorAll('#initialSizeStocksBody tr[data-size-row]'));
                rows.forEach(r => {
                    const cId = r.getAttribute('data-color-id') || "0";
                    const sId = r.getAttribute('data-size-id');
                    const qtyInput = r.querySelector('input[name$=".StockQuantity"]');
                    if (qtyInput) {
                        stockCache.set(`${cId}-${sId}`, qtyInput.value);
                    }
                });
            }

            function getSelectedColors() {
                const inputs = Array.from(document.querySelectorAll('input[name="SelectedColorIds"]:checked'));
                return inputs.map(input => {
                    const id = input.value;
                    const label = document.querySelector(`label[for="${input.id}"]`);
                    const name = label ? (label.getAttribute('data-color-name') || label.querySelector('.admin-color-name')?.textContent?.trim() || "N/A") : "N/A";
                    return { id, name };
                });
            }

            function applySizeFiltering() {
                updateStockCache();
                const mode = schemeSelect.value;
                const colors = getSelectedColors();
                
                // If no colors are selected, we treat it as "Default" color (null)
                const colorList = colors.length > 0 ? colors : [{ id: "0", name: "Mặc định" }];

                const body = document.getElementById('initialSizeStocksBody');
                const tpl = document.getElementById('initialSizeStockRowTemplate');
                if (!body || !tpl) return;

                body.innerHTML = '';
                let index = 0;
                let visible = 0;

                for (const color of colorList) {
                    for (const size of allSizes) {
                        const sizeName = size.sizeName || size.SizeName;
                        const sizeId = size.sizeId || size.SizeId;
                        
                        const kind = classify(sizeName);
                        const inMode = (mode === 'all') || (kind === mode);
                        if (!inMode) continue;
                        
                        const isSelectedInPicker = selectedSizes.has(sizeName);
                        if (!isSelectedInPicker) continue;

                        const qty = stockCache.get(`${color.id}-${sizeId}`) || "0";

                        let html = tpl.innerHTML
                            .replaceAll('__index__', index)
                            .replaceAll('__colorId__', color.id)
                            .replaceAll('__colorName__', color.name)
                            .replaceAll('__sizeId__', sizeId)
                            .replaceAll('__sizeName__', sizeName)
                            .replaceAll('__isSelected__', "true")
                            .replaceAll('__qty__', qty);

                        const temp = document.createElement('tbody');
                        temp.innerHTML = html.trim();
                        const row = temp.firstElementChild;
                        if (row) body.appendChild(row);

                        index++;
                        visible++;
                    }
                }

                if (visible === 0) {
                    body.innerHTML = '<tr><td colspan="4" class="text-muted text-center py-3">Hãy chọn size ở bảng phía trên.</td></tr>';
                }

                if (emptyAlert) {
                    const availableInMode = allSizes.filter(s => mode === 'all' || classify(s.SizeName) === mode).length;
                    const shouldShowEmpty = (mode !== 'all') && (availableInMode === 0);
                    emptyAlert.classList.toggle('d-none', !shouldShowEmpty);
                }
            }

            function setVolumeInputsEnabled(enabled) {
                if (!volumeWrap) return;
                const inputs = Array.from(volumeWrap.querySelectorAll('input, select, textarea'));
                for (const el of inputs) {
                    if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement) {
                        el.disabled = !enabled;
                    }
                }
            }

            function readGuideRowData() {
                const map = new Map();
                if (!sizeGuideBody) return map;
                const rows = Array.from(sizeGuideBody.querySelectorAll('tr[data-size-guide-row]'));
                for (const r of rows) {
                    const label = (r.getAttribute('data-size-label') || '').trim();
                    if (!label) continue;

                    const read = (suffix) => {
                        const el = r.querySelector(`[name$=".${suffix}"]`);
                        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) {
                            return (el.value || '').trim();
                        }
                        return '';
                    };

                    map.set(label, {
                        HeightRange: read('HeightRange'),
                        WeightRange: read('WeightRange'),
                        ShoulderWidthCm: read('ShoulderWidthCm'),
                        BustCm: read('BustCm'),
                        WaistCm: read('WaistCm'),
                        HipCm: read('HipCm'),
                        ClothingLengthCm: read('ClothingLengthCm'),
                        ClothingWidthCm: read('ClothingWidthCm'),
                        ClothingHeightCm: read('ClothingHeightCm'),
                        ShoeLengthCm: read('ShoeLengthCm'),
                        Note: read('Note')
                    });
                }
                return map;
            }

            function collectSelectedSizeLabels() {
                const labels = [];
                const mode = schemeSelect.value;
                if (mode === 'volume' || mode === 'weight') {
                    if (volumeBody) {
                        const rows = Array.from(volumeBody.querySelectorAll('tr[data-volume-row]:not(.d-none)'));
                        for (const r of rows) {
                            const input = r.querySelector('input[name$=".OptionName"]');
                            const val = (input?.value || '').trim();
                            if (val) labels.push(val);
                        }
                    }
                } else {
                    // For size guide, we only want unique sizes regardless of color.
                    for (const s of selectedSizes) {
                        labels.push(s);
                    }
                }

                // Deduplicate while preserving order
                const seen = new Set();
                const unique = [];
                for (const l of labels) {
                    if (seen.has(l)) continue;
                    seen.add(l);
                    unique.push(l);
                }
                return unique;
            }

            const sgSel = document.getElementById('sizeGuideSchemeSelect');

            window.autoDetectScheme = function() {
                if (!sgSel) return;
                const cascader = document.getElementById('categoryCascader');
                if (!cascader) return;

                const selects = Array.from(cascader.querySelectorAll('select'));
                const fullText = selects.map(s => s.options[s.selectedIndex]?.text || "").join(" ").toLowerCase();

                if (fullText.includes("áo") || fullText.includes("shirt") || fullText.includes("top") || fullText.includes("sơ mi") || fullText.includes("phông")) {
                    sgSel.value = "ao";
                } else if (fullText.includes("quần") || fullText.includes("pants") || fullText.includes("jean") || fullText.includes("khaki") || fullText.includes("short")) {
                    sgSel.value = "quan";
                } else if (fullText.includes("giày") || fullText.includes("dép") || fullText.includes("shoe") || fullText.includes("sneaker")) {
                    sgSel.value = "shoe";
                } else {
                    sgSel.value = "all";
                }
                updateSgColumns();
            };

            function updateSgColumns() {
                if (!sgSel) return;
                const mode = sgSel.value;
                const allCols = document.querySelectorAll('[class*="sg-col-"]');
                allCols.forEach(el => {
                    if (mode === 'all') {
                        el.classList.remove('d-none');
                    } else {
                        const isMatch = el.classList.contains('sg-col-' + mode) || el.classList.contains('sg-col-shared');
                        el.classList.toggle('d-none', !isMatch);
                    }
                });
            }

            if (sgSel) sgSel.addEventListener('change', updateSgColumns);

            function setSizeGuideSchemeColumns() {
                updateSgColumns();
            }

            function syncSizeGuideRows() {
                if (!sizeGuideBody || !sizeGuideTpl || !(sizeGuideTpl instanceof HTMLTemplateElement)) return;

                const bySize = !!multi.checked;
                const mode = schemeSelect.value;

                // Only meaningful for clothing/shoe size variants.
                const applicable = bySize && (mode === 'clothing' || mode === 'shoe' || mode === 'volume' || mode === 'weight' || mode === 'all');
                if (sizeGuideTableWrap) sizeGuideTableWrap.classList.toggle('d-none', !applicable);
                if (!applicable) {
                    sizeGuideEmptyAlert?.classList.add('d-none');
                    return;
                }


                const selected = collectSelectedSizeLabels();
                const existing = readGuideRowData();

                if (selected.length === 0) {
                    sizeGuideBody.innerHTML = '';
                    sizeGuideEmptyAlert?.classList.remove('d-none');
                    return;
                }

                sizeGuideEmptyAlert?.classList.add('d-none');

                const rowsHtml = [];
                for (let i = 0; i < selected.length; i++) {
                    const sizeLabel = selected[i];
                    let html = sizeGuideTpl.innerHTML
                        .replaceAll('__index__', String(i))
                        .replaceAll('__sizeLabel__', String(sizeLabel));
                    rowsHtml.push(html);
                }

                sizeGuideBody.innerHTML = rowsHtml.join('');

                // Restore any typed values for sizes we kept.
                const rows = Array.from(sizeGuideBody.querySelectorAll('tr[data-size-guide-row]'));
                for (const r of rows) {
                    const label = (r.getAttribute('data-size-label') || '').trim();
                    if (!label) continue;
                    const data = existing.get(label);
                    if (!data) continue;

                    const set = (suffix, value) => {
                        const el = r.querySelector(`[name$=".${suffix}"]`);
                        if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) {
                            el.value = value || '';
                        }
                    };

                    set('HeightRange', data.HeightRange);
                    set('WeightRange', data.WeightRange);
                    set('ShoulderWidth', data.ShoulderWidth);
                    set('Bust', data.Bust);
                    set('Waist', data.Waist);
                    set('Hip', data.Hip);
                    set('ClothingLength', data.ClothingLength);
                    set('ClothingWidth', data.ClothingWidth);
                    set('ShoeLength', data.ShoeLength);
                    set('Note', data.Note);
                }

                setSizeGuideSchemeColumns();
            }

            function wireVolumeRemoveButtons() {
                if (!volumeBody) return;
                const btns = Array.from(volumeBody.querySelectorAll('[data-volume-remove]'));
                for (const b of btns) {
                    if (b.getAttribute('data-wired') === '1') continue;
                    b.setAttribute('data-wired', '1');
                    b.addEventListener('click', (e) => {
                        e.preventDefault();
                        const row = (b instanceof HTMLElement) ? b.closest('tr[data-volume-row]') : null;
                        if (!row) return;

                        const nameInput = row.querySelector('input[name^="VolumeOptionStocks["][name$=".OptionName"]');
                        const qtyInput = row.querySelector('input[name^="VolumeOptionStocks["][name$=".StockQuantity"]');
                        if (nameInput instanceof HTMLInputElement) nameInput.value = '';
                        if (qtyInput instanceof HTMLInputElement) qtyInput.value = '0';
                        row.classList.add('d-none');
                        syncSizeGuideRows();
                    });
                }
            }

            function addVolumeRow(initialValue = '') {
                if (!volumeBody || !volumeTpl) return;
                const tpl = volumeTpl;
                if (!(tpl instanceof HTMLTemplateElement)) return;

                const existingIndexes = Array.from(volumeBody.querySelectorAll('input[name^="VolumeOptionStocks["]'))
                    .map(i => {
                        const n = (i instanceof HTMLInputElement) ? i.name : '';
                        const m = n.match(/^VolumeOptionStocks\[(\d+)\]/);
                        return m ? parseInt(m[1], 10) : -1;
                    })
                    .filter(n => n >= 0);

                const nextIndex = (existingIndexes.length ? Math.max(...existingIndexes) : -1) + 1;
                const html = tpl.innerHTML.replaceAll('__index__', String(nextIndex));
                const temp = document.createElement('tbody');
                temp.innerHTML = html.trim();
                const row = temp.querySelector('tr[data-volume-row]');
                if (!row) return;

                if (initialValue) {
                    const nameInput = row.querySelector('input[name$=".OptionName"]');
                    if (nameInput instanceof HTMLInputElement) nameInput.value = initialValue;
                }

                volumeBody.appendChild(row);
                wireVolumeRemoveButtons();
                syncSizeGuideRows();
            }

            function syncVariantModeVisibility() {
                const bySize = !!multi.checked;
                singleWrap.classList.toggle('d-none', bySize);
                schemeWrap.classList.toggle('d-none', !bySize);
            }

            function apply() {
                syncVariantModeVisibility();

                const bySize = !!multi.checked;
                if (!bySize) {
                    volumeWrap?.classList.add('d-none');
                    sizeWrap.classList.add('d-none');
                    setVolumeInputsEnabled(false);

                    selectedSizes.clear();
                    lastPickerMode = null;
                    if (sizePickerWrap) sizePickerWrap.classList.add('d-none');

                    syncSizeGuideRows();
                    return;
                }

                const mode = schemeSelect.value;
                const isCustom = mode === 'volume' || mode === 'weight';

                volumeWrap?.classList.toggle('d-none', !isCustom);
                sizeWrap.classList.toggle('d-none', isCustom);

                if (sizePickerWrap) sizePickerWrap.classList.toggle('d-none', isCustom);

                setVolumeInputsEnabled(isCustom);

                if (isCustom) {
                    // Ensure size table stocks don't leak into custom mode.
                    applySizeFiltering();
                    
                    const volSamples = document.getElementById('volumeSamples');
                    const weightSamples = document.getElementById('weightSamples');
                    volSamples?.classList.toggle('d-none', mode !== 'volume');
                    weightSamples?.classList.toggle('d-none', mode !== 'weight');
                } else {
                    const mode = schemeSelect.value;
                    if (lastPickerMode !== mode) {
                        seedSelectionFromQty(mode);
                        renderSizePicker(mode);
                        lastPickerMode = mode;
                    }
                    syncPickerStates();
                    applySizeFiltering();
                }

                syncSizeGuideRows();
            }

            // Events
            multi.addEventListener('change', apply);
            single.addEventListener('change', apply);
            schemeSelect.addEventListener('change', apply);

            // Keep size guide in sync while user types quantities.
            sizeWrap.addEventListener('input', (e) => {
                const t = e.target;
                if (!(t instanceof HTMLElement)) return;
                if (t.matches('input[type="number"]')) {
                    const row = t.closest('tr[data-size-row]');
                    const name = row ? getRowSizeName(row) : '';
                    const qty = (t instanceof HTMLInputElement) ? parseInt(t.value || '0', 10) : 0;
                    if (name && qty > 0) {
                        selectedSizes.add(name);
                        syncPickerStates();
                    }
                    syncSizeGuideRows();
                }
            });

            volumeAddRowBtn?.addEventListener('click', (e) => {
                e.preventDefault();
                addVolumeRow();
            });

            wireVolumeRemoveButtons();

            volumeWrap?.addEventListener('input', (e) => {
                const t = e.target;
                if (!(t instanceof HTMLElement)) return;
                if (t.matches('input[name$=".OptionName"]')) {
                    syncSizeGuideRows();
                }
            });

            // Sample buttons
            document.querySelectorAll('[data-sample]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const val = btn.getAttribute('data-sample');
                    if (val) addVolumeRow(val);
                });
            });

            // Color selection changes
            document.querySelectorAll('input[name="SelectedColorIds"]').forEach(input => {
                input.addEventListener('change', () => {
                    apply();
                });
            });

            apply();

            // Currency formatting logic
            (function () {
                const inputs = document.querySelectorAll('.vn-money-input');

                function formatValue(val) {
                    let n = val.replace(/\D/g, "");
                    return n === "" ? "" : Number(n).toLocaleString("vi-VN");
                }

                inputs.forEach(input => {
                    if (input.value) {
                        input.value = formatValue(input.value);
                    }

                    input.addEventListener('input', function () {
                        let originalValue = this.value;
                        let formatted = formatValue(originalValue);
                        
                        if (formatted !== originalValue) {
                            // Try to maintain cursor position
                            let cursor = this.selectionStart;
                            this.value = formatted;
                            // Simple cursor adjustment (moves to end for simplicity in this case)
                        }
                    });
                });

                // Strip dots before submit
                const form = document.getElementById('admin-product-create-form');
                if (form) {
                    form.addEventListener('submit', () => {
                        inputs.forEach(input => {
                            input.value = input.value.replace(/\./g, "").replace(/,/g, ""); // vi-VN uses dot for thousands and comma for decimal, but usually we handle integers for VND
                        });
                    });
                }
            })();
        })();
    </script>
}
