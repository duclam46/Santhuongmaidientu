@model DOAN_BANHANG.ViewModels.ProductAdminReviewsVm

@{
    ViewData["Title"] = "Quản lý đánh giá";
}


        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0 font-size-18">Đánh giá sản phẩm</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductId">#@Model.ProductId</a></li>
                            <li class="breadcrumb-item active">Đánh giá</li>
                        </ol>
                    </div>

                </div>
            </div>
        </div>

        @if (TempData["AdminToast"] is string msg && !string.IsNullOrWhiteSpace(msg))
        {
            <div class="alert alert-success">@msg</div>
        }

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <h4 class="card-title mb-1">@Model.ProductName</h4>
                                <div class="text-muted small">Xem và trả lời đánh giá của khách hàng</div>
                            </div>
                            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductId">Quay lại</a>
                        </div>

                        @if (Model.Reviews.Count == 0)
                        {
                            <div class="text-center text-muted py-5">Chưa có đánh giá.</div>
                        }
                        else
                        {
                            foreach (var r in Model.Reviews)
                            {
                                <div class="border rounded p-3 mb-3">
                                    <div class="d-flex justify-content-between flex-wrap gap-2">
                                        <div>
                                            <div class="fw-medium">@r.AuthorName</div>
                                            <div class="text-muted small">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                        <div>
                                            <span class="badge bg-info">@r.Rating/5</span>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(r.Comment))
                                    {
                                        <div class="mt-2">@r.Comment</div>
                                    }

                                    <div class="mt-3">
                                        <form asp-area="Admin" asp-controller="Products" asp-action="ReplyReview" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ProductId" value="@Model.ProductId" />
                                            <input type="hidden" name="ReviewId" value="@r.ReviewId" />

                                            <label class="form-label">Phản hồi người bán</label>
                                            <textarea class="form-control" name="SellerReply" rows="3" placeholder="Nhập phản hồi...">@r.SellerReply</textarea>

                                            <div class="d-flex justify-content-end mt-2">
                                                <button type="submit" class="btn btn-sm btn-primary">Gửi phản hồi</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>
        </div>


