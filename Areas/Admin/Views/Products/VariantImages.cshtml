@model DOAN_BANHANG.ViewModels.ProductAdminVariantImagesVm
@{
    ViewData["Title"] = "Ảnh biến thể";
}

    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">Ảnh biến thể</h4>
                <div class="page-title-right">
                    <a class="btn btn-outline-secondary" href="@Url.Action("Edit", new { id = Model.ProductId })">Quay lại sản phẩm</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="mb-1">@Model.ProductName</h5>
            <div class="text-muted mb-3">@Model.VariantLabel</div>

            <form asp-action="UploadVariantImages" method="post" enctype="multipart/form-data" class="mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProductId" value="@Model.ProductId" />
                <input type="hidden" name="VariantId" value="@Model.VariantId" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        <label class="form-label">Tải ảnh (jpg/png/webp)</label>
                        <input class="form-control" type="file" name="Files" multiple accept="image/*" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-primary w-100" type="submit">Upload</button>
                    </div>
                </div>
            </form>

            @if (Model.Images == null || Model.Images.Count == 0)
            {
                <div class="alert alert-info mb-0">Chưa có ảnh cho biến thể này.</div>
            }
            else
            {
                <div class="row">
                    @foreach (var img in Model.Images)
                    {
                        <div class="col-md-3 col-sm-6">
                            <div class="card">
                                <img src="@img.ImageUrl" class="card-img-top" alt="variant image" style="object-fit:cover;height:180px;" />
                                <div class="card-body">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="badge @(img.IsPrimary ? "bg-success" : "bg-secondary")">@(img.IsPrimary ? "Primary" : "")</span>
                                        <small class="text-muted">#@img.SortOrder</small>
                                    </div>

                                    <div class="mt-3 d-flex gap-2">
                                        <form asp-action="SetPrimaryVariantImage" method="post" class="flex-fill">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@Model.ProductId" />
                                            <input type="hidden" name="variantId" value="@Model.VariantId" />
                                            <input type="hidden" name="imageId" value="@img.ImageId" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm w-100" @(img.IsPrimary ? "disabled" : null)>Đặt chính</button>
                                        </form>

                                        <form asp-action="DeleteVariantImage" method="post" class="flex-fill" onsubmit="return confirm('Xóa ảnh này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@Model.ProductId" />
                                            <input type="hidden" name="variantId" value="@Model.VariantId" />
                                            <input type="hidden" name="imageId" value="@img.ImageId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Xóa</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

