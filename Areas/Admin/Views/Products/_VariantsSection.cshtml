@model DOAN_BANHANG.ViewModels.ProductAdminUpsertVm

<div class="card border shadow-none">
    <div class="card-header bg-light border-0">
        <div class="d-flex align-items-center justify-content-between">
            <h5 class="my-0"><i class="bx bx-list-ul me-1"></i>Danh sách biến thể</h5>
            <span class="badge bg-secondary">@Model.Variants.Count</span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-nowrap table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">ID</th>
                        <th>Màu</th>
                        <th>Size</th>
                        <th>Giá</th>
                        <th>Tồn</th>
                        <th>Trạng thái</th>
                        <th style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Variants.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có biến thể.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var v in Model.Variants)
                        {
                            <tr>
                                <td>#@v.VariantId</td>
                                <td>@(v.ColorName ?? "-")</td>
                                <td>@(v.SizeName ?? "-")</td>
                                <td>@v.Price.ToString("n0")</td>
                                <td>@v.StockQuantity</td>
                                <td>
                                    <span class="badge @(v.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                        @(v.IsActive ? "Bật" : "Tắt")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <form asp-area="Admin" asp-controller="Products" asp-action="ToggleVariantActive" method="post" data-ajax-variants="true">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ProductId" value="@Model.Id" />
                                            <input type="hidden" name="VariantId" value="@v.VariantId" />
                                            <button type="submit" class="btn btn-sm @(v.IsActive ? "btn-soft-warning" : "btn-soft-success")">
                                                <i class="bx @(v.IsActive ? "bx-power-off" : "bx-check-circle") me-1"></i>
                                                @(v.IsActive ? "Tắt" : "Bật")
                                            </button>
                                        </form>

                                        <form asp-area="Admin" asp-controller="Products" asp-action="DeleteVariant" method="post" data-ajax-variants="true" data-confirm="Xóa biến thể này?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ProductId" value="@Model.Id" />
                                            <input type="hidden" name="VariantId" value="@v.VariantId" />
                                            <button type="submit" class="btn btn-soft-danger btn-sm">
                                                <i class="bx bx-trash me-1"></i>Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
