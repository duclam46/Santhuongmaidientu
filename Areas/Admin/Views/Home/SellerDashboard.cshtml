@model DOAN_BANHANG.ViewModels.SellerDashboardViewModel
@{
    ViewData["Title"] = "Kênh Người Bán - " + Model.ShopName;
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap">

<style>
    :root {
        --skote-primary: #556ee6;
        --skote-success: #34c38f;
        --skote-info: #50a5f1;
        --skote-warning: #f1b44c;
        --skote-danger: #f46a6a;
    }

    body {
        font-family: 'Inter', sans-serif !important;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', sans-serif !important;
    }

    .stat-card-premium {
        border: none;
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        overflow: hidden;
        position: relative;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .stat-card-premium:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1);
    }

    .bg-gradient-primary { background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); }
    .bg-gradient-success { background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%); }
    .bg-gradient-warning { background: linear-gradient(135deg, #f83600 0%, #f9d423 100%); }
    .bg-gradient-info { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); }
    .bg-gradient-profit { background: linear-gradient(135deg, #7f00ff 0%, #e100ff 100%) !important; }

    .card-glass {
        border: none;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

    .card-glass:hover {
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    .animated-item {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    .hover-lift {
        transition: all 0.2s ease-in-out;
    }
    .hover-lift:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.08);
    }

    @@keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-pulse {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% { transform: scale(0.95); opacity: 0.5; }
        50% { transform: scale(1.05); opacity: 1; }
        100% { transform: scale(0.95); opacity: 0.5; }
    }

    .product-rank-badge {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 11px;
    }

    .bg-rank-1 { background-color: #ffd700; color: #fff; }
    .bg-rank-2 { background-color: #c0c0c0; color: #fff; }
    .bg-rank-3 { background-color: #cd7f32; color: #fff; }
    .bg-rank-other { background-color: #f1f3f5; color: #6c757d; }
</style>

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18 fw-bold">Cổng Người Bán: @Model.ShopName</h4>
            <div class="page-title-right">
                <span class="badge bg-success bg-soft text-success font-size-13 p-2 rounded-pill fw-semibold">
                    <i class="bx bxs-circle me-1 animate-pulse"></i> Gian hàng trực tuyến
                </span>
            </div>
        </div>
    </div>
</div>

<!-- TOP Performance Bar -->
<div class="row g-4 mb-4">
    <!-- Welcome Panel -->
    <div class="col-xl-4 animated-item" style="animation-delay: 0.1s;">
        <div class="card overflow-hidden text-white border-0 shadow-lg h-100" style="border-radius: 16px; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); min-height: 180px;">
            <div class="card-body p-4 position-relative d-flex flex-column justify-content-between h-100">
                <div style="z-index: 2; position: relative;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="text-white fw-bold mb-1 font-size-18">Gian hàng @Model.ShopName</h4>
                            <p class="text-white-50 font-size-12 mb-3">Hôm nay hoạt động kinh doanh ổn định.</p>
                        </div>
                        <div class="avatar-md">
                            <span class="avatar-title rounded-circle bg-white bg-opacity-10 text-white font-size-24">
                                <i class="bx bx-store-alt"></i>
                            </span>
                        </div>
                    </div>
                    
                    <div class="row g-2 mt-2">
                        <div class="col-6 border-end border-white border-opacity-10">
                            <p class="text-white-50 font-size-11 mb-1 text-uppercase tracking-wider">Khách hàng tuần này</p>
                            <h5 class="text-white fw-bold mb-0">@Model.TotalCustomers</h5>
                        </div>
                        <div class="col-6 ps-3">
                            <p class="text-white-50 font-size-11 mb-1 text-uppercase tracking-wider">Cần bổ sung kho</p>
                            <h5 class="@(Model.LowStockItemsCount > 0 ? "text-warning" : "text-white") fw-bold mb-0">@Model.LowStockItemsCount sản phẩm</h5>
                        </div>
                    </div>
                </div>
                <i class="bx bx-store font-size-80 position-absolute text-white" style="bottom: -15px; right: -15px; opacity: 0.08; transform: rotate(-15deg); z-index: 1;"></i>
            </div>
        </div>
    </div>

    <!-- Today's Stats Grid -->
    <div class="col-xl-8">
        <div class="row g-3 h-100">
            <!-- 1. Doanh thu bán ra -->
            <div class="col-md-4 animated-item" style="animation-delay: 0.15s;">
                <div class="card stat-card-premium bg-gradient-primary h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="font-size-13 mb-0 text-white text-uppercase" style="letter-spacing: 0.5px;">Tổng doanh thu</h5>
                            <div class="avatar-sm">
                                <span class="avatar-title rounded-circle bg-white bg-opacity-25 font-size-20 text-white">
                                    <i class="bx bx-dollar-circle"></i>
                                </span>
                            </div>
                        </div>
                        <div class="text-white">
                            <h3 class="mb-1 text-white fw-bold">@Model.TotalRevenue.ToString("N0") ₫</h3>
                            <p class="text-white-50 mb-0 font-size-11"><i class="mdi mdi-arrow-up-bold me-1"></i> Doanh thu hàng hóa gốc</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Lợi nhuận thực tế -->
            <div class="col-md-4 animated-item" style="animation-delay: 0.2s;">
                <div class="card stat-card-premium bg-gradient-profit h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="font-size-13 mb-0 text-white text-uppercase" style="letter-spacing: 0.5px;">Lợi nhuận ròng</h5>
                            <div class="avatar-sm">
                                <span class="avatar-title rounded-circle bg-white bg-opacity-25 font-size-20 text-white">
                                    <i class="bx bx-trending-up"></i>
                                </span>
                            </div>
                        </div>
                        <div class="text-white">
                            <h3 class="mb-1 text-white fw-bold">@Model.TotalProfit.ToString("N0") ₫</h3>
                            <p class="text-white-50 mb-0 font-size-11"><i class="mdi mdi-shield-check me-1"></i> Đã khấu trừ mọi chi phí</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Tổng đơn hàng -->
            <div class="col-md-4 animated-item" style="animation-delay: 0.25s;">
                <div class="card stat-card-premium bg-gradient-success h-100">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="font-size-13 mb-0 text-white text-uppercase" style="letter-spacing: 0.5px;">Số đơn thành công</h5>
                            <div class="avatar-sm">
                                <span class="avatar-title rounded-circle bg-white bg-opacity-25 font-size-20 text-white">
                                    <i class="bx bx-shopping-bag"></i>
                                </span>
                            </div>
                        </div>
                        <div class="text-white">
                            <h3 class="mb-1 text-white fw-bold">@Model.TotalOrders đơn</h3>
                            <p class="text-white-50 mb-0 font-size-11"><i class="mdi mdi-check-circle me-1"></i> Tỉ lệ bàn giao @Model.FulfillmentRate%</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- WORKBENCH: Quick Actions & Operations Alerts -->
<div class="row g-4 mb-4">
    <!-- Workbench Shortcuts & To-Do List -->
    <div class="col-xl-8 animated-item" style="animation-delay: 0.3s;">
        <div class="card card-glass h-100 p-4">
            <h4 class="card-title fw-bold text-dark font-size-16 mb-1">Cổng Làm Việc Người Bán</h4>
            <p class="text-muted font-size-12 mb-4">Lối tắt nhanh đến các tính năng vận hành quan trọng của gian hàng.</p>
            
            <div class="row g-3 mb-4">
                <div class="col-6 col-sm-3">
                    <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="btn btn-light w-100 py-3 border-0 rounded-3 text-center d-block hover-lift" style="background: rgba(85, 110, 230, 0.06); color: #556ee6;">
                        <i class="bx bx-plus-circle font-size-24 mb-2 d-block"></i>
                        <span class="fw-semibold font-size-12">Thêm Sản phẩm</span>
                    </a>
                </div>
                <div class="col-6 col-sm-3">
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-light w-100 py-3 border-0 rounded-3 text-center d-block hover-lift" style="background: rgba(52, 195, 143, 0.06); color: #34c38f;">
                        <i class="bx bx-package font-size-24 mb-2 d-block"></i>
                        <span class="fw-semibold font-size-12">Kho Sản phẩm</span>
                    </a>
                </div>
                <div class="col-6 col-sm-3">
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-light w-100 py-3 border-0 rounded-3 text-center d-block hover-lift" style="background: rgba(241, 180, 76, 0.06); color: #f1b44c;">
                        <i class="bx bx-cart font-size-24 mb-2 d-block"></i>
                        <span class="fw-semibold font-size-12">Xem Đơn hàng</span>
                    </a>
                </div>
                <div class="col-6 col-sm-3">
                    <a asp-area="Admin" asp-controller="Statistics" asp-action="Seller" class="btn btn-light w-100 py-3 border-0 rounded-3 text-center d-block hover-lift" style="background: rgba(127, 0, 255, 0.06); color: #7f00ff;">
                        <i class="bx bx-line-chart font-size-24 mb-2 d-block"></i>
                        <span class="fw-semibold font-size-12">Trang Chiến lược</span>
                    </a>
                </div>
            </div>

            <!-- "Việc cần làm" (To-Do List widget) -->
            <div class="border-top pt-4">
                <h5 class="font-size-14 fw-bold mb-3 text-dark"><i class="bx bx-task me-1 text-primary"></i> Danh sách cần xử lý</h5>
                <div class="row g-3 text-center">
                    <div class="col-3">
                        <div class="p-3 rounded-3" style="background: #f8f9fa;">
                            <h3 class="fw-bold text-primary mb-1">@Model.TotalOrders</h3>
                            <p class="text-muted font-size-11 mb-0">Đơn chờ đóng gói</p>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="p-3 rounded-3" style="background: #f8f9fa;">
                            <h3 class="fw-bold text-danger mb-1">@Model.LowStockItemsCount</h3>
                            <p class="text-muted font-size-11 mb-0">Hết/Sắp hết hàng</p>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="p-3 rounded-3" style="background: #f8f9fa;">
                            <h3 class="fw-bold text-warning mb-1">@Model.ReturnRate%</h3>
                            <p class="text-muted font-size-11 mb-0">Tỉ lệ hoàn đơn</p>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="p-3 rounded-3" style="background: #f8f9fa;">
                            <h3 class="fw-bold text-success mb-1">@Model.TotalProducts</h3>
                            <p class="text-muted font-size-11 mb-0">Tổng sản phẩm kho</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification Center -->
    <div class="col-xl-4 animated-item" style="animation-delay: 0.35s;">
        <div class="card card-glass h-100 p-4">
            <h4 class="card-title fw-bold text-dark font-size-16 mb-1">Bảng Tin Cảnh Báo</h4>
            <p class="text-muted font-size-12 mb-4">Các tin tức, cảnh báo hoạt động quan trọng từ Sellzy.</p>

            <div class="d-flex flex-column gap-3 overflow-auto" style="max-height: 260px;">
                @if (Model.LowStockItemsCount > 0)
                {
                    <div class="d-flex gap-3 p-3 rounded-3" style="background: rgba(244, 106, 106, 0.05); border-left: 3px solid var(--skote-danger);">
                        <div class="text-danger"><i class="bx bx-error font-size-20"></i></div>
                        <div>
                            <h6 class="font-size-12 fw-bold text-danger mb-1">CẢNH BÁO KHO HÀNG</h6>
                            <p class="font-size-11 text-muted mb-0">Có @Model.LowStockItemsCount sản phẩm của bạn sắp hết hàng (dưới 10 sp). Hãy bổ sung tồn kho ngay.</p>
                        </div>
                    </div>
                }
                
                <div class="d-flex gap-3 p-3 rounded-3" style="background: rgba(85, 110, 230, 0.05); border-left: 3px solid var(--skote-primary);">
                    <div class="text-primary"><i class="bx bx-bell font-size-20"></i></div>
                    <div>
                        <h6 class="font-size-12 fw-bold text-primary mb-1">CẬP NHẬT CHÍNH SÁCH</h6>
                        <p class="font-size-11 text-muted mb-0">Hệ thống đã cập nhật tỷ lệ chiết khấu và thuế theo cài đặt tài chính mới nhất của sàn.</p>
                    </div>
                </div>

                <div class="d-flex gap-3 p-3 rounded-3" style="background: rgba(52, 195, 143, 0.05); border-left: 3px solid var(--skote-success);">
                    <div class="text-success"><i class="bx bx-check-shield font-size-20"></i></div>
                    <div>
                        <h6 class="font-size-12 fw-bold text-success mb-1">ĐẠT CHỈ TIÊU VẬN HÀNH</h6>
                        <p class="font-size-11 text-muted mb-0">Cửa hàng của bạn đạt điểm uy tín vận hành 95% và được gắn nhãn "Shop Uy Tín" tuần này.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <!-- Category Pie Chart -->
    <div class="col-xl-4 animated-item" style="animation-delay: 0.4s;">
        <div class="card card-glass h-100">
            <div class="card-body p-4">
                <h4 class="card-title mb-1 fw-bold text-dark font-size-16">Cơ cấu Ngành hàng</h4>
                <p class="text-muted font-size-12 mb-4">Tỷ lệ phân chia sản phẩm bán ra theo từng nhóm hàng.</p>
                <div id="shop-category-pie" class="apex-charts"></div>
            </div>
        </div>
    </div>
    
    <!-- Top 5 Products Table -->
    <div class="col-xl-8 animated-item" style="animation-delay: 0.45s;">
        <div class="card card-glass h-100">
            <div class="card-body p-4">
                <h4 class="card-title mb-1 fw-bold text-dark font-size-16">Top 5 Sản phẩm Bán chạy nhất</h4>
                <p class="text-muted font-size-12 mb-4">Top 5 sản phẩm mang lại doanh thu đóng góp nhiều nhất.</p>
                
                <div class="table-responsive">
                    <table class="table align-middle table-nowrap table-hover mb-0">
                        <thead class="table-light table-opacity">
                            <tr class="text-uppercase font-size-11 fw-bold text-muted" style="letter-spacing: 0.5px;">
                                <th style="width: 50px;">Hạng</th>
                                <th>Tên sản phẩm</th>
                                <th class="text-center">Số lượt bán</th>
                                <th class="text-end">Doanh thu đóng góp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopProductNames == null || !Model.TopProductNames.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4">Chưa có dữ liệu bán chạy.</td>
                                </tr>
                            }
                            else
                            {
                                for (int i = 0; i < Model.TopProductNames.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <span class="product-rank-badge @(i==0 ? "bg-rank-1" : i==1 ? "bg-rank-2" : i==2 ? "bg-rank-3" : "bg-rank-other")">
                                                @(i + 1)
                                            </span>
                                        </td>
                                        <td>
                                            <h5 class="font-size-13 fw-semibold text-dark mb-0">@Model.TopProductNames[i]</h5>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-success bg-soft text-success font-size-11 rounded-pill px-2 py-1">
                                                @Model.TopProductSales[i] lượt bán
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold text-primary font-size-13">
                                            @Model.TopProductRevenue[i].ToString("N0") ₫
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Knob Indicators Section wrapped in premium visual layout -->
<div class="row g-4 mb-4">
    <div class="col-xl-4 col-md-6 animated-item" style="animation-delay: 0.5s;">
        <div class="card card-glass text-center h-100 p-3">
            <div class="card-body">
                <h5 class="card-title mb-1 fw-bold text-dark font-size-15">Mức độ Hài lòng</h5>
                <p class="text-muted font-size-12 mb-4">Điểm phản hồi thực tế từ xếp hạng đánh giá.</p>
                <div class="position-relative d-inline-block">
                    <input class="knob" data-width="130" data-height="130" data-linecap="round" data-fgColor="#556ee6" data-bgColor="#f1f3f5" value="@Model.CustomerSatisfactionScore" data-readOnly="true" data-thickness=".12" />
                    <i class="bx bx-smile text-primary position-absolute font-size-24" style="top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;"></i>
                </div>
                <p class="text-muted mt-3 font-size-12 mb-0">Đánh giá chung: <strong class="text-primary">@(Model.AverageRating.ToString("F1")) / 5.0 ★</strong></p>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 animated-item" style="animation-delay: 0.55s;">
        <div class="card card-glass text-center h-100 p-3">
            <div class="card-body">
                <h5 class="card-title mb-1 fw-bold text-dark font-size-15">Kho hàng An toàn</h5>
                <p class="text-muted font-size-12 mb-4">Mức độ an toàn của chuỗi cung ứng sản phẩm.</p>
                <div class="position-relative d-inline-block">
                    <input class="knob" data-width="130" data-height="130" data-linecap="round" data-fgColor="#34c38f" data-bgColor="#f1f3f5" value="@Model.StockLevelHealth" data-readOnly="true" data-thickness=".12" />
                    <i class="bx bx-shield-check text-success position-absolute font-size-24" style="top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;"></i>
                </div>
                <p class="text-muted mt-3 font-size-12 mb-0">Hàng tồn luôn được duy trì ở mức an toàn.</p>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 animated-item" style="animation-delay: 0.6s;">
        <div class="card card-glass text-center h-100 p-3">
            <div class="card-body">
                <h5 class="card-title mb-1 fw-bold text-dark font-size-15">Uy tín Gian hàng</h5>
                <p class="text-muted font-size-12 mb-4">Chỉ số đo lường hiệu suất vận hành chuẩn sàn.</p>
                <div class="position-relative d-inline-block">
                    <input class="knob" data-width="130" data-height="130" data-linecap="round" data-fgColor="#f1b44c" data-bgColor="#f1f3f5" value="95" data-readOnly="true" data-thickness=".12" />
                    <i class="bx bx-award text-warning position-absolute font-size-24" style="top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none;"></i>
                </div>
                <p class="text-muted mt-3 font-size-12 mb-0">Gian hàng đạt danh hiệu <strong class="text-warning">Shop Uy Tín</strong>.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/admin/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="/admin/assets/libs/jquery-knob/jquery.knob.min.js"></script>

    <script>
        $(function() {
            // Knob initialization with custom premium options
            $(".knob").knob({
                'draw': function() {
                    $(this.i).css({
                        'font-weight': '700',
                        'font-family': 'Outfit, sans-serif',
                        'color': '#333'
                    });
                }
            });

            // 1. Shop Category Distribution (Apex Donut - much more premium than normal pie!)
            var categoryOptions = {
                chart: { 
                    height: 320, 
                    type: 'donut',
                    fontFamily: 'Inter, sans-serif'
                },
                series: @Html.Raw(Json.Serialize(Model.ShopCategoryCounts)),
                labels: @Html.Raw(Json.Serialize(Model.ShopCategoryNames)),
                colors: ['#6a11cb', '#34c38f', '#f1b44c', '#50a5f1', '#f46a6a'],
                plotOptions: {
                    pie: {
                        donut: {
                            size: '75%',
                            labels: {
                                show: true,
                                name: { show: true, fontSize: '14px', fontWeight: '600' },
                                value: { 
                                    show: true, 
                                    fontSize: '18px', 
                                    fontWeight: '700',
                                    formatter: function(val) {
                                        return val + " sp";
                                    }
                                },
                                total: {
                                    show: true,
                                    label: 'Tổng sản phẩm',
                                    formatter: function (w) {
                                        return w.globals.seriesTotals.reduce(function(a, b) {
                                            return a + b;
                                        }, 0) + " sp";
                                    }
                                }
                            }
                        }
                    }
                },
                legend: { position: 'bottom' },
                stroke: { width: 0 }
            };
            new ApexCharts(document.querySelector("#shop-category-pie"), categoryOptions).render();
        });
    </script>
}
