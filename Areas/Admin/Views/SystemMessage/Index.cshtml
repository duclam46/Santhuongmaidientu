@model IEnumerable<DOAN_BANHANG.Models.SystemNotification>
@{
    ViewData["Title"] = "Thông báo hệ thống";
    var list = Model.ToList();
    var totalCount = list.Count;
    var allTargetCount = list.Count(n => n.TargetType == "All");
    var roleTargetCount = list.Count(n => n.TargetType == "Role");
    var accountTargetCount = list.Count(n => n.TargetType == "Account");
}

@section Styles {
    <style>
        .sm-hero {
            background: radial-gradient(circle at 88% 18%, rgba(255, 235, 105, 0.16) 0%, transparent 46%),
                        linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
            border-radius: 22px;
            padding: 26px 30px;
            color: #ffffff;
            margin-bottom: 24px;
            box-shadow: 0 18px 38px -16px rgba(0, 38, 42, 0.34);
        }
        .sm-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-top: 18px;
        }
        @@media (max-width: 991px) {
            .sm-kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        .sm-kpi-card {
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 16px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .sm-kpi-ic {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: rgba(255, 235, 105, 0.18);
            color: #FFEB69;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
        .sm-sender-avatar {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: linear-gradient(135deg, #088178 0%, #04464C 100%);
            color: #FFEB69;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 13px;
            flex-shrink: 0;
        }
        .sm-preview {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
}

<!-- HERO HEADER -->
<div class="sm-hero">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h4 class="text-white fw-bold mb-1">
                <i class="bx bx-broadcast text-warning me-1"></i>Thông báo hệ thống
            </h4>
            <p class="mb-0 small" style="color: rgba(255,255,255,0.82);">
                Quản lý lịch sử phát thông báo tức thời tới toàn bộ người dùng, nhóm đối tác bán hàng hoặc từng tài khoản cụ thể.
            </p>
        </div>
        <a asp-action="Create" class="btn btn-sm rounded-pill px-3.5 py-2 fw-bold shadow-sm" style="background: #FFEB69; color: #161C24;">
            <i class="bx bx-send me-1"></i>Soạn thông báo mới
        </a>
    </div>

    <div class="sm-kpi-grid">
        <div class="sm-kpi-card">
            <span class="sm-kpi-ic"><i class="bx bx-bell"></i></span>
            <div>
                <div class="fs-5 fw-bold text-white lh-1">@totalCount</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Tổng thông báo đã gửi</div>
            </div>
        </div>
        <div class="sm-kpi-card">
            <span class="sm-kpi-ic" style="background: rgba(56,189,248,0.22); color: #7DD3FC;"><i class="bx bx-globe"></i></span>
            <div>
                <div class="fs-5 fw-bold text-white lh-1">@allTargetCount</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Gửi toàn hệ thống</div>
            </div>
        </div>
        <div class="sm-kpi-card">
            <span class="sm-kpi-ic"><i class="bx bx-group"></i></span>
            <div>
                <div class="fs-5 fw-bold lh-1" style="color: #FFEB69;">@roleTargetCount</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Gửi theo nhóm quyền</div>
            </div>
        </div>
        <div class="sm-kpi-card">
            <span class="sm-kpi-ic" style="background: rgba(251,191,36,0.22); color: #FDE68A;"><i class="bx bx-user"></i></span>
            <div>
                <div class="fs-5 fw-bold text-white lh-1">@accountTargetCount</div>
                <div class="small" style="color: rgba(255,255,255,0.78);">Gửi đích danh cá nhân</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-4">
        @if (TempData["SuccessMessage"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 rounded-3" role="alert">
                <i class="bx bx-check-circle fs-5"></i>
                <div>@okMsg</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- THANH LỌC NHANH -->
        <div class="border rounded-3 px-3 py-2.5 bg-light mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex flex-wrap align-items-center gap-1.5">
                    <span class="small fw-bold text-secondary me-1"><i class="bx bx-filter-alt me-1"></i>Đối tượng:</span>
                    <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 fw-semibold sm-filter-btn" data-target="">Tất cả</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold sm-filter-btn" data-target="All">Toàn hệ thống</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold sm-filter-btn" data-target="Role">Theo nhóm</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold sm-filter-btn" data-target="Account">Cá nhân</button>
                </div>
                <div class="input-group input-group-sm" style="max-width: 340px;">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bx bx-search"></i></span>
                    <input type="text" id="smSearchInput" class="form-control border-start-0 ps-0" placeholder="Tìm theo tiêu đề hoặc nội dung..." />
                </div>
            </div>
        </div>

        <!-- BẢNG LỊCH SỬ THÔNG BÁO -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="smTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 155px;">Thời gian gửi</th>
                        <th>Nội dung thông báo</th>
                        <th style="width: 190px;">Đối tượng nhận</th>
                        <th style="width: 210px;">Người phát hành</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!list.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="bx bx-bell-off display-5 text-muted d-block mb-2"></i>
                                <div class="fw-bold text-dark">Chưa có thông báo hệ thống nào</div>
                                <div class="text-muted small mt-1">Bấm <strong>Soạn thông báo mới</strong> để gửi thông báo đầu tiên tới người dùng.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in list)
                        {
                            var localTime = item.CreatedAt.ToLocalTime();
                            var senderName = item.SentByAdmin?.Profile?.FullName ?? item.SentByAdmin?.Email ?? "Quản trị viên";
                            var initial = !string.IsNullOrWhiteSpace(senderName) ? senderName.Trim()[0].ToString().ToUpperInvariant() : "Q";
                            <tr class="sm-row" data-target="@item.TargetType" data-search="@($"{item.Title} {item.Content}".ToLowerInvariant())">
                                <td>
                                    <div class="fw-semibold text-dark small">@localTime.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@localTime.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark mb-0.5">@item.Title</div>
                                    <div class="small text-muted sm-preview" title="@item.Content">@item.Content</div>
                                </td>
                                <td>
                                    @if (item.TargetType == "All")
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-1">
                                            <i class="bx bx-globe me-1"></i>Toàn hệ thống
                                        </span>
                                    }
                                    else if (item.TargetType == "Role")
                                    {
                                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle rounded-pill px-2.5 py-1">
                                            <i class="bx bx-group me-1"></i>@(item.TargetRole == "Shop" ? "Đối tác bán hàng" : "Khách hàng")
                                        </span>
                                    }
                                    else if (item.TargetType == "Account")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1">
                                            <i class="bx bx-user me-1"></i>Tài khoản #@item.TargetAccountId
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="sm-sender-avatar">@initial</span>
                                        <span class="small fw-semibold text-dark text-truncate">@senderName</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            let activeTarget = '';
            function applyFilters() {
                const q = ($('#smSearchInput').val() || '').trim().toLowerCase();
                $('.sm-row').each(function () {
                    const $row = $(this);
                    const targetMatch = !activeTarget || $row.data('target') === activeTarget;
                    const textMatch = !q || (($row.data('search') || '').indexOf(q) !== -1);
                    $row.toggle(targetMatch && textMatch);
                });
            }

            $('.sm-filter-btn').on('click', function () {
                $('.sm-filter-btn').removeClass('btn-dark').addClass('btn-outline-secondary');
                $(this).removeClass('btn-outline-secondary').addClass('btn-dark');
                activeTarget = $(this).data('target') || '';
                applyFilters();
            });

            $('#smSearchInput').on('input', applyFilters);
        })();
    </script>
}
