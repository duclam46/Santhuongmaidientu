@model DOAN_BANHANG.Models.SystemNotification
@{
    ViewData["Title"] = "Soạn thông báo hệ thống";
    var accounts = ViewBag.Accounts as List<DOAN_BANHANG.Models.Account>;
}

@section Styles {
    <style>
        .sm-form-hero {
            background: radial-gradient(circle at 88% 18%, rgba(255, 235, 105, 0.16) 0%, transparent 46%),
                        linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
            border-radius: 22px;
            padding: 22px 28px;
            color: #ffffff;
            margin-bottom: 24px;
            box-shadow: 0 18px 38px -16px rgba(0, 38, 42, 0.34);
        }
        .sm-target-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
        }
        @@media (max-width: 575px) {
            .sm-target-grid { grid-template-columns: 1fr; }
        }
        .sm-target-option {
            cursor: pointer;
            display: block;
            margin: 0;
        }
        .sm-target-option input {
            display: none;
        }
        .sm-target-box {
            border: 2px solid #E2E8F0;
            border-radius: 16px;
            padding: 16px 12px;
            text-align: center;
            background: #F8FAFC;
            transition: all 0.2s ease;
            height: 100%;
        }
        .sm-target-box i {
            font-size: 24px;
            color: #64748B;
            display: block;
            margin-bottom: 6px;
        }
        .sm-target-option input:checked + .sm-target-box {
            border-color: #088178;
            background: #E6F4F3;
            box-shadow: 0 8px 16px -8px rgba(8, 129, 120, 0.35);
        }
        .sm-target-option input:checked + .sm-target-box i,
        .sm-target-option input:checked + .sm-target-box .sm-target-title {
            color: #088178;
        }
        .sm-preview-shell {
            background: #F1F5F9;
            border: 1px solid #E2E8F0;
            border-radius: 18px;
            padding: 16px;
        }
        .sm-notif-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 16px;
            border: 1px solid #E2E8F0;
            box-shadow: 0 8px 20px -10px rgba(15, 23, 42, 0.14);
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }
        .sm-notif-ic {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #00262A 0%, #088178 100%);
            color: #FFEB69;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
    </style>
}

<!-- HERO HEADER -->
<div class="sm-form-hero">
    <a asp-action="Index" class="btn btn-sm rounded-pill px-3 mb-2" style="background: rgba(255,255,255,0.14); color: #ffffff; border: 1px solid rgba(255,255,255,0.22);">
        <i class="bx bx-left-arrow-alt me-1"></i>Lịch sử thông báo
    </a>
    <h4 class="text-white fw-bold mb-1"><i class="bx bx-send text-warning me-1"></i>Soạn Thông báo hệ thống</h4>
    <p class="mb-0 small" style="color: rgba(255,255,255,0.82);">
        Soạn nội dung và chọn nhóm đối tượng nhận để gửi thông báo tức thời tới người dùng trên toàn sàn Sellzy.
    </p>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- CỘT TRÁI: SOẠN THÔNG BÁO -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bx bx-edit text-primary me-2"></i>1. Nội dung thông báo</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Tiêu đề thông báo <span class="text-danger">*</span></label>
                        <input asp-for="Title" id="inputTitle" class="form-control" required placeholder="Ví dụ: Chương trình ưu đãi cuối tuần hoặc Thông báo bảo trì hệ thống..." autocomplete="off" />
                    </div>
                    <div class="mb-0">
                        <label asp-for="Content" class="form-label fw-semibold">Nội dung chi tiết <span class="text-danger">*</span></label>
                        <textarea asp-for="Content" id="inputContent" rows="5" class="form-control" required placeholder="Nhập nội dung chi tiết muốn gửi đến người dùng..."></textarea>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bx bx-target-lock text-primary me-2"></i>2. Đối tượng nhận thông báo</h5>
                </div>
                <div class="card-body p-4">
                    <div class="sm-target-grid mb-3">
                        <label class="sm-target-option">
                            <input type="radio" asp-for="TargetType" value="All" id="targetAll" checked />
                            <div class="sm-target-box">
                                <i class="bx bx-globe"></i>
                                <div class="fw-bold small sm-target-title">Toàn hệ thống</div>
                                <div class="text-muted" style="font-size: 11.5px;">Tất cả tài khoản</div>
                            </div>
                        </label>

                        <label class="sm-target-option">
                            <input type="radio" asp-for="TargetType" value="Role" id="targetRole" />
                            <div class="sm-target-box">
                                <i class="bx bx-group"></i>
                                <div class="fw-bold small sm-target-title">Theo nhóm quyền</div>
                                <div class="text-muted" style="font-size: 11.5px;">Khách hàng / Đối tác</div>
                            </div>
                        </label>

                        <label class="sm-target-option">
                            <input type="radio" asp-for="TargetType" value="Account" id="targetAccount" />
                            <div class="sm-target-box">
                                <i class="bx bx-user"></i>
                                <div class="fw-bold small sm-target-title">Cá nhân</div>
                                <div class="text-muted" style="font-size: 11.5px;">Chọn đích danh</div>
                            </div>
                        </label>
                    </div>

                    <div id="roleSelectBox" class="p-3 rounded-3 bg-light border mb-3" style="display: none;">
                        <label asp-for="TargetRole" class="form-label fw-semibold small">Chọn nhóm đối tượng nhận</label>
                        <select asp-for="TargetRole" id="selectTargetRole" class="form-select">
                            <option value="Customer">Tất cả Khách hàng mua sắm</option>
                            <option value="Shop">Tất cả Đối tác bán hàng (Shop)</option>
                        </select>
                    </div>

                    <div id="accountSelectBox" class="p-3 rounded-3 bg-light border mb-3" style="display: none;">
                        <label asp-for="TargetAccountId" class="form-label fw-semibold small">Chọn tài khoản nhận đích danh</label>
                        <select asp-for="TargetAccountId" id="selectTargetAccount" class="form-select">
                            <option value="">-- Chọn tài khoản người nhận --</option>
                            @if (accounts != null)
                            {
                                foreach (var acc in accounts)
                                {
                                    var name = acc.Profile?.ShopName ?? acc.Profile?.FullName ?? acc.Email;
                                    <option value="@acc.Id">@name (@acc.Email) — @acc.Role</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold shadow-sm">
                            <i class="bx bx-send me-1"></i>Phát thông báo ngay
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: XEM TRƯỚC TRỰC TIẾP -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden sticky-top" style="top: 84px;">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bx bx-show text-primary me-2"></i>Xem trước thông báo</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3 d-flex align-items-center justify-content-between">
                        <span class="small text-muted fw-semibold">Phạm vi gửi:</span>
                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1" id="previewRecipient">
                            <i class="bx bx-globe me-1"></i>Toàn hệ thống
                        </span>
                    </div>

                    <div class="sm-preview-shell mb-3">
                        <div class="small fw-bold text-secondary mb-2 d-flex align-items-center justify-content-between">
                            <span><i class="bx bx-bell me-1"></i>Hộp thư thông báo Sellzy</span>
                            <span class="text-muted fw-normal">Vừa xong</span>
                        </div>
                        <div class="sm-notif-card">
                            <div class="sm-notif-ic"><i class="bx bx-broadcast"></i></div>
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="fw-bold text-dark small mb-1" id="previewTitle">Tiêu đề thông báo</div>
                                <div class="small text-muted" style="white-space: pre-line;" id="previewContent">Nội dung thông báo sẽ hiển thị trực tiếp tại đây khi bạn nhập ở khung bên trái...</div>
                                <div class="text-muted mt-2" style="font-size: 11px;">
                                    <i class="bx bx-shield-quarter text-primary me-1"></i>Hệ thống quản trị Sellzy
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info rounded-3 mb-0 small d-flex align-items-start gap-2">
                        <i class="bx bx-info-circle fs-5 flex-shrink-0"></i>
                        <span>Thông báo sẽ được đẩy tức thời tới các tài khoản đang trực tuyến và lưu lại trong lịch sử thông báo của người nhận.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const radioAll = document.getElementById("targetAll");
            const radioRole = document.getElementById("targetRole");
            const radioAccount = document.getElementById("targetAccount");

            const roleSelectBox = document.getElementById("roleSelectBox");
            const accountSelectBox = document.getElementById("accountSelectBox");
            const selectTargetRole = document.getElementById("selectTargetRole");
            const selectTargetAccount = document.getElementById("selectTargetAccount");

            const inputTitle = document.getElementById("inputTitle");
            const inputContent = document.getElementById("inputContent");
            const previewTitle = document.getElementById("previewTitle");
            const previewContent = document.getElementById("previewContent");
            const previewRecipient = document.getElementById("previewRecipient");

            function updateRecipientBadge() {
                if (radioAll.checked) {
                    previewRecipient.innerHTML = '<i class="bx bx-globe me-1"></i>Toàn hệ thống';
                } else if (radioRole.checked) {
                    const roleLabel = selectTargetRole.value === 'Shop' ? 'Tất cả Đối tác bán hàng' : 'Tất cả Khách hàng';
                    previewRecipient.innerHTML = '<i class="bx bx-group me-1"></i>' + roleLabel;
                } else if (radioAccount.checked) {
                    const opt = selectTargetAccount.options[selectTargetAccount.selectedIndex];
                    const accLabel = (opt && opt.value) ? opt.text : 'Chưa chọn tài khoản';
                    previewRecipient.innerHTML = '<i class="bx bx-user me-1"></i>' + accLabel;
                }
            }

            inputTitle.addEventListener("input", function () {
                previewTitle.innerText = this.value.trim() || "Tiêu đề thông báo";
            });

            inputContent.addEventListener("input", function () {
                previewContent.innerText = this.value.trim() || "Nội dung thông báo sẽ hiển thị trực tiếp tại đây khi bạn nhập ở khung bên trái...";
            });

            function toggleBoxes() {
                roleSelectBox.style.display = radioRole.checked ? "block" : "none";
                accountSelectBox.style.display = radioAccount.checked ? "block" : "none";
                updateRecipientBadge();
            }

            radioAll.addEventListener("change", toggleBoxes);
            radioRole.addEventListener("change", toggleBoxes);
            radioAccount.addEventListener("change", toggleBoxes);
            selectTargetRole.addEventListener("change", updateRecipientBadge);
            selectTargetAccount.addEventListener("change", updateRecipientBadge);

            toggleBoxes();
        });
    </script>
}
