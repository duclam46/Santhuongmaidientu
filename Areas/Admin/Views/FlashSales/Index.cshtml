@model DOAN_BANHANG.ViewModels.AdminFlashSaleListVm

@{
    ViewData["Title"] = "Chiến dịch Flash Sale";
    var viVn = global::System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var nowLocal = DateTime.Now;
    var items = Model.Items ?? new List<DOAN_BANHANG.ViewModels.AdminFlashSaleConfiguredItemVm>();

    var total = items.Count;
    var ongoing = items.Count(i => i.SaleStartDate.HasValue && i.SaleEndDate.HasValue && i.SaleStartDate.Value <= nowLocal && i.SaleEndDate.Value >= nowLocal);
    var upcoming = items.Count(i => i.SaleStartDate.HasValue && i.SaleStartDate.Value > nowLocal);
    var ended = items.Count(i => i.SaleEndDate.HasValue && i.SaleEndDate.Value < nowLocal);
}

<style>
    :root {
        --fs-teal: #0b5c56;
        --fs-teal-dark: #063532;
        --fs-emerald: #10b981;
        --fs-amber: #d97706;
        --fs-red: #dc2626;
        --fs-border: #e2e8f0;
    }

    .fs-hero {
        background: linear-gradient(135deg, #063532 0%, #0b5c56 58%, #0f766e 100%);
        border-radius: 18px;
        padding: 24px 28px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(6, 53, 50, 0.16);
        margin-bottom: 20px;
    }
    .fs-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -30px;
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, rgba(245, 158, 11, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .fs-hero-title {
        font-size: 1.45rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -0.02em;
        margin-bottom: 4px;
    }
    .fs-hero-sub { color: rgba(255, 255, 255, 0.8); font-size: 0.88rem; }

    .fs-btn-setup {
        background: #10b981;
        color: #fff;
        border: none;
        border-radius: 11px;
        padding: 10px 20px;
        font-weight: 700;
        font-size: 0.88rem;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35);
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .fs-btn-setup:hover { background: #059669; color: #fff; transform: translateY(-1px); }

    .fs-btn-danger-ghost {
        background: rgba(239, 68, 68, 0.18);
        color: #fecaca;
        border: 1px solid rgba(248, 113, 113, 0.4);
        border-radius: 11px;
        padding: 10px 16px;
        font-weight: 600;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }
    .fs-btn-danger-ghost:hover { background: #dc2626; color: #fff; border-color: #dc2626; }

    /* KPI Cards */
    .fs-kpi-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--fs-border);
        padding: 18px 20px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        height: 100%;
        transition: all 0.2s ease;
    }
    .fs-kpi-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06); }
    .fs-kpi-label { font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; margin-bottom: 4px; }
    .fs-kpi-val { font-size: 1.55rem; font-weight: 800; color: #0f172a; line-height: 1.15; }
    .fs-kpi-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.45rem; flex-shrink: 0; }

    /* Main Panel */
    .fs-main-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid var(--fs-border);
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.035);
        overflow: hidden;
    }

    .fs-tabs-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 22px;
        border-bottom: 1px solid var(--fs-border);
        background: #fafcff;
    }

    #flashsale-status-tabs .nav-link {
        border-radius: 10px;
        padding: 8px 15px;
        color: #475569;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.18s;
    }
    #flashsale-status-tabs .nav-link:hover { color: var(--fs-teal); background: #f1f5f9; }
    #flashsale-status-tabs .nav-link.active {
        background: var(--fs-teal);
        color: #fff;
        box-shadow: 0 4px 10px rgba(11, 92, 86, 0.22);
    }

    .fs-search-box { position: relative; max-width: 340px; width: 100%; }
    .fs-search-box i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 1.05rem; }
    .fs-search-box input {
        padding-left: 38px;
        border-radius: 10px;
        border: 1px solid #cbd5e1;
        height: 39px;
        font-size: 0.86rem;
    }
    .fs-search-box input:focus { border-color: var(--fs-teal); box-shadow: 0 0 0 3px rgba(11, 92, 86, 0.12); }

    /* Table */
    .fs-table { margin-bottom: 0; }
    .fs-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 13px 16px;
        border-bottom: 1.5px solid var(--fs-border);
        white-space: nowrap;
    }
    .fs-table tbody td {
        padding: 14px 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }
    .fs-table tbody tr:hover td { background: #f8fafc; }

    .fs-prod-img {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        object-fit: cover;
        border: 1px solid #e2e8f0;
        background: #fff;
        flex-shrink: 0;
    }

    .fs-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .fs-status-live { background: #ecfdf5; color: #047857; }
    .fs-status-upcoming { background: #fffbeb; color: #b45309; }
    .fs-status-ended { background: #f1f5f9; color: #64748b; }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #10b981;
        border-radius: 50%;
        display: inline-block;
        animation: fsPulse 1.5s infinite;
    }
    @@keyframes fsPulse {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .fs-act-btn {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        border: none;
        transition: all 0.18s;
        text-decoration: none;
    }
    .fs-act-view { background: #f1f5f9; color: #334155; }
    .fs-act-view:hover { background: var(--fs-teal); color: #fff; }
    .fs-act-edit { background: #eff6ff; color: #2563eb; }
    .fs-act-edit:hover { background: #2563eb; color: #fff; }
    .fs-act-restart { background: #ecfdf5; color: #059669; }
    .fs-act-restart:hover { background: #059669; color: #fff; }
    .fs-act-del { background: #fef2f2; color: #dc2626; }
    .fs-act-del:hover { background: #dc2626; color: #fff; }
</style>

<!-- 1. HERO HEADER -->
<div class="fs-hero d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div style="position: relative; z-index: 2;">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge rounded-pill" style="background: rgba(245, 158, 11, 0.24); color: #fde68a; font-weight: 700; font-size: 0.72rem;">
                <i class="bx bxs-zap me-1"></i>KHUYẾN MÃI CHỚP NHOÁNG
            </span>
            @if (ongoing > 0)
            {
                <span class="badge rounded-pill" style="background: rgba(16, 185, 129, 0.22); color: #a7f3d0; font-weight: 700; font-size: 0.72rem;">
                    @ongoing đang chạy trực tiếp
                </span>
            }
        </div>
        <h3 class="fs-hero-title">
            <i class="bx bxs-zap me-2" style="color: #fbbf24;"></i>Chiến dịch Flash Sale
        </h3>
        <div class="fs-hero-sub">Quản lý khung giờ, mức giảm giá theo biến thể và theo dõi trạng thái các sự kiện giảm giá chớp nhoáng.</div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2" style="position: relative; z-index: 2;">
        @if (total > 0)
        {
            <form asp-area="Admin" asp-controller="FlashSales" asp-action="CancelEvent" method="post" class="d-inline"
                  onsubmit="return confirm('CẢNH BÁO: Bạn chuẩn bị hủy toàn bộ sự kiện FlashSale hiện tại! Hành động này không thể hoàn tác. Tiếp tục?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="fs-btn-danger-ghost">
                    <i class="bx bx-power-off"></i>Hủy toàn bộ sự kiện
                </button>
            </form>
        }
        <a asp-area="Admin" asp-controller="FlashSales" asp-action="Setup" class="fs-btn-setup">
            <i class="bx bx-plus-circle fs-5"></i>Tạo sự kiện mới
        </a>
    </div>
</div>

<!-- 2. KPI CARDS -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="fs-kpi-card">
            <div>
                <div class="fs-kpi-label">Tổng sản phẩm Sale</div>
                <div class="fs-kpi-val">@total</div>
            </div>
            <div class="fs-kpi-icon" style="background: rgba(11, 92, 86, 0.1); color: #0b5c56;">
                <i class="bx bx-package"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="fs-kpi-card">
            <div>
                <div class="fs-kpi-label">Đang diễn ra</div>
                <div class="fs-kpi-val text-success">@ongoing</div>
            </div>
            <div class="fs-kpi-icon" style="background: #ecfdf5; color: #059669;">
                <i class="bx bxs-zap"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="fs-kpi-card">
            <div>
                <div class="fs-kpi-label">Sắp diễn ra</div>
                <div class="fs-kpi-val text-warning">@upcoming</div>
            </div>
            <div class="fs-kpi-icon" style="background: #fffbeb; color: #d97706;">
                <i class="bx bx-calendar-event"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="fs-kpi-card">
            <div>
                <div class="fs-kpi-label">Đã kết thúc</div>
                <div class="fs-kpi-val text-secondary">@ended</div>
            </div>
            <div class="fs-kpi-icon" style="background: #f1f5f9; color: #64748b;">
                <i class="bx bx-history"></i>
            </div>
        </div>
    </div>
</div>

<!-- 3. MAIN TABLE PANEL -->
<div class="fs-main-card">
    <div class="fs-tabs-bar">
        <ul class="nav nav-pills gap-1" id="flashsale-status-tabs">
            <li class="nav-item">
                <a class="nav-link active" href="#" data-filter="all">Tất cả (@total)</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" data-filter="ongoing">Hoạt động &amp; Sắp tới (@(ongoing + upcoming))</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#" data-filter="ended">Đã kết thúc (@ended)</a>
            </li>
        </ul>

        <form method="get" class="fs-search-box">
            <i class="bx bx-search"></i>
            <input class="form-control" name="search" value="@Model.Search" placeholder="Tìm tên sản phẩm..." />
        </form>
    </div>

    @if (total == 0)
    {
        <div class="text-center py-5 px-3">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; border-radius: 20px; background: #fffbeb; color: #d97706; font-size: 2rem;">
                <i class="bx bxs-zap"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">Chưa có sự kiện Flash Sale nào</h5>
            <p class="text-muted small mb-4">Bạn chưa thiết lập chiến dịch Flash Sale nào cho cửa hàng.</p>
            <a asp-area="Admin" asp-controller="FlashSales" asp-action="Setup" class="fs-btn-setup">
                <i class="bx bx-plus-circle fs-5"></i>Thiết lập ngay
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table fs-table table-nowrap align-middle">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">Biến thể Sale</th>
                        <th class="text-end">Giá gốc</th>
                        <th class="text-end">Giá Flash Sale</th>
                        <th>Khung thời gian</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        var startUtc = item.SaleStartDate;
                        var endUtc = item.SaleEndDate;

                        var statusText = "—";
                        var statusClass = "fs-status-ended";
                        var statusData = "all";
                        var showPulse = false;

                        if (startUtc.HasValue && endUtc.HasValue)
                        {
                            if (endUtc.Value < nowLocal)
                            {
                                statusText = "Đã kết thúc";
                                statusClass = "fs-status-ended";
                                statusData = "ended";
                            }
                            else if (startUtc.Value > nowLocal)
                            {
                                statusText = "Sắp diễn ra";
                                statusClass = "fs-status-upcoming";
                                statusData = "ongoing";
                            }
                            else
                            {
                                statusText = "Đang diễn ra";
                                statusClass = "fs-status-live";
                                statusData = "ongoing";
                                showPulse = true;
                            }
                        }

                        var discountPct = (item.MinPrice > 0 && item.MinSalePrice.HasValue && item.MinSalePrice.Value > 0 && item.MinSalePrice.Value < item.MinPrice)
                            ? (int?)Math.Round((1m - (item.MinSalePrice.Value / item.MinPrice)) * 100m, 0, MidpointRounding.AwayFromZero)
                            : null;

                        <tr data-status="@statusData" class="flashsale-row">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(item.PrimaryImageUrl))
                                    {
                                        <img src="@item.PrimaryImageUrl" alt="@item.Name" class="fs-prod-img" onerror="this.src='/images/no-image.png'" />
                                    }
                                    else
                                    {
                                        <div class="fs-prod-img bg-light d-flex align-items-center justify-content-center text-muted">
                                            <i class="bx bx-image fs-4"></i>
                                        </div>
                                    }
                                    <div>
                                        <a asp-area="Admin" asp-controller="FlashSales" asp-action="Details" asp-route-id="@item.ProductId"
                                           class="fw-bold text-dark text-decoration-none d-block"
                                           style="max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            @item.Name
                                        </a>
                                        <div class="text-muted small">Mã SP: #@item.ProductId</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill px-3 py-1" style="background: rgba(11, 92, 86, 0.1); color: #0b5c56; font-weight: 700;">
                                    <i class="bx bx-layer me-1"></i>@item.VariantOnSaleCount SKU
                                </span>
                            </td>
                            <td class="text-end fw-semibold text-muted text-decoration-line-through">
                                @item.MinPrice.ToString("N0", viVn)₫
                            </td>
                            <td class="text-end">
                                @if (item.MinSalePrice.HasValue)
                                {
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <span class="fw-bold text-danger" style="font-size: 1.02rem;">@item.MinSalePrice.Value.ToString("N0", viVn)₫</span>
                                        @if (discountPct.HasValue && discountPct.Value > 0)
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger fw-bold">-@discountPct.Value%</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (startUtc.HasValue && endUtc.HasValue)
                                {
                                    <div class="d-flex flex-column gap-1">
                                        <div class="small fw-semibold text-success"><i class="bx bx-play-circle me-1"></i>@startUtc.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                        <div class="small fw-semibold text-danger"><i class="bx bx-stop-circle me-1"></i>@endUtc.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="fs-status-pill @statusClass">
                                    @if (showPulse) { <span class="pulse-dot"></span> }
                                    @statusText
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-area="Admin" asp-controller="FlashSales" asp-action="Details" asp-route-id="@item.ProductId"
                                       class="fs-act-btn fs-act-view" data-bs-toggle="tooltip" title="Xem chi tiết">
                                        <i class="bx bx-show-alt"></i>
                                    </a>
                                    <a asp-area="Admin" asp-controller="FlashSales" asp-action="Edit" asp-route-id="@item.ProductId"
                                       class="fs-act-btn fs-act-edit" data-bs-toggle="tooltip" title="Chỉnh sửa">
                                        <i class="bx bx-edit-alt"></i>
                                    </a>

                                    @if (statusText == "Đã kết thúc")
                                    {
                                        <a asp-area="Admin" asp-controller="FlashSales" asp-action="Setup" asp-route-restartProductId="@item.ProductId"
                                           class="fs-act-btn fs-act-restart" data-bs-toggle="tooltip" title="Bắt đầu lại">
                                            <i class="bx bx-play-circle"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <form asp-area="Admin" asp-controller="FlashSales" asp-action="CancelProduct" method="post" class="d-inline"
                                              onsubmit="return confirm('Hủy FlashSale của sản phẩm: @item.Name ?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="search" value="@Model.Search" />
                                            <button type="submit" class="fs-act-btn fs-act-del" data-bs-toggle="tooltip" title="Hủy sự kiện">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            $('#flashsale-status-tabs a').on('click', function(e) {
                e.preventDefault();
                $('#flashsale-status-tabs a').removeClass('active');
                $(this).addClass('active');

                var filter = $(this).data('filter');
                if (filter === 'all') {
                    $('.flashsale-row').fadeIn(200);
                } else {
                    $('.flashsale-row').each(function() {
                        if ($(this).data('status') === filter) {
                            $(this).fadeIn(200);
                        } else {
                            $(this).hide();
                        }
                    });
                }
            });
        });
    </script>
}
