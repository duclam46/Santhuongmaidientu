@model DOAN_BANHANG.ViewModels.ProductAdminFlashSaleVm

@{
    ViewData["Title"] = "Chi tiết Flash Sale";
    var viVn = global::System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var nowLocal = DateTime.Now;
    var variants = Model.Variants ?? new List<DOAN_BANHANG.ViewModels.ProductAdminFlashSaleVariantVm>();
    var count = variants.Count;
    decimal? minSale = variants
        .Where(v => v.SalePrice.HasValue)
        .Select(v => (decimal?)v.SalePrice!.Value)
        .DefaultIfEmpty((decimal?)null)
        .Min();

    decimal? maxSale = variants
        .Where(v => v.SalePrice.HasValue)
        .Select(v => (decimal?)v.SalePrice!.Value)
        .DefaultIfEmpty((decimal?)null)
        .Max();

    DateTime? startMin = variants
        .Where(v => v.SaleStartDate.HasValue)
        .Select(v => (DateTime?)v.SaleStartDate!.Value)
        .DefaultIfEmpty((DateTime?)null)
        .Min();

    DateTime? endMax = variants
        .Where(v => v.SaleEndDate.HasValue)
        .Select(v => (DateTime?)v.SaleEndDate!.Value)
        .DefaultIfEmpty((DateTime?)null)
        .Max();
}

<style>
    .fsd-hero {
        background: linear-gradient(135deg, #063532 0%, #0b5c56 58%, #0f766e 100%);
        border-radius: 18px;
        padding: 24px 28px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 26px rgba(6, 53, 50, 0.16);
        margin-bottom: 20px;
    }
    .fsd-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -30px;
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, rgba(245, 158, 11, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .fsd-btn-ghost {
        background: rgba(255,255,255,0.14);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 10px;
        padding: 9px 15px;
        font-weight: 600;
        font-size: 0.86rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.18s;
    }
    .fsd-btn-ghost:hover { background: rgba(255,255,255,0.22); color: #fff; }
    .fsd-btn-edit {
        background: #10b981;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 9px 18px;
        font-weight: 700;
        font-size: 0.86rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.35);
        transition: all 0.18s;
    }
    .fsd-btn-edit:hover { background: #059669; color: #fff; }

    .fsd-kpi {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 18px 20px;
        height: 100%;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
    }
    .fsd-kpi-label { font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; margin-bottom: 6px; }

    .fsd-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.035);
        overflow: hidden;
    }
    .fsd-card-head {
        padding: 16px 22px;
        background: #fafcff;
        border-bottom: 1px solid #e2e8f0;
    }

    .fsd-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 13px 16px;
        border-bottom: 1.5px solid #e2e8f0;
        position: sticky;
        top: 0;
        z-index: 1;
    }
    .fsd-table tbody td {
        padding: 13px 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }
    .fsd-table tbody tr:hover td { background: #f8fafc; }

    .fsd-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
    }
    .fsd-pill-live { background: #ecfdf5; color: #047857; }
    .fsd-pill-up { background: #fffbeb; color: #b45309; }
    .fsd-pill-end { background: #f1f5f9; color: #64748b; }

    .fsd-pulse {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        animation: fsdPulse 1.5s infinite;
    }
    @@keyframes fsdPulse {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
</style>

<!-- 1. HERO HEADER -->
<div class="fsd-hero d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div style="position: relative; z-index: 2;">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <span class="badge rounded-pill" style="background: rgba(245,158,11,0.25); color: #fde68a; font-weight: 700; font-size: 0.72rem;">
                <i class="bx bxs-zap me-1"></i>CHI TIẾT FLASH SALE
            </span>
            <span class="badge rounded-pill" style="background: rgba(255,255,255,0.16); color: #ccfbf1; font-weight: 700; font-size: 0.72rem;">
                @count biến thể tham gia
            </span>
            <span class="text-white-50 small">•</span>
            <a asp-area="Admin" asp-controller="FlashSales" asp-action="Index" class="text-white-50 small text-decoration-none">Flash Sale</a>
            <span class="text-white-50 small">/</span>
            <span class="text-white small fw-semibold">Chi tiết</span>
        </div>
        <h3 class="mb-1 fw-bold text-white" style="font-size: 1.38rem;">@Model.ProductName</h3>
        <div class="small" style="color: rgba(255,255,255,0.8);">
            Mã sản phẩm #@Model.ProductId — Chỉ hiển thị các biến thể đã cấu hình đầy đủ Giá sale, Thời gian bắt đầu và kết thúc.
        </div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2" style="position: relative; z-index: 2;">
        <a class="fsd-btn-ghost" asp-area="Admin" asp-controller="FlashSales" asp-action="Index">
            <i class="bx bx-arrow-back"></i>Quay lại
        </a>
        <a class="fsd-btn-edit" asp-area="Admin" asp-controller="FlashSales" asp-action="Edit" asp-route-id="@Model.ProductId">
            <i class="bx bx-edit-alt"></i>Chỉnh sửa Flash Sale
        </a>
    </div>
</div>

<!-- 2. KPI SUMMARY -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="fsd-kpi">
            <div class="fsd-kpi-label"><i class="bx bx-layer text-success me-1"></i>Số biến thể tham gia</div>
            <div class="fs-3 fw-bold text-dark">@count <span class="fs-6 fw-normal text-muted">SKU</span></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="fsd-kpi">
            <div class="fsd-kpi-label"><i class="bx bx-purchase-tag text-danger me-1"></i>Khoảng giá Flash Sale</div>
            <div class="fs-5 fw-bold">
                @if (count > 0 && minSale.HasValue && maxSale.HasValue)
                {
                    if (minSale.Value == maxSale.Value)
                    {
                        <span class="text-danger">@minSale.Value.ToString("N0", viVn)₫</span>
                    }
                    else
                    {
                        <span class="text-danger">@minSale.Value.ToString("N0", viVn)₫</span>
                        <span class="text-muted mx-1">→</span>
                        <span class="text-danger">@maxSale.Value.ToString("N0", viVn)₫</span>
                    }
                }
                else
                {
                    <span class="text-muted">—</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="fsd-kpi">
            <div class="fsd-kpi-label"><i class="bx bx-time-five text-primary me-1"></i>Khung thời gian sự kiện</div>
            @if (count > 0 && startMin.HasValue && endMax.HasValue)
            {
                <div class="small fw-semibold text-success"><i class="bx bx-play-circle me-1"></i>Bắt đầu: @startMin.Value.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small fw-semibold text-danger mt-1"><i class="bx bx-stop-circle me-1"></i>Kết thúc: @endMax.Value.ToString("dd/MM/yyyy HH:mm")</div>
            }
            else
            {
                <div class="text-muted fw-semibold">—</div>
            }
        </div>
    </div>
</div>

<!-- 3. VARIANTS TABLE -->
<div class="fsd-card">
    <div class="fsd-card-head d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h5 class="mb-0 fw-bold text-dark"><i class="bx bx-check-shield text-success me-1"></i>Danh sách biến thể đang Flash Sale</h5>
            <div class="text-muted small">Kiểm tra mức giảm thực tế và khung giờ của từng phân loại SKU</div>
        </div>
    </div>

    @if (variants.Count == 0)
    {
        <div class="p-5 text-center">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 18px; background: #f1f5f9; color: #94a3b8; font-size: 1.8rem;">
                <i class="bx bx-info-circle"></i>
            </div>
            <div class="fw-bold text-dark mb-1">Chưa có biến thể đủ điều kiện Flash Sale</div>
            <div class="text-muted small mb-3">Hãy thiết lập Giá sale, Thời gian bắt đầu và kết thúc cho ít nhất 1 biến thể.</div>
            <a class="fsd-btn-edit" asp-area="Admin" asp-controller="FlashSales" asp-action="Edit" asp-route-id="@Model.ProductId">
                <i class="bx bx-edit-alt"></i>Thiết lập Flash Sale
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive" style="max-height: 560px; overflow: auto;">
            <table class="table fsd-table table-nowrap align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 100px;">Variant</th>
                        <th>Phân loại / Thuộc tính</th>
                        <th class="text-end" style="width: 155px;">Giá gốc</th>
                        <th class="text-end" style="width: 155px;">Giá Flash Sale</th>
                        <th class="text-center" style="width: 110px;">Mức giảm</th>
                        <th style="width: 240px;">Thời gian áp dụng</th>
                        <th style="width: 145px;">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in variants)
                    {
                        var start = v.SaleStartDate;
                        var end = v.SaleEndDate;

                        var statusText = "—";
                        var statusClass = "fsd-pill-end";
                        var isLive = false;

                        if (start.HasValue && end.HasValue)
                        {
                            if (end.Value < nowLocal)
                            {
                                statusText = "Đã kết thúc";
                                statusClass = "fsd-pill-end";
                            }
                            else if (start.Value > nowLocal)
                            {
                                statusText = "Sắp diễn ra";
                                statusClass = "fsd-pill-up";
                            }
                            else
                            {
                                statusText = "Đang diễn ra";
                                statusClass = "fsd-pill-live";
                                isLive = true;
                            }
                        }

                        decimal? pct = null;
                        if (v.Price > 0m && v.SalePrice.HasValue && v.SalePrice.Value > 0m)
                        {
                            var raw = (1m - (v.SalePrice.Value / v.Price)) * 100m;
                            pct = Math.Round(raw, 0, MidpointRounding.AwayFromZero);
                        }

                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border fw-bold">#@v.VariantId</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@v.VariantLabel</div>
                                <div class="mt-1">
                                    @if (v.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success">Đang mở bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary">Tạm ngưng</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end text-muted text-decoration-line-through fw-semibold">@v.Price.ToString("N0", viVn)₫</td>
                            <td class="text-end">
                                @if (v.SalePrice.HasValue)
                                {
                                    <span class="fw-bold text-danger fs-6">@v.SalePrice.Value.ToString("N0", viVn)₫</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (pct.HasValue)
                                {
                                    <span class="badge rounded-pill bg-danger-subtle text-danger fw-bold px-2 py-1">-@pct.Value%</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (start.HasValue && end.HasValue)
                                {
                                    <div class="small fw-semibold text-success"><i class="bx bx-play-circle me-1"></i>@start.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="small fw-semibold text-danger"><i class="bx bx-stop-circle me-1"></i>@end.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="fsd-pill @statusClass">
                                    @if (isLive) { <span class="fsd-pulse"></span> }
                                    @statusText
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
