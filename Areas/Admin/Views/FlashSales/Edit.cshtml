@model DOAN_BANHANG.ViewModels.ProductAdminFlashSaleVm

@{
    ViewData["Title"] = "Sửa Flash Sale";
    var variants = Model.Variants ?? new List<DOAN_BANHANG.ViewModels.ProductAdminFlashSaleVariantVm>();
    var totalVariants = variants.Count;
    var selectedVariants = variants.Count(v => v.IsOnSale);
    var activeVariants = variants.Count(v => v.IsActive);
    var configuredSelectedVariants = variants.Count(v => v.IsOnSale && v.SalePrice.HasValue && v.SaleStartDate.HasValue && v.SaleEndDate.HasValue);
}

<style>
    :root {
        --fse-teal: #0b5c56;
        --fse-teal-dark: #063532;
        --fse-border: #e2e8f0;
    }

    .fse-hero {
        background: linear-gradient(135deg, #063532 0%, #0b5c56 58%, #0f766e 100%);
        border-radius: 18px;
        padding: 22px 26px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 26px rgba(6, 53, 50, 0.16);
        margin-bottom: 20px;
    }
    .fse-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -30px;
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, rgba(245, 158, 11, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .fse-btn-ghost {
        background: rgba(255,255,255,0.14);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 10px;
        padding: 9px 15px;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.18s;
    }
    .fse-btn-ghost:hover { background: rgba(255,255,255,0.22); color: #fff; }
    .fse-btn-save {
        background: #10b981;
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 9px 18px;
        font-weight: 700;
        font-size: 0.86rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.35);
        transition: all 0.18s;
    }
    .fse-btn-save:hover { background: #059669; color: #fff; }

    .fse-kpi {
        background: #fff;
        border: 1px solid var(--fse-border);
        border-radius: 16px;
        padding: 16px 20px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 100%;
    }
    .fse-kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .fse-card {
        background: #fff;
        border: 1px solid var(--fse-border);
        border-radius: 18px;
        box-shadow: 0 4px 20px rgba(15, 23, 42, 0.035);
        overflow: hidden;
    }
    .fse-card-head {
        padding: 16px 22px;
        background: #fafcff;
        border-bottom: 1px solid var(--fse-border);
    }

    .flashsale-table-wrap {
        max-height: 560px;
        overflow: auto;
        border-color: #cbd5e1 !important;
        border-radius: 12px;
    }

    .flashsale-table {
        margin-bottom: 0;
        table-layout: fixed;
        width: 100%;
        min-width: 1180px;
    }
    .flashsale-table th,
    .flashsale-table td {
        padding: 10px 10px;
    }
    .flashsale-table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #f1f5f9;
        color: #475569;
        font-weight: 700;
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        border-bottom: 1.5px solid #e2e8f0;
        text-align: center;
        vertical-align: middle;
    }
    .flashsale-table thead th .form-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
    }
    .flashsale-badges {
        display: flex;
        flex-wrap: wrap;
        gap: .25rem;
    }
    .flashsale-variant-label {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .flashsale-table .input-group-text {
        width: 36px;
        justify-content: center;
        background: #f8fafc;
        color: #64748b;
    }
    .flashsale-table .input-group { width: 100%; flex-wrap: nowrap; }
    .flashsale-table tbody tr:hover > td { background: #f8fafc; }

    .sale-row--inactive { color: #94a3b8; }
    .sale-row--selected { box-shadow: inset 4px 0 0 #0b5c56; }
    .sale-row--selected > td,
    .sale-row--selected:hover > td { background: #f0fdfa !important; }

    .flashsale-input { min-width: 0; width: 100%; }
    .flashsale-input:disabled { background-color: #f1f5f9; opacity: 0.8; }
</style>

<!-- 1. HERO HEADER -->
<div class="fse-hero d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div style="position: relative; z-index: 2;">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <span class="badge rounded-pill" style="background: rgba(245,158,11,0.25); color: #fde68a; font-weight: 700; font-size: 0.72rem;">
                <i class="bx bxs-zap me-1"></i>CHỈNH SỬA FLASH SALE
            </span>
            <span class="badge rounded-pill" style="background: rgba(255,255,255,0.16); color: #ccfbf1; font-weight: 700; font-size: 0.72rem;">
                <i class="bx bx-layer me-1"></i>@totalVariants biến thể
            </span>
            <span class="badge rounded-pill" style="background: rgba(239,68,68,0.25); color: #fecaca; font-weight: 700; font-size: 0.72rem;" id="js-selected-badge">
                <i class="bx bx-purchase-tag me-1"></i>Đang chọn: @selectedVariants
            </span>
        </div>
        <h3 class="mb-1 fw-bold text-white" style="font-size: 1.35rem;">@Model.ProductName</h3>
        <div class="small" style="color: rgba(255,255,255,0.8);">
            Tick chọn “Sale” ở từng biến thể để đặt giá khuyến mãi và khung giờ riêng; bỏ tick để tắt Flash Sale.
        </div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2" style="position: relative; z-index: 2;">
        <a asp-area="Admin" asp-controller="FlashSales" asp-action="Details" asp-route-id="@Model.ProductId" class="fse-btn-ghost">
            <i class="bx bx-show"></i>Chi tiết
        </a>
        <a asp-area="Admin" asp-controller="FlashSales" asp-action="Index" class="fse-btn-ghost">
            <i class="bx bx-arrow-back"></i>Quay lại
        </a>
        <button type="submit" form="fseEditForm" class="fse-btn-save">
            <i class="bx bx-save fs-5"></i>Lưu Flash Sale
        </button>
    </div>
</div>

@if (TempData["AdminToast"] is string msg && !string.IsNullOrWhiteSpace(msg))
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
        <i class="bx bx-check-circle me-1"></i>@msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- 2. KPI CARDS -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="fse-kpi">
            <div>
                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Tổng biến thể</div>
                <div class="fs-3 fw-bold text-dark">@totalVariants <span class="fs-6 fw-normal text-muted">(@activeVariants active)</span></div>
            </div>
            <div class="fse-kpi-icon" style="background: rgba(11,92,86,0.1); color: #0b5c56;">
                <i class="bx bx-layer"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="fse-kpi">
            <div>
                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Đang chọn (Sale)</div>
                <div class="fs-3 fw-bold text-danger" id="js-selected-count">@selectedVariants</div>
            </div>
            <div class="fse-kpi-icon" style="background: #fef2f2; color: #dc2626;">
                <i class="bx bx-purchase-tag"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="fse-kpi">
            <div>
                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.72rem;">Đã cấu hình đủ</div>
                <div class="fs-3 fw-bold text-success" id="js-configured-count">@configuredSelectedVariants</div>
            </div>
            <div class="fse-kpi-icon" style="background: #ecfdf5; color: #059669;">
                <i class="bx bx-check-shield"></i>
            </div>
        </div>
    </div>
</div>

<!-- 3. MAIN FORM CARD -->
<div class="fse-card">
    <div class="fse-card-head d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h5 class="mb-0 fw-bold text-dark"><i class="bx bx-slider-alt text-success me-1"></i>Thiết lập chi tiết từng biến thể</h5>
            <div class="text-muted small">Chỉ biến thể có đủ <strong>Giá sale + Bắt đầu + Kết thúc</strong> mới hiển thị ngoài gian hàng.</div>
        </div>
        <div class="d-flex flex-wrap gap-1">
            <span class="badge rounded-pill bg-success-subtle text-success">Đủ cấu hình</span>
            <span class="badge rounded-pill bg-warning-subtle text-warning">Thiếu thông tin</span>
            <span class="badge rounded-pill bg-secondary-subtle text-secondary">Inactive</span>
        </div>
    </div>

    <div class="p-4">
        <form id="fseEditForm" asp-area="Admin" asp-controller="FlashSales" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="ProductName" />

            @if (!ViewData.ModelState.IsValid)
            {
                @Html.ValidationSummary(excludePropertyErrors: false, message: null, htmlAttributes: new { @class = "alert alert-danger rounded-3" })
            }

            <div class="table-responsive border flashsale-table-wrap">
                <table class="table table-hover table-nowrap align-middle table-sm flashsale-table">
                    <colgroup>
                        <col style="width:72px" />
                        <col style="width:95px" />
                        <col style="width:230px" />
                        <col style="width:135px" />
                        <col style="width:195px" />
                        <col style="width:235px" />
                        <col style="width:235px" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>
                                <div class="form-check m-0">
                                    <input class="form-check-input" type="checkbox" id="js-sale-select-all" />
                                    <label class="form-check-label" for="js-sale-select-all">Sale</label>
                                </div>
                            </th>
                            <th>Variant</th>
                            <th class="text-start">Thuộc tính</th>
                            <th class="text-end">Giá gốc</th>
                            <th>Giá Flash Sale</th>
                            <th>Bắt đầu</th>
                            <th>Kết thúc</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < variants.Count; i++)
                        {
                            var row = variants[i];
                            var isConfigured = row.SalePrice.HasValue && row.SaleStartDate.HasValue && row.SaleEndDate.HasValue;
                            <tr class="js-sale-row @(row.IsOnSale ? "sale-row--selected" : "") @(!row.IsActive ? "sale-row--inactive" : "")">
                                <td class="text-center">
                                    <div class="form-check d-inline-flex justify-content-center m-0">
                                        <input class="form-check-input js-sale-toggle" type="checkbox" id="sale_@i" name="Variants[@i].IsOnSale" value="true" @(row.IsOnSale ? "checked" : "") />
                                        <label class="form-check-label" for="sale_@i"></label>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border fw-bold">#@row.VariantId</span>
                                    <input type="hidden" name="Variants[@i].VariantId" value="@row.VariantId" />
                                    <input type="hidden" name="Variants[@i].VariantLabel" value="@row.VariantLabel" />
                                    <input type="hidden" name="Variants[@i].Price" value="@row.Price" />
                                    <input type="hidden" name="Variants[@i].IsActive" value="@(row.IsActive ? "true" : "false")" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark flashsale-variant-label" title="@row.VariantLabel">@row.VariantLabel</div>
                                    <div class="mt-1 flashsale-badges">
                                        @if (row.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary">Inactive</span>
                                        }
                                        @if (row.IsOnSale)
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger">On Sale</span>
                                        }
                                        @if (row.IsOnSale && !isConfigured)
                                        {
                                            <span class="badge rounded-pill bg-warning-subtle text-warning">Thiếu thông tin</span>
                                        }
                                        @if (row.IsOnSale && isConfigured)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success">Đủ cấu hình</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end fw-semibold text-muted">
                                    @row.Price.ToString("n0")₫
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">₫</span>
                                        <input class="form-control form-control-sm text-end fw-bold text-danger js-sale-input flashsale-input" type="number" step="0.01" min="0" placeholder="Giá sale" name="Variants[@i].SalePrice" value="@(row.SalePrice?.ToString("0.##") ?? "")" @(row.IsOnSale ? "" : "disabled") />
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text"><i class="bx bx-play-circle text-success"></i></span>
                                        <input class="form-control form-control-sm js-sale-input flashsale-input" type="datetime-local" name="Variants[@i].SaleStartDate" value="@(row.SaleStartDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")" @(row.IsOnSale ? "" : "disabled") />
                                    </div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text"><i class="bx bx-stop-circle text-danger"></i></span>
                                        <input class="form-control form-control-sm js-sale-input flashsale-input" type="datetime-local" name="Variants[@i].SaleEndDate" value="@(row.SaleEndDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")" @(row.IsOnSale ? "" : "disabled") />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 pt-3 border-top">
                <div class="text-muted small">
                    <i class="bx bx-time-five me-1"></i>
                    Thời gian hiển thị theo giờ thiết bị (local datetime).
                </div>
                <div class="d-flex gap-2">
                    <a asp-area="Admin" asp-controller="FlashSales" asp-action="Index" class="btn btn-light border px-3" style="border-radius: 10px;">
                        Hủy bỏ
                    </a>
                    <button type="submit" class="fse-btn-save px-4">
                        <i class="bx bx-save fs-5"></i>Lưu Flash Sale
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const selectAll = document.getElementById('js-sale-select-all');
            const toggles = Array.from(document.querySelectorAll('.js-sale-toggle'));
            const selectedBadge = document.getElementById('js-selected-badge');
            const selectedCount = document.getElementById('js-selected-count');
            const configuredCount = document.getElementById('js-configured-count');

            function setRowEnabled(toggleEl, enabled, clear) {
                const tr = toggleEl.closest('tr');
                if (!tr) return;

                const inputs = Array.from(tr.querySelectorAll('.js-sale-input'));
                inputs.forEach(input => {
                    input.disabled = !enabled;
                    if (!enabled && clear) {
                        input.value = '';
                    }
                });

                tr.classList.toggle('sale-row--selected', enabled);
            }

            function updateSelectedBadge() {
                if (!selectedBadge) return;
                const count = toggles.filter(t => t.checked).length;
                selectedBadge.innerHTML = '<i class="bx bx-purchase-tag me-1"></i>Đang chọn: ' + count;

                if (selectedCount) selectedCount.textContent = count;

                if (configuredCount) {
                    const configured = toggles
                        .filter(t => t.checked)
                        .filter(t => {
                            const tr = t.closest('tr');
                            if (!tr) return false;

                            const inputs = Array.from(tr.querySelectorAll('.js-sale-input'));
                            const salePrice = inputs[0]?.value?.trim();
                            const start = inputs[1]?.value?.trim();
                            const end = inputs[2]?.value?.trim();
                            return !!salePrice && !!start && !!end;
                        }).length;
                    configuredCount.textContent = configured;
                }
            }

            function syncSelectAllState() {
                if (!selectAll) return;
                if (toggles.length === 0) {
                    selectAll.checked = false;
                    selectAll.indeterminate = false;
                    return;
                }

                const checkedCount = toggles.filter(t => t.checked).length;
                selectAll.indeterminate = checkedCount > 0 && checkedCount < toggles.length;
                selectAll.checked = checkedCount === toggles.length;
            }

            toggles.forEach(t => setRowEnabled(t, t.checked, false));
            syncSelectAllState();
            updateSelectedBadge();

            toggles.forEach(t => {
                t.addEventListener('change', function () {
                    setRowEnabled(t, t.checked, !t.checked);
                    syncSelectAllState();
                    updateSelectedBadge();
                });
            });

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    toggles.forEach(t => {
                        t.checked = selectAll.checked;
                        setRowEnabled(t, t.checked, !t.checked);
                    });
                    syncSelectAllState();
                    updateSelectedBadge();
                });
            }
        })();
    </script>
}
