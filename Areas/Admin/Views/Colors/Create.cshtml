@model DOAN_BANHANG.Models.Color

@{
    ViewData["Title"] = "Thêm màu sắc";
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0 font-size-18">Thêm màu sắc mới</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-action="Index">Màu sắc</a></li>
                    <li class="breadcrumb-item active">Thêm mới</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card" style="border-radius: 16px;">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Tên màu sắc</label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Đỏ, Xanh Navy, Charcoal..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Code" class="form-label">Mã màu (HEX)</label>
                        <div class="input-group">
                            <input asp-for="Code" class="form-control" placeholder="#000000" type="color" style="height: 38px; width: 60px; flex: 0 0 auto;" />
                            <input type="text" id="colorText" class="form-control" placeholder="#000000" value="#000000" />
                        </div>
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light btn-rounded">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary btn-rounded px-4">Lưu màu sắc</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#Code').on('input', function() {
                $('#colorText').val($(this).val());
            });
            $('#colorText').on('input', function() {
                var val = $(this).val();
                if (/^#[0-9A-F]{6}$/i.test(val)) {
                    $('#Code').val(val);
                }
            });
        });
    </script>
}
