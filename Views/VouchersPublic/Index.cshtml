@using System.Globalization
@model DOAN_BANHANG.ViewModels.VoucherHubVm
@{
    ViewData["Title"] = "Trạm Săn Voucher & Mã Giảm Giá Sellzy";
    var viVn = CultureInfo.GetCultureInfo("vi-VN");

    string FormatDiscTitle(DOAN_BANHANG.ViewModels.VoucherHubCardVm v)
    {
        if (v.DiscountType == "FreeShipping")
            return $"Freeship đến {v.DiscountValue.ToString("N0", viVn)}₫";
        if (v.DiscountType == "Percent")
            return $"Giảm {v.DiscountValue:0.##}%";
        return $"Giảm {v.DiscountValue.ToString("N0", viVn)}₫";
    }
}

@section Styles {
<style>
  .vh-page { background: #eef2f6; min-height: 80vh; padding: 28px 0 80px; }
  .vh-hero {
    background: radial-gradient(circle at 90% 15%, rgba(253, 224, 71, 0.18) 0%, transparent 45%),
                linear-gradient(135deg, #022c22 0%, #065f5b 55%, #008374 100%);
    border-radius: 26px;
    padding: 32px 36px;
    color: #ffffff;
    box-shadow: 0 20px 44px -18px rgba(2, 44, 34, 0.45);
    margin-bottom: 24px;
  }
  @@media (max-width: 767px) { .vh-hero { padding: 22px 18px; border-radius: 20px; } }
  .vh-hero-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(253, 224, 71, 0.18); border: 1px solid rgba(253, 224, 71, 0.45);
    color: #fde047; font-size: 11.5px; font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.06em; padding: 5px 12px; border-radius: 999px; margin-bottom: 10px;
  }
  .vh-hero h1 { color: #ffffff !important; font-size: clamp(24px, 3vw, 34px); font-weight: 800; margin: 0 0 8px; }
  .vh-hero-sub { color: rgba(255, 255, 255, 0.86); font-size: 14.5px; margin: 0; max-width: 640px; }
  .vh-my-wallet-btn {
    display: inline-flex; align-items: center; gap: 8px;
    background: #fde047; color: #022c22; font-size: 13.5px; font-weight: 800;
    padding: 10px 20px; border-radius: 999px; text-decoration: none;
    box-shadow: 0 8px 20px -6px rgba(253, 224, 71, 0.5); transition: transform 0.18s ease;
    white-space: nowrap;
  }
  .vh-my-wallet-btn:hover { transform: translateY(-2px); color: #022c22; }

  /* Quick secret code entry bar */
  .vh-code-bar {
    margin-top: 22px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 18px;
    padding: 12px 16px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
  }
  .vh-code-bar input {
    flex: 1; min-width: 220px; height: 42px; border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.3); background: #ffffff;
    color: #0f172a; font-size: 14px; font-weight: 700; text-transform: uppercase;
    padding: 0 14px; outline: none;
  }
  .vh-code-bar button {
    height: 42px; padding: 0 22px; border-radius: 12px; border: none;
    background: #fde047; color: #022c22; font-size: 13.5px; font-weight: 800;
    cursor: pointer; white-space: nowrap;
  }
  .vh-code-msg {
    width: 100%; font-size: 13px; font-weight: 600; display: none; padding: 6px 12px; border-radius: 10px;
  }

  /* Filter Toolbar */
  .vh-toolbar {
    background: #ffffff; border: 1px solid #dbe3ec; border-radius: 20px;
    padding: 14px 20px; margin-bottom: 26px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
    box-shadow: 0 6px 18px -10px rgba(15, 23, 42, 0.08);
  }
  .vh-filter-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .vh-pill {
    padding: 8px 16px; border-radius: 999px; font-size: 13px; font-weight: 700;
    border: 1px solid #cbd5e1; background: #ffffff; color: #334155; cursor: pointer;
    transition: all 0.18s ease;
  }
  .vh-pill.is-active { background: #008374; color: #ffffff; border-color: #008374; }
  .vh-search-box { position: relative; width: 250px; max-width: 100%; }
  .vh-search-box input {
    width: 100%; height: 38px; padding: 0 14px 0 36px; border-radius: 999px;
    border: 1px solid #cbd5e1; background: #f8fafc; font-size: 13px; color: #0f172a; outline: none;
  }
  .vh-search-box input:focus { border-color: #008374; background: #ffffff; }
  .vh-search-box i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748b; }

  /* Section Headers */
  .vh-sec { margin-bottom: 32px; }
  .vh-sec-head {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    margin-bottom: 16px; flex-wrap: wrap;
  }
  .vh-sec-title {
    font-size: 20px; font-weight: 800; color: #0f172a; margin: 0;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .vh-sec-count {
    font-size: 12px; font-weight: 800; color: #065f5b; background: #d1fae5;
    padding: 3px 10px; border-radius: 999px;
  }

  /* Shopee-style Notched Ticket Grid */
  .vh-grid {
    display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 16px;
  }
  @@media (min-width: 768px) { .vh-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @@media (min-width: 1200px) { .vh-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .vh-ticket {
    position: relative;
    background: #ffffff;
    border: 1px solid #dbe3ec;
    border-radius: 18px;
    display: flex;
    overflow: hidden;
    box-shadow: 0 6px 20px -10px rgba(15, 23, 42, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .vh-ticket:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px -10px rgba(15, 23, 42, 0.15);
    border-color: #008374;
  }
  .vh-stub {
    position: relative;
    width: 112px; flex-shrink: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 16px 10px; text-align: center; color: #ffffff;
    border-right: 2px dashed rgba(255, 255, 255, 0.55);
  }
  .vh-stub::before, .vh-stub::after {
    content: ""; position: absolute; right: -8px; width: 14px; height: 14px;
    border-radius: 50%; background: #eef2f6; z-index: 2;
  }
  .vh-stub::before { top: -7px; }
  .vh-stub::after { bottom: -7px; }

  .vh-stub.is-ship { background: linear-gradient(145deg, #0369a1 0%, #0ea5e9 100%); }
  .vh-stub.is-platform { background: linear-gradient(145deg, #022c22 0%, #008374 100%); }
  .vh-stub.is-shop { background: linear-gradient(145deg, #c2410c 0%, #f59e0b 100%); }

  .vh-stub-logo {
    width: 42px; height: 42px; border-radius: 50%; object-fit: cover;
    border: 2px solid rgba(255,255,255,0.85); background: #ffffff; margin-bottom: 6px;
  }
  .vh-body {
    flex: 1; padding: 14px 16px; display: flex; flex-direction: column;
    justify-content: space-between; min-width: 0;
  }
  .vh-disc-title { font-size: 16.5px; font-weight: 800; color: #0f172a; line-height: 1.25; }
  .vh-max-cap { font-size: 12px; font-weight: 700; color: #dc2626; margin-top: 2px; }
  .vh-min-ord { font-size: 12.5px; color: #475569; margin-top: 3px; }
  .vh-prog-wrap { margin-top: 8px; }
  .vh-prog-track { height: 6px; background: #e2e8f0; border-radius: 999px; overflow: hidden; }
  .vh-prog-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #008374, #10b981); }
  .vh-prog-fill.is-hot { background: linear-gradient(90deg, #f97316, #dc2626); }
  .vh-prog-meta {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 11px; color: #64748b; margin-top: 4px;
  }
  .vh-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    margin-top: 10px; padding-top: 9px; border-top: 1px dashed #e2e8f0;
  }
  .vh-btn-save {
    padding: 7px 16px; border-radius: 999px; font-size: 12.5px; font-weight: 800;
    border: none; cursor: pointer; background: #008374; color: #ffffff;
    white-space: nowrap; transition: all 0.18s ease;
  }
  .vh-btn-save:hover { background: #065f5b; }
  .vh-btn-use {
    padding: 7px 15px; border-radius: 999px; font-size: 12.5px; font-weight: 800;
    border: 1.5px solid #008374; background: #ecfdf5; color: #008374;
    text-decoration: none; white-space: nowrap; transition: all 0.18s ease;
  }
  .vh-btn-use:hover { background: #008374; color: #ffffff; }
</style>
}

<div class="vh-page">
  <div class="container">
    <!-- Hero Banner -->
    <div class="vh-hero">
      <div style="display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 16px;">
        <div>
          <div class="vh-hero-badge">🎟️ Trạm Săn Mã Giảm Giá Sellzy</div>
          <h1>Săn Voucher Cực Khủng — Giảm Chồng Freeship</h1>
          <p class="vh-hero-sub">Lưu trước vào Kho Voucher cá nhân. Hệ thống sẽ tự động chọn cặp mã <strong>Freeship + Giảm giá</strong> tiết kiệm nhất khi bạn thanh toán!</p>
        </div>
        <a href="/my-vouchers" class="vh-my-wallet-btn">
          <span>💼 Kho Voucher của tôi</span>
          <span style="background: #022c22; color: #fde047; padding: 2px 9px; border-radius: 999px; font-size: 12px;" id="js-hub-saved-badge">@Model.SavedCount</span>
        </a>
      </div>

      <!-- Nhập mã bí mật / mã Shop gửi qua Chat -->
      <div class="vh-code-bar">
        <span style="font-size: 13.5px; font-weight: 700; color: #ffffff; white-space: nowrap;">🔑 Nhập mã ưu đãi:</span>
        <input type="text" id="js-manual-voucher-code" placeholder="Nhập mã Voucher (VD: SELLZY50, FREESHIP...)" />
        <button type="button" onclick="claimManualCode()">Lưu vào Kho</button>
        <div id="js-manual-voucher-msg" class="vh-code-msg"></div>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="vh-toolbar">
      <div class="vh-filter-pills">
        <button type="button" class="vh-pill is-active" onclick="filterVoucherSections('all', this)">🔥 Tất cả (@Model.TotalActiveCount)</button>
        <button type="button" class="vh-pill" onclick="filterVoucherSections('ship', this)">🚚 Freeship (@Model.FreeShippingVouchers.Count)</button>
        <button type="button" class="vh-pill" onclick="filterVoucherSections('platform', this)">💎 Voucher Sàn (@Model.PlatformVouchers.Count)</button>
        <button type="button" class="vh-pill" onclick="filterVoucherSections('shop', this)">🏪 Voucher Shop (@Model.ShopVouchers.Count)</button>
      </div>
      <div class="vh-search-box">
        <i class="hgi hgi-stroke hgi-search-01"></i>
        <input type="text" id="js-vh-search" placeholder="Tìm theo mã hoặc tên Shop..." />
      </div>
    </div>

    @if (Model.TotalActiveCount == 0)
    {
      <div style="background:#ffffff; border:1px dashed #cbd5e1; border-radius:24px; padding:56px 24px; text-align:center;">
        <div style="font-size:44px; margin-bottom:10px;">🎟️</div>
        <h4 style="font-weight:800; color:#0f172a; margin:0 0 8px;">Hiện chưa có mã công khai nào đang mở</h4>
        <p style="color:#64748b; font-size:14px; max-width:460px; margin:0 auto;">Hãy nhập mã bí mật ở khung phía trên hoặc nhắn tin trực tiếp với Gian hàng để nhận Voucher độc quyền qua Chat!</p>
      </div>
    }
    else
    {
      <!-- KHU 1: FREESHIP -->
      @if (Model.FreeShippingVouchers.Count > 0)
      {
        <section class="vh-sec js-vh-sec" data-sec="ship">
          <div class="vh-sec-head">
            <h2 class="vh-sec-title">🚚 Mã Miễn Phí Vận Chuyển (Freeship)</h2>
            <span class="vh-sec-count">@Model.FreeShippingVouchers.Count mã đang mở</span>
          </div>
          <div class="vh-grid">
            @foreach (var v in Model.FreeShippingVouchers)
            {
              bool isHot = v.UsageLimit > 0 && v.UsedPercent >= 70;
              <div class="vh-ticket js-vh-ticket" data-search="@($"{v.Code} {v.ShopName} {v.ScopeLabel}".ToLowerInvariant())">
                <div class="vh-stub is-ship">
                  <div style="font-size: 24px; margin-bottom: 4px;">🚚</div>
                  <div style="font-size: 11px; font-weight: 800; text-transform: uppercase;">FREESHIP</div>
                  <div style="font-size: 10.5px; opacity: 0.9; margin-top: 3px; font-family: monospace;">@v.Code</div>
                </div>
                <div class="vh-body">
                  <div>
                    <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-bottom:4px;">
                      <span style="font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:999px; background:#e0f2fe; color:#0369a1;">@v.ScopeLabel</span>
                      @if (v.IsExpiringSoon) { <span style="font-size:10.5px; font-weight:700; color:#dc2626;">⏰ Sắp hết hạn</span> }
                    </div>
                    <div class="vh-disc-title">@FormatDiscTitle(v)</div>
                    <div class="vh-min-ord">Đơn tối thiểu @v.MinOrderValue.ToString("N0", viVn)₫</div>
                    <div class="vh-prog-wrap">
                      <div class="vh-prog-track"><div class="vh-prog-fill @(isHot ? "is-hot" : "")" style="width:@(v.UsageLimit > 0 ? Math.Max(12, v.UsedPercent) : 25)%"></div></div>
                      <div class="vh-prog-meta">
                        <span>@(v.UsageLimit > 0 ? $"Đã dùng {v.UsedPercent}%" : "Số lượng không giới hạn")</span>
                        <span>HSD: @v.EndDate.ToString("dd/MM/yyyy")</span>
                      </div>
                    </div>
                  </div>
                  <div class="vh-foot">
                    <span style="font-size:11.5px; font-weight:700; color:#0f172a; font-family:monospace;">@v.Code</span>
                    @if (v.IsSaved)
                    {
                      <a href="@v.UseNowUrl" class="vh-btn-use">Dùng ngay →</a>
                    }
                    else
                    {
                      <button type="button" class="vh-btn-save js-hub-save-btn" data-voucher-id="@v.Id" data-voucher-code="@v.Code" data-use-url="@v.UseNowUrl" onclick="saveTicketVoucher(this)">Lưu mã</button>
                    }
                  </div>
                </div>
              </div>
            }
          </div>
        </section>
      }

      <!-- KHU 2: VOUCHER TOÀN SÀN & MALL -->
      @if (Model.PlatformVouchers.Count > 0)
      {
        <section class="vh-sec js-vh-sec" data-sec="platform">
          <div class="vh-sec-head">
            <h2 class="vh-sec-title">💎 Voucher Toàn Sàn Sellzy &amp; Độc Quyền Mall</h2>
            <span class="vh-sec-count">@Model.PlatformVouchers.Count mã đang mở</span>
          </div>
          <div class="vh-grid">
            @foreach (var v in Model.PlatformVouchers)
            {
              bool isHot = v.UsageLimit > 0 && v.UsedPercent >= 70;
              <div class="vh-ticket js-vh-ticket" data-search="@($"{v.Code} {v.ShopName} {v.ScopeLabel}".ToLowerInvariant())">
                <div class="vh-stub is-platform">
                  <div style="font-size: 24px; margin-bottom: 4px;">💎</div>
                  <div style="font-size: 11px; font-weight: 800; text-transform: uppercase;">@(v.ScopeType == "MallOnly" ? "SELLZY MALL" : "SELLZY SÀN")</div>
                  <div style="font-size: 10.5px; opacity: 0.9; margin-top: 3px; font-family: monospace;">@v.Code</div>
                </div>
                <div class="vh-body">
                  <div>
                    <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-bottom:4px;">
                      <span style="font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:999px; background:#e6f4f3; color:#065f5b;">@v.ScopeLabel</span>
                      @if (v.IsExpiringSoon) { <span style="font-size:10.5px; font-weight:700; color:#dc2626;">⏰ Sắp hết hạn</span> }
                    </div>
                    <div class="vh-disc-title">@FormatDiscTitle(v)</div>
                    @if (v.MaxDiscountValue.HasValue && v.DiscountType == "Percent")
                    {
                      <div class="vh-max-cap">Giảm tối đa @v.MaxDiscountValue.Value.ToString("N0", viVn)₫</div>
                    }
                    <div class="vh-min-ord">Đơn tối thiểu @v.MinOrderValue.ToString("N0", viVn)₫</div>
                    <div class="vh-prog-wrap">
                      <div class="vh-prog-track"><div class="vh-prog-fill @(isHot ? "is-hot" : "")" style="width:@(v.UsageLimit > 0 ? Math.Max(12, v.UsedPercent) : 30)%"></div></div>
                      <div class="vh-prog-meta">
                        <span>@(v.UsageLimit > 0 ? $"Đã dùng {v.UsedPercent}%" : "Ưu đãi toàn sàn")</span>
                        <span>HSD: @v.EndDate.ToString("dd/MM/yyyy")</span>
                      </div>
                    </div>
                  </div>
                  <div class="vh-foot">
                    <span style="font-size:11.5px; font-weight:700; color:#0f172a; font-family:monospace;">@v.Code</span>
                    @if (v.IsSaved)
                    {
                      <a href="@v.UseNowUrl" class="vh-btn-use">Dùng ngay →</a>
                    }
                    else
                    {
                      <button type="button" class="vh-btn-save js-hub-save-btn" data-voucher-id="@v.Id" data-voucher-code="@v.Code" data-use-url="@v.UseNowUrl" onclick="saveTicketVoucher(this)">Lưu mã</button>
                    }
                  </div>
                </div>
              </div>
            }
          </div>
        </section>
      }

      <!-- KHU 3: VOUCHER GIAN HÀNG -->
      @if (Model.ShopVouchers.Count > 0)
      {
        <section class="vh-sec js-vh-sec" data-sec="shop">
          <div class="vh-sec-head">
            <h2 class="vh-sec-title">🏪 Siêu Voucher Gian Hàng Đối Tác</h2>
            <span class="vh-sec-count">@Model.ShopVouchers.Count mã đang mở</span>
          </div>
          <div class="vh-grid">
            @foreach (var v in Model.ShopVouchers)
            {
              bool isHot = v.UsageLimit > 0 && v.UsedPercent >= 70;
              <div class="vh-ticket js-vh-ticket" data-search="@($"{v.Code} {v.ShopName} {v.ScopeLabel}".ToLowerInvariant())">
                <div class="vh-stub is-shop">
                  @if (!string.IsNullOrWhiteSpace(v.ShopLogoUrl))
                  {
                    <img src="@v.ShopLogoUrl" alt="@v.ShopName" class="vh-stub-logo" />
                  }
                  else
                  {
                    <div style="font-size: 24px; margin-bottom: 4px;">🏪</div>
                  }
                  <div style="font-size: 10.5px; font-weight: 800; line-height: 1.2; max-width: 92px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@v.ShopName</div>
                  @if (v.IsMallShop)
                  {
                    <span style="margin-top: 4px; background: #022c22; color: #fde047; font-size: 9px; font-weight: 900; padding: 1px 6px; border-radius: 999px;">MALL</span>
                  }
                </div>
                <div class="vh-body">
                  <div>
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:6px; margin-bottom:4px;">
                      <span style="font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:999px; background:#fef3c7; color:#b45309;">@v.ScopeLabel</span>
                      @if (!string.IsNullOrWhiteSpace(v.ShopSlug))
                      {
                        <a href="/shop/@v.ShopSlug" style="font-size:11.5px; font-weight:700; color:#008374; text-decoration:none; white-space:nowrap;">Xem Shop →</a>
                      }
                    </div>
                    <div class="vh-disc-title">@FormatDiscTitle(v)</div>
                    @if (v.MaxDiscountValue.HasValue && v.DiscountType == "Percent")
                    {
                      <div class="vh-max-cap">Giảm tối đa @v.MaxDiscountValue.Value.ToString("N0", viVn)₫</div>
                    }
                    <div class="vh-min-ord">Đơn tối thiểu @v.MinOrderValue.ToString("N0", viVn)₫</div>
                    <div class="vh-prog-wrap">
                      <div class="vh-prog-track"><div class="vh-prog-fill @(isHot ? "is-hot" : "")" style="width:@(v.UsageLimit > 0 ? Math.Max(12, v.UsedPercent) : 25)%"></div></div>
                      <div class="vh-prog-meta">
                        <span>@(v.UsageLimit > 0 ? $"Đã dùng {v.UsedPercent}%" : "Từ Gian hàng")</span>
                        <span>HSD: @v.EndDate.ToString("dd/MM/yyyy")</span>
                      </div>
                    </div>
                  </div>
                  <div class="vh-foot">
                    <span style="font-size:11.5px; font-weight:700; color:#0f172a; font-family:monospace;">@v.Code</span>
                    @if (v.IsSaved)
                    {
                      <a href="@v.UseNowUrl" class="vh-btn-use">Dùng ngay →</a>
                    }
                    else
                    {
                      <button type="button" class="vh-btn-save js-hub-save-btn" data-voucher-id="@v.Id" data-voucher-code="@v.Code" data-use-url="@v.UseNowUrl" onclick="saveTicketVoucher(this)">Lưu mã</button>
                    }
                  </div>
                </div>
              </div>
            }
          </div>
        </section>
      }
    }
  </div>
</div>

@section Scripts {
<script>
  function filterVoucherSections(mode, btnEl) {
    document.querySelectorAll('.vh-pill').forEach(p => p.classList.toggle('is-active', p === btnEl));
    document.querySelectorAll('.js-vh-sec').forEach(sec => {
      sec.style.display = (mode === 'all' || sec.dataset.sec === mode) ? 'block' : 'none';
    });
  }

  document.getElementById('js-vh-search')?.addEventListener('input', function () {
    const q = (this.value || '').trim().toLowerCase();
    document.querySelectorAll('.js-vh-ticket').forEach(t => {
      const hay = t.dataset.search || '';
      t.style.display = !q || hay.includes(q) ? 'flex' : 'none';
    });
  });

  async function saveTicketVoucher(btnEl) {
    const voucherId = Number(btnEl.dataset.voucherId || 0);
    const code = btnEl.dataset.voucherCode || '';
    const useUrl = btnEl.dataset.useUrl || '/products';
    btnEl.disabled = true;
    btnEl.textContent = 'Đang lưu...';
    try {
      const res = await fetch('/vouchers/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ voucherId, code })
      });
      const data = await res.json();
      if (res.ok && data && data.ok) {
        const badge = document.getElementById('js-hub-saved-badge');
        if (badge && typeof data.savedCount === 'number' && data.persistedToAccount) {
          badge.textContent = String(data.savedCount);
        }
        const link = document.createElement('a');
        link.href = useUrl;
        link.className = 'vh-btn-use';
        link.textContent = '✓ Dùng ngay →';
        btnEl.replaceWith(link);
      } else {
        alert(data?.message || 'Không thể lưu mã này.');
        btnEl.disabled = false;
        btnEl.textContent = 'Lưu mã';
      }
    } catch (e) {
      btnEl.disabled = false;
      btnEl.textContent = 'Lưu mã';
    }
  }

  async function claimManualCode() {
    const input = document.getElementById('js-manual-voucher-code');
    const msgEl = document.getElementById('js-manual-voucher-msg');
    const code = (input?.value || '').trim().toUpperCase();
    if (!code) {
      msgEl.style.display = 'block';
      msgEl.style.background = 'rgba(254, 226, 226, 0.95)';
      msgEl.style.color = '#991b1b';
      msgEl.textContent = 'Vui lòng nhập mã giảm giá trước khi bấm lưu.';
      return;
    }

    try {
      const res = await fetch('/vouchers/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ voucherId: 0, code })
      });
      const data = await res.json();
      msgEl.style.display = 'block';
      if (res.ok && data && data.ok) {
        msgEl.style.background = 'rgba(209, 250, 229, 0.96)';
        msgEl.style.color = '#065f46';
        msgEl.textContent = '✅ ' + data.message;
        input.value = '';
        const badge = document.getElementById('js-hub-saved-badge');
        if (badge && typeof data.savedCount === 'number' && data.persistedToAccount) {
          badge.textContent = String(data.savedCount);
        }
      } else {
        msgEl.style.background = 'rgba(254, 226, 226, 0.96)';
        msgEl.style.color = '#991b1b';
        msgEl.textContent = '⚠️ ' + (data?.message || 'Mã giảm giá không hợp lệ hoặc đã hết hạn.');
      }
    } catch (e) {
      msgEl.style.display = 'block';
      msgEl.style.background = 'rgba(254, 226, 226, 0.96)';
      msgEl.style.color = '#991b1b';
      msgEl.textContent = 'Có lỗi kết nối máy chủ. Vui lòng thử lại.';
    }
  }
</script>
}
