<!DOCTYPE html>
<html lang="vi">
<head>
    <!-- ========== Meta Tags ========== -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@Url.Content("~/")" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - Sellzy" : "Sellzy - Sàn Thương Mại Điện Tử Đa Ngành")</title>

    <!-- ========== Favicon ========== -->
    <link
      rel="shortcut icon"
      href="assets/images/favicon.png"
      type="image/x-icon"
    />

    <!-- ========== Google Fonts (Vietnamese Support) ========== -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />

    <!-- ========== Huge Icons CSS ========== -->
    <link
      rel="stylesheet"
      href="assets/css/vendor/hugeicons/hgi-stroke-rounded.css"
    />

    <!-- ========== Slick CSS ========== -->
    <link rel="stylesheet" href="assets/css/vendor/slick.min.css" />

    <!-- ========== Nice Select CSS ========== -->
    <link rel="stylesheet" href="assets/css/vendor/nice-select.css" />

    <!-- ========== Animate CSS ========== -->
    <link rel="stylesheet" href="assets/css/vendor/animate.min.css" />

    <!-- ========== noUiSlider CSS ========== -->
    <link rel="stylesheet" href="assets/css/vendor/nouislider.min.css" />

    <!-- ========== Custom CSS ========== -->
    <link rel="stylesheet" href="assets/css/style.css" />
    <link rel="stylesheet" href="assets/css/toast.css" />

    <style>
      /* Global Vietnamese Typography & Smoothness Overrides */
      :root {
        --font-dm-sans: "Be Vietnam Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
        --font-urbanist: "Plus Jakarta Sans", "Be Vietnam Pro", -apple-system, BlinkMacSystemFont, sans-serif !important;
      }

      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body, button, input, select, textarea {
        font-family: "Be Vietnam Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
      }

      h1, h2, h3, h4, h5, h6, .font-urbanist {
        font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif !important;
        letter-spacing: -0.01em;
      }

      .font-dm-sans {
        font-family: "Be Vietnam Pro", sans-serif !important;
      }

      /* Global product card and image size normalization fixes */
      .product-card-1, .product-card-2 {
        display: flex !important;
        flex-direction: column !important;
        height: 100% !important;
        justify-content: space-between !important;
        transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.28s ease !important;
        background-color: #ffffff;
      }

      .product-card-1:hover, .product-card-2:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 30px -8px rgba(22, 28, 36, 0.10), 0 4px 10px -2px rgba(22, 28, 36, 0.05) !important;
        border-color: rgba(8, 129, 120, 0.35) !important;
      }
      
      .product-image {
        aspect-ratio: 1 / 1 !important;
        width: 100% !important;
        height: auto !important;
        position: relative !important;
        overflow: hidden !important;
        background-color: #F4F3F5 !important;
        border-radius: 12px !important;
      }
      
      .product-image img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1) !important;
      }

      .product-content {
        flex-grow: 1 !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
      }

      .product-content h5,
      .product-content h6 {
        display: -webkit-box !important;
        -webkit-line-clamp: 2 !important;
        -webkit-box-orient: vertical !important;
        overflow: hidden !important;
        height: 48px !important; /* Standardize product name to exactly 2 lines */
        margin-bottom: 10px !important;
        line-height: 24px !important;
      }

      .product-content h5 a:hover,
      .product-content h6 a:hover {
        color: #088178 !important;
        transition: color 0.2s ease;
      }

      /* Global custom modern floating discount tags override */
      .product-discount-badge {
        position: absolute !important;
        top: 12px !important;
        left: 12px !important;
        background: linear-gradient(135deg, #FF3B30 0%, #FF6B00 100%) !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 11px !important;
        line-height: 1 !important;
        padding: 5px 10px !important;
        border-radius: 9999px !important;
        box-shadow: 0 4px 10px -1px rgba(255, 59, 48, 0.35) !important;
        z-index: 10 !important;
        text-transform: uppercase !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 4px !important;
        border: none !important;
        letter-spacing: 0.02em;
      }
      
      .product-discount-badge.hidden {
        display: none !important;
      }
      
      .product-discount-badge::after {
        display: none !important;
      }

      /* Smooth buttons & action icons */
      .btn {
        transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1) !important;
      }
      .btn:active {
        transform: scale(0.97);
      }

      /* Custom subtle scrollbars for sidebars and dropdowns */
      .cart-products-content::-webkit-scrollbar,
      .similar-products-content::-webkit-scrollbar,
      .quick-view-sidebar-content::-webkit-scrollbar {
        width: 6px;
      }
      .cart-products-content::-webkit-scrollbar-thumb,
      .similar-products-content::-webkit-scrollbar-thumb,
      .quick-view-sidebar-content::-webkit-scrollbar-thumb {
        background-color: rgba(145, 158, 171, 0.35);
        border-radius: 9999px;
      }

      /* ========== REDESIGNED MODERN HEADER STYLES ========== */
      .header-top {
        background: linear-gradient(90deg, #04535c 0%, #088178 50%, #04535c 100%) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      }
      .sellzy-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 38px;
        padding: 6px 0;
        gap: 16px;
        font-size: 13px;
        line-height: 20px;
        color: #ffffff;
        white-space: nowrap;
      }
      .sellzy-top-left,
      .sellzy-top-center,
      .sellzy-top-right {
        display: flex;
        align-items: center;
        white-space: nowrap;
      }
      .sellzy-top-left {
        gap: 10px;
      }
      .sellzy-top-center {
        gap: 8px;
        font-weight: 500;
      }
      .sellzy-top-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background-color: #FFEB69;
        color: #161c24;
        font-weight: 700;
        font-size: 11.5px;
        line-height: 16px;
        padding: 2px 10px;
        border-radius: 9999px;
        white-space: nowrap;
      }
      .sellzy-top-links {
        display: flex;
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
        white-space: nowrap;
      }
      .sellzy-top-link-item {
        display: flex;
        align-items: center;
        position: relative;
        white-space: nowrap;
      }
      .sellzy-top-link-item:not(:last-child)::after {
        content: "";
        display: block;
        width: 1px;
        height: 14px;
        background-color: rgba(255, 255, 255, 0.25);
        margin: 0 14px;
      }
      .sellzy-top-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: rgba(255, 255, 255, 0.95);
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s ease, opacity 0.2s ease;
      }
      .sellzy-top-link:hover {
        color: #FFEB69;
      }

      /* Header Middle */
      .header-middle {
        background-color: #ffffff;
        padding: 16px 0 !important;
      }
      .sellzy-middle-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
      }
      .sellzy-logo-wrap {
        flex-shrink: 0;
        display: flex;
        align-items: center;
      }
      .sellzy-logo-wrap img {
        max-height: 44px;
        width: auto;
      }
      .sellzy-search-wrap {
        flex: 1;
        max-width: 580px;
        margin: 0 auto;
        position: relative;
      }
      .sellzy-search-box {
        display: flex;
        align-items: center;
        width: 100%;
        height: 46px;
        background-color: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 9999px;
        padding: 4px 6px 4px 20px;
        transition: all 0.22s ease;
      }
      .sellzy-search-box:hover {
        background-color: #ffffff;
        border-color: #cbd5e1;
      }
      .sellzy-search-box:focus-within {
        background-color: #ffffff;
        border-color: #088178;
        box-shadow: 0 0 0 4px rgba(8, 129, 120, 0.12);
      }
      .sellzy-search-box input.header-search-input {
        flex: 1;
        border: none !important;
        outline: none !important;
        background: transparent !important;
        font-size: 14px;
        color: #161c24;
        padding: 0 12px 0 0 !important;
        box-shadow: none !important;
      }
      .sellzy-search-box input.header-search-input::placeholder {
        color: #919eab !important;
        opacity: 1 !important;
      }
      .sellzy-search-btn {
        width: 36px;
        height: 36px;
        border-radius: 9999px;
        background: #088178;
        color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: none;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.2s ease;
      }
      .sellzy-search-btn:hover {
        background: #04535c;
        transform: scale(1.04);
      }

      /* Header Right Actions */
      .sellzy-actions-list {
        display: flex;
        align-items: center;
        gap: 22px;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-shrink: 0;
        white-space: nowrap;
      }
      .sellzy-action-trigger {
        display: inline-flex;
        align-items: center;
        gap: 11px;
        padding: 4px 8px 4px 4px;
        border-radius: 9999px;
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.2s ease;
        white-space: nowrap;
      }
      .sellzy-action-trigger:hover {
        background-color: #f8fafc;
      }
      .sellzy-action-icon {
        width: 42px;
        height: 42px;
        border-radius: 9999px;
        background-color: #FFF6C5;
        border: 1px solid #FFE27A;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
        flex-shrink: 0;
        transition: all 0.22s ease;
      }
      .sellzy-action-trigger:hover .sellzy-action-icon {
        background-color: #FFEB69;
        transform: translateY(-1px);
      }
      .sellzy-action-text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        line-height: 1.25;
        white-space: nowrap;
      }
      .sellzy-action-sub {
        font-size: 12px;
        color: #637381;
        font-weight: 400;
      }
      .sellzy-action-main {
        font-size: 14px;
        font-weight: 600;
        color: #161c24;
        max-width: 135px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* Header Bottom Nav */
      .header-bottom {
        background-color: #ffffff;
        border-top: 1px solid #f1f5f9 !important;
        border-bottom: 1px solid #e2e8f0 !important;
      }
      .sellzy-bottom-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        min-height: 54px;
        white-space: nowrap;
      }
      .sellzy-cat-btn {
        display: inline-flex !important;
        align-items: center !important;
        gap: 10px !important;
        height: 40px !important;
        padding: 0 18px !important;
        border-radius: 10px !important;
        background-color: #088178 !important;
        color: #ffffff !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        white-space: nowrap !important;
      }
      .sellzy-cat-btn:hover {
        background-color: #04535c !important;
      }
      .header-bottom .main-menu ul {
        display: flex !important;
        align-items: center !important;
        gap: 4px !important;
        white-space: nowrap !important;
      }
      .header-bottom .main-menu ul li a {
        display: inline-flex !important;
        align-items: center !important;
        gap: 5px !important;
        padding: 8px 14px !important;
        font-size: 14.5px !important;
        font-weight: 600 !important;
        color: #212b36 !important;
        border-radius: 8px !important;
        white-space: nowrap !important;
        transition: all 0.2s ease !important;
      }
      .header-bottom .main-menu ul li a:hover,
      .header-bottom .main-menu ul li a.active {
        color: #088178 !important;
        background-color: rgba(8, 129, 120, 0.08) !important;
      }
      .sellzy-hotline-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 5px 14px 5px 6px;
        border-radius: 9999px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        white-space: nowrap;
        text-decoration: none;
        transition: all 0.2s ease;
      }
      .sellzy-hotline-pill:hover {
        border-color: #088178;
        background-color: rgba(8, 129, 120, 0.04);
      }
      .sellzy-hotline-icon {
        width: 32px;
        height: 32px;
        border-radius: 9999px;
        background-color: rgba(8, 129, 120, 0.12);
        color: #088178;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      @@media (max-width: 1279px) {
        .sellzy-top-left,
        .sellzy-top-right {
          display: none !important;
        }
        .sellzy-top-bar {
          justify-content: center;
        }
      }

      /* ========== REDESIGNED MODERN FOOTER STYLES ========== */
      .sellzy-subscribe-cutout {
        background-color: #ffffff;
        max-width: 680px !important;
        width: calc(100% - 32px) !important;
        margin: 0 auto -80px auto !important;
        border-radius: 0 0 56px 56px !important;
        padding: 4px 32px 24px 32px !important;
        position: relative;
        z-index: 10;
      }
      @@media (min-width: 1024px) {
        .sellzy-subscribe-cutout::before {
          content: "";
          position: absolute;
          bottom: 52px;
          left: -28px;
          width: 28px;
          height: 28px;
          background: radial-gradient(circle at 0 100%, transparent 28px, #ffffff 28.5px);
          pointer-events: none;
        }
        .sellzy-subscribe-cutout::after {
          content: "";
          position: absolute;
          bottom: 52px;
          right: -28px;
          width: 28px;
          height: 28px;
          background: radial-gradient(circle at 100% 100%, transparent 28px, #ffffff 28.5px);
          pointer-events: none;
        }
      }
      .sellzy-subscribe-cutout h3 {
        font-size: 24px !important;
        line-height: 1.35 !important;
        font-weight: 700 !important;
        margin-bottom: 6px !important;
      }
      .sellzy-subscribe-cutout p {
        font-size: 14px !important;
        line-height: 1.5 !important;
        margin-bottom: 16px !important;
        color: #637381 !important;
      }
      .sellzy-footer {
        color: rgba(255, 255, 255, 0.82);
        border-radius: 28px !important;
        margin: 0 16px 16px 16px;
        padding-top: 112px !important;
        padding-bottom: 22px !important;
      }
      @@media (max-width: 767px) {
        .sellzy-subscribe-cutout {
          border-radius: 0 0 36px 36px !important;
          padding: 4px 20px 20px 20px !important;
          margin-bottom: -64px !important;
        }
        .sellzy-subscribe-cutout h3 {
          font-size: 20px !important;
        }
        .sellzy-footer {
          margin: 0 8px 80px 8px;
          border-radius: 22px !important;
          padding-top: 92px !important;
          padding-bottom: 20px !important;
        }
      }

      /* Footer Columns */
      .sellzy-footer-heading {
        color: #ffffff !important;
        font-size: 16px !important;
        font-weight: 700 !important;
        line-height: 1.4 !important;
        margin-bottom: 20px !important;
        position: relative;
        padding-bottom: 12px;
      }
      .sellzy-footer-heading::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 34px;
        height: 3px;
        background-color: #FFEB69;
        border-radius: 9999px;
      }
      .sellzy-footer-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 11px;
      }
      .sellzy-footer-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: rgba(255, 255, 255, 0.78);
        font-size: 14px;
        font-weight: 400;
        text-decoration: none;
        transition: all 0.2s ease;
      }
      .sellzy-footer-link i {
        font-size: 15px;
        color: rgba(255, 235, 105, 0.75);
        transition: transform 0.2s ease;
      }
      .sellzy-footer-link:hover {
        color: #FFEB69;
        transform: translateX(4px);
      }
      .sellzy-footer-link:hover i {
        transform: translateX(2px);
        color: #FFEB69;
      }
      .sellzy-social-btn {
        width: 38px;
        height: 38px;
        border-radius: 9999px;
        background-color: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        transition: all 0.22s ease;
      }
      .sellzy-social-btn:hover {
        background-color: #FFEB69;
        border-color: #FFEB69;
        color: #161c24;
        transform: translateY(-2px);
      }
      .sellzy-contact-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-size: 14px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.85);
      }
      .sellzy-contact-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background-color: rgba(255, 255, 255, 0.09);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #FFEB69;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
      }
      .sellzy-payment-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
      }
      .sellzy-pay-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 8px;
        background-color: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #ffffff;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .sellzy-footer-bottom {
        margin-top: 26px;
        padding-top: 18px;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        font-size: 13.5px;
        color: rgba(255, 255, 255, 0.65);
      }
      .sellzy-footer-bottom-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 20px;
      }
      .sellzy-footer-bottom-links a {
        color: rgba(255, 255, 255, 0.72);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .sellzy-footer-bottom-links a:hover {
        color: #FFEB69;
      }
      /* ========== HOME BENEFIT / CTA CARDS ========== */
      .sellzy-cta-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 28px 22px;
        border-radius: 20px;
        border: 1px solid rgba(22, 28, 36, 0.08);
        text-align: center;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }
      .sellzy-cta-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(22, 28, 36, 0.08);
      }
      .sellzy-cta-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: #ffffff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(22, 28, 36, 0.06);
        flex-shrink: 0;
      }
      .sellzy-cta-card h5 {
        margin: 16px 0 8px 0;
        padding: 0;
        font-size: 18px;
        line-height: 1.35;
        font-weight: 700;
        color: #161C24;
      }
      .sellzy-cta-card p {
        margin: 0;
        font-size: 14px;
        line-height: 1.55;
        color: #212B36;
        max-width: 245px;
      }
    </style>

    @await RenderSectionAsync("Styles", required: false)
  </head>
  <body>
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration
    @{
      var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
      var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

      var isHomePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
      var isAboutPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "About", StringComparison.OrdinalIgnoreCase);
      var isContactPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Contact", StringComparison.OrdinalIgnoreCase);
      var isFlashSalePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "FlashSale", StringComparison.OrdinalIgnoreCase);

      var googleEnabled = !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"])
        && !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]);
    }

    <!-- Preloader Start -->
    <div id="preloader" class="preloader">
      <div class="pxl-loader-spinner">
        <div class="pxl-loader-bounce1"></div>
        <div class="pxl-loader-bounce2"></div>
