    @{
        var aiChatUserId = User.Identity?.IsAuthenticated == true
            ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            : null;
        var aiChatStorageKey = !string.IsNullOrWhiteSpace(aiChatUserId)
            ? $"sellzy_ai_chat_u_{aiChatUserId}"
            : "sellzy_ai_chat_guest";
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("chatbot-toggle-btn");
            const chatBox = document.getElementById("chatbot-box");
            const iconOpen = document.getElementById("chat-icon-open");
            const iconClose = document.getElementById("chat-icon-close");
            const chatInput = document.getElementById("chatbot-input");
            const sendBtn = document.getElementById("chatbot-send-btn");
            const resetBtn = document.getElementById("chatbot-reset-btn");
            const chatBody = document.getElementById("chatbot-body");

            const STORAGE_KEY = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(aiChatStorageKey));
            const MAX_SAVED_MSGS = 30;
            const TTL_MS = 24 * 60 * 60 * 1000; // 24 giờ
            const WELCOME_HTML = '<div class="ai-msg-row bot"><div class="ai-msg-bubble bot"><p style="margin:0;">Xin chào! Mình là <strong>Trợ lý AI Sellzy</strong>. Bạn có thể hỏi tìm sản phẩm đa ngành, săn Flash Sale/Voucher, tra cứu đơn hàng, giỏ hàng hoặc Ví Sellzy nhé!</p></div></div>';

            let chatHistory = [];

            function loadLocalHistory() {
                try {
                    const raw = localStorage.getItem(STORAGE_KEY);
                    if (!raw) return [];
                    const parsed = JSON.parse(raw);
                    if (!parsed || !Array.isArray(parsed.messages)) return [];
                    if (parsed.updatedAt && (Date.now() - parsed.updatedAt > TTL_MS)) {
                        localStorage.removeItem(STORAGE_KEY);
                        return [];
                    }
                    return parsed.messages.slice(-MAX_SAVED_MSGS);
                } catch {
                    return [];
                }
            }

            function saveLocalHistory() {
                try {
                    const payload = {
                        updatedAt: Date.now(),
                        messages: chatHistory.slice(-MAX_SAVED_MSGS)
                    };
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
                } catch (e) {
                    console.warn("Không thể lưu lịch sử chat vào localStorage:", e);
                }
            }

            // Render Markdown an toàn (escape HTML trước rồi mới format bold/code/newline)
            function renderSafeMarkdown(text) {
                const escaped = String(text ?? "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
                return escaped
                    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
                    .replace(/`([^`]+)`/g, "<code>$1</code>")
                    .replace(/\n/g, "<br/>");
            }

            // 1. Logic Đóng/Mở Popup
            toggleBtn.addEventListener("click", function () {
                const isHidden = chatBox.classList.contains("hidden");
                if (isHidden) {
                    chatBox.classList.remove("hidden");
                    iconOpen.style.display = "none";
                    iconClose.style.display = "block";
                    chatInput.focus();
                    loadHistoryIfNeeded();
                } else {
                    chatBox.classList.add("hidden");
                    iconOpen.style.display = "block";
                    iconClose.style.display = "none";
                }
            });

            // Nút làm mới cuộc trò chuyện (xóa phiên localStorage)
            if (resetBtn) {
                resetBtn.addEventListener("click", function () {
                    chatHistory = [];
                    try { localStorage.removeItem(STORAGE_KEY); } catch {}
                    chatBody.innerHTML = WELCOME_HTML;
                    chatInput.focus();
                });
            }

            // Quick Action Chips
            document.querySelectorAll(".ai-quick-chip").forEach(chip => {
                chip.addEventListener("click", function () {
                    const prompt = this.getAttribute("data-prompt");
                    if (prompt) {
                        chatInput.value = prompt;
                        handleSendMessage();
                    }
                });
            });

            // 2. Hàm chèn tin nhắn mới vào giao diện HTML
            function appendMessage(sender, text, products, quickLinks) {
                const msgRow = document.createElement("div");
                msgRow.className = "ai-msg-row " + sender;

                const msgBubble = document.createElement("div");
                msgBubble.className = "ai-msg-bubble " + sender;

                msgRow.appendChild(msgBubble);
                chatBody.appendChild(msgRow);
                chatBody.scrollTop = chatBody.scrollHeight;

                if (sender !== "bot" || !text) {
                    const p = document.createElement("p");
                    p.style.margin = "0";
                    p.style.whiteSpace = "pre-wrap";
                    p.textContent = text ?? "";
                    msgBubble.appendChild(p);
                    return;
                }

                // Phân tích cú pháp để chèn thẻ sản phẩm đúng vị trí dưới mỗi dòng mô tả sản phẩm
                const lines = text.split('\n');
                const segments = [];
                let currentSegment = { type: 'text', lines: [] };
                segments.push(currentSegment);

                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i];
                    const match = /ID:\s*(\d+)/i.exec(line);
                    const isProductHeader = /^\s*\d+\./.test(line) && match;

                    if (isProductHeader) {
                        const id = parseInt(match[1]);
                        currentSegment = { type: 'product', id: id, lines: [line] };
                        segments.push(currentSegment);
                    } else {
                        const isListItem = /^\s*[\*\-\u2022]/.test(line);
                        if (currentSegment.type === 'product' && (isListItem || line.trim() === '')) {
                            currentSegment.lines.push(line);
                        } else {
                            if (currentSegment.type !== 'text') {
                                currentSegment = { type: 'text', lines: [] };
                                segments.push(currentSegment);
                            }
                            currentSegment.lines.push(line);
                        }
                    }
                }

                const productPlaceholders = {};

                for (const seg of segments) {
                    if (seg.lines.length === 0) continue;
                    const contentText = seg.lines.join('\n').trim();
                    if (!contentText) continue;

                    const div = document.createElement("div");
                    div.style.margin = "0";
                    div.innerHTML = renderSafeMarkdown(contentText);
                    msgBubble.appendChild(div);

                    if (seg.type === 'product') {
                        const cardContainer = document.createElement("div");
                        cardContainer.style.marginTop = "6px";
                        cardContainer.style.marginBottom = "10px";
                        msgBubble.appendChild(cardContainer);
                        productPlaceholders[seg.id] = cardContainer;
                    }
                }

                const items = Array.isArray(products)
                    ? products
                    : (Array.isArray(products?.$values) ? products.$values : []);

                const productIds = Object.keys(productPlaceholders).map(id => parseInt(id));
                const renderedIds = new Set();

                if (productIds.length > 0) {
                    if (items.length > 0) {
                        for (const pid of productIds) {
                            const pData = items.find(item => (item.id || item.Id) === pid);
                            if (pData && productPlaceholders[pid]) {
                                renderSingleProductCard(pData, productPlaceholders[pid]);
                                renderedIds.add(pid);
                            }
                        }
                    } else {
                        fetchAndRenderProductCards(productIds, productPlaceholders);
                    }
                }

                // Nếu có thẻ sản phẩm chưa được gắn inline, hiển thị gọn cuối bong bóng
                const extraItems = items.filter(it => !renderedIds.has(it.id || it.Id));
                if (extraItems.length > 0) {
                    const extraWrap = document.createElement("div");
                    extraWrap.style.display = "flex";
                    extraWrap.style.flexDirection = "column";
                    extraWrap.style.gap = "7px";
                    extraWrap.style.marginTop = "8px";
                    for (const it of extraItems.slice(0, 4)) {
                        renderSingleProductCard(it, extraWrap);
                    }
                    msgBubble.appendChild(extraWrap);
                }

                // Render Quick Links (nút đi nhanh tới Đơn hàng, Giỏ hàng, Ví, Khiếu nại...)
                const links = Array.isArray(quickLinks) ? quickLinks : [];
                if (links.length > 0) {
                    const linkWrap = document.createElement("div");
                    linkWrap.className = "ai-quick-links";
                    for (const lk of links) {
                        const url = (lk.url || lk.Url || "").toString();
                        const label = (lk.label || lk.Label || "").toString();
                        if (!url || !label) continue;
                        const a = document.createElement("a");
                        a.href = url;
                        a.className = "ai-quick-link-btn";
                        a.textContent = label + " →";
                        linkWrap.appendChild(a);
                    }
                    if (linkWrap.children.length > 0) msgBubble.appendChild(linkWrap);
                }

                chatBody.scrollTop = chatBody.scrollHeight;
            }

            async function fetchAndRenderProductCards(ids, placeholders) {
                try {
                    const params = ids.map(id => `ids=${id}`).join('&');
                    const response = await fetch(`/api/products/get-by-ids?${params}`);
                    if (response.ok) {
                        const products = await response.json();
                        if (products && products.length > 0) {
                            for (const p of products) {
                                const pid = p.id || p.Id;
                                if (placeholders[pid]) {
                                    renderSingleProductCard(p, placeholders[pid]);
                                }
                            }
                            chatBody.scrollTop = chatBody.scrollHeight;
                        }
                    }
                } catch (err) {
                    console.error("Lỗi khi tải thẻ sản phẩm cho chatbot:", err);
                }
            }

            function formatPriceRange(minPrice, maxPrice) {
                const min = Number(minPrice ?? 0);
                const max = Number(maxPrice ?? 0);
                const fmt = (v) => (Number.isFinite(v) ? v.toLocaleString('vi-VN') + 'đ' : '');
                if (max > 0 && max !== min) return `${fmt(min)}–${fmt(max)}`;
                return fmt(min);
            }

            function renderSingleProductCard(p, container) {
                const card = document.createElement('div');
                card.style.display = 'flex';
                card.style.alignItems = 'center';
                card.style.gap = '10px';
                card.style.padding = '8px';
                card.style.border = '1px solid #e2e8f0';
                card.style.borderRadius = '12px';
                card.style.backgroundColor = '#ffffff';
                card.style.boxShadow = '0 1px 3px rgba(15,23,42,0.04)';
                card.style.transition = 'border-color 0.2s, transform 0.2s';
                card.onmouseover = () => { card.style.transform = 'translateY(-1px)'; card.style.borderColor = '#088178'; };
                card.onmouseout = () => { card.style.transform = 'none'; card.style.borderColor = '#e2e8f0'; };

                let imageUrl = (p?.imageUrl || p?.ImageUrl || '').toString();
                const nameText = (p?.name || p?.Name || '').toString();
                const slug = (p?.slug || p?.Slug || '').toString();
                const minPrice = p?.minPrice ?? p?.MinPrice;
                const maxPrice = p?.maxPrice ?? p?.MaxPrice;
                const rating = p?.rating ?? p?.Rating;
                const isMall = Boolean(p?.isMall ?? p?.IsMall);
                const isFlashSale = Boolean(p?.isFlashSale ?? p?.IsFlashSale);

                if (imageUrl && !/^https?:\/\//i.test(imageUrl) && !imageUrl.startsWith('/')) {
                    imageUrl = '/' + imageUrl;
                }
                if (!imageUrl) {
                    imageUrl = '/assets/images/placeholder.png';
                }

                const detailHref = slug ? ('/product/' + encodeURIComponent(slug)) : '#';

                const imageLink = document.createElement('a');
                imageLink.href = detailHref;
                imageLink.style.width = '48px';
                imageLink.style.height = '48px';
                imageLink.style.borderRadius = '8px';
                imageLink.style.overflow = 'hidden';
                imageLink.style.flexShrink = '0';
                imageLink.style.display = 'block';
                imageLink.style.border = '1px solid #f1f5f9';

                const img = document.createElement('img');
                img.src = imageUrl;
                img.alt = nameText || 'Sản phẩm';
                img.style.width = '100%';
                img.style.height = '100%';
                img.style.objectFit = 'cover';
                imageLink.appendChild(img);
                card.appendChild(imageLink);

                const info = document.createElement('div');
                info.style.flex = '1';
                info.style.minWidth = '0';
                info.style.display = 'flex';
                info.style.flexDirection = 'column';
                info.style.gap = '2px';

                const nameA = document.createElement('a');
                nameA.href = detailHref;
                nameA.textContent = nameText;
                nameA.style.fontWeight = '600';
                nameA.style.fontSize = '12.5px';
                nameA.style.color = '#1e293b';
                nameA.style.textDecoration = 'none';
                nameA.style.whiteSpace = 'nowrap';
                nameA.style.overflow = 'hidden';
                nameA.style.textOverflow = 'ellipsis';
                nameA.style.display = 'block';
                nameA.onmouseover = () => nameA.style.color = '#088178';
                nameA.onmouseout = () => nameA.style.color = '#1e293b';
                info.appendChild(nameA);

                const meta = document.createElement('div');
                meta.style.fontSize = '11.5px';
                meta.style.color = '#088178';
                meta.style.fontWeight = '700';
                const priceText = formatPriceRange(minPrice, maxPrice);
                const ratingText = (rating !== undefined && rating !== null && rating !== '')
                    ? ` • ${Number(rating).toFixed(1)}⭐`
                    : '';
                meta.textContent = priceText + ratingText;
                info.appendChild(meta);

                const actionRow = document.createElement('div');
                actionRow.style.display = 'flex';
                actionRow.style.alignItems = 'center';
                actionRow.style.gap = '6px';
                actionRow.style.marginTop = '2px';

                const btn = document.createElement('a');
                btn.textContent = 'Xem chi tiết';
                btn.href = detailHref;
                btn.style.fontSize = '10.5px';
                btn.style.padding = '2px 8px';
                btn.style.color = '#ffffff';
                btn.style.backgroundColor = '#088178';
                btn.style.borderRadius = '999px';
                btn.style.textDecoration = 'none';
                btn.style.fontWeight = '600';
                btn.onmouseover = () => btn.style.backgroundColor = '#066a62';
                btn.onmouseout = () => btn.style.backgroundColor = '#088178';
                if (!slug) {
                    btn.style.pointerEvents = 'none';
                    btn.style.opacity = '0.6';
                }
                actionRow.appendChild(btn);

                if (isMall) {
                    const mallTag = document.createElement('span');
                    mallTag.textContent = 'Mall';
                    mallTag.style.fontSize = '10px';
                    mallTag.style.fontWeight = '700';
                    mallTag.style.padding = '1px 6px';
                    mallTag.style.borderRadius = '999px';
                    mallTag.style.background = '#fef2f2';
                    mallTag.style.color = '#dc2626';
                    actionRow.appendChild(mallTag);
                }
                if (isFlashSale) {
                    const saleTag = document.createElement('span');
                    saleTag.textContent = 'Flash Sale';
                    saleTag.style.fontSize = '10px';
                    saleTag.style.fontWeight = '700';
                    saleTag.style.padding = '1px 6px';
                    saleTag.style.borderRadius = '999px';
                    saleTag.style.background = '#fff7ed';
                    saleTag.style.color = '#ea580c';
                    actionRow.appendChild(saleTag);
                }

                info.appendChild(actionRow);
                card.appendChild(info);
                container.appendChild(card);
            }

            let historyLoaded = false;
            function loadHistoryIfNeeded() {
                if (historyLoaded) return;
                historyLoaded = true;

                chatHistory = loadLocalHistory();
                if (chatHistory.length > 0) {
                    chatBody.innerHTML = '';
                    for (const m of chatHistory) {
                        appendMessage(m.sender === 'user' ? 'user' : 'bot', m.content || '', m.products || [], m.quickLinks || []);
                    }
                }
            }

            // 3. Logic xử lý gửi tin nhắn sang API C# (ChatbotController - Stateless + gửi ngữ cảnh 6 tin gần nhất)
            async function handleSendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;

                if (!historyLoaded) loadHistoryIfNeeded();

                const recentContext = chatHistory.slice(-6).map(m => ({
                    sender: m.sender,
                    content: m.content
                }));

                appendMessage("user", message);
                chatHistory.push({ sender: "user", content: message });
                saveLocalHistory();
                chatInput.value = "";

                const loadingId = "msg-loading-" + Date.now();
                const loadingDiv = document.createElement("div");
                loadingDiv.id = loadingId;
                loadingDiv.className = "ai-msg-row bot";
                loadingDiv.innerHTML = `
                    <div class="ai-msg-bubble bot" style="color: #64748b; font-style: italic;">
                        Trợ lý AI Sellzy đang tra cứu dữ liệu...
                    </div>
                `;
                chatBody.appendChild(loadingDiv);
                chatBody.scrollTop = chatBody.scrollHeight;

                try {
                    const response = await fetch('/api/chatbot/ask', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: message, history: recentContext })
                    });

                    document.getElementById(loadingId)?.remove();

                    let result = null;
                    try { result = await response.json(); } catch { result = null; }

                    if (!response.ok) {
                        const serverMsg = result?.message || `Lỗi máy chủ (${response.status}).`;
                        appendMessage("bot", serverMsg);
                        return;
                    }

                    if (result?.success) {
                        const prods = result.products ?? result.Products ?? [];
                        const links = result.quickLinks ?? result.QuickLinks ?? [];
                        appendMessage("bot", result.reply, prods, links);
                        chatHistory.push({
                            sender: "bot",
                            content: result.reply || "",
                            products: prods,
                            quickLinks: links
                        });
                        saveLocalHistory();
                    } else {
                        appendMessage("bot", "Có lỗi xảy ra: " + (result?.message || "Không xác định"));
                    }
                } catch (error) {
                    document.getElementById(loadingId)?.remove();
                    appendMessage("bot", "Không thể kết nối đến máy chủ AI. Vui lòng thử lại sau.");
                    console.error(error);
                }
            }

            sendBtn.addEventListener("click", handleSendMessage);

            chatInput.addEventListener("keypress", function (e) {
                if (e.key === "Enter") {
                    handleSendMessage();
                }
            });
        });
    </script>
    <!-- ========== Chatbot AI End ========== -->

    <!-- ========== Global Product Search Script Start ========== -->
    <script>
        $(document).ready(function () {
            function executeSearch(query) {
                var q = typeof query === "string" ? query.trim() : "";
                if (q.length > 0) {
                    window.location.href = "/search?q=" + encodeURIComponent(q);
                }
            }

            $(document).on("keypress", ".header-search-input", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    executeSearch($(this).val());
                }
            });

            $(document).on("click", ".search-input-container .input-group-addon, .search-input-container .hgi-search-01", function (e) {
                e.preventDefault();
                var input = $(this).closest(".search-input-container").find(".header-search-input");
                if (input.length) {
                    executeSearch(input.val());
                }
            });

            $(document).on("click", ".recent-search-item", function (e) {
                e.preventDefault();
                var kw = $(this).text().trim();
                if (kw) executeSearch(kw);
            });

            $(document).on("click", function (e) {
                if (!$(e.target).closest(".search-input-container").length) {
                    $(".search-result-container").attr("data-state", "close");
                }
            });

            function escapeHtmlSearch(str) {
                return String(str || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
            }

            var suggestionTimeout = null;
            $(document).on("input focus", ".header-search-input", function () {
                var inputEl = $(this);
                var container = inputEl.closest(".search-input-container");
                var resultPopup = container.find(".search-result-container");
                var rawValue = inputEl.val();
                var q = typeof rawValue === "string" ? rawValue.trim() : "";

                clearTimeout(suggestionTimeout);

                if (q.length === 0) {
                    resultPopup.attr("data-state", "close");
                    return;
                }

                resultPopup.attr("data-state", "open");
                var wrapper = container.find(".recommended-search-list-wrapper");
                if (!wrapper.find(".recommended-search-list").length) {
                    wrapper.html('<p class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Đang tìm gợi ý...</p><div class="recommended-search-list"></div>');
                }

                suggestionTimeout = setTimeout(function () {
                    $.ajax({
                        url: "/api/search/live-suggest",
                        type: "GET",
                        data: { q: q },
                        success: function (res) {
                            var shops = (res && Array.isArray(res.shops)) ? res.shops : [];
                            var products = (res && Array.isArray(res.products)) ? res.products : [];
                            var safeQ = escapeHtmlSearch(q);

                            if (shops.length === 0 && products.length === 0) {
                                wrapper.html(`
                                    <div style="padding:18px 8px; text-align:center; color:#64748b; font-size:13.5px;">
                                        Không tìm thấy sản phẩm hoặc gian hàng khớp với "<strong>${safeQ}</strong>"
                                    </div>
                                `);
                                return;
                            }

                            var html = '';
                            if (shops.length > 0) {
                                html += `<div style="font-size:11px; font-weight:800; color:#64748b; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:8px;">🏪 Gian hàng liên quan</div>`;
                                shops.forEach(function (s) {
                                    var mallBadge = s.isMall ? `<span style="background:#dc2626; color:#fff; font-size:9.5px; font-weight:800; padding:1px 6px; border-radius:999px; margin-left:6px;">MALL</span>` : '';
                                    html += `
                                        <a href="/shop/${encodeURIComponent(s.slug)}" style="display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:12px; background:#f8fafc; border:1px solid #e2e8f0; margin-bottom:6px; text-decoration:none;">
                                            <img src="${escapeHtmlSearch(s.logoUrl)}" alt="${escapeHtmlSearch(s.name)}" style="width:36px; height:36px; border-radius:50%; object-fit:cover; border:1px solid #cbd5e1; flex-shrink:0;" />
                                            <div style="min-width:0; flex:1;">
                                                <div style="font-size:13.5px; font-weight:700; color:#0f172a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeHtmlSearch(s.name)}${mallBadge}</div>
                                                <div style="font-size:11.5px; color:#64748b;">${s.productCount} sản phẩm đang bán</div>
                                            </div>
                                            <span style="font-size:11.5px; font-weight:700; color:#008374; flex-shrink:0;">Xem Shop →</span>
                                        </a>
                                    `;
                                });
                            }

                            if (products.length > 0) {
                                html += `<div style="font-size:11px; font-weight:800; color:#64748b; text-transform:uppercase; letter-spacing:0.05em; margin:${shops.length > 0 ? '12px' : '0'} 0 8px;">📦 Sản phẩm gợi ý</div>`;
                                products.forEach(function (item) {
                                    var detailsUrl = "/product/" + encodeURIComponent(item.slug);
                                    var priceFmt = new Intl.NumberFormat('vi-VN').format(item.price) + '₫';
                                    var oldFmt = (item.oldPrice && item.oldPrice > item.price)
                                        ? `<span style="font-size:11.5px; color:#94a3b8; text-decoration:line-through; margin-left:6px;">${new Intl.NumberFormat('vi-VN').format(item.oldPrice)}₫</span>`
                                        : '';
                                    html += `
                                        <a href="${detailsUrl}" style="display:flex; align-items:center; gap:12px; padding:7px 8px; border-radius:12px; text-decoration:none; transition:background 0.15s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
                                            <img src="${escapeHtmlSearch(item.imageUrl)}" alt="${escapeHtmlSearch(item.name)}" style="width:44px; height:44px; border-radius:10px; object-fit:cover; background:#f8fafc; border:1px solid #e2e8f0; flex-shrink:0;" />
                                            <div style="min-width:0; flex:1;">
                                                <div style="font-size:13.5px; font-weight:600; color:#0f172a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${escapeHtmlSearch(item.name)}</div>
                                                <div style="display:flex; align-items:center; gap:6px; margin-top:2px;">
                                                    <span style="font-size:13.5px; font-weight:800; color:#008374;">${priceFmt}</span>${oldFmt}
                                                    <span style="font-size:11px; color:#d97706; margin-left:auto;">★ ${escapeHtmlSearch(item.rating)}</span>
                                                </div>
                                            </div>
                                        </a>
                                    `;
                                });
                            }

                            html += `
                                <div style="margin-top:10px; padding-top:10px; border-top:1px solid #e2e8f0; text-align:center;">
                                    <a href="/search?q=${encodeURIComponent(q)}" style="display:inline-block; width:100%; padding:8px 12px; border-radius:999px; background:#e6f4f3; color:#008374; font-size:12.5px; font-weight:800; text-decoration:none;">
                                        🔍 Xem tất cả kết quả cho "${safeQ}" →
                                    </a>
                                </div>
                            `;
                            wrapper.html(html);
                        }
                    });
                }, 220);
            });
        });
    </script>
    <!-- ========== Global Product Search Script End ========== -->
  </body>

