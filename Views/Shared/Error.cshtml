@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra sự cố";
}

<style>
    .sz-err-wrap {
        background: #eef2f6;
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 16px;
    }
    .sz-err-card {
        max-width: 520px;
        width: 100%;
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 24px;
        padding: 40px 32px;
        text-align: center;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
    }
    .sz-err-icon {
        width: 84px;
        height: 84px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #d97706;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
    }
    .sz-err-title {
        font-size: 25px;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 10px;
    }
    .sz-err-desc {
        font-size: 14.5px;
        line-height: 1.65;
        color: #64748b;
        margin: 0 0 22px;
    }
    .sz-err-req {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 12.5px;
        color: #475569;
        margin-bottom: 24px;
        word-break: break-all;
    }
    .sz-err-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .sz-err-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 12px 22px;
        border-radius: 999px;
        font-size: 13.5px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }
    .sz-err-btn-main {
        background: linear-gradient(135deg, #022c22 0%, #008374 100%);
        color: #ffffff;
        border: none;
    }
    .sz-err-btn-main:hover { color: #ffffff; filter: brightness(1.08); }
    .sz-err-btn-sub {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }
</style>

<div class="sz-err-wrap">
    <div class="sz-err-card">
        <div class="sz-err-icon">
            <i class="hgi hgi-stroke hgi-alert-02"></i>
        </div>
        <h1 class="sz-err-title">Rất tiếc, yêu cầu tạm thời gián đoạn</h1>
        <p class="sz-err-desc">
            Hệ thống Sellzy gặp sự cố ngoài ý muốn khi xử lý thao tác vừa rồi. Bạn vui lòng tải lại trang hoặc quay về Trang chủ để tiếp tục mua sắm nhé.
        </p>

        @if (Model != null && Model.ShowRequestId)
        {
            <div class="sz-err-req">
                Mã tham chiếu hỗ trợ: <strong>@Model.RequestId</strong>
            </div>
        }

        <div class="sz-err-actions">
            <a href="/" class="sz-err-btn sz-err-btn-main">
                <i class="hgi hgi-stroke hgi-home-01"></i> Về Trang chủ
            </a>
            <a href="/Home/Contact" class="sz-err-btn sz-err-btn-sub">
                <i class="hgi hgi-stroke hgi-customer-service-01"></i> Liên hệ Hỗ trợ
            </a>
        </div>
    </div>
</div>
