@model DOAN_BANHANG.Components.NotificationViewModel
@{
    var isShopOrAdmin = string.Equals(Model.UserRole, "Shop", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(Model.UserRole, "Admin", StringComparison.OrdinalIgnoreCase);
}

<li class="sellzy-top-link-item">
    <div id="notification-sidebar-btn"
         class="notification-trigger sellzy-top-link cursor-pointer"
         data-signed-in="@(Model.IsSignedIn ? "true" : "false")"
         data-user-role="@Model.UserRole"
         data-auth-prompt="@(!Model.IsSignedIn ? "notifications" : null)"
         data-auth-return-url="@(!Model.IsSignedIn ? "/Chat/SystemNotifications" : null)">
        <div class="relative inline-flex items-center justify-center" style="width: 18px; height: 18px;">
            <i class="hgi hgi-stroke hgi-notification-03 text-[16px] text-white"></i>
            <div id="header-notif-unread-badge"
                 class="bg-error text-white font-bold flex items-center justify-center @(Model.IsSignedIn && Model.UnreadCount > 0 ? "" : "hidden")"
                 style="position: absolute !important; top: -6px !important; right: -8px !important; min-width: 16px !important; height: 16px !important; padding: 0 3px !important; border-radius: 9999px !important; font-size: 9px !important; border: 1.5px solid #065f5b !important; z-index: 20 !important;">
                @(Model.UnreadCount > 9 ? "9+" : Model.UnreadCount.ToString())
            </div>
        </div>
        <span>Thông báo</span>
    </div>

    <div id="notification-sidebar"
         data-state="close"
         data-is-seller="@(isShopOrAdmin ? "true" : "false")"
         class="notif-sidebar-container">

        <!-- Header -->
        <div class="notif-header-wrapper">
            <div class="notif-header">
                <div class="notif-header-top">
                    <div class="notif-title-wrap">
                        <div class="notif-title-icon">
                            <i class="hgi hgi-stroke hgi-notification-03"></i>
                        </div>
                        <div class="notif-title-text">
                            <div class="notif-title-line">
                                <h5>Thông báo</h5>
                                <span id="drawer-notif-unread-badge" class="notif-count-badge @(Model.IsSignedIn && Model.UnreadCount > 0 ? "" : "hidden")">
                                    @Model.UnreadCount mới
                                </span>
                            </div>
                            <span id="notif-role-subtitle" class="notif-role-pill">
                                @(Model.IsSignedIn ? (isShopOrAdmin ? "Gian hàng & Tài khoản mua sắm" : "Tài khoản thành viên Sellzy") : "Trung tâm cập nhật Sellzy")
                            </span>
                        </div>
                    </div>
                    <button type="button" class="notification-sidebar-close notif-close-btn" title="Đóng">
                        <i class="hgi hgi-stroke hgi-multiplication-sign"></i>
                    </button>
                </div>
            </div>

            <!-- Filter & Action Bar -->
            <div id="notif-header-actions" class="notif-header-actions @(Model.IsSignedIn && Model.Notifications.Any() ? "" : "hidden")">
                <div class="notif-filter-pills">
                    <button type="button" class="notif-pill active" data-drawer-filter="all">Tất cả</button>
                    <button type="button" class="notif-pill" data-drawer-filter="unread">Chưa đọc</button>
                </div>
                <button type="button" class="notif-readall-link mark-all-read">
                    <i class="hgi hgi-stroke hgi-checkmark-circle-02"></i>
                    <span>Đọc hết</span>
                </button>
            </div>
        </div>

        <!-- Body -->
        <div id="notif-drawer-body" class="notif-body custom-scrollbar">
            @if (!Model.IsSignedIn)
            {
                <div class="notif-empty-state" id="notif-guest-state">
                    <div class="notif-empty-ring">
                        <div class="notif-empty-icon lock-icon-glow">
                            <i class="hgi hgi-stroke hgi-lock-sync-01"></i>
                        </div>
                    </div>
                    <h6 class="notif-empty-title">Đăng nhập để xem thông báo</h6>
                    <p class="notif-empty-desc">Cập nhật hành trình đơn hàng, ưu đãi Flash Sale và biến động Ví Sellzy theo thời gian thực.</p>
                    <button type="button" class="login-page-btn notif-primary-btn">
                        Đăng nhập tài khoản
                    </button>
                </div>
            }
            else if (Model.Notifications.Any())
            {
                <div class="notif-list" id="notif-drawer-list">
                    @foreach (var item in Model.Notifications)
                    {
                        var themeClass = item.CategoryKey switch
                        {
                            "order" => "theme-order",
                            "return" => "theme-return",
                            "dispute" => "theme-dispute",
                            "wallet" => "theme-wallet",
                            "promo" => "theme-promo",
                            _ => "theme-system"
                        };

                        <div class="notif-item @(!item.IsRead ? "unread" : "") @themeClass"
                             data-id="@item.Id"
                             data-unread="@(!item.IsRead ? "true" : "false")"
                             data-action-url="@(item.ActionUrl ?? "")">
                            @if (!item.IsRead)
                            {
                                <div class="notif-unread-indicator"></div>
                            }

                            <div class="notif-item-icon-container">
                                <div class="notif-item-icon">
                                    <i class="hgi hgi-stroke @item.IconClass"></i>
                                </div>
                            </div>

                            <div class="notif-item-content">
                                <div class="notif-item-header">
                                    <span class="notif-category-label">@item.CategoryLabel</span>
                                    <span class="notif-time">
                                        <i class="hgi hgi-stroke hgi-clock-01"></i> @item.CreatedAt.AddHours(7).ToString("dd/MM HH:mm")
                                    </span>
                                </div>
                                <h6>@item.Title</h6>
                                <p>@item.Content</p>
                                @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                                {
                                    <div class="notif-item-link-row">
                                        <span class="notif-smart-link">
                                            @(item.ActionText ?? "Xem chi tiết")
                                            <i class="hgi hgi-stroke hgi-arrow-right-01"></i>
                                        </span>
                                    </div>
                                }
                            </div>

                            @if (!item.IsRead)
                            {
                                <button type="button" class="notif-quick-read-btn mark-as-read-btn" title="Đánh dấu đã đọc">
                                    <i class="hgi hgi-stroke hgi-tick-02 text-white"></i>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="notif-empty-state">
                    <div class="notif-empty-ring">
                        <div class="notif-empty-icon empty-icon-glow">
                            <i class="hgi hgi-stroke hgi-notification-03"></i>
                        </div>
                    </div>
                    <h6 class="notif-empty-title">Bạn đã cập nhật hết rồi!</h6>
                    <p class="notif-empty-desc">
                        Mọi cập nhật về đơn hàng, ví tiền, khuyến mãi và hoạt động gian hàng sẽ hiển thị ngay tại đây.
                    </p>
                    <div class="notif-shortcuts-grid">
                        @if (isShopOrAdmin)
                        {
                            <a href="/Admin/Orders/Index" class="notif-shortcut-card">
                                <span class="notif-shortcut-ic ic-teal"><i class="hgi hgi-stroke hgi-store-01"></i></span>
                                <span class="notif-shortcut-lbl">Đơn bán hàng</span>
                            </a>
                            <a href="/my-orders" class="notif-shortcut-card">
                                <span class="notif-shortcut-ic ic-amber"><i class="hgi hgi-stroke hgi-package-box"></i></span>
                                <span class="notif-shortcut-lbl">Đơn mua của tôi</span>
                            </a>
                            <a href="/Admin/SellerWallet/Index" class="notif-shortcut-card">
                                <span class="notif-shortcut-ic ic-emerald"><i class="hgi hgi-stroke hgi-wallet-02"></i></span>
                                <span class="notif-shortcut-lbl">Ví Doanh thu</span>
                            </a>
                        }
                        else
                        {
                            <a href="/my-orders" class="notif-shortcut-card">
                                <span class="notif-shortcut-ic ic-teal"><i class="hgi hgi-stroke hgi-package-box"></i></span>
                                <span class="notif-shortcut-lbl">Đơn mua của tôi</span>
                            </a>
                            <a href="/my-wallet" class="notif-shortcut-card">
                                <span class="notif-shortcut-ic ic-emerald"><i class="hgi hgi-stroke hgi-wallet-02"></i></span>
                                <span class="notif-shortcut-lbl">Ví Sellzy</span>
                            </a>
                            <a href="/vouchers" class="notif-shortcut-card">
                                <span class="notif-shortcut-ic ic-rose"><i class="hgi hgi-stroke hgi-ticket-01"></i></span>
                                <span class="notif-shortcut-lbl">Kho Voucher</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Footer -->
        <div id="notif-drawer-footer" class="notif-footer @(Model.IsSignedIn ? "" : "hidden")">
            <div class="notif-footer-grid">
                <a href="/Chat/SystemNotifications" class="notif-footer-link">
                    <span>Trung tâm thông báo</span>
                    <i class="hgi hgi-stroke hgi-arrow-right-01"></i>
                </a>
                @if (isShopOrAdmin)
                {
                    <a href="/Admin/Orders/Index" class="notif-footer-seller-btn" title="Quản lý đơn bán hàng">
                        <i class="hgi hgi-stroke hgi-store-01"></i>
                        <span>Đơn bán</span>
                    </a>
                }
                else
                {
                    <a href="/my-orders" class="notif-footer-seller-btn" title="Theo dõi đơn mua">
                        <i class="hgi hgi-stroke hgi-package-box"></i>
                        <span>Đơn mua</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <style>
        .notif-sidebar-container {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            position: fixed;
            right: 16px;
            top: 16px;
            width: calc(100vw - 32px);
            max-width: 420px;
            height: calc(100vh - 32px);
            border-radius: 24px;
            overflow: hidden !important;
            background-color: #f8fafc;
            z-index: 10050 !important;
            display: flex;
            flex-direction: column;
            box-shadow: 0 24px 60px -12px rgba(15, 23, 42, 0.32), 0 0 0 1px rgba(15, 23, 42, 0.06);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
            white-space: normal !important;
            text-align: left;
            box-sizing: border-box;
        }

        .notif-sidebar-container *,
        .notif-sidebar-container *::before,
        .notif-sidebar-container *::after {
            box-sizing: border-box;
            white-space: normal;
        }

        .notif-sidebar-container[data-state="open"] {
            transform: translateX(0);
            opacity: 1;
            visibility: visible;
        }

        .notif-sidebar-container[data-state="close"] {
            transform: translateX(120%);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .notif-header-wrapper {
            flex-shrink: 0;
            z-index: 10;
        }

        .notif-header {
            background: linear-gradient(135deg, #043e37 0%, #006d60 55%, #008374 100%);
            color: #ffffff;
            position: relative;
            overflow: hidden;
            padding: 20px 20px 18px 20px;
        }

        .notif-header::before {
            content: '';
            position: absolute;
            top: -55px;
            right: -35px;
            width: 160px;
            height: 160px;
            background: radial-gradient(circle, rgba(94, 234, 212, 0.28) 0%, rgba(255, 255, 255, 0) 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .notif-header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            position: relative;
            z-index: 2;
        }

        .notif-title-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .notif-title-icon {
            width: 42px;
            height: 42px;
            background: rgba(255, 255, 255, 0.16);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.28);
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #ffffff;
            flex-shrink: 0;
        }

        .notif-title-text {
            min-width: 0;
        }

        .notif-title-line {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .notif-title-wrap h5 {
            font-size: 18px;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.3px;
            line-height: 1.2;
            color: #ffffff;
        }

        .notif-role-pill {
            display: block;
            font-size: 11.5px;
            font-weight: 500;
            color: rgba(204, 251, 241, 0.92);
            margin-top: 3px;
            line-height: 1.3;
        }

        .notif-count-badge {
            background: #ef4444;
            color: #ffffff;
            font-size: 10.5px;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 999px;
            white-space: nowrap !important;
            box-shadow: 0 3px 8px rgba(239, 68, 68, 0.35);
        }

        .notif-count-badge.hidden {
            display: none !important;
        }

        .notif-close-btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.14);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            cursor: pointer;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }

        .notif-close-btn:hover {
            background-color: rgba(255, 255, 255, 0.28);
            transform: rotate(90deg);
        }

        .notif-header-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #ffffff;
            padding: 10px 16px;
            border-bottom: 1px solid #e2e8f0;
            gap: 10px;
        }

        .notif-header-actions.hidden {
            display: none !important;
        }

        .notif-filter-pills {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .notif-pill {
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            background: #f1f5f9;
            border: 1px solid transparent;
            cursor: pointer;
            white-space: nowrap !important;
            transition: all 0.18s ease;
        }

        .notif-pill:hover {
            color: #0f172a;
            background: #e2e8f0;
        }

        .notif-pill.active {
            background: #f0fdfa;
            color: #008374;
            border-color: #99f6e4;
        }

        .notif-readall-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: transparent;
            border: none;
            font-size: 12px;
            font-weight: 700;
            color: #008374;
            cursor: pointer;
            padding: 5px 8px;
            border-radius: 8px;
            white-space: nowrap !important;
            transition: background 0.18s ease;
        }

        .notif-readall-link:hover {
            background: #f0fdfa;
        }

        .notif-body {
            flex: 1;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .notif-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 100%;
        }

        .notif-item {
            display: flex;
            gap: 12px;
            padding: 14px;
            background-color: #ffffff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            width: 100%;
        }

        .notif-item:hover {
            transform: translateY(-1px);
            border-color: #99f6e4;
            box-shadow: 0 8px 18px -6px rgba(0, 131, 116, 0.14);
        }

        .notif-item.unread {
            background: linear-gradient(to right, #f0fdfa 0%, #ffffff 38%);
            border-color: #99f6e4;
        }

        .notif-unread-indicator {
            position: absolute;
            left: 0;
            top: 12px;
            bottom: 12px;
            width: 3.5px;
            background: linear-gradient(to bottom, #14b8a6, #008374);
            border-radius: 0 4px 4px 0;
        }

        .notif-item-icon-container {
            flex-shrink: 0;
        }

        .notif-item-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            color: #ffffff;
        }

        .theme-order .notif-item-icon { background: linear-gradient(135deg, #008374, #0d9488); }
        .theme-order .notif-category-label { color: #008374; background: #f0fdfa; border: 1px solid #ccfbf1; }

        .theme-return .notif-item-icon { background: linear-gradient(135deg, #f59e0b, #d97706); }
        .theme-return .notif-category-label { color: #d97706; background: #fffbeb; border: 1px solid #fde68a; }

        .theme-dispute .notif-item-icon { background: linear-gradient(135deg, #ef4444, #dc2626); }
        .theme-dispute .notif-category-label { color: #dc2626; background: #fef2f2; border: 1px solid #fecaca; }

        .theme-wallet .notif-item-icon { background: linear-gradient(135deg, #10b981, #059669); }
        .theme-wallet .notif-category-label { color: #059669; background: #ecfdf5; border: 1px solid #a7f3d0; }

        .theme-promo .notif-item-icon { background: linear-gradient(135deg, #ec4899, #e11d48); }
        .theme-promo .notif-category-label { color: #e11d48; background: #fff1f2; border: 1px solid #ffe4e6; }

        .theme-system .notif-item-icon { background: linear-gradient(135deg, #3b82f6, #2563eb); }
        .theme-system .notif-category-label { color: #2563eb; background: #eff6ff; border: 1px solid #dbeafe; }

        .notif-item-content {
            flex: 1;
            min-width: 0;
        }

        .notif-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
            gap: 6px;
        }

        .notif-category-label {
            font-size: 9.5px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 0.35px;
            white-space: nowrap !important;
        }

        .notif-item-content h6 {
            font-size: 13.5px;
            font-weight: 700;
            color: #0f172a;
            margin: 0 0 4px 0;
            line-height: 1.38;
            word-break: break-word;
        }

        .notif-item-content p {
            font-size: 12.5px;
            color: #475569;
            margin: 0;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            word-break: break-word;
        }

        .notif-item-link-row {
            margin-top: 8px;
        }

        .notif-smart-link {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11.5px;
            font-weight: 700;
            color: #008374;
            background: #f0fdfa;
            padding: 4px 10px;
            border-radius: 8px;
            border: 1px solid #ccfbf1;
        }

        .notif-time {
            font-size: 11px;
            color: #94a3b8;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-weight: 600;
            white-space: nowrap !important;
        }

        .notif-quick-read-btn {
            position: absolute;
            right: 10px;
            top: 10px;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: linear-gradient(135deg, #14b8a6, #008374);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            box-shadow: 0 4px 10px rgba(0, 131, 116, 0.3);
            transition: opacity 0.2s ease;
        }

        .notif-item:hover .notif-quick-read-btn {
            opacity: 1;
        }

        /* Empty State */
        .notif-empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: auto 0;
            padding: 28px 18px;
            text-align: center;
            width: 100%;
        }

        .notif-empty-ring {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0, 131, 116, 0.12) 0%, rgba(0, 131, 116, 0.02) 70%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
        }

        .notif-empty-icon {
            width: 66px;
            height: 66px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .lock-icon-glow {
            background: linear-gradient(135deg, #ccfbf1, #99f6e4);
            color: #008374;
        }

        .empty-icon-glow {
            background: linear-gradient(135deg, #ffffff, #f0fdfa);
            color: #008374;
            border: 1px solid #ccfbf1;
            box-shadow: 0 10px 24px -6px rgba(0, 131, 116, 0.18);
        }

        .notif-empty-title {
            font-size: 17px;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 8px 0;
            line-height: 1.3;
        }

        .notif-empty-desc {
            font-size: 13px;
            color: #64748b;
            margin: 0 auto 22px auto;
            line-height: 1.55;
            max-width: 300px;
            word-break: break-word;
        }

        .notif-shortcuts-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            width: 100%;
        }

        .notif-shortcut-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 13px 8px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .notif-shortcut-card:hover {
            border-color: #5eead4;
            background: #f0fdfa;
            transform: translateY(-2px);
            box-shadow: 0 8px 16px -6px rgba(0, 131, 116, 0.16);
        }

        .notif-shortcut-ic {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .notif-shortcut-ic.ic-teal { background: #f0fdfa; color: #008374; }
        .notif-shortcut-ic.ic-amber { background: #fffbeb; color: #d97706; }
        .notif-shortcut-ic.ic-emerald { background: #ecfdf5; color: #059669; }
        .notif-shortcut-ic.ic-rose { background: #fff1f2; color: #e11d48; }

        .notif-shortcut-lbl {
            font-size: 11.5px;
            font-weight: 700;
            color: #334155;
            text-align: center;
            line-height: 1.25;
        }

        .notif-primary-btn {
            background: linear-gradient(135deg, #008374, #065f5b);
            color: #ffffff;
            border: none;
            padding: 12px 22px;
            border-radius: 13px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            width: 100%;
            max-width: 260px;
        }

        /* Footer */
        .notif-footer {
            padding: 12px 16px;
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            flex-shrink: 0;
        }

        .notif-footer.hidden {
            display: none !important;
        }

        .notif-footer-grid {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .notif-footer-link {
            flex: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 11px 14px;
            background: linear-gradient(135deg, #008374, #065f5b);
            color: #ffffff !important;
            font-weight: 700;
            border-radius: 12px;
            text-decoration: none;
            font-size: 13px;
            white-space: nowrap !important;
            transition: all 0.2s ease;
        }

        .notif-footer-link:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(0, 131, 116, 0.26);
        }

        .notif-footer-seller-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 11px 14px;
            border-radius: 12px;
            background: #f0fdfa;
            border: 1px solid #99f6e4;
            color: #008374 !important;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap !important;
            transition: all 0.2s ease;
        }

        .notif-footer-seller-btn:hover {
            background: #ccfbf1;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('notification-sidebar-btn');
            const sidebar = document.getElementById('notification-sidebar');
            const closeBtn = sidebar ? sidebar.querySelector('.notification-sidebar-close') : null;
            const overlay = document.querySelector('.modal-overlay');
            const body = document.body;

            // Move drawer directly to document.body so it never inherits navbar white-space: nowrap or low z-index
            if (sidebar && sidebar.parentElement !== document.body) {
                document.body.appendChild(sidebar);
            }

            const drawerBody = document.getElementById('notif-drawer-body');
            const headerActions = document.getElementById('notif-header-actions');
            const drawerFooter = document.getElementById('notif-drawer-footer');
            const headerBadge = document.getElementById('header-notif-unread-badge');
            const drawerBadge = document.getElementById('drawer-notif-unread-badge');
            const isSeller = sidebar && sidebar.getAttribute('data-is-seller') === 'true';
            let currentFilter = 'all';

            function updateBadgeCounts(count) {
                const safeCount = Math.max(0, parseInt(count || 0, 10));
                if (headerBadge) {
                    if (safeCount > 0) {
                        headerBadge.textContent = safeCount > 9 ? '9+' : safeCount.toString();
                        headerBadge.classList.remove('hidden');
                    } else {
                        headerBadge.classList.add('hidden');
                    }
                }
                if (drawerBadge) {
                    if (safeCount > 0) {
                        drawerBadge.textContent = safeCount + ' mới';
                        drawerBadge.classList.remove('hidden');
                    } else {
                        drawerBadge.classList.add('hidden');
                    }
                }
            }

            function resolveThemeClass(catKey) {
                switch (catKey) {
                    case 'order': return 'theme-order';
                    case 'return': return 'theme-return';
                    case 'dispute': return 'theme-dispute';
                    case 'wallet': return 'theme-wallet';
                    case 'promo': return 'theme-promo';
                    default: return 'theme-system';
                }
            }

            function escapeHtml(str) {
                const div = document.createElement('div');
                div.textContent = str || '';
                return div.innerHTML;
            }

            function formatVnTime(isoStr) {
                try {
                    const d = new Date(isoStr);
                    return d.toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
                } catch (e) {
                    return '';
                }
            }

            function buildEmptyShortcutsHtml() {
                if (isSeller) {
                    return `
                        <a href="/Admin/Orders/Index" class="notif-shortcut-card">
                            <span class="notif-shortcut-ic ic-teal"><i class="hgi hgi-stroke hgi-store-01"></i></span>
                            <span class="notif-shortcut-lbl">Đơn bán hàng</span>
                        </a>
                        <a href="/my-orders" class="notif-shortcut-card">
                            <span class="notif-shortcut-ic ic-amber"><i class="hgi hgi-stroke hgi-package-box"></i></span>
                            <span class="notif-shortcut-lbl">Đơn mua của tôi</span>
                        </a>
                        <a href="/Admin/SellerWallet/Index" class="notif-shortcut-card">
                            <span class="notif-shortcut-ic ic-emerald"><i class="hgi hgi-stroke hgi-wallet-02"></i></span>
                            <span class="notif-shortcut-lbl">Ví Doanh thu</span>
                        </a>`;
                }
                return `
                    <a href="/my-orders" class="notif-shortcut-card">
                        <span class="notif-shortcut-ic ic-teal"><i class="hgi hgi-stroke hgi-package-box"></i></span>
                        <span class="notif-shortcut-lbl">Đơn mua của tôi</span>
                    </a>
                    <a href="/my-wallet" class="notif-shortcut-card">
                        <span class="notif-shortcut-ic ic-emerald"><i class="hgi hgi-stroke hgi-wallet-02"></i></span>
                        <span class="notif-shortcut-lbl">Ví Sellzy</span>
                    </a>
                    <a href="/vouchers" class="notif-shortcut-card">
                        <span class="notif-shortcut-ic ic-rose"><i class="hgi hgi-stroke hgi-ticket-01"></i></span>
                        <span class="notif-shortcut-lbl">Kho Voucher</span>
                    </a>`;
            }

            function applyDrawerFilter() {
                if (!drawerBody) return;
                drawerBody.querySelectorAll('.notif-item').forEach(item => {
                    if (currentFilter === 'unread') {
                        item.style.display = item.classList.contains('unread') ? 'flex' : 'none';
                    } else {
                        item.style.display = 'flex';
                    }
                });
            }

            function renderDrawerNotifications(items) {
                if (!drawerBody) return;
                if (!Array.isArray(items) || items.length === 0) {
                    drawerBody.innerHTML = `
                        <div class="notif-empty-state">
                            <div class="notif-empty-ring">
                                <div class="notif-empty-icon empty-icon-glow">
                                    <i class="hgi hgi-stroke hgi-notification-03"></i>
                                </div>
                            </div>
                            <h6 class="notif-empty-title">Bạn đã cập nhật hết rồi!</h6>
                            <p class="notif-empty-desc">Mọi cập nhật về đơn hàng, ví tiền, khuyến mãi và hoạt động gian hàng sẽ hiển thị ngay tại đây.</p>
                            <div class="notif-shortcuts-grid">${buildEmptyShortcutsHtml()}</div>
                        </div>`;
                    if (headerActions) headerActions.classList.add('hidden');
                    if (drawerFooter) drawerFooter.classList.remove('hidden');
                    updateBadgeCounts(0);
                    return;
                }

                if (headerActions) headerActions.classList.remove('hidden');
                if (drawerFooter) drawerFooter.classList.remove('hidden');

                let unreadCount = 0;
                let html = '<div class="notif-list" id="notif-drawer-list">';

                items.forEach(item => {
                    if (!item.isRead) unreadCount++;
                    const themeClass = resolveThemeClass(item.categoryKey);
                    const iconClass = escapeHtml(item.iconClass || 'hgi-notification-02');
                    const categoryLabel = escapeHtml(item.categoryLabel || 'Hệ thống');
                    const title = escapeHtml(item.title);
                    const content = escapeHtml(item.content);
                    const actionUrl = item.actionUrl ? escapeHtml(item.actionUrl) : '';
                    const actionText = escapeHtml(item.actionText || 'Xem chi tiết');
                    const timeStr = formatVnTime(item.createdAt);

                    html += `
                        <div class="notif-item ${!item.isRead ? 'unread' : ''} ${themeClass}"
                             data-id="${item.id}"
                             data-unread="${!item.isRead ? 'true' : 'false'}"
                             data-action-url="${actionUrl}">
                            ${!item.isRead ? '<div class="notif-unread-indicator"></div>' : ''}
                            <div class="notif-item-icon-container">
                                <div class="notif-item-icon">
                                    <i class="hgi hgi-stroke ${iconClass}"></i>
                                </div>
                            </div>
                            <div class="notif-item-content">
                                <div class="notif-item-header">
                                    <span class="notif-category-label">${categoryLabel}</span>
                                    <span class="notif-time"><i class="hgi hgi-stroke hgi-clock-01"></i> ${timeStr}</span>
                                </div>
                                <h6>${title}</h6>
                                <p>${content}</p>
                                ${actionUrl ? `<div class="notif-item-link-row"><span class="notif-smart-link">${actionText} <i class="hgi hgi-stroke hgi-arrow-right-01"></i></span></div>` : ''}
                            </div>
                            ${!item.isRead ? `<button type="button" class="notif-quick-read-btn mark-as-read-btn" title="Đánh dấu đã đọc"><i class="hgi hgi-stroke hgi-tick-02 text-white"></i></button>` : ''}
                        </div>`;
                });

                html += '</div>';
                drawerBody.innerHTML = html;
                updateBadgeCounts(unreadCount);
                applyDrawerFilter();
            }

            async function refreshLatestNotifications() {
                try {
                    const res = await fetch('/Chat/GetLatestNotifications?take=15', {
                        headers: { 'Accept': 'application/json' },
                        credentials: 'same-origin'
                    });
                    if (res.ok) {
                        if (typeof window.markSellzySessionAuthenticated === 'function') {
                            window.markSellzySessionAuthenticated();
                        }
                        if (btn) {
                            btn.setAttribute('data-signed-in', 'true');
                            btn.removeAttribute('data-auth-prompt');
                            btn.removeAttribute('data-auth-return-url');
                        }
                        const items = await res.json();
                        renderDrawerNotifications(items);
                        return true;
                    }
                    return false;
                } catch (e) {
                    return false;
                }
            }

            function openSidebar() {
                if (!sidebar) return;
                sidebar.setAttribute('data-state', 'open');
                if (overlay) {
                    overlay.style.display = 'block';
                    overlay.style.zIndex = '10040';
                    overlay.setAttribute('data-overlay-for', '#notification-sidebar');
                }
                body.classList.add('overflow-hidden', 'scrollbar-offset');
                refreshLatestNotifications();
            }

            function closeSidebar() {
                if (!sidebar) return;
                sidebar.setAttribute('data-state', 'close');
                if (overlay) {
                    overlay.style.display = 'none';
                    overlay.style.zIndex = '';
                    overlay.removeAttribute('data-overlay-for');
                }
                body.classList.remove('overflow-hidden', 'scrollbar-offset');
            }

            if (btn && sidebar) {
                btn.addEventListener('click', async function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const modal = document.getElementById('sellzy-auth-prompt-modal');
                    const domAuthenticated = (modal && modal.getAttribute('data-authenticated') === 'true')
                                             || btn.getAttribute('data-signed-in') === 'true';

                    if (domAuthenticated) {
                        btn.removeAttribute('data-auth-prompt');
                        openSidebar();
                        return;
                    }

                    const verifiedOnline = await refreshLatestNotifications();
                    if (verifiedOnline) {
                        openSidebar();
                        return;
                    }

                    if (typeof window.showSellzyAuthPrompt === 'function') {
                        window.showSellzyAuthPrompt({
                            context: 'notifications',
                            returnUrl: '/Chat/SystemNotifications'
                        });
                    } else {
                        openSidebar();
                    }
                });
            }

            if (closeBtn) closeBtn.addEventListener('click', closeSidebar);

            if (overlay) {
                overlay.addEventListener('click', function () {
                    if (this.getAttribute('data-overlay-for') === '#notification-sidebar') {
                        closeSidebar();
                    }
                });
            }

            if (sidebar) {
                sidebar.querySelectorAll('[data-drawer-filter]').forEach(pill => {
                    pill.addEventListener('click', function () {
                        sidebar.querySelectorAll('[data-drawer-filter]').forEach(p => p.classList.remove('active'));
                        this.classList.add('active');
                        currentFilter = this.getAttribute('data-drawer-filter') || 'all';
                        applyDrawerFilter();
                    });
                });
            }

            if (drawerBody) {
                drawerBody.addEventListener('click', async function (e) {
                    const item = e.target.closest('.notif-item');
                    if (!item) return;

                    const clickedQuickBtn = e.target.closest('.mark-as-read-btn');
                    const id = item.dataset.id;
                    const actionUrl = item.dataset.actionUrl;

                    if (item.classList.contains('unread') && id) {
                        try {
                            await fetch(`/notifications/mark-read?id=${id}`, { method: 'POST', credentials: 'same-origin' });
                            item.classList.remove('unread');
                            item.setAttribute('data-unread', 'false');
                            const ind = item.querySelector('.notif-unread-indicator');
                            if (ind) ind.remove();
                            const qBtn = item.querySelector('.mark-as-read-btn');
                            if (qBtn) qBtn.remove();

                            const remainingUnread = drawerBody.querySelectorAll('.notif-item.unread').length;
                            updateBadgeCounts(remainingUnread);
                            applyDrawerFilter();
                        } catch (err) {
                            console.error('Failed to mark notification as read:', err);
                        }
                    }

                    if (!clickedQuickBtn && actionUrl) {
                        window.location.href = actionUrl;
                    }
                });
            }

            const markAllBtn = sidebar ? sidebar.querySelector('.mark-all-read') : null;
            if (markAllBtn) {
                markAllBtn.addEventListener('click', async function () {
                    try {
                        const response = await fetch('/notifications/mark-all-read', {
                            method: 'POST',
                            credentials: 'same-origin'
                        });
                        if (response.ok) {
                            drawerBody.querySelectorAll('.notif-item.unread').forEach(item => {
                                item.classList.remove('unread');
                                item.setAttribute('data-unread', 'false');
                                const ind = item.querySelector('.notif-unread-indicator');
                                if (ind) ind.remove();
                                const qBtn = item.querySelector('.mark-as-read-btn');
                                if (qBtn) qBtn.remove();
                            });
                            updateBadgeCounts(0);
                            applyDrawerFilter();
                        }
                    } catch (err) {
                        console.error('Failed to mark all notifications as read:', err);
                    }
                });
            }
        });
    </script>
</li>
