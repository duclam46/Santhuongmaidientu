@{
    ViewData["Title"] = "Từ chối truy cập";
}

<style>
    .sz-deny-wrap {
        background: #eef2f6;
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 16px;
    }
    .sz-deny-card {
        max-width: 500px;
        width: 100%;
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 24px;
        padding: 40px 32px;
        text-align: center;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
    }
    .sz-deny-icon {
        width: 84px;
        height: 84px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
    }
    .sz-deny-code {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 12px;
    }
    .sz-deny-title {
        font-size: 26px;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 10px;
    }
    .sz-deny-desc {
        font-size: 14.5px;
        line-height: 1.65;
        color: #64748b;
        margin: 0 0 28px;
    }
    .sz-deny-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .sz-deny-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px 20px;
        border-radius: 14px;
        background: linear-gradient(135deg, #022c22 0%, #008374 100%);
        color: #ffffff;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        transition: all 0.2s;
    }
    .sz-deny-btn-primary:hover {
        filter: brightness(1.08);
        color: #ffffff;
    }
    .sz-deny-btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid #dbe3ec;
        color: #334155;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .sz-deny-btn-outline:hover {
        background: #f1f5f9;
    }
</style>

<div class="sz-deny-wrap">
    <div class="sz-deny-card">
        <div class="sz-deny-icon">
            <i class="hgi hgi-stroke hgi-lock-password"></i>
        </div>
        <div class="sz-deny-code">HTTP 403 • Khu vực giới hạn quyền hạn</div>
        <h1 class="sz-deny-title">Truy cập bị từ chối</h1>
        <p class="sz-deny-desc">
            Tài khoản hiện tại của bạn không có quyền truy cập vào khu vực quản trị này. Vui lòng đăng nhập đúng vai trò (Khách hàng / Đối tác Shop / Quản trị viên) hoặc quay lại trang mua sắm.
        </p>
        <div class="sz-deny-actions">
            <a href="/" class="sz-deny-btn-primary">
                <i class="hgi hgi-stroke hgi-home-01"></i> Quay về Trang chủ Sellzy
            </a>
            <button type="button" onclick="history.back()" class="sz-deny-btn-outline">
                <i class="hgi hgi-stroke hgi-arrow-left-01"></i> Quay lại trang trước
            </button>
        </div>
    </div>
</div>
