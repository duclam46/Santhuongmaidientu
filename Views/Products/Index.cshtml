@model DOAN_BANHANG.ViewModels.CategoryProductsVm

@{
  var viVn = global::System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

  var startItem = Model.TotalItems == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
  var endItem = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);

  string CategoryUrl(
    int? childCategoryId = null,
    int? brandId = null,
    int? rating = null,
    string? color = null,
    string? size = null,
    decimal? minPrice = null,
    decimal? maxPrice = null,
    int? page = null,
    string? sort = null,
    int? overrideAttrId = null,
    string? overrideAttrVal = null,
    bool clearAttr = false)
  {
    var baseUrl = string.IsNullOrEmpty(Model.CategorySlug)
      ? (Url.Action("Search", "Products", new
      {
        q = Model.SearchTerm,
        childCategoryId,
        brandId,
        rating,
        color,
        size,
        minPrice,
        maxPrice,
        page,
        sort
      }) ?? "#")
      : (Url.RouteUrl("category", new
      {
        slug = Model.CategorySlug,
        childCategoryId,
        brandId,
        rating,
        color,
        size,
        minPrice,
        maxPrice,
        page,
        sort
      }) ?? "#");

    var attrPairs = new List<string>();
    if (Model.SelectedAttributes != null)
    {
      foreach (var kv in Model.SelectedAttributes)
      {
        if (overrideAttrId.HasValue && kv.Key == overrideAttrId.Value) continue;
        attrPairs.Add($"attr_{kv.Key}={Uri.EscapeDataString(kv.Value)}");
      }
    }
    if (overrideAttrId.HasValue && !clearAttr && !string.IsNullOrWhiteSpace(overrideAttrVal))
    {
      attrPairs.Add($"attr_{overrideAttrId.Value}={Uri.EscapeDataString(overrideAttrVal)}");
    }

    if (attrPairs.Count > 0)
    {
      baseUrl += (baseUrl.Contains('?') ? "&" : "?") + string.Join("&", attrPairs);
    }

    return baseUrl;
  }

  string PageUrl(int page) => CategoryUrl(
    childCategoryId: Model.SelectedChildCategoryId,
    brandId: Model.SelectedBrandId,
    rating: Model.SelectedRating,
    color: Model.SelectedColor,
    size: Model.SelectedSize,
    minPrice: Model.SelectedMinPrice,
    maxPrice: Model.SelectedMaxPrice,
    page: page,
    sort: Model.Sort);

  var hasActiveFilters = Model.SelectedChildCategoryId.HasValue
    || Model.SelectedBrandId.HasValue
    || (Model.SelectedAttributes != null && Model.SelectedAttributes.Count > 0)
    || Model.SelectedRating.HasValue
    || !string.IsNullOrWhiteSpace(Model.SelectedColor)
    || !string.IsNullOrWhiteSpace(Model.SelectedSize)
    || Model.SelectedMinPrice.HasValue
    || Model.SelectedMaxPrice.HasValue;
}

