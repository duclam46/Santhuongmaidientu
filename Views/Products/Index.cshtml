<!-- Hidden filter form used by template JS (price-range slider auto-submit) -->
<form id="category-filter-form" method="get" action="@(string.IsNullOrEmpty(Model.CategorySlug) ? Url.Action("Search", "Products") : (Url.RouteUrl("category", new { slug = Model.CategorySlug }) ?? "#"))" class="hidden">
  @if (string.IsNullOrEmpty(Model.CategorySlug))
  {
    <input type="hidden" name="q" value="@Model.SearchTerm" />
  }
  @if (Model.SelectedChildCategoryId.HasValue)
  {
    <input type="hidden" name="childCategoryId" value="@Model.SelectedChildCategoryId" />
  }
  @if (Model.SelectedBrandId.HasValue)
  {
    <input type="hidden" name="brandId" value="@Model.SelectedBrandId" />
  }
  @if (Model.SelectedAttributes != null)
  {
    foreach (var kv in Model.SelectedAttributes)
    {
      <input type="hidden" name="attr_@kv.Key" value="@kv.Value" />
    }
  }
  @if (Model.SelectedRating.HasValue)
  {
    <input type="hidden" name="rating" value="@Model.SelectedRating" />
  }
  @if (!string.IsNullOrWhiteSpace(Model.SelectedColor))
  {
    <input type="hidden" name="color" value="@Model.SelectedColor" />
  }
  @if (!string.IsNullOrWhiteSpace(Model.SelectedSize))
  {
    <input type="hidden" name="size" value="@Model.SelectedSize" />
  }
  @if (!string.IsNullOrWhiteSpace(Model.Sort))
  {
    <input type="hidden" name="sort" value="@Model.Sort" />
  }
  <input type="hidden" name="page" value="1" />

  <!-- main.js updates these via .price-range-*-hidden selectors -->
  <input type="hidden" name="minPrice" class="price-range-min-hidden" value="@(Model.SelectedMinPrice ?? Model.PriceMin)" />
  <input type="hidden" name="maxPrice" class="price-range-max-hidden" value="@(Model.SelectedMaxPrice ?? Model.PriceMax)" />
</form>

@functions {
  private string ResolveImageUrl(string? rawUrl)
  {
    if (string.IsNullOrWhiteSpace(rawUrl))
    {
      return Url.Content("~/assets/images/vitamin-c.png");
    }

    rawUrl = rawUrl.Trim();

    if (rawUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
        || rawUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
        || rawUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
    {
      return rawUrl;
    }

    if (rawUrl.StartsWith("~/", StringComparison.Ordinal))
    {
      return Url.Content(rawUrl);
    }

    if (rawUrl.StartsWith("/", StringComparison.Ordinal))
    {
      return rawUrl;
    }

    return Url.Content("~/" + rawUrl.TrimStart('/'));
  }
}

<!-- ========== Top Boutique Hero Banner Start ========== -->
<div class="container pt-6">
  <div class="sp-hero">
    <div>
      <div class="sp-breadcrumb">
        <a href='@Url.Action("Index", "Home")'>
          <i class="hgi hgi-stroke hgi-home-01 mr-1"></i>Trang chủ
        </a>
        <span>/</span>
        <span style="color: #FFEB69; font-weight: 600;">@Model.CategoryName</span>
      </div>
      <h1 class="sp-hero-title">@Model.CategoryName</h1>
      <p class="sp-hero-sub">
        Bộ sưu tập chính hãng được tuyển chọn kỹ lưỡng — giao nhanh toàn quốc &amp; đổi trả 30 ngày.
      </p>
    </div>

    <div class="sp-hero-stats">
      <div class="sp-stat-pill">
        <i class="hgi hgi-stroke hgi-shopping-bag-02 text-lg" style="color: #FFEB69;"></i>
        <span><strong>@Model.TotalItems</strong> sản phẩm</span>
      </div>
      <div class="sp-stat-pill">
        <i class="hgi hgi-stroke hgi-truck-delivery text-lg" style="color: #FFEB69;"></i>
        <span>Freeship từ <strong>500K</strong></span>
      </div>
    </div>
  </div>

  @if (Model.ChildCategories.Count > 0)
  {
    <div class="sp-quick-cats">
      <a href="@CategoryUrl(childCategoryId: null, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)"
         class="sp-quick-cat-pill @(!Model.SelectedChildCategoryId.HasValue ? "is-active" : "")">
        <span>Tất cả</span>
      </a>
      @foreach (var c in Model.ChildCategories)
      {
        var quickUrl = CategoryUrl(
          childCategoryId: c.CategoryId,
          rating: Model.SelectedRating,
          color: Model.SelectedColor,
          size: Model.SelectedSize,
          minPrice: Model.SelectedMinPrice,
          maxPrice: Model.SelectedMaxPrice,
          page: 1,
          sort: Model.Sort);
        <a href="@quickUrl" class="sp-quick-cat-pill @(c.IsSelected ? "is-active" : "")">
          <span>@c.Name</span>
          <span class="opacity-75 text-xs">(@c.ProductCount)</span>
        </a>
      }
    </div>
  }
</div>
<!-- ========== Top Boutique Hero Banner End ========== -->

<!-- ========== Main Shop Layout Start ========== -->
<section class="pb-[90px]">
  <div class="container">
    <div class="grid grid-cols-12 lg:gap-x-6 gap-y-6">
      <!-- LEFT SIDEBAR -->
      <div class="xl:col-span-3 lg:col-span-4 col-span-12 row-start-2 lg:row-start-auto">
        <div class="sidebar sticky top-20">
          <div class="sp-filter-panel">
            <!-- Header -->
            <div class="sp-filter-head sidebar-title wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
              <h5>
                <i class="hgi hgi-stroke hgi-filter-horizontal text-lg" style="color: #FFEB69;"></i>
                <span>Bộ lọc tìm kiếm</span>
              </h5>
              <a href="@CategoryUrl()" class="sp-filter-clear">Xóa tất cả</a>
            </div>

            <div class="sp-filter-body">
              <!-- Category -->
              <div class="widget-category wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
                <div class="sp-filter-group">
                  <div class="sp-filter-group-head widget-category-title">
                    <h6>Danh mục</h6>
                    <a
                      href="@CategoryUrl(childCategoryId: null, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)"
                      class="sp-filter-reset"
                    >Đặt lại</a>
                  </div>

                  <div class="widget-category-content">
                    <ul class="flex flex-col gap-y-1">
                      @if (Model.ChildCategories.Count == 0)
                      {
                        <li>
                          <p class="text-xs text-light-disabled-text py-1">Không có danh mục con.</p>
                        </li>
                      }
                      else
                      {
                        @foreach (var c in Model.ChildCategories)
                        {
                          var childUrl = CategoryUrl(
                            childCategoryId: c.CategoryId,
                            rating: Model.SelectedRating,
                            color: Model.SelectedColor,
                            size: Model.SelectedSize,
                            minPrice: Model.SelectedMinPrice,
                            maxPrice: Model.SelectedMaxPrice,
                            page: 1,
                            sort: Model.Sort);

                          <li class="widget-category-content-list-items">
                            <label class="sp-cat-row @(c.IsSelected ? "is-selected" : "")">
                              <span class="flex items-center gap-x-2.5">
                                <span class="relative inline-flex w-4.5 h-4.5 items-center justify-center">
                                  <input
                                    type="radio"
                                    name="childCategoryId"
                                    value="@c.CategoryId"
                                    checked="@(c.IsSelected ? "checked" : null)"
                                    onchange="window.location.href='@childUrl'"
                                    class="peer appearance-none w-full h-full border-2 focus:outline-none checked:border-none border-gray-300 rounded-sm bg-white checked:bg-primary transition-all duration-200"
                                  />
                                  <span class="absolute inset-0 inline-flex items-center justify-center text-white opacity-0 peer-checked:opacity-100 transition-all">
                                    <i class="hgi hgi-stroke hgi-tick-02 text-[14px]"></i>
                                  </span>
                                </span>
                                <span class="text-sm text-light-primary-text">@c.Name</span>
                              </span>
                              <span class="text-xs text-light-secondary-text">(@c.ProductCount)</span>
                            </label>
                          </li>
                        }
                      }
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Price Range -->
              <div class="widget-price-range wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
                <div class="sp-filter-group flex flex-col gap-y-4 widget-price-range-title">
                  <div class="sp-filter-group-head mb-0">
                    <h6>Khoảng giá</h6>
                    <a
                      href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: null, maxPrice: null, page: 1, sort: Model.Sort)"
                      class="sp-filter-reset"
                    >Đặt lại</a>
                  </div>
                  <div
                    id="price-range-slider"
                    data-min="@Model.PriceMin.ToString("0", global::System.Globalization.CultureInfo.InvariantCulture)"
                    data-max="@Model.PriceMax.ToString("0", global::System.Globalization.CultureInfo.InvariantCulture)"
                    data-start-min="@((Model.SelectedMinPrice ?? Model.PriceMin).ToString("0", global::System.Globalization.CultureInfo.InvariantCulture))"
                    data-start-max="@((Model.SelectedMaxPrice ?? Model.PriceMax).ToString("0", global::System.Globalization.CultureInfo.InvariantCulture))"
                    data-form="category-filter-form"
                  ></div>
                  <div class="price-range-values flex items-center justify-between gap-2">
                    <div class="input-group medium max-w-[130px] w-full rounded-[80px] py-1.5 px-3 bg-[#F8FAFC]">
                      <div class="input-group-addon inline-flex items-center justify-center text-xs font-bold text-primary" data-align="inline-start">₫</div>
                      <input
                        class="price-range-min-value form-control text-xs font-semibold"
                        type="text"
                        inputmode="numeric"
                        value="@((Model.SelectedMinPrice ?? Model.PriceMin).ToString("N0", viVn))"
                      />
                    </div>
                    <span class="text-xs text-light-disabled-text">—</span>
                    <div class="input-group medium max-w-[130px] w-full rounded-[80px] py-1.5 px-3 bg-[#F8FAFC]">
                      <div class="input-group-addon inline-flex items-center justify-center text-xs font-bold text-primary" data-align="inline-start">₫</div>
                      <input
                        class="price-range-max-value form-control text-xs font-semibold"
                        type="text"
                        inputmode="numeric"
                        value="@((Model.SelectedMaxPrice ?? Model.PriceMax).ToString("N0", viVn))"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Rating -->
              <div class="widget-rating wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
                <div class="sp-filter-group">
                  <div class="sp-filter-group-head widget-rating-title">
                    <h6>Đánh giá</h6>
                    <a
                      href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: null, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)"
                      class="sp-filter-reset"
                    >Đặt lại</a>
                  </div>
                  <div class="ratings">
                    <ul class="flex items-center flex-wrap gap-2">
                      @for (var r = 5; r >= 1; r--)
                      {
                        var ratingUrl = CategoryUrl(
                          childCategoryId: Model.SelectedChildCategoryId,
                          rating: r,
                          color: Model.SelectedColor,
                          size: Model.SelectedSize,
                          minPrice: Model.SelectedMinPrice,
                          maxPrice: Model.SelectedMaxPrice,
                          page: 1,
                          sort: Model.Sort);

                        <li>
                          <a
                            href="@ratingUrl"
                            class="btn btn-default outline shadow-none gap-x-1.5 items-center rounded-[80px] @(Model.SelectedRating == r ? "active" : "")"
                          >
                            <span>@r</span>
                            <div class="bg-[url('../images/star-icon.png')] w-5 h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]">
                              <div style="width: 100%" class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"></div>
                            </div>
                          </a>
                        </li>
                      }
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Brand Filter -->
              @{
                var visibleBrands = (Model.Brands ?? Array.Empty<DOAN_BANHANG.ViewModels.BrandFilterItemVm>())
                  .Where(b => b.ProductCount > 0 || b.IsSelected)
                  .ToList();
              }
              @if (visibleBrands.Count > 0)
              {
                <div class="widget-brand wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
                  <div class="sp-filter-group">
                    <div class="sp-filter-group-head">
                      <h6>Thương hiệu</h6>
                      <a href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, brandId: null, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)"
                         class="sp-filter-reset">Đặt lại</a>
                    </div>
                    <div class="flex flex-wrap gap-2">
                      @foreach (var b in visibleBrands)
                      {
                        var brandUrl = CategoryUrl(
                          childCategoryId: Model.SelectedChildCategoryId,
                          brandId: b.IsSelected ? null : b.BrandId,
                          rating: Model.SelectedRating,
                          color: Model.SelectedColor,
                          size: Model.SelectedSize,
                          minPrice: Model.SelectedMinPrice,
                          maxPrice: Model.SelectedMaxPrice,
                          page: 1,
                          sort: Model.Sort);
                        <a href="@brandUrl"
                           class="px-3 py-1.5 rounded-full text-xs font-semibold border transition-all @(b.IsSelected ? "bg-primary text-white border-primary" : "bg-[#F8FAFC] text-light-primary-text border-gray-200 hover:border-primary hover:text-primary")">
                          @b.Name (@b.ProductCount)
                        </a>
                      }
                    </div>
                  </div>
                </div>
              }

              <!-- Dynamic Category Attributes (EAV) -->
              @if (Model.DynamicAttributes != null && Model.DynamicAttributes.Count > 0)
              {
                foreach (var attr in Model.DynamicAttributes)
                {
                  <div class="widget-dynamic-attr wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
                    <div class="sp-filter-group">
                      <div class="sp-filter-group-head">
                        <h6>@attr.Name @(!string.IsNullOrWhiteSpace(attr.Unit) ? $"({attr.Unit})" : "")</h6>
                        <a href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, brandId: Model.SelectedBrandId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort, overrideAttrId: attr.AttributeId, clearAttr: true)"
                           class="sp-filter-reset">Đặt lại</a>
                      </div>
                      <div class="flex flex-wrap gap-2">
                        @foreach (var val in attr.AvailableValues)
                        {
                          var isSelectedAttr = string.Equals(attr.SelectedValue, val, StringComparison.OrdinalIgnoreCase);
                          var attrUrl = CategoryUrl(
                            childCategoryId: Model.SelectedChildCategoryId,
                            brandId: Model.SelectedBrandId,
                            rating: Model.SelectedRating,
                            color: Model.SelectedColor,
                            size: Model.SelectedSize,
                            minPrice: Model.SelectedMinPrice,
                            maxPrice: Model.SelectedMaxPrice,
                            page: 1,
                            sort: Model.Sort,
                            overrideAttrId: attr.AttributeId,
                            overrideAttrVal: val,
                            clearAttr: isSelectedAttr);
                          <a href="@attrUrl"
                             class="px-3 py-1.5 rounded-full text-xs font-semibold border transition-all @(isSelectedAttr ? "bg-primary text-white border-primary" : "bg-[#F8FAFC] text-light-primary-text border-gray-200 hover:border-primary hover:text-primary")">
                            @val
                          </a>
                        }
                      </div>
                    </div>
                  </div>
                }
              }

              <!-- Color -->
              <div class="widget-color-picker wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
                <div class="sp-filter-group">
                  <div class="sp-filter-group-head widget-color-title">
                    <h6>Màu sắc</h6>
                    <a
                      href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: null, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)"
                      class="sp-filter-reset"
                    >Đặt lại</a>
                  </div>
                  <div class="colors">
                    <ul class="flex items-center flex-wrap gap-4">
                      <li class="inline-flex items-center justify-center">
                        <button data-color="primary" class="w-6 h-6 inline-flex items-center justify-center bg-primary rounded-full @(string.Equals(Model.SelectedColor, "primary", StringComparison.OrdinalIgnoreCase) ? "active" : "")"></button>
                      </li>
                      <li class="inline-flex items-center justify-center">
                        <button data-color="info" class="w-6 h-6 inline-flex items-center justify-center bg-info rounded-full @(string.Equals(Model.SelectedColor, "info", StringComparison.OrdinalIgnoreCase) ? "active" : "")"></button>
                      </li>
                      <li class="inline-flex items-center justify-center">
                        <button data-color="info-darker" class="w-6 h-6 inline-flex items-center justify-center bg-info-darker rounded-full @(string.Equals(Model.SelectedColor, "info-darker", StringComparison.OrdinalIgnoreCase) ? "active" : "")"></button>
                      </li>
                      <li class="inline-flex items-center justify-center">
                        <button data-color="warning" class="w-6 h-6 inline-flex items-center justify-center bg-warning rounded-full @(string.Equals(Model.SelectedColor, "warning", StringComparison.OrdinalIgnoreCase) ? "active" : "")"></button>
                      </li>
                      <li class="inline-flex items-center justify-center">
                        <button data-color="error-light" class="w-6 h-6 inline-flex items-center justify-center bg-error-light rounded-full @(string.Equals(Model.SelectedColor, "error-light", StringComparison.OrdinalIgnoreCase) ? "active" : "")"></button>
                      </li>
                      <li class="inline-flex items-center justify-center">
                        <button data-color="error-dark" class="w-6 h-6 inline-flex items-center justify-center bg-error-dark rounded-full @(string.Equals(Model.SelectedColor, "error-dark", StringComparison.OrdinalIgnoreCase) ? "active" : "")"></button>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Size -->
              <div class="widget-size-picker wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
                <div class="sp-filter-group">
                  <div class="sp-filter-group-head widget-size-title">
                    <h6>Kích cỡ (Size)</h6>
                    <a
                      href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: null, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)"
                      class="sp-filter-reset"
                    >Đặt lại</a>
                  </div>
                  <div class="sizes">
                    <ul class="flex items-center flex-wrap gap-2">
                      @foreach (var label in new[] { "S", "M", "L", "XL", "XXL", "XXXL" })
                      {
                        <li>
                          <button data-size="@label" class="btn btn-default outline shadow-none rounded-[80px] @(string.Equals(Model.SelectedSize, label, StringComparison.OrdinalIgnoreCase) ? "active" : "")">@label</button>
                        </li>
                      }
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT CONTENT -->
      <div class="xl:col-span-9 lg:col-span-8 col-span-12 row-start-1 lg:row-start-auto">
        <div class="sp-control-bar wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
          <div class="flex items-center gap-x-3 shrink-0 justify-start">
            <div class="flex items-center gap-x-2">
              <button type="button" id="btn-view-grid" class="sp-view-btn is-active" title="Xem dạng lưới">
                <i class="hgi hgi-stroke hgi-grid-view text-lg"></i>
              </button>
              <button type="button" id="btn-view-list" class="sp-view-btn" title="Xem dạng danh sách">
                <i class="hgi hgi-stroke hgi-left-to-right-list-bullet text-lg"></i>
              </button>
            </div>
            <div class="lg:flex hidden">
              <p class="text-sm text-light-secondary-text m-0">
                Hiển thị <span class="font-bold text-light-primary-text">@startItem–@endItem</span> trong <span class="font-bold text-light-primary-text">@Model.TotalItems</span> sản phẩm
              </p>
            </div>
          </div>

          <!-- Sorting -->
          <div class="relative min-w-[140px]">
            @{
              var sortNameAscUrl = CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: null);
              var sortNameDescUrl = CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: "name_desc");
              var sortPriceAscUrl = CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: "price_asc");
              var sortPriceDescUrl = CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: "price_desc");
              var sortRatingDescUrl = CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: "rating_desc");
              var sortRatingAscUrl = CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: "rating_asc");
              var sortNewestUrl = CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: "newest");
            }

            <select id="sorting" class="filter-select label" onchange="window.location.href=this.value">
              <option value="@sortNameAscUrl" selected="@(string.IsNullOrWhiteSpace(Model.Sort) ? "selected" : null)">Tên (A-Z)</option>
              <option value="@sortNameDescUrl" selected="@(string.Equals(Model.Sort, "name_desc", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Tên (Z-A)</option>
              <option value="@sortPriceAscUrl" selected="@(string.Equals(Model.Sort, "price_asc", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Giá (Thấp → Cao)</option>
              <option value="@sortPriceDescUrl" selected="@(string.Equals(Model.Sort, "price_desc", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Giá (Cao → Thấp)</option>
              <option value="@sortRatingDescUrl" selected="@(string.Equals(Model.Sort, "rating_desc", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Đánh giá (Cao → Thấp)</option>
              <option value="@sortRatingAscUrl" selected="@(string.Equals(Model.Sort, "rating_asc", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Đánh giá (Thấp → Cao)</option>
              <option value="@sortNewestUrl" selected="@(string.Equals(Model.Sort, "newest", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Mới nhất</option>
            </select>
            <label for="sorting" class="nice-select-label">Sắp xếp</label>
          </div>
        </div>

        @if (hasActiveFilters)
        {
          <div class="sp-active-chips">
            <span class="text-xs font-bold text-light-secondary-text mr-1">Đang lọc:</span>
            @if (Model.SelectedBrandId.HasValue)
            {
              var selBrandName = Model.Brands?.FirstOrDefault(b => b.BrandId == Model.SelectedBrandId.Value)?.Name ?? $"Hãng #{Model.SelectedBrandId}";
              <a class="sp-chip" href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, brandId: null, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)">
                <span>Hãng: @selBrandName</span>
                <i class="hgi hgi-stroke hgi-multiplication-sign text-xs"></i>
              </a>
            }
            @if (Model.SelectedAttributes != null)
            {
              foreach (var kv in Model.SelectedAttributes)
              {
                var attrName = Model.DynamicAttributes?.FirstOrDefault(a => a.AttributeId == kv.Key)?.Name ?? "Thuộc tính";
                <a class="sp-chip" href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, brandId: Model.SelectedBrandId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort, overrideAttrId: kv.Key, clearAttr: true)">
                  <span>@attrName: @kv.Value</span>
                  <i class="hgi hgi-stroke hgi-multiplication-sign text-xs"></i>
                </a>
              }
            }
            @if (Model.SelectedRating.HasValue)
            {
              <a class="sp-chip" href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: null, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)">
                <span>Từ @Model.SelectedRating sao</span>
                <i class="hgi hgi-stroke hgi-multiplication-sign text-xs"></i>
              </a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SelectedColor))
            {
              <a class="sp-chip" href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: null, size: Model.SelectedSize, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)">
                <span>Màu: @Model.SelectedColor</span>
                <i class="hgi hgi-stroke hgi-multiplication-sign text-xs"></i>
              </a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SelectedSize))
            {
              <a class="sp-chip" href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: null, minPrice: Model.SelectedMinPrice, maxPrice: Model.SelectedMaxPrice, page: 1, sort: Model.Sort)">
                <span>Size: @Model.SelectedSize</span>
                <i class="hgi hgi-stroke hgi-multiplication-sign text-xs"></i>
              </a>
            }
            @if (Model.SelectedMinPrice.HasValue || Model.SelectedMaxPrice.HasValue)
            {
              <a class="sp-chip" href="@CategoryUrl(childCategoryId: Model.SelectedChildCategoryId, rating: Model.SelectedRating, color: Model.SelectedColor, size: Model.SelectedSize, minPrice: null, maxPrice: null, page: 1, sort: Model.Sort)">
                <span>Giá: @((Model.SelectedMinPrice ?? Model.PriceMin).ToString("N0", viVn))đ – @((Model.SelectedMaxPrice ?? Model.PriceMax).ToString("N0", viVn))đ</span>
                <i class="hgi hgi-stroke hgi-multiplication-sign text-xs"></i>
              </a>
            }
            <a href="@CategoryUrl()" class="text-xs font-bold text-error hover:underline ml-1">Xóa tất cả</a>
          </div>
        }

        <div id="shop-products-grid" class="grid grid-cols-12 gap-5 pb-12 items-stretch">
          @if (Model.Products.Count == 0)
          {
            <div class="col-span-12">
              <div class="border border-dashed border-gray-300 bg-gray-50 rounded-3xl p-12 text-center">
                <i class="hgi hgi-stroke hgi-shopping-bag-02 text-5xl text-gray-400 mb-3 inline-block"></i>
                <h5 class="text-lg font-bold text-light-primary-text mb-1">Không tìm thấy sản phẩm phù hợp</h5>
                <p class="text-sm text-light-secondary-text mb-5">Hãy thử điều chỉnh bộ lọc hoặc xóa điều kiện tìm kiếm để xem thêm sản phẩm.</p>
                <a href="@CategoryUrl()" class="btn btn-primary rounded-full px-6 py-2.5 text-sm font-semibold text-white">Xem tất cả sản phẩm</a>
              </div>
            </div>
          }
          else
          {
            foreach (var p in Model.Products)
            {
              var imageUrl = ResolveImageUrl(p.PrimaryImageUrl);
              var detailsUrl = Url.RouteUrl("product_details", new { slug = p.Slug }) ?? "#";
              var ratingPct = (int)Math.Round(Math.Clamp((double)(p.RatingAverage / 5m * 100m), 0d, 100d));

              <div class="sellzy-grid-item xl:col-span-4 md:col-span-6 col-span-12 wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
                <div class="product-card-1 sp-card group">
                  <div class="product-image-container relative">
                    @if (p.DiscountPercent > 0)
                    {
                      <span class="sp-discount-tag">-@p.DiscountPercent%</span>
                    }
                    <div class="product-image rounded-xl mb-3.5 overflow-hidden">
                      <a href='@detailsUrl'>
                        <img src="@imageUrl" alt="@p.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-in-out" />
                      </a>
                    </div>
                    <div class="product-btn-actions absolute bottom-0 right-0 left-0 flex justify-center z-9 transition-all duration-300 ease-in-out opacity-0 group-hover:opacity-100 group-hover:bottom-3">
                      <ul class="flex items-center gap-x-px shadow-md rounded-lg overflow-hidden">
                        <li>
                          <button type="button" aria-label='Yêu thích' data-wishlist-toggle data-product-id='@p.ProductId' class='product-btn-action-item relative size-10 bg-white inline-flex items-center justify-center'>
                            <svg class="wishlist-heart-icon w-5 h-5 text-light-secondary-text" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                              <path class="wishlist-heart-fill opacity-0" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor" />
                            </svg>
                          </button>
                        </li>
                        <li>
                          <a aria-label='So sánh' class='product-btn-action-item relative size-10 bg-white inline-flex items-center justify-center' href='javascript:void(0)' onclick='addToCompare(@p.ProductId)'>
                            <i class="hgi hgi-stroke hgi-reload text-xl text-light-primary-text"></i>
                          </a>
                        </li>
                        <li>
                          <a aria-label="Xem nhanh" class="quick-view-sidebar-btn product-btn-action-item relative size-10 bg-white inline-flex items-center justify-center" href="#" data-quick-view-url="@Url.Action("QuickView", "Products", new { id = p.ProductId })">
                            <i class="hgi hgi-stroke hgi-view text-xl text-light-primary-text"></i>
                          </a>
                        </li>
                      </ul>
                    </div>
                  </div>

                  <div class="product-content flex-1 flex flex-col justify-between">
                    <div>
                      <h5 class="sp-card-title">
                        <a href='@detailsUrl' class="line-clamp-2 transition-colors">@p.Name</a>
                      </h5>

                      <div class="rating-section flex items-center mb-2.5">
                        <div class="bg-[url('../images/star-icon.png')] w-[90px] h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]">
                          <div style="width: @ratingPct%" class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"></div>
                        </div>
                        <span class="text-xs leading-[18px] text-light-secondary-text inline-block ml-1.5">(@p.RatingCount)</span>
                      </div>

                      <div class="sp-price-row">
                        <span class="sp-price-now">@p.Price.ToString("N0", viVn)đ</span>
                        @if (p.OldPrice.HasValue && p.OldPrice.Value > p.Price)
                        {
                          <span class="sp-price-old">@p.OldPrice.Value.ToString("N0", viVn)đ</span>
                          <span class="sp-price-off">-@p.DiscountPercent%</span>
                        }
                      </div>
                    </div>

                    <div class="btn-section">
                      <button type="button" aria-label="Yêu thích" data-wishlist-toggle data-product-id='@p.ProductId' class='flex items-center justify-center rounded-full border'>
                        <svg class="wishlist-heart-icon w-5 h-5 text-light-secondary-text" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                          <path class="wishlist-heart-fill opacity-0" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor" />
                        </svg>
                      </button>
                      <a class='btn btn-primary rounded-full font-semibold text-white' href='#' data-add-to-cart data-variant-id='@p.DefaultVariantId'>
                        <i class="hgi hgi-stroke hgi-shopping-cart-02 text-lg text-white"></i>
                        <span>Thêm vào giỏ</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            }
          }
        </div>

        <!-- Pagination -->
        <div class="grid grid-cols-12 wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
          <div class="col-span-12">
            <ul class="flex items-center justify-center gap-x-1.5 blog-pagination">
              @{
                var totalPages = Model.TotalPages;
                var currentPage = Model.Page;

                var windowStart = Math.Max(1, currentPage - 2);
                var windowEnd = Math.Min(totalPages, currentPage + 2);
              }

              <li class="group blog-pagination-item">
                <a
                  href="@(currentPage > 1 ? PageUrl(currentPage - 1) : "#")"
                  class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] bg-white cursor-pointer border border-gray-300 group-hover:font-semibold group-hover:border-primary group-hover:bg-[rgba(8,129,120,0.08)] transition-colors duration-300 ease-in-out"
                >
                  <span class="inline-flex items-center justify-center">
                    <i class="hgi hgi-stroke hgi-arrow-left-01 text-[20px] group-hover:font-semibold leading-5 text-light-primary-text group-hover:text-primary"></i>
                  </span>
                </a>
              </li>

              @if (totalPages > 0)
              {
                if (windowStart > 1)
                {
                  <li class="group blog-pagination-item">
                    <a href="@PageUrl(1)" class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] text-base leading-6 text-light-primary-text group-hover:text-primary group-hover:font-semibold bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-[rgba(8,129,120,0.08)] transition-colors duration-300 ease-in-out">1</a>
                  </li>
                }

                if (windowStart > 2)
                {
                  <li class="blog-pagination-item">
                    <a href="#" class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] bg-white">
                      <span class="inline-flex items-center justify-center"><i class="hgi hgi-stroke hgi-more-horizontal text-[20px] leading-5 text-light-primary-text"></i></span>
                    </a>
                  </li>
                }

                for (var i = windowStart; i <= windowEnd; i++)
                {
                  if (i == currentPage)
                  {
                    <li class="group blog-pagination-item">
                      <a href="#" class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] active">@i</a>
                    </li>
                  }
                  else
                  {
                    <li class="group blog-pagination-item">
                      <a href="@PageUrl(i)" class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] text-base leading-6 text-light-primary-text group-hover:text-primary group-hover:font-semibold bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-[rgba(8,129,120,0.08)] transition-colors duration-300 ease-in-out">@i</a>
                    </li>
                  }
                }

                if (windowEnd < totalPages - 1)
                {
                  <li class="blog-pagination-item">
                    <a href="#" class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] bg-white">
                      <span class="inline-flex items-center justify-center"><i class="hgi hgi-stroke hgi-more-horizontal text-[20px] leading-5 text-light-primary-text"></i></span>
                    </a>
                  </li>
                }

                if (windowEnd < totalPages)
                {
                  <li class="group blog-pagination-item">
                    <a href="@PageUrl(totalPages)" class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] text-base leading-6 text-light-primary-text group-hover:text-primary group-hover:font-semibold bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-[rgba(8,129,120,0.08)] transition-colors duration-300 ease-in-out">@totalPages</a>
                  </li>
                }
              }

              <li class="group blog-pagination-item">
                <a
                  href="@(currentPage < totalPages ? PageUrl(currentPage + 1) : "#")"
                  class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] group-hover:font-semibold bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-[rgba(8,129,120,0.08)] transition-colors duration-300 ease-in-out"
                >
                  <span class="inline-flex items-center justify-center">
                    <i class="hgi hgi-stroke hgi-arrow-right-01 text-[20px] leading-5 group-hover:font-semibold text-light-primary-text group-hover:text-primary"></i>
                  </span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ========== Main Shop Layout End ========== -->

@section Scripts {
  <script>
    (function () {
      const grid = document.getElementById('shop-products-grid');
      const btnGrid = document.getElementById('btn-view-grid');
      const btnList = document.getElementById('btn-view-list');
      if (!grid || !btnGrid || !btnList) return;

      btnGrid.addEventListener('click', function () {
        grid.classList.remove('is-list-view');
        btnGrid.classList.add('is-active');
        btnList.classList.remove('is-active');
      });

      btnList.addEventListener('click', function () {
        grid.classList.add('is-list-view');
        btnList.classList.add('is-active');
        btnGrid.classList.remove('is-active');
      });
    })();
  </script>
}
