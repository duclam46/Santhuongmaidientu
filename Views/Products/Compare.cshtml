@model DOAN_BANHANG.ViewModels.ProductCompareVm
@{
    ViewData["Title"] = "So sánh sản phẩm";
    var viCulture = new System.Globalization.CultureInfo("vi-VN");
}

<style>
    .sz-cmp-page {
        background: #eef2f6;
        min-height: 75vh;
        padding: 28px 0 72px;
    }
    .sz-cmp-bc {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #64748b;
        margin-bottom: 18px;
    }
    .sz-cmp-bc a {
        color: #475569;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 500;
    }
    .sz-cmp-bc a:hover { color: #008374; }

    .sz-cmp-hero {
        background: linear-gradient(135deg, #022c22 0%, #065f5b 58%, #008374 100%);
        border-radius: 22px;
        padding: 26px 30px;
        color: #ffffff;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
        box-shadow: 0 14px 34px rgba(2, 44, 34, 0.16);
    }
    .sz-cmp-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(253, 224, 71, 0.16);
        border: 1px solid rgba(253, 224, 71, 0.4);
        color: #fde047;
        font-size: 11.5px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 8px;
    }
    .sz-cmp-hero h1 {
        font-size: 24px;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 4px;
    }
    .sz-cmp-hero p {
        margin: 0;
        font-size: 13.5px;
        color: rgba(255, 255, 255, 0.82);
    }
    .sz-cmp-hero-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .sz-cmp-btn-clear {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.28);
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }
    .sz-cmp-btn-clear:hover {
        background: rgba(239, 68, 68, 0.85);
        border-color: rgba(239, 68, 68, 0.95);
    }
    .sz-cmp-btn-add {
        background: #fde047;
        color: #0f172a;
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }
    .sz-cmp-btn-add:hover {
        background: #facc15;
        transform: translateY(-1px);
    }

    .sz-cmp-card {
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
    }
    .sz-cmp-scroll {
        overflow-x: auto;
    }
    .sz-cmp-table {
        width: 100%;
        min-width: 860px;
        border-collapse: collapse;
        table-layout: fixed;
    }
    .sz-cmp-table td {
        border-bottom: 1px solid #e2e8f0;
        border-right: 1px solid #edf2f7;
        padding: 16px 18px;
        vertical-align: middle;
        transition: background-color 0.18s ease;
    }
    .sz-cmp-table td:last-child { border-right: none; }
    .sz-cmp-table tr:last-child td { border-bottom: none; }
    .sz-cmp-table tr:hover td { background: #f8fafc; }

    .sz-cmp-label-col {
        width: 210px;
        background: #f8fafc !important;
        font-weight: 700;
        font-size: 13.5px;
        color: #1e293b;
        text-align: left;
    }
    .sz-cmp-prod-cell {
        position: relative;
        text-align: center;
        vertical-align: top !important;
        padding: 22px 16px !important;
    }
    .sz-cmp-remove {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    .sz-cmp-remove:hover {
        background: #fef2f2;
        color: #ef4444;
        border-color: #fecaca;
    }
    .sz-cmp-thumb {
        width: 136px;
        height: 136px;
        margin: 0 auto 12px;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        display: block;
    }
    .sz-cmp-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.25s ease;
    }
    .sz-cmp-thumb:hover img { transform: scale(1.05); }
    .sz-cmp-prod-title {
        font-size: 14.5px;
        font-weight: 700;
        line-height: 1.45;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 42px;
    }
    .sz-cmp-prod-title a {
        color: #0f172a;
        text-decoration: none;
    }
    .sz-cmp-prod-title a:hover { color: #008374; }

    .sz-cmp-slot-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 16px 8px;
        color: #94a3b8;
        text-decoration: none;
    }
    .sz-cmp-slot-box {
        width: 120px;
        height: 120px;
        border: 2px dashed #cbd5e1;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        color: #94a3b8;
        transition: all 0.2s;
    }
    .sz-cmp-slot-empty:hover .sz-cmp-slot-box {
        border-color: #008374;
        color: #008374;
        background: #f0fdfa;
    }

    .sz-cmp-price {
        font-size: 18px;
        font-weight: 800;
        color: #008374;
    }
    .sz-cmp-old-price {
        font-size: 13px;
        color: #94a3b8;
        text-decoration: line-through;
        margin-left: 6px;
    }
    .sz-cmp-pill-ok {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 700;
    }
    .sz-cmp-pill-out {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 700;
    }
    .sz-cmp-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        padding: 11px 16px;
        border-radius: 12px;
        background: linear-gradient(135deg, #065f5b 0%, #008374 100%);
        color: #ffffff;
        font-weight: 700;
        font-size: 13.5px;
        text-decoration: none;
        transition: all 0.2s;
    }
    .sz-cmp-cta:hover {
        filter: brightness(1.06);
        transform: translateY(-1px);
        color: #ffffff;
    }

    .sz-cmp-empty {
        padding: 68px 24px;
        text-align: center;
    }
    .sz-cmp-empty-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #f0fdfa;
        border: 1px solid #ccfbf1;
        color: #008374;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
    }
</style>

<div class="sz-cmp-page">
    <div class="container">
        <nav class="sz-cmp-bc">
            <a asp-controller="Home" asp-action="Index">
                <i class="hgi hgi-stroke hgi-home-01"></i> Trang chủ
            </a>
            <span>•</span>
            <span style="color:#0f172a;font-weight:600;">So sánh sản phẩm</span>
        </nav>

        <div class="sz-cmp-hero">
            <div>
                <div class="sz-cmp-badge">
                    <i class="hgi hgi-stroke hgi-repeat-01"></i> Đối chiếu thông số trực quan
                </div>
                <h1>So sánh sản phẩm (@Model.Products.Count/4)</h1>
                <p>Đặt tối đa 4 sản phẩm cạnh nhau để đối chiếu giá bán, bảo hành, thuộc tính kỹ thuật và đánh giá thực tế.</p>
            </div>
            <div class="sz-cmp-hero-actions">
                <a href="/products/all" class="sz-cmp-btn-add">
                    <i class="hgi hgi-stroke hgi-add-01"></i> Thêm sản phẩm khác
                </a>
                @if (Model.Products.Any())
                {
                    <button type="button" onclick="clearCompare()" class="sz-cmp-btn-clear">
                        <i class="hgi hgi-stroke hgi-delete-02"></i> Xóa tất cả
                    </button>
                }
            </div>
        </div>

        <div class="sz-cmp-card">
            @if (Model.Products.Any())
            {
                <div class="sz-cmp-scroll">
                    <table class="sz-cmp-table compare-table">
                        <tbody>
                            <!-- Sản phẩm -->
                            <tr>
                                <td class="sz-cmp-label-col">Sản phẩm</td>
                                @foreach (var product in Model.Products)
                                {
                                    var prodUrl = Url.RouteUrl("product_details", new { slug = product.Slug }) ?? $"/product/{product.Slug}";
                                    var imgSrc = DOAN_BANHANG.Helpers.ImageUrlHelper.NormalizeStaticFileUrl(product.ImageUrl)
                                        ?? "/assets/images/placeholder.png";
                                    <td class="sz-cmp-prod-cell">
                                        <button type="button" onclick="removeFromCompare(@product.ProductId)" class="sz-cmp-remove" title="Bỏ khỏi so sánh">
                                            <i class="hgi hgi-stroke hgi-cancel-01"></i>
                                        </button>
                                        <a href="@prodUrl" class="sz-cmp-thumb">
                                            <img src="@imgSrc" alt="@product.Name" onerror="this.onerror=null;this.src='/assets/images/placeholder.png';" />
                                        </a>
                                        <h6 class="sz-cmp-prod-title">
                                            <a href="@prodUrl">@product.Name</a>
                                        </h6>
                                    </td>
                                }
                                @for (int i = Model.Products.Count; i < 4; i++)
                                {
                                    <td class="sz-cmp-prod-cell" style="background:#fcfdfe;">
                                        <a href="/products/all" class="sz-cmp-slot-empty">
                                            <div class="sz-cmp-slot-box">
                                                <i class="hgi hgi-stroke hgi-add-01"></i>
                                            </div>
                                            <span style="font-size:12.5px;font-weight:600;">Chọn thêm sản phẩm</span>
                                        </a>
                                    </td>
                                }
                            </tr>

                            <!-- Giá bán -->
                            <tr>
                                <td class="sz-cmp-label-col">Mức giá</td>
                                @foreach (var product in Model.Products)
                                {
                                    <td style="text-align:center;">
                                        <span class="sz-cmp-price">@product.Price.ToString("C0", viCulture)</span>
                                        @if (product.OldPrice.HasValue && product.OldPrice.Value > product.Price)
                                        {
                                            <span class="sz-cmp-old-price">@product.OldPrice.Value.ToString("C0", viCulture)</span>
                                        }
                                    </td>
                                }
                                @for (int i = Model.Products.Count; i < 4; i++) { <td></td> }
                            </tr>

                            <!-- Đánh giá -->
                            <tr>
                                <td class="sz-cmp-label-col">Đánh giá</td>
                                @foreach (var product in Model.Products)
                                {
                                    <td style="text-align:center;">
                                        <div style="display:inline-flex;align-items:center;gap:4px;color:#f59e0b;font-size:15px;">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Round(product.Rating))
                                                {
                                                    <i class="hgi hgi-stroke hgi-star" style="color:#f59e0b;"></i>
                                                }
                                                else
                                                {
                                                    <i class="hgi hgi-stroke hgi-star" style="color:#cbd5e1;"></i>
                                                }
                                            }
                                            <span style="font-size:13px;color:#64748b;margin-left:4px;">
                                                (@product.Rating.ToString("0.0") • @product.ReviewCount đánh giá)
                                            </span>
                                        </div>
                                    </td>
                                }
                                @for (int i = Model.Products.Count; i < 4; i++) { <td></td> }
                            </tr>

                            <!-- Danh mục & Thương hiệu -->
                            <tr>
                                <td class="sz-cmp-label-col">Danh mục &amp; Hãng</td>
                                @foreach (var product in Model.Products)
                                {
                                    <td style="text-align:center;">
                                        <div style="font-size:13.5px;font-weight:700;color:#0f172a;">@product.CategoryName</div>
                                        @if (!string.IsNullOrWhiteSpace(product.BrandName))
                                        {
                                            <div style="font-size:12px;font-weight:700;color:#008374;margin-top:3px;">Thương hiệu: @product.BrandName</div>
                                        }
                                        <div style="font-size:12px;color:#64748b;margin-top:4px;">
                                            @(product.WarrantyMonths > 0 ? $"Bảo hành {product.WarrantyMonths} tháng" : "Không bảo hành")
                                            • @(product.IsReturnable ? "Hỗ trợ đổi trả" : "Không đổi trả")
                                        </div>
                                    </td>
                                }
                                @for (int i = Model.Products.Count; i < 4; i++) { <td></td> }
                            </tr>

                            @{
                                var allSpecKeys = Model.Products
                                    .SelectMany(p => p.Specs.Keys)
                                    .Distinct()
                                    .ToList();
                            }
                            @foreach (var specKey in allSpecKeys)
                            {
                                <tr>
                                    <td class="sz-cmp-label-col">@specKey</td>
                                    @foreach (var product in Model.Products)
                                    {
                                        <td style="text-align:center;font-size:13.5px;color:#334155;">
                                            @(product.Specs.TryGetValue(specKey, out var sv) && !string.IsNullOrWhiteSpace(sv) ? sv : "—")
                                        </td>
                                    }
                                    @for (int i = Model.Products.Count; i < 4; i++) { <td></td> }
                                </tr>
                            }

                            <!-- Tình trạng kho -->
                            <tr>
                                <td class="sz-cmp-label-col">Tình trạng kho</td>
                                @foreach (var product in Model.Products)
                                {
                                    <td style="text-align:center;">
                                        @if (product.InStock)
                                        {
                                            <span class="sz-cmp-pill-ok">
                                                <i class="hgi hgi-stroke hgi-checkmark-circle-02"></i> Còn hàng
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="sz-cmp-pill-out">
                                                <i class="hgi hgi-stroke hgi-unavailable"></i> Hết hàng
                                            </span>
                                        }
                                    </td>
                                }
                                @for (int i = Model.Products.Count; i < 4; i++) { <td></td> }
                            </tr>

                            <!-- Phân loại màu sắc -->
                            <tr>
                                <td class="sz-cmp-label-col">Tùy chọn 1 / Màu sắc</td>
                                @foreach (var product in Model.Products)
                                {
                                    <td style="text-align:center;font-size:13.5px;color:#334155;">
                                        @(product.Colors.Any() ? string.Join(", ", product.Colors) : "Mặc định")
                                    </td>
                                }
                                @for (int i = Model.Products.Count; i < 4; i++) { <td></td> }
                            </tr>

                            <!-- Phân loại kích thước -->
                            <tr>
                                <td class="sz-cmp-label-col">Tùy chọn 2 / Kích cỡ</td>
                                @foreach (var product in Model.Products)
                                {
                                    <td style="text-align:center;font-size:13.5px;color:#334155;">
                                        @(product.Sizes.Any() ? string.Join(", ", product.Sizes) : "Mặc định")
                                    </td>
                                }
                                @for (int i = Model.Products.Count; i < 4; i++) { <td></td> }
                            </tr>

                            <!-- Tóm tắt mô tả -->
                            <tr>
                                <td class="sz-cmp-label-col">Mô tả nổi bật</td>
                                @foreach (var product in Model.Products)
                                {
                                    <td style="vertical-align:top;font-size:13px;line-height:1.6;color:#475569;">
                                        <div style="display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden;">
                                            @Html.Raw(product.Description)
                                        </div>
                                    </td>
                                }
                                @for (int i = Model.Products.Count; i < 4; i++) { <td></td> }
                            </tr>

                            <!-- Hành động -->
                            <tr>
                                <td class="sz-cmp-label-col">Mua sắm</td>
                                @foreach (var product in Model.Products)
                                {
                                    var prodUrl = Url.RouteUrl("product_details", new { slug = product.Slug }) ?? $"/product/{product.Slug}";
                                    <td style="text-align:center;">
                                        <a href="@prodUrl" class="sz-cmp-cta">
                                            <span>Xem chi tiết &amp; Đặt mua</span>
                                            <i class="hgi hgi-stroke hgi-arrow-right-01"></i>
                                        </a>
                                    </td>
                                }
                                @for (int i = Model.Products.Count; i < 4; i++) { <td></td> }
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="sz-cmp-empty">
                    <div class="sz-cmp-empty-icon">
                        <i class="hgi hgi-stroke hgi-repeat-01"></i>
                    </div>
                    <h4 style="font-size:20px;font-weight:800;color:#0f172a;margin:0 0 8px;">Chưa có sản phẩm nào trong bảng so sánh</h4>
                    <p style="font-size:14px;color:#64748b;max-width:460px;margin:0 auto 24px;">
                        Hãy bấm biểu tượng <strong>So sánh</strong> trên thẻ sản phẩm bất kỳ để đặt lên bàn cân đối chiếu giá bán và cấu hình chi tiết.
                    </p>
                    <a href="/products/all" class="sz-cmp-cta" style="width:auto;padding:12px 28px;border-radius:999px;">
                        <i class="hgi hgi-stroke hgi-shopping-bag-02"></i> Khám phá sản phẩm ngay
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Using global compare.js -->
}
