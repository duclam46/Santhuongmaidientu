@section Scripts {
  <script>
    (function () {
      const dataEl = document.getElementById("js-product-variants");
      if (!dataEl) return;

      const scope = dataEl.closest(".rounded-3xl") || document;

      let variants = [];
      try {
        variants = JSON.parse(dataEl.textContent || "[]") || [];
      } catch {
        variants = [];
      }

      if (!Array.isArray(variants) || variants.length === 0) return;

      const currentPriceEl = document.getElementById("js-current-price");
      const oldPriceEl = document.getElementById("js-old-price");
      const discountPercentEl = document.getElementById("js-discount-percent");
      const stockEl = document.getElementById("js-stock");
      const stockLeftEl = document.getElementById("js-stock-left");
      const stockProgressEl = document.getElementById("js-stock-progress");
      const selectedSizeTextEl = scope.querySelector(".size-variation-selected-size");
      const selectedColorTextEl = scope.querySelector(".color-variation-selected-color");

      const saleBadgeEl = document.getElementById("js-sale-badge");
      const saleCountdownEl = document.getElementById("js-sale-countdown");
      const saleDaysEl = document.getElementById("js-sale-days");
      const saleHoursEl = document.getElementById("js-sale-hours");
      const saleMinutesEl = document.getElementById("js-sale-minutes");
      const saleSecondsEl = document.getElementById("js-sale-seconds");

      const addToCartBtn = scope.querySelector("button[data-add-to-cart]");
      const buyNowBtn = scope.querySelector("button[data-buy-now]");

      const sizeButtons = Array.from(scope.querySelectorAll(".size-variation-items button[data-size-id]"));
      const colorButtons = Array.from(scope.querySelectorAll(".color-variation-items button[data-color-id]"));

      const hasSizeUi = sizeButtons.length > 0;
      const hasColorUi = colorButtons.length > 0;

      const fmt = new Intl.NumberFormat("vi-VN");
      const fmtVnd = (n) => `${fmt.format(n)} VNĐ`;

      const asInt = (v) => {
        const n = parseInt(String(v ?? "0"), 10);
        return Number.isFinite(n) ? n : 0;
      };

      const asNum = (v) => {
        const n = Number(v);
        return Number.isFinite(n) ? n : null;
      };

      let saleTimerId = null;
      let saleDeadlineMs = null;
      let lastRenderedSecs = null;

      const clearSaleTimer = () => {
        if (saleTimerId) {
          window.clearTimeout(saleTimerId);
          saleTimerId = null;
        }
        saleDeadlineMs = null;
        lastRenderedSecs = null;
      };

      const splitCountdown = (totalSeconds) => {
        const s = Math.max(0, asInt(totalSeconds));
        const days = Math.floor(s / 86400);
        const hours = Math.floor((s % 86400) / 3600);
        const minutes = Math.floor((s % 3600) / 60);
        const seconds = s % 60;
        return {
          days,
          hours: String(hours).padStart(2, "0"),
          minutes: String(minutes).padStart(2, "0"),
          seconds: String(seconds).padStart(2, "0"),
        };
      };

      const renderSaleCountdown = (secs) => {
        if (!saleCountdownEl) return;
        const safeSecs = Math.max(0, asInt(secs));
        if (safeSecs <= 0) {
          saleCountdownEl.classList.add("hidden");
          if (saleDaysEl) saleDaysEl.textContent = "0";
          if (saleHoursEl) saleHoursEl.textContent = "00";
          if (saleMinutesEl) saleMinutesEl.textContent = "00";
          if (saleSecondsEl) saleSecondsEl.textContent = "00";
          return;
        }

        if (saleCountdownEl.classList.contains("hidden")) {
          saleCountdownEl.classList.remove("hidden");
        }

        const parts = splitCountdown(safeSecs);
        if (saleDaysEl) saleDaysEl.textContent = String(parts.days);
        if (saleHoursEl) saleHoursEl.textContent = parts.hours;
        if (saleMinutesEl) saleMinutesEl.textContent = parts.minutes;
        if (saleSecondsEl) saleSecondsEl.textContent = parts.seconds;
      };

      const computeRemainingSecs = () => {
        if (saleDeadlineMs == null) return 0;
        const msLeft = saleDeadlineMs - Date.now();
        if (msLeft <= 0) return 0;
        return Math.ceil(msLeft / 1000);
      };

      const scheduleNextTick = () => {
        if (saleDeadlineMs == null) return;

        const remaining = computeRemainingSecs();
        if (lastRenderedSecs !== remaining) {
          lastRenderedSecs = remaining;
          renderSaleCountdown(remaining);
        }

        if (remaining <= 0) {
          clearSaleTimer();
          renderSaleCountdown(0);
          return;
        }

        const msLeft = saleDeadlineMs - Date.now();
        const msToNextSecond = Math.max(50, Math.min(1000, (msLeft % 1000) || 1000));
        saleTimerId = window.setTimeout(scheduleNextTick, msToNextSecond);
      };

      const setSaleUiFromVariant = (v) => {
        const isOnSale = !!v?.isOnSale;
        if (saleBadgeEl) saleBadgeEl.classList.toggle("hidden", !isOnSale);

        const secs = isOnSale ? asInt(v?.saleSecondsLeft) : 0;
        clearSaleTimer();

        if (!isOnSale || secs <= 0) {
          renderSaleCountdown(0);
          return;
        }

        saleDeadlineMs = Date.now() + (secs * 1000);
        lastRenderedSecs = null;
        scheduleNextTick();
      };

      function setDisabled(btn, disabled) {
        if (!btn) return;
        btn.disabled = !!disabled;
        btn.classList.toggle("opacity-50", !!disabled);
        btn.classList.toggle("cursor-not-allowed", !!disabled);

        const wrap = btn.closest?.(".variation-color-item");
        if (wrap) {
          wrap.classList.toggle("opacity-50", !!disabled);
          wrap.classList.toggle("cursor-not-allowed", !!disabled);
        }
      }

      const state = {
        colorId: hasColorUi
          ? asInt(colorButtons.find(b => b.closest(".variation-color-item")?.classList.contains("border-primary"))?.dataset.colorId) || asInt(colorButtons[0]?.dataset.colorId)
          : 0,
        sizeId: hasSizeUi
          ? asInt(sizeButtons.find(b => b.classList.contains("bg-primary"))?.dataset.sizeId) || asInt(sizeButtons[0]?.dataset.sizeId)
          : 0
      };

      const findExactVariant = (colorId, sizeId) => {
        return variants.find(v => {
          const okColor = !hasColorUi || asInt(v.colorId) === asInt(colorId);
          const okSize = !hasSizeUi || asInt(v.sizeId) === asInt(sizeId);
          return okColor && okSize;
        }) || null;
      };

      const availableSizesForColor = (colorId) => {
        const set = new Set();
        variants.forEach(v => {
          if (asInt(v.colorId) === asInt(colorId) && asInt(v.sizeId)) set.add(asInt(v.sizeId));
        });
        return set;
      };

      const availableColorsForSize = (sizeId) => {
        const set = new Set();
        variants.forEach(v => {
          if (asInt(v.sizeId) === asInt(sizeId) && asInt(v.colorId)) set.add(asInt(v.colorId));
        });
        return set;
      };

      const syncOptionAvailability = () => {
        if (hasColorUi && state.colorId) {
          const sizesOk = availableSizesForColor(state.colorId);
          for (const btn of sizeButtons) {
            const id = asInt(btn.dataset.sizeId);
            setDisabled(btn, !sizesOk.has(id));
          }
        }

        if (hasSizeUi && state.sizeId) {
          const colorsOk = availableColorsForSize(state.sizeId);
          for (const btn of colorButtons) {
            const id = asInt(btn.dataset.colorId);
            setDisabled(btn, !colorsOk.has(id));
          }
        }
      };

      const selectColorUi = (colorId) => {
        state.colorId = asInt(colorId);
        for (const btn of colorButtons) {
          const isSelected = asInt(btn.dataset.colorId) === state.colorId;

          const wrap = btn.closest(".variation-color-item");
          if (wrap) {
            wrap.classList.toggle("border-primary", isSelected);
            wrap.classList.toggle("border-gray-300", !isSelected);
          }

          const tick = btn.querySelector("i.hgi-tick-02");
          if (tick) tick.classList.toggle("hidden", !isSelected);
        }

        if (selectedColorTextEl) {
          const selectedBtn = colorButtons.find(b => asInt(b.dataset.colorId) === state.colorId);
          if (selectedBtn) {
            selectedColorTextEl.textContent = (selectedBtn.dataset.colorText || "").toString();
          }
        }
      };

      const selectSizeUi = (sizeId) => {
        state.sizeId = asInt(sizeId);
        for (const btn of sizeButtons) {
          const isSelected = asInt(btn.dataset.sizeId) === state.sizeId;

          // Selected
          btn.classList.toggle("bg-primary", isSelected);
          btn.classList.toggle("text-white", isSelected);
          btn.classList.toggle("border-primary", isSelected);
          btn.classList.toggle("hover:bg-primary", isSelected);

          // Unselected
          btn.classList.toggle("text-light-primary-text", !isSelected);
          btn.classList.toggle("border-gray-300", !isSelected);
          if (!isSelected) btn.classList.remove("hover:bg-primary");

          if (isSelected && selectedSizeTextEl) {
            selectedSizeTextEl.textContent = (btn.dataset.sizeText || "").toString();
          }
        }
      };

      const ensureValidSelection = () => {
        if (hasColorUi && !state.colorId) {
          const first = colorButtons.find(b => !b.disabled);
          if (first) selectColorUi(asInt(first.dataset.colorId));
        }

        if (hasSizeUi && !state.sizeId) {
          const first = sizeButtons.find(b => !b.disabled);
          if (first) selectSizeUi(asInt(first.dataset.sizeId));
        }

        const isValid = findExactVariant(state.colorId, state.sizeId);
        if (isValid) return;

        const sorted = variants
          .slice()
          .sort((a, b) => {
            const sa = asInt(a.stockQuantity) > 0 ? 0 : 1;
            const sb = asInt(b.stockQuantity) > 0 ? 0 : 1;
            if (sa !== sb) return sa - sb;
            return (asNum(a.price) ?? 0) - (asNum(b.price) ?? 0);
          });

        const first = sorted[0] || null;
        if (!first) return;

        if (hasColorUi && asInt(first.colorId)) selectColorUi(asInt(first.colorId));
        if (hasSizeUi && asInt(first.sizeId)) selectSizeUi(asInt(first.sizeId));
      };

      const pickBestVariant = (predicate) => {
        const list = variants.filter(predicate);
        if (list.length === 0) return null;

        return list
          .slice()
          .sort((a, b) => {
            const sa = asInt(a.stockQuantity) > 0 ? 0 : 1;
            const sb = asInt(b.stockQuantity) > 0 ? 0 : 1;
            if (sa !== sb) return sa - sb;
            return (asNum(a.price) ?? 0) - (asNum(b.price) ?? 0);
          })[0];
      };

      const ensureValidAfterColorChange = () => {
        if (!hasColorUi) return;
        const exact = findExactVariant(state.colorId, state.sizeId);
        if (exact) return;

        const best = pickBestVariant(v => asInt(v.colorId) === asInt(state.colorId));
        if (!best) return;

        if (hasSizeUi && asInt(best.sizeId)) {
          selectSizeUi(asInt(best.sizeId));
        }
      };

      const ensureValidAfterSizeChange = () => {
        if (!hasSizeUi) return;
        const exact = findExactVariant(state.colorId, state.sizeId);
        if (exact) return;

        const best = pickBestVariant(v => asInt(v.sizeId) === asInt(state.sizeId));
        if (!best) return;

        if (hasColorUi && asInt(best.colorId)) {
          selectColorUi(asInt(best.colorId));
        }
      };

      const updateDisplayedInfo = () => {
        const v = findExactVariant(state.colorId, state.sizeId);
        if (!v) return;

        // If a matching variant was found, sync the state from it to avoid any mismatch
        // caused by fallbacks/availability rules.
        if (hasColorUi && asInt(v.colorId)) {
          state.colorId = asInt(v.colorId);
          selectColorUi(state.colorId);
        } else if (selectedColorTextEl && v.color) {
          selectedColorTextEl.textContent = String(v.color);
        }

        if (hasSizeUi && asInt(v.sizeId)) {
          state.sizeId = asInt(v.sizeId);
          selectSizeUi(state.sizeId);
        } else if (selectedSizeTextEl && v.sizeLabel) {
          selectedSizeTextEl.textContent = String(v.sizeLabel);
        }

        const price = asNum(v.price) ?? 0;
        if (currentPriceEl) currentPriceEl.textContent = fmtVnd(price);

        const basePrice = asNum(v.basePrice);
        const onSale = !!v?.isOnSale && basePrice != null && basePrice > price;
        if (oldPriceEl) {
          oldPriceEl.classList.toggle("hidden", !onSale);
          if (onSale) oldPriceEl.textContent = fmtVnd(basePrice);
        }
        if (discountPercentEl) {
          discountPercentEl.classList.toggle("hidden", !onSale);
          if (onSale) {
            const rawPct = basePrice > 0 ? Math.round(((basePrice - price) / basePrice) * 100) : 0;
            const pct = Math.max(0, Math.min(100, rawPct));
            discountPercentEl.textContent = `${pct}% OFF`;
          }
        }

        const stockQty = asInt(v.stockQuantity);
        if (stockEl) stockEl.textContent = fmt.format(stockQty);
        if (stockLeftEl) stockLeftEl.textContent = fmt.format(stockQty);
        if (stockProgressEl) {
          const maxStock = variants.reduce((m, it) => Math.max(m, asInt(it.stockQuantity)), 0);
          const rawPct = maxStock > 0 ? Math.round((stockQty / maxStock) * 100) : 0;
          const pct = Math.max(0, Math.min(100, rawPct));
          stockProgressEl.style.width = `${pct}%`;
        }

        if (addToCartBtn && asInt(v.variantId)) {
          addToCartBtn.dataset.variantId = String(asInt(v.variantId));
        }

        if (buyNowBtn && asInt(v.variantId)) {
          buyNowBtn.dataset.variantId = String(asInt(v.variantId));
        }

        setSaleUiFromVariant(v);
      };

      for (const btn of colorButtons) {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          if (btn.disabled) return;
          const colorId = asInt(btn.dataset.colorId);
          if (!colorId) return;
          selectColorUi(colorId);
          ensureValidAfterColorChange();
          syncOptionAvailability();
          updateDisplayedInfo();
        });
      }

      for (const btn of sizeButtons) {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          if (btn.disabled) return;
          const sizeId = asInt(btn.dataset.sizeId);
          if (!sizeId) return;
          selectSizeUi(sizeId);
          ensureValidAfterSizeChange();
          syncOptionAvailability();
          updateDisplayedInfo();
        });
      }

      syncOptionAvailability();
      ensureValidSelection();
      updateDisplayedInfo();
    })();
  </script>
}
