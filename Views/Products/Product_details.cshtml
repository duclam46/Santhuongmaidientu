@model DOAN_BANHANG.ViewModels.ProductDetailsVm

@{
  var viVn = global::System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
  var ratingPct = (int)System.Math.Round(System.Math.Clamp((double)(Model.AverageRating / 5m * 100m), 0d, 100d));

  var images = (Model.Images ?? new List<DOAN_BANHANG.ViewModels.ProductDetailsImageVm>())
    .OrderByDescending(i => i.IsPrimary)
    .ThenBy(i => i.SortOrder)
    .ThenBy(i => i.Url)
    .ToList();

  if (images.Count == 0)
  {
    images.Add(new DOAN_BANHANG.ViewModels.ProductDetailsImageVm
    {
      Url = "assets/images/vitamin-c.png",
      Alt = Model.Name,
      IsPrimary = true,
      SortOrder = 0
    });
  }

  var descImage1 = images.ElementAtOrDefault(0)?.Url;
  var descImage2 = images.ElementAtOrDefault(1)?.Url ?? descImage1;

  var sizeGuides = (Model.SizeGuides ?? new List<DOAN_BANHANG.ViewModels.ProductSizeGuideVm>()).ToList();
  var reviews = (Model.Reviews ?? new List<DOAN_BANHANG.ViewModels.ProductReviewVm>()).ToList();
  var reviewsTotal = reviews.Count;
  var ratingCounts = new int[6];
  foreach (var r in reviews)
  {
    if (r.Rating >= 1 && r.Rating <= 5) ratingCounts[r.Rating]++;
  }

  // Treat "new arrival" as created in last 30 days.
  var isNewArrival = Model.CreatedAt >= DateTime.UtcNow.AddDays(-30);

  var variants = (Model.Variants ?? new List<DOAN_BANHANG.ViewModels.ProductVariantVm>()).ToList();

  var selectedVariant = variants
    .FirstOrDefault(v => Model.SelectedVariantId.HasValue && v.VariantId == Model.SelectedVariantId.Value)
    ?? variants
      .OrderBy(v => v.VariantId)
      .FirstOrDefault();

  var colorOptions = variants
    .Where(v => v.ColorId.HasValue && !string.IsNullOrWhiteSpace(v.Color))
    .GroupBy(v => v.ColorId!.Value)
    .Select(g => new
    {
      ColorId = g.Key,
      Name = g.Select(x => x.Color).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? "(N/A)",
      Hex = g.Select(x => x.ColorHex).FirstOrDefault(h => !string.IsNullOrWhiteSpace(h)) ?? "#dfe3e8",
    })
    .OrderBy(x => x.Name)
    .ToList();

  var selectedColorId = selectedVariant?.ColorId ?? (colorOptions.Count > 0 ? colorOptions[0].ColorId : (int?)null);
  var selectedColor = selectedVariant?.Color ?? (colorOptions.Count > 0 ? colorOptions[0].Name : string.Empty);

  var sizeOrder = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
  {
    ["XS"] = 0,
    ["S"] = 1,
    ["M"] = 2,
    ["L"] = 3,
    ["XL"] = 4,
    ["XXL"] = 5,
    ["XXXL"] = 6
  };

  var sizeOptions = variants
    .Where(v => v.SizeId.HasValue && !string.IsNullOrWhiteSpace(v.SizeLabel))
    .GroupBy(v => v.SizeId!.Value)
    .Select(g => new
    {
      SizeId = g.Key,
      Name = g.Select(x => x.SizeLabel).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? "(N/A)",
    })
    .OrderBy(x => sizeOrder.TryGetValue(x.Name, out var ord) ? ord : 999)
    .ThenBy(x => x.Name)
    .ToList();

  var selectedSizeId = selectedVariant?.SizeId ?? (sizeOptions.Count > 0 ? sizeOptions[0].SizeId : (int?)null);
  var selectedSize = selectedVariant?.SizeLabel ?? (sizeOptions.Count > 0 ? sizeOptions[0].Name : "One Size");

  var isOnSale = selectedVariant?.IsOnSale == true;
  var saleSecondsLeft = selectedVariant?.SaleSecondsLeft;

  var displayBasePrice = selectedVariant?.BasePrice ?? Model.Price;
  var displayPrice = selectedVariant?.Price ?? Model.Price;
  var displayDiscountPercent = isOnSale && displayBasePrice > displayPrice && displayBasePrice > 0
    ? (int)System.Math.Round(System.Math.Clamp((double)((displayBasePrice - displayPrice) / displayBasePrice * 100m), 0d, 100d))
    : 0;
  var isSaleDisplay = isOnSale && displayBasePrice > displayPrice && displayDiscountPercent > 0;

  var displayStockLeft = selectedVariant?.StockQuantity ?? Model.StockQuantity;
  var maxVariantStock = variants.Count > 0 ? variants.Max(v => v.StockQuantity) : displayStockLeft;
  var displayStockPct = maxVariantStock > 0
    ? (int)System.Math.Round(System.Math.Clamp(displayStockLeft * 100d / maxVariantStock, 0d, 100d))
    : 0;
}

    <!-- ========== Breadcrumb Section Start ========== -->
    <div class="py-12">
      <div class="container">
        <div class="breadcrumb">
          <ul>
            <li>
              <a href='@Url.Action("Index", "Home")'>
                <span>
                  <i class="hgi hgi-stroke hgi-home-01 text-[20px]"></i>
                </span>
                Trang chủ
              </a>
            </li>
            <li class="text-light-disabled-text">&#8226;</li>
            <li><span>Chi tiết sản phẩm</span></li>
          </ul>
        </div>
      </div>
    </div>
    <!-- ========== Breadcrumb Section End ========== -->

    <!-- ========== Product Details Section Start ========== -->
    <section>
      <div class="container">
        <div class="lg:grid lg:grid-cols-12 lg:gap-12">
          <div class="xl:col-span-7 lg:col-span-6">
            <div
              class="flex gap-x-6 xl:flex-row flex-col gap-y-6 xl:gap-y-0 xl:gap-x-6"
            >
              <div
                class="xl:w-[114px] lg:w-full order-2 xl:order-1 flex-none overflow-hidden"
              >
                <div
                  class="product-details-small-slider -m-2.5 sellzy-slider"
                  data-slick='{"slidesToShow": 6, "slidesToScroll": 1, "arrows": false, "infinite": true, "loop": true, "vertical": true, "verticalSwiping": true, "asNavFor": ".product-details-big-slider", "focusOnSelect": true, "responsive": [{"breakpoint": 1025, "settings": {"slidesToShow": 4, "vertical": false, "verticalSwiping": false}}, {"breakpoint": 769, "settings": {"slidesToShow": 3, "vertical": false, "verticalSwiping": false}}, {"breakpoint": 480, "settings": {"slidesToShow": 2, "vertical": false, "verticalSwiping": false}}]}'
                >
                  @foreach (var img in images)
                  {
                    <div class="single-product-small-slider-item p-2.5 rounded-lg overflow-hidden aspect-square bg-[#F4F3F5]">
                      <img
                        src="@img.Url"
                        alt="@img.Alt"
                        class="w-full h-full object-cover rounded-lg"
                      />
                    </div>
                  }
                </div>
              </div>
              <div
                class="w-full xl:flex-1 order-1 xl:order-2 overflow-hidden relative"
              >
                <div id="js-sale-badge" class="absolute top-4 left-4 z-10 px-3 py-1 rounded-full bg-error text-white text-xs font-bold uppercase @(isOnSale ? "" : "hidden")">
                  Giảm giá
                </div>
                <div
                  class="product-details-big-slider -mx-3 sellzy-slider"
                  data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "arrows": true, "asNavFor": ".product-details-small-slider", "appendArrows": ".product-details-big-slider-nav", "responsive": [{"breakpoint": 769, "settings": {"slidesToShow": 1, "arrows": false}}]}'
                >
                  @foreach (var img in images)
                  {
                    <div class="single-product-big-slider-item px-3 rounded-2xl overflow-hidden h-[360px] sm:h-[440px] lg:h-[520px] bg-[#F4F3F5] flex items-center justify-center">
                      <img
                        src="@img.Url"
                        alt="@img.Alt"
                        class="w-full h-full object-contain rounded-3xl"
                      />
                    </div>
                  }
                </div>
                <div
                  class="product-details-big-slider-nav absolute top-1/2 -translate-y-1/2 left-0 right-0 flex items-center justify-between px-3"
                ></div>
              </div>
            </div>
          </div>
          <div class="xl:col-span-5 lg:col-span-6 mt-6 lg:mt-0">
            <div class="rounded-3xl border border-gray-300 p-6">
              @if (isSaleDisplay || isNewArrival || Model.IsDigital || Model.ExpiryDate.HasValue || (!string.IsNullOrWhiteSpace(Model.ShippingCondition) && Model.ShippingCondition != "Tiêu chuẩn"))
              {
                <div class="flex items-center flex-wrap gap-2 mb-6">
                  @if (isSaleDisplay)
                  {
                    <span class="product-details-tag-sale">Đang giảm giá</span>
                  }
                  @if (isNewArrival)
                  {
                    <span class="product-details-tag-new">Hàng mới</span>
                  }
                  @if (Model.IsDigital)
                  {
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700 border border-blue-200">⚡ Sản phẩm số / E-Voucher (Giao mã tự động - Freeship)</span>
                  }
                  @if (!string.IsNullOrWhiteSpace(Model.ShippingCondition) && Model.ShippingCondition != "Tiêu chuẩn")
                  {
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200">📦 @Model.ShippingCondition</span>
                  }
                  @if (Model.ExpiryDate.HasValue)
                  {
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">⏳ HSD: @Model.ExpiryDate.Value.ToString("dd/MM/yyyy")</span>
                  }
                </div>
              }
              <div
                class="product-title-section flex items-center justify-between mb-6"
              >
                <h3 class="line-clamp-1">
                  @Model.Name
                </h3>
                <button type="button" aria-label="Thêm vào yêu thích" data-wishlist-toggle data-product-id='@Model.ProductId' class='size-10 inline-flex flex-none items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 border border-gray-300'>
                  <svg class="wishlist-heart-icon w-5 h-5 text-light-secondary-text" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                    <path class="wishlist-heart-fill opacity-0" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor" />
                  </svg>
                </button>
              </div>
              <div class="rating-section flex items-center mb-4">
                <div
                  class="bg-[url('../images/star-icon.png')] w-[90px] h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]"
                >
                  <div
                    style="width: @ratingPct%"
                    class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"
                  ></div>
                </div>
                <span class="font-normal inline-block ml-1">(@Model.ReviewCount.ToString("N0", viVn) đánh giá)</span>
              </div>
              <div class="price-section flex items-center gap-x-3 mb-2 flex-wrap">
                <span
                  class="current-price text-2xl leading-9 font-bold text-light-primary-text inline-block @(isSaleDisplay ? "relative after:absolute after:h-6 after:w-px after:bg-gray-300 after:right-0 after:top-1/2 after:-translate-y-1/2 pr-3" : "")"
                  id="js-current-price">@displayPrice.ToString("N0", viVn) VNĐ</span>
                @if (isSaleDisplay)
                {
                  <span
                    id="js-old-price"
                    class="old-price text-2xl leading-9 font-normal text-light-disabled-text"
                  >@displayBasePrice.ToString("N0", viVn) VNĐ</span>
                  <span
                    id="js-discount-percent"
                    class="product-details-discount-badge"
                  >-@displayDiscountPercent%</span>
                }
                else
                {
                  <span
                    id="js-old-price"
                    class="old-price text-2xl leading-9 font-normal text-light-disabled-text hidden"
                    style="display: none;"
                  ></span>
                  <span
                    id="js-discount-percent"
                    class="product-details-discount-badge hidden"
                    style="display: none;"
                  ></span>
                }
              </div>
              <div class="flex flex-wrap items-center gap-2 mb-5">
                @if (Model.HasPriceRange)
                {
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-light-secondary-text border border-gray-200">
                    📊 Phổ giá theo phân loại: <strong class="text-primary">@Model.MinVariantPrice.ToString("N0", viVn)₫ – @Model.MaxVariantPrice.ToString("N0", viVn)₫</strong>
                  </span>
                }
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                  🏷️ SKU: <strong id="js-variant-sku">@(!string.IsNullOrWhiteSpace(selectedVariant?.Sku) ? selectedVariant!.Sku : $"SP-{Model.ProductId}")</strong>
                </span>
              </div>
              <div id="js-sale-countdown" class="sale-section flex flex-col xl:flex-row xl:items-center xl:justify-between mb-6 @(isOnSale && saleSecondsLeft.HasValue && saleSecondsLeft.Value > 0 ? "" : "hidden")" data-seconds-left="@(saleSecondsLeft ?? 0)">
                <p class="xl:w-[120px] w-full text-left mb-4 xl:mb-0">Nhanh tay! Kết thúc sau:</p>
                <div class="home-one-hot-deal-countdown flex items-center gap-x-3 sm:gap-x-5">
                  <div class="countdown-item flex flex-col items-center justify-center w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-error/8 border border-error text-center">
                    <h5 id="js-sale-days" class="days text-sm sm:text-base">0</h5>
                    <p class="text-xs sm:text-sm leading-[18px] sm:leading-[22px]">Ngày</p>
                  </div>
                  <p class="font-semibold">:</p>
                  <div class="countdown-item flex flex-col items-center justify-center w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-error/8 border border-error text-center">
                    <h5 id="js-sale-hours" class="hours text-sm sm:text-base">00</h5>
                    <p class="text-xs sm:text-sm leading-[18px] sm:leading-[22px]">Giờ</p>
                  </div>
                  <p class="font-semibold">:</p>
                  <div class="countdown-item flex flex-col items-center justify-center w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-error/8 border border-error text-center">
                    <h5 id="js-sale-minutes" class="minutes text-sm sm:text-base">00</h5>
                    <p class="text-xs sm:text-sm leading-[18px] sm:leading-[22px]">Phút</p>
                  </div>
                  <p class="font-semibold">:</p>
                  <div class="countdown-item flex flex-col items-center justify-center w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-error/8 border border-error text-center">
                    <h5 id="js-sale-seconds" class="seconds text-sm sm:text-base">00</h5>
                    <p class="text-xs sm:text-sm leading-[18px] sm:leading-[22px]">Giây</p>
                  </div>
                </div>
              </div>

              <div class="progressbar-section mb-5">
                <div class="progress w-full h-1.5 bg-warning-lighter rounded-[50px] overflow-hidden mb-2.5">
                  <div id="js-stock-progress" style="width: @displayStockPct%" class="progress-bar h-full bg-warning rounded-[50px]"></div>
                </div>
                <p class="text-light-primary-text">
                  Nhanh tay! Chỉ còn <span id="js-stock-left" class="font-semibold">@displayStockLeft.ToString("N0", viVn)</span> sản phẩm trong kho
                </p>
              </div>

              @if (Model.AvailableVouchers != null && Model.AvailableVouchers.Count > 0)
              {
                <div class="mb-5 p-3.5 rounded-2xl border border-amber-200" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);">
                  <div class="flex items-center justify-between gap-2 mb-2.5">
                    <span class="text-xs font-extrabold uppercase tracking-wider text-amber-900 flex items-center gap-1.5">
                      <span>🎟️</span> Mã giảm giá áp dụng cho sản phẩm này
                    </span>
                    <span class="text-[11px] font-semibold text-amber-700">Bấm Lưu để tự áp dụng khi Thanh toán</span>
                  </div>
                  <div class="flex items-stretch gap-2.5 overflow-x-auto pb-1">
                    @foreach (var v in Model.AvailableVouchers)
                    {
                      var discText = v.DiscountType == "FreeShipping"
                        ? $"Freeship {v.DiscountValue.ToString("N0", viVn)}₫"
                        : (v.DiscountType == "Percent" ? $"Giảm {v.DiscountValue:0.##}%" : $"Giảm {v.DiscountValue.ToString("N0", viVn)}₫");
                      <div class="flex items-center justify-between gap-2.5 bg-white border border-amber-300 rounded-xl px-3 py-2 shadow-xs shrink-0" style="min-width: 215px;">
                        <div class="min-w-0">
                          <div class="flex items-center gap-1">
                            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded @(v.IsShopVoucher ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800")">@v.SponsorBadge</span>
                            <span class="text-[10px] text-gray-500">@v.ScopeBadge</span>
                          </div>
                          <div class="font-extrabold text-sm text-red-600 mt-0.5">@discText</div>
                          <div class="text-[11px] text-gray-500">Đơn từ @v.MinOrderValue.ToString("N0", viVn)₫</div>
                        </div>
                        <button type="button"
                                class="js-claim-voucher-btn px-2.5 py-1.5 rounded-lg text-xs font-bold text-white shrink-0 cursor-pointer transition-all"
                                style="background: @(v.IsSaved ? "#059669" : "linear-gradient(135deg, #f97316, #ea580c)");"
                                data-voucher-id="@v.Id"
                                data-voucher-code="@v.Code"
                                onclick="claimSellzyVoucher(@v.Id, '@v.Code', this)">
                          @(v.IsSaved ? "✓ Đã lưu" : "Lưu mã")
                        </button>
                      </div>
                    }
                  </div>
                </div>
              }

              <script type="application/json" id="js-product-variants">
                @Html.Raw(global::System.Text.Json.JsonSerializer.Serialize(
                  Model.Variants ?? new List<DOAN_BANHANG.ViewModels.ProductVariantVm>(),
                  new global::System.Text.Json.JsonSerializerOptions
                  {
                    PropertyNamingPolicy = global::System.Text.Json.JsonNamingPolicy.CamelCase
                  }))
              </script>
              <div
                class="product-add-to-cart-section py-6 border-b border-dashed border-gray-300 border-t"
              >
                @{
                  var tier1Group = Model.OptionGroups?.FirstOrDefault(g => g.Tier == 1);
                  var tier2Group = Model.OptionGroups?.FirstOrDefault(g => g.Tier == 2);
                }

                @if (tier1Group != null && tier1Group.Values.Count > 0)
                {
                  <div class="color-variation-section mb-6">
                    <div class="color-variation-section-title mb-4">
                      <p class="font-semibold text-light-primary-text flex items-center gap-x-2.5">
                        @tier1Group.Name:
                        <span class="text-light-primary-text font-normal capitalize color-variation-selected-color">@(selectedVariant?.Option1Value ?? selectedColor)</span>
                      </p>
                    </div>

                    <div class="color-variation-items flex items-center gap-2 flex-wrap">
                      @for (var i = 0; i < tier1Group.Values.Count; i++)
                      {
                        var val = tier1Group.Values[i];
                        var isSelected = (selectedVariant?.ColorId ?? selectedColorId) == val.Id;
                        if (!string.IsNullOrWhiteSpace(val.ColorHex))
                        {
                          <div class="variation-color-item p-1 border rounded-full @(isSelected ? "border-primary" : "border-gray-300")">
                            <button
                              type="button"
                              data-color-id="@val.Id"
                              data-color-text="@val.Value"
                              data-opt-img="@val.ImageUrl"
                              class="size-6 rounded-full flex items-center justify-center cursor-pointer"
                              style="background-color: @val.ColorHex"
                              title="@val.Value"
                            >
                              <i class="hgi hgi-stroke hgi-tick-02 text-white @(isSelected ? "" : "hidden")" aria-hidden="true"></i>
                            </button>
                          </div>
                        }
                        else
                        {
                          <div class="variation-color-item">
                            <button
                              type="button"
                              data-color-id="@val.Id"
                              data-color-text="@val.Value"
                              data-opt-img="@val.ImageUrl"
                              class="cursor-pointer inline-flex items-center gap-2 text-sm leading-6 px-4 py-1.5 font-semibold rounded-[100px] border transition-all @(isSelected ? "border-primary bg-primary text-white" : "text-light-primary-text border-gray-300 hover:bg-[rgba(145,158,171,0.08)]")"
                            >
                              @if (!string.IsNullOrWhiteSpace(val.ImageUrl))
                              {
                                <img src="@val.ImageUrl" alt="@val.Value" class="size-5 rounded-full object-cover" />
                              }
                              <span>@val.Value</span>
                            </button>
                          </div>
                        }
                      }
                    </div>
                  </div>
                }
                else if (colorOptions.Count > 0)
                {
                  <div class="color-variation-section mb-6">
                    <div class="color-variation-section-title mb-4">
                      <p class="font-semibold text-light-primary-text flex items-center gap-x-2.5">
                        Màu sắc:
                        <span class="text-light-primary-text font-normal capitalize color-variation-selected-color">@selectedColor</span>
                      </p>
                    </div>

                    @if (colorOptions.Count > 1)
                    {
                      <div class="color-variation-items flex items-center gap-x-2">
                        @for (var i = 0; i < colorOptions.Count; i++)
                        {
                          var c = colorOptions[i];
                          var isSelected = c.ColorId == selectedColorId;

                          <div class="variation-color-item p-1 border rounded-full @(isSelected ? "border-primary" : "border-gray-300")">
                            <button
                              type="button"
                              data-color-id="@c.ColorId"
                              data-color-text="@c.Name"
                              class="size-6 rounded-full flex items-center justify-center cursor-pointer"
                              style="background-color: @c.Hex"
                              title="@c.Name"
                            >
                              <i class="hgi hgi-stroke hgi-tick-02 text-white @(isSelected ? "" : "hidden")" aria-hidden="true"></i>
                            </button>
                          </div>
                        }
                      </div>
                    }
                  </div>
                }

                @if (tier2Group != null && tier2Group.Values.Count > 0)
                {
                  <div class="size-variation-section mb-6">
                    <div class="size-variation-section-title mb-4 flex items-center justify-between">
                      <p class="font-semibold text-light-primary-text flex items-center gap-x-2.5">
                        @tier2Group.Name:
                        <span class="text-light-primary-text font-normal capitalize size-variation-selected-size">@(selectedVariant?.Option2Value ?? selectedSize)</span>
                      </p>
                      @if (Model.HasSizeGuide)
                      {
                        <a href="#" class="text-sm leading-[22px] hover:underline variation-size-guide-btn">Bảng size</a>
                      }
                    </div>
                    <div class="size-variation-items flex items-center gap-2 flex-wrap">
                      @for (var i = 0; i < tier2Group.Values.Count; i++)
                      {
                        var val = tier2Group.Values[i];
                        var isSelected = (selectedVariant?.SizeId ?? selectedSizeId) == val.Id;

                        <div class="size-variation-item">
                          <button
                            type="button"
                            data-size-id="@val.Id"
                            data-size-text="@val.Value"
                            data-opt-img="@val.ImageUrl"
                            class="cursor-pointer flex items-center justify-center text-sm leading-6 px-[26px] py-1.5 font-semibold rounded-[100px] hover:bg-[rgba(145,158,171,0.08)] @(isSelected ? "border border-primary bg-primary text-white hover:bg-primary" : "text-light-primary-text border border-gray-300")"
                          >
                            @val.Value
                          </button>
                        </div>
                      }
                    </div>
                  </div>
                }
                else if (sizeOptions.Count > 0)
                {
                  <div class="size-variation-section mb-6">
                    <div
                      class="size-variation-section-title mb-4 flex items-center justify-between"
                    >
                      <p
                        class="font-semibold text-light-primary-text flex items-center gap-x-2.5"
                      >
                        Kích cỡ:
                        <span
                          class="text-light-primary-text font-normal capitalize size-variation-selected-size"
                          >@selectedSize</span>
                      </p>
                      @if (Model.HasSizeGuide)
                      {
                        <a
                          href="#"
                          class="text-sm leading-[22px] hover:underline variation-size-guide-btn"
                          >Bảng size</a>
                      }
                    </div>
                    <div
                      class="size-variation-items flex items-center gap-2 2xl:flex-nowrap flex-wrap"
                    >
                      @for (var i = 0; i < sizeOptions.Count; i++)
                      {
                        var s = sizeOptions[i];
                        var isSelected = s.SizeId == selectedSizeId;

                        <div class="size-variation-item">
                          <button
                            type="button"
                            data-size-id="@s.SizeId"
                            data-size-text="@s.Name"
                            class="cursor-pointer flex items-center justify-center text-sm leading-6 px-[38px] py-1.5 font-semibold rounded-[100px] hover:bg-[rgba(145,158,171,0.08)] @(isSelected ? "border border-primary bg-primary text-white hover:bg-primary" : "text-light-primary-text border border-gray-300")"
                          >
                            @s.Name
                          </button>
                        </div>
                      }
                    </div>
                  </div>
                }
                <div class="product-add-to-cart-btn-section">
                  <p class="font-semibold text-light-primary-text mb-4">Số lượng:</p>
                  <div
                    class="flex items-center justify-between gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0"
                  >
                    <div
                      class="quantity-section flex-1 max-w-[185px] border border-gray-300 rounded-[80px] px-4 py-[11px] flex items-center justify-between"
                    >
                      <button
                        type="button"
                        data-qty-action="dec"
                        class="quantity-btn inline-flex items-center justify-center hover:text-primary"
                      >
                        <i
                          class="hgi hgi-stroke hgi-minus-sign text-xl leading-5"
                        ></i>
                      </button>
                      <input
                        type="number"
                        min="1"
                        step="1"
                        class="quantity-input text-center w-full focus:outline-none font-semibold text-base leading-6 text-light-primary-text"
                        value="1"
                      />
                      <button
                        type="button"
                        data-qty-action="inc"
                        class="quantity-btn inline-flex items-center justify-center hover:text-primary"
                      >
                        <i
                          class="hgi hgi-stroke hgi-plus-sign text-xl leading-5"
                        ></i>
                      </button>
                    </div>

                    <button
                      type="button"
                      data-buy-now
                      data-variant-id="@selectedVariant?.VariantId"
                      class="btn btn-warning btn-large rounded-[80px] flex-1"
                    >
                      Mua ngay
                    </button>
                    <button
                      type="button"
                      data-add-to-cart
                      data-variant-id="@selectedVariant?.VariantId"
                      class="btn btn-primary btn-large rounded-[80px] flex-1"
                    >
                      <i
                        class="hgi hgi-stroke hgi-shopping-cart-add-02 leading-6 text-2xl text-white"
                      ></i>
                      Thêm vào giỏ
                    </button>
                  </div>
                </div>
              </div>
              <div
                class="product-share-and-compare-section flex items-center gap-x-4 mt-6"
              >
                <a
                  href="#"
                  class="product-share-btn text-info inline-flex items-center gap-x-2.5 pr-4 relative after:absolute after:top-1/2 after:-translate-y-1/2 after:right-0 after:w-px after:h-3 after:bg-gray-300"
                >
                  <i class="hgi hgi-stroke hgi-share-05 text-xl leading-5"></i>
                  <span>Chia sẻ</span>
                </a>
                <a class='product-compare-btn text-info inline-flex items-center gap-x-2.5 pr-4 relative after:absolute after:top-1/2 after:-translate-y-1/2 after:right-0 after:w-px after:h-3 after:bg-gray-300' 
                   href="javascript:void(0)" onclick="addToCompare(@Model.ProductId)">
                  <i
                    class="hgi hgi-stroke hgi-git-compare text-xl leading-5"
                  ></i>
                  <span>So sánh</span>
                </a>
                @if (Model.ShopId > 0)
                {
                    <button type="button" onclick="openChatWithShop(@Model.ProductId, @Model.ShopId)" class="text-info inline-flex items-center gap-x-2.5 hover:text-primary transition-colors cursor-pointer bg-transparent border-none p-0">
                        <i class="hgi hgi-stroke hgi-chatting-01 text-xl leading-5"></i>
                        <span class="font-medium">Nhắn với shop</span>
                    </button>
                }
              </div>
              <div
                class="product-extra-info-section flex flex-col gap-y-4 mt-6"
              >
                <div
                  class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0"
                >
                  <p class="font-semibold text-light-primary-text">Vận chuyển:</p>
                  <p>Dự kiến giao 5–7 ngày</p>
                </div>
                <div
                  class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0"
                >
                  <p class="font-semibold text-light-primary-text">Tồn kho:</p>
                  <p id="js-stock">@Model.StockQuantity.ToString("N0", viVn)</p>
                </div>
                <div
                  class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0"
                >
                  <p class="font-semibold text-light-primary-text">
                    Danh mục:
                  </p>
                  <p>
                    @if (!string.IsNullOrWhiteSpace(Model.PrimaryCategoryName))
                    {
                      @Model.PrimaryCategoryName
                    }
                    else
                    {
                      @:-(
                    }
                  </p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.BrandName))
                {
                  <div class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0">
                    <p class="font-semibold text-light-primary-text">Thương hiệu:</p>
                    <p class="font-semibold text-primary">@Model.BrandName</p>
                  </div>
                }
                <div class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0">
                  <p class="font-semibold text-light-primary-text">Bảo hành:</p>
                  <p>
                    @if (Model.WarrantyMonths > 0)
                    {
                      <span class="text-success font-medium">@Model.WarrantyMonths tháng @(string.IsNullOrWhiteSpace(Model.WarrantyType) ? "" : $"({Model.WarrantyType})")</span>
                    }
                    else
                    {
                      <span class="text-light-secondary-text">Không áp dụng bảo hành</span>
                    }
                  </p>
                </div>
                <div class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0">
                  <p class="font-semibold text-light-primary-text">Đổi trả:</p>
                  <p>
                    @if (Model.IsReturnable)
                    {
                      <span class="text-success font-medium">Hỗ trợ đổi trả nếu lỗi / không đúng mô tả</span>
                    }
                    else
                    {
                      <span class="text-error font-semibold">Sản phẩm không hỗ trợ đổi trả</span>
                    }
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        @if (Model.Shop is not null && !string.IsNullOrWhiteSpace(Model.Shop.Slug))
        {
          var shopUrl = Url.RouteUrl("shop_details", new { slug = Model.Shop.Slug }) ?? "#";
          var shopLogoUrl = global::DOAN_BANHANG.Helpers.ImageUrlHelper.NormalizeStaticFileUrl(Model.Shop.LogoUrl)
            ?? Url.Content("~/assets/images/vendors-list/vendor-profile.png");

          <div class="mt-5 lg:mt-6 border border-gray-300 rounded-2xl p-5 bg-white">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-6">
              <a href="@shopUrl" class="flex items-center gap-3 min-w-0 md:flex-1">
                <div class="size-12 rounded-full overflow-hidden border border-gray-300 bg-gray-100 flex items-center justify-center flex-none">
                  <img src="@shopLogoUrl" alt="@Model.Shop.Name" class="w-full h-full object-cover" />
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <p class="font-semibold text-light-primary-text truncate">@Model.Shop.Name</p>
                    @if (Model.Shop.IsMall)
                    {
                      <span style="background: #dc2626; color: #ffffff; font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 999px; letter-spacing: 0.04em;">MALL</span>
                    }
                  </div>
                  <div class="text-sm text-light-secondary-text">
                    @if (!string.IsNullOrWhiteSpace(Model.Shop.Location))
                    {
                      <span class="inline-flex items-center gap-1 min-w-0">
                        <i class="hgi hgi-stroke hgi-location-01 text-base"></i>
                        <span class="truncate">@Model.Shop.Location</span>
                      </span>
                    }
                    else
                    {
                      <span class="text-light-secondary-text">Đối tác chính thức</span>
                    }
                  </div>
                </div>
              </a>

              <div class="flex items-center justify-start md:justify-center gap-6 flex-wrap md:flex-nowrap md:flex-1">
                <div class="text-center min-w-[82px]">
                  <p class="text-sm text-light-secondary-text whitespace-nowrap">Đánh giá</p>
                  <p class="font-semibold text-light-primary-text whitespace-nowrap">@Model.Shop.RatingAverage.ToString("0.0", viVn)</p>
                </div>
                <div class="text-center min-w-[82px]">
                  <p class="text-sm text-light-secondary-text whitespace-nowrap">Sản phẩm</p>
                  <p class="font-semibold text-light-primary-text whitespace-nowrap">@Model.Shop.ProductCount.ToString("N0", viVn)</p>
                </div>
                <div class="text-center min-w-[96px]">
                  <p class="text-sm text-light-secondary-text whitespace-nowrap">Người theo dõi</p>
                  <p class="font-semibold text-light-primary-text whitespace-nowrap" id="js-pd-follower-count">@Model.Shop.FollowerCount.ToString("N0", viVn)</p>
                </div>
              </div>

              <div class="flex items-center gap-2.5 w-full md:w-auto flex-none">
                <button type="button"
                        id="js-pd-follow-btn"
                        onclick="toggleFollowShopOnProduct(@Model.Shop.ShopId, this)"
                        class="rounded-full font-semibold text-sm leading-6 px-4 py-2 flex-1 md:flex-none whitespace-nowrap cursor-pointer transition-all"
                        style="@(Model.Shop.IsFollowing ? "background:#e6f4f3; color:#008374; border:1px solid #008374;" : "background:#008374; color:#ffffff; border:1px solid #008374;")">
                  @(Model.Shop.IsFollowing ? "✓ Đang theo dõi" : "+ Theo dõi")
                </button>
                <a href="@shopUrl" class="btn btn-outline rounded-full font-semibold text-sm leading-6 px-5 py-2 flex-1 md:flex-none whitespace-nowrap">
                  Xem shop
                </a>
              </div>
            </div>
          </div>
        }

        @if (Model.BundleProducts != null && Model.BundleProducts.Count > 0)
        {
          var topShopVoucher = Model.AvailableVouchers?.OrderByDescending(x => x.IsShopVoucher).ThenBy(x => x.MinOrderValue).FirstOrDefault();
          <div class="mt-6 border-2 border-emerald-200 rounded-2xl p-5 bg-gradient-to-r from-emerald-50/60 via-white to-teal-50/40"
               id="js-bundle-deal-card"
               data-voucher-min="@(topShopVoucher?.MinOrderValue.ToString("0", global::System.Globalization.CultureInfo.InvariantCulture) ?? "0")"
               data-voucher-code="@(topShopVoucher?.Code ?? "")">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
              <div>
                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-red-100 text-red-700 mb-1">
                  🔥 MUA KÈM DEAL SỐC • GỢI Ý COMBO TỪ GIAN HÀNG
                </div>
                <h5 class="font-bold text-light-primary-text text-base">Thường được mua cùng để tối ưu phí vận chuyển &amp; mở khóa Voucher Shop</h5>
              </div>
              @if (topShopVoucher != null && topShopVoucher.MinOrderValue > 0)
              {
                <div class="text-xs font-semibold px-3 py-1.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900" id="js-bundle-voucher-hint">
                  🎟️ Gom đơn đạt <strong>@topShopVoucher.MinOrderValue.ToString("N0", viVn)₫</strong> để dùng mã <strong>@topShopVoucher.Code</strong>
                </div>
              }
            </div>

            <div class="grid grid-cols-12 gap-4 items-center">
              <div class="col-span-12 lg:col-span-9">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  @foreach (var bp in Model.BundleProducts)
                  {
                    var bpImg = !string.IsNullOrWhiteSpace(bp.PrimaryImageUrl) ? bp.PrimaryImageUrl : "assets/images/vitamin-c.png";
                    var bpUrl = Url.RouteUrl("product_details", new { slug = bp.Slug }) ?? "#";
                    <label class="flex items-center gap-3 p-3 rounded-xl border border-gray-200 bg-white hover:border-primary transition-all cursor-pointer">
                      <input type="checkbox"
                             class="js-bundle-item-chk size-4 accent-emerald-600 rounded cursor-pointer"
                             checked
                             data-variant-id="@bp.DefaultVariantId"
                             data-price="@bp.Price.ToString("0", global::System.Globalization.CultureInfo.InvariantCulture)" />
                      <img src="@bpImg" alt="@bp.Name" class="size-14 rounded-lg object-cover border border-gray-100 shrink-0" />
                      <div class="min-w-0 flex-1">
                        <a href="@bpUrl" class="text-xs font-bold text-light-primary-text hover:text-primary line-clamp-2">@bp.Name</a>
                        <div class="text-sm font-extrabold text-primary mt-1">@bp.Price.ToString("N0", viVn)₫</div>
                      </div>
                    </label>
                  }
                </div>
              </div>

              <div class="col-span-12 lg:col-span-3">
                <div class="p-4 rounded-2xl bg-white border border-emerald-200 text-center shadow-xs">
                  <div class="text-xs text-light-secondary-text">Tổng giá trị Combo (<span id="js-bundle-count">@(Model.BundleProducts.Count + 1)</span> SP)</div>
                  <div class="text-xl font-extrabold text-primary my-1" id="js-bundle-total-price">0 VNĐ</div>
                  <button type="button"
                          id="js-add-bundle-btn"
                          onclick="addBundleToCart()"
                          class="btn btn-primary rounded-full w-full py-2.5 text-xs font-bold text-white mt-2 cursor-pointer">
                    🛒 Thêm cả Combo vào giỏ
                  </button>
                </div>
              </div>
            </div>
          </div>
        }
      </div>
    </section>
    <!-- ========== Product Details Section End ========== -->

    <!-- ========== Size Guide Modal Start ========== -->
    <div
      data-state="close"
      class="size-variation-modal max-w-[950px] w-full overflow-y-auto h-full lg:h-auto fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white rounded-2xl z-99 data-[state=close]:invisible data-[state=close]:opacity-0 data-[state=open]:visible data-[state=open]:opacity-100 transition-all duration-250"
    >
      <div class="size-variation-modal-content">
        <h5 class="size-variation-modal-title py-[15px] px-6 border-b border-gray-300 relative">
          Bảng size
          <button
            type="button"
            data-close-sidebar=".size-variation-modal"
            class="absolute top-1/2 -translate-y-1/2 right-6 close-sidebar-btn"
          >
            <i class="hgi hgi-stroke hgi-multiplication-sign text-xl"></i>
          </button>
        </h5>
        <div class="size-variation-modal-content-inner p-[34px]">
          <div class="height-range-slider-section mb-6 flex items-center gap-x-10">
            <div class="flex items-center gap-x-6">
              <span>Chiều cao:</span>
              <p class="py-2.5 px-3.5 border border-gray-300 rounded-[80px] font-semibold text-light-primary-text min-w-21">
                <span class="height-range-slider-value">130</span><span>cm</span>
              </p>
            </div>
            <div class="flex-1" id="height-range-slider"></div>
          </div>

          <div class="weight-range-slider-section mb-6 flex items-center gap-x-10">
            <div class="flex items-center gap-x-6">
              <span>Cân nặng:</span>
              <p class="py-2.5 px-3.5 border border-gray-300 rounded-[80px] font-semibold text-light-primary-text min-w-21">
                <span class="weight-range-slider-value">135</span><span>kg</span>
              </p>
            </div>
            <div class="flex-1" id="weight-range-slider"></div>
          </div>

          <div class="suggestion-section mb-4">
            <h6 class="mb-2">Gợi ý cho bạn:</h6>
            <div id="js-size-suggestion-output" class="suggestion-items flex items-center gap-x-2">
              <span class="text-light-secondary-text text-sm italic">Sử dụng thanh trượt phía trên để nhận gợi ý size phù hợp</span>
            </div>
          </div>

          <div class="size-table-section p-6 border border-gray-300 rounded-2xl">
            <div class="size-table w-full overflow-x-auto">
              <table class="w-full">
                <thead>
                  @{
                    var guidesM = Model.SizeGuides ?? new List<ProductSizeGuideVm>();
                    var hasShoulderM = guidesM.Any(g => g.ShoulderWidthCm.HasValue);
                    var hasBustM = guidesM.Any(g => g.BustCm.HasValue);
                    var hasWaistM = guidesM.Any(g => g.WaistCm.HasValue);
                    var hasHipM = guidesM.Any(g => g.HipCm.HasValue);
                    var hasLenM = guidesM.Any(g => g.LengthCm.HasValue);
                    var hasWidM = guidesM.Any(g => g.WidthCm.HasValue);
                    var hasHeiM = guidesM.Any(g => g.HeightCm.HasValue);
                    var hasShoeM = guidesM.Any(g => g.ShoeLengthCm.HasValue);
                    var hasPersonHeightM = guidesM.Any(g => !string.IsNullOrEmpty(g.HeightRange));
                    var hasPersonWeightM = guidesM.Any(g => !string.IsNullOrEmpty(g.WeightRange));
                  }
                  <tr class="border-b border-gray-300">
                    <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Size</th>
                    @if (hasShoulderM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Vai</th> }
                    @if (hasBustM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Ngực</th> }
                    @if (hasWaistM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Eo</th> }
                    @if (hasHipM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Mông</th> }
                    @if (hasLenM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Dài</th> }
                    @if (hasWidM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Rộng</th> }
                    @if (hasHeiM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Cao</th> }
                    @if (hasShoeM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Dài chân</th> }
                    @if (hasPersonHeightM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">C.Cao người</th> }
                    @if (hasPersonWeightM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">C.Nặng người</th> }
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-300">
                  @if (guidesM.Count == 0)
                  {
                    <tr><td colspan="12" class="py-10 text-center text-light-secondary-text">Chưa có thông số chi tiết</td></tr>
                  }
                  else
                  {
                    foreach(var g in guidesM)
                    {
                      <tr>
                        <td class="text-left py-3 px-4 font-semibold text-light-primary-text">@g.SizeLabel</td>
                        @if (hasShoulderM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.ShoulderWidthCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasBustM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.BustCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasWaistM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.WaistCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasHipM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.HipCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasLenM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.LengthCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasWidM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.WidthCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasHeiM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.HeightCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasShoeM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.ShoeLengthCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasPersonHeightM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.HeightRange ?? "-")</td> }
                        @if (hasPersonWeightM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.WeightRange ?? "-")</td> }
                      </tr>
                    }
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- ========== Size Guide Modal End ========== -->

    <!-- ========== CTA Info Section Start ========== -->
    <section class="py-12">
      <div class="container">
        <div class="grid grid-cols-12 gap-6">
          <div class="md:col-span-6 col-span-12 xl:col-span-3">
            <div
              class="p-6 border-gray-300 border rounded-2xl text-center wow animate__animated animate__fadeInUp"
              data-wow-delay=".2s"
            >
              <span
                class="inline-flex items-center justify-center size-14 bg-warning-lighter rounded-full"
              >
                <i
                  class="hgi hgi-stroke hgi-container-truck text-3xl text-light-primary-text"
                ></i>
              </span>
              <h5 class="pt-3 pb-0.5">Miễn phí vận chuyển</h5>
              <p>Tận hưởng ưu đãi miễn phí vận chuyển cho mọi đơn hàng</p>
