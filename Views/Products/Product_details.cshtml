                        @if (hasWaistM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.WaistCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasHipM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.HipCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasLenM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.LengthCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasWidM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.WidthCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasHeiM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.HeightCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasShoeM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.ShoeLengthCm?.ToString("0.#") ?? "-")</td> }
                        @if (hasPersonHeightM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.HeightRange ?? "-")</td> }
                        @if (hasPersonWeightM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.WeightRange ?? "-")</td> }
                      </tr>
                    }
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- ========== Size Guide Modal End ========== -->

