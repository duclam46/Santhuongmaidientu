                  </div>
                </div>
              </div>
              <div class="comment-list-wrapper p-6">
                @{
                  var reviewsWithPhotoCount = reviews.Count(r => r.MediaUrls != null && r.MediaUrls.Count > 0);
                }
                <div class="comment-list-title flex flex-col gap-4 pb-6 border-b border-gray-300 mb-6">
                  <div class="flex items-center justify-between flex-wrap gap-3">
                    <h5>Đánh giá của khách hàng</h5>
                    <div class="relative min-w-[100px]">
                      <select id="sorting" class="rounded-[100px]! filter-select label">
                        <option value="newest" selected>Mới nhất</option>
                        <option value="oldest">Cũ nhất</option>
                        <option value="rating">Điểm cao</option>
                      </select>
                      <label for="sorting" class="nice-select-label">Sắp xếp</label>
                    </div>
                  </div>
                  @if (reviews.Count > 0)
                  {
                    <div class="flex flex-wrap items-center gap-2">
                      <button type="button" class="js-review-filter-pill text-xs font-bold px-3.5 py-1.5 rounded-full cursor-pointer transition-all"
                              style="background:#008374; color:#ffffff; border:1px solid #008374;"
                              onclick="filterSellzyReviews('all', this)">
                        Tất cả (@reviewsTotal)
                      </button>
                      <button type="button" class="js-review-filter-pill text-xs font-bold px-3.5 py-1.5 rounded-full cursor-pointer transition-all"
                              style="background:#ffffff; color:#334155; border:1px solid #cbd5e1;"
                              onclick="filterSellzyReviews('photo', this)">
                        📷 Có hình ảnh (@reviewsWithPhotoCount)
                      </button>
                      @for (int star = 5; star >= 1; star--)
                      {
                        <button type="button" class="js-review-filter-pill text-xs font-bold px-3.5 py-1.5 rounded-full cursor-pointer transition-all"
                                style="background:#ffffff; color:#334155; border:1px solid #cbd5e1;"
                                onclick="filterSellzyReviews('@star', this)">
                          @star Sao (@ratingCounts[star])
                        </button>
                      }
                    </div>
                  }
                </div>
                <ol class="comment-list">
                  @if (reviews.Count == 0)
                  {
                    <li class="comment">
                      <div class="comment-body">
                        <p class="text-light-secondary-text">Chưa có đánh giá cho sản phẩm này.</p>
                      </div>
                    </li>
                  }
                  else
                  {
                    <li id="js-review-filter-empty" style="display:none; padding: 24px 0; text-align:center; color:#64748b; font-size:14px;">
                      Không có đánh giá nào khớp với bộ lọc đã chọn.
                    </li>
                    foreach (var review in reviews)
                    {
                      var reviewPct = (int)System.Math.Round(System.Math.Clamp((double)(review.Rating / 5m * 100m), 0d, 100d));
                      var avatar = !string.IsNullOrWhiteSpace(review.AvatarUrl) ? review.AvatarUrl : Url.Content("~/assets/images/blog/user-avatar-1.png");
                      var hasPhotos = review.MediaUrls != null && review.MediaUrls.Count > 0;
                      <li class="comment js-review-item" data-rating="@review.Rating" data-has-photos="@(hasPhotos ? "1" : "0")">
                        <div class="comment-body">
                          <div class="comment-avatar-card flex items-center gap-x-4 mb-3">
                            <div class="comment-author-avatar size-12 rounded-full overflow-hidden">
                              <img src="@avatar" alt="Comment Author Avatar" class="rounded-full w-full h-full object-cover" />
                            </div>
                            <div class="comment-author-info flex-1">
                              <p class="comment-author font-semibold text-light-primary-text">@review.AuthorName</p>
                              <div class="flex flex-wrap items-center gap-2 mt-0.5">
                                <span class="text-xs leading-[18px] text-light-secondary-text">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm", viVn)</span>
                                @if (!string.IsNullOrWhiteSpace(review.VariantName))
                                {
                                  <span style="font-size: 11px; font-weight: 600; color: #0f766e; background: #f0fdfa; border: 1px solid #99f6e4; padding: 1px 8px; border-radius: 999px;">
                                    Phân loại: @review.VariantName
                                  </span>
                                }
                              </div>
                            </div>
                          </div>

                          <div class="flex items-center mb-3">
                            <div class="rating-section flex items-center relative after:absolute after:h-[22px] after:w-px after:right-0 after:top-1/2 after:-translate-y-1/2 after:bg-gray-300 pr-3">
                              <div class="bg-[url('../images/star-icon.png')] w-[90px] h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]">
                                <div style="width: @reviewPct%" class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"></div>
                              </div>
                              <span class="text-sm leading-[22px] font-normal inline-flex ml-2 text-light-primary-text">@review.Rating.ToString(viVn)</span>
                            </div>
                            <span style="font-size: 11.5px; color: #059669; font-weight: 600; margin-left: 10px;">✓ Đã mua hàng tại Sellzy</span>
                          </div>

                          @if (!string.IsNullOrWhiteSpace(review.Comment))
                          {
                            <div class="comment-content pl-0! pr-0! mb-3">
                              <p class="text-light-primary-text whitespace-pre-line">@review.Comment</p>
                            </div>
                          }

                          @if (hasPhotos)
                          {
                            <div class="flex flex-wrap items-center gap-2.5 mb-3">
                              @foreach (var photoUrl in review.MediaUrls!)
                              {
                                var resolvedPhoto = global::DOAN_BANHANG.Helpers.ImageUrlHelper.NormalizeStaticFileUrl(photoUrl) ?? photoUrl;
                                <button type="button"
                                        onclick="openReviewPhotoLightbox('@resolvedPhoto')"
                                        style="width: 78px; height: 78px; border-radius: 12px; overflow: hidden; border: 1px solid #cbd5e1; padding: 0; background: #f8fafc; cursor: zoom-in;">
                                  <img src="@resolvedPhoto" alt="Ảnh đánh giá thực tế" style="width: 100%; height: 100%; object-fit: cover;" />
                                </button>
                              }
                            </div>
                          }

                          @if (!string.IsNullOrWhiteSpace(review.SellerReply))
                          {
                            <div class="mt-3 p-3.5 rounded-2xl border" style="background: #f4fbfa; border-color: #cce3df;">
                              <div class="flex items-center justify-between gap-2 mb-1">
                                <span class="text-xs font-bold" style="color: #088178;">
                                  <i class="hgi hgi-stroke hgi-store-01 mr-1"></i>Phản hồi từ @(string.IsNullOrWhiteSpace(review.ShopName) ? "Gian hàng" : review.ShopName)
                                </span>
                                @if (review.RepliedAt.HasValue)
                                {
                                  <span class="text-xs text-light-secondary-text">@review.RepliedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm", viVn)</span>
                                }
                              </div>
                              <p class="text-sm text-light-primary-text whitespace-pre-line mb-0">@review.SellerReply</p>
                            </div>
                          }
                        </div>
                      </li>
                    }
                  }
                </ol>
                <div class="comment-pagination-wrapper mt-6">
                  <ul
                    class="flex items-center justify-center gap-x-1.5 comment-pagination"
                  >
                    <li class="group comment-pagination-item">
                      <a
                        href="#"
                        class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] bg-white cursor-pointer border border-gray-300 group-hover:font-semibold group-hover:border-primary group-hover:bg-[rgba(0,171,85,0.08)] transition-colors duration-300 ease-in-out"
                      >
                        <span class="inline-flex items-center justify-center">
                          <i
                            class="hgi hgi-stroke hgi-arrow-left-01 text-[20px] group-hover:font-semibold leading-5 text-light-primary-text group-hover:text-primary"
                          ></i
                        ></span>
                      </a>
                    </li>
                    <li class="group comment-pagination-item">
                      <a
                        href="#"
                        class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] active"
                      >
                        1
                      </a>
                    </li>
                    <li class="group blog-pagination-item">
                      <a
                        href="#"
                        class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] text-base leading-6 text-light-primary-text group-hover:text-primary group-hover:font-semibold bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-[rgba(0,171,85,0.08)] transition-colors duration-300 ease-in-out"
                      >
                        2
                      </a>
                    </li>
                    <li class="group comment-pagination-item">
                      <a
                        href="#"
                        class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] text-base leading-6 text-light-primary-text group-hover:text-primary group-hover:font-semibold bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-[rgba(0,171,85,0.08)] transition-colors duration-300 ease-in-out"
                      >
                        3
                      </a>
                    </li>
                    <li class="group blog-pagination-item">
                      <a
                        href="#"
                        class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] text-base leading-6 text-light-primary-text group-hover:text-primary group-hover:font-semibold bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-[rgba(0,171,85,0.08)] transition-colors duration-300 ease-in-out"
                      >
                        4
                      </a>
                    </li>
                    <li class="group comment-pagination-item">
                      <a
                        href="#"
                        class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] text-base leading-6 text-light-primary-text group-hover:text-primary group-hover:font-semibold bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-[rgba(0,171,85,0.08)] transition-colors duration-300 ease-in-out"
                      >
                        5
                      </a>
                    </li>
                    <li class="comment-pagination-item">
                      <a
                        href="#"
                        class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] bg-white"
                      >
                        <span class="inline-flex items-center justify-center">
                          <i
                            class="hgi hgi-stroke hgi-more-horizontal text-[20px] leading-5 text-light-primary-text"
                          ></i
                        ></span>
                      </a>
                    </li>
                    <li class="group comment-pagination-item">
                      <a
                        href="#"
                        class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] group-hover:font-semibold bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-[rgba(0,171,85,0.08)] transition-colors duration-300 ease-in-out"
                      >
                        <span class="inline-flex items-center justify-center">
                          <i
                            class="hgi hgi-stroke hgi-arrow-right-01 text-[20px] leading-5 group-hover:font-semibold text-light-primary-text group-hover:text-primary"
