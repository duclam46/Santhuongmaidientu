                          @if (hasPersonHeight) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.HeightRange ?? "-")</td> }
                          @if (hasPersonWeight) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.WeightRange ?? "-")</td> }
