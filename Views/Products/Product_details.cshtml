@model DOAN_BANHANG.ViewModels.ProductDetailsVm

@{
  var viVn = global::System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
  var ratingPct = (int)System.Math.Round(System.Math.Clamp((double)(Model.AverageRating / 5m * 100m), 0d, 100d));

  var images = (Model.Images ?? new List<DOAN_BANHANG.ViewModels.ProductDetailsImageVm>())
    .OrderByDescending(i => i.IsPrimary)
    .ThenBy(i => i.SortOrder)
    .ThenBy(i => i.Url)
    .ToList();

  if (images.Count == 0)
  {
    images.Add(new DOAN_BANHANG.ViewModels.ProductDetailsImageVm
    {
      Url = "assets/images/vitamin-c.png",
      Alt = Model.Name,
      IsPrimary = true,
      SortOrder = 0
    });
  }

  var descImage1 = images.ElementAtOrDefault(0)?.Url;
  var descImage2 = images.ElementAtOrDefault(1)?.Url ?? descImage1;

  var sizeGuides = (Model.SizeGuides ?? new List<DOAN_BANHANG.ViewModels.ProductSizeGuideVm>()).ToList();
  var reviews = (Model.Reviews ?? new List<DOAN_BANHANG.ViewModels.ProductReviewVm>()).ToList();
  var reviewsTotal = reviews.Count;
  var ratingCounts = new int[6];
  foreach (var r in reviews)
  {
    if (r.Rating >= 1 && r.Rating <= 5) ratingCounts[r.Rating]++;
  }

  // Treat "new arrival" as created in last 30 days.
  var isNewArrival = Model.CreatedAt >= DateTime.UtcNow.AddDays(-30);

  var variants = (Model.Variants ?? new List<DOAN_BANHANG.ViewModels.ProductVariantVm>()).ToList();

  var selectedVariant = variants
    .FirstOrDefault(v => Model.SelectedVariantId.HasValue && v.VariantId == Model.SelectedVariantId.Value)
    ?? variants
      .OrderBy(v => v.VariantId)
      .FirstOrDefault();

  var colorOptions = variants
    .Where(v => v.ColorId.HasValue && !string.IsNullOrWhiteSpace(v.Color))
    .GroupBy(v => v.ColorId!.Value)
    .Select(g => new
    {
      ColorId = g.Key,
      Name = g.Select(x => x.Color).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? "(N/A)",
      Hex = g.Select(x => x.ColorHex).FirstOrDefault(h => !string.IsNullOrWhiteSpace(h)) ?? "#dfe3e8",
    })
    .OrderBy(x => x.Name)
    .ToList();

  var selectedColorId = selectedVariant?.ColorId ?? (colorOptions.Count > 0 ? colorOptions[0].ColorId : (int?)null);
  var selectedColor = selectedVariant?.Color ?? (colorOptions.Count > 0 ? colorOptions[0].Name : string.Empty);

  var sizeOrder = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
  {
    ["XS"] = 0,
    ["S"] = 1,
    ["M"] = 2,
    ["L"] = 3,
    ["XL"] = 4,
    ["XXL"] = 5,
    ["XXXL"] = 6
  };

  var sizeOptions = variants
    .Where(v => v.SizeId.HasValue && !string.IsNullOrWhiteSpace(v.SizeLabel))
    .GroupBy(v => v.SizeId!.Value)
    .Select(g => new
    {
      SizeId = g.Key,
      Name = g.Select(x => x.SizeLabel).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? "(N/A)",
    })
    .OrderBy(x => sizeOrder.TryGetValue(x.Name, out var ord) ? ord : 999)
    .ThenBy(x => x.Name)
    .ToList();

  var selectedSizeId = selectedVariant?.SizeId ?? (sizeOptions.Count > 0 ? sizeOptions[0].SizeId : (int?)null);
  var selectedSize = selectedVariant?.SizeLabel ?? (sizeOptions.Count > 0 ? sizeOptions[0].Name : "One Size");

  var isOnSale = selectedVariant?.IsOnSale == true;
  var saleSecondsLeft = selectedVariant?.SaleSecondsLeft;

  var displayBasePrice = selectedVariant?.BasePrice ?? Model.Price;
  var displayPrice = selectedVariant?.Price ?? Model.Price;
  var isSaleDisplay = isOnSale && displayBasePrice > displayPrice;
  var displayDiscountPercent = isSaleDisplay && displayBasePrice > 0
    ? (int)System.Math.Round(System.Math.Clamp((double)((displayBasePrice - displayPrice) / displayBasePrice * 100m), 0d, 100d))
    : 0;

  var displayStockLeft = selectedVariant?.StockQuantity ?? Model.StockQuantity;
  var maxVariantStock = variants.Count > 0 ? variants.Max(v => v.StockQuantity) : displayStockLeft;
  var displayStockPct = maxVariantStock > 0
    ? (int)System.Math.Round(System.Math.Clamp(displayStockLeft * 100d / maxVariantStock, 0d, 100d))
    : 0;
}

    <!-- ========== Breadcrumb Section Start ========== -->
    <div class="py-12">
      <div class="container">
        <div class="breadcrumb">
          <ul>
            <li>
              <a href='@Url.Action("Index", "Home")'>
                <span>
                  <i class="hgi hgi-stroke hgi-home-01 text-[20px]"></i>
                </span>
                Trang chủ
              </a>
            </li>
            <li class="text-light-disabled-text">&#8226;</li>
            <li><span>Chi tiết sản phẩm</span></li>
          </ul>
        </div>
      </div>
    </div>
    <!-- ========== Breadcrumb Section End ========== -->

    <!-- ========== Product Details Section Start ========== -->
    <section>
      <div class="container">
        <div class="lg:grid lg:grid-cols-12 lg:gap-12">
          <div class="xl:col-span-7 lg:col-span-6">
            <div
              class="flex gap-x-6 xl:flex-row flex-col gap-y-6 xl:gap-y-0 xl:gap-x-6"
            >
              <div
                class="xl:w-[114px] lg:w-full order-2 xl:order-1 flex-none overflow-hidden"
              >
                <div
                  class="product-details-small-slider -m-2.5 sellzy-slider"
                  data-slick='{"slidesToShow": 6, "slidesToScroll": 1, "arrows": false, "infinite": true, "loop": true, "vertical": true, "verticalSwiping": true, "asNavFor": ".product-details-big-slider", "focusOnSelect": true, "responsive": [{"breakpoint": 1025, "settings": {"slidesToShow": 4, "vertical": false, "verticalSwiping": false}}, {"breakpoint": 769, "settings": {"slidesToShow": 3, "vertical": false, "verticalSwiping": false}}, {"breakpoint": 480, "settings": {"slidesToShow": 2, "vertical": false, "verticalSwiping": false}}]}'
                >
                  @foreach (var img in images)
                  {
                    <div class="single-product-small-slider-item p-2.5 rounded-lg overflow-hidden">
                      <img
                        src="@img.Url"
                        alt="@img.Alt"
                        class="w-full h-full object-cover rounded-lg"
                      />
                    </div>
                  }
                </div>
              </div>
              <div
                class="w-full xl:flex-1 order-1 xl:order-2 overflow-hidden relative"
              >
                <div id="js-sale-badge" class="absolute top-4 left-4 z-10 px-3 py-1 rounded-full bg-error text-white text-xs font-bold uppercase @(isOnSale ? "" : "hidden")">
                  Giảm giá
                </div>
                <div
                  class="product-details-big-slider -mx-3 sellzy-slider"
                  data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "arrows": true, "asNavFor": ".product-details-small-slider", "appendArrows": ".product-details-big-slider-nav", "responsive": [{"breakpoint": 769, "settings": {"slidesToShow": 1, "arrows": false}}]}'
                >
                  @foreach (var img in images)
                  {
                    <div class="single-product-big-slider-item px-3 rounded-2xl overflow-hidden">
                      <img
                        src="@img.Url"
                        alt="@img.Alt"
                        class="w-full h-full object-cover rounded-3xl"
                      />
                    </div>
                  }
                </div>
                <div
                  class="product-details-big-slider-nav absolute top-1/2 -translate-y-1/2 left-0 right-0 flex items-center justify-between px-3"
                ></div>
              </div>
            </div>
          </div>
          <div class="xl:col-span-5 lg:col-span-6 mt-6 lg:mt-0">
            <div class="rounded-3xl border border-gray-300 p-6">
              @if (isSaleDisplay || isNewArrival)
              {
                <div class="flex items-center flex-wrap gap-2 mb-6">
                  @if (isSaleDisplay)
                  {
                    <span class="product-discount-badge inline-block uppercase relative bg-error text-warning-lighter font-medium text-sm leading-[22px] px-1 after:absolute after:top-0 after:left-full after:z-10 after:w-1 after:h-full after:bg-[url('../images/discount-shape.png')] after:bg-contain after:bg-no-repeat">Đang giảm giá</span>
                  }
                  @if (isNewArrival)
                  {
                    <span class="product-discount-badge inline-block uppercase relative bg-success-light text-black text-sm leading-[22px] px-1 after:absolute after:top-0 after:left-full after:z-10 after:w-1 after:h-full after:bg-[url('../images/discount-primary-shape.png')] after:bg-contain after:bg-no-repeat">Hàng mới</span>
                  }
                </div>
              }
              <div
                class="product-title-section flex items-center justify-between mb-6"
              >
                <h3 class="line-clamp-1">
                  @Model.Name
                </h3>
                <button type="button" aria-label="Thêm vào yêu thích" data-wishlist-toggle data-product-id='@Model.ProductId' class='size-10 inline-flex flex-none items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 border border-gray-300'>
                  <svg class="wishlist-heart-icon w-5 h-5 text-light-secondary-text" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                    <path class="wishlist-heart-fill opacity-0" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor" />
                  </svg>
                </button>
              </div>
              <div class="rating-section flex items-center mb-4">
                <div
                  class="bg-[url('../images/star-icon.png')] w-[90px] h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]"
                >
                  <div
                    style="width: @ratingPct%"
                    class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"
                  ></div>
                </div>
                <span class="font-normal inline-block ml-1">(@Model.ReviewCount.ToString("N0", viVn) đánh giá)</span>
              </div>
              <div class="price-section flex items-center gap-x-3 mb-6">
                <span
                  class="current-price text-2xl leading-9 font-bold text-light-primary-text relative after:absolute after:h-6 after:w-px after:bg-gray-300 after:right-0 after:top-1/2 after:-translate-y-1/2 pr-3 inline-block"
                  id="js-current-price">@displayPrice.ToString("N0", viVn) VNĐ</span>
                <span
                  id="js-old-price"
                  class="old-price text-2xl leading-9 font-normal text-light-disabled-text @(isSaleDisplay ? "" : "hidden")"
                >@displayBasePrice.ToString("N0", viVn) VNĐ</span>
                <span
                  id="js-discount-percent"
                  class="product-discount-badge uppercase relative bg-error text-warning-lighter font-medium text-sm leading-[22px] px-1 after:absolute after:top-0 after:left-full after:z-10 after:w-1 after:h-full after:bg-[url('../images/discount-shape.png')] after:bg-contain after:bg-no-repeat @(isSaleDisplay ? "" : "hidden")"
                >@displayDiscountPercent% OFF</span>
              </div>
              <div id="js-sale-countdown" class="sale-section flex flex-col xl:flex-row xl:items-center xl:justify-between mb-6 @(isOnSale && saleSecondsLeft.HasValue && saleSecondsLeft.Value > 0 ? "" : "hidden")" data-seconds-left="@(saleSecondsLeft ?? 0)">
                <p class="xl:w-[120px] w-full text-left mb-4 xl:mb-0">Nhanh tay! Kết thúc sau:</p>
                <div class="home-one-hot-deal-countdown flex items-center gap-x-3 sm:gap-x-5">
                  <div class="countdown-item flex flex-col items-center justify-center w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-error/8 border border-error text-center">
                    <h5 id="js-sale-days" class="days text-sm sm:text-base">0</h5>
                    <p class="text-xs sm:text-sm leading-[18px] sm:leading-[22px]">Ngày</p>
                  </div>
                  <p class="font-semibold">:</p>
                  <div class="countdown-item flex flex-col items-center justify-center w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-error/8 border border-error text-center">
                    <h5 id="js-sale-hours" class="hours text-sm sm:text-base">00</h5>
                    <p class="text-xs sm:text-sm leading-[18px] sm:leading-[22px]">Giờ</p>
                  </div>
                  <p class="font-semibold">:</p>
                  <div class="countdown-item flex flex-col items-center justify-center w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-error/8 border border-error text-center">
                    <h5 id="js-sale-minutes" class="minutes text-sm sm:text-base">00</h5>
                    <p class="text-xs sm:text-sm leading-[18px] sm:leading-[22px]">Phút</p>
                  </div>
                  <p class="font-semibold">:</p>
                  <div class="countdown-item flex flex-col items-center justify-center w-12 h-12 sm:w-15 sm:h-15 rounded-full bg-error/8 border border-error text-center">
                    <h5 id="js-sale-seconds" class="seconds text-sm sm:text-base">00</h5>
                    <p class="text-xs sm:text-sm leading-[18px] sm:leading-[22px]">Giây</p>
                  </div>
                </div>
              </div>

              <div class="progressbar-section mb-6">
                <div class="progress w-full h-1.5 bg-warning-lighter rounded-[50px] overflow-hidden mb-2.5">
                  <div id="js-stock-progress" style="width: @displayStockPct%" class="progress-bar h-full bg-warning rounded-[50px]"></div>
                </div>
                <p class="text-light-primary-text">
                  Nhanh tay! Chỉ còn <span id="js-stock-left" class="font-semibold">@displayStockLeft.ToString("N0", viVn)</span> sản phẩm trong kho
                </p>
              </div>

              @if (Model.Shop is not null && !string.IsNullOrWhiteSpace(Model.Shop.Slug))
              {
                var shopUrl = Url.RouteUrl("shop_details", new { slug = Model.Shop.Slug }) ?? "#";
                var shopLogoUrl = global::DOAN_BANHANG.Helpers.ImageUrlHelper.NormalizeStaticFileUrl(Model.Shop.LogoUrl)
                  ?? Url.Content("~/assets/images/vendors-list/vendor-profile.png");

                <div class="border border-gray-300 rounded-2xl p-4 mb-6">
                  <div class="flex items-start justify-between gap-4">
                    <a href="@shopUrl" class="flex items-center gap-3 min-w-0">
                      <div class="size-12 rounded-full overflow-hidden border border-gray-300 bg-gray-100 flex items-center justify-center flex-none">
                        <img src="@shopLogoUrl" alt="@Model.Shop.Name" class="w-full h-full object-cover" />
                      </div>
                      <div class="min-w-0">
                        <p class="font-semibold text-light-primary-text truncate">@Model.Shop.Name</p>
                        <div class="text-sm text-light-secondary-text">
                          @if (!string.IsNullOrWhiteSpace(Model.Shop.Location))
                          {
                            <span class="inline-flex items-center gap-1">
                              <i class="hgi hgi-stroke hgi-location-01 text-base"></i>
                              <span class="truncate">@Model.Shop.Location</span>
                            </span>
                          }
                          else
                          {
                            <span class="text-light-secondary-text">&nbsp;</span>
                          }
                        </div>
                      </div>
                    </a>

                    <a href="@shopUrl" class="btn btn-outline rounded-full font-semibold text-sm leading-6 px-5 py-2 flex-none">
                      Xem shop
                    </a>
                  </div>

                  <div class="grid grid-cols-3 gap-3 mt-4">
                    <div class="text-center">
                      <p class="text-sm text-light-secondary-text">Đánh giá</p>
                      <p class="font-semibold text-light-primary-text">@Model.Shop.RatingAverage.ToString("0.0", viVn)</p>
                    </div>
                    <div class="text-center">
                      <p class="text-sm text-light-secondary-text">Sản phẩm</p>
                      <p class="font-semibold text-light-primary-text">@Model.Shop.ProductCount.ToString("N0", viVn)</p>
                    </div>
                    <div class="text-center">
                      <p class="text-sm text-light-secondary-text">Phản hồi chat</p>
                      <p class="font-semibold text-light-primary-text">@(Model.Shop.ChatResponseRate.HasValue ? (Model.Shop.ChatResponseRate.Value + "%") : "-")</p>
                    </div>
                  </div>
                </div>
              }

              <script type="application/json" id="js-product-variants">
                @Html.Raw(global::System.Text.Json.JsonSerializer.Serialize(
                  Model.Variants ?? new List<DOAN_BANHANG.ViewModels.ProductVariantVm>(),
                  new global::System.Text.Json.JsonSerializerOptions
                  {
                    PropertyNamingPolicy = global::System.Text.Json.JsonNamingPolicy.CamelCase
                  }))
              </script>
              <div
                class="product-add-to-cart-section py-6 border-b border-dashed border-gray-300 border-t"
              >
                @if (colorOptions.Count > 0)
                {
                  <div class="color-variation-section mb-6">
                    <div class="color-variation-section-title mb-4">
                      <p class="font-semibold text-light-primary-text flex items-center gap-x-2.5">
                        Màu sắc:
                        <span class="text-light-primary-text font-normal capitalize color-variation-selected-color">@selectedColor</span>
                      </p>
                    </div>

                    @if (colorOptions.Count > 1)
                    {
                      <div class="color-variation-items flex items-center gap-x-2">
                        @for (var i = 0; i < colorOptions.Count; i++)
                        {
                          var c = colorOptions[i];
                          var isSelected = c.ColorId == selectedColorId;

                          <div class="variation-color-item p-1 border rounded-full @(isSelected ? "border-primary" : "border-gray-300")">
                            <button
                              type="button"
                              data-color-id="@c.ColorId"
                              data-color-text="@c.Name"
                              class="size-6 rounded-full flex items-center justify-center cursor-pointer"
                              style="background-color: @c.Hex"
                              title="@c.Name"
                            >
                              <i class="hgi hgi-stroke hgi-tick-02 text-white @(isSelected ? "" : "hidden")" aria-hidden="true"></i>
                            </button>
                          </div>
                        }
                      </div>
                    }
                  </div>
                }

                <div class="size-variation-section mb-6">
                  <div
                    class="size-variation-section-title mb-4 flex items-center justify-between"
                  >
                    <p
                      class="font-semibold text-light-primary-text flex items-center gap-x-2.5"
                    >
                      Kích cỡ:
                      <span
                        class="text-light-primary-text font-normal capitalize size-variation-selected-size"
                        >@selectedSize</span>
                    </p>
                    <a
                      href="#"
                      class="text-sm leading-[22px] hover:underline variation-size-guide-btn"
                      >Bảng size</a
                    >
                  </div>
                  <div
                    class="size-variation-items flex items-center gap-2 2xl:flex-nowrap flex-wrap"
                  >
                    @for (var i = 0; i < sizeOptions.Count; i++)
                    {
                      var s = sizeOptions[i];
                      var isSelected = s.SizeId == selectedSizeId;

                      <div class="size-variation-item">
                        <button
                          type="button"
                          data-size-id="@s.SizeId"
                          data-size-text="@s.Name"
                          class="cursor-pointer flex items-center justify-center text-sm leading-6 px-[38px] py-1.5 font-semibold rounded-[100px] hover:bg-[rgba(145,158,171,0.08)] @(isSelected ? "border border-primary bg-primary text-white hover:bg-primary" : "text-light-primary-text border border-gray-300")"
                        >
                          @s.Name
                        </button>
                      </div>
                    }
                  </div>
                </div>
                <div class="product-add-to-cart-btn-section">
                  <p class="font-semibold text-light-primary-text mb-4">Số lượng:</p>
                  <div
                    class="flex items-center justify-between gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0"
                  >
                    <div
                      class="quantity-section flex-1 max-w-[185px] border border-gray-300 rounded-[80px] px-4 py-[11px] flex items-center justify-between"
                    >
                      <button
                        type="button"
                        data-qty-action="dec"
                        class="quantity-btn inline-flex items-center justify-center hover:text-primary"
                      >
                        <i
                          class="hgi hgi-stroke hgi-minus-sign text-xl leading-5"
                        ></i>
                      </button>
                      <input
                        type="number"
                        min="1"
                        step="1"
                        class="quantity-input text-center w-full focus:outline-none font-semibold text-base leading-6 text-light-primary-text"
                        value="1"
                      />
                      <button
                        type="button"
                        data-qty-action="inc"
                        class="quantity-btn inline-flex items-center justify-center hover:text-primary"
                      >
                        <i
                          class="hgi hgi-stroke hgi-plus-sign text-xl leading-5"
                        ></i>
                      </button>
                    </div>
                    <button
                      type="button"
                      data-buy-now
                      data-variant-id="@selectedVariant?.VariantId"
                      class="btn btn-warning btn-large rounded-[80px] flex-1"
                    >
                      Mua ngay
                    </button>
                    <button
                      type="button"
                      data-add-to-cart
                      data-variant-id="@selectedVariant?.VariantId"
                      class="btn btn-primary btn-large rounded-[80px] flex-1"
                    >
                      <i
                        class="hgi hgi-stroke hgi-shopping-cart-add-02 leading-6 text-2xl text-white"
                      ></i>
                      Thêm vào giỏ
                    </button>
                  </div>
                </div>
              </div>
              <div
                class="product-share-and-compare-section flex items-center gap-x-4 mt-6"
              >
                <a
                  href="#"
                  class="product-share-btn text-info inline-flex items-center gap-x-2.5 pr-4 relative after:absolute after:top-1/2 after:-translate-y-1/2 after:right-0 after:w-px after:h-3 after:bg-gray-300"
                >
                  <i class="hgi hgi-stroke hgi-share-05 text-xl leading-5"></i>
                  <span>Chia sẻ</span>
                </a>
                <a class='product-compare-btn text-info inline-flex items-center gap-x-2.5' href="#">
                  <i
                    class="hgi hgi-stroke hgi-git-compare text-xl leading-5"
                  ></i>
                  <span>So sánh</span>
                </a>
              </div>
              <div
                class="product-extra-info-section flex flex-col gap-y-4 mt-6"
              >
                <div
                  class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0"
                >
                  <p class="font-semibold text-light-primary-text">Vận chuyển:</p>
                  <p>Dự kiến giao 5–7 ngày</p>
                </div>
                <div
                  class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0"
                >
                  <p class="font-semibold text-light-primary-text">Tồn kho:</p>
                  <p id="js-stock">@Model.StockQuantity.ToString("N0", viVn)</p>
                </div>
                <div
                  class="product-extra-info-item flex items-center gap-x-4 gap-y-4 flex-wrap md:flex-nowrap md:gap-y-0"
                >
                  <p class="font-semibold text-light-primary-text">
                    Danh mục:
                  </p>
                  <p>
                    @if (!string.IsNullOrWhiteSpace(Model.PrimaryCategoryName))
                    {
                      @Model.PrimaryCategoryName
                    }
                    else
                    {
                      @:-(
                    }
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ========== Product Details Section End ========== -->

    <!-- ========== Size Guide Modal Start ========== -->
