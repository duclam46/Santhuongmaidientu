            class="related-products-slider-nav flex items-center gap-x-6 wow animate__animated animate__fadeInUp"
          ></div>
        </div>
        <div
          data-slick='{"slidesToShow": 6, "slidesToScroll": 1, "loop": true, "arrows": true, "infinite": true, "appendArrows": ".related-products-slider-nav", "autoplay": true, "autoplaySpeed": 7000, "responsive": [{"breakpoint": 1441, "settings": {"slidesToShow": 4}}, {"breakpoint": 1025, "settings": {"slidesToShow": 3}}, {"breakpoint": 769, "settings": {"slidesToShow": 2}}, {"breakpoint": 480, "settings": {"slidesToShow": 1}}]}'
          class="related-products-slider -mx-3 sellzy-slider"
        >
          @if (Model.RelatedProducts is null || Model.RelatedProducts.Count == 0)
          {
            <div class="mx-3">
              <p class="text-light-secondary-text">Không có sản phẩm liên quan.</p>
            </div>
          }
          else
          {
            foreach (var rp in Model.RelatedProducts)
            {
              var rpImage = !string.IsNullOrWhiteSpace(rp.PrimaryImageUrl) ? rp.PrimaryImageUrl : "assets/images/vitamin-c.png";
              var rpRatingPct = (int)System.Math.Round(System.Math.Clamp((double)(rp.RatingAverage / 5m * 100m), 0d, 100d));
              <div class="border border-gray-300 rounded-2xl product-card-1 p-4 group related-product-item mx-3">
                <div class="product-image-container relative">
                  <div class="product-image rounded-xl bg-[#F4F3F5] mb-4 overflow-hidden">
                    <a href="@Url.RouteUrl("product_details", new { slug = rp.Slug })">
                      <img
                        src="@rpImage"
                        alt="@rp.Name"
                        class="group-hover:scale-110 transition-all transform group-hover:-rotate-3 ease-in-out duration-300"
                      />
                    </a>
                  </div>
                </div>

                <div class="product-content">
                  <h5 class="text-base leading-6 font-semibold font-dm-sans mb-4">
                    <a href="@Url.RouteUrl("product_details", new { slug = rp.Slug })">@rp.Name</a>
                  </h5>

                  <div class="rating-section flex items-center mb-4">
                    <div class="bg-[url('../images/star-icon.png')] w-[90px] h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]">
                      <div style="width: @rpRatingPct%" class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"></div>
                    </div>
                    <span class="text-sm leading-[22px] font-normal inline-block ml-1">(@rp.RatingCount.ToString("N0", viVn))</span>
                  </div>

                  <div class="price-section flex items-center gap-x-3 mb-2">
                    <span class="current-price text-base font-semibold text-light-primary-text">@rp.Price.ToString("N0", viVn) VNĐ</span>
                  </div>

                  <div class="btn-section flex items-center gap-x-4">
                    <a class='btn btn-primary rounded-full font-semibold text-sm leading-6 px-6.5 py-2 flex-1' href='@Url.RouteUrl("product_details", new { slug = rp.Slug })'>
                      <i class="hgi hgi-stroke hgi-view text-xl text-white"></i>
                      <span>Xem chi tiết</span>
                    </a>
                  </div>
                </div>
              </div>
            }
          }
        </div>
      </div>
    </section>
    <!-- ========== Related Products Section End ========== -->



