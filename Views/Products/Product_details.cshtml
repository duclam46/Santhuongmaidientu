                    @if (hasBustM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Ngực</th> }
                    @if (hasWaistM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Eo</th> }
                    @if (hasHipM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Mông</th> }
                    @if (hasLenM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Dài</th> }
                    @if (hasWidM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Rộng</th> }
                    @if (hasHeiM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Cao</th> }
                    @if (hasShoeM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">Dài chân</th> }
                    @if (hasPersonHeightM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">C.Cao người</th> }
                    @if (hasPersonWeightM) { <th class="text-left font-semibold p-4 bg-[#F4F6F8]">C.Nặng người</th> }
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-300">
                  @if (guidesM.Count == 0)
                  {
                    <tr><td colspan="12" class="py-10 text-center text-light-secondary-text">Chưa có thông số chi tiết</td></tr>
                  }
                  else
                  {
                    foreach(var g in guidesM)
                    {
                      <tr>
                        <td class="text-left py-3 px-4 font-semibold text-light-primary-text">@g.SizeLabel</td>
                        @if (hasShoulderM) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.ShoulderWidthCm?.ToString("0.#") ?? "-")</td> }
