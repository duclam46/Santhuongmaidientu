                          @if (hasLen) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.LengthCm?.ToString("0.#") ?? "-")</td> }
                          @if (hasWid) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.WidthCm?.ToString("0.#") ?? "-")</td> }
                          @if (hasHei) { <td class="text-left py-3 px-4 text-light-secondary-text">@(g.HeightCm?.ToString("0.#") ?? "-")</td> }
