    .sz-lightbox { position: fixed; inset: 0; z-index: 100080; background: rgba(15,23,42,0.86); backdrop-filter: blur(6px); display: none; align-items: center; justify-content: center; padding: 24px; cursor: zoom-out; }
    .sz-lightbox.is-open { display: flex; }
    .sz-lightbox img { max-width: 92vw; max-height: 88vh; border-radius: 20px; }

