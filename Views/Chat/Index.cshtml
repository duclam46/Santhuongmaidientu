        box-shadow: 0 22px 54px -18px rgba(15,23,42,0.10);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }
    .sz-guest-preview-bg {
        position: absolute;
        inset: 0;
        display: flex;
        filter: blur(6px);
        opacity: 0.45;
        pointer-events: none;
        user-select: none;
    }
    .sz-guest-preview-sb {
        width: 310px;
        flex-shrink: 0;
        background: linear-gradient(180deg, #e7f6f3 0%, #f1f8f7 52%, #f8fafc 100%);
        border-right: 1px solid #dbe9e7;
        padding: 22px 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .sz-guest-skel {
        height: 62px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e1efed;
        box-shadow: 0 6px 16px -8px rgba(15,23,42,0.08);
    }
    .sz-guest-preview-main {
        flex: 1;
        min-width: 0;
        background: #f6f8fb;
        padding: 28px 34px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 16px;
    }
    .sz-guest-bubble {
        height: 44px;
        border-radius: 18px;
        max-width: 58%;
    }
    .sz-guest-bubble.in {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        align-self: flex-start;
        width: 280px;
    }
    .sz-guest-bubble.out {
        background: linear-gradient(135deg, #0d9488 0%, #088178 100%);
        align-self: flex-end;
        width: 240px;
    }
    .sz-guest-card {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 470px;
        background: #ffffff;
        border-radius: 26px;
        border: 1px solid #d7eae7;
        box-shadow: 0 24px 60px -16px rgba(15,23,42,0.18);
        overflow: hidden;
    }
    .sz-guest-hero {
        background: linear-gradient(135deg, #e7f7f4 0%, #eef5ff 100%);
        padding: 28px 28px 22px;
        text-align: center;
        border-bottom: 1px solid #e1efed;
    }
    .sz-guest-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 14px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0d9488 0%, #088178 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 14px 28px -6px rgba(8,129,120,0.40);
    }
    .sz-guest-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid #c7e5e0;
        color: #0f766e;
        font-size: 11.5px;
        font-weight: 700;
        margin-bottom: 10px;
    }
    .sz-guest-hero h4 {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.3;
    }
    .sz-guest-hero p {
        margin: 0 auto;
        font-size: 13.5px;
        color: #475569;
        line-height: 1.55;
        max-width: 390px;
    }
    .sz-guest-body {
        padding: 22px 28px 26px;
        background: #ffffff;
    }
    .sz-guest-benefits {
        list-style: none;
        margin: 0 0 20px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .sz-guest-benefit {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 13px;
        color: #334155;
        line-height: 1.45;
    }
    .sz-guest-benefit-check {
        width: 20px;
        height: 20px;
        border-radius: 999px;
        background: #e6f6f4;
        color: #088178;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 1px;
    }
    .sz-guest-btn-primary {
        width: 100%;
        height: 44px;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #0d9488 0%, #088178 100%);
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 20px -4px rgba(8,129,120,0.40);
        transition: all 0.2s ease;
    }
    .sz-guest-btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 24px -4px rgba(8,129,120,0.48);
    }
    .sz-guest-actions-sub {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 10px;
    }
    .sz-guest-btn-secondary {
        height: 40px;
        border-radius: 999px;
        border: 1px solid #cce3df;
        background: #f4fbfa;
        color: #0f766e;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.18s ease;
    }
    .sz-guest-btn-secondary:hover {
        background: #e7f6f3;
        border-color: #088178;
    }
    .sz-guest-btn-ghost {
        height: 40px;
        border-radius: 999px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.18s ease;
    }
    .sz-guest-btn-ghost:hover {
        border-color: #cbd5e1;
        background: #f8fafc;
        color: #0f172a;
    }

    @@media (max-width: 860px) {
        .sz-chat-card { flex-direction: column; height: auto; min-height: 680px; border-radius: 22px; }
        .sz-chat-sidebar { width: 100%; max-height: 310px; border-right: none; border-bottom: 1px solid #dbe9e7; }
        .sz-feature-grid { grid-template-columns: 1fr; }
        .sz-guest-gate { height: auto; min-height: 540px; padding: 16px; border-radius: 22px; }
        .sz-guest-preview-sb { display: none; }
        .sz-guest-hero, .sz-guest-body { padding-left: 20px; padding-right: 20px; }
        .sz-guest-actions-sub { grid-template-columns: 1fr; }
    }
</style>

<div class="sz-chat-page">
    <div class="sz-chat-shell">
        <div class="sz-top-strip">
            <div class="sz-breadcrumb">
                <a href="/">Trang chủ</a>
                <span>/</span>
