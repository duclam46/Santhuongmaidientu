@model IEnumerable<DOAN_BANHANG.Models.Conversation>
@using DOAN_BANHANG.Helpers
@{
    ViewData["Title"] = "Tin nhắn hỏi đáp";
    var activeConv = ViewBag.ActiveConversation as DOAN_BANHANG.Models.Conversation;
    var messages = ViewBag.Messages as List<DOAN_BANHANG.Models.Message> ?? new List<DOAN_BANHANG.Models.Message>();
    var currentAccountId = ViewBag.CurrentAccountId != null ? (int)ViewBag.CurrentAccountId : 0;
    var unreadMap = ViewBag.UnreadByConv as Dictionary<int, int> ?? new Dictionary<int, int>();
    var onlineIds = ViewBag.OnlineIds as HashSet<int> ?? new HashSet<int>();
    var attachProduct = ViewBag.AttachProduct as DOAN_BANHANG.Models.Product;
    var suggestedShops = ViewBag.SuggestedShops as List<DOAN_BANHANG.Models.Account> ?? new List<DOAN_BANHANG.Models.Account>();
    var isGuest = ViewBag.IsGuest as bool? ?? false;
    var guestReturnUrl = ViewBag.GuestReturnUrl as string ?? "/Chat";

    int activePartnerId = 0;
    string activePartnerName = "";
    string activePartnerAvatar = "";
    bool activePartnerIsMall = false;
    string? activeShopSlug = null;

    if (activeConv != null)
    {
        bool isCustomerSide = activeConv.CustomerId == currentAccountId;
        var partner = isCustomerSide ? activeConv.Shop : activeConv.Customer;
        activePartnerId = partner?.Id ?? 0;
        activePartnerName = isCustomerSide
            ? (partner?.Profile?.ShopName ?? partner?.Profile?.FullName ?? partner?.Email ?? "Gian hàng")
            : (partner?.Profile?.FullName ?? partner?.Email ?? "Khách hàng");
        activePartnerAvatar = ImageUrlHelper.NormalizeStaticFileUrl(
            isCustomerSide ? (partner?.Profile?.ShopLogoUrl ?? partner?.Profile?.AvatarUrl) : partner?.Profile?.AvatarUrl) ?? "";
        activePartnerIsMall = isCustomerSide && (partner?.Profile?.IsMall == true);
        activeShopSlug = isCustomerSide ? partner?.Profile?.ShopSlug : null;
    }

    var attachProdImg = attachProduct != null
        ? ImageUrlHelper.NormalizeStaticFileUrl(attachProduct.Images.OrderByDescending(i => i.IsPrimary).Select(i => i.ImageUrl).FirstOrDefault())
        : null;
    var attachProdPrice = attachProduct != null && attachProduct.Variants.Any(v => v.IsActive && !v.IsDeleted)
        ? attachProduct.Variants.Where(v => v.IsActive && !v.IsDeleted).Min(v => v.SalePrice ?? v.Price)
        : 0m;
}

<style>
    .sz-chat-page {
        background: #f2f5f8;
        padding: 22px 0 48px;
        min-height: calc(100vh - 140px);
        font-family: "Be Vietnam Pro", sans-serif;
    }
    .sz-chat-shell { max-width: 1340px; margin: 0 auto; padding: 0 20px; }

    /* Top utility strip */
    .sz-top-strip { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
    .sz-breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: #64748b; }
    .sz-breadcrumb a { color: #088178; text-decoration: none; font-weight: 700; }
    .sz-breadcrumb a:hover { text-decoration: underline; }
    .sz-top-links { display: flex; align-items: center; gap: 8px; }
    .sz-top-pill {
        display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px;
        border-radius: 999px; background: #ffffff;
        border: 1px solid #dbe4ee; color: #1e293b; font-size: 12.5px;
        font-weight: 600; text-decoration: none; transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }
    .sz-top-pill:hover { background: #088178; border-color: #088178; color: #ffffff; transform: translateY(-1px); }

    /* Main Floating Rounded-3xl Chat Shell */
    .sz-chat-card {
        display: flex; height: min(77vh, 750px); min-height: 600px;
        background: #ffffff; border-radius: 26px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 20px 50px -16px rgba(15, 23, 42, 0.10);
        overflow: hidden;
    }

    /* Left Sidebar — Soft Mint-Slate Pastel Surface */
    .sz-chat-sidebar {
        width: 360px; flex-shrink: 0;
        display: flex; flex-direction: column;
        background: linear-gradient(180deg, #e7f6f3 0%, #f1f8f7 45%, #f8fafc 100%);
        border-right: 1px solid #dbe9e7;
    }
    .sz-sb-head { padding: 22px 20px 16px; border-bottom: 1px solid #d7eae7; }
    .sz-sb-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .sz-sb-title { font-size: 19px; font-weight: 800; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 10px; letter-spacing: -0.015em; }
    .sz-sb-title svg { color: #ffffff; background: linear-gradient(135deg, #14b8a6 0%, #088178 100%); padding: 7px; width: 34px; height: 34px; border-radius: 12px; box-shadow: 0 4px 10px rgba(8,129,120,0.24); }
    .sz-sb-search { position: relative; margin-bottom: 12px; }
    .sz-sb-search input {
        width: 100%; height: 40px; padding: 0 16px 0 40px; border-radius: 999px;
        border: 1px solid #cfe3e0; background: #ffffff; font-size: 13px; color: #0f172a;
        outline: none; transition: all 0.2s ease;
    }
    .sz-sb-search input::placeholder { color: #94a3b8; }
    .sz-sb-search input:focus { border-color: #088178; box-shadow: 0 0 0 3px rgba(8,129,120,0.12); }
    .sz-sb-search svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #088178; }
    .sz-filter-tabs { display: flex; gap: 4px; background: #d9ece9; padding: 4px; border-radius: 999px; }
    .sz-filter-tab {
        flex: 1; padding: 7px 12px; border-radius: 999px; border: none;
        background: transparent; color: #335c58; font-size: 12.5px; font-weight: 700;
        cursor: pointer; transition: all 0.2s ease;
    }
    .sz-filter-tab.is-active { background: #088178; color: #ffffff; box-shadow: 0 3px 10px rgba(8,129,120,0.22); }

    .sz-conv-list { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 7px; }
    .sz-conv-item {
        display: flex; align-items: center; gap: 12px; padding: 12px 14px;
        border-radius: 16px; cursor: pointer; transition: all 0.2s ease;
        border: 1px solid #e1efed; background: #ffffff;
    }
    .sz-conv-item:hover { border-color: #99f6e4; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(8,129,120,0.08); }
    .sz-conv-item.is-active {
        background: #ffffff; border: 1.5px solid #088178;
        box-shadow: 0 6px 16px rgba(8,129,120,0.12);
    }
    .sz-avatar-wrap { position: relative; width: 46px; height: 46px; flex-shrink: 0; }
    .sz-avatar {
        width: 46px; height: 46px; border-radius: 50%; object-fit: cover;
        background: linear-gradient(135deg, #14b8a6 0%, #088178 100%);
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; color: #ffffff; font-size: 16px;
        border: 2px solid #ffffff; box-shadow: 0 3px 8px rgba(8,129,120,0.18);
    }
    .sz-online-dot { position: absolute; right: 1px; bottom: 1px; width: 12px; height: 12px; border-radius: 50%; background: #cbd5e1; border: 2px solid #ffffff; }
    .sz-online-dot.is-online { background: #22c55e; box-shadow: 0 0 0 2px rgba(34,197,94,0.24); }
    .sz-conv-meta { flex: 1; min-width: 0; }
    .sz-conv-top { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 3px; }
    .sz-conv-name { font-size: 13.8px; font-weight: 700; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: flex; align-items: center; gap: 5px; }
    .sz-mall-pill { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 999px; background: linear-gradient(135deg, #f43f5e 0%, #dc2626 100%); color: #ffffff; flex-shrink: 0; }
    .sz-conv-time { font-size: 11px; color: #94a3b8; flex-shrink: 0; }
    .sz-conv-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .sz-conv-preview { font-size: 12.5px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sz-conv-item.has-unread .sz-conv-preview { color: #0f172a; font-weight: 700; }
    .sz-unread-badge { min-width: 21px; height: 21px; padding: 0 6px; border-radius: 999px; background: linear-gradient(135deg, #fb7185 0%, #e11d48 100%); color: #ffffff; font-size: 11px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 3px 8px rgba(225,29,72,0.30); }

    /* Right Main Chat Pane — Crisp Neutral Surface */
    .sz-chat-main { flex: 1; display: flex; flex-direction: column; min-width: 0; background: #f6f8fb; }
    .sz-main-head {
        padding: 15px 24px;
        background: #ffffff;
        border-bottom: 1px solid #e5ecf2;
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }
    .sz-main-partner { display: flex; align-items: center; gap: 13px; min-width: 0; }
    .sz-status-text { font-size: 12px; color: #64748b; display: flex; align-items: center; gap: 5px; margin-top: 1px; }
    .sz-status-text.is-online { color: #16a34a; font-weight: 700; }

    .sz-msg-stream { flex: 1; overflow-y: auto; padding: 22px 26px; display: flex; flex-direction: column; gap: 12px; }
    .sz-date-sep { text-align: center; margin: 12px 0 6px; }
    .sz-date-sep span { display: inline-block; padding: 4px 14px; border-radius: 999px; background: #e8eef3; color: #475569; font-size: 11.5px; font-weight: 600; }

    .sz-msg-row { display: flex; align-items: flex-end; gap: 8px; max-width: 74%; }
    .sz-msg-row.is-me { align-self: flex-end; flex-direction: row-reverse; }
    .sz-msg-row.is-other { align-self: flex-start; }
    .sz-msg-bubble { padding: 12px 16px; border-radius: 22px; font-size: 13.8px; line-height: 1.55; word-break: break-word; position: relative; }
    .sz-msg-row.is-me .sz-msg-bubble {
        background: linear-gradient(135deg, #0d9488 0%, #088178 100%);
        color: #ffffff; border-bottom-right-radius: 6px;
        box-shadow: 0 8px 18px -4px rgba(8,129,120,0.28);
    }
    .sz-msg-row.is-other .sz-msg-bubble {
        background: #ffffff; color: #0f172a;
        border: 1px solid #e2e8f0; border-bottom-left-radius: 6px;
        box-shadow: 0 3px 10px -2px rgba(15,23,42,0.05);
    }
    .sz-msg-foot { display: flex; align-items: center; gap: 6px; margin-top: 4px; font-size: 11px; color: #64748b; padding: 0 4px; }
    .sz-msg-row.is-me .sz-msg-foot { justify-content: flex-end; }
    .sz-recall-btn { opacity: 0; border: none; background: transparent; color: #64748b; font-size: 11px; cursor: pointer; padding: 0 4px; transition: opacity 0.15s, color 0.15s; }
    .sz-msg-row:hover .sz-recall-btn { opacity: 1; }
    .sz-recall-btn:hover { color: #ef4444; text-decoration: underline; }

    /* Rich Cards inside chat */
    .sz-prod-card { display: flex; align-items: center; gap: 11px; padding: 10px; border-radius: 16px; background: #ffffff; border: 1px solid #dbe6ed; color: #0f172a; text-decoration: none; margin-bottom: 7px; min-width: 245px; box-shadow: 0 3px 10px rgba(15,23,42,0.06); }
    .sz-prod-card img { width: 56px; height: 56px; border-radius: 12px; object-fit: cover; flex-shrink: 0; border: 1px solid #f1f5f9; }
    .sz-voucher-card { padding: 11px 14px; border-radius: 16px; background: linear-gradient(135deg, #fffbeb 0%, #fde68a 100%); border: 1.5px dashed #d97706; color: #92400e; margin-bottom: 7px; min-width: 245px; }
    .sz-media-img { max-width: 240px; max-height: 240px; border-radius: 16px; cursor: zoom-in; display: block; object-fit: cover; }
    .sz-media-vid { max-width: 260px; max-height: 220px; border-radius: 16px; display: block; }

    /* Balanced Light Pastel Welcome Hub */
    .sz-empty-hub { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 28px 24px; overflow-y: auto; }
    .sz-empty-card {
        width: 100%; max-width: 630px; background: #ffffff;
        border: 1px solid #e2e8f0; border-radius: 26px; overflow: hidden;
        text-align: center; box-shadow: 0 18px 44px -16px rgba(15, 23, 42, 0.09);
    }
    .sz-empty-hero {
        background: linear-gradient(135deg, #e7f7f4 0%, #eef5ff 100%);
