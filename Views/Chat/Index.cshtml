                                    </div>
                                    <div class="sz-feature-item">
                                        <strong>Săn mã ưu đãi</strong>
                                        <span>Nhận &amp; sao chép mã Voucher độc quyền do gian hàng gửi ngay trong chat.</span>
                                    </div>
                                    <div class="sz-feature-item">
                                        <strong>Minh bạch an toàn</strong>
                                        <span>Lưu vết trao đổi rõ ràng làm cơ sở bảo vệ quyền lợi khi có khiếu nại.</span>
                                    </div>
                                </div>

                                <div style="display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap;">
                                    <a href="/products" class="sz-send-btn" style="text-decoration:none;">Khám phá sản phẩm ngay</a>
                                    <a href="/my-account/orders" class="sz-top-pill" style="height:40px; padding:0 18px;">Xem đơn hàng của tôi</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="sz-main-head">
                        <div class="sz-main-partner">
                            <div class="sz-avatar-wrap" style="width:42px; height:42px;">
                                @if (!string.IsNullOrWhiteSpace(activePartnerAvatar) && !activePartnerAvatar.Contains("placeholder"))
                                {
                                    <img id="sz-head-avatar" class="sz-avatar" style="width:42px; height:42px;" src="@activePartnerAvatar" alt="@activePartnerName" />
                                }
                                else
                                {
                                    <div id="sz-head-avatar" class="sz-avatar" style="width:42px; height:42px;">@(string.IsNullOrEmpty(activePartnerName) ? "S" : activePartnerName.Substring(0, 1).ToUpper())</div>
                                }
                                <span id="sz-head-dot" class="sz-online-dot @(onlineIds.Contains(activePartnerId) ? "is-online" : "")" data-presence-user="@activePartnerId"></span>
                            </div>
                            <div>
                                <div style="display:flex; align-items:center; gap:6px;">
                                    <strong id="sz-head-name" style="font-size:15.5px; color:#0f172a;">@activePartnerName</strong>
                                    <span id="sz-head-mall" class="sz-mall-pill" style="display:@(activePartnerIsMall ? "inline-flex" : "none");">Sellzy Mall</span>
                                </div>
                                <div id="sz-head-status" class="sz-status-text @(onlineIds.Contains(activePartnerId) ? "is-online" : "")">
