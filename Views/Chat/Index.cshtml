    .sz-feature-item:nth-child(2) { background: #fff9ed; border-color: #fde68a; }
    .sz-feature-item:nth-child(2) strong { color: #b45309; }
    .sz-feature-item:nth-child(3) { background: #effcf6; border-color: #bbf7d0; }
    .sz-feature-item:nth-child(3) strong { color: #047857; }
    .sz-feature-item:hover { transform: translateY(-2px); box-shadow: 0 8px 18px -6px rgba(15,23,42,0.09); }
    .sz-feature-item strong { display: block; font-size: 13px; margin-bottom: 4px; font-weight: 800; }
    .sz-feature-item span { font-size: 11.8px; color: #475569; line-height: 1.45; display: block; }

    /* Suggested shop cards on the soft mint-slate sidebar */
