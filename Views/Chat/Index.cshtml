                    <div class="sz-guest-preview-sb">
                        <div class="sz-guest-skel"></div>
                        <div class="sz-guest-skel"></div>
                        <div class="sz-guest-skel"></div>
                        <div class="sz-guest-skel"></div>
                    </div>
                    <div class="sz-guest-preview-main">
                        <div class="sz-guest-bubble in"></div>
                        <div class="sz-guest-bubble out"></div>
                        <div class="sz-guest-bubble in"></div>
                        <div class="sz-guest-bubble out"></div>
                    </div>
                </div>

                <div class="sz-guest-card">
                    <div class="sz-guest-hero">
                        <div class="sz-guest-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </div>
                        <span class="sz-guest-pill">Hộp thư &amp; Mua sắm Sellzy</span>
