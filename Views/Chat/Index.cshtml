            </div>
            <div class="sz-top-links">
                <a href="/Chat/SystemNotifications" class="sz-top-pill" data-auth-prompt="@(isGuest ? "notifications" : null)" data-auth-return-url="@(isGuest ? "/Chat/SystemNotifications" : null)">Thông báo hệ thống</a>
                <a href="/disputes" class="sz-top-pill" data-auth-prompt="@(isGuest ? "account" : null)" data-auth-return-url="@(isGuest ? "/disputes" : null)">Trung tâm khiếu nại</a>
                <a href="/my-account/orders" class="sz-top-pill" data-auth-prompt="@(isGuest ? "orders" : null)" data-auth-return-url="@(isGuest ? "/my-account/orders" : null)">Đơn hàng của tôi</a>
