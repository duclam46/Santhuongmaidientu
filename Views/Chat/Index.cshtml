    .sz-composer input[type="text"] { flex: 1; height: 38px; padding: 0 10px; border: none; background: transparent; font-size: 13.8px; color: #0f172a; outline: none; }
    .sz-composer input[type="text"]::placeholder { color: #94a3b8; }
    .sz-send-btn {
        height: 40px; padding: 0 22px; border-radius: 999px; border: none;
        background: linear-gradient(135deg, #0d9488 0%, #088178 100%); color: #ffffff;
