                        <button type="button" class="sz-guest-btn-primary" data-open-auth="login" data-auth-return-url="@guestReturnUrl">Đăng nhập ngay</button>
                        <div class="sz-guest-actions-sub">
                            <button type="button" class="sz-guest-btn-secondary" data-open-auth="register" data-auth-return-url="@guestReturnUrl">Tạo tài khoản mới</button>
