                        <button type="button" class="sz-quick-pill" data-quick="Shop có mã giảm giá nào đang áp dụng không ạ?">Xin mã giảm giá</button>
                        <button type="button" class="sz-quick-pill" data-quick="Chính sách bảo hành và đổi trả của sản phẩm này thế nào ạ?">Bảo hành &amp; đổi trả</button>
