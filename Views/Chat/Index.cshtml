    .sz-shop-suggest-item:hover { border-color: #088178; transform: translateY(-1px); box-shadow: 0 6px 16px rgba(8,129,120,0.10); }

    /* Typing + Quick Replies + Floating Pill Composer */
    .sz-typing-bar { padding: 0 26px 4px; font-size: 12px; color: #088178; font-weight: 600; font-style: italic; min-height: 18px; }
    .sz-attach-bar { margin: 0 20px 10px; padding: 11px 16px; background: #ffffff; border: 1.5px solid #088178; border-radius: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; box-shadow: 0 8px 20px rgba(8,129,120,0.12); }
    .sz-quick-bar { padding: 6px 20px 8px; background: transparent; display: flex; gap: 7px; overflow-x: auto; scrollbar-width: none; }
    .sz-quick-bar::-webkit-scrollbar { display: none; }
    .sz-quick-pill {
