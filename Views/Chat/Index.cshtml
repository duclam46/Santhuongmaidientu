                        </button>
                        <input type="text" id="sz-msg-input" placeholder="Nhập tin nhắn hỏi Shop (Enter để gửi, Ctrl+V để dán ảnh)..." autocomplete="off" />
                        <button type="button" id="sz-send-btn" class="sz-send-btn">
                            Gửi
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                        </button>
                    </div>
                }
            </section>
        </div>
        <div class="sz-lightbox" id="sz-lightbox" onclick="this.classList.remove('is-open')">
            <img id="sz-lightbox-img" src="" alt="Xem ảnh phóng to" />
        </div>
        }
    </div>
</div>

@section Scripts {
@if (!isGuest)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        (function () {
            const currentAccountId = @currentAccountId;
            let activeConvId = @(activeConv?.Id ?? 0);
            let activePartnerId = @activePartnerId;
            let typingTimer = null;
            let isTypingSent = false;

            const stream = document.getElementById('sz-msg-stream');
            const input = document.getElementById('sz-msg-input');
            const sendBtn = document.getElementById('sz-send-btn');
            const uploadBtn = document.getElementById('sz-upload-btn');
            const fileInput = document.getElementById('sz-media-file');
            const typingBar = document.getElementById('sz-typing-bar');

            // Bắt đầu chat nhanh với gian hàng gợi ý khi hộp thư trống
            document.querySelectorAll('.sz-start-shop-btn').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const shopId = parseInt(this.getAttribute('data-shop-id'));
                    if (!shopId) return;
                    const res = await fetch('/Chat/StartOrOpen', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ShopId: shopId, AutoSendCard: false })
                    });
                    const data = await res.json().catch(() => null);
                    if (res.ok && data?.conversationId) {
                        window.location.href = '/Chat/Index?id=' + data.conversationId;
                    } else {
                        alert(data?.error || 'Không thể mở hội thoại với gian hàng này.');
                    }
                });
            });

            const initialMessages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                messages.Select(m => new {
                    id = m.Id,
                    conversationId = m.ConversationId,
                    senderId = m.SenderId,
                    content = m.Content,
                    messageType = m.MessageType,
                    isReadByCustomer = m.IsReadByCustomer,
                    isReadByShop = m.IsReadByShop,
                    createdAt = m.CreatedAt.ToString("o"),
                    product = m.AttachedProduct == null ? null : new {
                        id = m.AttachedProduct.Id,
                        name = m.AttachedProduct.Name,
                        slug = m.AttachedProduct.Slug,
                        imageUrl = ImageUrlHelper.NormalizeStaticFileUrl(m.AttachedProduct.Images.OrderByDescending(i => i.IsPrimary).Select(i => i.ImageUrl).FirstOrDefault()),
                        price = m.AttachedProduct.Variants.Where(v => v.IsActive && !v.IsDeleted).Select(v => v.SalePrice ?? v.Price).DefaultIfEmpty(0m).Min()
                    },
                    voucher = m.AttachedVoucher == null ? null : new {
                        id = m.AttachedVoucher.Id,
                        code = m.AttachedVoucher.Code,
                        discountType = m.AttachedVoucher.DiscountType,
                        discountValue = m.AttachedVoucher.DiscountValue,
                        endDate = m.AttachedVoucher.EndDate.AddHours(7).ToString("dd/MM/yyyy")
                    }
                })
            ));

            function esc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
            window.saveChatVoucher = async function (voucherId, code, btnEl) {
                if (!code) return;
                document.cookie = "sellzy_claimed_voucher=" + encodeURIComponent(code) + "; path=/; max-age=604800; SameSite=Lax";
                try {
                    const res = await fetch('/vouchers/save', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ voucherId: voucherId, code: code })
                    });
                    if (res.ok && btnEl) {
                        btnEl.textContent = '✓ Đã lưu';
                        btnEl.style.background = '#059669';
                    }
                } catch (e) {}
            };
            function fmtMoney(v) { return Number(v || 0).toLocaleString('vi-VN') + 'đ'; }
            function dateLabel(iso) {
                const d = new Date(iso).toLocaleDateString('vi-VN');
                const now = new Date();
                const yest = new Date(now); yest.setDate(now.getDate() - 1);
                if (d === now.toLocaleDateString('vi-VN')) return 'Hôm nay';
                if (d === yest.toLocaleDateString('vi-VN')) return 'Hôm qua';
                return d;
            }
            function fmtTime(iso) { return new Date(iso).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }); }

            let lastDateRendered = null;

            function renderMessages(list) {
                if (!stream) return;
                stream.innerHTML = '';
                lastDateRendered = null;
                if (!list || list.length === 0) {
                    stream.innerHTML = '<div style="margin:auto; background:#ffffff; border:1px solid #dbe4ee; padding:16px 22px; border-radius:16px; color:#64748b; font-size:13.5px; text-align:center;">Hãy gửi lời chào hoặc chọn câu hỏi nhanh bên dưới để bắt đầu!</div>';
                    return;
                }
                list.forEach(appendMessage);
                stream.scrollTop = stream.scrollHeight;
            }

            function appendMessage(m) {
                if (!stream) return;
                const dLbl = dateLabel(m.createdAt);
                if (dLbl !== lastDateRendered) {
                    lastDateRendered = dLbl;
                    const sep = document.createElement('div');
                    sep.className = 'sz-date-sep';
                    sep.innerHTML = `<span>${esc(dLbl)}</span>`;
                    stream.appendChild(sep);
                }

                const isMe = m.senderId === currentAccountId;
                const row = document.createElement('div');
                row.className = 'sz-msg-row ' + (isMe ? 'is-me' : 'is-other');
                row.setAttribute('data-msg-id', m.id);

                let inner = '';
                if (m.messageType === 'product_card' && m.product) {
                    const href = m.product.slug ? `/product/${encodeURIComponent(m.product.slug)}` : '#';
                    inner += `<a href="${href}" class="sz-prod-card">
                        <img src="${esc(m.product.imageUrl || '/assets/images/placeholder.png')}" alt="" />
                        <div style="min-width:0; flex:1;">
                            <div style="font-size:12.5px; font-weight:700; color:#0f172a; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${esc(m.product.name)}</div>
                            <div style="font-size:12.5px; font-weight:800; color:#088178; margin-top:2px;">${fmtMoney(m.product.price)}</div>
                        </div>
                    </a>`;
                } else if (m.messageType === 'voucher_card' && m.voucher) {
                    const desc = m.voucher.discountType === 'FreeShipping'
                        ? `Freeship ${fmtMoney(m.voucher.discountValue)}`
                        : (m.voucher.discountType === 'Percent' ? `Giảm ${m.voucher.discountValue}%` : `Giảm ${fmtMoney(m.voucher.discountValue)}`);
                    inner += `<div class="sz-voucher-card">
                        <div style="display:flex; justify-content:space-between; align-items:center; gap:6px; flex-wrap:wrap;">
                            <strong style="font-size:13.5px;">🎟️ ${esc(m.voucher.code)}</strong>
                            <div style="display:flex; gap:5px;">
                                <button type="button" onclick="saveChatVoucher(${Number(m.voucher.id || 0)}, '${esc(m.voucher.code)}', this)" style="border:none; background:#008374; color:#fff; border-radius:999px; padding:3px 10px; font-size:11px; font-weight:700; cursor:pointer;">Lưu mã</button>
                                <button type="button" onclick="navigator.clipboard?.writeText('${esc(m.voucher.code)}'); this.textContent='Đã chép';" style="border:none; background:#f59e0b; color:#fff; border-radius:999px; padding:3px 9px; font-size:11px; font-weight:700; cursor:pointer;">Sao chép</button>
                            </div>
                        </div>
                        <div style="font-size:12.5px; margin-top:3px;">${desc} • HSD: ${esc(m.voucher.endDate)}</div>
                    </div>`;
                }

                if (m.messageType === 'image') {
                    inner += `<img src="${esc(m.content)}" class="sz-media-img" onclick="document.getElementById('sz-lightbox-img').src=this.src; document.getElementById('sz-lightbox').classList.add('is-open');" />`;
                } else if (m.messageType === 'video') {
                    inner += `<video src="${esc(m.content)}" controls class="sz-media-vid"></video>`;
                } else if (m.content) {
                    inner += `<div>${esc(m.content).replace(/\n/g, '<br/>')}</div>`;
                }

                const isRead = isMe ? (m.isReadByShop && m.isReadByCustomer) : true;
                const readTick = isMe ? `<span class="sz-read-tick">${isRead ? '✓✓ Đã xem' : '✓ Đã gửi'}</span>` : '';
                const canRecall = isMe && ((Date.now() - new Date(m.createdAt).getTime()) < 5 * 60 * 1000);
                const recallHtml = canRecall ? `<button type="button" class="sz-recall-btn" data-recall-id="${m.id}">Thu hồi</button>` : '';

                row.innerHTML = `<div><div class="sz-msg-bubble">${inner}</div><div class="sz-msg-foot">${fmtTime(m.createdAt)} ${readTick} ${recallHtml}</div></div>`;
                stream.appendChild(row);
                stream.scrollTop = stream.scrollHeight;
            }

            renderMessages(initialMessages);

            const conn = new signalR.HubConnectionBuilder().withUrl('/chathub').withAutomaticReconnect().build();

            conn.on('ReceiveMessage', function (m) {
                if (m.conversationId === activeConvId) {
                    appendMessage(m);
                    if (m.senderId !== currentAccountId) conn.invoke('MarkRead', activeConvId).catch(() => {});
                } else {
                    const item = document.querySelector(`.sz-conv-item[data-conv-id="${m.conversationId}"]`);
                    if (item) {
                        item.classList.add('has-unread');
                        const badge = item.querySelector('.sz-unread-badge');
                        if (badge) { badge.textContent = (parseInt(badge.textContent || '0') || 0) + 1; badge.style.display = 'inline-flex'; }
                        const prev = item.querySelector('.sz-conv-preview');
                        if (prev) prev.textContent = m.messageType === 'image' ? '[Hình ảnh]' : (m.content || '');
                    }
                }
            });

            conn.on('MessagesRead', p => {
                if (p.conversationId === activeConvId && p.readByAccountId !== currentAccountId) {
                    document.querySelectorAll('.sz-read-tick').forEach(el => el.textContent = '✓✓ Đã xem');
                }
            });
            conn.on('UserTyping', p => {
                if (p.conversationId === activeConvId && typingBar) typingBar.textContent = p.isTyping ? 'Đối phương đang nhập tin nhắn...' : '';
            });
            conn.on('UserPresenceChanged', p => {
                document.querySelectorAll(`[data-presence-user="${p.accountId}"]`).forEach(dot => dot.classList.toggle('is-online', p.isOnline));
                if (p.accountId === activePartnerId) {
                    const st = document.getElementById('sz-head-status');
                    if (st) { st.textContent = p.isOnline ? '● Đang trực tuyến' : '○ Ngoại tuyến'; st.classList.toggle('is-online', p.isOnline); }
                }
            });
            conn.on('MessageRecalled', p => {
                if (p.conversationId === activeConvId) {
                    const row = document.querySelector(`.sz-msg-row[data-msg-id="${p.messageId}"]`);
                    if (row) {
                        const b = row.querySelector('.sz-msg-bubble');
                        if (b) { b.style.opacity = '0.6'; b.style.fontStyle = 'italic'; b.innerHTML = 'Tin nhắn đã được thu hồi'; }
                        row.querySelector('.sz-recall-btn')?.remove();
                    }
                }
            });

            conn.start().then(() => {
                if (activeConvId > 0) conn.invoke('JoinConversation', activeConvId).catch(() => {});
            }).catch(console.error);

            document.querySelectorAll('.sz-conv-item').forEach(item => {
                item.addEventListener('click', async function () {
                    const newId = parseInt(this.getAttribute('data-conv-id'));
                    if (!newId || newId === activeConvId) return;
                    if (activeConvId > 0) conn.invoke('LeaveConversation', activeConvId).catch(() => {});
                    activeConvId = newId;
                    document.querySelectorAll('.sz-conv-item').forEach(x => x.classList.remove('is-active'));
                    this.classList.add('is-active');
                    this.classList.remove('has-unread');
                    const badge = this.querySelector('.sz-unread-badge');
                    if (badge) { badge.textContent = '0'; badge.style.display = 'none'; }

                    const res = await fetch('/Chat/GetMessages/' + newId);
                    if (!res.ok) return;
                    const data = await res.json();
                    activePartnerId = data.conversation.partnerId;

                    document.getElementById('sz-head-name').textContent = data.conversation.partnerName;
                    const mallEl = document.getElementById('sz-head-mall');
                    if (mallEl) mallEl.style.display = data.conversation.isMall ? 'inline-flex' : 'none';
                    const stEl = document.getElementById('sz-head-status');
                    if (stEl) {
                        stEl.textContent = data.conversation.isOnline ? '● Đang trực tuyến' : '○ Ngoại tuyến';
                        stEl.classList.toggle('is-online', data.conversation.isOnline);
                    }
                    const dot = document.getElementById('sz-head-dot');
                    if (dot) { dot.setAttribute('data-presence-user', activePartnerId); dot.classList.toggle('is-online', data.conversation.isOnline); }
                    const shopLink = document.getElementById('sz-head-shop-link');
                    if (shopLink) {
                        if (data.conversation.shopSlug) { shopLink.href = '/shop/' + data.conversation.shopSlug; shopLink.style.display = 'inline-flex'; }
                        else { shopLink.style.display = 'none'; }
                    }
                    renderMessages(data.messages);
                    conn.invoke('JoinConversation', activeConvId).catch(() => {});
                    window.history.replaceState({}, '', '/Chat/Index?id=' + activeConvId);
                });
            });

            async function sendCurrentText() {
                if (!input || !activeConvId) return;
                const txt = input.value.trim();
                if (!txt) return;
                input.value = '';
                conn.invoke('SendTyping', activeConvId, false).catch(() => {});
                isTypingSent = false;
                await conn.invoke('SendTextMessage', activeConvId, txt);
            }
            sendBtn?.addEventListener('click', sendCurrentText);
            input?.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendCurrentText(); } });
            input?.addEventListener('input', () => {
                if (!activeConvId) return;
                if (!isTypingSent) { isTypingSent = true; conn.invoke('SendTyping', activeConvId, true).catch(() => {}); }
                clearTimeout(typingTimer);
                typingTimer = setTimeout(() => { isTypingSent = false; conn.invoke('SendTyping', activeConvId, false).catch(() => {}); }, 1500);
            });

            async function uploadAndSendFile(file) {
                if (!file || !activeConvId) return;
                const fd = new FormData(); fd.append('file', file);
                const res = await fetch('/Chat/UploadMedia', { method: 'POST', body: fd });
                const data = await res.json().catch(() => null);
                if (!res.ok) { alert(data?.error || 'Tải tệp lên thất bại.'); return; }
                await conn.invoke('SendMediaMessage', activeConvId, data.url, data.type);
            }
            uploadBtn?.addEventListener('click', () => fileInput?.click());
            fileInput?.addEventListener('change', async function () { if (this.files?.[0]) { await uploadAndSendFile(this.files[0]); this.value = ''; } });
            input?.addEventListener('paste', async e => {
                for (const it of (e.clipboardData?.items || [])) {
                    if (it.type.startsWith('image/')) { e.preventDefault(); await uploadAndSendFile(it.getAsFile()); break; }
                }
            });

            stream?.addEventListener('click', e => {
                const btn = e.target.closest('.sz-recall-btn');
                if (!btn) return;
                const msgId = parseInt(btn.getAttribute('data-recall-id'));
                if (msgId && confirm('Thu hồi tin nhắn này?')) conn.invoke('RecallMessage', msgId).catch(console.error);
            });

            document.querySelectorAll('.sz-quick-pill[data-quick]').forEach(btn => {
                btn.addEventListener('click', () => { if (input) { input.value = btn.getAttribute('data-quick'); sendCurrentText(); } });
            });

            const attachBar = document.getElementById('sz-attach-bar');
            document.getElementById('sz-send-attach-btn')?.addEventListener('click', async () => {
                const pid = parseInt(attachBar?.getAttribute('data-product-id') || '0');
                if (!pid || !activeConvId) return;
                const customMsg = input?.value?.trim() || 'Mình muốn hỏi tư vấn thêm về sản phẩm này ạ!';
                if (input) input.value = '';
                await conn.invoke('SendProductCard', activeConvId, pid, customMsg);
                attachBar?.remove();
            });
            document.getElementById('sz-dismiss-attach-btn')?.addEventListener('click', () => attachBar?.remove());

            let activeFilter = 'all';
            function applyFilters() {
                const q = (document.getElementById('sz-conv-search')?.value || '').trim().toLowerCase();
                document.querySelectorAll('.sz-conv-item').forEach(el => {
                    const matchText = !q || (el.getAttribute('data-search') || '').includes(q);
                    const matchUnread = activeFilter === 'all' || el.classList.contains('has-unread');
                    el.style.display = (matchText && matchUnread) ? 'flex' : 'none';
                });
            }
            document.getElementById('sz-conv-search')?.addEventListener('input', applyFilters);
            document.querySelectorAll('.sz-filter-tab').forEach(tab => {
                tab.addEventListener('click', function () {
                    document.querySelectorAll('.sz-filter-tab').forEach(t => t.classList.remove('is-active'));
                    this.classList.add('is-active');
                    activeFilter = this.getAttribute('data-filter');
                    applyFilters();
                });
            });
        })();
    </script>
}
}
