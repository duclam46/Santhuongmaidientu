@model List<DOAN_BANHANG.Models.OrderDispute>
@{
    ViewData["Title"] = "Khiếu nại & Yêu cầu hoàn tiền của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    (string label, string bg, string color) StatusUi(string s) => s switch
    {
        "Open" => ("Chờ Gian hàng phản hồi", "#FEF3C7", "#92400E"),
        "ShopResponded" => ("Gian hàng đã giải trình", "#DBEAFE", "#1E40AF"),
        "EscalatedToAdmin" => ("Đang chờ Sàn Sellzy phân xử", "#FEE2E2", "#991B1B"),
        "ResolvedBuyerWinShopFault" => ("Đã hoàn tiền (Lỗi Gian hàng)", "#D1FAE5", "#065F46"),
        "ResolvedBuyerWinShippingFault" => ("Đã hoàn tiền (Lỗi Vận chuyển GHN)", "#E0F2FE", "#075985"),
        "ResolvedShopWin" => ("Đã đóng — Bác bỏ khiếu nại", "#F1F5F9", "#475569"),
        "Closed" => ("Đã rút khiếu nại", "#F1F5F9", "#64748B"),
        _ => (s, "#F1F5F9", "#475569")
    };
}

<style>
    .cdisp-wrap { max-width: 1120px; margin: 28px auto 60px; padding: 0 16px; }
    .cdisp-hero {
        background: linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
        border-radius: 20px; padding: 26px 30px; color: #fff; margin-bottom: 24px;
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
    }
    .cdisp-card {
        background: #fff; border: 1px solid #E2E8F0; border-radius: 16px;
        padding: 18px 22px; margin-bottom: 14px; transition: border-color 0.2s;
    }
    .cdisp-card:hover { border-color: #088178; }
    .cdisp-pill {
        display: inline-block; padding: 4px 12px; border-radius: 999px;
        font-size: 12.5px; font-weight: 700;
    }
    .cdisp-btn {
        display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px;
        border-radius: 999px; font-size: 13px; font-weight: 700; text-decoration: none;
    }
</style>

<div class="cdisp-wrap">
    <div class="cdisp-hero">
        <div>
            <h2 style="margin:0 0 6px; font-size:22px; font-weight:800; color:#fff;">Trung tâm Khiếu nại &amp; Bảo vệ Người mua</h2>
            <p style="margin:0; font-size:13.5px; color:rgba(255,255,255,0.82);">
                Theo dõi tiến trình xử lý khiếu nại sản phẩm, sự cố vận chuyển GHN và nhận hoàn tiền trực tiếp về Ví Sellzy.
            </p>
        </div>
        <a href="/my-orders" class="cdisp-btn" style="background:#FFEB69; color:#161C24;">
            ← Quản lý đơn hàng của tôi
        </a>
    </div>

    @if (TempData["DisputeToast"] is string toast && !string.IsNullOrWhiteSpace(toast))
    {
        <div style="background:#ECFDF5; border:1px solid #A7F3D0; color:#065F46; padding:12px 16px; border-radius:12px; margin-bottom:16px; font-size:14px; font-weight:600;">
            ✓ @toast
        </div>
    }

    @if (!Model.Any())
    {
        <div class="cdisp-card" style="text-align:center; padding:48px 20px;">
            <div style="font-size:40px; margin-bottom:10px;">🛡️</div>
            <div style="font-size:17px; font-weight:700; color:#1E293B;">Bạn chưa có hồ sơ khiếu nại nào</div>
            <p style="color:#64748B; font-size:14px; margin:8px 0 18px;">
                Nếu gặp sự cố về sản phẩm hoặc giao hàng GHN, bạn có thể bấm nút <strong>Khiếu nại</strong> ngay trong trang Chi tiết đơn hàng.
            </p>
            <a href="/my-orders" class="cdisp-btn" style="background:#088178; color:#fff;">Xem đơn hàng của tôi</a>
        </div>
    }
    else
    {
        foreach (var d in Model)
        {
            var st = StatusUi(d.Status);
            var shopName = d.Shop?.Profile?.ShopName ?? $"Shop #{d.ShopId}";
            <div class="cdisp-card">
                <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:10px; padding-bottom:12px; border-bottom:1px solid #F1F5F9;">
                    <div>
                        <span style="font-family:monospace; font-weight:800; color:#0F172A; font-size:15px;">@d.DisputeCode</span>
                        <span style="color:#94A3B8; margin:0 8px;">•</span>
                        <span style="font-size:13.5px; color:#475569;">Đơn hàng <strong>#@(d.Order?.OrderCode ?? d.OrderId.ToString())</strong></span>
                        <span style="color:#94A3B8; margin:0 8px;">•</span>
                        <span style="font-size:13.5px; color:#088178; font-weight:600;">@shopName</span>
                    </div>
                    <span class="cdisp-pill" style="background:@st.bg; color:@st.color;">@st.label</span>
                </div>

                <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:14px; padding-top:12px;">
                    <div style="flex:1; min-width:240px;">
                        <span class="cdisp-pill" style="background:#F1F5F9; color:#334155; font-size:11.5px; margin-bottom:6px;">
                            @(d.Category == "Shipping" ? "🚚 Khiếu nại Vận chuyển GHN" : (d.Category == "Service" ? "🏪 Khiếu nại Dịch vụ Gian hàng" : "📦 Khiếu nại Sản phẩm"))
                        </span>
                        <div style="font-weight:700; color:#1E293B; font-size:15px;">@d.ReasonTitle</div>
                        <div style="font-size:13px; color:#64748B; margin-top:4px;">Gửi lúc @d.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</div>
                    </div>
                    <div style="text-align:right;">
                        <div style="font-size:12.5px; color:#64748B;">Số tiền yêu cầu hoàn</div>
                        <div style="font-size:17px; font-weight:800; color:#DC2626;">@d.RequestedAmount.ToString("N0")₫</div>
                        <a href="/my-disputes/details/@d.Id" class="cdisp-btn" style="background:#088178; color:#fff; margin-top:8px;">
                            Xem tiến trình &amp; Trao đổi →
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>
