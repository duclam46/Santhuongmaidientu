@using DOAN_BANHANG.ViewModels
@using System.Globalization
@model BlogPostDetailsVm

@{
    ViewData["Title"] = Model.Title;
    var currentUrl = Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path + Context.Request.QueryString;
    var publishDate = (Model.PublishedAt ?? Model.CreatedAt).ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    var coverBg = !string.IsNullOrEmpty(Model.CoverImageUrl) ? Model.CoverImageUrl : "/assets/images/blog/blog-details.jpg";
}

@section Styles {
    <style>
        /* ── Blog hero ── */
        .blog-details-image {
            height: 400px;
            width: 100%;
            border-radius: 1.5rem;
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center center;
        }
        /* ── Yellow card: overlaps bottom of image ── */
        .blog-hero-card {
            margin-top: -64px;
            margin-left: 1.25rem;
            margin-right: 1.25rem;
            background: #FFEB69;
            border-radius: 1rem;
            padding: 1.25rem 1.5rem;
        }
        @@media (max-width: 767px) {
            .blog-details-image { height: 220px; border-radius: 1rem; }
            .blog-hero-card { margin-top: 0; margin-left: 0; margin-right: 0; border-radius: 0; }
        }
        /* ── Article typography (scoped tightly to .blog-body) ── */
        .blog-body { font-size: 1rem; color: #454F5B; line-height: 1.8; }
        .blog-body > p,
        .blog-body > div > p { margin-bottom: 1.25rem; }
        .blog-body h2 { font-size: 1.4rem; font-weight: 700; color: #161C24; margin-top: 2rem; margin-bottom: 0.875rem; }
        .blog-body h3 { font-size: 1.2rem; font-weight: 700; color: #161C24; margin-top: 1.75rem; margin-bottom: 0.75rem; }
        .blog-body h4 { font-size: 1.05rem; font-weight: 700; color: #161C24; margin-top: 1.5rem; margin-bottom: 0.5rem; }
        .blog-body blockquote {
            border-left: 4px solid #00AB55;
            padding: 1.25rem 1.5rem;
            background: #F4F6F8;
            border-radius: 0 0.75rem 0.75rem 0;
            margin: 1.75rem 0;
            font-style: italic;
            color: #637381;
        }
        /* Only images INSIDE .blog-body get the article image style */
        .blog-body > img,
        .blog-body p > img,
        .blog-body figure > img,
        .blog-body div > img:not(.sidebar-img):not(.sp-img) {
            border-radius: 1rem;
            max-width: 100%;
            height: auto !important;
            margin: 1.5rem auto;
            display: block;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            width: auto;
        }
        /* Sidebar thumbnails must NOT be affected by blog-body img — hard reset */
        .sidebar-img {
            border-radius: 0 !important;
            margin: 0 !important;
            box-shadow: none !important;
            display: block !important;
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
        }
        .blog-body ul { list-style: disc; padding-left: 1.75rem; margin-bottom: 1.25rem; }
        .blog-body ol { list-style: decimal; padding-left: 1.75rem; margin-bottom: 1.25rem; }
        .blog-body ul li, .blog-body ol li { margin-bottom: 0.5rem; }
        .blog-body a { color: #00AB55; text-decoration: underline; }
        .blog-body strong { color: #161C24; }
        .blog-body figure { margin: 1.5rem 0; }
        .blog-body figure figcaption { text-align: center; font-size: 0.875rem; color: #919EAB; margin-top: 0.5rem; }
        /* ── Sidebar product card ── */
        .sp-card { transition: all 0.2s ease; }
        .sp-card:hover { border-color: #00AB55; box-shadow: 0 2px 10px rgba(0,171,85,0.1); }
        /* ── Sidebar recent posts divider ── */
        .last-child-no-border:last-child { border-bottom: none !important; padding-bottom: 0 !important; }
        .last-child-no-border:first-child { padding-top: 0 !important; }
        /* ── Comments ── */
        .comment-list, .comment-list ol.children { list-style: none; padding: 0; margin: 0; }
        .comment-list .comment { margin-bottom: 1.5rem; }
        .comment-body { display: flex; gap: 1rem; }
        .comment-meta { display: flex; gap: 0.75rem; align-items: flex-start; margin-bottom: 0.5rem; }
        .children { padding-left: 3rem; margin-top: 1.5rem; border-left: 2px solid #e5e7eb; }
    </style>
}

<!-- ========== Breadcrumb ========== -->
<div class="pb-8 pt-12">
    <div class="container">
        <div class="breadcrumb">
            <ul>
                <li>
                    <a href='@Url.Action("Index", "Home")'>
                        <span><i class="hgi hgi-stroke hgi-home-01 text-[20px]"></i></span>
                        Home
                    </a>
                </li>
                <li class="text-light-disabled-text">•</li>
                <li><a href='@Url.Action("Index", "Blog")'>Blog</a></li>
                <li class="text-light-disabled-text">•</li>
                <li><span class="line-clamp-1 max-w-[280px]">@Model.Title</span></li>
            </ul>
        </div>
    </div>
</div>

<!-- ========== Blog Details Section ========== -->
<section class="pb-[70px]">
    <div class="container">

        <!-- ── Two-column layout wraps everything including hero ── -->
        <div class="grid grid-cols-12 gap-x-10 gap-y-6">

            <!-- ===== Article Column ===== -->
            <div class="xl:col-span-9 col-span-12">

                <!-- ── Hero Cover Image (left column only) ── -->
                <div class="blog-details-image"
                     style="background-image: url('@coverBg')">
                </div>

                <!-- ── Yellow card: overlap bottom of image, centered text ── -->
                <div class="blog-hero-card mb-8 text-center">
                    @if (!string.IsNullOrEmpty(Model.ProductCategoryName))
                    {
                        <p class="text-primary font-semibold text-xs uppercase tracking-widest mb-2">@Model.ProductCategoryName</p>
                    }
                    <h1 class="text-2xl md:text-3xl font-bold text-light-primary-text leading-snug mb-3">@Model.Title</h1>
                    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
                        <span class="inline-flex items-center gap-x-1.5 text-sm text-light-primary-text">
                            <i class="hgi hgi-stroke hgi-user" style="font-size:14px"></i>
                            @Model.ShopName
                        </span>
                        <span class="inline-flex items-center gap-x-1.5 text-sm text-light-primary-text">
                            <i class="hgi hgi-stroke hgi-calendar-03" style="font-size:14px"></i>
                            @publishDate
                        </span>
                        <span class="inline-flex items-center gap-x-1.5 text-sm text-light-primary-text">
                            <i class="hgi hgi-stroke hgi-chatting-01" style="font-size:14px"></i>
                            @Model.TotalComments bình luận
                        </span>
                        <span class="inline-flex items-center gap-x-1.5 text-sm text-light-primary-text">
                            <i class="hgi hgi-stroke hgi-eye" style="font-size:14px"></i>
                            @Model.ViewCount lượt xem
                        </span>
                    </div>
                </div>

                <!-- Summary / Lead -->
                @if (!string.IsNullOrEmpty(Model.Summary))
                {
                    <p class="text-light-secondary-text text-lg leading-relaxed mb-8 italic border-l-4 border-primary pl-5 wow animate__animated animate__fadeInUp" data-wow-delay="0.1s">
                        @Model.Summary
                    </p>
                }

                <!-- Article Body (CKEditor HTML, may contain inline images) -->
                <div class="blog-body mb-10 wow animate__animated animate__fadeInUp" data-wow-delay="0.15s">
                    @Html.Raw(Model.Content)
                </div>

                <!-- Share + Tags bar -->
                <div class="md:flex md:items-center md:justify-between md:gap-x-4 bg-gray-200 rounded-3xl p-6 mb-12">
                    <div class="flex items-center gap-x-2 md:mb-0 mb-4">
                        <span class="text-sm font-semibold text-light-primary-text mr-1">Chia sẻ:</span>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(currentUrl.ToString())"
                           target="_blank"
                           class="size-8 border border-gray-300 inline-flex justify-center items-center rounded-full bg-white hover:bg-[#1877F2] hover:border-[#1877F2] transition-colors group">
                            <i class="hgi hgi-stroke hgi-facebook-01 text-base text-[#1877F2] group-hover:text-white transition-colors"></i>
                        </a>
                        <a href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(currentUrl.ToString())&text=@Uri.EscapeDataString(Model.Title)"
                           target="_blank"
                           class="size-8 border border-gray-300 inline-flex justify-center items-center rounded-full bg-white hover:bg-black hover:border-black transition-colors group">
                            <i class="hgi hgi-stroke hgi-twitter text-base group-hover:text-white transition-colors"></i>
                        </a>
                    </div>
                </div>

                <!-- Comments Section -->
                <div id="comments" class="wow animate__animated animate__fadeInUp" data-wow-delay="0.2s">
                    <div class="flex items-center justify-between pb-6 border-b border-gray-300 mb-8">
                        <h5 class="text-light-primary-text">Bình luận (@Model.TotalComments)</h5>
                    </div>

                    <!-- Comment List -->
                    <ol class="comment-list mb-10" id="commentsList">
                        @if (!Model.Comments.Any(c => c.ParentCommentId == null))
                        {
                            <li class="border border-gray-300 rounded-2xl p-6 text-center">
                                <p class="text-light-secondary-text">Chưa có bình luận nào. Hãy là người đầu tiên!</p>
                            </li>
                        }
                        @foreach (var comment in Model.Comments.Where(c => c.ParentCommentId == null))
                        {
                            <li class="comment" id="comment-@comment.Id">
                                <div class="comment-body">
                                    <div class="w-12 h-12 rounded-full bg-gray-200 inline-flex items-center justify-center text-gray-400 shrink-0 overflow-hidden">
                                        @if (!string.IsNullOrEmpty(comment.AvatarUrl))
                                        {
                                            <img src="@comment.AvatarUrl" class="w-full h-full object-cover" alt="avatar" />
                                        }
                                        else
                                        {
                                            <i class="hgi hgi-stroke hgi-user text-2xl"></i>
                                        }
                                    </div>
                                    <div class="flex-1 min-w-0 border border-gray-300 rounded-2xl p-4">
                                        <div class="comment-meta">
                                            <div class="comment-metadata flex-1">
                                                <p class="comment-author font-semibold text-light-primary-text mb-0.5">@comment.UserName</p>
                                                <p class="comment-date text-sm text-light-secondary-text">@comment.CreatedAt.ToString("HH:mm, dd MMM yyyy")</p>
                                            </div>
                                            @if (Model.IsLoggedIn && (Model.CurrentAccountId == comment.AccountId || Model.CurrentAccountId == Model.ShopId))
                                            {
                                                <button onclick="deleteComment(@comment.Id)" class="text-xs text-error font-semibold inline-flex items-center gap-x-1 hover:underline shrink-0">
                                                    <i class="hgi hgi-stroke hgi-delete-02 text-sm"></i> Xóa
                                                </button>
                                            }
                                        </div>
                                        <div class="comment-content">
                                            <p class="text-sm leading-[22px] text-light-secondary-text">@comment.Content</p>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ol>

                    <!-- Comment Form -->
                    <div class="border border-gray-300 rounded-3xl p-6">
                        <h6 class="text-light-primary-text mb-4">Viết bình luận</h6>
                        <form id="commentForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="blogPostId" value="@Model.Id" />
                            <div class="mb-4">
                                <textarea name="content" id="commentContent" rows="4"
                                    class="w-full p-4 border border-gray-300 rounded-2xl text-sm focus:border-primary focus:ring-0 outline-none transition-colors resize-y"
                                    placeholder="Nhập nội dung bình luận..."></textarea>
                            </div>
                            <button type="submit" id="btnSubmitComment" class="btn btn-primary btn-medium rounded-full px-8 font-semibold">
                                Gửi bình luận
                            </button>
                        </form>
                    </div>
                </div>

            </div>

            <!-- ===== Sidebar ===== -->
            <div class="xl:col-span-3 col-span-12">
                <div class="flex flex-col gap-y-6">

                    <!-- (search removed per request) -->

                    <!-- Linked Products -->
                    @if (Model.LinkedProducts != null && Model.LinkedProducts.Any())
                    {
                        <div class="border border-gray-300 rounded-2xl wow animate__animated animate__fadeInUp" data-wow-delay="0.15s">
                            <div class="px-5 py-4 bg-gray-200 rounded-t-2xl flex items-center gap-x-2">
                                <i class="hgi hgi-stroke hgi-shopping-bag-02 text-lg text-light-primary-text"></i>
                                <h6 class="text-light-primary-text font-semibold">Sản phẩm trong bài</h6>
                            </div>
                            <div class="p-4 flex flex-col gap-y-3">
                                @foreach (var p in Model.LinkedProducts)
                                {
                                    <a href="@Url.Action("Details", "Products", new { slug = p.Slug })"
                                       class="sp-card flex items-center gap-x-3 p-3 border border-gray-300 rounded-2xl group">
                                        <div class="w-[60px] h-[60px] rounded-xl bg-[#F4F3F5] overflow-hidden shrink-0">
                                            <img src="@(p.ImageUrl ?? "/assets/images/no-image.png")"
                                                 alt="@p.Name"
                                                 class="w-full h-full object-cover rounded-xl" />
                                        </div>
                                        <div class="flex flex-col min-w-0 flex-1">
                                            <span class="text-sm font-semibold text-light-primary-text group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                                                @p.Name
                                            </span>
                                            <div class="flex items-center gap-x-1 mt-1 flex-wrap">
                                                <span class="text-sm font-bold text-primary">@p.Price.ToString("N0")đ</span>
                                                @if (p.SalePrice.HasValue && p.SalePrice < p.Price)
                                                {
                                                    <span class="text-xs text-light-disabled-text line-through">@p.SalePrice.Value.ToString("N0")đ</span>
                                                }
                                            </div>
                                        </div>
                                        <i class="hgi hgi-stroke hgi-arrow-right-01 text-lg text-light-disabled-text shrink-0 group-hover:text-primary transition-colors"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <!-- Recent Posts -->
                    <div class="border border-gray-300 rounded-2xl wow animate__animated animate__fadeInUp" data-wow-delay="0.2s">
                        <div class="px-5 py-4 bg-gray-200 rounded-t-2xl">
                            <h6 class="text-light-primary-text font-semibold">Bài viết gần đây</h6>
                        </div>
                        <div class="p-4">
                            <div class="flex flex-col divide-y divide-gray-300">
                                @foreach (var recent in Model.RecentPosts.Take(5))
                                {
                                    var recentUrl = Url.Action("Details", "Blog", new { slug = recent.Slug }) ?? "#";
                                    var recentDate = (recent.PublishedAt ?? recent.CreatedAt).ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
                                    <div style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;" class="last-child-no-border">
                                        <a href="@recentUrl" class="flex items-center gap-x-3 group">
                                            <div class="shrink-0 overflow-hidden rounded-lg" style="width:44px;height:44px;min-width:44px;">
                                                <img src="@(recent.CoverImageUrl ?? "/assets/images/no-image.png")"
                                                     alt="@recent.Title"
                                                     class="sidebar-img" />
                                            </div>
                                            <div style="flex:1;min-width:0;">
                                                <p style="font-size:12px;font-weight:600;color:#161C24;line-height:1.4;margin:0 0 2px 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                                    @recent.Title
                                                </p>
                                                <p style="font-size:11px;color:#919EAB;margin:0;display:flex;align-items:center;gap:4px;">
                                                    <i class="hgi hgi-stroke hgi-calendar-03" style="font-size:11px;line-height:1;"></i>
                                                    @recentDate
                                                </p>
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('commentForm');
            var btn = document.getElementById('btnSubmitComment');
            if (!form) return;

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                var content = document.getElementById('commentContent').value.trim();
                if (!content) return;

                btn.disabled = true;
                btn.innerHTML = 'Đang gửi...';

                var formData = new FormData(form);
                try {
                    var res = await fetch('/Blog/AddComment', { method: 'POST', body: formData });
                    var result = await res.json();
                    if (result.success) {
                        location.reload();
                    } else {
                        alert(result.message || 'Có lỗi xảy ra');
                    }
                } catch (err) {
                    alert('Lỗi kết nối');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = 'Gửi bình luận';
                }
            });
        });

        async function deleteComment(id) {
            if (!confirm('Xóa bình luận này?')) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var formData = new FormData();
            formData.append('commentId', id);
            try {
                var res = await fetch('/Blog/DeleteComment', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token ? token.value : '' },
                    body: formData
                });
                var result = await res.json();
                if (result.success) {
                    var el = document.getElementById('comment-' + id);
                    if (el) { el.style.opacity = '0'; setTimeout(() => el.remove(), 300); }
                } else {
                    alert(result.message || 'Lỗi khi xóa');
                }
            } catch (err) { console.error(err); }
        }
    </script>
}
