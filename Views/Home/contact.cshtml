@{
  ViewData["Title"] = "Liên hệ";
}
    <!-- ========== Breadcrumb Section Start ========== -->
    <div class="py-12">
      <div class="container">
        <div class="breadcrumb">
          <ul>
            <li>
              <a href="@Url.Action("Index", "Home")">
                <span>
                  <i class="hgi hgi-stroke hgi-home-01 text-[20px]"></i>
                </span>
                Trang chủ
              </a>
            </li>
            <li class="text-light-disabled-text">&#8226;</li>
            <li><span>Liên hệ</span></li>
          </ul>
        </div>
      </div>
    </div>
    <!-- ========== Breadcrumb Section End ========== -->

    <!-- ========== Happy To Assist Section Start ========== -->
    <section class="pb-[70px]">
      <div class="container">
        <div class="text-center">
          <h3
            class="pb-3 wow animate__animated animate__fadeInUp"
            data-wow-delay=".2s"
          >
            Chúng tôi luôn sẵn sàng hỗ trợ bạn
          </h3>
          <p
            class="pb-10 wow animate__animated animate__fadeInUp"
            data-wow-delay=".2s"
          >
            Luôn đồng hành cùng bạn mọi lúc, mọi nơi khi bạn cần.
          </p>
        </div>
        <div class="grid grid-cols-12 gap-6">
          <div
            class="md:col-span-6 col-span-12 xl:col-span-3 border-gray-300 border p-6 rounded-2xl wow animate__animated animate__fadeInUp"
            data-wow-delay=".2s"
          >
            <div>
              <span
                class="inline-flex items-center justify-center size-12 bg-[#919EAB14] rounded-full"
              >
                <i
                  class="hgi hgi-stroke hgi-mail-02 text-2xl text-light-primary-text"
                ></i>
              </span>
              <p class="pt-4 pb-0.5 font-semibold text-light-primary-text">
                Email
              </p>
              <p>support@example.com</p>
            </div>
          </div>
          <div
            class="md:col-span-6 col-span-12 xl:col-span-3 p-6 border-gray-300 border rounded-2xl wow animate__animated animate__fadeInUp"
            data-wow-delay=".3s"
          >
            <div>
              <span
                class="inline-flex items-center justify-center size-12 bg-[#919EAB14] rounded-full"
              >
                <i
                  class="hgi hgi-stroke hgi-customer-support text-2xl text-light-primary-text"
                ></i>
              </span>
              <p class="pt-4 pb-0.5 font-semibold text-light-primary-text">
                Điện thoại
              </p>
              <p>+1 (555) 123-4567</p>
            </div>
          </div>
          <div
            class="md:col-span-6 col-span-12 xl:col-span-3 p-6 border-gray-300 border rounded-2xl wow animate__animated animate__fadeInUp"
            data-wow-delay=".4s"
          >
            <div>
              <span
                class="inline-flex items-center justify-center size-12 bg-[#919EAB14] rounded-full"
              >
                <i
                  class="hgi hgi-stroke hgi-location-06 text-2xl text-light-primary-text"
                ></i>
              </span>
              <p class="pt-4 pb-0.5 font-semibold text-light-primary-text">
                Địa chỉ
              </p>
              <p>
                182 Lê Duẩn, Bến Thủy, Thành phố Vinh, Nghệ An, Việt Nam
              </p>
            </div>
          </div>
          <div
            class="md:col-span-6 col-span-12 xl:col-span-3 p-6 border-gray-300 border rounded-2xl wow animate__animated animate__fadeInUp"
            data-wow-delay=".5s"
          >
            <div>
              <span
                class="inline-flex items-center justify-center size-12 bg-[#919EAB14] rounded-full"
              >
                <i
                  class="hgi hgi-stroke hgi-internet text-2xl text-light-primary-text"
                ></i>
              </span>
              <p class="pt-4 pb-0.5 font-semibold text-light-primary-text">
                Website
              </p>
              <p>www.createuiux.com</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ========== Happy To Assist Section End ========== -->

    <!-- ========== Contact Form Section Start ========== -->
    <section class="mb-[70px]">
      <div
        class="lg:bg-white bg-[#9EE872] py-12 lg:pt-0 lg:pb-[23px] text-center lg:max-w-[704px] mx-auto lg:rounded-[164px] lg:-mb-[103px] relative z-10 lg:before:bg-[#9EE872] lg:after:bg-[#9EE872] lg:before:absolute lg:before:bottom-0 lg:before:left-0 lg:before:h-full lg:before:w-[145px] lg:before:bg-[url('images/slider-left-shape.html')] lg:before:bg-no-repeat lg:before:z-11 lg:after:absolute lg:after:bottom-0 lg:after:right-0 lg:after:h-full lg:after:w-[145px] lg:after:bg-[url('images/slider-right-shape.png')] lg:after:bg-no-repeat lg:after:z-11"
      >
        <h3
          class="mb-2 wow animate__animated animate__fadeInUp"
          data-wow-delay=".2s"
        >
          Liên hệ với chúng tôi
        </h3>
        <p class="wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
          Chúng tôi rất muốn lắng nghe ý kiến của bạn!
        </p>
      </div>
      <div
        class="xl:max-w-[1728px] w-full mx-auto relative bg-[#9EE872] xl:rounded-5xl pb-12 lg:pt-[172px]"
      >
        <div class="container">
          <div class="grid grid-cols-12 gap-6">
            <div
              class="lg:col-start-2 md:col-start-2 col-start-1 xl:col-end-12 md:col-end-12 col-end-13 bg-white rounded-2xl gap-y-6 wow animate__animated animate__fadeInUp"
              data-wow-delay=".2s"
            >
              <div class="lg:p-10 p-5">
                <div class="md:flex gap-x-4 pb-6">
                  <div
                    class="md:w-1/2 w-full wow animate__animated animate__fadeInUp"
                    data-wow-delay=".2s"
                  >
                    <div class="relative w-full">
                      <input
                        type="text"
                        id="first_name"
                        class="peer form-control input-group medium rounded-[80px] px-3.5 placeholder-transparent focus:placeholder-transparent focus:outline-none"
                        placeholder="Tên"
                      />

                      <label
                        for="first_name"
                        class="absolute left-[14px] top-1/2 -translate-y-1/2 text-xs leading-[18px] transition-all peer-placeholder-shown:text-light-disabled-text peer-placeholder-shown:text-[16px] peer-placeholder-shown:top-1/2 peer-focus:text-[12px] peer-focus:top-0 peer-[:not(:placeholder-shown)]:text-[12px] peer-[:not(:placeholder-shown)]:top-0 bg-white peer-focus:px-1 peer-[:not(:placeholder-shown)]:px-1"
                      >
                        Tên
                      </label>
                    </div>
                  </div>
                  <div
                    class="md:w-1/2 w-full pt-6 md:pt-0 wow animate__animated animate__fadeInUp"
                    data-wow-delay=".3s"
                  >
                    <div class="relative w-full">
                      <input
                        type="text"
                        id="last_name"
                        class="peer form-control input-group medium rounded-[80px] px-3.5 placeholder-transparent focus:placeholder-transparent focus:outline-none"
                        placeholder="Họ"
                      />

                      <label
                        for="last_name"
                        class="absolute left-[14px] top-1/2 -translate-y-1/2 text-xs leading-[18px] transition-all peer-placeholder-shown:text-light-disabled-text peer-placeholder-shown:text-[16px] peer-placeholder-shown:top-1/2 peer-focus:text-[12px] peer-focus:top-0 peer-[:not(:placeholder-shown)]:text-[12px] peer-[:not(:placeholder-shown)]:top-0 bg-white peer-focus:px-1 peer-[:not(:placeholder-shown)]:px-1"
                      >
                        Họ
                      </label>
                    </div>
                  </div>
                </div>
                <div
                  class="md:flex gap-x-4 pb-6 wow animate__animated animate__fadeInUp"
                  data-wow-delay=".2s"
                >
                  <div class="md:w-1/2 w-full">
                    <div class="relative w-full">
                      <input
                        type="tel"
                        id="phone"
                        class="peer form-control input-group medium rounded-[80px] px-3.5 placeholder-transparent focus:placeholder-transparent focus:outline-none"
                        placeholder="Số điện thoại"
                      />

                      <label
                        for="phone"
                        class="absolute left-[14px] top-1/2 -translate-y-1/2 text-xs leading-[18px] transition-all peer-placeholder-shown:text-light-disabled-text peer-placeholder-shown:text-[16px] peer-placeholder-shown:top-1/2 peer-focus:text-[12px] peer-focus:top-0 peer-[:not(:placeholder-shown)]:text-[12px] peer-[:not(:placeholder-shown)]:top-0 bg-white peer-focus:px-1 peer-[:not(:placeholder-shown)]:px-1"
                      >
                        Số điện thoại
                      </label>
                    </div>
                  </div>
                  <div class="md:w-1/2 w-full pt-6 md:pt-0">
                    <div class="relative w-full">
                      <input
                        type="email"
                        id="email"
                        class="peer form-control input-group medium rounded-[80px] px-3.5 placeholder-transparent focus:placeholder-transparent focus:outline-none"
                        placeholder="Địa chỉ Email"
                      />

                      <label
                        for="email"
                        class="absolute left-[14px] top-1/2 -translate-y-1/2 text-xs leading-[18px] transition-all peer-placeholder-shown:text-light-disabled-text peer-placeholder-shown:text-[16px] peer-placeholder-shown:top-1/2 peer-focus:text-[12px] peer-focus:top-0 peer-[:not(:placeholder-shown)]:text-[12px] peer-[:not(:placeholder-shown)]:top-0 bg-white peer-focus:px-1 peer-[:not(:placeholder-shown)]:px-1"
                      >
                        Địa chỉ Email
                      </label>
                    </div>
                  </div>
                </div>
                <div
                  class="w-full pb-6 wow animate__animated animate__fadeInUp"
                  data-wow-delay=".2s"
                >
                  <div class="relative w-full">
                    <input
                      type="text"
                      id="subject"
                      class="peer form-control input-group medium rounded-[80px] px-3.5 placeholder-transparent focus:placeholder-transparent focus:outline-none"
                      placeholder="Tiêu đề"
                    />

                    <label
                      for="subject"
                      class="absolute left-[14px] top-1/2 -translate-y-1/2 text-xs leading-[18px] transition-all peer-placeholder-shown:text-light-disabled-text peer-placeholder-shown:text-[16px] peer-placeholder-shown:top-1/2 peer-focus:text-[12px] peer-focus:top-0 peer-[:not(:placeholder-shown)]:text-[12px] peer-[:not(:placeholder-shown)]:top-0 bg-white peer-focus:px-1 peer-[:not(:placeholder-shown)]:px-1"
                    >
                      Tiêu đề
                    </label>
                  </div>
                </div>
                <div
                  class="w-full pb-10 wow animate__animated animate__fadeInUp"
                  data-wow-delay=".2s"
                >
                  <div
                    class="input-group medium rounded-[20px] px-3.5 resize-none"
                  >
                    <textarea
                      id="message"
                      rows="4"
                      class="peer form-control placeholder-transparent focus:placeholder-transparent"
                      placeholder="Nhập tin nhắn của bạn"
                    ></textarea>
                    <label
                      for="message"
                      class="absolute left-[14px] top-1/2 -translate-y-1/2 text-xs leading-[18px] transition-all peer-placeholder-shown:text-light-disabled-text peer-placeholder-shown:text-[16px] peer-placeholder-shown:top-6 peer-focus:text-[12px] peer-focus:top-0 peer-[:not(:placeholder-shown)]:text-[12px] peer-[:not(:placeholder-shown)]:top-0 bg-white peer-focus:px-1 peer-[:not(:placeholder-shown)]:px-1"
                    >
                      Nhập tin nhắn của bạn
                    </label>
                  </div>
                </div>
                <div
                  class="flex justify-end wow animate__animated animate__fadeInUp"
                  data-wow-delay=".2s"
                >
                  <div
                    class="btn btn-large btn-primary rounded-[100px] px-[35px] py-[11px]"
                  >
                    <a href="#">Gửi tin nhắn</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ========== Contact Form Section End ========== -->

    <!-- ========== FAQ Section Start ========== -->
    <section class="mb-[70px]">
      <div class="container">
        <div class="text-center">
          <h3
            class="pb-3 wow animate__animated animate__fadeInUp"
            data-wow-delay=".2s"
          >
            Câu Hỏi Thường Gặp
          </h3>
          <p
            class="pb-12 wow animate__animated animate__fadeInUp"
            data-wow-delay=".2s"
          >
            Tìm câu trả lời nhanh chóng cho các câu hỏi phổ biến nhất.
          </p>
        </div>
        <div class="grid grid-cols-12">
          <div
            class="lg:col-start-2 md:col-start-2 col-start-1 xl:col-end-12 md:col-end-12 col-end-13"
          >
            <div class="accordion">
              <div
                class="accordion-item wow animate__animated animate__fadeInUp"
                data-wow-delay=".2s"
              >
                <div class="accordion-header active">
                  <h6>1. Cửa hàng chấp nhận những phương thức thanh toán nào?</h6>
                  <i class="hgi hgi-stroke hgi-minus-sign"></i>
                  <i class="hgi hgi-stroke hgi-plus-sign"></i>
                </div>
                <div class="accordion-body">
                  <p>
                    Chúng tôi chấp nhận nhiều phương thức thanh toán linh hoạt bao gồm chuyển khoản ngân hàng trực tiếp, thanh toán qua các ví điện tử phổ biến (Momo, VNPay) và thanh toán khi nhận hàng (COD) cực kỳ tiện lợi.
                  </p>
                </div>
              </div>
              <div
                class="accordion-item wow animate__animated animate__fadeInUp"
                data-wow-delay=".2s"
              >
                <div class="accordion-header">
                  <h6>2. Làm thế nào để tôi có thể theo dõi đơn hàng của mình?</h6>
                  <i class="hgi hgi-stroke hgi-minus-sign"></i>
                  <i class="hgi hgi-stroke hgi-plus-sign"></i>
                </div>
                <div class="accordion-body">
                  <p>
                    Sau khi đơn hàng được gửi đi thành công, hệ thống sẽ gửi cho bạn một mã vận đơn chi tiết. Bạn có thể sử dụng mã vận đơn này trực tiếp trên trang "Tra cứu đơn hàng" trên website để theo dõi hành trình đơn hàng theo thời gian thực.
                  </p>
                </div>
              </div>
              <div
                class="accordion-item wow animate__animated animate__fadeInUp"
                data-wow-delay=".2s"
              >
                <div class="accordion-header">
                  <h6>3. Mất bao lâu để tôi có thể nhận được hàng?</h6>
                  <i class="hgi hgi-stroke hgi-minus-sign"></i>
                  <i class="hgi hgi-stroke hgi-plus-sign"></i>
                </div>
                <div class="accordion-body">
                  <p>
                    Thông thường thời gian vận chuyển sẽ dao động từ 2-4 ngày làm việc tùy thuộc vào địa chỉ giao hàng của bạn. Đối với các đơn hàng nội thành hoặc đơn giao nhanh, chúng tôi hỗ trợ giao ngay chỉ trong 24 giờ.
                  </p>
                </div>
              </div>
              <div
                class="accordion-item wow animate__animated animate__fadeInUp"
                data-wow-delay=".2s"
              >
                <div class="accordion-header">
                  <h6>4. Cửa hàng có hỗ trợ giao hàng quốc tế không?</h6>
                  <i class="hgi hgi-stroke hgi-minus-sign"></i>
                  <i class="hgi hgi-stroke hgi-plus-sign"></i>
                </div>
                <div class="accordion-body">
                  <p>
                    Hiện tại hệ thống hỗ trợ giao hàng trên khắp 63 tỉnh thành Việt Nam. Đối với nhu cầu vận chuyển đi nước ngoài, xin vui lòng liên hệ trực tiếp với bộ phận chăm sóc khách hàng của chúng tôi để được tư vấn chính sách cụ thể nhất.
                  </p>
                </div>
              </div>
              <div
                class="accordion-item wow animate__animated animate__fadeInUp"
                data-wow-delay=".2s"
              >
                <div class="accordion-header">
                  <h6>5. Tôi có thể hủy hoặc thay đổi thông tin đơn hàng không?</h6>
                  <i class="hgi hgi-stroke hgi-minus-sign"></i>
                  <i class="hgi hgi-stroke hgi-plus-sign"></i>
                </div>
                <div class="accordion-body">
                  <p>
                    Bạn có thể hủy hoặc điều chỉnh thông tin đơn hàng bất cứ lúc nào trước khi đơn hàng chuyển sang trạng thái "Đang giao hàng". Hãy liên hệ hotline hỗ trợ sớm nhất có thể để chúng tôi kịp thời xử lý cho bạn.
                  </p>
                </div>
              </div>
              <div
                class="accordion-item wow animate__animated animate__fadeInUp"
                data-wow-delay=".2s"
              >
                <div class="accordion-header">
                  <h6>6. Tôi có bắt buộc phải đăng ký tài khoản để mua sắm không?</h6>
                  <i class="hgi hgi-stroke hgi-minus-sign"></i>
                  <i class="hgi hgi-stroke hgi-plus-sign"></i>
                </div>
                <div class="accordion-body">
                  <p>
                    Bạn có thể đặt hàng nhanh chóng dưới tư cách khách vãng lai mà không cần đăng ký. Tuy nhiên, việc tạo tài khoản sẽ giúp bạn dễ dàng lưu trữ giỏ hàng, tích lũy điểm thưởng thành viên và nhận các chương trình ưu đãi độc quyền.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ========== FAQ Section End ========== -->
