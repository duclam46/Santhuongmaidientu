              {
                var hDisc = hv.DiscountType == "FreeShipping"
                  ? $"Freeship {hv.DiscountValue:N0}₫"
                  : (hv.DiscountType == "Percent" ? $"Giảm {hv.DiscountValue:0.##}%" : $"Giảm {hv.DiscountValue:N0}₫");
                var stubBg = hv.DiscountType == "FreeShipping"
                  ? "linear-gradient(135deg, #0369a1, #0ea5e9)"
                  : (hv.IsShopVoucher ? "linear-gradient(135deg, #c2410c, #f59e0b)" : "linear-gradient(135deg, #022c22, #008374)");
                <div class="col-span-12 sm:col-span-6 xl:col-span-3">
