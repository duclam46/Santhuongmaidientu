          >
            <div class="sellzy-cta-card w-full bg-[#FFC091]">
              <span class="sellzy-cta-icon">
                <i
                  class="hgi hgi-stroke hgi-delivery-return-02 text-3xl text-light-primary-text"
                ></i>
              </span>
