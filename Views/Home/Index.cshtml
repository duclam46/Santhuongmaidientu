@{
    var topCategoriesList = Model.TopCategories ?? new List<DOAN_BANHANG.ViewModels.CategoryLinkVm>();
    (string Type, string CircleBg) GetHomeCatVisual(DOAN_BANHANG.ViewModels.CategoryLinkVm item)
    {
        var name = (item.Name ?? string.Empty).Trim().ToLowerInvariant();
        var slug = (item.Slug ?? string.Empty).Trim().ToLowerInvariant();
        var icon = (item.IconUrl ?? string.Empty).Trim().ToLowerInvariant();

        if (slug.Contains("dien-thoai") || name.Contains("điện thoại") || icon.Contains("mobile")) return ("phone", "#DBEAFE");
        if (slug.Contains("may-tinh") || slug.Contains("laptop") || name.Contains("laptop") || name.Contains("máy tính") || icon.Contains("laptop")) return ("laptop", "#E0E7FF");
        if (slug.Contains("gia-dung") || name.Contains("gia dụng") || name.Contains("điện tử") || icon.Contains("fridge")) return ("appliance", "#CFFAFE");
        if (slug.Contains("thoi-trang-nam") || name.Contains("thời trang nam")) return ("men", "#DCFCE7");
        if (slug.Contains("thoi-trang-nu") || name.Contains("thời trang nữ")) return ("women", "#FCE7F3");
        if (slug.Contains("giay-dep") || slug.Contains("tui-xach") || name.Contains("giày") || name.Contains("túi") || icon.Contains("walk")) return ("shoes", "#FFEDD5");
        if (slug.Contains("my-pham") || slug.Contains("sac-dep") || name.Contains("mỹ phẩm") || name.Contains("sắc đẹp") || icon.Contains("spa")) return ("beauty", "#F3E8FF");
        if (slug.Contains("thuc-pham") || slug.Contains("do-uong") || name.Contains("thực phẩm") || name.Contains("đồ uống") || icon.Contains("bowl")) return ("food", "#FEE2E2");
        if (slug.Contains("nha-sach") || slug.Contains("van-phong") || name.Contains("sách") || name.Contains("văn phòng") || icon.Contains("book")) return ("book", "#FEF3C7");
        if (slug.Contains("san-pham-so") || slug.Contains("evoucher") || name.Contains("sản phẩm số") || name.Contains("voucher") || icon.Contains("barcode")) return ("digital", "#CCFBF1");
        return ("default", "#E6F4F3");
    }
}
