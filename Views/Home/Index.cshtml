    <!-- ========== Hand Picked Section Start ========== -->
    <section class="pb-[70px]">
      <div class="container">
        <div class="text-center pb-10 wow animate__animated animate__fadeInUp" data-wow-delay="0.2s">
          <span class="sellzy-section-eyebrow">Gợi ý dành riêng</span>
          <h2 class="sellzy-section-title">
            Sản phẩm tuyển chọn dành riêng cho bạn
          </h2>
        </div>
        <div class="grid grid-cols-12 gap-6">
          <!-- ========== Dynamic Product Cards Start ========== -->
          @if (Model.FeaturedProducts != null)
          {
              foreach (var product in Model.FeaturedProducts.Take(4))
              {
                  <div
                    class="xl:col-span-3 md:col-span-6 col-span-12 wow animate__animated animate__fadeInUp"
                    data-wow-delay="0.2s"
                  >
                    <div
                      class="border border-gray-300 rounded-2xl product-card-1 p-6 group h-full flex flex-col justify-between"
                    >
                      <div>
                          <!-- ========== Product Image Slider Start ========== -->
                          <div
                            class="mb-3 -mx-3 home-four-hand-picked-big-slider-@product.ProductId sellzy-slider"
                            data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "loop": true, "arrows": false, "infinite": true, "asNavFor": ".home-four-hand-picked-small-slider-@product.ProductId"}'
                          >
                            @if (product.ImageUrls != null && product.ImageUrls.Any())
                            {
                                foreach (var imgUrl in product.ImageUrls)
                                {
                                    <div class="mx-3">
                                      <a href="@Url.RouteUrl("product_details", new { slug = product.Slug })">
                                        <img
                                          src="@imgUrl"
                                          alt="@product.Name"
                                          class="bg-[#F4F3F5] rounded-2xl w-full"
                                          style="aspect-ratio: 1/1; object-fit: cover;"
                                        />
                                      </a>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="mx-3">
                                  <a href="@Url.RouteUrl("product_details", new { slug = product.Slug })">
                                    <img
                                      src="@product.PrimaryImageUrl"
                                      alt="@product.Name"
                                      class="bg-[#F4F3F5] rounded-2xl w-full"
                                      style="aspect-ratio: 1/1; object-fit: cover;"
                                    />
                                  </a>
                                </div>
                            }
                          </div>

                          <div
                            class="mb-3 -mx-1.5 home-four-hand-picked-small-slider-@product.ProductId sellzy-slider"
                            data-slick='{"slidesToShow": 3, "slidesToScroll": 1, "loop": true, "arrows": false, "infinite": true, "asNavFor": ".home-four-hand-picked-big-slider-@product.ProductId"}'
                          >
                            @if (product.ImageUrls != null && product.ImageUrls.Any())
                            {
                                foreach (var imgUrl in product.ImageUrls)
                                {
                                    <div class="mx-1.5">
                                      <img
                                        src="@imgUrl"
                                        alt="@product.Name"
                                        class="bg-[#F4F3F5] rounded-2xl w-full cursor-pointer"
                                        style="aspect-ratio: 1/1; object-fit: cover;"
                                      />
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="mx-1.5">
                                  <img
                                    src="@product.PrimaryImageUrl"
                                    alt="@product.Name"
                                    class="bg-[#F4F3F5] rounded-2xl w-full cursor-pointer"
                                    style="aspect-ratio: 1/1; object-fit: cover;"
                                  />
                                </div>
                            }
                          </div>
                          <!-- ========== Product Image Slider End ========== -->

                          <div class="product-content">
                            <h5 class="sellzy-product-title">
                              <a href="@Url.RouteUrl("product_details", new { slug = product.Slug })" class="line-clamp-2 transition-colors">
                                  @product.Name
                              </a>
                            </h5>
                            <div class="rating-section flex items-center mb-4">
                              <div
                                class="bg-[url('../images/star-icon.png')] w-[90px] h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]"
                              >
                                <div
                                  style="width: @(product.RatingAverage * 20)%"
                                  class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"
                                ></div>
                              </div>
                              <span
                                class="text-sm leading-[22px] font-normal inline-block ml-1"
                                >(@product.RatingCount)</span
                              >
                            </div>

                            <!-- ========== Dynamic Size Selection Start ========== -->
                            @if (product.Sizes != null && product.Sizes.Any())
                            {
                                <div class="size-variation-section mb-4">
                                  <div
                                    class="size-variation-items flex items-center gap-3 2xl:flex-nowrap flex-wrap"
                                  >
                                    @foreach (var size in product.Sizes)
                                    {
                                        <div class="size-variation-item">
                                          <button
                                            type="button"
                                            data-size-text="@size"
                                            class="cursor-pointer flex items-center justify-center text-sm leading-[26px] px-4 py-[7px] text-light-primary-text font-semibold border border-gray-300 rounded-lg hover:bg-[rgba(145,158,171,0.08)] text-[16px]"
                                          >
                                            @size
                                          </button>
                                        </div>
                                    }
                                  </div>
                                </div>
                            }
                            <!-- ========== Dynamic Size Selection End ========== -->

                            <!-- ========== Dynamic Color Selection Start ========== -->
                            @if (product.Colors != null && product.Colors.Any())
                            {
                                <div class="variation-buttons flex gap-x-2.5 mb-4">
                                  @foreach (var color in product.Colors)
                                  {
                                      <div
                                        class="variation-color-item p-1 border border-gray-300 rounded-full"
                                      >
                                        <button
                                          type="button"
                                          data-color="@color.Code"
                                          style="background-color: @(string.IsNullOrEmpty(color.Code) ? "#ccc" : color.Code);"
                                          class="size-6 rounded-full flex items-center justify-center cursor-pointer"
                                          title="@color.Name"
                                        >
                                          <i
                                            class="hgi hgi-stroke hgi-tick-02 text-white hidden"
                                          ></i>
                                        </button>
                                      </div>
                                  }
                                </div>
                            }
                            <!-- ========== Dynamic Color Selection End ========== -->
                          </div>
                      </div>

                      <div>
                          <div class="sellzy-price-row">
                            <span class="sellzy-price-current">
                                @product.Price.ToString("N0")đ
                            </span>
                            @if (product.OldPrice.HasValue && product.OldPrice.Value > product.Price)
                            {
                                <span class="sellzy-price-old">
                                    @product.OldPrice.Value.ToString("N0")đ
                                </span>
                                <span class="sellzy-price-off">
                                    -@product.DiscountPercent%
                                </span>
                            }
                          </div>

                          <div class="btn-section flex items-center gap-x-4">
                            <button type="button" data-wishlist-toggle data-product-id="@product.ProductId" class="size-11 flex flex-none items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 border border-gray-300">
                              <i class="hgi hgi-stroke hgi-favourite text-xl text-light-secondary-text"></i>
                            </button>

                            <a class="btn btn-primary rounded-full font-semibold text-sm leading-6 px-6.5 py-2 flex-1 flex items-center justify-center gap-2" href="#" data-add-to-cart data-variant-id="@product.DefaultVariantId">
                              <i class="hgi hgi-stroke hgi-shopping-cart-02 text-xl text-white"></i>
                              <span>Thêm vào giỏ</span>
                            </a>
                          </div>
                      </div>
                    </div>
                  </div>
              }
          }

        </div>
      </div>
    </section>
    <!-- ========== Hand Picked Section End ========== -->

    <!-- ========== Promo Section Start ========== -->
