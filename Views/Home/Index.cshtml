@model DOAN_BANHANG.ViewModels.HomeIndexVm
@section Styles {
  <style>
    /* ========== HOME PAGE REDESIGN STYLES ========== */
    .sellzy-section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #088178;
      background-color: #E6F4F3;
      padding: 5px 14px;
      border-radius: 999px;
      margin-bottom: 10px;
    }
    .sellzy-section-title {
      font-size: clamp(24px, 2.5vw, 32px);
      line-height: 1.25;
      font-weight: 800;
      color: #161C24;
      letter-spacing: -0.02em;
    }

    /* Hero Slider */
    .sellzy-hero-wrap {
      position: relative;
    }
    .home-four-hero-slider .slick-list {
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 18px 40px -14px rgba(22, 28, 36, 0.12);
    }
    .home-four-hero-slider .slick-dots {
      margin-top: 14px;
    }
    .home-four-hero-slider-nav {
      pointer-events: none;
      z-index: 10;
    }
    .home-four-hero-slider-nav button {
      pointer-events: auto;
      width: 44px !important;
      height: 44px !important;
      border-radius: 50% !important;
      background-color: rgba(255, 255, 255, 0.92) !important;
      color: #161C24 !important;
      border: 1px solid rgba(22, 28, 36, 0.08) !important;
      box-shadow: 0 6px 16px rgba(22, 28, 36, 0.12) !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      transition: all 0.25s ease !important;
    }
    .home-four-hero-slider-nav button:hover {
      background-color: #088178 !important;
      color: #ffffff !important;
      border-color: #088178 !important;
      transform: scale(1.06);
    }
    .single-hero-slider-item {
      position: relative;
      overflow: hidden;
      min-height: 460px;
      padding: 40px 28px !important;
      background-position: center center !important;
      background-size: cover !important;
    }
    @@media (min-width: 768px) {
      .single-hero-slider-item {
        min-height: 540px;
        padding: 48px 40px 48px 88px !important;
      }
    }
    @@media (min-width: 1280px) {
      .single-hero-slider-item {
        min-height: 580px;
        padding: 56px 48px 56px 128px !important;
      }
    }
    .single-hero-slider-content {
      position: relative;
      z-index: 2;
      max-width: 520px;
    }
    .sellzy-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background-color: rgba(255, 255, 255, 0.92);
      border: 1px solid rgba(8, 129, 120, 0.2);
      color: #056D6E;
      font-size: 13px;
      font-weight: 700;
      padding: 6px 15px;
      border-radius: 999px;
      box-shadow: 0 4px 12px rgba(8, 129, 120, 0.08);
      margin-bottom: 16px;
    }
    .sellzy-hero-badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #088178;
      display: inline-block;
    }
    .single-hero-slider-content h2 {
      font-size: clamp(28px, 3.2vw, 44px);
      line-height: 1.18;
      font-weight: 800;
      color: #161C24;
      margin-bottom: 14px;
      padding: 0;
    }
    .single-hero-slider-content p {
      font-size: 15.5px;
      line-height: 1.65;
      color: #212B36;
      margin-bottom: 24px;
    }

    /* Category Cards */
    .sellzy-cat-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    @@media (min-width: 768px) {
      .sellzy-cat-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }
    }
    @@media (min-width: 1200px) {
      .sellzy-cat-grid {
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 16px;
      }
    }
    .sellzy-cat-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 16px 12px;
      border-radius: 16px;
      background-color: #ffffff;
      border: 1px solid rgba(22, 28, 36, 0.08);
      box-shadow: 0 2px 10px rgba(22, 28, 36, 0.03);
      height: 100%;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
    }
    .sellzy-cat-card:hover {
      transform: translateY(-4px);
      background-color: #ffffff;
      border-color: rgba(8, 129, 120, 0.4);
      box-shadow: 0 12px 24px -8px rgba(8, 129, 120, 0.16);
    }
    .sellzy-cat-icon-box {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
      transition: transform 0.25s ease;
    }
    .sellzy-cat-card:hover .sellzy-cat-icon-box {
      transform: scale(1.08);
    }
    .sellzy-cat-icon-box svg,
    .sellzy-cat-icon-box img {
      width: 28px;
      height: 28px;
      object-fit: contain;
    }
    .sellzy-cat-name {
      font-size: 13.5px;
      font-weight: 700;
      line-height: 1.35;
      color: #161C24;
      margin-bottom: 6px;
      transition: color 0.2s ease;
    }
    .sellzy-cat-card:hover .sellzy-cat-name {
      color: #088178;
    }
    .sellzy-cat-count {
      font-size: 11.5px;
      font-weight: 600;
      color: #056D6E;
      background-color: #E6F4F3;
      padding: 2px 9px;
      border-radius: 999px;
      margin: 0;
    }

    /* Unified Product Card Polish */
    .sellzy-product-title {
      font-size: 16px !important;
      line-height: 1.45 !important;
      font-weight: 700 !important;
      color: #161C24;
      height: 46px;
      overflow: hidden;
      margin-bottom: 8px;
    }
    .sellzy-product-title a:hover {
      color: #088178;
    }
    .sellzy-price-row {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }
    .sellzy-price-current {
      font-size: 17px;
      font-weight: 800;
      color: #088178;
    }
    .sellzy-price-old {
      font-size: 13.5px;
      color: #919EAB;
      text-decoration: line-through;
    }
    .sellzy-price-off {
      font-size: 11.5px;
      font-weight: 700;
      color: #B71D18;
      background-color: #FFE4DE;
      padding: 2px 7px;
      border-radius: 6px;
    }
    .product-card-1 {
      padding: 18px !important;
      overflow: hidden;
    }
    .product-card-1 .variation-buttons {
      min-height: 36px;
      align-items: center;
    }
    .product-card-1 .btn-section {
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
      width: 100% !important;
      margin-top: auto;
    }
    .product-card-1 .btn-section button[data-wishlist-toggle] {
      width: 40px !important;
      height: 40px !important;
      min-width: 40px !important;
      flex: 0 0 40px !important;
    }
    .product-card-1 .btn-section .btn {
      flex: 1 1 0% !important;
      min-width: 0 !important;
      padding: 8px 10px !important;
      font-size: 13px !important;
      line-height: 20px !important;
      gap: 6px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      white-space: nowrap !important;
    }
    .product-card-1 .btn-section .btn i {
      font-size: 17px !important;
      flex-shrink: 0;
    }
    .home-four-picks-slider .slick-track {
      display: flex !important;
      align-items: stretch !important;
    }
    .home-four-picks-slider .slick-slide {
      height: auto !important;
      display: flex !important;
    }
    .home-four-picks-slider .slick-slide > div {
      width: 100%;
      display: flex;
    }

    /* Deal & Category Filter Tabs */
    .home-four-product-filter,
    .home-four-category-filter {
      scrollbar-width: none;
    }
    .home-four-product-filter::-webkit-scrollbar,
    .home-four-category-filter::-webkit-scrollbar {
      display: none;
    }
    .home-four-product-filter button {
      white-space: nowrap;
      font-size: 14px;
      font-weight: 600;
      padding: 9px 16px;
      border-radius: 999px;
      color: #454F5B;
      background-color: #F4F6F8 !important;
      border: 1px solid rgba(145, 158, 171, 0.24) !important;
      transition: all 0.22s ease;
    }
    .home-four-product-filter button:hover {
      color: #088178;
      background-color: #E6F4F3 !important;
      border-color: rgba(8, 129, 120, 0.35) !important;
    }
    .home-four-product-filter button.border-b-2,
    .home-four-product-filter button.font-semibold {
      background: linear-gradient(135deg, #088178 0%, #056d6e 100%) !important;
      color: #ffffff !important;
      border-color: transparent !important;
      box-shadow: 0 6px 16px -4px rgba(8, 129, 120, 0.45);
    }
    .home-four-category-filter button {
      white-space: nowrap;
      font-size: 18px;
      line-height: 1.4;
      font-weight: 700;
      padding: 10px 22px;
      border-radius: 999px;
      color: #454F5B;
      background-color: #F4F6F8 !important;
      border: 1px solid rgba(145, 158, 171, 0.24);
      transition: all 0.22s ease;
    }
    .home-four-category-filter button:hover {
      color: #088178;
      background-color: #E6F4F3 !important;
    }
    .home-four-category-filter button.text-primary {
      background: linear-gradient(135deg, #088178 0%, #056d6e 100%) !important;
      color: #ffffff !important;
      border-color: transparent;
      box-shadow: 0 6px 16px -4px rgba(8, 129, 120, 0.45);
    }
    @@media (max-width: 767px) {
      .home-four-category-filter button {
        font-size: 16px;
        padding: 8px 14px;
      }
    }

    /* Promo Bento Cards */
    .sellzy-promo-card {
      border-radius: 24px;
      overflow: hidden;
      min-height: 520px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      text-align: center;
      position: relative;
      box-shadow: 0 12px 30px -10px rgba(22, 28, 36, 0.12);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .sellzy-promo-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px -12px rgba(22, 28, 36, 0.16);
    }
    .sellzy-promo-card-top {
      justify-content: flex-start;
    }
    .sellzy-promo-box {
      padding: 26px 24px;
    }

    /* Promo Section 2: Clean Multi-Industry Bento Grid */
    .sellzy-promo2-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }
    @@media (min-width: 768px) {
      .sellzy-promo2-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .sellzy-promo2-wide {
        grid-column: span 2 / span 2;
      }
    }
    @@media (min-width: 1200px) {
      .sellzy-promo2-grid {
        grid-template-columns: 2fr 1fr 1fr;
      }
      .sellzy-promo2-wide {
        grid-column: span 1 / span 1;
      }
    }
    .sellzy-bento2-card {
      border-radius: 24px;
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 290px;
      box-shadow: 0 10px 28px -10px rgba(22, 28, 36, 0.10);
      transition: transform 0.28s ease, box-shadow 0.28s ease;
    }
    .sellzy-bento2-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 36px -12px rgba(22, 28, 36, 0.16);
    }
    .sellzy-bento2-wide-inner {
      display: flex;
      flex-direction: column;
      gap: 20px;
      height: 100%;
    }
    @@media (min-width: 768px) {
      .sellzy-bento2-wide-inner {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }
    .sellzy-bento2-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 12px;
    }
    .sellzy-bento2-title {
      font-size: 20px;
      font-weight: 800;
      color: #161C24;
      margin: 0 0 8px 0;
      line-height: 1.3;
    }
    .sellzy-bento2-desc {
      font-size: 13.5px;
      line-height: 1.55;
      color: #454F5B;
      margin: 0 0 18px 0;
    }
    .sellzy-bento2-mini {
      background: #ffffff;
      border-radius: 16px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 4px 14px rgba(22, 28, 36, 0.05);
    }
    .sellzy-bento2-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.92);
      padding: 6px 12px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 16px;
    }
    .sellzy-promo-box h3,
    .sellzy-promo-box h4 {
      font-size: 22px;
      line-height: 1.3;
      font-weight: 800;
      color: #161C24;
      margin: 10px 0 8px;
    }
    .sellzy-promo-box p {
      font-size: 14px;
      line-height: 1.55;
      color: #212B36;
      margin-bottom: 16px;
    }
    .sellzy-promo-pill {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 700;
      color: #161C24;
    }

    /* Marquee & Brand Logos */
    .sellzy-marquee-wrap {
      border-radius: 20px;
      background: linear-gradient(90deg, #E6F4F3 0%, #F0FAF9 50%, #E6F4F3 100%);
      border: 1px solid rgba(8, 129, 120, 0.12);
    }
    .sellzy-brand-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
    @@media (min-width: 768px) {
      .sellzy-brand-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }
    }
    @@media (min-width: 1200px) {
      .sellzy-brand-grid {
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 16px;
      }
    }
    .sellzy-brand-tile {
      padding: 16px 14px;
      border-radius: 16px;
      background-color: #F8FAFC;
      border: 1px solid rgba(22, 28, 36, 0.06);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 4px;
      text-decoration: none;
      transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
    }
    .sellzy-brand-tile:hover {
      transform: translateY(-3px);
      background-color: #ffffff;
      border-color: rgba(8, 129, 120, 0.35);
      box-shadow: 0 10px 24px -6px rgba(8, 129, 120, 0.14);
    }
    .sellzy-brand-name {
      font-family: "Plus Jakarta Sans", "Be Vietnam Pro", sans-serif;
      font-size: 17px;
      font-weight: 800;
      letter-spacing: 0.02em;
      color: #161C24;
      transition: color 0.2s ease;
    }
    .sellzy-brand-tile:hover .sellzy-brand-name {
      color: #088178;
    }
    .sellzy-brand-sub {
      font-size: 11.5px;
      font-weight: 600;
      color: #637381;
    }
  </style>
}
    <!-- ========== Hero Section Start ========== -->
    <section class="pt-6">
      <div class="container">
        @if (Model.ActiveCampaigns != null && Model.ActiveCampaigns.Count > 0)
        {
          var topCamp = Model.ActiveCampaigns[0];
          <div style="background: linear-gradient(135deg, #022c22 0%, #065f5b 55%, #008374 100%); border-radius: 20px; padding: 14px 22px; margin-bottom: 18px; color: #ffffff; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; box-shadow: 0 12px 28px -12px rgba(2, 44, 34, 0.45);">
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
              <span style="background: #fde047; color: #022c22; font-size: 11px; font-weight: 900; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; letter-spacing: 0.05em;">
                🔥 CHIẾN DỊCH SÀN
              </span>
              <strong style="font-size: 15.5px; color: #ffffff;">@topCamp.Name</strong>
              @if (!string.IsNullOrWhiteSpace(topCamp.DiscountUpToText))
              {
                <span style="background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.24); color: #fde047; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px;">
                  @topCamp.DiscountUpToText
                </span>
              }
              <span style="font-size: 13px; color: rgba(255,255,255,0.85);">@topCamp.Description</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <a href="/vouchers" style="background: #fde047; color: #022c22; font-size: 12.5px; font-weight: 800; padding: 7px 16px; border-radius: 999px; text-decoration: none; white-space: nowrap;">
                🎟️ Trạm Săn Voucher →
              </a>
              <a href="/Home/FlashSale" style="background: rgba(255,255,255,0.15); color: #ffffff; font-size: 12.5px; font-weight: 700; padding: 7px 14px; border-radius: 999px; text-decoration: none; white-space: nowrap;">
                ⚡ Flash Sale
              </a>
            </div>
          </div>
        }
        <div class="relative sellzy-hero-wrap">
          <div
            class="home-four-hero-slider rounded-3xl relative md:bg-transparent bg-[#FFEB69] sellzy-slider"
            data-slick='{"slidesToShow": 1, "slidesToScroll": 1, "loop": true, "arrows": true, "infinite": true, "dots": true, "appendArrows": ".home-four-hero-slider-nav", "autoplay": true, "autoplaySpeed": 7000, "fade": true, "responsive": [{"breakpoint": 1025, "settings": {"arrows": false}}]}'
          >
            @if (Model.DynamicBanners != null && Model.DynamicBanners.Count > 0)
            {
              foreach (var dbBanner in Model.DynamicBanners)
              {
                var bgUrl = global::DOAN_BANHANG.Helpers.ImageUrlHelper.NormalizeStaticFileUrl(dbBanner.ImageUrl) ?? "/assets/images/home-4/hero-1.png";
                <div class="bg-center bg-no-repeat bg-cover rounded-3xl single-hero-slider-item flex! items-center md:h-[600px]! h-[500px]!"
                     style="background-image: url('@bgUrl');">
                  <div class="single-hero-slider-content">
                    @if (!string.IsNullOrWhiteSpace(dbBanner.BadgeText))
                    {
                      <div class="sellzy-hero-badge">
                        <span class="sellzy-hero-badge-dot"></span>
                        <span>@dbBanner.BadgeText</span>
                      </div>
                    }
                    <h2>@dbBanner.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(dbBanner.Subtitle))
                    {
                      <p>@dbBanner.Subtitle</p>
                    }
                    <a class="btn btn-primary text-white btn-large rounded-[60px] group py-2.5 pl-6 pr-3 shadow-md" href="@(string.IsNullOrWhiteSpace(dbBanner.LinkUrl) ? "/vouchers" : dbBanner.LinkUrl)">
                      @(string.IsNullOrWhiteSpace(dbBanner.ButtonText) ? "Khám Phá Ngay" : dbBanner.ButtonText)
                      <span class="size-8 bg-white inline-flex items-center justify-center rounded-full rotate-[-40deg] transform group-hover:rotate-0 transition-all duration-300">
                        <i class="hgi hgi-stroke hgi-arrow-right-02 text-xl text-primary-darker"></i>
                      </span>
                    </a>
                  </div>
                </div>
              }
            }
            <div
              class="md:bg-[url(../images/home-4/hero-1.png)] bg-center bg-no-repeat bg-cover rounded-3xl single-hero-slider-item flex! items-center md:h-[600px]! h-[500px]!"
              data-wow-delay=".2s"
            >
              <!-- Content Section -->
              <div class="single-hero-slider-content">
                <div class="sellzy-hero-badge">
                  <span class="sellzy-hero-badge-dot"></span>
                  <span>Ưu đãi 30% cho đơn đầu tiên từ 500.000đ</span>
                </div>
                <h2>
                  Khám Phá Các <br class="hidden lg:block" />
                  Phong Cách Mới Nhất Mùa Này
                </h2>
                <p>
                  Khám phá bộ sưu tập mới nhất với xu hướng, màu sắc và kiểu dáng
                  giúp nâng tầm vẻ ngoài mỗi ngày của bạn.
                </p>
                <a class='btn btn-primary text-white btn-large rounded-[60px] group py-2.5 pl-6 pr-3 shadow-md' href='@(Url.RouteUrl("shop_index") ?? Url.Action("Index", "Shop"))'>
                  Mua Ngay
                  <span
                    class="size-8 bg-white inline-flex items-center justify-center rounded-full rotate-[-40deg] transform group-hover:rotate-0 transition-all duration-300"
                  >
                    <i
                      class="hgi hgi-stroke hgi-arrow-right-02 text-xl text-primary-darker"
                    ></i>
                  </span>
                </a>
              </div>
            </div>
            <div
              class="md:bg-[url(../images/home-4/hero-2.png)] bg-center bg-no-repeat bg-cover rounded-3xl single-hero-slider-item flex! items-center md:h-[600px]! h-[500px]!"
              data-wow-delay=".2s"
            >
              <!-- Content Section -->
              <div class="single-hero-slider-content">
                <div class="sellzy-hero-badge">
                  <span class="sellzy-hero-badge-dot"></span>
                  <span>Ưu đãi 30% cho đơn đầu tiên từ 500.000đ</span>
                </div>
                <h2>Giữ Ấm Với Chi Phí Tiết Kiệm</h2>
                <p>
                  Nhận ưu đãi đặc biệt cho áo len, hoodie, áo khoác và các sản phẩm
                  giữ ấm mùa đông với chất liệu mềm mịn, bền đẹp.
                </p>
