                                      aria-label="Xem nhanh"
                                      class="quick-view-sidebar-btn product-btn-action-item relative size-11 bg-white inline-flex items-center justify-center rounded-tr-sm rounded-br-sm before:absolute before:left-[calc(50%-8px)] before:bottom-full before:z-9 before:border-8 before:border-transparent before:border-t-black before:opacity-0 before:invisible before:-mb-3.5 hover:before:opacity-100 hover:before:visible before:transition-all before:duration-300 after:absolute after:bottom-full after:left-1/2 after:-translate-x-1/2 after:rounded-sm after:bg-gray-800 after:whitespace-nowrap after:text-white after:text-xs after:leading-[18px] after:py-[3px] after:px-2 after:content-[attr(aria-label)] after:opacity-0 after:invisible after:transition-all after:duration-300 hover:after:opacity-100 hover:after:visible hover:after:-translate-y-2.5 hover:before:-translate-y-2.5"
                                      href="#"
                                      data-quick-view-url="@Url.Action("QuickView", "Products", new { id = product.ProductId })"
                                    >
                                      <i class="hgi hgi-stroke hgi-view text-xl text-light-primary-text"></i>
                                    </a>
                                  </li>
                                </ul>
                              </div>
                            </div>

                            <div class="product-content flex-1 flex flex-col justify-between">
                              <div>
                                <h5 class="sellzy-product-title">
                                  <a href="@Url.RouteUrl("product_details", new { slug = product.Slug })" class="line-clamp-2 transition-colors">
                                      @product.Name
                                  </a>
                                </h5>
                                <div class="rating-section flex items-center mb-4">
                                  <div
                                    class="bg-[url('../images/star-icon.png')] w-[90px] h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]"
                                  >
                                    <div
                                      style="width: @(product.RatingAverage * 20)%"
                                      class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"
                                    ></div>
                                  </div>
                                  <span
                                    class="text-sm leading-[22px] font-normal inline-block ml-1"
                                    >(@product.RatingCount)</span
                                  >
                                </div>

                                <!-- ========== Size Selection ========== -->
                                @if (product.Sizes != null && product.Sizes.Any())
                                {
                                    <div class="size-variation-section mb-4">
                                      <div class="size-variation-items flex items-center gap-2 flex-wrap">
                                        @foreach (var size in product.Sizes)
                                        {
                                            <div class="size-variation-item">
                                              <button
                                                data-size-text="@size"
                                                class="cursor-pointer flex items-center justify-center text-xs leading-5 px-2.5 py-1 text-light-primary-text font-semibold border border-gray-300 rounded-lg hover:bg-[rgba(145,158,171,0.08)]"
                                              >
                                                @size
                                              </button>
                                            </div>
                                        }
                                      </div>
                                    </div>
                                }

                                <!-- ========== Color Selection ========== -->
                                @if (product.Colors != null && product.Colors.Any())
                                {
                                    <div class="variation-buttons flex gap-x-2 mb-4">
                                      @foreach (var color in product.Colors)
                                      {
                                          <div class="variation-color-item p-0.5 border border-gray-300 rounded-full">
                                            <button
                                              data-color="@color.Code"
                                              style="background-color: @color.Code;"
                                              class="size-5 rounded-full flex items-center justify-center cursor-pointer"
                                            >
                                              <i class="hgi hgi-stroke hgi-tick-02 text-[10px] text-white hidden"></i>
                                            </button>
                                          </div>
                                      }
                                    </div>
                                }
                              </div>

                              <div>
                                <div class="sellzy-price-row">
                                  <span class="sellzy-price-current">
                                    @product.Price.ToString("N0")đ
                                  </span>
                                  @if (product.OldPrice.HasValue && product.OldPrice.Value > product.Price)
                                  {
                                      <span class="sellzy-price-old">
                                        @product.OldPrice.Value.ToString("N0")đ
                                      </span>
                                      <span class="sellzy-price-off">
                                        -@product.DiscountPercent%
                                      </span>
                                  }
                                </div>
                                <div class="btn-section flex items-center gap-x-3 mt-auto">
                                  <button type="button" data-wishlist-toggle data-product-id="@product.ProductId" class="size-10 flex flex-none items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 border border-gray-300">
                                    <i class="hgi hgi-stroke hgi-favourite text-lg text-light-secondary-text"></i>
                                  </button>
                                  <a class="btn btn-primary rounded-full font-semibold text-xs leading-5 py-2 flex-1 flex items-center justify-center gap-1.5" href="#" data-add-to-cart data-variant-id="@product.DefaultVariantId">
                                    <i class="hgi hgi-stroke hgi-shopping-cart-02 text-lg text-white"></i>
                                    <span>Thêm vào giỏ</span>
                                  </a>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                    }
                }
            </div>
          </div>
          <!-- ========== Most Wanted Tab End ========== -->
        </div>

        <div
          class="home-four-category-slider-nav-bottom flex items-center justify-center gap-x-6 mt-7 md:hidden"
        ></div>
      </div>
    </section>
    <!-- ========== Category Product Section End ========== -->

    <!-- ========== CTA Section Start ========== -->
