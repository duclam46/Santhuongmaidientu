                    <div style="width:74px; flex-shrink:0; background:@stubBg; color:#ffffff; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:10px 6px; text-align:center; border-right:2px dashed rgba(255,255,255,0.5);">
                      <span style="font-size:18px;">@(hv.DiscountType == "FreeShipping" ? "🚚" : (hv.IsShopVoucher ? "🏪" : "💎"))</span>
                      <span style="font-size:9.5px; font-weight:800; text-transform:uppercase; margin-top:3px;">@hv.SponsorBadge</span>
