                        <div style="font-size:11.5px; color:#64748b; margin-top:2px;">Đơn từ @hv.MinOrderValue.ToString("N0")₫</div>
                      </div>
                      <div style="display:flex; align-items:center; justify-content:space-between; gap:6px; margin-top:8px;">
                        <span style="font-size:10.5px; font-family:monospace; font-weight:700; color:#475569;">@hv.Code</span>
                        <button type="button"
                                onclick="saveHomeHotVoucher(@hv.Id, '@hv.Code', this)"
                                style="border:none; border-radius:999px; padding:4px 11px; font-size:11px; font-weight:800; cursor:pointer; background:@(hv.IsSaved ? "#ecfdf5" : "#008374"); color:@(hv.IsSaved ? "#059669" : "#ffffff"); border:@(hv.IsSaved ? "1px solid #a7f3d0" : "none");">
                          @(hv.IsSaved ? "✓ Đã lưu" : "Lưu mã")
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              }
            </div>
          </div>
        </div>
      </section>
      <script>
        async function saveHomeHotVoucher(voucherId, code, btnEl) {
          try {
            const res = await fetch('/vouchers/save', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({ voucherId, code })
            });
            if (res.ok && btnEl) {
              btnEl.textContent = '✓ Đã lưu';
              btnEl.style.background = '#ecfdf5';
              btnEl.style.color = '#059669';
              btnEl.style.border = '1px solid #a7f3d0';
            }
          } catch (e) {}
        }
      </script>
    }

