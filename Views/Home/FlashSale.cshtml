@model DOAN_BANHANG.ViewModels.FlashSalePageVm

@{
  ViewData["Title"] = "Flash Sale";
  var viVn = global::System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

  string ResolveImageUrl(string? rawUrl)
  {
    if (string.IsNullOrWhiteSpace(rawUrl))
    {
      return Url.Content("~/assets/images/vitamin-c.png");
    }

    rawUrl = rawUrl.Trim();

    if (rawUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
        || rawUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
        || rawUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
    {
      return rawUrl;
    }

    if (rawUrl.StartsWith("~/", StringComparison.Ordinal))
    {
      return Url.Content(rawUrl);
    }

    if (rawUrl.StartsWith("/", StringComparison.Ordinal))
    {
      return rawUrl;
    }

    return Url.Content("~/" + rawUrl.TrimStart('/'));
  }

  string DetailsUrl(string slug) => Url.RouteUrl("product_details", new { slug }) ?? "#";
}

