@{
    ViewData["Title"] = "Giới thiệu";
}

@section Styles {
  <style>
    /* ========== MULTI-INDUSTRY ABOUT PAGE ========== */
    .ab-hero {
      background: radial-gradient(circle at 85% 20%, rgba(8, 129, 120, 0.35) 0%, transparent 50%),
                  linear-gradient(135deg, #00262A 0%, #033E44 55%, #065B5E 100%);
      border-radius: 32px;
      padding: 44px 48px;
      color: #ffffff;
      position: relative;
      overflow: hidden;
      box-shadow: 0 24px 50px -16px rgba(0, 38, 42, 0.35);
    }
    @@media (max-width: 767px) {
      .ab-hero {
        padding: 28px 20px;
        border-radius: 24px;
      }
    }
    .ab-breadcrumb {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.72);
      margin-bottom: 24px;
    }
    .ab-breadcrumb a {
      color: rgba(255, 255, 255, 0.85);
      transition: color 0.2s;
    }
    .ab-breadcrumb a:hover {
      color: #FFEB69;
    }
    .ab-hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 235, 105, 0.14);
      border: 1px solid rgba(255, 235, 105, 0.35);
      color: #FFEB69;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 18px;
    }
    .ab-hero-title {
      font-size: clamp(30px, 3.6vw, 46px);
      line-height: 1.18;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.02em;
      margin-bottom: 18px;
    }
    .ab-hero-title span {
      color: #FFEB69;
    }
    .ab-hero-desc {
      font-size: 16px;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.84);
      max-width: 540px;
      margin-bottom: 28px;
    }
    .ab-lookbook-stack {
      position: relative;
      display: grid;
      grid-template-columns: 1.12fr 0.88fr;
      gap: 16px;
      align-items: end;
    }
    @@media (max-width: 575px) {
      .ab-lookbook-stack {
        grid-template-columns: 1fr;
      }
    }
    .ab-lookbook-main {
      border-radius: 24px;
      overflow: hidden;
      height: 390px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.28);
      border: 1px solid rgba(255, 255, 255, 0.16);
      background-color: #ffffff;
    }
    .ab-lookbook-side {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .ab-lookbook-sub {
      border-radius: 22px;
      overflow: hidden;
      height: 235px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background-color: #ffffff;
    }
    .ab-lookbook-main img,
    .ab-lookbook-sub img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .ab-glass-stat {
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 20px;
      padding: 18px 20px;
    }

    /* Section Headings */
    .ab-eyebrow {
      display: inline-block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #088178;
      margin-bottom: 8px;
    }
    .ab-heading {
      font-size: clamp(26px, 2.8vw, 36px);
      line-height: 1.25;
      font-weight: 800;
      color: #161C24;
      letter-spacing: -0.02em;
    }

    /* Bento Grid */
    .ab-bento-grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 20px;
    }
    .ab-bento-card {
      border-radius: 26px;
      padding: 32px;
      position: relative;
      overflow: hidden;
      transition: transform 0.28s ease, box-shadow 0.28s ease;
    }
    .ab-bento-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 36px -12px rgba(22, 28, 36, 0.12);
    }
    .ab-bento-a {
      grid-column: span 7;
      background: linear-gradient(135deg, #EAF7F6 0%, #F4FBFB 100%);
      border: 1px solid rgba(8, 129, 120, 0.14);
    }
    .ab-bento-b {
      grid-column: span 5;
      background-color: #FFEB69;
      color: #161C24;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .ab-bento-c {
      grid-column: span 5;
      background-color: #161C24;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .ab-bento-d {
      grid-column: span 7;
      padding: 0;
      min-height: 270px;
      background-color: #F4F6F8;
    }
    @@media (max-width: 991px) {
      .ab-bento-a, .ab-bento-b, .ab-bento-c, .ab-bento-d {
        grid-column: span 12;
      }
    }
    .ab-pillar-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #ffffff;
      border: 1px solid rgba(8, 129, 120, 0.15);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 13.5px;
      font-weight: 600;
      color: #161C24;
    }

    /* Multi-Industry Ecosystem Grid */
    .ab-industry-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    @@media (max-width: 991px) {
      .ab-industry-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @@media (max-width: 639px) {
      .ab-industry-grid {
        grid-template-columns: 1fr;
      }
    }
    .ab-industry-card {
      background: #ffffff;
      border: 1px solid #E5E7EB;
      border-radius: 22px;
      padding: 26px 24px;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .ab-industry-card:hover {
      transform: translateY(-4px);
      border-color: #088178;
      box-shadow: 0 16px 32px -12px rgba(8, 129, 120, 0.14);
    }
    .ab-industry-icon {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin-bottom: 16px;
    }

    /* Timeline */
    .ab-timeline-wrap {
      background-color: #F8FAFC;
      border-radius: 32px;
      padding: 56px 36px;
      border: 1px solid rgba(22, 28, 36, 0.06);
    }
    @@media (max-width: 767px) {
      .ab-timeline-wrap {
        padding: 36px 20px;
      }
    }
    .ab-timeline-card {
      background-color: #ffffff;
      border-radius: 22px;
      padding: 26px 22px;
      border: 1px solid rgba(22, 28, 36, 0.07);
      height: 100%;
      position: relative;
      transition: border-color 0.25s ease, transform 0.25s ease;
    }
    .ab-timeline-card:hover {
      transform: translateY(-4px);
      border-color: #088178;
    }
    .ab-year-badge {
      display: inline-block;
      font-size: 14px;
      font-weight: 800;
      color: #ffffff;
      background-color: #088178;
      padding: 4px 14px;
      border-radius: 999px;
      margin-bottom: 14px;
    }

    /* 4 Steps */
    .ab-step-card {
      padding: 28px 24px;
      border-radius: 22px;
      background-color: #ffffff;
      border: 1px solid rgba(22, 28, 36, 0.08);
      height: 100%;
      transition: all 0.25s ease;
    }
    .ab-step-card:hover {
      border-color: rgba(8, 129, 120, 0.35);
      box-shadow: 0 14px 28px -10px rgba(8, 129, 120, 0.12);
    }
    .ab-step-num {
      font-size: 36px;
      font-weight: 900;
      line-height: 1;
      color: rgba(8, 129, 120, 0.22);
      margin-bottom: 16px;
      font-family: "Plus Jakarta Sans", sans-serif;
    }
  </style>
}

<!-- ========== 1. Hero Đa Ngành Start ========== -->
<section class="pt-6 pb-[70px]">
  <div class="container">
    <div class="ab-hero">
      <div class="grid grid-cols-12 gap-8 items-center">
        <div class="col-span-12 lg:col-span-6 wow animate__animated animate__fadeInUp" data-wow-delay=".15s">
          <div class="ab-breadcrumb">
            <a href='@Url.Action("Index", "Home")'>Trang chủ</a>
            <span>/</span>
            <span style="color: #FFEB69; font-weight: 600;">Giới thiệu</span>
          </div>

          <div class="ab-hero-pill">
            <i class="hgi hgi-stroke hgi-sparkles"></i>
            <span>Sellzy Multi-Category Marketplace • Est. 2021</span>
          </div>

          <h1 class="ab-hero-title">
            Nền Tảng Mua Sắm Đa Ngành — Trọn Vẹn <span>Mọi Nhu Cầu</span>
          </h1>

          <p class="ab-hero-desc">
            Sellzy kết nối hàng nghìn sản phẩm chính hãng từ Công nghệ, Thời trang, Mỹ phẩm đến Thực phẩm sạch, Nhà sách &amp; Sản phẩm số trên một nền tảng duy nhất — minh bạch nguồn gốc, giao hàng linh hoạt và hỗ trợ xuất hóa đơn VAT.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a href='@(Url.RouteUrl("shop_index") ?? Url.Action("Index", "Products"))' class="btn rounded-full px-7 py-3 font-bold text-sm" style="background-color: #FFEB69; color: #161C24;">
              Khám phá sản phẩm
            </a>
            <a href="javascript:void(0)" onclick="document.getElementById('hanh-trinh')?.scrollIntoView({behavior:'smooth'})" class="btn rounded-full px-6 py-3 font-semibold text-sm" style="background-color: rgba(255,255,255,0.12); color: #ffffff; border: 1px solid rgba(255,255,255,0.28);">
              Hành trình phát triển
            </a>
          </div>
        </div>

        <div class="col-span-12 lg:col-span-6 wow animate__animated animate__fadeInUp" data-wow-delay=".25s">
          <div class="ab-lookbook-stack">
            <div class="ab-lookbook-main">
              <img src="/assets/images/home-4/promo-tech.jpg" alt="Công nghệ và thiết bị số chính hãng tại Sellzy" />
            </div>
            <div class="ab-lookbook-side">
              <div class="ab-lookbook-sub">
                <img src="/assets/images/home-4/promo-lifestyle.jpg" alt="Gia dụng thông minh và làm đẹp Sellzy" />
              </div>
              <div class="ab-glass-stat">
                <div class="text-2xl font-extrabold" style="color: #FFEB69;">10+ Ngành Hàng</div>
                <div class="text-xs mt-1" style="color: rgba(255,255,255,0.85);">
                  Công nghệ, Thời trang, Thực phẩm sạch, Sách &amp; E-Voucher chính hãng
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ========== Hero Đa Ngành End ========== -->

<!-- ========== 2. Bento Grid: Giá Trị & Con Số Start ========== -->
<section class="pb-[70px]">
  <div class="container">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 wow animate__animated animate__fadeInUp" data-wow-delay=".15s">
      <div>
        <span class="ab-eyebrow">Giá trị cốt lõi</span>
        <h2 class="ab-heading m-0">Tại Sao Hàng Trăm Nghìn Khách Hàng Chọn Sellzy?</h2>
      </div>
      <p class="text-sm text-light-secondary-text max-w-md m-0">
        Sự kết hợp giữa hệ sinh thái đa ngành hàng chuẩn hóa, thanh toán an toàn và dịch vụ hậu mãi minh bạch.
      </p>
    </div>

    <div class="ab-bento-grid">
      <!-- Block A -->
      <div class="ab-bento-card ab-bento-a wow animate__animated animate__fadeInUp" data-wow-delay=".15s">
        <span class="ab-eyebrow">Sứ mệnh nền tảng</span>
        <h3 class="text-2xl font-extrabold text-light-primary-text mb-3">
          Đa Dạng Ngành Hàng — Đồng Nhất Chất Lượng
        </h3>
        <p class="text-sm leading-relaxed text-light-secondary-text mb-6">
          Từ thiết bị điện tử bảo hành chính hãng, thực phẩm kiểm soát hạn sử dụng nghiêm ngặt, đến key bản quyền giao tức thì — mọi sản phẩm trên Sellzy đều được chuẩn hóa thông tin và kiểm định trước khi đến tay khách hàng.
        </p>
        <div class="flex flex-wrap gap-2.5">
          <span class="ab-pillar-chip"><i class="hgi hgi-stroke hgi-checkmark-badge-01 text-primary"></i> 100% Chính hãng &amp; Minh bạch</span>
          <span class="ab-pillar-chip"><i class="hgi hgi-stroke hgi-clock-01 text-primary"></i> Kiểm soát HSD &amp; Bảo quản</span>
          <span class="ab-pillar-chip"><i class="hgi hgi-stroke hgi-invoice-01 text-primary"></i> Hỗ trợ xuất Hóa đơn VAT</span>
        </div>
      </div>

      <!-- Block B -->
      <div class="ab-bento-card ab-bento-b wow animate__animated animate__fadeInUp" data-wow-delay=".25s">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-white/70">Độ hài lòng</span>
          <i class="hgi hgi-stroke hgi-star text-2xl"></i>
        </div>
        <div class="my-4">
          <div class="flex items-baseline gap-1">
            <span class="about-us-counter text-5xl font-black">99</span>
            <span class="text-4xl font-black">%</span>
          </div>
          <p class="text-sm font-semibold mt-2 m-0">Khách hàng đánh giá 5 sao và tiếp tục quay lại mua sắm</p>
        </div>
        <div class="text-xs font-medium opacity-80">Dựa trên hơn 50.000+ đánh giá đơn hàng xác thực</div>
      </div>

      <!-- Block C -->
      <div class="ab-bento-card ab-bento-c wow animate__animated animate__fadeInUp" data-wow-delay=".3s">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full" style="background: rgba(255,255,255,0.12); color: #FFEB69;">Năng lực vận hành</span>
          <i class="hgi hgi-stroke hgi-container-truck text-2xl" style="color: #FFEB69;"></i>
        </div>
        <div class="my-4">
          <div class="flex items-baseline gap-1" style="color: #FFEB69;">
            <span class="about-us-counter text-5xl font-black">120</span>
            <span class="text-4xl font-black">K+</span>
          </div>
          <p class="text-sm font-semibold mt-2 m-0" style="color: rgba(255,255,255,0.9);">Đơn hàng đã giao an toàn đến 63 tỉnh thành</p>
        </div>
        <div class="text-xs" style="color: rgba(255,255,255,0.68);">Giao tiêu chuẩn, giao mát bảo quản &amp; giao mã số 24/7</div>
      </div>

      <!-- Block D -->
      <div class="ab-bento-card ab-bento-d wow animate__animated animate__fadeInUp" data-wow-delay=".35s">
        <img src="/assets/images/about/woman-on-phone.jpg" alt="Mua sắm thông minh trên Sellzy" class="w-full h-full object-cover" style="min-height: 270px; object-position: center 25%;" />
        <div style="position: absolute; inset: 0; background: linear-gradient(180deg, transparent 32%, rgba(0, 38, 42, 0.9) 100%); display: flex; align-items: flex-end; padding: 28px;">
          <div class="text-white">
            <span class="inline-block text-xs font-bold px-3 py-1 rounded-full mb-2" style="background: #FFEB69; color: #161C24;">Trải nghiệm thông minh</span>
            <h4 class="text-xl font-extrabold text-white m-0">Mua Sắm Dễ Dàng — Thanh Toán Tiện Lợi</h4>
            <p class="text-xs mt-1 m-0" style="color: rgba(255,255,255,0.85);">Tích hợp tìm kiếm nhanh, trợ lý AI, VNPay, Ví Sellzy &amp; theo dõi đơn hàng theo thời gian thực.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ========== Bento Grid End ========== -->

<!-- ========== 3. Hệ Sinh Thái Ngành Hàng Chủ Lực Start ========== -->
<section class="pb-[70px]">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-10 wow animate__animated animate__fadeInUp" data-wow-delay=".15s">
      <span class="ab-eyebrow">Hệ sinh thái đa ngành</span>
      <h2 class="ab-heading mb-3">Trọn Vẹn Mọi Nhu Cầu Cuộc Sống Hiện Đại</h2>
      <p class="text-sm text-light-secondary-text m-0">
        Mỗi nhóm ngành hàng trên Sellzy đều được tối ưu quy trình kiểm định, bảo quản và giao nhận riêng biệt.
      </p>
    </div>

    <div class="ab-industry-grid">
      <div class="ab-industry-card wow animate__animated animate__fadeInUp" data-wow-delay=".15s">
        <div class="ab-industry-icon" style="background-color: #E0F2FE; color: #0284C7;">
          <i class="hgi hgi-stroke hgi-laptop"></i>
        </div>
        <h5 class="text-base font-bold text-light-primary-text mb-2">Công Nghệ &amp; Thiết Bị Số</h5>
        <p class="text-sm text-light-secondary-text leading-relaxed m-0">
          Điện thoại, laptop, tai nghe &amp; thiết bị gia dụng thông minh chính hãng với bảo hành điện tử minh bạch.
        </p>
      </div>

      <div class="ab-industry-card wow animate__animated animate__fadeInUp" data-wow-delay=".2s">
        <div class="ab-industry-icon" style="background-color: #FCE7F3; color: #DB2777;">
          <i class="hgi hgi-stroke hgi-t-shirt"></i>
        </div>
        <h5 class="text-base font-bold text-light-primary-text mb-2">Thời Trang &amp; Phụ Kiện</h5>
        <p class="text-sm text-light-secondary-text leading-relaxed m-0">
          Trang phục nam nữ, giày dép &amp; túi xách đa dạng phong cách, cập nhật xu hướng mới mỗi ngày.
        </p>
      </div>

      <div class="ab-industry-card wow animate__animated animate__fadeInUp" data-wow-delay=".25s">
        <div class="ab-industry-icon" style="background-color: #F3E8FF; color: #7C3AED;">
          <i class="hgi hgi-stroke hgi-sparkles"></i>
        </div>
        <h5 class="text-base font-bold text-light-primary-text mb-2">Mỹ Phẩm &amp; Chăm Sóc Cá Nhân</h5>
        <p class="text-sm text-light-secondary-text leading-relaxed m-0">
          Dược mỹ phẩm, chăm sóc da &amp; nước hoa nhập khẩu chính ngạch với đầy đủ tem phụ kiểm định.
        </p>
      </div>

      <div class="ab-industry-card wow animate__animated animate__fadeInUp" data-wow-delay=".3s">
        <div class="ab-industry-icon" style="background-color: #DCFCE7; color: #16A34A;">
          <i class="hgi hgi-stroke hgi-apple"></i>
        </div>
        <h5 class="text-base font-bold text-light-primary-text mb-2">Thực Phẩm Sạch &amp; Đồ Uống</h5>
        <p class="text-sm text-light-secondary-text leading-relaxed m-0">
          Kiểm soát hạn sử dụng (HSD) rõ ràng theo từng lô hàng, đóng gói chống sốc &amp; giao nhanh bảo quản mát.
        </p>
      </div>

      <div class="ab-industry-card wow animate__animated animate__fadeInUp" data-wow-delay=".35s">
        <div class="ab-industry-icon" style="background-color: #FFEDD5; color: #EA580C;">
          <i class="hgi hgi-stroke hgi-book-open-01"></i>
        </div>
        <h5 class="text-base font-bold text-light-primary-text mb-2">Nhà Sách &amp; Văn Phòng Phẩm</h5>
        <p class="text-sm text-light-secondary-text leading-relaxed m-0">
          Sách chọn lọc, dụng cụ học tập &amp; vật tư doanh nghiệp chính hãng, hỗ trợ xuất hóa đơn VAT nhanh chóng.
        </p>
      </div>

      <div class="ab-industry-card wow animate__animated animate__fadeInUp" data-wow-delay=".4s">
        <div class="ab-industry-icon" style="background-color: #E0E7FF; color: #4338CA;">
          <i class="hgi hgi-stroke hgi-ticket-02"></i>
        </div>
        <h5 class="text-base font-bold text-light-primary-text mb-2">Sản Phẩm Số &amp; E-Voucher</h5>
        <p class="text-sm text-light-secondary-text leading-relaxed m-0">
          Key bản quyền phần mềm, thẻ nạp &amp; khóa học trực tuyến giao mã tự động 0đ phí vận chuyển ngay sau thanh toán.
        </p>
      </div>
    </div>
  </div>
</section>
<!-- ========== Hệ Sinh Thái Ngành Hàng End ========== -->

<!-- ========== 4. Hành Trình Phát Triển (Timeline) Start ========== -->
<section id="hanh-trinh" class="pb-[70px]">
  <div class="container">
    <div class="ab-timeline-wrap">
      <div class="text-center max-w-2xl mx-auto mb-10 wow animate__animated animate__fadeInUp" data-wow-delay=".15s">
        <span class="ab-eyebrow">Cột mốc đáng nhớ</span>
        <h2 class="ab-heading mb-3">Hành Trình Phát Triển Nền Tảng</h2>
        <p class="text-sm text-light-secondary-text m-0">
