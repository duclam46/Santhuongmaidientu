@using DOAN_BANHANG.Helpers
@using System.Globalization
@model DOAN_BANHANG.ViewModels.ShopDetailsVm

@{
  ViewData["Title"] = Model.Shop.Name;
  var viVn = CultureInfo.GetCultureInfo("vi-VN");

  string ResolveImageUrl(string? raw)
  {
    var normalized = ImageUrlHelper.NormalizeStaticFileUrl(raw);
    return !string.IsNullOrWhiteSpace(normalized)
      ? normalized
      : Url.Content("~/assets/images/vendors-list/vendor-profile.png");
  }

  var shopLogo = ResolveImageUrl(Model.Shop.LogoUrl);
}

<section class="breadcrumb-section py-6">
  <div class="container">
    <div class="flex items-center gap-x-2 text-sm text-light-secondary-text">
      <a href="/" class="hover:underline">Trang chủ</a>
      <span>/</span>
      <span class="text-light-primary-text font-semibold">@Model.Shop.Name</span>
    </div>
  </div>
</section>

<section class="shop-details-section pb-12">
  <div class="container">
    <div class="border border-gray-300 rounded-3xl p-6 mb-6">
      <div class="flex items-center justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-3">
          <div class="size-12 rounded-full overflow-hidden border border-gray-300 bg-gray-100 flex items-center justify-center">
            <img src="@shopLogo" alt="@Model.Shop.Name" class="w-full h-full object-cover" />
          </div>
          <div>
            <h3 class="text-lg font-semibold leading-7">@Model.Shop.Name</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Shop.Location))
            {
              <p class="text-sm text-light-secondary-text">@Model.Shop.Location</p>
            }
          </div>
        </div>

        <div class="flex items-center gap-6">
          <div class="text-center">
            <p class="text-sm text-light-secondary-text">Đánh giá</p>
            <p class="font-semibold text-light-primary-text">@Model.Shop.RatingAverage.ToString("0.0", viVn)</p>
          </div>
          <div class="text-center">
            <p class="text-sm text-light-secondary-text">Sản phẩm</p>
            <p class="font-semibold text-light-primary-text">@Model.Shop.ProductCount.ToString("N0", viVn)</p>
          </div>
          <div class="text-center">
            <p class="text-sm text-light-secondary-text">Phản hồi chat</p>
            <p class="font-semibold text-light-primary-text">@(Model.Shop.ChatResponseRate.HasValue ? (Model.Shop.ChatResponseRate.Value + "%") : "-")</p>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-12 gap-6">
      @if (Model.Products is null || Model.Products.Count == 0)
      {
        <div class="col-span-12">
          <div class="border border-gray-300 rounded-2xl p-6 text-center">
            <p class="text-light-secondary-text">Shop này chưa có sản phẩm.</p>
          </div>
        </div>
      }
      else
      {
        foreach (var p in Model.Products)
        {
          var imageUrl = ResolveImageUrl(p.PrimaryImageUrl);
          var detailsUrl = Url.RouteUrl("product_details", new { slug = p.Slug }) ?? "#";
          var ratingPct = (int)Math.Round(Math.Clamp((double)(p.RatingAverage / 5m * 100m), 0d, 100d));

          <div class="xl:col-span-4 md:col-span-6 col-span-12">
            <div class="border border-gray-300 rounded-2xl product-card-1 p-4 group">
              <div class="product-image-container relative">
                <div class="product-image rounded-xl bg-[#F4F3F5] mb-4 overflow-hidden">
                  <a href='@detailsUrl'>
                    <img src="@imageUrl" alt="@p.Name" class="group-hover:scale-110 transition-all transform group-hover:-rotate-3 ease-in-out duration-300" />
                  </a>
                </div>
              </div>

              <div class="product-content">
                <h5 class="text-base leading-6 font-semibold font-dm-sans mb-4">
                  <a href='@detailsUrl'>@p.Name</a>
                </h5>

                <div class="rating-section flex items-center mb-4">
                  <div class="bg-[url('../images/star-icon.png')] w-[90px] h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]">
                    <div style="width: @ratingPct%" class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"></div>
                  </div>
                  <span class="text-sm leading-[22px] font-normal inline-block ml-1">(@p.RatingCount)</span>
                </div>

                <div class="price-section flex items-center gap-x-3 mb-2">
                  <span class="current-price text-base font-semibold text-light-primary-text">@p.Price.ToString("N0", viVn) VNĐ</span>
                  @if (p.OldPrice.HasValue)
                  {
                    <span class="old-price text-sm leading-[22px] font-normal text-light-disabled-text line-through">@p.OldPrice.Value.ToString("N0", viVn) VNĐ</span>
                  }
                  @if (p.DiscountPercent > 0)
                  {
                    <span class="discount-percentage text-sm leading-[22px] font-semibold text-error">@p.DiscountPercent% OFF</span>
                  }
                </div>

                <div class="btn-section flex items-center gap-x-4">
                  <a class='btn btn-primary rounded-full font-semibold text-sm leading-6 px-6.5 py-2 flex-1' href='@detailsUrl'>
                    <i class="hgi hgi-stroke hgi-shopping-cart-02 text-xl text-white"></i>
                    <span>Xem chi tiết</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        }
      }
    </div>
  </div>
</section>
