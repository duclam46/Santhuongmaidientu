@model DOAN_BANHANG.ViewModels.ShopListVm

@{
    ViewData["Title"] = "Cửa hàng đối tác";
    string ShopUrl(int? categoryId = null, int? minRating = null, int? maxRating = null, int? page = null, string? tier = null)
        => Url.RouteUrl("shop_index", new { categoryId, minRating, maxRating, tier = tier ?? Model.SelectedTier, page }) ?? "#";
}

@section Styles {
  <style>
    /* ========== MODERN MULTI-INDUSTRY SHOP DIRECTORY ========== */
    .sh-hero {
      background: radial-gradient(circle at 88% 18%, rgba(255, 235, 105, 0.16) 0%, transparent 46%),
                  linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
      border-radius: 28px;
      padding: 34px 38px;
      color: #ffffff;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      box-shadow: 0 22px 46px -18px rgba(0, 38, 42, 0.35);
    }
    @@media (max-width: 767px) {
      .sh-hero {
        padding: 24px 20px;
        border-radius: 22px;
      }
    }
    .sh-crumb {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.72);
      margin-bottom: 10px;
    }
    .sh-crumb a {
      color: rgba(255, 255, 255, 0.88);
      transition: color 0.2s;
    }
    .sh-crumb a:hover {
      color: #FFEB69;
    }
    .sh-page-title {
      font-size: clamp(26px, 2.8vw, 34px);
      font-weight: 800;
      color: #ffffff;
      line-height: 1.22;
      letter-spacing: -0.02em;
      margin: 0 0 8px 0;
    }
    .sh-page-sub {
      font-size: 14.5px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.84);
      margin: 0;
      max-width: 580px;
    }
    .sh-header-metrics {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .sh-hm-pill {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 18px;
      padding: 12px 18px;
      color: #ffffff;
    }
    .sh-hm-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background-color: rgba(255, 235, 105, 0.18);
      color: #FFEB69;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }

    /* Main 2-column layout */
    .sh-layout {
      display: grid;
      grid-template-columns: 290px minmax(0, 1fr);
      gap: 24px;
      align-items: start;
    }
    @@media (max-width: 1023px) {
      .sh-layout {
        grid-template-columns: 1fr;
      }
    }

    /* Sidebar */
    .sh-sidebar-box {
      background-color: #ffffff;
      border: 1px solid #E5E7EB;
      border-radius: 22px;
      padding: 22px;
      box-shadow: 0 8px 24px -12px rgba(22, 28, 36, 0.06);
      position: sticky;
      top: 90px;
    }
    .sh-sidebar-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 14px;
      margin-bottom: 18px;
      border-bottom: 1px solid #F1F5F9;
    }
    .sh-sidebar-top h5 {
      font-size: 16px;
      font-weight: 800;
      color: #161C24;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .sh-clear-link {
      font-size: 12.5px;
      font-weight: 700;
      color: #088178;
    }
    .sh-clear-link:hover {
      text-decoration: underline;
    }
    .sh-filter-sec {
      padding-bottom: 18px;
      margin-bottom: 18px;
      border-bottom: 1px solid #F1F5F9;
    }
    .sh-filter-sec:last-child {
      padding-bottom: 0;
      margin-bottom: 0;
      border-bottom: none;
    }
    .sh-filter-sec-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }
    .sh-filter-sec-head h6 {
      font-size: 14px;
      font-weight: 700;
      color: #161C24;
      margin: 0;
    }
    .sh-reset-btn {
      font-size: 12px;
      color: #64748B;
      font-weight: 600;
    }
    .sh-reset-btn:hover {
      color: #088178;
    }
    .sh-cat-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 8px 10px;
      border-radius: 11px;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;
      font-size: 13.5px;
      color: #334155;
    }
    .sh-cat-item:hover {
      background-color: #F2F9F8;
      color: #088178;
    }
    .sh-cat-item.is-selected {
      background-color: #E6F4F3;
      color: #088178;
      font-weight: 700;
    }
    .sh-radio-box {
      width: 18px;
      height: 18px;
      border-radius: 6px;
      border: 2px solid #CBD5E1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      background-color: #ffffff;
      transition: all 0.2s ease;
    }
    .sh-cat-item.is-selected .sh-radio-box {
      border-color: #088178;
      background-color: #088178;
      color: #ffffff;
    }
    .sh-rating-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }
    .sh-rating-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 12px;
      border-radius: 999px;
      background-color: #F8FAFC;
      border: 1px solid #E2E8F0;
      color: #1E293B;
      font-size: 13px;
      font-weight: 700;
      transition: all 0.2s ease;
    }
    .sh-rating-pill:hover {
      border-color: #088178;
      color: #088178;
      background-color: #F2F9F8;
    }
    .sh-rating-pill.active {
      background-color: #088178;
      border-color: #088178;
      color: #ffffff;
    }
    .sh-rating-pill .sh-star-ic {
      color: #F59E0B;
      font-size: 13px;
      line-height: 1;
    }
    .sh-rating-pill.active .sh-star-ic {
      color: #FFEB69;
    }

    /* Toolbar & Search */
    .sh-toolbar-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
      padding: 14px 18px;
      background-color: #ffffff;
      border: 1px solid #E5E7EB;
      border-radius: 18px;
    }
    .sh-search-inline {
      position: relative;
      flex: 1;
      min-width: 220px;
      max-width: 300px;
    }
    .sh-search-inline input {
      width: 100%;
      height: 40px;
      padding: 0 14px 0 38px;
      border-radius: 999px;
      border: 1px solid #E2E8F0;
      background-color: #F8FAFC;
      font-size: 13.5px;
      color: #161C24;
      outline: none;
      transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
    }
    .sh-search-inline input:focus {
      border-color: #088178;
      background-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(8, 129, 120, 0.12);
    }
    .sh-search-inline i {
      position: absolute;
      left: 13px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748B;
      font-size: 15px;
    }

    /* Shop Cards Grid */
    .sh-cards-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    @@media (max-width: 1279px) {
      .sh-cards-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @@media (max-width: 639px) {
      .sh-cards-grid {
        grid-template-columns: 1fr;
      }
    }
    .sh-clean-card {
      background-color: #ffffff;
      border: 1px solid #E5E7EB;
      border-radius: 22px;
      overflow: hidden;
      height: 100%;
      display: flex;
      flex-direction: column;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .sh-clean-card:hover {
      transform: translateY(-5px);
      border-color: #088178;
      box-shadow: 0 20px 38px -14px rgba(8, 129, 120, 0.18);
    }
    .sh-card-cover {
      height: 86px;
      padding: 14px 16px;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      position: relative;
    }
    .sh-mall-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background-color: rgba(255, 255, 255, 0.92);
      color: #088178;
      font-size: 11px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 999px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    .sh-rate-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background-color: rgba(22, 28, 36, 0.78);
      backdrop-filter: blur(6px);
      color: #ffffff;
      font-size: 11.5px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 999px;
    }
    .sh-rate-tag i {
      color: #FFEB69;
    }
    .sh-card-inner {
      padding: 0 20px 20px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .sh-avatar-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-top: -32px;
      margin-bottom: 12px;
      position: relative;
      z-index: 2;
    }
    .sh-avatar {
      width: 66px;
      height: 66px;
      border-radius: 18px;
      background-color: #ffffff;
      border: 3px solid #ffffff;
      box-shadow: 0 8px 18px rgba(22, 28, 36, 0.12);
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .sh-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .sh-avatar-text {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #088178 0%, #04464C 100%);
      color: #FFEB69;
      font-size: 24px;
      font-weight: 800;
    }
    .sh-live-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11.5px;
      font-weight: 700;
      color: #047857;
      background-color: #ECFDF5;
      border: 1px solid #A7F3D0;
      padding: 4px 10px;
      border-radius: 999px;
    }
    .sh-live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #10B981;
    }
    .sh-title-row {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
    }
    .sh-title-row h6 {
      font-size: 16.5px;
      font-weight: 800;
      color: #161C24;
      margin: 0;
      line-height: 1.35;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .sh-clean-card:hover .sh-title-row h6 {
      color: #088178;
    }
    .sh-verified-icon {
      color: #088178;
      font-size: 16px;
      flex-shrink: 0;
    }
    .sh-loc-line {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 12.5px;
      color: #64748B;
      margin-bottom: 14px;
    }
    .sh-meta-strip {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      padding: 12px 10px;
      background-color: #F8FAFC;
      border: 1px solid #EEF2F6;
      border-radius: 14px;
      margin-bottom: 16px;
      text-align: center;
    }
    .sh-meta-val {
      font-size: 14px;
      font-weight: 800;
      color: #161C24;
      line-height: 1.25;
    }
    .sh-meta-lbl {
      font-size: 11px;
      font-weight: 600;
      color: #64748B;
      margin-top: 2px;
    }
    .sh-card-footer {
      margin-top: auto;
    }
    .sh-btn-visit {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 10px 16px;
      border-radius: 12px;
      background-color: #E6F4F3;
      color: #088178;
      font-size: 13.5px;
      font-weight: 700;
      transition: all 0.2s ease;
    }
    .sh-clean-card:hover .sh-btn-visit,
    .sh-btn-visit:hover {
      background-color: #088178;
      color: #ffffff;
    }
  </style>
}

<!-- ========== Top Hero Header Start ========== -->
<section class="pt-6 pb-7">
  <div class="container">
    <div class="sh-hero">
      <div>
        <nav class="sh-crumb">
          <a href='@Url.Action("Index", "Home")'>
            <i class="hgi hgi-stroke hgi-home-01 mr-1"></i>Trang chủ
          </a>
          <span>/</span>
          <span style="color: #FFEB69; font-weight: 700;">Cửa hàng</span>
        </nav>
        <h1 class="sh-page-title">Cửa Hàng Đối Tác Sellzy</h1>
        <p class="sh-page-sub">
          Khám phá các gian hàng chính hãng đa ngành hàng — từ Công nghệ, Thời trang, Mỹ phẩm đến Thực phẩm sạch, Nhà sách &amp; Sản phẩm số.
        </p>
      </div>

      <div class="sh-header-metrics">
        <div class="sh-hm-pill">
          <span class="sh-hm-icon"><i class="hgi hgi-stroke hgi-store-04"></i></span>
          <div>
            <div class="text-lg font-extrabold leading-tight" style="color: #ffffff;">@Model.TotalItems</div>
            <div class="text-xs" style="color: rgba(255,255,255,0.78);">Gian hàng đối tác</div>
          </div>
        </div>
        <div class="sh-hm-pill">
          <span class="sh-hm-icon"><i class="hgi hgi-stroke hgi-checkmark-badge-02"></i></span>
          <div>
            <div class="text-lg font-extrabold leading-tight" style="color: #FFEB69;">100%</div>
            <div class="text-xs" style="color: rgba(255,255,255,0.78);">Kiểm duyệt chính hãng</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ========== Top Hero Header End ========== -->

<!-- ========== Main Content Start ========== -->
<section class="pb-20">
  <div class="container">
    <div class="sh-layout">
      <!-- LEFT SIDEBAR -->
      <aside>
        <div class="sh-sidebar-box">
          <div class="sh-sidebar-top">
            <h5>
              <i class="hgi hgi-stroke hgi-filter-horizontal text-primary"></i>
              <span>Bộ lọc tìm kiếm</span>
            </h5>
            <a href='@(Url.RouteUrl("shop_index") ?? "#")' class="sh-clear-link">Xóa tất cả</a>
          </div>

          <div class="sh-filter-sec">
            <div class="sh-filter-sec-head">
              <h6>Hạng gian hàng</h6>
              <a href='@(Url.RouteUrl("shop_index", new { categoryId = Model.SelectedCategoryId, minRating = Model.SelectedMinRating, maxRating = Model.SelectedMaxRating, tier = (string?)null, page = 1 }) ?? "#")' class="sh-reset-btn">Đặt lại</a>
            </div>
            <div class="flex flex-col gap-1.5">
              @{
                var allTierUrl = Url.RouteUrl("shop_index", new { categoryId = Model.SelectedCategoryId, minRating = Model.SelectedMinRating, maxRating = Model.SelectedMaxRating, tier = (string?)null, page = 1 }) ?? "#";
                var mallTierUrl = Url.RouteUrl("shop_index", new { categoryId = Model.SelectedCategoryId, minRating = Model.SelectedMinRating, maxRating = Model.SelectedMaxRating, tier = "Mall", page = 1 }) ?? "#";
                var stdTierUrl = Url.RouteUrl("shop_index", new { categoryId = Model.SelectedCategoryId, minRating = Model.SelectedMinRating, maxRating = Model.SelectedMaxRating, tier = "Standard", page = 1 }) ?? "#";
              }
              <a href="@allTierUrl" class="sh-cat-item @(string.IsNullOrWhiteSpace(Model.SelectedTier) ? "is-selected" : "")">
                <span class="flex items-center gap-2">
                  <i class="hgi hgi-stroke hgi-store-04"></i>
                  <span>Tất cả gian hàng</span>
                </span>
              </a>
              <a href="@mallTierUrl" class="sh-cat-item @(Model.SelectedTier == "Mall" ? "is-selected" : "")">
                <span class="flex items-center gap-2">
                  <i class="hgi hgi-stroke hgi-checkmark-badge-02" style="color: #B45309;"></i>
                  <span>Sellzy Mall (Chính hãng)</span>
                </span>
              </a>
              <a href="@stdTierUrl" class="sh-cat-item @(Model.SelectedTier == "Standard" ? "is-selected" : "")">
                <span class="flex items-center gap-2">
                  <i class="hgi hgi-stroke hgi-store-02"></i>
                  <span>Shop Thường (Tiêu chuẩn)</span>
                </span>
              </a>
            </div>
          </div>

          <div class="sh-filter-sec">
            <div class="sh-filter-sec-head">
              <h6>Ngành hàng</h6>
              <a href="@ShopUrl(categoryId: null, minRating: Model.SelectedMinRating, maxRating: Model.SelectedMaxRating, page: 1)" class="sh-reset-btn">Đặt lại</a>
            </div>
            <ul class="flex flex-col gap-y-1">
              @if (Model.Categories.Count == 0)
              {
                <li><p class="text-xs text-light-disabled-text py-1">Chưa có danh mục để lọc.</p></li>
              }
              else
              {
                @foreach (var c in Model.Categories)
                {
                  var catUrl = ShopUrl(categoryId: c.CategoryId, minRating: Model.SelectedMinRating, maxRating: Model.SelectedMaxRating, page: 1);
                  <li>
                    <label class="sh-cat-item @(c.IsSelected ? "is-selected" : "")">
                      <span class="flex items-center gap-2.5 min-w-0">
                        <input type="radio" name="categoryId" value="@c.CategoryId" checked="@(c.IsSelected ? "checked" : null)" onchange="window.location.href='@catUrl'" class="hidden" />
                        <span class="sh-radio-box">
                          @if (c.IsSelected)
                          {
                            <i class="hgi hgi-stroke hgi-tick-02 text-[12px]"></i>
                          }
                        </span>
                        <span class="truncate">@c.Name</span>
                      </span>
                      <span class="text-xs opacity-75 shrink-0">(@c.ShopCount)</span>
                    </label>
                  </li>
                }
              }
            </ul>
          </div>

          <div class="sh-filter-sec">
            <div class="sh-filter-sec-head">
              <h6>Mức đánh giá</h6>
              <a href="@ShopUrl(categoryId: Model.SelectedCategoryId, minRating: null, maxRating: null, page: 1)" class="sh-reset-btn">Đặt lại</a>
            </div>
            <div class="sh-rating-pills">
              @for (var r = 5; r >= 1; r--)
              {
                var ratingUrl = ShopUrl(categoryId: Model.SelectedCategoryId, minRating: r, maxRating: 5, page: 1);
                var isActive = Model.SelectedMinRating == r && ((Model.SelectedMaxRating ?? 5) == 5);
                <a href="@ratingUrl" class="sh-rating-pill @(isActive ? "active" : "")">
                  <span>@r</span>
                  <span class="sh-star-ic">★</span>
                  @if (r < 5)
                  {
                    <span class="text-[11px] opacity-80">trở lên</span>
                  }
                </a>
              }
            </div>
            <p class="text-xs text-light-secondary-text m-0">Hiển thị cửa hàng đạt điểm trung bình từ mức sao đã chọn.</p>
          </div>
        </div>
      </aside>

      <!-- RIGHT CONTENT -->
      <div>
        <div class="sh-toolbar-bar">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class="text-sm font-semibold text-light-primary-text">
              Hiển thị <strong id="shop-visible-count" class="text-primary">@Model.Shops.Count</strong> cửa hàng
            </span>
            @if (Model.SelectedCategoryId.HasValue && !string.IsNullOrWhiteSpace(Model.SelectedCategoryName))
            {
              <a href="@ShopUrl(categoryId: null, minRating: Model.SelectedMinRating, maxRating: Model.SelectedMaxRating, page: 1)" class="inline-flex items-center gap-1 text-xs font-bold bg-[#E6F4F3] text-primary rounded-full px-3 py-1">
                <span>@Model.SelectedCategoryName</span>
                <i class="hgi hgi-stroke hgi-cancel-01 text-xs"></i>
              </a>
            }
            @if (Model.SelectedMinRating.HasValue)
            {
              <a href="@ShopUrl(categoryId: Model.SelectedCategoryId, minRating: null, maxRating: null, page: 1)" class="inline-flex items-center gap-1 text-xs font-bold bg-[#FFF7CC] text-light-primary-text rounded-full px-3 py-1">
                <span>Từ @Model.SelectedMinRating sao</span>
                <i class="hgi hgi-stroke hgi-cancel-01 text-xs"></i>
              </a>
            }
          </div>

          <div class="sh-search-inline">
            <i class="hgi hgi-stroke hgi-search-01"></i>
            <input type="text" id="shop-quick-search" placeholder="Tìm nhanh tên cửa hàng..." />
          </div>
        </div>

        @if (Model.Shops.Count == 0)
        {
          <div class="rounded-2xl border border-dashed border-gray-300 p-14 text-center bg-white">
            <i class="hgi hgi-stroke hgi-store-04 text-5xl text-gray-400 mb-3 inline-block"></i>
            <h5 class="text-lg font-bold text-light-primary-text mb-1">Không tìm thấy cửa hàng phù hợp</h5>
            <p class="text-sm text-light-secondary-text mb-6">Hãy thử thay đổi điều kiện lọc ở cột bên trái.</p>
            <a href="@ShopUrl()" class="btn btn-primary rounded-full py-2.5 px-6 text-white text-sm font-semibold">Xem tất cả cửa hàng</a>
          </div>
        }
        else
        {
          <div id="shop-cards-grid" class="sh-cards-grid">
            @{
              var coverGradients = new[] {
                "linear-gradient(135deg, #047857 0%, #088178 100%)",
                "linear-gradient(135deg, #312E81 0%, #4F46E5 100%)",
                "linear-gradient(135deg, #0F766E 0%, #0EA5E9 100%)",
                "linear-gradient(135deg, #9A3412 0%, #EA580C 100%)"
              };
            }
            @foreach (var shop in Model.Shops)
            {
              var detailsUrl = Url.RouteUrl("shop_details", new { slug = shop.Slug }) ?? "#";
              var coverIdx = Math.Abs(shop.Name?.GetHashCode() ?? 0) % coverGradients.Length;
              var coverBg = coverGradients[coverIdx];

              <div class="shop-grid-item" data-shop-name="@(shop.Name?.ToLowerInvariant() ?? "")">
                <div class="sh-clean-card">
                  <div class="sh-card-cover" style="background: @coverBg;">
                    @if (shop.IsMall)
                    {
                      <span class="sh-mall-tag" style="background-color: #00262A; color: #FFEB69;">
                        <i class="hgi hgi-stroke hgi-checkmark-badge-02"></i> Sellzy Mall
                      </span>
                    }
                    else
                    {
                      <span class="sh-mall-tag">
                        <i class="hgi hgi-stroke hgi-store-02"></i> Shop Thường
                      </span>
                    }
                    <span class="sh-rate-tag">
                      <i class="hgi hgi-stroke hgi-star"></i> @shop.RatingAverage.ToString("0.0")
                    </span>
                  </div>

                  <div class="sh-card-inner">
                    <div class="sh-avatar-row">
                      <div class="sh-avatar">
                        @if (!string.IsNullOrWhiteSpace(shop.LogoUrl))
                        {
                          <img src="@shop.LogoUrl" alt="@shop.Name" />
                        }
                        else
                        {
                          <div class="sh-avatar-text">
                            @(string.IsNullOrWhiteSpace(shop.Name) ? "S" : shop.Name.Trim()[0].ToString().ToUpperInvariant())
                          </div>
                        }
                      </div>

                      <span class="sh-live-badge">
                        <span class="sh-live-dot"></span>
                        Đang mở cửa
                      </span>
                    </div>

                    <div class="sh-title-row">
                      <h6 title="@shop.Name">@shop.Name</h6>
                      <i class="hgi hgi-stroke hgi-checkmark-badge-02 sh-verified-icon" title="Cửa hàng chính hãng"></i>
                    </div>

                    <div class="sh-loc-line">
                      <i class="hgi hgi-stroke hgi-location-01 text-sm text-primary"></i>
                      <span class="truncate">@(!string.IsNullOrWhiteSpace(shop.Location) ? shop.Location : "Toàn quốc")</span>
                    </div>

                    <div class="sh-meta-strip">
                      <div>
                        <div class="sh-meta-val">@shop.ProductCount</div>
                        <div class="sh-meta-lbl">Sản phẩm</div>
                      </div>
                      <div>
                        <div class="sh-meta-val">@shop.RatingAverage.ToString("0.0") ★</div>
                        <div class="sh-meta-lbl">Đánh giá</div>
                      </div>
                      <div>
                        <div class="sh-meta-val">@(shop.IsMall ? "Chính hãng" : "Đối tác")</div>
                        <div class="sh-meta-lbl"> Phân hạng</div>
                      </div>
                    </div>

                    <div class="sh-card-footer">
                      <a href="@detailsUrl" class="sh-btn-visit">
                        <span>Ghé thăm gian hàng</span>
                        <i class="hgi hgi-stroke hgi-arrow-right-02 text-sm"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            }
          </div>

          @if (Model.TotalPages > 1)
          {
            <div class="flex justify-center pt-12">
              <ul class="flex items-center gap-x-1.5 blog-pagination">
                <li class="group blog-pagination-item">
                  <a href="@(Model.Page > 1 ? ShopUrl(categoryId: Model.SelectedCategoryId, minRating: Model.SelectedMinRating, maxRating: Model.SelectedMaxRating, page: Model.Page - 1) : "#")" class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-primary/10 transition-colors">
                    <i class="hgi hgi-stroke hgi-arrow-left-01 text-[20px] leading-5 text-light-primary-text group-hover:text-primary"></i>
                  </a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                  var isActive = i == Model.Page;
                  <li class="group blog-pagination-item">
                    <a href='@ShopUrl(categoryId: Model.SelectedCategoryId, minRating: Model.SelectedMinRating, maxRating: Model.SelectedMaxRating, page: i)' class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] @(isActive ? "active" : "text-base leading-6 text-light-primary-text bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-primary/10 group-hover:text-primary transition-colors")">@i</a>
                  </li>
                }
                <li class="group blog-pagination-item">
                  <a href="@(Model.Page < Model.TotalPages ? ShopUrl(categoryId: Model.SelectedCategoryId, minRating: Model.SelectedMinRating, maxRating: Model.SelectedMaxRating, page: Model.Page + 1) : "#")" class="inline-flex items-center justify-center md:size-10 size-9 rounded-[50px] bg-white cursor-pointer border border-gray-300 group-hover:border-primary group-hover:bg-primary/10 transition-colors">
                    <i class="hgi hgi-stroke hgi-arrow-right-01 text-[20px] leading-5 text-light-primary-text group-hover:text-primary"></i>
                  </a>
                </li>
              </ul>
            </div>
          }
        }
      </div>
    </div>
  </div>
</section>

@section Scripts {
  <script>
    (function () {
      const input = document.getElementById('shop-quick-search');
      const items = document.querySelectorAll('#shop-cards-grid .shop-grid-item');
      const countEl = document.getElementById('shop-visible-count');
      if (!input || !items.length) return;

      input.addEventListener('input', function () {
        const q = (this.value || '').trim().toLowerCase();
        let visible = 0;
        items.forEach(function (el) {
          const name = el.getAttribute('data-shop-name') || '';
          const match = !q || name.includes(q);
          el.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        if (countEl) countEl.textContent = visible;
      });
    })();
  </script>
}
