@using DOAN_BANHANG.Helpers
@model DOAN_BANHANG.ViewModels.MyAccountPageVm

@{
  ViewData["Title"] = "Sản phẩm yêu thích";

  string FormatVnd(decimal amount)
  {
    return string.Format("{0:N0}₫", amount);
  }

  var items = Model.Account?.WishlistItems ?? new List<DOAN_BANHANG.ViewModels.WishlistItemVm>();
  var inStockCount = items.Count(x => x.AvailableStock > 0);
  var onSaleCount = items.Count(x => x.SalePrice.HasValue && x.SalePrice.Value > 0m && x.SalePrice.Value < x.Price);
}

@section Styles {
  <style>
    .sz-wl-shell {
      background: #eef2f6;
      min-height: 76vh;
      padding: 28px 0 80px;
    }
    .sz-wl-crumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 13.5px;
      color: #64748b;
      margin-bottom: 18px;
    }
    .sz-wl-crumb a {
      color: #475569;
      text-decoration: none;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: color 0.18s ease;
    }
    .sz-wl-crumb a:hover { color: #008374; }

    /* Dark-Teal Hero matching Account & Wallet */
    .sz-wl-hero {
      background: radial-gradient(circle at 90% 18%, rgba(253, 224, 71, 0.16) 0%, transparent 45%),
                  linear-gradient(135deg, #022c22 0%, #065f5b 55%, #008374 100%);
      border-radius: 26px;
      padding: 28px 32px;
      color: #ffffff;
      box-shadow: 0 20px 44px -18px rgba(2, 44, 34, 0.45);
      margin-bottom: 24px;
    }
    @@media (max-width: 767px) {
      .sz-wl-hero { padding: 22px 18px; border-radius: 20px; }
    }
    .sz-wl-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(253, 224, 71, 0.18);
      border: 1px solid rgba(253, 224, 71, 0.42);
      color: #fde047;
      font-size: 11.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 5px 12px;
      border-radius: 999px;
      margin-bottom: 10px;
    }
    .sz-wl-hero h1 {
      color: #ffffff !important;
      font-size: clamp(22px, 2.6vw, 30px);
      font-weight: 800;
      margin: 0 0 6px;
      line-height: 1.25;
    }
    .sz-wl-hero-sub {
      color: rgba(255, 255, 255, 0.85);
      font-size: 14px;
      margin: 0;
    }
    .sz-wl-nav-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .sz-wl-nav-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 15px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 700;
      color: #ffffff;
      background: rgba(255, 255, 255, 0.13);
      border: 1px solid rgba(255, 255, 255, 0.22);
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .sz-wl-nav-pill:hover {
      background: #fde047;
      color: #022c22;
      border-color: #fde047;
    }
    .sz-wl-kpi-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 20px;
    }
    @@media (max-width: 640px) {
      .sz-wl-kpi-grid { grid-template-columns: 1fr; }
    }
    .sz-wl-kpi {
      background: rgba(255, 255, 255, 0.11);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 16px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .sz-wl-kpi-ic {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }
    .sz-wl-kpi-val {
      font-size: 20px;
      font-weight: 800;
      line-height: 1.15;
      color: #ffffff;
    }
    .sz-wl-kpi-lbl {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.8);
      margin-top: 2px;
    }

    /* Main Card */
    .sz-wl-card {
      background: #ffffff;
      border: 1px solid #dbe3ec;
      border-radius: 24px;
      box-shadow: 0 10px 30px -14px rgba(15, 23, 42, 0.08);
      overflow: hidden;
    }
    .sz-wl-toolbar {
      padding: 18px 24px;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fafc;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }
    .sz-wl-search-wrap {
      position: relative;
      width: 240px;
      max-width: 100%;
    }
    .sz-wl-search-wrap input {
      width: 100%;
      height: 38px;
      padding: 0 14px 0 36px;
      border-radius: 999px;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      font-size: 13px;
      color: #0f172a;
      outline: none;
    }
    .sz-wl-search-wrap input:focus {
      border-color: #008374;
      box-shadow: 0 0 0 3px rgba(0, 131, 116, 0.12);
    }
    .sz-wl-search-wrap i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
      font-size: 16px;
    }
    .sz-wl-filter-btn {
      padding: 7px 14px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 700;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      color: #334155;
      cursor: pointer;
      transition: all 0.18s ease;
    }
    .sz-wl-filter-btn.is-active {
      background: #008374;
      color: #ffffff;
      border-color: #008374;
    }
    .sz-wl-bulk-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 999px;
      font-size: 13.5px;
      font-weight: 800;
      background: linear-gradient(135deg, #065f5b, #008374);
      color: #ffffff;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 8px 18px -6px rgba(0, 131, 116, 0.45);
    }
    .sz-wl-bulk-btn:disabled {
      opacity: 0.48;
      cursor: not-allowed;
      box-shadow: none;
    }

    /* Table styling */
    .sz-wl-table {
      width: 100%;
      border-collapse: collapse;
    }
    .sz-wl-table thead th {
      background: #f1f5f9;
      color: #475569;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 13px 16px;
      border-bottom: 1px solid #dbe3ec;
      white-space: nowrap;
    }
    .sz-wl-table tbody tr {
      border-bottom: 1px solid #eef2f6;
      transition: background 0.18s ease;
    }
    .sz-wl-table tbody tr:last-child { border-bottom: none; }
    .sz-wl-table tbody tr:hover { background: #f8fafc; }
    .sz-wl-table tbody td {
      padding: 18px 16px;
      vertical-align: middle;
    }

    .sz-wl-thumb-wrap {
      position: relative;
      width: 88px;
      height: 88px;
      border-radius: 16px;
      overflow: hidden;
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      flex-shrink: 0;
    }
    .sz-wl-thumb-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.25s ease;
    }
    .sz-wl-table tbody tr:hover .sz-wl-thumb-wrap img {
      transform: scale(1.06);
    }
    .sz-wl-sale-badge {
      position: absolute;
      top: 6px;
      left: 6px;
      background: #dc2626;
      color: #ffffff;
      font-size: 10px;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 6px;
    }
    .sz-wl-prod-name {
      font-size: 15px;
      font-weight: 700;
      color: #0f172a;
      text-decoration: none;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      max-width: 290px;
    }
    .sz-wl-prod-name:hover { color: #008374; }
    .sz-wl-cat-pill {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      color: #065f5b;
      background: #e6f4f3;
      padding: 2px 9px;
      border-radius: 999px;
      margin-top: 5px;
    }
    .sz-wl-stock-ok {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      font-weight: 700;
      color: #047857;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      padding: 4px 10px;
      border-radius: 999px;
      white-space: nowrap;
    }
    .sz-wl-stock-out {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      font-weight: 700;
      color: #b91c1c;
      background: #fef2f2;
      border: 1px solid #fecaca;
      padding: 4px 10px;
      border-radius: 999px;
      white-space: nowrap;
    }
    .sz-wl-price-now {
      font-size: 16px;
      font-weight: 800;
      color: #008374;
      white-space: nowrap;
    }
    .sz-wl-price-old {
      font-size: 12.5px;
      color: #94a3b8;
      text-decoration: line-through;
      white-space: nowrap;
    }
    .sz-wl-qty-box {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid #cbd5e1;
      border-radius: 999px;
      background: #ffffff;
      width: 106px;
      padding: 5px 10px;
    }
    .sz-wl-qty-btn {
      border: none;
      background: transparent;
      color: #334155;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
    }
    .sz-wl-qty-btn:hover:not(:disabled) { color: #008374; }
    .sz-wl-qty-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .sz-wl-btn-buy {
      background: #fde047;
      color: #022c22;
      border: 1px solid #facc15;
      border-radius: 999px;
      padding: 8px 15px;
      font-size: 12.5px;
      font-weight: 800;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.18s ease;
    }
    .sz-wl-btn-buy:hover:not(:disabled) { background: #facc15; transform: translateY(-1px); }
    .sz-wl-btn-cart {
      background: #008374;
      color: #ffffff;
      border: 1px solid #008374;
      border-radius: 999px;
      padding: 8px 15px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: all 0.18s ease;
    }
    .sz-wl-btn-cart:hover:not(:disabled) { background: #065f5b; transform: translateY(-1px); }
    .sz-wl-btn-buy:disabled, .sz-wl-btn-cart:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }
    .sz-wl-btn-del {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      color: #64748b;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.18s ease;
    }
    .sz-wl-btn-del:hover {
      background: #fef2f2;
      border-color: #fecaca;
      color: #dc2626;
    }
    .sz-wl-empty {
      padding: 64px 24px;
      text-align: center;
    }
    .sz-wl-empty-ic {
      width: 72px;
      height: 72px;
      border-radius: 22px;
      background: #e6f4f3;
      color: #008374;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 34px;
      margin-bottom: 14px;
    }
  </style>
}

<div class="sz-wl-shell">
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="sz-wl-crumb">
      <a href='@Url.Action("Index", "Home")'>
        <i class="hgi hgi-stroke hgi-home-01 text-base"></i>
        <span>Trang chủ</span>
      </a>
      <span>•</span>
      <a href="/my-account">Tài khoản của tôi</a>
      <span>•</span>
      <span style="color: #0f172a; font-weight: 700;">Sản phẩm yêu thích</span>
    </nav>

    @if (!Model.IsSignedIn)
    {
      <div class="sz-wl-card">
        <div class="sz-wl-empty">
          <div class="sz-wl-empty-ic">
            <i class="hgi hgi-stroke hgi-favourite"></i>
          </div>
          <h4 style="font-size: 22px; font-weight: 800; color: #0f172a; margin: 0 0 8px;">Đăng nhập để xem Danh sách Yêu thích</h4>
          <p style="color: #64748b; font-size: 14.5px; max-width: 440px; margin: 0 auto 24px;">
            Lưu lại những sản phẩm bạn yêu thích để theo dõi biến động giá, săn Flash Sale và thêm vào giỏ hàng nhanh chóng.
          </p>
          <a href="#" class="btn btn-primary rounded-full px-8 py-3 font-bold login-page-btn">Đăng nhập ngay</a>
        </div>
      </div>
    }
    else
    {
      <!-- Hero Banner -->
      <div class="sz-wl-hero">
        <div style="display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 16px;">
          <div>
            <div class="sz-wl-hero-badge">❤️ Bộ sưu tập cá nhân Sellzy</div>
            <h1>Sản phẩm Yêu thích của tôi</h1>
            <p class="sz-wl-hero-sub">Theo dõi tình trạng tồn kho, ưu đãi giảm giá và thêm nhanh nhiều sản phẩm vào giỏ hàng chỉ với 1 chạm.</p>
          </div>
          <div class="sz-wl-nav-pills">
            <a href="/my-account" class="sz-wl-nav-pill"><i class="hgi hgi-stroke hgi-user-circle"></i> Tài khoản</a>
            <a href="/my-orders" class="sz-wl-nav-pill"><i class="hgi hgi-stroke hgi-package"></i> Đơn mua</a>
            <a href="/vouchers" class="sz-wl-nav-pill"><i class="hgi hgi-stroke hgi-ticket-01"></i> Kho Voucher</a>
          </div>
        </div>

        <div class="sz-wl-kpi-grid">
          <div class="sz-wl-kpi">
            <span class="sz-wl-kpi-ic" style="background: rgba(253,224,71,0.18); color: #fde047;">
              <i class="hgi hgi-stroke hgi-favourite"></i>
            </span>
            <div>
              <div class="sz-wl-kpi-val">@items.Count</div>
              <div class="sz-wl-kpi-lbl">Tổng sản phẩm đã lưu</div>
            </div>
          </div>
          <div class="sz-wl-kpi">
            <span class="sz-wl-kpi-ic" style="background: rgba(52,211,153,0.22); color: #6ee7b7;">
              <i class="hgi hgi-stroke hgi-checkmark-circle-02"></i>
            </span>
            <div>
              <div class="sz-wl-kpi-val">@inStockCount</div>
              <div class="sz-wl-kpi-lbl">Sẵn hàng có thể đặt ngay</div>
            </div>
          </div>
          <div class="sz-wl-kpi">
            <span class="sz-wl-kpi-ic" style="background: rgba(251,146,60,0.24); color: #fdba74;">
              <i class="hgi hgi-stroke hgi-flash"></i>
            </span>
            <div>
              <div class="sz-wl-kpi-val">@onSaleCount</div>
              <div class="sz-wl-kpi-lbl">Đang có giá khuyến mãi</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Wishlist Card -->
      <div class="sz-wl-card">
        @if (items.Count == 0)
        {
          <div class="sz-wl-empty">
            <div class="sz-wl-empty-ic">
              <i class="hgi hgi-stroke hgi-favourite"></i>
            </div>
            <h4 style="font-size: 21px; font-weight: 800; color: #0f172a; margin: 0 0 8px;">Danh sách yêu thích đang trống</h4>
            <p style="color: #64748b; font-size: 14.5px; max-width: 460px; margin: 0 auto 24px;">
              Hãy nhấn biểu tượng trái tim trên bất kỳ sản phẩm nào bạn quan tâm để lưu lại và so sánh dễ dàng hơn.
            </p>
            <div style="display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;">
              <a href='@Url.Action("Index", "Home")' class="sz-wl-btn-cart" style="text-decoration: none; padding: 11px 24px; font-size: 14px;">
                <i class="hgi hgi-stroke hgi-shopping-bag-02"></i>
                <span>Khám phá sản phẩm ngay</span>
              </a>
              <a href="/Home/FlashSale" class="sz-wl-btn-buy" style="text-decoration: none; padding: 11px 22px; font-size: 14px;">
                🔥 Xem Flash Sale hôm nay
              </a>
            </div>
          </div>
        }
        else
        {
          <div data-wishlist-page>
            <!-- Toolbar -->
            <div class="sz-wl-toolbar">
              <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px;">
                <div class="sz-wl-search-wrap">
                  <i class="hgi hgi-stroke hgi-search-01"></i>
                  <input type="text" id="sz-wl-search" placeholder="Tìm sản phẩm đã lưu..." />
                </div>
                <button type="button" class="sz-wl-filter-btn is-active" onclick="filterWishlistRows('all', this)">Tất cả (@items.Count)</button>
                <button type="button" class="sz-wl-filter-btn" onclick="filterWishlistRows('instock', this)">Còn hàng (@inStockCount)</button>
                <button type="button" class="sz-wl-filter-btn" onclick="filterWishlistRows('sale', this)">Đang giảm giá (@onSaleCount)</button>
              </div>

              <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                <span style="font-size: 13.5px; font-weight: 700; color: #334155;">
                  Đã chọn: <strong style="color: #008374;" data-wishlist-selected-count>0</strong> sản phẩm
                </span>
                <button type="button" class="sz-wl-bulk-btn" data-wishlist-add-selected disabled>
                  <i class="hgi hgi-stroke hgi-shopping-cart-02 text-lg"></i>
                  <span>Thêm đã chọn vào giỏ</span>
                </button>
              </div>
            </div>

            <!-- Table -->
            <div class="wishlist-table-wrapper overflow-x-auto">
              <table class="sz-wl-table wishlist-table">
                <thead>
                  <tr>
                    <th style="width: 52px; text-align: center;">
                      <label class="relative inline-flex w-5 h-5 cursor-pointer items-center justify-center" title="Chọn tất cả sản phẩm còn hàng">
                        <input type="checkbox" data-wishlist-select-all class="peer appearance-none w-full h-full border-2 focus:outline-none checked:border-none border-gray-400 rounded-sm bg-white checked:bg-primary transition-all" />
                        <span class="absolute inset-0 inline-flex items-center justify-center text-white opacity-0 peer-checked:opacity-100 transition-all">
                          <i class="hgi hgi-stroke hgi-tick-02 text-[16px] leading-[16px]"></i>
                        </span>
                      </label>
                    </th>
                    <th class="text-left">Sản phẩm</th>
                    <th class="text-left">Tình trạng kho</th>
                    <th class="text-left">Đơn giá</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-left">Thao tác mua</th>
                    <th class="text-center" style="width: 68px;">Xóa</th>
                  </tr>
                </thead>
                <tbody id="sz-wl-tbody">
                  @foreach (var it in items)
                  {
                    var hasVariant = it.VariantId > 0;
                    var inStock = it.AvailableStock > 0;
                    var canAdd = hasVariant && inStock;
                    var ratingPct = (int)Math.Round(Math.Clamp((double)(it.AverageRating / 5m * 100m), 0d, 100d));
                    var detailsUrl = Url.RouteUrl("product_details", new { slug = it.ProductSlug }) ?? Url.Action("Details", "Products", new { slug = it.ProductSlug }) ?? "#";
                    var imgUrl = ImageUrlHelper.NormalizeStaticFileUrl(it.ProductImageUrl) ?? Url.Content("~/assets/images/vitamin-c.png");
                    var categoryName = string.IsNullOrWhiteSpace(it.CategoryName) ? "" : it.CategoryName;
                    var showSale = it.SalePrice.HasValue && it.SalePrice.Value > 0m && it.SalePrice.Value < it.Price;
                    var discountPct = showSale && it.Price > 0m
                      ? (int)Math.Round((it.Price - it.SalePrice!.Value) * 100m / it.Price)
                      : 0;

                    <tr class="product-add-to-cart-section js-wl-row"
                        data-variant-id="@it.VariantId"
                        data-name="@((it.ProductName ?? "").ToLowerInvariant())"
                        data-instock="@(inStock ? "1" : "0")"
                        data-sale="@(showSale ? "1" : "0")">
                      <td style="text-align: center;">
                        <label class="relative inline-flex w-5 h-5 cursor-pointer items-center justify-center">
                          <input type="checkbox" data-wishlist-item-select class="peer appearance-none w-full h-full border-2 focus:outline-none checked:border-none border-gray-300 rounded-sm bg-white checked:bg-primary transition-all" @(canAdd ? null : "disabled") />
                          <span class="absolute inset-0 inline-flex items-center justify-center text-white opacity-0 peer-checked:opacity-100 transition-all">
                            <i class="hgi hgi-stroke hgi-tick-02 text-[16px] leading-[16px]"></i>
                          </span>
                        </label>
                      </td>

                      <td>
                        <div style="display: flex; align-items: center; gap: 14px;">
                          <a href="@detailsUrl" class="sz-wl-thumb-wrap">
                            <img src="@imgUrl" alt="@it.ProductName" />
                            @if (discountPct > 0)
                            {
                              <span class="sz-wl-sale-badge">-@discountPct%</span>
                            }
                          </a>
                          <div style="min-width: 0;">
                            <a class="sz-wl-prod-name" href="@detailsUrl">@it.ProductName</a>
                            @if (!string.IsNullOrWhiteSpace(categoryName))
                            {
                              <div><span class="sz-wl-cat-pill">@categoryName</span></div>
                            }
                            <div style="display: flex; align-items: center; gap: 6px; margin-top: 6px;">
                              <div class="bg-[url('../images/star-icon.png')] w-[90px] h-4.5 bg-repeat-x overflow-hidden bg-position-[0_0]">
                                <div style="width: @ratingPct%" class="bg-[url('../images/star-icon.png')] h-4.5 bg-repeat-x bg-position-[0_-18px]"></div>
                              </div>
                              <span style="font-size: 12px; color: #64748b;">(@it.ReviewCount đánh giá)</span>
                            </div>
                          </div>
                        </div>
                      </td>

                      <td>
                        @if (inStock)
                        {
                          <span class="sz-wl-stock-ok">● Còn @it.AvailableStock SP</span>
                        }
                        else
                        {
                          <span class="sz-wl-stock-out">✕ Tạm hết hàng</span>
                        }
                      </td>

                      <td>
                        <div style="display: flex; flex-direction: column; gap: 2px;">
                          @if (showSale)
                          {
                            <span class="sz-wl-price-now product-offer-price">@FormatVnd(it.SalePrice!.Value)</span>
                            <span class="sz-wl-price-old">@FormatVnd(it.Price)</span>
                          }
                          else
                          {
                            <span class="sz-wl-price-now product-offer-price">@FormatVnd(it.Price)</span>
                          }
                        </div>
                      </td>

                      <td style="text-align: center;">
                        <div class="sz-wl-qty-box">
                          <button type="button" data-wishlist-qty-minus class="sz-wl-qty-btn" @(canAdd ? null : "disabled") aria-label="Giảm số lượng">
                            <i class="hgi hgi-stroke hgi-remove-circle text-lg"></i>
                          </button>
                          <input type="text" readonly value="1" class="quantity-input border-0 w-full grow text-center focus:outline-none font-bold text-sm" style="color: #0f172a;" />
                          <button type="button" data-wishlist-qty-plus class="sz-wl-qty-btn" @(canAdd ? null : "disabled") aria-label="Tăng số lượng">
                            <i class="hgi hgi-stroke hgi-add-circle text-lg"></i>
                          </button>
                        </div>
                      </td>

                      <td>
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: nowrap;">
                          <button type="button" class="sz-wl-btn-buy product-buy-now" data-buy-now data-variant-id="@it.VariantId" @(canAdd ? null : "disabled")>
                            Mua ngay
                          </button>
                          <button type="button" class="sz-wl-btn-cart product-add-to-cart" data-add-to-cart data-variant-id="@it.VariantId" @(canAdd ? null : "disabled")>
                            <i class="hgi hgi-stroke hgi-shopping-cart-02 text-base"></i>
                            <span>Thêm giỏ</span>
                          </button>
                        </div>
                      </td>

                      <td style="text-align: center;">
                        <form method="post" action='@Url.Content("/my-wishlist/remove")'>
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="productId" value="@it.ProductId" />
                          <button type="submit" class="sz-wl-btn-del" aria-label="Xóa khỏi yêu thích" title="Xóa khỏi danh sách yêu thích">
                            <i class="hgi hgi-stroke hgi-delete-01 text-lg"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  }
                  <tr id="sz-wl-no-match" style="display: none;">
                    <td colspan="7" style="text-align: center; padding: 36px 16px; color: #64748b; font-size: 14px;">
                      Không tìm thấy sản phẩm yêu thích nào khớp với bộ lọc hiện tại.
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        }
      </div>
    }
  </div>
</div>

@section Scripts {
  <script>
    (function () {
      let activeFilter = 'all';
      const searchInput = document.getElementById('sz-wl-search');
      const rows = Array.from(document.querySelectorAll('.js-wl-row'));
      const noMatchRow = document.getElementById('sz-wl-no-match');

      function applyFilter() {
        const q = (searchInput?.value || '').trim().toLowerCase();
        let shown = 0;
        rows.forEach(r => {
          const name = r.dataset.name || '';
          const instock = r.dataset.instock === '1';
          const sale = r.dataset.sale === '1';

          let ok = !q || name.includes(q);
          if (ok && activeFilter === 'instock') ok = instock;
          if (ok && activeFilter === 'sale') ok = sale;

          r.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });
        if (noMatchRow) noMatchRow.style.display = shown === 0 ? '' : 'none';
      }

      window.filterWishlistRows = function (mode, btnEl) {
        activeFilter = mode;
        document.querySelectorAll('.sz-wl-filter-btn').forEach(b => b.classList.toggle('is-active', b === btnEl));
        applyFilter();
      };

      if (searchInput) {
        searchInput.addEventListener('input', applyFilter);
      }
    })();
  </script>
}
