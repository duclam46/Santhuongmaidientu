                              data-address-type="@a.AddressType"
                              data-province-id="@a.ProvinceId"
                              data-province-name="@a.ProvinceName"
                              data-district-id="@a.DistrictId"
                              data-district-name="@a.DistrictName"
                              data-ward-code="@a.WardCode"
