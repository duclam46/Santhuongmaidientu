@model DOAN_BANHANG.ViewModels.MyAccountPageVm

@{
  ViewData["Title"] = "Tài khoản";

  var account = Model.Account;
  var displayName = account is null
    ? "Tài khoản"
    : (!string.IsNullOrWhiteSpace(account.FullName) ? account.FullName : account.Email);

  string ResolveImageUrl(string? rawUrl)
  {
    if (string.IsNullOrWhiteSpace(rawUrl))
    {
      return Url.Content("~/assets/images/blog/user-avatar-1.png");
    }

    rawUrl = rawUrl.Trim();

    if (rawUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
        || rawUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
        || rawUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
    {
      return rawUrl;
    }

    if (rawUrl.StartsWith("~/", StringComparison.Ordinal))
    {
      return Url.Content(rawUrl);
    }

    if (rawUrl.StartsWith("/", StringComparison.Ordinal))
    {
      return rawUrl;
    }

    return Url.Content("~/" + rawUrl.TrimStart('/'));
  }

  string FormatVnd(decimal amount)
  {
    return string.Format("{0:N0}đ", amount);
  }

  (string tabKey, string label, string pillClass) ResolveOrderStatusUi(string? rawStatus, bool isReceivedByCustomer = false)
  {
    var s = (rawStatus ?? string.Empty).Trim();
    var norm = s.Replace(" ", string.Empty).ToLowerInvariant();

    const string basePill = "inline-flex items-center justify-center whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold leading-5";

    return norm switch
    {
      "pendingconfirmation" or "waitconfirm" or "waitingconfirm" or "confirming" or "pending" or "confirmationpending" or "processing" or "inprocess" or "inprocessing" or "inprocess" or "chờxácnhận" or "choxacnhan" => (
        "pending-confirmation",
        "Chờ xác nhận",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "awaitingpickup" or "waitpickup" or "waitingpickup" or "readytopick" or "pickup" or "chờlấyhàng" or "cholayhang" => (
        "awaiting-pickup",
        "Chờ lấy hàng",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "confirmed" or "accepted" or "đãxácnhận" or "daxacnhan" => (
        "awaiting-pickup",
        "Chờ lấy hàng",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "shipping" or "delivering" or "intransit" or "đanggiao" or "danggiao" => (
        "delivering",
        "Đang giao",
        $"{basePill} bg-primary/8 text-primary"
      ),
      "completed" or "success" or "hoàntất" or "hoantat" => (
        "completed",
        "Hoàn tất",
        $"{basePill} bg-success-light text-success-dark"
      ),
      "delivered" or "deliverysuccess" or "dagiao" or "đãgiao" => isReceivedByCustomer ? (
        "completed",
        "Hoàn tất",
        $"{basePill} bg-success-light text-success-dark"
      ) : (
        "delivering",
        "Đang giao (Đã giao)",
        $"{basePill} bg-primary/8 text-primary"
      ),
      "returned" or "return" or "refund" or "returnrequest" or "returning" or "trahang" or "trảhàng" => (
        "returned",
        "Trả hàng",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "cancelled" or "canceled" or "cancel" or "đãhủy" or "dahuy" => (
        "cancelled",
        "Đã hủy",
        $"{basePill} bg-error-light text-error-dark"
      ),
      _ => (
        "pending-confirmation",
        "Chờ xác nhận",
        $"{basePill} bg-warning-light text-warning-dark"
      )
    };
  }

  string ResolvePaymentBadge(string? rawPaymentStatus)
  {
    var s = (rawPaymentStatus ?? string.Empty).Trim();
    var norm = s.Replace(" ", string.Empty).ToLowerInvariant();
    return norm is "paid" or "success" or "completed" ? "(Đã thanh toán)" : "(Chưa thanh toán)";
  }
}

<!-- ========== Breadcrumb Section Start ========== -->
<div class="container py-12">
  <div class="breadcrumb">
    <ul>
      <li>
        <a href='@Url.Action("Index", "Home")'>
          <span class="inline-flex items-center justify-center">
            <i class="hgi hgi-stroke hgi-home-01 text-2xl leading-6"></i>
          </span>
          Home
        </a>
      </li>
      <li class="text-light-disabled-text">&#8226;</li>
      <li><span class="text-sm leading-[22px]">Tài khoản</span></li>
    </ul>
  </div>
</div>
<!-- ========== Breadcrumb Section End ========== -->

<section class="pb-[90px]">
  <div class="container">
    <div class="grid grid-cols-12 gap-y-6 lg:gap-x-6">
      <div class="xl:col-span-3 lg:col-span-4 col-span-12">
        <div class="border border-gray-300 rounded-2xl p-6">
          <div class="flex items-center gap-x-4 pb-6 border-b border-gray-300">
            <div class="size-14 rounded-full overflow-hidden bg-gray-200">
              <img src="@(ResolveImageUrl(account?.AvatarUrl))" alt="Avatar" class="w-full h-full object-cover" />
            </div>
            <div>
              <p class="text-sm leading-[22px] text-light-secondary-text">Xin chào</p>
              <p id="my-account-display-name-left" class="text-base leading-6 text-light-primary-text font-semibold">@displayName</p>
              @if (Model.IsSignedIn)
              {
                <p class="text-xs leading-[18px] text-light-secondary-text">@account!.Email</p>
              }
            </div>
          </div>

          <ul class="my-account-menu flex flex-col gap-y-1 pt-6">
            <li>
              <p class="px-2 pb-2 text-xs leading-[18px] text-primary font-semibold uppercase">Dashboard</p>
            </li>
            <li>
              <button type="button" data-tab="dashboard" class="active w-full text-left px-4 py-3 rounded-xl text-light-primary-text font-semibold hover:bg-primary/8 hover:text-primary transition-colors duration-300">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-dashboard-square-01 text-xl"></i>
                  Tổng quan
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="orders" class="w-full text-left px-4 py-3 rounded-xl text-light-primary-text font-semibold hover:bg-primary/8 hover:text-primary transition-colors duration-300">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-package text-xl"></i>
                  Đơn hàng
                </span>
              </button>
            </li>
            <li>
              <a href="/my-wallet" class="w-full flex items-center justify-between px-4 py-3 rounded-xl text-light-primary-text font-semibold hover:bg-blue-50 hover:text-blue-600 transition-colors duration-300" style="background: linear-gradient(135deg, rgba(37,99,235,0.06), rgba(124,58,237,0.02))">
                <span class="inline-flex items-center gap-x-3">
                  <span style="font-size:18px;">💳</span>
                  Số dư tài khoản
                </span>
                <i class="hgi hgi-stroke hgi-arrow-right-01 text-xs text-blue-500"></i>
              </a>
            </li>

            <li class="pt-4 mt-3 border-t border-gray-200">
              <p class="px-2 pb-2 text-xs leading-[18px] text-primary font-semibold uppercase">Account settings</p>
            </li>
            <li>
              <button type="button" data-tab="account-details" class="w-full text-left px-4 py-3 rounded-xl text-light-primary-text font-semibold hover:bg-primary/8 hover:text-primary transition-colors duration-300">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-user-circle text-xl"></i>
                  Thông tin cá nhân
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="password" class="w-full text-left px-4 py-3 rounded-xl text-light-primary-text font-semibold hover:bg-primary/8 hover:text-primary transition-colors duration-300">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-lock-sync-01 text-xl"></i>
                  Đổi mật khẩu
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="address" class="w-full text-left px-4 py-3 rounded-xl text-light-primary-text font-semibold hover:bg-primary/8 hover:text-primary transition-colors duration-300">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-location-01 text-xl"></i>
                  Địa chỉ
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="wishlist" class="w-full text-left px-4 py-3 rounded-xl text-light-primary-text font-semibold hover:bg-primary/8 hover:text-primary transition-colors duration-300">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-favourite text-xl"></i>
                  Yêu thích
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="reviews" class="w-full text-left px-4 py-3 rounded-xl text-light-primary-text font-semibold hover:bg-primary/8 hover:text-primary transition-colors duration-300">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-star text-xl"></i>
                  Reviews
                </span>
              </button>
            </li>
            @if (Model.IsSignedIn)
            {
              <li class="pt-3">
                <button type="button" data-tab="logout" class="logout-btn w-full text-left px-4 py-3 rounded-xl text-light-primary-text font-semibold hover:bg-primary/8 hover:text-primary transition-colors duration-300">
                  <span class="inline-flex items-center gap-x-3">
                    <i class="hgi hgi-stroke hgi-logout-01 text-xl"></i>
                    Đăng xuất
                  </span>
                </button>
              </li>
            }
          </ul>
        </div>
      </div>

      <div class="xl:col-span-9 lg:col-span-8 col-span-12">
        <div class="border border-gray-300 rounded-2xl p-6">
          <div id="my-account-ajax-message" class="mb-6 p-4 rounded-2xl hidden"></div>
          @if (TempData["AccountSuccess"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
          {
            <div class="my-account-status-message mb-6 p-4 rounded-2xl bg-success-light text-light-primary-text">
              @okMsg
            </div>
          }
          @if (TempData["AccountError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
          {
            <div class="my-account-status-message mb-6 p-4 rounded-2xl bg-warning-light text-light-primary-text">
              @errMsg
            </div>
          }

          <div class="my-account-content">
            <div id="dashboard" class="menu-tab-pane">
              @if (!Model.IsSignedIn)
              {
                <h4 class="pb-3">Bạn chưa đăng nhập</h4>
                <p class="text-light-secondary-text pb-6">
                  Vui lòng đăng nhập để xem thông tin tài khoản.
                </p>
                <a href="#" class="btn btn-primary login-page-btn">Đăng nhập</a>
              }
              else
              {
                var orders = Model.Account?.Orders ?? new List<OrderSummaryVm>();
                var totalOrders = orders.Count;
                var completedOrdersCount = orders.Count(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "completed");
                var processingOrdersCount = orders.Count(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey is "pending-confirmation" or "awaiting-pickup");
                var cancelledOrdersCount = orders.Count(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "cancelled");
                var wishlistCount = 0;
                var reviewsCount = Model.Account?.ReviewsTotalCount ?? 0;
                var recentOrders = orders.Take(5).ToList();
                var recentReviews = Model.Account?.RecentReviews ?? new List<ReviewSummaryVm>();

                <div class="pb-6">
                  <h3 class="text-light-primary-text">Tổng quan</h3>
                  <p class="text-light-secondary-text pt-1">
                    Xin chào <span id="my-account-display-name-dashboard" class="text-light-primary-text font-semibold">@displayName</span>.
                  </p>
                </div>

                <div class="grid grid-cols-12 gap-4">
                  <!-- Card Số dư tài khoản (Premium Wallet Style) -->
                  <div class="md:col-span-4 col-span-12 rounded-2xl p-5 border border-blue-100 hover:border-blue-200 transition-all shadow-sm"
                       style="background: linear-gradient(135deg, #eff6ff 0%, #faf5ff 100%)">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-x-3">
                        <div class="size-12 rounded-2xl bg-blue-600 text-white inline-flex items-center justify-center shadow-md shadow-blue-500/20">
                          <span style="font-size:20px;">💳</span>
                        </div>
                        <div>
                          <p id="dashboard-wallet-balance" class="text-2xl leading-7 text-blue-700 font-bold">Đang tải...</p>
                          <p class="text-xs leading-[18px] text-gray-500 font-medium">Số dư tài khoản</p>
                        </div>
                      </div>
                      <a href="/my-wallet" class="btn btn-small rounded-full bg-blue-600 hover:bg-blue-700 text-white font-bold px-3 py-1.5 shadow-sm transition-all" style="font-size:11px">
                        Nạp ngay
                      </a>
                    </div>
                  </div>

                  <div class="md:col-span-4 col-span-12 bg-success-lighter rounded-2xl p-5">
                    <div class="flex items-center gap-x-4">
                      <div class="size-12 rounded-2xl bg-success-light text-success-dark inline-flex items-center justify-center">
                        <i class="hgi hgi-stroke hgi-package text-2xl leading-6"></i>
                      </div>
                      <div>
                        <p class="text-2xl leading-7 text-light-primary-text font-semibold">@totalOrders</p>
                        <p class="text-sm leading-[22px] text-light-secondary-text">Total Order</p>
                      </div>
                    </div>
                  </div>

                  <div class="md:col-span-4 col-span-12 bg-primary-lighter rounded-2xl p-5">
                    <div class="flex items-center gap-x-4">
                      <div class="size-12 rounded-2xl bg-primary text-white inline-flex items-center justify-center">
                        <i class="hgi hgi-stroke hgi-checkmark-circle-02 text-2xl leading-6"></i>
                      </div>
                      <div>
                        <p class="text-2xl leading-7 text-light-primary-text font-semibold">@completedOrdersCount</p>
                        <p class="text-sm leading-[22px] text-light-secondary-text">Completed Order</p>
                      </div>
                    </div>
                  </div>

                  <div class="md:col-span-4 col-span-12 bg-warning-lighter rounded-2xl p-5">
                    <div class="flex items-center gap-x-4">
                      <div class="size-12 rounded-2xl bg-warning text-white inline-flex items-center justify-center">
                        <i class="hgi hgi-stroke hgi-time-quarter-pass text-2xl leading-6"></i>
                      </div>
                      <div>
                        <p class="text-2xl leading-7 text-light-primary-text font-semibold">@processingOrdersCount</p>
                        <p class="text-sm leading-[22px] text-light-secondary-text">Pending Order</p>
                      </div>
                    </div>
                  </div>

                  <div class="md:col-span-4 col-span-12 bg-error-lighter rounded-2xl p-5">
                    <div class="flex items-center gap-x-4">
                      <div class="size-12 rounded-2xl bg-error text-white inline-flex items-center justify-center">
                        <i class="hgi hgi-stroke hgi-cancel-01 text-2xl leading-6"></i>
                      </div>
                      <div>
                        <p class="text-2xl leading-7 text-light-primary-text font-semibold">@cancelledOrdersCount</p>
                        <p class="text-sm leading-[22px] text-light-secondary-text">Canceled Order</p>
                      </div>
                    </div>
                  </div>

                  <div class="md:col-span-4 col-span-12 bg-gray-100 rounded-2xl p-5">
                    <div class="flex items-center gap-x-4">
                      <div class="size-12 rounded-2xl bg-primary-dark text-white inline-flex items-center justify-center">
                        <i class="hgi hgi-stroke hgi-favourite text-2xl leading-6"></i>
                      </div>
                      <div>
                        <p class="text-2xl leading-7 text-light-primary-text font-semibold">@wishlistCount</p>
                        <p class="text-sm leading-[22px] text-light-secondary-text">Total Wishlist</p>
                      </div>
                    </div>
                  </div>

                  <div class="md:col-span-4 col-span-12 bg-gray-100 rounded-2xl p-5">
                    <div class="flex items-center gap-x-4">
                      <div class="size-12 rounded-2xl bg-primary-darker text-white inline-flex items-center justify-center">
                        <i class="hgi hgi-stroke hgi-star text-2xl leading-6"></i>
                      </div>
                      <div>
                        <p class="text-2xl leading-7 text-light-primary-text font-semibold">@reviewsCount</p>
                        <p class="text-sm leading-[22px] text-light-secondary-text">Total Reviews</p>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-12 gap-4 pt-6">
                  <div class="lg:col-span-8 col-span-12 border border-gray-300 rounded-2xl overflow-x-auto">
                    <div class="p-6 border-b border-gray-300">
                      <h4 class="text-light-primary-text">Your Recent Order</h4>
                    </div>
                    <table class="w-full">
                      <thead>
                        <tr class="border-b border-gray-300 text-left">
                          <th class="py-4 px-6 text-sm leading-[22px] text-light-secondary-text font-semibold">Order ID</th>
                          <th class="py-4 px-6 text-sm leading-[22px] text-light-secondary-text font-semibold">Date</th>
                          <th class="py-4 px-6 text-sm leading-[22px] text-light-secondary-text font-semibold">Status</th>
                          <th class="py-4 px-6 text-sm leading-[22px] text-light-secondary-text font-semibold">Amount</th>
                          <th class="py-4 px-6 text-sm leading-[22px] text-light-secondary-text font-semibold">Action</th>
                        </tr>
                      </thead>
                      <tbody>
                        @if (recentOrders.Count == 0)
                        {
                          <tr>
                            <td class="py-5 px-6" colspan="5">
                              <p class="text-light-secondary-text">Chưa có đơn hàng nào.</p>
                            </td>
                          </tr>
                        }
                        else
                        {
                          foreach (var o in recentOrders)
                          {
                            var ui = ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer);
                            <tr class="border-b border-gray-300">
                              <td class="py-5 px-6 text-light-primary-text font-semibold">#@(!string.IsNullOrWhiteSpace(o.OrderCode) ? o.OrderCode : o.Id.ToString())</td>
                              <td class="py-5 px-6 text-light-secondary-text">@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                              <td class="py-5 px-6">
                                <span class="@ui.pillClass">@ui.label</span>
                              </td>
                              <td class="py-5 px-6 text-light-primary-text font-semibold">@FormatVnd(o.FinalAmount)</td>
                              <td class="py-5 px-6">
                                  <div class="flex flex-wrap items-center gap-2">
                                    <a class="btn btn-default outline btn-small rounded-full"
                                       href='@Url.Action("OrderDetails", "Account", new { id = o.Id })'>Xem</a>

                                    @if (ui.tabKey is "pending-confirmation" or "awaiting-pickup")
                                    {
                                      <form method="post" action="/my-orders/cancel" class="inline-flex" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không? Hành động này không thể hoàn tác.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Id" value="@o.Id" />
                                        <input type="hidden" name="ReturnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                        <button type="submit" class="btn btn-small rounded-full bg-error text-white ring-1 ring-inset ring-error-dark/20">Hủy</button>
                                      </form>
                                    }
                                  </div>
                              </td>
                            </tr>
                          }
                        }
                      </tbody>
                    </table>
                  </div>

                  <div class="lg:col-span-4 col-span-12 border border-gray-300 rounded-2xl overflow-hidden">
                    <div class="p-6 border-b border-gray-300">
                      <h4 class="text-light-primary-text">Your Recent Reviews</h4>
                    </div>
                    <div class="p-6">
                      @if (recentReviews.Count == 0)
                      {
                        <p class="text-light-secondary-text">Chưa có đánh giá nào.</p>
                      }
                      else
                      {
                        <div class="flex flex-col gap-y-5">
                          @foreach (var r in recentReviews)
                          {
                            var img = string.IsNullOrWhiteSpace(r.ProductImageUrl)
                              ? Url.Content("~/assets/images/product-details/product-details-1.png")
                              : ResolveImageUrl(r.ProductImageUrl);

                            <div class="flex gap-x-4">
                              <div class="size-16 rounded-2xl overflow-hidden bg-gray-200 shrink-0">
                                <img src="@img" alt="@r.ProductName" class="w-full h-full object-cover" />
                              </div>
                              <div class="min-w-0">
                                <div class="flex items-start justify-between gap-x-3">
                                  <a class="text-light-primary-text font-semibold truncate" href='@Url.RouteUrl("product_details", new { slug = r.ProductSlug })'>@r.ProductName</a>
                                  <span class="inline-flex items-center gap-x-1 shrink-0">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                      var starClass = i <= Math.Clamp(r.Rating, 0, 5) ? "text-warning" : "text-gray-300";
                                      <i class="hgi hgi-stroke hgi-star text-base leading-4 @starClass"></i>
                                    }
                                  </span>
                                </div>
                                <p class="text-xs leading-[18px] text-light-secondary-text pt-1">@r.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy")</p>
                                <p class="text-sm leading-[22px] text-light-secondary-text pt-2">
                                  @(string.IsNullOrWhiteSpace(r.Comment) ? "(Không có nội dung đánh giá.)" : r.Comment)
                                </p>
                              </div>
                            </div>
                          }
                        </div>
                      }
                    </div>
                  </div>
                </div>
              }
            </div>

            <div id="account-details" class="menu-tab-pane hidden">
              <h4 class="pb-6">Thông tin tài khoản</h4>

              @if (!Model.IsSignedIn)
              {
                <p class="text-light-secondary-text">Vui lòng đăng nhập để xem thông tin.</p>
              }
              else
              {
                <div class="border border-gray-300 rounded-2xl">
                  <div class="py-4 px-6 bg-gray-200 rounded-t-2xl">
                    <h5 class="text-light-primary-text">Personal Information</h5>
                  </div>

                  <div class="px-6 py-6">
                    <div class="flex flex-col gap-y-6">
                      <form id="update-profile-form" method="post" action="/my-account/update-profile" enctype="multipart/form-data" class="flex flex-col gap-y-6">
                        @Html.AntiForgeryToken()

                        <div class="flex items-center justify-center">
                          <div class="w-[144px] h-[144px] flex items-center justify-center border-2 border-dashed border-gray-300 rounded-full hover:border-primary transition-all duration-300 ease-in-out">
                            <label class="flex flex-col items-center justify-center w-[128px] h-[128px] bg-gray-100 rounded-full cursor-pointer overflow-hidden">
                              <input type="file" name="AvatarFile" accept="image/*" class="hidden" />

                              @if (!string.IsNullOrWhiteSpace(account!.AvatarUrl))
