<script>
document.addEventListener("DOMContentLoaded", function () {
    const modal = document.getElementById("shopeeReviewModal");
    const openBtns = document.querySelectorAll(".js-open-review-modal");
    const closeBtn = document.getElementById("reviewModalCloseBtn");
    const form = document.getElementById("shopeeReviewForm");

    const pIdInput = document.getElementById("reviewProductId");
    const pImg = document.getElementById("reviewProductImg");
    const pName = document.getElementById("reviewProductName");
    const pVariant = document.getElementById("reviewProductVariant");

    const starInput = document.getElementById("reviewRatingInput");
    const ratingLabel = document.getElementById("reviewRatingLabel");
    const stars = document.querySelectorAll("#reviewStarsRow .review-star-item");
    const textarea = document.getElementById("reviewTextarea");
    const charCount = document.getElementById("reviewCharCount");
    const submitBtn = document.getElementById("reviewSubmitBtn");

    const starLabels = {
        5: "Cực kỳ hài lòng",
        4: "Rất hài lòng",
        3: "Hài lòng",
        2: "Không hài lòng",
        1: "Tệ"
    };

    const ratingPlaceholders = {
        5: "Chất liệu: Tôi thấy chất liệu nhựa dẻo và tròng kính rất chắc chắn, bền đẹp.\nMàu sắc: Đen bóng cực kỳ sang và thời thượng, dễ phối đồ.\nHãy chia sẻ nhận xét chi tiết hơn về sản phẩm này bạn nhé!",
        4: "Chất liệu: Tốt, cứng cáp so với tầm giá.\nMàu sắc: Đẹp, giống hình mô tả.\nHãy chia sẻ nhận xét chi tiết hơn về sản phẩm này bạn nhé!",
        3: "Chất liệu: Tạm ổn.\nMàu sắc: Hơi khác ảnh một chút nhưng vẫn chấp nhận được.\nHãy chia sẻ nhận xét chi tiết hơn về sản phẩm này bạn nhé!",
        2: "Chất liệu: Không như mong đợi, gọng kính hơi yếu.\nMàu sắc: Hơi xỉn màu.\nHãy chia sẻ nhận xét chi tiết hơn về sản phẩm này bạn nhé!",
        1: "Chất liệu: Quá kém gọng dễ gãy.\nMàu sắc: Không đúng mô tả.\nHãy chia sẻ nhận xét chi tiết hơn về sản phẩm này bạn nhé!"
    };

    const coinBar = document.querySelector(".review-coin-bar");
    const uploadBox = document.getElementById("reviewUploadBox");
    const fileInput = document.getElementById("reviewFileInput");

    const perfectTemplates = {
        5: "Chất liệu sản phẩm rất tốt, đường may tỉ mỉ chắc chắn. Màu sắc chuẩn đẹp y hệt hình mô tả của shop. Giao hàng cực kỳ nhanh chóng và đóng gói cẩn thận. Rất đáng tiền!",
        4: "Sản phẩm chất lượng khá ổn, đóng gói kỹ càng. Màu sắc đẹp và thời trang. Thời gian giao hàng nhanh, nhân viên thân thiện. Sẽ ủng hộ shop thêm lần sau.",
        3: "Sản phẩm dùng tạm ổn, chất lượng bình thường so với giá tiền. Đóng gói đầy đủ, giao hàng không quá lâu.",
        2: "Sản phẩm không giống mô tả lắm, chất lượng chưa được tốt. Cần cải thiện dịch vụ chăm sóc khách hàng.",
        1: "Chất lượng sản phẩm quá tệ, khác xa so với quảng cáo. Đóng gói sơ sài, giao hàng rất chậm."
    };

    function showReviewToast(msg) {
        let toast = document.createElement("div");
        toast.style.position = "fixed";
        toast.style.bottom = "80px";
        toast.style.left = "50%";
        toast.style.transform = "translateX(-50%)";
        toast.style.background = "#10b981";
        toast.style.color = "#ffffff";
        toast.style.padding = "10px 20px";
        toast.style.borderRadius = "30px";
        toast.style.fontSize = "13px";
        toast.style.fontWeight = "600";
        toast.style.zIndex = "100000";
        toast.style.boxShadow = "0 10px 25px rgba(16, 185, 129, 0.4)";
        toast.style.transition = "all 0.3s ease";
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = "0";
            setTimeout(() => toast.remove(), 300);
        }, 2500);
    }

    // Show detailed guide when clicking the coin bar
    if (coinBar) {
        coinBar.addEventListener("click", function() {
            alert("💡 HƯỚNG DẪN NHẬN 500 XU THƯỞNG:\n\nĐể được cộng ngay 500 xu vào ví của bạn, vui lòng:\n1️⃣ Tải lên ít nhất 1 hình ảnh sản phẩm thực tế.\n2️⃣ Viết nội dung đánh giá từ 50 ký tự trở lên.\n\nChúc bạn nhận xu thành công và mua sắm vui vẻ cùng shop nhé!");
        });
    }

    let selectedFiles = [];
    const previewsGrid = document.getElementById("reviewPreviewsGrid");

    function updatePreviews() {
        if (!previewsGrid) return;
        if (selectedFiles.length === 0) {
            previewsGrid.classList.add("hidden");
            previewsGrid.innerHTML = "";
            fileInput.value = "";
            uploadBox.innerHTML = `
                <span class="review-upload-badge">Yêu cầu: >= 1 ảnh & >= 50 ký tự</span>
                <div class="review-upload-icon">
                  <i class="hgi hgi-stroke hgi-camera-01"></i>
                </div>
                <p class="review-upload-text">Nhấp vào đây để tải lên nhiều ảnh sản phẩm</p>
            `;
            return;
        }

        previewsGrid.classList.remove("hidden");
        previewsGrid.innerHTML = "";
        
        const dt = new DataTransfer();
        
        selectedFiles.forEach((file, index) => {
            dt.items.add(file);
            
            const reader = new FileReader();
            const previewItem = document.createElement("div");
            previewItem.className = "review-preview-item";
            
            reader.onload = function(e) {
                previewItem.innerHTML = `
                    <img src="${e.target.result}" alt="Preview" />
                    <button type="button" class="review-preview-remove" data-index="${index}">&times;</button>
                `;
                previewItem.querySelector(".review-preview-remove").addEventListener("click", function(event) {
                    event.stopPropagation();
                    const removeIdx = parseInt(this.getAttribute("data-index"));
                    selectedFiles.splice(removeIdx, 1);
                    updatePreviews();
                });
            };
            reader.readAsDataURL(file);
            previewsGrid.appendChild(previewItem);
        });

        fileInput.files = dt.files;

        uploadBox.innerHTML = `
            <div style="color: #10b981; font-weight: 600; font-size: 13px;">
                <i class="hgi hgi-stroke hgi-tick-double-02" style="font-size: 20px; vertical-align: middle; margin-right: 4px;"></i>
                Đã chọn ${selectedFiles.length} hình ảnh thực tế
            </div>
            <p style="font-size: 11px; color: #64748b; margin-top: 4px; margin-bottom: 0;">(Nhấp để thêm ảnh thực tế khác)</p>
        `;
    }

    // Image Upload Interaction
    if (uploadBox && fileInput) {
        uploadBox.addEventListener("click", () => fileInput.click());
        fileInput.addEventListener("change", function() {
            if (this.files && this.files.length > 0) {
                for (let file of this.files) {
                    selectedFiles.push(file);
                }
                updatePreviews();
            }
        });
    }

    // Open Modal
    openBtns.forEach(btn => {
        btn.addEventListener("click", function () {
            const pId = this.getAttribute("data-product-id");
            const name = this.getAttribute("data-product-name");
            const img = this.getAttribute("data-product-image");
            const variant = this.getAttribute("data-product-variant");

            pIdInput.value = pId;
            pName.textContent = name;
            pVariant.textContent = variant || "Mặc định";
            pImg.src = img || "/assets/images/placeholder.png";

            // Reset Form Values
            setStars(5);
            textarea.value = "";
            charCount.textContent = "0 ký tự";
            fileInput.value = "";
            selectedFiles = [];
            updatePreviews();

            submitBtn.disabled = false;
            submitBtn.textContent = "Gửi";

            modal.classList.add("active");
        });
    });

    // Close Modal
    function closeModal() {
        modal.classList.remove("active");
    }
    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", function (e) {
        if (e.target === modal) closeModal();
    });

    // Star Selection Logic
    stars.forEach(star => {
        star.addEventListener("click", function () {
            const val = parseInt(this.getAttribute("data-val"));
            setStars(val);
        });
    });

    function setStars(rating) {
        starInput.value = rating;
        ratingLabel.textContent = starLabels[rating] || "";
        
        // Update placeholder based on selected rating
        textarea.placeholder = ratingPlaceholders[rating] || "Hãy chia sẻ nhận xét cho sản phẩm này bạn nhé!";

        stars.forEach(s => {
            const starVal = parseInt(s.getAttribute("data-val"));
            if (starVal <= rating) {
                s.classList.add("active");
            } else {
                s.classList.remove("active");
            }
        });
    }

    // Textarea Char Count
    textarea.addEventListener("input", function () {
        const count = this.value.length;
        charCount.textContent = count + " ký tự";
    });

    // Form Submit via AJAX
    form.addEventListener("submit", function (e) {
        e.preventDefault();


        submitBtn.disabled = true;
        submitBtn.textContent = "Đang gửi...";

        const formData = new FormData(form);

        fetch("/my-account/submit-review", {
            method: "POST",
            body: formData,
            headers: {
                "X-Requested-With": "XMLHttpRequest"
            }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("Cảm ơn bạn! " + data.message);
                closeModal();
                // Reload list to update buttons & reviewed states
                window.location.reload();
            } else {
                alert("Lỗi: " + (data.error || "Không thể gửi đánh giá"));
                submitBtn.disabled = false;
                submitBtn.textContent = "Gửi";
            }
        })
        .catch(err => {
            console.error(err);
            alert("Có lỗi kết nối xảy ra. Vui lòng thử lại sau.");
            submitBtn.disabled = false;
            submitBtn.textContent = "Gửi";
        });
    });
});
</script>
