                            </button>

                            <button
                              type="button"
                              class="btn btn-error btn-medium rounded-full delete-address-button"
                              data-address-id="@a.Id">
                              Xóa
                            </button>
                          </div>
                        </div>
                      }
                    </div>
                  }
                </div>
              }
