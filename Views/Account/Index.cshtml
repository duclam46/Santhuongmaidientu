      <!-- Footer Action -->
      <div class="review-modal-footer">
        <button type="submit" id="reviewSubmitBtn" class="review-submit-btn">Gửi</button>
      </div>
    </form>
  </div>
</div>

<style>
/* Modal overlay styling */
