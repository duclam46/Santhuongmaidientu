@model DOAN_BANHANG.ViewModels.MyAccountPageVm

@{
  ViewData["Title"] = "Tài khoản";

  var account = Model.Account;
  var displayName = account is null
    ? "Tài khoản"
    : (!string.IsNullOrWhiteSpace(account.FullName) ? account.FullName : account.Email);

  string ResolveImageUrl(string? rawUrl)
  {
    if (string.IsNullOrWhiteSpace(rawUrl))
    {
      return Url.Content("~/assets/images/blog/user-avatar-1.png");
    }

    rawUrl = rawUrl.Trim();

    if (rawUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
        || rawUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
        || rawUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
    {
      return rawUrl;
    }

    if (rawUrl.StartsWith("~/", StringComparison.Ordinal))
    {
      return Url.Content(rawUrl);
    }

    if (rawUrl.StartsWith("/", StringComparison.Ordinal))
    {
      return rawUrl;
    }

    return Url.Content("~/" + rawUrl.TrimStart('/'));
  }

  string FormatVnd(decimal amount)
  {
    return string.Format("{0:N0}đ", amount);
  }

  (string tabKey, string label, string pillClass) ResolveOrderStatusUi(string? rawStatus, bool isReceivedByCustomer = false)
  {
    var s = (rawStatus ?? string.Empty).Trim();
    var norm = s.Replace(" ", string.Empty).ToLowerInvariant();

    const string basePill = "inline-flex items-center justify-center whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold leading-5";

    return norm switch
    {
      "pendingconfirmation" or "waitconfirm" or "waitingconfirm" or "confirming" or "pending" or "confirmationpending" or "processing" or "inprocess" or "inprocessing" or "inprocess" or "chờxácnhận" or "choxacnhan" => (
        "pending-confirmation",
        "Chờ xác nhận",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "awaitingpickup" or "waitpickup" or "waitingpickup" or "readytopick" or "pickup" or "chờlấyhàng" or "cholayhang" => (
        "awaiting-pickup",
        "Chờ lấy hàng",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "confirmed" or "accepted" or "đãxácnhận" or "daxacnhan" => (
        "awaiting-pickup",
        "Chờ lấy hàng",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "shipping" or "delivering" or "intransit" or "đanggiao" or "danggiao" => (
        "delivering",
        "Đang giao",
        $"{basePill} bg-primary/8 text-primary"
      ),
      "completed" or "success" or "hoàntất" or "hoantat" => (
        "completed",
        "Hoàn tất",
        $"{basePill} bg-success-light text-success-dark"
      ),
      "delivered" or "deliverysuccess" or "dagiao" or "đãgiao" => isReceivedByCustomer ? (
        "completed",
        "Hoàn tất",
        $"{basePill} bg-success-light text-success-dark"
      ) : (
        "delivering",
        "Đang giao (Đã giao)",
        $"{basePill} bg-primary/8 text-primary"
      ),
      "returned" or "return" or "refund" or "returnrequest" or "returning" or "trahang" or "trảhàng" => (
        "returned",
        "Trả hàng",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "cancelled" or "canceled" or "cancel" or "đãhủy" or "dahuy" => (
        "cancelled",
        "Đã hủy",
        $"{basePill} bg-error-light text-error-dark"
      ),
      _ => (
        "pending-confirmation",
        "Chờ xác nhận",
        $"{basePill} bg-warning-light text-warning-dark"
      )
    };
  }

  string ResolvePaymentBadge(string? rawPaymentStatus)
  {
    var s = (rawPaymentStatus ?? string.Empty).Trim();
    var norm = s.Replace(" ", string.Empty).ToLowerInvariant();
    return norm is "paid" or "success" or "completed" ? "(Đã thanh toán)" : "(Chưa thanh toán)";
  }
}

<!-- ========== Breadcrumb Section Start ========== -->
<div class="sz-acc-shell">
  <div class="container pt-8 pb-4">
    <div class="breadcrumb">
      <ul>
        <li>
          <a href='@Url.Action("Index", "Home")'>
            <span class="inline-flex items-center justify-center">
              <i class="hgi hgi-stroke hgi-home-01 text-xl leading-6"></i>
            </span>
            Trang chủ
          </a>
        </li>
        <li class="text-light-disabled-text">&#8226;</li>
        <li><span class="text-sm leading-[22px] font-semibold text-slate-600">Tài khoản của tôi</span></li>
      </ul>
    </div>
  </div>
<!-- ========== Breadcrumb Section End ========== -->

<section class="pb-[90px]">
  <div class="container">
    <div class="grid grid-cols-12 gap-y-6 lg:gap-x-6">
      <div class="xl:col-span-3 lg:col-span-4 col-span-12">
        <div class="sz-acc-sidebar-card">
          <div class="sz-acc-profile-head">
            <div class="sz-acc-avatar-ring">
              <img src="@(ResolveImageUrl(account?.AvatarUrl))" alt="Avatar" class="w-full h-full object-cover" />
            </div>
            <div class="min-w-0">
              <p class="text-[11px] uppercase tracking-wider text-teal-100/80 font-semibold">Thành viên Sellzy</p>
              <p id="my-account-display-name-left" class="text-base leading-6 text-white font-bold truncate">@displayName</p>
              @if (Model.IsSignedIn)
              {
                <p class="text-xs leading-[18px] text-teal-100/85 truncate">@account!.Email</p>
              }
            </div>
          </div>

          <ul class="my-account-menu flex flex-col gap-y-1 p-4">
            <li>
              <p class="px-3 pb-1.5 pt-1 text-[11px] tracking-wider text-teal-700 font-extrabold uppercase">Tổng quan &amp; Mua sắm</p>
            </li>
            <li>
              <button type="button" data-tab="dashboard" class="sz-acc-nav-btn active w-full text-left px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-dashboard-square-01 text-lg"></i>
                  Tổng quan
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="orders" class="sz-acc-nav-btn w-full text-left px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-package text-lg"></i>
                  Đơn mua của tôi
                </span>
              </button>
            </li>
            <li>
              <a href="/my-disputes" class="sz-acc-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-justice-scale-01 text-lg"></i>
                  Khiếu nại &amp; Tranh chấp
                </span>
                <i class="hgi hgi-stroke hgi-arrow-right-01 text-xs opacity-60"></i>
              </a>
            </li>
            <li>
              <a href="/my-wallet" class="sz-acc-nav-btn sz-acc-wallet-link w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-wallet-02 text-lg"></i>
                  Ví Sellzy &amp; Số dư
                </span>
                <i class="hgi hgi-stroke hgi-arrow-right-01 text-xs"></i>
              </a>
            </li>
            <li>
              <a href="/my-vouchers" class="sz-acc-nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-ticket-01 text-lg"></i>
                  Kho Voucher của tôi
                </span>
                <i class="hgi hgi-stroke hgi-arrow-right-01 text-xs opacity-60"></i>
              </a>
            </li>

            <li class="pt-3 mt-2 border-t border-slate-100">
              <p class="px-3 pb-1.5 text-[11px] tracking-wider text-teal-700 font-extrabold uppercase">Thiết lập tài khoản</p>
            </li>
            <li>
              <button type="button" data-tab="account-details" class="sz-acc-nav-btn w-full text-left px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-user-circle text-lg"></i>
                  Thông tin cá nhân
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="password" class="sz-acc-nav-btn w-full text-left px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-lock-sync-01 text-lg"></i>
                  Đổi mật khẩu
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="address" class="sz-acc-nav-btn w-full text-left px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-location-01 text-lg"></i>
                  Sổ địa chỉ
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="wishlist" class="sz-acc-nav-btn w-full text-left px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-favourite text-lg"></i>
                  Sản phẩm yêu thích
                </span>
              </button>
            </li>
            <li>
              <button type="button" data-tab="reviews" class="sz-acc-nav-btn w-full text-left px-3.5 py-2.5 rounded-xl font-semibold">
                <span class="inline-flex items-center gap-x-3">
                  <i class="hgi hgi-stroke hgi-star text-lg"></i>
                  Đánh giá của tôi
                </span>
              </button>
            </li>
            @if (Model.IsSignedIn)
            {
              <li class="pt-3 mt-2 border-t border-slate-100">
                <button type="button" data-tab="logout" class="logout-btn sz-acc-nav-btn sz-acc-logout-btn w-full text-left px-3.5 py-2.5 rounded-xl font-semibold">
                  <span class="inline-flex items-center gap-x-3">
                    <i class="hgi hgi-stroke hgi-logout-01 text-lg"></i>
                    Đăng xuất
                  </span>
                </button>
              </li>
            }
          </ul>
        </div>
      </div>

      <div class="xl:col-span-9 lg:col-span-8 col-span-12">
        <div class="sz-acc-main-card">
          <div id="my-account-ajax-message" class="mb-6 p-4 rounded-2xl hidden"></div>
          @if (TempData["AccountSuccess"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
          {
            <div class="my-account-status-message mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 font-semibold text-sm flex items-center gap-2.5">
              <i class="hgi hgi-stroke hgi-checkmark-circle-02 text-emerald-600 text-lg"></i>
              <span>@okMsg</span>
            </div>
          }
          @if (TempData["AccountError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
          {
            <div class="my-account-status-message mb-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 font-semibold text-sm flex items-center gap-2.5">
              <i class="hgi hgi-stroke hgi-alert-circle text-amber-600 text-lg"></i>
              <span>@errMsg</span>
            </div>
          }

          <div class="my-account-content">
            <div id="dashboard" class="menu-tab-pane">
              @if (!Model.IsSignedIn)
              {
                <div class="text-center py-12">
                  <div class="w-16 h-16 rounded-2xl bg-teal-50 text-teal-700 inline-flex items-center justify-center text-3xl mb-4">
                    <i class="hgi hgi-stroke hgi-user-circle"></i>
                  </div>
                  <h4 class="pb-2 text-slate-900 font-extrabold">Bạn chưa đăng nhập</h4>
                  <p class="text-slate-500 pb-6 text-sm">
                    Vui lòng đăng nhập để quản lý đơn hàng, ví Sellzy và thông tin cá nhân của bạn.
                  </p>
                  <a href="#" class="btn btn-primary rounded-full px-8 login-page-btn">Đăng nhập ngay</a>
                </div>
              }
              else
              {
                var orders = Model.Account?.Orders ?? new List<OrderSummaryVm>();
                var totalOrders = orders.Count;
                var completedOrdersCount = orders.Count(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "completed");
                var processingOrdersCount = orders.Count(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey is "pending-confirmation" or "awaiting-pickup" or "delivering");
                var cancelledOrdersCount = orders.Count(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "cancelled");
                var wishlistCount = Model.Account?.WishlistItems?.Count ?? 0;
                var reviewsCount = Model.Account?.ReviewsTotalCount ?? 0;
                var recentOrders = orders.Take(5).ToList();
                var recentReviews = Model.Account?.RecentReviews ?? new List<ReviewSummaryVm>();

                <div class="sz-acc-dash-hero mb-6">
                  <div>
                    <span class="sz-acc-hero-kicker">BẢNG ĐIỀU KHIỂN CÁ NHÂN</span>
                    <h3 class="text-white font-extrabold text-2xl mt-1 mb-1">
                      Xin chào, <span id="my-account-display-name-dashboard">@displayName</span>!
                    </h3>
                    <p class="text-teal-100/85 text-sm">
                      Theo dõi đơn hàng, quản lý số dư ví và cập nhật thông tin tài khoản của bạn tại một nơi duy nhất.
                    </p>
                  </div>
                  <div class="sz-acc-wallet-hero-box">
                    <div class="text-xs text-teal-100/85 font-semibold mb-0.5">Số dư Ví Sellzy</div>
                    <div id="dashboard-wallet-balance" class="text-2xl font-extrabold text-white tracking-tight">Đang tải...</div>
                    <a href="/my-wallet" class="sz-acc-wallet-cta mt-2.5">
                      <i class="hgi hgi-stroke hgi-wallet-add-01"></i>
                      <span>Nạp tiền / Lịch sử ví</span>
                    </a>
                  </div>
                </div>

                <div class="grid grid-cols-12 gap-4">
                  <div class="xl:col-span-4 md:col-span-6 col-span-12 sz-acc-kpi-card">
                    <div class="sz-acc-kpi-icon kpi-teal"><i class="hgi hgi-stroke hgi-package"></i></div>
                    <div>
                      <p class="sz-acc-kpi-num">@totalOrders</p>
                      <p class="sz-acc-kpi-lbl">Tổng đơn hàng</p>
                    </div>
                  </div>

                  <div class="xl:col-span-4 md:col-span-6 col-span-12 sz-acc-kpi-card">
                    <div class="sz-acc-kpi-icon kpi-emerald"><i class="hgi hgi-stroke hgi-checkmark-circle-02"></i></div>
                    <div>
                      <p class="sz-acc-kpi-num">@completedOrdersCount</p>
                      <p class="sz-acc-kpi-lbl">Đơn hoàn tất</p>
                    </div>
                  </div>

                  <div class="xl:col-span-4 md:col-span-6 col-span-12 sz-acc-kpi-card">
                    <div class="sz-acc-kpi-icon kpi-amber"><i class="hgi hgi-stroke hgi-time-quarter-pass"></i></div>
                    <div>
                      <p class="sz-acc-kpi-num">@processingOrdersCount</p>
                      <p class="sz-acc-kpi-lbl">Đang xử lý / Giao</p>
                    </div>
                  </div>

                  <div class="xl:col-span-4 md:col-span-6 col-span-12 sz-acc-kpi-card">
                    <div class="sz-acc-kpi-icon kpi-rose"><i class="hgi hgi-stroke hgi-cancel-01"></i></div>
                    <div>
                      <p class="sz-acc-kpi-num">@cancelledOrdersCount</p>
                      <p class="sz-acc-kpi-lbl">Đơn đã hủy</p>
                    </div>
                  </div>

                  <div class="xl:col-span-4 md:col-span-6 col-span-12 sz-acc-kpi-card">
                    <div class="sz-acc-kpi-icon kpi-pink"><i class="hgi hgi-stroke hgi-favourite"></i></div>
                    <div>
                      <p class="sz-acc-kpi-num">@wishlistCount</p>
                      <p class="sz-acc-kpi-lbl">Sản phẩm yêu thích</p>
                    </div>
                  </div>

                  <div class="xl:col-span-4 md:col-span-6 col-span-12 sz-acc-kpi-card">
                    <div class="sz-acc-kpi-icon kpi-slate"><i class="hgi hgi-stroke hgi-star"></i></div>
                    <div>
                      <p class="sz-acc-kpi-num">@reviewsCount</p>
                      <p class="sz-acc-kpi-lbl">Đánh giá đã gửi</p>
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-12 gap-5 pt-6">
                  <div class="lg:col-span-8 col-span-12 sz-acc-panel overflow-x-auto">
                    <div class="sz-acc-panel-head">
                      <h4 class="text-base font-extrabold text-slate-800 m-0">Đơn hàng gần đây</h4>
                      <a href="/my-orders" class="text-xs font-bold text-teal-700 hover:underline">Xem tất cả →</a>
                    </div>
                    <table class="w-full sz-acc-table">
                      <thead>
                        <tr>
                          <th>Mã đơn</th>
                          <th>Ngày đặt</th>
                          <th>Trạng thái</th>
                          <th>Tổng tiền</th>
                          <th class="text-right">Thao tác</th>
                        </tr>
                      </thead>
                      <tbody>
                        @if (recentOrders.Count == 0)
                        {
                          <tr>
                            <td class="py-8 px-6 text-center text-slate-400 text-sm" colspan="5">
                              Chưa có đơn hàng nào.
                            </td>
                          </tr>
                        }
                        else
                        {
                          foreach (var o in recentOrders)
                          {
                            var ui = ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer);
                            <tr>
                              <td class="font-bold text-slate-900">#@(!string.IsNullOrWhiteSpace(o.OrderCode) ? o.OrderCode : o.Id.ToString())</td>
                              <td class="text-slate-500 text-xs">@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                              <td><span class="@ui.pillClass">@ui.label</span></td>
                              <td class="font-bold text-teal-700">@FormatVnd(o.FinalAmount)</td>
                              <td class="text-right">
                                <div class="inline-flex flex-wrap items-center justify-end gap-1.5">
                                  <a class="sz-acc-mini-btn outline"
                                     href='@Url.Action("OrderDetails", "Account", new { id = o.Id })'>Chi tiết</a>

                                  @if (ui.tabKey is "pending-confirmation" or "awaiting-pickup")
                                  {
                                    <form method="post" action="/my-orders/cancel" class="inline-flex" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không? Hành động này không thể hoàn tác.');">
                                      @Html.AntiForgeryToken()
                                      <input type="hidden" name="Id" value="@o.Id" />
                                      <input type="hidden" name="ReturnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                      <button type="submit" class="sz-acc-mini-btn danger">Hủy</button>
                                    </form>
                                  }
                                </div>
                              </td>
                            </tr>
                          }
                        }
                      </tbody>
                    </table>
                  </div>

                  <div class="lg:col-span-4 col-span-12 sz-acc-panel overflow-hidden">
                    <div class="sz-acc-panel-head">
                      <h4 class="text-base font-extrabold text-slate-800 m-0">Đánh giá gần đây</h4>
                    </div>
                    <div class="p-5">
                      @if (recentReviews.Count == 0)
                      {
                        <p class="text-slate-400 text-sm text-center py-6">Chưa có đánh giá nào.</p>
                      }
                      else
                      {
                        <div class="flex flex-col gap-y-4">
                          @foreach (var r in recentReviews)
                          {
                            var img = string.IsNullOrWhiteSpace(r.ProductImageUrl)
                              ? Url.Content("~/assets/images/product-details/product-details-1.png")
                              : ResolveImageUrl(r.ProductImageUrl);

                            <div class="flex gap-x-3 pb-4 border-b border-slate-100 last:border-0 last:pb-0">
                              <div class="size-14 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 shrink-0">
                                <img src="@img" alt="@r.ProductName" class="w-full h-full object-cover" />
                              </div>
                              <div class="min-w-0 flex-1">
                                <a class="text-slate-800 text-sm font-bold truncate block hover:text-teal-700" href='@Url.RouteUrl("product_details", new { slug = r.ProductSlug })'>@r.ProductName</a>
                                <div class="flex items-center justify-between gap-2 mt-0.5">
                                  <span class="inline-flex items-center gap-x-0.5">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                      var starClass = i <= Math.Clamp(r.Rating, 0, 5) ? "text-amber-400" : "text-slate-200";
                                      <i class="hgi hgi-stroke hgi-star text-xs @starClass"></i>
                                    }
                                  </span>
                                  <span class="text-[11px] text-slate-400">@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </div>
                                <p class="text-xs text-slate-500 pt-1.5 line-clamp-2">
                                  @(string.IsNullOrWhiteSpace(r.Comment) ? "(Không có nội dung đánh giá.)" : r.Comment)
                                </p>
                              </div>
                            </div>
                          }
                        </div>
                      }
                    </div>
                  </div>
                </div>
              }
            </div>

            <div id="account-details" class="menu-tab-pane hidden">
              <div class="sz-acc-tab-header">
                <div>
                  <h4 class="text-xl font-extrabold text-slate-900 m-0">Thông tin cá nhân</h4>
                  <p class="text-xs text-slate-500 mt-1">Cập nhật ảnh đại diện, họ tên và thông tin liên hệ của bạn.</p>
                </div>
              </div>

              @if (!Model.IsSignedIn)
              {
                <p class="text-slate-500">Vui lòng đăng nhập để xem thông tin.</p>
              }
              else
              {
                <div class="sz-acc-panel">
                  <div class="sz-acc-panel-head">
                    <h5 class="text-sm font-extrabold text-slate-800 m-0">Hồ sơ thành viên</h5>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-teal-50 text-teal-700 border border-teal-100">
