}
.review-media-section {
    background: #ffffff;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid rgba(226, 232, 240, 0.8);
}
.review-media-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12.5px;
}
.review-media-title {
    color: #475569;
