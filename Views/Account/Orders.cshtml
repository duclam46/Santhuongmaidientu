@model DOAN_BANHANG.ViewModels.MyAccountPageVm

@{
  ViewData["Title"] = "Đơn hàng";

  string FormatVnd(decimal amount)
  {
    return string.Format("{0:N0}đ", amount);
  }

  (string tabKey, string label, string pillClass) ResolveOrderStatusUi(string? rawStatus, bool isReceivedByCustomer = false)
  {
    var s = (rawStatus ?? string.Empty).Trim();
    var norm = s.Replace(" ", string.Empty).ToLowerInvariant();

    const string basePill = "inline-flex items-center justify-center whitespace-nowrap rounded-full px-3.5 py-1.5 text-sm font-bold leading-5 ring-1 ring-inset";

    return norm switch
    {
      "pendingconfirmation" or "waitconfirm" or "waitingconfirm" or "confirming" or "pending" or "confirmationpending" or "processing" or "inprocess" or "inprocessing" or "inprocess" or "chờxácnhận" or "choxacnhan" => (
        "pending-confirmation",
        "Chờ xác nhận",
        $"{basePill} bg-warning-light text-warning-dark ring-warning-dark/25"
      ),
      "awaitingpickup" or "waitpickup" or "waitingpickup" or "readytopick" or "pickup" or "chờlấyhàng" or "cholayhang" => (
        "awaiting-pickup",
        "Chờ lấy hàng",
        $"{basePill} bg-warning-light text-warning-dark ring-warning-dark/25"
      ),
      "confirmed" or "accepted" or "đãxácnhận" or "daxacnhan" => (
        "awaiting-pickup",
        "Chờ lấy hàng",
        $"{basePill} bg-warning-light text-warning-dark ring-warning-dark/25"
      ),
      "shipping" or "delivering" or "intransit" or "đanggiao" or "danggiao" => (
        "delivering",
        "Đang giao",
        $"{basePill} bg-primary/8 text-primary ring-primary/20"
      ),
      "completed" or "success" or "hoàntất" or "hoantat" => (
        "completed",
        "Hoàn tất",
        $"{basePill} bg-success-light text-success-dark ring-success-dark/20"
      ),
      "delivered" or "deliverysuccess" or "dagiao" or "đãgiao" => isReceivedByCustomer ? (
        "completed",
        "Hoàn tất",
        $"{basePill} bg-success-light text-success-dark ring-success-dark/20"
      ) : (
        "delivering",
        "Đang giao (Đã giao)",
        $"{basePill} bg-primary/8 text-primary ring-primary/20"
      ),
      "returned" or "return" or "refund" or "returnrequest" or "returning" or "trahang" or "trảhàng" => (
        "returned",
        "Trả hàng",
        $"{basePill} bg-warning-light text-warning-dark ring-warning-dark/25"
      ),
      "cancelled" or "canceled" or "cancel" or "đãhủy" or "dahuy" => (
        "cancelled",
        "Đã hủy",
        $"{basePill} bg-error-light text-error-dark ring-error-dark/20"
      ),
      _ => (
        "pending-confirmation",
        "Chờ xác nhận",
        $"{basePill} bg-warning-light text-warning-dark ring-warning-dark/25"
      )
    };
  }

  string ResolvePaymentBadge(string? rawPaymentStatus)
  {
    var s = (rawPaymentStatus ?? string.Empty).Trim();
    var norm = s.Replace(" ", string.Empty).ToLowerInvariant();
    return norm is "paid" or "success" or "completed" ? "(Đã thanh toán)" : "(Chưa thanh toán)";
  }
}

<!-- ========== Breadcrumb Section Start ========== -->
<div class="container py-12">
  <div class="breadcrumb">
    <ul>
      <li>
        <a href='@Url.Action("Index", "Home")'>
          <span class="inline-flex items-center justify-center">
            <i class="hgi hgi-stroke hgi-home-01 text-2xl leading-6"></i>
          </span>
          Home
        </a>
      </li>
      <li class="text-light-disabled-text">&#8226;</li>
      <li><span class="text-sm leading-[22px]">Đơn hàng</span></li>
    </ul>
  </div>
</div>
<!-- ========== Breadcrumb Section End ========== -->

<section class="pb-[90px]">
  <div class="container">
    <div class="border border-gray-300 rounded-2xl p-6">
      @if (!Model.IsSignedIn)
      {
        <h4 class="pb-3">Bạn chưa đăng nhập</h4>
        <p class="text-light-secondary-text pb-6">
          Vui lòng đăng nhập để xem lịch sử đơn hàng.
        </p>
        <a href="#" class="btn btn-primary login-page-btn">Đăng nhập</a>
      }
      else
      {
        @if (TempData["AccountSuccess"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
        {
          <div class="mb-6 p-4 rounded-2xl bg-success-light text-light-primary-text">@okMsg</div>
        }
        @if (TempData["AccountError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
        {
          <div class="mb-6 p-4 rounded-2xl bg-warning-light text-light-primary-text">@errMsg</div>
        }

        var allOrders = Model.Account?.Orders ?? new List<DOAN_BANHANG.ViewModels.OrderSummaryVm>();
        var pendingConfirmOrders = allOrders.Where(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "pending-confirmation").ToList();
        var awaitingPickupOrders = allOrders.Where(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "awaiting-pickup").ToList();
        var deliveringOrders = allOrders.Where(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "delivering").ToList();
        var completedOrders = allOrders.Where(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "completed").ToList();
        var returnedOrders = allOrders.Where(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "returned").ToList();
        var cancelledOrders = allOrders.Where(o => ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer).tabKey == "cancelled").ToList();

        var tabs = new (string key, List<DOAN_BANHANG.ViewModels.OrderSummaryVm> orders)[]
        {
          ("all", allOrders),
          ("pending-confirmation", pendingConfirmOrders),
          ("awaiting-pickup", awaitingPickupOrders),
          ("delivering", deliveringOrders),
          ("completed", completedOrders),
          ("returned", returnedOrders),
          ("cancelled", cancelledOrders)
        };

        <div id="orders" class="menu-tab-pane">
          <div class="flex flex-col gap-y-6 mb-6">
            <h3 class="text-light-primary-text">Lịch sử đơn hàng</h3>
            <div class="flex gap-x-4 overflow-x-auto order-history-product-filter">
              <button data-tab="all" class="inline-flex items-center justify-center py-2 px-6 text-sm leading-[22px] rounded-[80px] font-medium text-light-primary-text">Tất cả</button>
              <button data-tab="pending-confirmation" class="inline-flex items-center justify-center gap-x-2 py-2 px-6 text-sm leading-[22px] rounded-[80px] font-medium text-light-primary-text whitespace-nowrap">
                <span>Chờ xác nhận</span>
                @if (pendingConfirmOrders.Count > 0)
                {
                  <span class="inline-flex items-center justify-center min-w-6 h-6 px-2 rounded-full text-xs font-bold bg-error text-white border-2 border-white" style="pointer-events:none">@pendingConfirmOrders.Count</span>
                }
              </button>
              <button data-tab="awaiting-pickup" class="inline-flex items-center justify-center gap-x-2 py-2 px-6 text-sm leading-[22px] rounded-[80px] font-medium text-light-primary-text whitespace-nowrap">
                <span>Chờ lấy hàng</span>
                @if (awaitingPickupOrders.Count > 0)
                {
                  <span class="inline-flex items-center justify-center min-w-6 h-6 px-2 rounded-full text-xs font-bold bg-error text-white border-2 border-white" style="pointer-events:none">@awaitingPickupOrders.Count</span>
                }
              </button>
              <button data-tab="delivering" class="inline-flex items-center justify-center gap-x-2 py-2 px-6 text-sm leading-[22px] rounded-[80px] font-medium text-light-primary-text whitespace-nowrap">
                <span>Đang giao</span>
                @if (deliveringOrders.Count > 0)
                {
                  <span class="inline-flex items-center justify-center min-w-6 h-6 px-2 rounded-full text-xs font-bold bg-error text-white border-2 border-white" style="pointer-events:none">@deliveringOrders.Count</span>
                }
              </button>
              <button data-tab="completed" class="inline-flex items-center justify-center py-2 px-6 text-sm leading-[22px] rounded-[80px] font-medium text-light-primary-text">Hoàn tất</button>
              <button data-tab="returned" class="inline-flex items-center justify-center py-2 px-6 text-sm leading-[22px] rounded-[80px] font-medium text-light-primary-text">Trả hàng</button>
              <button data-tab="cancelled" class="inline-flex items-center justify-center py-2 px-6 text-sm leading-[22px] rounded-[80px] font-medium text-light-primary-text">Đã hủy</button>
            </div>
          </div>

          <div id="order-tab-content">
            @foreach (var tab in tabs)
            {
              <div class="tab-pane" id="@tab.key">
                @if (tab.orders.Count == 0)
                {
                  <div class="border border-gray-300 rounded-2xl p-6">
                    <p class="text-light-secondary-text">Chưa có đơn hàng nào.</p>
                  </div>
                }
                else
                {
                  <div class="flex flex-col gap-y-6">
                    @foreach (var o in tab.orders)
                    {
                      var ui = ResolveOrderStatusUi(o.OrderStatus, o.IsReceivedByCustomer);
                      <div class="order-history-table-wrapper border-gray-300 rounded-2xl border overflow-hidden">
                        <table class="w-full order-history-table">
                          <thead>
                            <tr class="border-b border-gray-300">
                              <th class="py-5 px-6">
                                <div class="flex items-center justify-between">
                                  <span class="pr-3 break-all">Mã đơn: #@(!string.IsNullOrWhiteSpace(o.OrderCode) ? o.OrderCode : o.Id.ToString())</span>
                                  <span class="@ui.pillClass">@ui.label</span>
                                </div>
                              </th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr>
                              <td class="lg:px-6 px-4 py-6 border-b border-gray-300">
                                <div>
                                  <ul class="flex flex-col gap-y-4">
                                    <li class="flex items-center justify-between">
                                      <p class="text-light-primary-text font-medium inline-flex items-center md:gap-x-4 gap-x-2">
                                        <span class="inline-flex items-center justify-center"><i class="hgi hgi-stroke hgi-calendar-03 text-2xl leading-6"></i></span>
                                        Ngày đặt:
                                      </p>
                                      <span class="font-semibold text-light-primary-text">@o.CreatedAt.ToLocalTime().ToString("HH:mm, dd/MM/yyyy")</span>
                                    </li>
                                    <li class="flex items-center justify-between">
                                      <p class="text-light-primary-text font-medium inline-flex items-center md:gap-x-4 gap-x-2">
                                        <span class="inline-flex items-center justify-center"><i class="hgi hgi-stroke hgi-delivery-box-01 text-2xl leading-6"></i></span>
                                        Sản phẩm
                                      </p>
                                      <span class="font-semibold text-light-primary-text">@o.ItemCount</span>
                                    </li>
                                    <li class="flex items-center justify-between">
                                      <p class="text-light-primary-text font-medium inline-flex items-center md:gap-x-4 gap-x-2">
                                        <span class="inline-flex items-center justify-center"><i class="hgi hgi-stroke hgi-truck text-2xl leading-6"></i></span>
                                        Phí vận chuyển
                                      </p>
                                      <p class="font-semibold text-light-primary-text">@(o.ShippingFee <= 0 ? "Miễn phí" : FormatVnd(o.ShippingFee))</p>
                                    </li>
                                    <li class="flex items-center justify-between">
                                      <p class="text-light-primary-text font-medium inline-flex items-center md:gap-x-4 gap-x-2">
                                        <span class="inline-flex items-center justify-center"><i class="hgi hgi-stroke hgi-payment-success-01 text-2xl leading-6"></i></span>
                                        Tổng thanh toán
                                      </p>
                                      <p class="font-semibold text-light-primary-text">
                                        @FormatVnd(o.FinalAmount)<span class="text-primary ml-0.5">@ResolvePaymentBadge(o.PaymentStatus)</span>
                                      </p>
                                      @if (ui.tabKey != "cancelled" && o.PaymentStatus == "AwaitingPayment" && o.PaymentMethod == "BankTransfer" && o.PaymentDeadlineUtc.HasValue)
                                      {
                                          var remainingSeconds = (o.PaymentDeadlineUtc.Value - DateTime.Now).TotalSeconds;
                                          if (remainingSeconds < 0 || remainingSeconds > 1800)
                                          {
                                              var altDiff = (o.PaymentDeadlineUtc.Value - DateTime.UtcNow).TotalSeconds;
                                              if (altDiff >= 0 && altDiff <= 1800)
                                              {
                                                  remainingSeconds = altDiff;
                                              }
                                          }
                                          if (remainingSeconds < 0) remainingSeconds = 0;
                                          if (remainingSeconds > 900) remainingSeconds = 900;

                                          <li class="flex items-center justify-between bg-error/5 p-3 rounded-xl border border-error/20">
                                              <p class="text-error font-medium inline-flex items-center gap-x-2">
                                                  <i class="hgi hgi-stroke hgi-time-04 text-xl"></i> Thời gian thanh toán còn lại:
                                              </p>
                                              <span class="font-bold text-error text-lg js-payment-countdown" data-remaining-seconds="@((int)remainingSeconds)">--:--</span>
                                          </li>
                                      }
                                    </li>
                                  </ul>
                                </div>
                              </td>
                            </tr>
                            <tr>
                              <td class="p-4">
                                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                                  <a class="btn btn-large btn-default outline py-1.5 px-6 text-sm leading-[22px] font-semibold rounded-[80px] shadow-none w-auto whitespace-nowrap"
                                     href='@Url.Action("OrderDetails", "Account", new { id = o.Id })'>
                                    Xem chi tiết
                                  </a>

                                  <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center md:justify-end gap-2 w-full md:w-auto">
                                     @if (ui.tabKey == "delivering")
                                     {
                                         <form method="post" action="/my-orders/received" class="inline-flex w-auto" onsubmit="return confirm('Bạn xác nhận đã nhận được hàng đầy đủ và nguyên vẹn?');">
                                             @Html.AntiForgeryToken()
                                             <input type="hidden" name="Id" value="@o.Id" />
                                             <input type="hidden" name="ReturnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                             <button type="submit" class="btn btn-large py-[7px] px-6 text-sm leading-[22px] font-semibold rounded-[80px] w-auto whitespace-nowrap text-white shadow-none"
                                                     style="background: linear-gradient(135deg, #10b981, #059669) !important; border: none !important; display: inline-flex; align-items: center; justify-content: center; gap: 4px;">
                                                 ✓ Đã nhận được hàng
                                             </button>
                                         </form>
                                     }

                                     @if (ui.tabKey != "cancelled" && o.PaymentStatus == "AwaitingPayment" && o.PaymentMethod == "BankTransfer")
                                     {
                                         <a class="btn btn-large py-[7px] px-6 text-sm leading-[22px] font-semibold rounded-[80px] shadow-none w-auto whitespace-nowrap text-white js-payment-btn" style="background: linear-gradient(135deg, #f59e0b, #d97706)"
                                            href="/checkout/vnpay-retry?codes=@Uri.EscapeDataString(o.OrderCode)">
                                             Thanh toán ngay
                                         </a>
                                     }
                                     @if (ui.tabKey is "pending-confirmation" or "awaiting-pickup")
                                     {
                                       var cancelConfirmMsg = (o.PaymentStatus == "Paid" && o.PaymentMethod == "BankTransfer")
                                           ? "Bạn có chắc chắn muốn hủy đơn hàng này không? Đơn hàng này đã được thanh toán qua VNPay, số tiền sẽ được hoàn trả về tài khoản thanh toán của bạn. Hành động này không thể hoàn tác."
                                           : "Bạn có chắc chắn muốn hủy đơn hàng này không? Hành động này không thể hoàn tác.";
                                       <form method="post" action="/my-orders/cancel" class="js-cancel-form inline-flex w-auto" data-confirm-msg="@cancelConfirmMsg">
                                         @Html.AntiForgeryToken()
                                         <input type="hidden" name="Id" value="@o.Id" />
                                         <input type="hidden" name="ReturnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                         <button type="submit" class="btn btn-large py-1.5 px-6 text-sm leading-[22px] font-semibold rounded-[80px] shadow-none w-auto whitespace-nowrap bg-error text-white ring-1 ring-inset ring-error-dark/20">
                                           Hủy đơn
                                         </button>
                                       </form>
                                     }

                                    @{
                                        var rawStatus = (o.OrderStatus ?? string.Empty).Trim();
                                        var normStatus = rawStatus.Replace(" ", string.Empty).ToLowerInvariant();
                                        var isDeliveredStatus = normStatus is "delivered" or "deliverysuccess" or "dagiao" or "đãgiao" or "completed" or "success";
                                        var isReturnReqStatus = normStatus is "returnrequest" or "returning" or "return" or "returned" or "refund" or "trahang" or "trảhàng";

                                        var canReturn = false;
                                        var daysRemaining = 0;
                                        if (isDeliveredStatus)
                                         {
                                             var daysSince = (DateTime.UtcNow - o.UpdatedAt).TotalDays;
                                             canReturn = daysSince <= 5;
                                             daysRemaining = (int)Math.Max(0, Math.Ceiling(5 - daysSince));
                                         }
                                    }

                                    @if (canReturn)
                                    {
                                        <a class="btn btn-large py-[7px] px-6 text-sm leading-[22px] font-semibold rounded-[80px] w-auto whitespace-nowrap text-white shadow-none"
                                           style="background: linear-gradient(135deg, #f97316, #ea580c) !important; border: none !important; display: inline-flex; align-items: center; justify-content: center; gap: 4px;"
                                           href="/my-orders/return/@o.Id">
                                            ↩ Trả hàng (@daysRemaining ngày)
                                        </a>
                                    }
                                    @if (isReturnReqStatus)
                                    {
                                        <a class="btn btn-large py-[7px] px-6 text-sm leading-[22px] font-semibold rounded-[80px] w-auto whitespace-nowrap shadow-none"
                                           style="background-color: #ede9fe !important; border: 1px solid #c084fc !important; color: #6d28d9 !important; display: inline-flex; align-items: center; justify-content: center; gap: 4px;"
                                           href="/my-orders/return/@o.Id">
                                            📋 Xem trả hàng
                                        </a>
                                    }

                                    @if (ui.tabKey == "completed")
                                    {
                                       var diffCreatedUtc = Math.Abs((DateTime.UtcNow - o.CreatedAt).TotalDays);
                                       var diffCreatedLocal = Math.Abs((DateTime.Now - o.CreatedAt).TotalDays);
                                       var diffUpdatedUtc = Math.Abs((DateTime.UtcNow - o.UpdatedAt).TotalDays);
                                       var diffUpdatedLocal = Math.Abs((DateTime.Now - o.UpdatedAt).TotalDays);
                                       var isRecent = diffCreatedUtc <= 5 || diffCreatedLocal <= 5 || diffUpdatedUtc <= 5 || diffUpdatedLocal <= 5;

                                       if (isRecent && !o.HasReviewed && !string.IsNullOrWhiteSpace(o.FirstProductSlug) && o.IsReceivedByCustomer)
                                        {
                                          <button type="button" class="btn btn-large py-[7px] px-6 text-sm leading-[22px] font-semibold rounded-[80px] w-auto whitespace-nowrap text-white shadow-none js-open-review-modal" 
                                              style="background-color: #f59e0b !important; border: 1px solid #d97706 !important; display: inline-flex; align-items: center; justify-content: center; gap: 4px;"
                                              data-product-id="@o.FirstProductId"
                                              data-product-name="@o.FirstProductName"
                                              data-product-image="@o.FirstProductImageUrl"
                                              data-product-variant="@o.FirstProductVariantName">
                                             Đánh giá
                                           </button>
                                        }
                                    }
                                    <form method="post" action="/my-orders/repurchase" class="inline-flex">
                                      @Html.AntiForgeryToken()
                                      <input type="hidden" name="Id" value="@o.Id" />
                                      <input type="hidden" name="ReturnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                      <button type="submit" class="btn btn-large btn-primary py-[7px] px-6 text-sm leading-[22px] font-semibold rounded-[80px] w-auto whitespace-nowrap shadow-none">
                                        Mua lại
                                      </button>
                                    </form>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                    }
                  </div>
                }
              </div>
            }
          </div>
        </div>

        <div id="order-details" class="menu-tab-pane hidden">
          <div class="flex items-center justify-between pb-6">
            <h4>Chi tiết đơn hàng</h4>
            <button type="button" class="btn btn-default outline btn-medium rounded-full order-details-back-button">
              Quay lại
            </button>
          </div>

          <div class="border border-gray-300 rounded-2xl p-6">
            <p class="text-light-secondary-text">Trang chi tiết đơn hàng đã được chuyển sang trang riêng để hiển thị dữ liệu thật.</p>
          </div>
        </div>
      }
    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function() {
    var countdowns = document.querySelectorAll('.js-payment-countdown');
    if (countdowns.length === 0) return;

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    countdowns.forEach(function(el) {
        var secAttr = el.getAttribute('data-remaining-seconds');
        el.remainingSeconds = parseInt(secAttr || '0', 10);
    });

    function updateCountdowns() {
        countdowns.forEach(function(el) {
            if (el.remainingSeconds === undefined) return;

            if (el.remainingSeconds <= 0) {
                el.textContent = 'Đã hết hạn';
                el.style.color = '#dc2626';
                var tbody = el.closest('tbody');
                if (tbody) {
                    var btn = tbody.querySelector('.js-payment-btn');
                    if (btn) {
                        btn.classList.add('opacity-50', 'cursor-not-allowed');
                        btn.removeAttribute('href');
                        btn.textContent = 'Đã hết hạn';
                    }
                }
            } else {
                var m = Math.floor(el.remainingSeconds / 60);
                var s = el.remainingSeconds % 60;
                el.textContent = pad(m) + ':' + pad(s);
                el.remainingSeconds--;
            }
        });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 1000);
});
</script>

<!-- Custom Confirm Cancel Modal -->
<style>
/* Premium Confirmation Modal Styles */
.confirm-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.3s;
}

.confirm-modal-overlay.active {
    opacity: 1;
    visibility: visible;
}

.confirm-modal-box {
    background: #ffffff;
    border-radius: 28px;
    width: 90%;
    max-width: 440px;
    padding: 32px 28px;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
    border: 1px solid rgba(226, 232, 240, 0.8);
    text-align: center;
    transform: scale(0.92) translateY(10px);
    opacity: 0;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s;
    box-sizing: border-box;
}

.confirm-modal-overlay.active .confirm-modal-box {
    transform: scale(1) translateY(0);
    opacity: 1;
}

/* Beautiful Colorful Icon & Glow */
