}
.review-star-item {
    font-size: 36px;
    color: #e2e8f0;
    cursor: pointer;
    transition: color 0.15s ease, transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.review-star-item.active {
