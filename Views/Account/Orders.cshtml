<div id="cancelConfirmModal" class="confirm-modal-overlay">
  <div class="confirm-modal-box" id="cancelConfirmBox">
    <!-- Beautiful Glowing & Pulse Multi-color SVG Icon -->
    <div class="confirm-modal-icon-wrapper">
      <div class="confirm-modal-icon-bg"></div>
      <div class="confirm-modal-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" fill="url(#iconWarningGrad)" />
          <path d="M12 8V13" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
          <circle cx="12" cy="16" r="1.25" fill="#ffffff" />
          <defs>
            <linearGradient id="iconWarningGrad" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#f97316" />
              <stop offset="100%" stop-color="#ef4444" />
            </linearGradient>
          </defs>
        </svg>
      </div>
    </div>
    
    <!-- Title -->
    <h3 class="confirm-modal-title">Xác nhận hủy đơn</h3>
    
    <!-- Description -->
    <p class="confirm-modal-desc" id="cancelConfirmText">
      Bạn có chắc chắn muốn hủy đơn hàng này không? Hành động này không thể hoàn tác.
    </p>
    
    <!-- Action Buttons -->
    <div class="confirm-modal-actions">
      <button type="button" id="cancelConfirmBtnClose" class="confirm-modal-btn confirm-modal-btn-cancel">
        Không, giữ lại đơn
      </button>
      <button type="button" id="cancelConfirmBtnSubmit" class="confirm-modal-btn confirm-modal-btn-confirm">
        Hủy đơn hàng
      </button>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const cancelForms = document.querySelectorAll(".js-cancel-form");
    const modal = document.getElementById("cancelConfirmModal");
    const modalText = document.getElementById("cancelConfirmText");
    const btnClose = document.getElementById("cancelConfirmBtnClose");
    const btnSubmit = document.getElementById("cancelConfirmBtnSubmit");
    
    let activeForm = null;
    
    cancelForms.forEach(form => {
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            activeForm = this;
            
            const msg = this.getAttribute("data-confirm-msg");
            if (msg) {
                modalText.innerText = msg;
            }
            
            modal.classList.add("active");
        });
    });
    
    function closeModal() {
        modal.classList.remove("active");
        activeForm = null;
    }
    
    if (btnClose) btnClose.addEventListener("click", closeModal);
    
    // Close modal if user clicks outside of confirm-modal-box
    modal.addEventListener("click", function (e) {
        if (e.target === modal) {
            closeModal();
        }
    });
    
    if (btnSubmit) {
        btnSubmit.addEventListener("click", function () {
            if (activeForm) {
                activeForm.submit();
            }
            closeModal();
        });
    }
});
</script>

