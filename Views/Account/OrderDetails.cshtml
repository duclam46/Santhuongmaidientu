@model DOAN_BANHANG.ViewModels.MyOrderDetailsPageVm

@{
  ViewData["Title"] = "Chi tiết đơn hàng";

  string FormatVnd(decimal amount)
  {
    return string.Format("{0:N0}đ", amount);
  }

  (string label, string pillClass) ResolveOrderStatusPill(string? rawStatus)
  {
    var s = (rawStatus ?? string.Empty).Trim();
    var norm = s.Replace(" ", string.Empty).ToLowerInvariant();

    const string basePill = "inline-flex items-center justify-center whitespace-nowrap rounded-full px-3 py-1 text-xs font-semibold leading-5";

    return norm switch
    {
      "pendingconfirmation" or "waitconfirm" or "waitingconfirm" or "confirming" or "pending" or "confirmationpending" or "processing" or "inprocess" or "inprocessing" or "chờxácnhận" or "choxacnhan" => (
        "Chờ xác nhận",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "awaitingpickup" or "waitpickup" or "waitingpickup" or "readytopick" or "pickup" or "chờlấyhàng" or "cholayhang" or "confirmed" or "accepted" or "đãxácnhận" or "daxacnhan" => (
        "Chờ lấy hàng",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "shipping" or "delivering" or "intransit" or "đanggiao" or "danggiao" => (
        "Đang giao",
        $"{basePill} bg-primary/8 text-primary"
      ),
      "completed" or "success" or "hoàntất" or "hoantat" => (
        "Hoàn tất",
        $"{basePill} bg-success-light text-success-dark"
      ),
      "delivered" or "deliverysuccess" or "dagiao" or "đãgiao" => (
        "Đã giao",
        $"{basePill} bg-success-light text-success-dark"
      ),
      "returned" or "return" or "refund" or "returnrequest" or "returning" or "trahang" or "trảhàng" => (
        "Trả hàng",
        $"{basePill} bg-warning-light text-warning-dark"
      ),
      "rejected" or "cancelled" or "canceled" or "cancel" or "đãhủy" or "dahuy" => (
        "Đã hủy",
        $"{basePill} bg-error-light text-error-dark"
      ),
      _ => (
        "Chờ xác nhận",
        $"{basePill} bg-warning-light text-warning-dark"
      )
    };
  }

  string ResolvePaymentBadge(string? rawPaymentStatus)
  {
    var s = (rawPaymentStatus ?? string.Empty).Trim();
    var norm = s.Replace(" ", string.Empty).ToLowerInvariant();
    return norm is "paid" or "success" or "completed" ? "(Đã thanh toán)" : "(Chưa thanh toán)";
  }

  var order = Model.Order;
}

<div class="sz-od-shell">
<section class="pb-[90px]">
  <div class="container">
    <div class="breadcrumb pt-8 pb-4">
      <ul>
        <li>
          <a href='@Url.Action("Index", "Home")'>
            <span class="inline-flex items-center justify-center">
              <i class="hgi hgi-stroke hgi-home-01 text-xl leading-6"></i>
            </span>
            Trang chủ
          </a>
        </li>
        <li class="text-light-disabled-text">&#8226;</li>
        <li>
          <a href='@Url.Action("Orders", "Account")'><span class="text-sm leading-[22px] text-slate-500 hover:text-teal-700">Đơn mua của tôi</span></a>
        </li>
        <li class="text-light-disabled-text">&#8226;</li>
        <li><span class="text-sm leading-[22px] font-semibold text-slate-700">Chi tiết đơn hàng</span></li>
      </ul>
    </div>

    <div class="mt-2">
      @if (TempData["AccountSuccess"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
      {
        <div class="mb-5 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 font-semibold text-sm flex items-center gap-2.5">
          <i class="hgi hgi-stroke hgi-checkmark-circle-02 text-emerald-600 text-lg"></i>
          <span>@okMsg</span>
        </div>
      }
      @if (TempData["AccountError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
      {
        <div class="mb-5 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 font-semibold text-sm flex items-center gap-2.5">
          <i class="hgi hgi-stroke hgi-alert-circle text-amber-600 text-lg"></i>
          <span>@errMsg</span>
        </div>
      }

      @if (!Model.IsSignedIn)
      {
        <div class="sz-od-card p-10 text-center">
          <h4 class="pb-2 text-slate-900 font-extrabold">Bạn chưa đăng nhập</h4>
          <p class="text-slate-500 pb-6 text-sm">Vui lòng đăng nhập để xem chi tiết đơn hàng.</p>
          <a href="#" class="btn btn-primary rounded-full px-8 login-page-btn">Đăng nhập ngay</a>
        </div>
      }
      else if (order is null)
      {
        <div class="sz-od-card p-10 text-center">
          <h4 class="pb-3 text-slate-900 font-extrabold">Không tìm thấy đơn hàng</h4>
          <a class="btn btn-default outline rounded-full px-6" href='@Url.Action("Orders", "Account")'>Quay lại danh sách</a>
        </div>
      }
      else
      {
        var statusUi = ResolveOrderStatusPill(order.OrderStatus);
        var raw = (order.OrderStatus ?? string.Empty).Trim();
        var norm = raw.Replace(" ", string.Empty).ToLowerInvariant();
        var isCancelled = norm is "rejected" or "cancelled" or "canceled" or "cancel" or "đãhủy" or "dahuy";

        var isDelivered = norm is "delivered" or "deliverysuccess" or "dagiao" or "đãgiao" or "completed" or "success";
        var isReturnRequest = norm is "returnrequest" or "returning" or "return" or "returned" or "refund" or "trahang" or "trảhàng";
        var isDelivering = norm is "shipping" or "delivering" or "intransit" or "đanggiao" or "danggiao";

        var canReturn = false;
        var daysRemainingReturn = 0;
        if (isDelivered && order.CanReturn)
        {
          var daysSince = (DateTime.UtcNow - order.UpdatedAt).TotalDays;
          canReturn = daysSince <= 5;
          daysRemainingReturn = (int)Math.Max(0, Math.Ceiling(5 - daysSince));
        }

        var canCancel = norm switch
        {
          "pendingconfirmation" or "waitconfirm" or "waitingconfirm" or "confirming" or "pending" or "confirmationpending" or "processing" or "inprocess" or "inprocessing" or "chờxácnhận" or "choxacnhan" => true,
          "awaitingpickup" or "waitpickup" or "waitingpickup" or "readytopick" or "pickup" or "chờlấyhàng" or "cholayhang" or "confirmed" or "accepted" or "đãxácnhận" or "daxacnhan" => true,
          _ => false
        };

        <!-- Unified Dark-Teal Hero Header + Stepper Card -->
        <div class="sz-od-card overflow-hidden">
          <div class="sz-od-hero">
            <div class="flex items-start justify-between gap-4 flex-wrap">
              <div class="flex items-center gap-4">
                <div class="sz-od-hero-icon">
                  <i class="hgi hgi-stroke hgi-invoice-01"></i>
                </div>
                <div>
                  <span class="sz-od-kicker">CHI TIẾT ĐƠN MUA</span>
                  <h3 class="text-white font-extrabold text-2xl mt-1 mb-0.5">
                    Đơn hàng #@(!string.IsNullOrWhiteSpace(order.OrderCode) ? order.OrderCode : order.Id.ToString())
                  </h3>
                  <div class="text-teal-100/85 text-xs font-medium">
                    Đặt lúc @order.CreatedAt.ToLocalTime().ToString("HH:mm, dd/MM/yyyy")
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2.5 flex-wrap">
                <span class="@statusUi.pillClass">@statusUi.label</span>
                @if (isDelivering || (isDelivered && !order.IsReceivedByCustomer))
                {
                  <form method="post" action="/my-orders/received" class="inline-flex" onsubmit="return confirm('Bạn xác nhận đã nhận được hàng đầy đủ và nguyên vẹn?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@order.Id" />
                    <input type="hidden" name="ReturnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                    <button type="submit" class="sz-od-action-btn emerald">
                      ✓ Đã nhận được hàng
                    </button>
                  </form>
                }
                @if (canCancel)
                {
                  var cancelConfirmMsg = (order.PaymentStatus == "Paid" || order.PaymentMethod == "Wallet" || order.PaymentMethod == "WalletVNPay" || order.PaymentMethod == "WalletCOD")
                      ? "Bạn có chắc chắn muốn hủy đơn hàng này không? Số tiền đã thanh toán (nếu có qua VNPay hoặc Ví) sẽ được hoàn trả về ví của bạn. Hành động này không thể hoàn tác."
                      : "Bạn có chắc chắn muốn hủy đơn hàng này không? Hành động này không thể hoàn tác.";

                  <form method="post" action="/my-orders/cancel" class="js-cancel-form inline-flex" data-confirm-msg="@cancelConfirmMsg">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@order.Id" />
                    <input type="hidden" name="ReturnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                    <button type="submit" class="sz-od-action-btn danger">
                      Hủy đơn
                    </button>
                  </form>
                }
                @if (canReturn)
                {
                  <a href="/my-orders/return/@order.Id" class="sz-od-action-btn orange">
                    ↩ Trả hàng (@daysRemainingReturn ngày)
                  </a>
                }
                @if (isReturnRequest)
                {
                  <a href="/my-orders/return/@order.Id" class="sz-od-action-btn light">
                    📋 Xem trả hàng
                  </a>
                }
                <a href="/my-disputes/create/@order.Id" class="sz-od-action-btn ghost">
                  ⚖️ Khiếu nại SP / Vận chuyển
                </a>
              </div>
            </div>
          </div>

          @{
            int currentStep = 1;
            if (norm is "confirmed" or "accepted" or "awaitingpickup" or "waitpickup" or "waitingpickup" or "readytopick" or "pickup" or "chờlấyhàng" or "cholayhang" or "đãxácnhận" or "daxacnhan")
            {
              currentStep = 2;
            }
            else if (isDelivering)
            {
              currentStep = 3;
            }
            else if (norm is "delivered" or "deliverysuccess" or "dagiao" or "đãgiao")
            {
              currentStep = order.IsReceivedByCustomer ? 5 : 4;
            }
            else if (norm is "completed" or "success" or "hoàntất" or "hoantat")
            {
              currentStep = 5;
            }

            var steps = new[]
            {
              new { Num = 1, Icon = "hgi-note-01", Title = "Đơn hàng đã đặt", Sub = order.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM") },
              new { Num = 2, Icon = "hgi-package", Title = "Shop đã xác nhận", Sub = currentStep >= 2 ? "Đã đóng gói & tạo vận đơn" : "Chờ Shop xác nhận" },
              new { Num = 3, Icon = "hgi-truck", Title = "Đang vận chuyển GHN", Sub = !string.IsNullOrWhiteSpace(order.TrackingCode) ? $"Mã GHN: {order.TrackingCode}" : "Bàn giao ĐVVC" },
              new { Num = 4, Icon = "hgi-delivery-box-01", Title = "Đã giao hàng", Sub = currentStep >= 4 ? "Giao thành công" : "Dự kiến 2-4 ngày" },
              new { Num = 5, Icon = "hgi-checkmark-circle-02", Title = "Hoàn tất", Sub = currentStep >= 5 ? "Đã hoàn tất đơn hàng" : "Xác nhận nhận hàng" }
            };
          }

          <div class="p-6 bg-white">
            @if (isCancelled)
            {
              <div class="flex items-center gap-3 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800">
                <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-xl shrink-0">
                  <i class="hgi hgi-stroke hgi-cancel-circle"></i>
                </div>
                <div>
                  <div class="font-bold text-sm">Đơn hàng đã bị hủy</div>
                  <div class="text-xs text-rose-600 mt-0.5">Cập nhật lúc @order.UpdatedAt.ToLocalTime().ToString("HH:mm, dd/MM/yyyy"). Nếu đơn đã thanh toán qua Ví/VNPay, tiền đã được hoàn tự động về Ví Sellzy của bạn.</div>
                </div>
              </div>
            }
            else if (isReturnRequest)
            {
              <div class="flex items-center justify-between flex-wrap gap-3 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl shrink-0">
                    <i class="hgi hgi-stroke hgi-package-process"></i>
                  </div>
                  <div>
                    <div class="font-bold text-sm">Đơn hàng đang trong quy trình Trả hàng / Hoàn tiền</div>
                    <div class="text-xs text-amber-700 mt-0.5">Tiền đơn hàng đang được đóng băng bảo vệ quyền lợi người mua cho đến khi hoàn tất xử lý.</div>
                  </div>
                </div>
                <a href="/my-orders/return/@order.Id" class="sz-od-action-btn orange">
                  Xem tiến độ trả hàng &amp; hoàn tiền
                </a>
              </div>
            }
            else
            {
              <div class="grid grid-cols-1 sm:grid-cols-5 gap-3">
                @foreach (var st in steps)
                {
                  bool isDone = st.Num < currentStep || currentStep == 5;
                  bool isCurrent = st.Num == currentStep && currentStep < 5;
                  <div class="sz-od-step @(isDone ? "is-done" : (isCurrent ? "is-current" : "is-pending"))">
                    <div class="sz-od-step-circle">
                      @if (isDone)
                      {
                        <i class="hgi hgi-stroke hgi-tick-02"></i>
                      }
                      else
                      {
                        <i class="hgi hgi-stroke @st.Icon"></i>
                      }
                    </div>
                    <div class="min-w-0">
                      <div class="sz-od-step-title">@st.Num. @st.Title</div>
                      <div class="sz-od-step-sub truncate">@st.Sub</div>
                    </div>
                  </div>
                }
              </div>
            }
          </div>
        </div>

        <div class="grid lg:grid-cols-12 grid-cols-1 gap-6 mt-6">
          <div class="lg:col-span-7 col-span-1 flex flex-col gap-6">
            @{
              var digitalLog = order.TrackingLogs?.FirstOrDefault(l => l.Note != null && (l.Note.Contains("BÀN GIAO SẢN PHẨM SỐ") || l.Note.Contains("E-Voucher")));
            }
            @if (order.IsDigitalOrder || digitalLog != null)
            {
              <div class="sz-od-card overflow-hidden border-teal-300">
                <div class="sz-od-panel-head teal">
                  <h4 class="text-white font-bold text-base m-0 flex items-center gap-2">
                    <i class="hgi hgi-stroke hgi-flash"></i> Sản phẩm số / E-Voucher
                  </h4>
                  <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-white text-teal-800">Giao tức thời</span>
                </div>
                <div class="p-5 text-sm bg-teal-50/40">
                  @if (digitalLog != null)
                  {
                    <div class="font-bold text-sm mb-2 text-teal-900">Mã kích hoạt / Link tải của bạn:</div>
                    <div class="p-3.5 rounded-xl bg-white border border-teal-200 font-mono font-bold text-teal-900 break-all">
                      @digitalLog.Note
                    </div>
                  }
                  else
                  {
                    <div class="text-slate-600">Mã E-Voucher / Link sản phẩm số sẽ hiển thị tại đây ngay sau khi đơn hàng hoàn tất thanh toán.</div>
                  }
                </div>
              </div>
            }

            @if (order.RequiresVatInvoice)
            {
              <div class="sz-od-card overflow-hidden">
                <div class="sz-od-panel-head">
                  <h5 class="text-slate-900 font-extrabold text-base m-0 flex items-center gap-2">
                    <i class="hgi hgi-stroke hgi-invoice-02 text-teal-700"></i> Thông tin xuất Hóa đơn GTGT (VAT)
                  </h5>
                  <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-teal-50 text-teal-700 border border-teal-200">Đã đăng ký</span>
                </div>
                <div class="p-5 text-sm grid grid-cols-1 gap-2">
                  <div><span class="text-slate-500">Tên công ty:</span> <strong class="text-slate-900">@order.CompanyName</strong></div>
                  <div><span class="text-slate-500">Mã số thuế (MST):</span> <strong class="text-teal-700">@order.TaxCode</strong></div>
                  <div><span class="text-slate-500">Địa chỉ công ty:</span> <span class="font-semibold text-slate-800">@order.CompanyAddress</span></div>
                </div>
              </div>
            }

            <!-- Products Card -->
            <div class="sz-od-card overflow-hidden">
              <div class="sz-od-panel-head">
                <h4 class="text-slate-900 font-extrabold text-base m-0 flex items-center gap-2">
                  <i class="hgi hgi-stroke hgi-shopping-bag-02 text-teal-700"></i> Sản phẩm trong đơn
                </h4>
                <span class="text-xs font-bold rounded-full px-3 py-1 bg-teal-50 text-teal-700 border border-teal-200">@order.Items.Count sản phẩm</span>
              </div>
              <div class="p-5 overflow-x-auto">
                <table class="w-full sz-od-table">
                  <thead>
                    <tr>
                      <th class="text-left">Sản phẩm</th>
                      <th class="text-left">Phân loại</th>
                      <th class="text-right">Đơn giá</th>
                      <th class="text-right">SL</th>
                      <th class="text-right">Thành tiền</th>
                    </tr>
                  </thead>
                  <tbody>
                    @foreach (var i in order.Items)
                    {
                      var variant = !string.IsNullOrWhiteSpace(i.VariantDescription)
                        ? i.VariantDescription
                        : string.Join(" - ", new[] { i.ColorName, i.SizeName }.Where(x => !string.IsNullOrWhiteSpace(x)));
                      <tr>
                        <td class="font-bold text-slate-900">@i.ProductName</td>
                        <td class="text-slate-500 text-xs">@(string.IsNullOrWhiteSpace(variant) ? "-" : variant)</td>
                        <td class="text-right font-semibold text-slate-700">@FormatVnd(i.UnitPrice)</td>
                        <td class="text-right font-semibold text-slate-700">x@i.Quantity</td>
                        <td class="text-right font-extrabold text-teal-700">@FormatVnd(i.LineTotal)</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Payment Card -->
            <div class="sz-od-card overflow-hidden">
              <div class="sz-od-panel-head">
                <h4 class="text-slate-900 font-extrabold text-base m-0 flex items-center gap-2">
                  <i class="hgi hgi-stroke hgi-payment-success-01 text-teal-700"></i> Chi tiết thanh toán
                </h4>
                <span class="text-xs font-bold rounded-full px-3 py-1 bg-slate-100 text-slate-700 border border-slate-200">@order.PaymentMethod</span>
              </div>
              <div class="p-5">
                <div class="rounded-2xl border border-slate-200 overflow-hidden">
                  <div class="p-5 bg-white flex flex-col gap-y-3 text-sm">
                    <div class="flex items-center justify-between">
                      <span class="text-slate-500">Tổng tiền hàng</span>
                      <span class="text-slate-900 font-bold">@FormatVnd(order.SubTotal)</span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-slate-500">Phí vận chuyển</span>
                      <span class="text-slate-900 font-bold">@FormatVnd(order.ShippingFee)</span>
                    </div>
                    @if (order.ShippingDiscount > 0)
                    {
                      <div class="flex items-center justify-between">
                        <span class="text-slate-500">Ưu đãi phí vận chuyển</span>
                        <span class="text-emerald-600 font-bold">-@FormatVnd(order.ShippingDiscount)</span>
                      </div>
                    }
                    @if (order.VoucherDiscount > 0)
                    {
                      <div class="flex items-center justify-between">
                        <span class="text-slate-500">Voucher giảm giá</span>
                        <span class="text-emerald-600 font-bold">-@FormatVnd(order.VoucherDiscount)</span>
                      </div>
                    }
                    @{
                      var calcVat = order.FinalAmount - order.SubTotal - order.ShippingFee + order.DiscountAmount;
                      if (calcVat < 0) calcVat = 0m;
                      var calcVatRate = order.SubTotal > 0 ? (calcVat / order.SubTotal * 100) : 0m;
                    }
                    @if (calcVat > 0)
                    {
                      <div class="flex items-center justify-between">
                        <span class="text-slate-500">Thuế VAT (@(calcVatRate.ToString("F2", new System.Globalization.CultureInfo("vi-VN")))%)</span>
                        <span class="text-slate-900 font-bold">@FormatVnd(calcVat)</span>
                      </div>
                    }
                  </div>

                  <div class="border-t border-teal-100 p-5 bg-teal-50/50">
                    <div class="flex items-center justify-between gap-3 flex-wrap">
                      <div>
                        <div class="text-slate-500 text-xs font-bold uppercase tracking-wider">Tổng thanh toán</div>
                        <div class="font-extrabold text-2xl text-teal-800 mt-0.5">@FormatVnd(order.FinalAmount)</div>
                      </div>
                      <div class="flex flex-col items-end gap-2">
                        <span class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-3 py-1 text-xs font-bold bg-white text-teal-700 border border-teal-200">
                          @ResolvePaymentBadge(order.PaymentStatus)
                        </span>
                        @if (!isCancelled && order.PaymentStatus == "AwaitingPayment" && (order.PaymentMethod == "BankTransfer" || order.PaymentMethod == "WalletVNPay") && order.PaymentDeadlineUtc.HasValue)
                        {
                          var remainingSeconds = (order.PaymentDeadlineUtc.Value - DateTime.Now).TotalSeconds;
                          if (remainingSeconds < 0 || remainingSeconds > 1800)
                          {
                            var altDiff = (order.PaymentDeadlineUtc.Value - DateTime.UtcNow).TotalSeconds;
                            if (altDiff >= 0 && altDiff <= 1800)
                            {
                              remainingSeconds = altDiff;
                            }
                          }
                          if (remainingSeconds < 0) remainingSeconds = 0;
                          if (remainingSeconds > 900) remainingSeconds = 900;

                          <div class="text-rose-600 font-extrabold text-xs bg-white px-3 py-1 rounded-full border border-rose-200 js-payment-countdown" data-remaining-seconds="@((int)remainingSeconds)">
                            <i class="hgi hgi-stroke hgi-time-04"></i> --:--
                          </div>
                        }
                      </div>
                    </div>
                    @if (!isCancelled && order.PaymentStatus == "AwaitingPayment" && (order.PaymentMethod == "BankTransfer" || order.PaymentMethod == "WalletVNPay"))
                    {
                      <div class="mt-4">
                        <a class="btn btn-medium w-full text-white js-payment-btn font-bold" style="background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 999px;" href="/checkout/vnpay-retry?codes=@Uri.EscapeDataString(order.OrderCode)">
                          Thanh toán ngay qua VNPay
                        </a>
                      </div>
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 col-span-1 flex flex-col gap-6">
            <!-- Shipping Address Card -->
            <div class="sz-od-card overflow-hidden">
              <div class="sz-od-panel-head">
                <h4 class="text-slate-900 font-extrabold text-base m-0 flex items-center gap-2">
                  <i class="hgi hgi-stroke hgi-location-01 text-teal-700"></i> Thông tin giao hàng
                </h4>
              </div>
              <div class="p-5 flex flex-col gap-3.5 text-sm">
                <div>
                  <div class="text-slate-400 text-xs font-bold uppercase tracking-wider">Người nhận</div>
                  <div class="text-slate-900 font-bold mt-0.5">@order.RecipientName • @order.RecipientPhone</div>
                </div>

                <div>
                  <div class="text-slate-400 text-xs font-bold uppercase tracking-wider">Địa chỉ nhận hàng</div>
                  <div class="text-slate-700 font-medium mt-0.5 leading-relaxed">@order.ShippingAddress</div>
                </div>

                <div class="border-t border-slate-100 pt-3.5 flex flex-col gap-2">
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-500 font-semibold">Dự kiến giao</span>
                    <span class="text-slate-900 font-bold">@(order.EstimatedDeliveryAt.HasValue ? order.EstimatedDeliveryAt.Value.ToLocalTime().ToString("HH:mm, dd/MM/yyyy") : "Đang cập nhật")</span>
                  </div>
                  @if (!string.IsNullOrWhiteSpace(order.ShipperName) || !string.IsNullOrWhiteSpace(order.ShipperPhone))
                  {
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-slate-500 font-semibold">Bưu tá giao hàng</span>
                      <span class="text-slate-900 font-bold">
                        @if (!string.IsNullOrWhiteSpace(order.ShipperName) && !string.IsNullOrWhiteSpace(order.ShipperPhone))
                        {
                          @order.ShipperName <text>(@order.ShipperPhone)</text>
                        }
                        else if (!string.IsNullOrWhiteSpace(order.ShipperName))
                        {
                          @order.ShipperName
                        }
                        else
                        {
                          @order.ShipperPhone
                        }
                      </span>
                    </div>
                  }
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-500 font-semibold">Mã vận đơn GHN</span>
                    <span class="font-mono font-extrabold text-teal-700 bg-teal-50 px-2.5 py-0.5 rounded-md border border-teal-200">@(string.IsNullOrWhiteSpace(order.TrackingCode) ? "Chưa khởi tạo" : order.TrackingCode)</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tracking Timeline Card -->
            <div class="order-history-table-wrapper sz-od-card overflow-hidden">
              <div class="sz-od-panel-head">
                <h4 class="text-slate-900 font-extrabold text-base m-0 flex items-center gap-2">
                  <i class="hgi hgi-stroke hgi-route-01 text-teal-700"></i> Hành trình đơn hàng
                </h4>
              </div>
              <div class="p-5">
                @{
                  bool ContainsAny(string? source, params string[] tokens)
                  {
                    if (string.IsNullOrWhiteSpace(source)) return false;
                    var s = source.Trim().ToLowerInvariant();
                    return tokens.Any(t => s.Contains(t));
                  }

                  var statusRaw = (order.OrderStatus ?? string.Empty).Trim();
                  var statusNorm = statusRaw.Replace(" ", string.Empty).ToLowerInvariant();

                  var logsAsc = (order.TrackingLogs ?? new List<DOAN_BANHANG.ViewModels.CustomerOrderTrackingLogVm>())
                    .OrderBy(x => x.CreatedAt)
                    .ToList();

                  DateTime? firstRealLogAt = logsAsc.Count > 0 ? logsAsc[0].CreatedAt : null;

                  const int RankPlaced = 0;
                  const int RankPreparing = 10;
                  const int RankPickedUp = 20;
                  const int RankCarrierLog = 100;

                  var timeline = new List<(DateTime At, int Rank, string Title, string? Detail, bool IsActive)>();
                  var placedAt = order.CreatedAt;

                  timeline.Add((placedAt, RankPlaced, "Đơn hàng đã được đặt", null, false));

                  var isBeyondPending = statusNorm is not (
                    "pendingconfirmation" or "waitconfirm" or "waitingconfirm" or "confirming" or "pending" or "confirmationpending" or
                    "processing" or "inprocess" or "inprocessing" or "chờxácnhận" or "choxacnhan");
                  if (isBeyondPending && !timeline.Any(x => string.Equals(x.Title, "Người bán đang chuẩn bị hàng", StringComparison.Ordinal)))
                  {
                    var preparingAt = firstRealLogAt.HasValue
                      ? firstRealLogAt.Value.AddSeconds(-60)
                      : (order.UpdatedAt > order.CreatedAt ? order.UpdatedAt : order.CreatedAt);

                    if (preparingAt <= placedAt) preparingAt = placedAt.AddSeconds(5);
                    timeline.Add((preparingAt, RankPreparing, "Người bán đang chuẩn bị hàng", null, false));
                  }

                  var isShippingOrLater = statusNorm is (
                    "shipping" or "delivering" or "intransit" or "đanggiao" or "danggiao" or
                    "completed" or "success" or "hoàntất" or "hoantat" or
                    "delivered" or "deliverysuccess" or "dagiao" or "đãgiao" or
                    "returned" or "return" or "refund" or "returnrequest" or "returning" or "trahang" or "trảhàng");
                  var hasPickedUpLog = logsAsc.Any(l =>
                    ContainsAny(l.Status, "pickup", "picked", "pickedup", "lấy") ||
                    ContainsAny(l.Note, "lấy hàng", "lấy hàng thành công"));

                  if (isShippingOrLater && !hasPickedUpLog)
                  {
                    var pickedUpAt = firstRealLogAt.HasValue
                      ? firstRealLogAt.Value.AddSeconds(-30)
                      : (order.UpdatedAt > order.CreatedAt ? order.UpdatedAt : order.CreatedAt);

                    var minPickedUpAt = timeline
                      .Where(x => x.Rank is RankPreparing or RankPlaced)
                      .Select(x => x.At)
                      .DefaultIfEmpty(placedAt)
                      .Max();

                    if (pickedUpAt <= minPickedUpAt) pickedUpAt = minPickedUpAt.AddSeconds(5);
                    timeline.Add((pickedUpAt, RankPickedUp, "Đơn vị vận chuyển lấy hàng thành công", null, false));
                  }

                  foreach (var l in logsAsc)
                  {
                    if (ContainsAny(l.Note, "shop xác nhận", "xác nhận đơn") || ContainsAny(l.Status, "confirm"))
                    {
                      continue;
                    }

                    var title = !string.IsNullOrWhiteSpace(l.Note) ? l.Note!.Trim() : l.Status.Trim();
                    if (!string.IsNullOrWhiteSpace(title))
                    {
                      timeline.Add((l.CreatedAt, RankCarrierLog, title, null, false));
                    }
                  }

                  if (timeline.Count == 0)
                  {
                    <p class="text-slate-400 text-sm text-center py-4">Chưa có cập nhật trạng thái.</p>
                  }
                  else
                  {
                    var timelineDesc = timeline
                      .OrderByDescending(x => x.At)
                      .ThenByDescending(x => x.Rank)
                      .ToList();

                    for (var i = 0; i < timelineDesc.Count; i++)
                    {
                      timelineDesc[i] = (timelineDesc[i].At, timelineDesc[i].Rank, timelineDesc[i].Title, timelineDesc[i].Detail, i == 0);
                    }

                    <div class="flex flex-col">
                      @for (var idx = 0; idx < timelineDesc.Count; idx++)
                      {
                        var item = timelineDesc[idx];
                        var isLast = idx == timelineDesc.Count - 1;
                        var local = item.At.ToLocalTime();
                        var dateText = local.ToString("dd/MM");
                        var timeText = local.ToString("HH:mm");

                        <div class="flex gap-x-4">
                          <div class="min-h-[60px] text-end shrink-0 w-[56px]">
                            <p class="text-xs font-bold text-slate-700 leading-4">@dateText</p>
                            <p class="text-[11px] text-slate-400 leading-4 mt-0.5">@timeText</p>
                          </div>

                          <div class="relative shrink-0">
                            @if (!isLast)
                            {
                              <div class="absolute bg-slate-200" style="top: 12px; bottom: 0; left: 4.5px; width: 2px;"></div>
                            }
                            <div class="relative z-10 mt-[5px] w-[11px] h-[11px] rounded-full @(item.IsActive ? "bg-teal-600 ring-4 ring-teal-100" : "bg-slate-300")"></div>
                          </div>

                          <div class="grow pb-6">
                            <p class="text-sm leading-5 @(item.IsActive ? "font-bold text-teal-800" : "font-medium text-slate-500")">@item.Title</p>
                            @if (!string.IsNullOrWhiteSpace(item.Detail))
                            {
                              <p class="text-slate-400 text-xs mt-1">@item.Detail</p>
                            }
                          </div>
                        </div>
                      }
                    </div>
                  }
                }
              </div>
            </div>

            <a class="btn btn-default outline w-full rounded-full font-bold py-3 text-center" href='@Url.Action("Orders", "Account")'>
              ← Quay lại danh sách đơn mua
            </a>
          </div>
        </div>
      }
    </div>
  </div>
</section>
</div>

