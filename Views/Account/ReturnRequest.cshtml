@model DOAN_BANHANG.ViewModels.ReturnRequestVm
@inject DOAN_BANHANG.Models.DataContext DbContext
@using Microsoft.EntityFrameworkCore

@{
  ViewData["Title"] = "Yêu cầu trả hàng";
  var rr = Model.ExistingRequest;
  bool hasPending = rr?.Status == "Pending";
  bool hasApproved = rr?.Status == "Approved";
  bool hasRejected = rr?.Status == "Rejected";

  // Fetch order tracking logs and order status for timeline
  var orderObj = await DbContext.Orders
    .AsNoTracking()
    .FirstOrDefaultAsync(o => o.Id == Model.OrderId);
  var orderStatusStr = orderObj?.OrderStatus ?? "";

  // Fetch order items with variant and product images for rich display
  var orderItems = await DbContext.OrderItems
    .AsNoTracking()
    .Include(oi => oi.Variant)
      .ThenInclude(v => v!.Product)
        .ThenInclude(p => p!.Images)
    .Where(oi => oi.OrderId == Model.OrderId)
    .ToListAsync();
}

<style>
  /* Unified Sellzy Dark-Teal Theme for Return Request */
  .return-page-wrapper {
    min-height: 85vh;
    background: #eef2f6;
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    color: #0f172a;
  }

  .breadcrumb ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
  }

  .breadcrumb a {
    color: #008374;
    text-decoration: none;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .breadcrumb a:hover {
    color: #065f5b;
  }

  .glass-banner {
    background: linear-gradient(135deg, #022c22 0%, #065f5b 55%, #008374 100%);
    border-radius: 22px;
    box-shadow: 0 14px 32px -10px rgba(0, 131, 116, 0.42);
    position: relative;
    overflow: hidden;
    color: #ffffff;
  }

  .glass-banner h3 {
    color: #ffffff !important;
  }

  .glass-banner > div:first-child .text-slate-500 {
    color: #d1fae5 !important;
  }

  .glass-banner > div:first-child .text-indigo-600 {
    color: #fde047 !important;
  }

  .glass-banner .text-indigo-600.hgi {
    color: #5eead4 !important;
  }

  .glass-banner .bg-white\/80 {
    background: #ffffff !important;
    border-color: #99f6e4 !important;
  }

  .glass-banner .text-indigo-950 {
    color: #043e37 !important;
  }

  .glass-banner .btn.btn-default.outline {
    background: rgba(255, 255, 255, 0.16) !important;
    border: 1px solid rgba(255, 255, 255, 0.34) !important;
    color: #ffffff !important;
  }

  .glass-banner .btn.btn-default.outline:hover {
    background: rgba(255, 255, 255, 0.26) !important;
  }

  .premium-card {
    background: #ffffff !important;
    border-radius: 20px !important;
    border: 1px solid #dbe4ee !important;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.05) !important;
    overflow: hidden !important;
    transition: all 0.25s ease !important;
  }

  .premium-card:hover {
    box-shadow: 0 12px 26px -8px rgba(0, 131, 116, 0.16) !important;
    border-color: #008374 !important;
  }

  /* Crisp high-contrast card headers */
  .card-header-indigo {
    background: linear-gradient(135deg, #022c22 0%, #008374 100%);
  }

  .card-header-violet {
    background: linear-gradient(135deg, #065f5b 0%, #0d9488 100%);
  }

  .card-header-slate {
    background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
  }

  .card-header-amber {
    background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);
  }

  .card-header-emerald {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
  }

  .card-header-rose {
    background: linear-gradient(135deg, #e11d48 0%, #f43f5e 100%);
  }

  .card-header-indigo h4,
  .card-header-violet h4,
  .card-header-slate h4,
  .card-header-amber h4,
  .card-header-emerald h4,
  .card-header-rose h4 {
    color: #ffffff !important;
  }

  /* High-contrast body text inside cards */
  .premium-card .text-indigo-600,
  .premium-card .text-indigo-900,
  .premium-card .text-indigo-950,
  .premium-card .text-violet-600,
  .premium-card .text-violet-700,
  .premium-card .text-violet-900,
  .premium-card .text-violet-950 {
    color: #043e37 !important;
  }

  .premium-card .bg-indigo-50,
  .premium-card .bg-violet-50 {
    background-color: #ecfdf5 !important;
  }

  .premium-card .border-indigo-100,
  .premium-card .border-violet-100 {
    border-color: #99f6e4 !important;
  }

  .reason-speech-bubble {
    background: #f8fafc !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 16px !important;
    color: #334155 !important;
    font-weight: 500;
    line-height: 1.6 !important;
    position: relative;
  }

  .ghn-ticket-card {
    background: linear-gradient(135deg, #f0fdfa 0%, #ecfdf5 100%) !important;
    border: 2px dashed #008374 !important;
    border-radius: 18px !important;
    padding: 20px !important;
    margin-top: 10px !important;
    position: relative !important;
    overflow: hidden !important;
  }

  .tracking-code {
    font-family: 'Courier New', Courier, monospace !important;
    font-size: 20px !important;
    font-weight: 900 !important;
    color: #065f5b !important;
    letter-spacing: 0.08em !important;
    background: #ffffff !important;
    padding: 6px 16px !important;
    border-radius: 10px !important;
    border: 1.5px solid #99f6e4 !important;
    display: inline-block !important;
  }

  .media-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)) !important;
    gap: 12px !important;
    margin-top: 14px !important;
  }

  .media-thumb {
    position: relative !important;
    width: 100% !important;
    aspect-ratio: 1 !important;
    border-radius: 14px !important;
    overflow: hidden !important;
    border: 1.5px solid #e2e8f0 !important;
    background: #f8fafc !important;
    transition: all 0.2s ease !important;
  }

  .media-thumb:hover {
    transform: translateY(-2px) !important;
    border-color: #008374 !important;
    box-shadow: 0 10px 18px rgba(0, 131, 116, 0.16) !important;
  }

  .media-thumb img, .media-thumb video {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .media-thumb .remove-btn {
    position: absolute !important;
    top: 6px !important;
    right: 6px !important;
    width: 24px !important;
    height: 24px !important;
    border-radius: 50% !important;
    background: rgba(239, 68, 68, 0.92) !important;
    color: white !important;
    border: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 11px !important;
    cursor: pointer !important;
    z-index: 10 !important;
    font-weight: bold !important;
  }

  .upload-progress {
    position: absolute !important;
    bottom: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 5px !important;
    background: rgba(226, 232, 240, 0.7) !important;
    z-index: 15 !important;
  }

  .upload-progress-bar {
    height: 100% !important;
    background: linear-gradient(to right, #008374, #14b8a6) !important;
    width: 0%;
    transition: width 0.2s ease !important;
  }

  .upload-area {
    border: 2px dashed #cbd5e1 !important;
    border-radius: 18px !important;
    padding: 28px 20px !important;
    text-align: center !important;
    background: #f8fafc !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
  }

  .upload-area:hover, .upload-area.dragover {
    border-color: #008374 !important;
    background: #f0fdfa !important;
  }

  .reason-textarea {
    width: 100% !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 16px !important;
    padding: 14px 18px !important;
    font-size: 14px !important;
    color: #0f172a !important;
    resize: vertical !important;
    min-height: 120px !important;
    outline: none !important;
    transition: all 0.2s ease !important;
    box-sizing: border-box !important;
  }

  .reason-textarea:focus {
    border-color: #008374 !important;
    box-shadow: 0 0 0 4px rgba(0, 131, 116, 0.12) !important;
    background: #ffffff !important;
  }

  .btn-submit-return {
    background: linear-gradient(135deg, #008374 0%, #065f5b 100%) !important;
    color: #fff !important;
    border: none !important;
    border-radius: 999px !important;
    padding: 14px 26px !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    box-shadow: 0 8px 20px rgba(0, 131, 116, 0.26) !important;
    width: 100% !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 10px !important;
  }

  .btn-submit-return:hover {
    box-shadow: 0 12px 24px rgba(0, 131, 116, 0.35) !important;
    transform: translateY(-1px) !important;
  }

  .btn-submit-return:disabled {
    opacity: 0.65 !important;
    cursor: not-allowed !important;
    transform: none !important;
  }

  .countdown-ring {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #008374, #065f5b);
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 14px;
    line-height: 1.1;
    border: 2px solid #99f6e4;
  }

  .countdown-ring .day-label {
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .prod-thumb {
    width: 68px !important;
    height: 68px !important;
    border-radius: 14px !important;
    object-fit: cover !important;
    border: 1.5px solid #e2e8f0 !important;
  }

  .timeline-log-msg {
    color: #475569 !important;
    font-size: 12.5px !important;
    line-height: 1.5 !important;
    font-weight: 600 !important;
    background: #f8fafc;
    border-radius: 10px;
    padding: 8px 12px;
    display: inline-block;
  }

  .status-badge-pending { background: rgba(255,255,255,0.22) !important; }
  .status-badge-approved { background: rgba(255,255,255,0.22) !important; }
  .status-badge-rejected { background: rgba(255,255,255,0.22) !important; }

  .custom-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .custom-lightbox.show { display: flex; opacity: 1; }
  .lightbox-content { max-width: 90%; max-height: 85%; position: relative; }
  .lightbox-content img, .lightbox-content video {
    max-width: 100%;
    max-height: 80vh;
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
  .lightbox-close {
    position: absolute;
    top: -45px;
    right: 0;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: white;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 16px;
  }
  .lightbox-close:hover { background: #ef4444; }
</style>

<section class="pb-[90px] return-page-wrapper">
  <div class="container">

    @* Breadcrumb *@
    <div class="breadcrumb pt-12">
      <ul>
        <li>
          <a href='@Url.Action("Index", "Home")'>
            <span class="inline-flex items-center justify-center">
              <i class="hgi hgi-stroke hgi-home-01 text-lg"></i>
            </span>
            Trang chủ
          </a>
        </li>
        <li class="text-light-disabled-text">&#8226;</li>
        <li>
          <a href='@Url.Action("Orders", "Account")'><span class="text-sm leading-[22px]">Đơn hàng</span></a>
        </li>
        <li class="text-light-disabled-text">&#8226;</li>
        <li><span class="text-sm leading-[22px] text-slate-400">Trả hàng hoàn tiền</span></li>
      </ul>
    </div>

    @* Alert messages *@
    @if (TempData["AccountSuccess"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
    {
      <div class="mt-6 p-4.5 rounded-2xl bg-emerald-50 border border-emerald-200/60 text-emerald-950 flex items-center gap-3 shadow-sm animate-fade-in">
        <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0">
          <i class="hgi hgi-stroke hgi-tick-circle text-lg"></i>
        </div>
        <span class="font-extrabold text-sm">@okMsg</span>
      </div>
    }
    @if (TempData["AccountError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
    {
      <div class="mt-6 p-4.5 rounded-2xl bg-rose-50 border border-rose-200/60 text-rose-950 flex items-center gap-3 shadow-sm animate-fade-in">
        <div class="w-8 h-8 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 flex-shrink-0">
          <i class="hgi hgi-stroke hgi-alert-circle text-lg"></i>
        </div>
        <span class="font-extrabold text-sm">@errMsg</span>
      </div>
    }

    @* Top Header Summary Panel *@
    <div class="glass-banner p-6 lg:p-8 mt-6 flex flex-wrap justify-between items-center gap-4">
      <div>
        <h3 class="text-slate-800 font-extrabold text-2xl lg:text-3xl flex items-center gap-2">
          <i class="hgi hgi-stroke hgi-arrow-back-double-02 text-3xl text-indigo-600"></i>
          Chi tiết yêu cầu trả hàng
        </h3>
        <div class="text-slate-500 text-[13.5px] mt-1.5 font-semibold">
          Mã đơn hàng gốc: <span class="font-extrabold text-indigo-600">#@Model.OrderCode</span>
        </div>
      </div>
      
      <div class="flex items-center gap-3">
        @if (Model.CanReturn && rr is null)
        {
          <div class="flex items-center gap-3 bg-white/80 backdrop-blur-md border border-indigo-100 rounded-full pl-3 pr-4 py-1.5 shadow-sm text-xs font-bold">
            <div class="countdown-ring">
              <span>@Model.DaysRemaining</span>
              <span class="day-label">ngày</span>
            </div>
            <span class="text-indigo-950 font-extrabold">Thời hạn yêu cầu còn lại</span>
          </div>
        }
        <a href="/my-orders" class="btn btn-default outline !rounded-full !py-3 !px-6 text-sm font-bold shadow-xs transition-all duration-200 hover:-translate-y-0.5">
          <i class="hgi hgi-stroke hgi-arrow-left-01 mr-1 text-lg"></i> Quay lại đơn hàng
        </a>
      </div>
    </div>

    @* CASE 1: Expired and no existing request *@
    @if (!Model.CanReturn && rr is null)
    {
      <div class="premium-card p-10 lg:p-14 mt-8 text-center bg-white">
        <div class="w-20 h-20 rounded-full bg-rose-50 flex items-center justify-center text-rose-500 mx-auto mb-6 shadow-inner animate-pulse">
          <i class="hgi hgi-stroke hgi-clock text-4xl"></i>
        </div>
        <h4 class="text-rose-600 font-extrabold text-2xl mb-3">Hết Hạn Trả Hàng Hoàn Tiền</h4>
        <p class="text-slate-500 max-w-md mx-auto text-[14.5px] leading-relaxed mb-8 font-semibold">
          Chính sách trả hàng chỉ áp dụng trong vòng <span class="text-indigo-600 font-bold">5 ngày</span> kể từ khi quý khách nhận hàng thành công.<br>
          <span class="text-xs text-slate-400 block mt-2">Thời gian nhận hàng: @Model.DeliveredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
        </p>
        <a href="/my-orders" class="inline-flex items-center justify-center bg-slate-800 text-white font-extrabold text-sm rounded-full px-8 py-3.5 hover:bg-slate-900 transition-all duration-200 shadow-md">
          <i class="hgi hgi-stroke hgi-arrow-left-01 mr-2 text-lg"></i> Quay lại đơn hàng
        </a>
      </div>
    }

    @* CASE 2: Existing return request (Stunning 50/50 Balanced Column Layout) *@
    @if (rr is not null)
    {
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-6">
        
        @* LEFT COLUMN (50%): Request details & Returned products list *@
        <div class="flex flex-col gap-6">
          
          @* Card 1: Request Details (Reason & Evidence Media) *@
          <div class="premium-card">
            <div class="card-header-indigo text-white p-5">
              <h4 class="font-black flex items-center gap-2.5 text-base lg:text-lg text-white m-0">
                <i class="hgi hgi-stroke hgi-note-01 text-2xl text-white"></i>
                Chi tiết yêu cầu đã gửi
              </h4>
            </div>
            
            <div class="p-6 flex flex-col gap-4">
              <div class="flex justify-between items-center py-2.5 border-b border-gray-100 flex-wrap gap-2">
                <span class="text-xs text-indigo-900 font-extrabold uppercase tracking-wider">Ngày gửi yêu cầu</span>
                <span class="text-sm font-extrabold text-indigo-600">@rr.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
              </div>
              
              <div class="py-2.5">
                <span class="text-xs text-indigo-900 font-extrabold uppercase tracking-wider block mb-3">Lý do từ quý khách:</span>
                <p class="p-4 reason-speech-bubble">“@rr.Reason”</p>
              </div>
              
              @if (rr.MediaUrls.Count > 0)
              {
                <div class="border-t border-gray-100 pt-4">
                  <span class="text-xs text-indigo-900 font-extrabold uppercase tracking-wider block mb-2.5">Hình ảnh / Video bằng chứng kèm theo:</span>
                  <div class="media-grid">
                    @foreach (var url in rr.MediaUrls)
                    {
                      <div class="media-thumb">
                        @{
                          var ext = System.IO.Path.GetExtension(url).ToLowerInvariant();
                          bool isVideo = ext is ".mp4" or ".mov" or ".avi" or ".webm";
                        }
                        @if (isVideo)
                        {
                          <video src="@url" style="width:100%;height:100%;object-fit:cover;cursor:zoom-in;" onclick="openLightbox('@url', true)"></video>
                        }
                        else
                        {
                          <img src="@url" alt="Evidence" loading="lazy" style="cursor:zoom-in;" onclick="openLightbox('@url', false)" />
                        }
                      </div>
                    }
                  </div>
                </div>
              }
            </div>
          </div>

          @* Card 2: Returned Products List *@
          <div class="premium-card">
            <div class="card-header-violet text-white p-5">
              <h4 class="font-black flex items-center gap-2.5 text-base lg:text-lg text-white m-0">
                <i class="hgi hgi-stroke hgi-shopping-bag text-2xl text-white"></i>
                Sản phẩm yêu cầu hoàn trả
              </h4>
            </div>
            
            <div class="p-6 flex flex-col gap-4">
              @foreach (var item in orderItems)
              {
                var imgUrl = item.Variant?.Product?.Images?.FirstOrDefault()?.ImageUrl ?? "/assets/images/no-image.png";
                <div class="flex gap-4 items-start pb-4 border-b border-gray-100 last:border-0 last:pb-0">
                  <img src="@imgUrl" class="prod-thumb" alt="@item.ProductName" />
                  <div class="flex-grow min-w-0">
                    <h5 class="text-sm font-extrabold text-violet-950 leading-snug truncate">@item.ProductName</h5>
                    <div class="flex gap-2 flex-wrap mt-1.5">
                      @if (!string.IsNullOrEmpty(item.ColorName))
                      {
                        <span class="inline-block text-[11px] font-bold bg-violet-50 text-violet-700 px-2.5 py-0.5 rounded-full border border-violet-100">Màu: @item.ColorName</span>
                      }
                      @if (!string.IsNullOrEmpty(item.SizeName))
                      {
                        <span class="inline-block text-[11px] font-bold bg-violet-50 text-violet-700 px-2.5 py-0.5 rounded-full border border-violet-100">Size: @item.SizeName</span>
                      }
                    </div>
                    <div class="flex justify-between items-center mt-3 flex-wrap gap-2">
                      <div class="text-xs text-light-secondary-text">Đơn giá: <span class="font-bold text-light-primary-text">@item.UnitPrice.ToString("N0")đ</span></div>
                      <div class="text-xs text-light-secondary-text">Số lượng: <span class="font-bold text-light-primary-text">x@item.Quantity</span></div>
                      <div class="text-sm font-black text-violet-600">@item.LineTotal.ToString("N0")đ</div>
                    </div>
                  </div>
                </div>
              }
            </div>
          </div>
        </div>

        @* RIGHT COLUMN (50%): Status, GHN logistics & Shipping Timeline Stepper *@
        <div class="flex flex-col gap-6">
          
          @* Card 3: Approved/Pending Status banner *@
          <div class="premium-card">
            @if (hasPending)
            {
              <div class="card-header-amber text-white p-5 flex justify-between items-center flex-wrap gap-3">
                <h4 class="font-black flex items-center gap-2.5 text-base lg:text-lg text-white m-0">
                  <i class="hgi hgi-stroke hgi-delivery-truck text-2xl text-white"></i>
                  Trạng thái phê duyệt vận chuyển
                </h4>
                <span class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-4 py-1.5 text-xs font-black bg-white/20 text-white shadow-xs backdrop-blur-md status-badge-pending">⏳ Chờ duyệt</span>
              </div>
            }
            else if (hasApproved)
            {
              <div class="card-header-emerald text-white p-5 flex justify-between items-center flex-wrap gap-3">
                <h4 class="font-black flex items-center gap-2.5 text-base lg:text-lg text-white m-0">
                  <i class="hgi hgi-stroke hgi-delivery-truck text-2xl text-white"></i>
                  Trạng thái phê duyệt vận chuyển
                </h4>
                <span class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-4 py-1.5 text-xs font-black bg-white/20 text-white shadow-xs backdrop-blur-md status-badge-approved">✅ Đã duyệt</span>
              </div>
            }
            else if (hasRejected)
            {
              <div class="card-header-rose text-white p-5 flex justify-between items-center flex-wrap gap-3">
                <h4 class="font-black flex items-center gap-2.5 text-base lg:text-lg text-white m-0">
                  <i class="hgi hgi-stroke hgi-delivery-truck text-2xl text-white"></i>
                  Trạng thái phê duyệt vận chuyển
                </h4>
                <span class="inline-flex items-center justify-center whitespace-nowrap rounded-full px-4 py-1.5 text-xs font-black bg-white/20 text-white shadow-xs backdrop-blur-md status-badge-rejected">❌ Bị từ chối</span>
              </div>
            }

            <div class="p-6">
              @if (hasApproved)
              {
                <div class="ghn-ticket-card">
                  <div class="font-extrabold flex items-center gap-1.5 mb-4 text-emerald-800 text-sm">
                    <i class="hgi hgi-stroke hgi-tick-circle text-xl text-emerald-600"></i>
                    Đơn hàng thu hồi GHN đã được tạo thành công
                  </div>

                  @if (!string.IsNullOrWhiteSpace(rr.ReturnTrackingCode))
                  {
                    <div class="flex justify-between items-center py-2.5 border-b border-emerald-200/30 flex-wrap gap-2">
                      <span class="text-xs text-emerald-800 font-extrabold uppercase tracking-wider">Mã đơn hoàn GHN</span>
                      <span class="tracking-code">@rr.ReturnTrackingCode</span>
                    </div>
                  }
                  @if (!string.IsNullOrWhiteSpace(rr.EstimatedPickupTime))
                  {
                    <div class="flex justify-between items-center py-2.5 border-b border-emerald-200/30 flex-wrap gap-2">
                      <span class="text-xs text-emerald-800 font-extrabold uppercase tracking-wider">Thời gian bưu tá đến</span>
                      <span class="text-xs font-extrabold text-emerald-955 bg-white border border-emerald-200 rounded-full px-3.5 py-1">@rr.EstimatedPickupTime</span>
                    </div>
                  }
                  <div class="flex justify-between py-3 flex-col gap-1 mt-2">
                    <span class="text-xs text-emerald-800 font-extrabold uppercase tracking-wider">Địa chỉ lấy hàng hoàn trả:</span>
                    <div class="font-medium text-emerald-955 text-xs leading-relaxed bg-white p-3.5 rounded-xl border border-emerald-100 mt-1.5 shadow-sm">
                      <strong class="text-sm text-slate-800">@Model.RecipientName — @Model.RecipientPhone</strong>
                      <span class="text-slate-500 text-[11.5px] font-semibold block mt-1">@Model.ShippingAddress</span>
                    </div>
                  </div>

                  <div class="p-3.5 bg-emerald-600/10 border border-emerald-200 rounded-xl mt-4 text-emerald-950 text-xs leading-relaxed font-bold">
                    💡 <strong>Quy định thu hồi:</strong> Bưu tá của Giaohangnhanh (GHN) sẽ tự động đến thu hồi tận nơi. Quý khách không phải thanh toán bất kỳ chi phí vận chuyển nào.
                  </div>
                </div>

                @* Beautiful Timeline stepper exactly like OrderDetails but upgraded with colors *@
                var returnLogs = await DbContext.OrderTrackingLogs
                  .AsNoTracking()
                  .Where(x => x.OrderId == Model.OrderId && x.Note != null && x.Note.StartsWith("SIM_RET|"))
                  .OrderBy(x => x.CreatedAt)
                  .ToListAsync();


                <div class="border border-emerald-100 rounded-2xl overflow-hidden mt-6 shadow-xs">
                  <div class="p-4 bg-gradient-to-r from-emerald-50 to-white border-b border-emerald-100 font-black text-sm text-emerald-950 flex items-center gap-1.5">
                    <i class="hgi hgi-stroke hgi-location-user-01 text-xl text-emerald-600"></i>
                    Lộ trình di chuyển hàng hoàn (GHN)
                  </div>
                  <div class="p-6 bg-white">
                    @if (returnLogs.Count == 0)
                    {
                      <div class="text-center py-8 bg-slate-50/50 rounded-2xl border border-dashed border-slate-200">
                        <div class="text-3xl mb-2">⏳</div>
                        <div class="font-extrabold text-slate-800 text-sm">Chờ bàn giao bưu cục GHN</div>
                        <p class="text-xs text-light-secondary-text mt-1.5 max-w-sm mx-auto leading-relaxed font-semibold">
                          Lịch trình bưu tá đi thu hồi và các điểm trung chuyển kho bãi sẽ tự động đồng bộ thời gian thực ngay khi quét biên nhận.
                        </p>
                      </div>
                    }
                    else
                    {
                      var returnLogsDesc = returnLogs.OrderByDescending(x => x.CreatedAt).ToList();
                      var latestLog = returnLogsDesc.FirstOrDefault();
                      var isRefused = returnLogs.Any(x => x.Note != null && (x.Note.Contains("|e=refuse") || x.Note.Contains("Event: refuse")));
                      var isSuccessful = orderStatusStr == "Returned" && !isRefused;

                      <div class="p-3.5 mb-6 rounded-xl text-center font-extrabold text-xs tracking-wider shadow-xs @(isSuccessful ? "bg-emerald-50 text-emerald-700 border border-emerald-100" : (isRefused ? "bg-rose-50 text-rose-700 border border-rose-100" : "bg-indigo-50 text-indigo-700 border border-indigo-100"))">
                        @if (isSuccessful)
                        {
                          <span>🎉 ĐÃ HOÀN TRẢ THÀNH CÔNG VỀ SHOP — TIỀN ĐÃ HOÀN</span>
                        }
                        else if (isRefused)
                        {
                          <span>❌ HÀNG HOÀN BỊ SHOP TỪ CHỐI NHẬN</span>
                        }
                        else
                        {
                          <span>🚚 ĐƠN HOÀN ĐANG TRÊN ĐƯỜNG VẬN CHUYỂN</span>
                        }
                      </div>

                      @* Clean and Professional Timeline Layout *@
                      <div class="flex flex-col pl-2 timeline-stepper">
                        @for (var idx = 0; idx < returnLogsDesc.Count; idx++)
                        {
                          var log = returnLogsDesc[idx];
                          var isLast = idx == returnLogsDesc.Count - 1;
                          var isFirst = idx == 0;
                          var local = log.CreatedAt.ToLocalTime();
                          var dateText = local.ToString("dd 'Th'MM");
                          var timeText = local.ToString("HH:mm");

                          var displayMsg = log.Note;
                          if (log.Note != null && log.Note.Contains(" - "))
                          {
                            displayMsg = log.Note.Substring(log.Note.IndexOf(" - ") + 3);
                          }

                          var titleClass = isFirst ? "text-emerald-600 font-extrabold text-sm" : "text-slate-400 text-sm font-semibold";
                          var dotStyle = isFirst 
                            ? "background-color: #10b981; box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.25); transform: scale(1.1);" 
                            : "background-color: #cbd5e1;";

                          <div class="flex gap-x-4">
                            @* Timestamp *@
                            <div class="min-h-[64px] text-end flex-shrink-0" style="width: 80px;">
                              <p class="text-xs font-black text-slate-800 leading-[18px]">@dateText</p>
                              <p class="text-[11px] font-extrabold text-slate-400 leading-[16px] mt-0.5">@timeText</p>
                            </div>

                            @* Line and Bullet *@
                            <div class="relative flex-shrink-0" style="width: 10px;">
                              @if (!isLast)
                              {
                                <div class="absolute bg-slate-200" style="top: 10px; bottom: 0; left: 4px; width: 2px;"></div>
                              }
                              <div class="relative z-10 mt-[6px] w-[10px] h-[10px] rounded-full transition-all duration-300" style="@dotStyle"></div>
                            </div>

                            @* Event description *@
                            <div class="grow pb-6 pl-2">
                              <p class="@titleClass leading-[20px]">@log.Status</p>
                              @if (!string.IsNullOrWhiteSpace(displayMsg))
                              {
                                <p class="timeline-log-msg mt-1">@displayMsg</p>
                              }
                            </div>
                          </div>
                        }
                      </div>
                    }
                  </div>
                </div>
              }

              @if (hasRejected)
              {
                <div class="p-4 bg-rose-50 border border-rose-100 rounded-2xl text-sm text-rose-950">
                  <div class="font-extrabold flex items-center gap-1.5 mb-1 text-rose-800">
                    <i class="hgi hgi-stroke hgi-cancel-01 text-lg"></i>
                    Lý do Shop từ chối nhận hàng hoàn
                  </div>
                  <p class="bg-white border border-rose-100 p-3.5 rounded-xl text-slate-800 font-bold mt-2 leading-relaxed shadow-sm">
                    “@(string.IsNullOrWhiteSpace(rr.RejectionNote) ? "Shop từ chối duyệt hoàn cho lý do này." : rr.RejectionNote)”
                  </p>
                  @if (Model.CanReturn)
                  {
                    <p class="text-xs text-rose-600/80 mt-2.5 font-bold">Thời hạn 5 ngày vẫn khả dụng. Quý khách có thể chỉnh sửa và gửi lại yêu cầu trả hàng mới ở biểu mẫu phía dưới.</p>
                  }
                  <div class="mt-3 pt-3 border-t border-rose-200/60 flex flex-wrap items-center justify-between gap-2">
                    <span class="text-xs font-bold text-rose-900">Không đồng ý với quyết định từ chối của Shop?</span>
                    <a href="/my-disputes/create/@Model.OrderId" style="display:inline-flex; align-items:center; gap:6px; background:#00262A; color:#FFEB69; padding:7px 14px; border-radius:999px; font-size:12.5px; font-weight:800; text-decoration:none;">
                      ⚖️ Khiếu nại lên Trọng tài Sàn Sellzy
                    </a>
                  </div>
                </div>
              }

              @if (hasPending)
              {
                <div class="p-4.5 bg-amber-50 border border-amber-100 rounded-2xl text-sm text-amber-950 flex gap-3 shadow-xs">
                  <i class="hgi hgi-stroke hgi-clock text-xl mt-0.5 text-amber-600"></i>
                  <div>
                    <div class="font-extrabold text-amber-900">Đang chờ Shop kiểm định lý do</div>
                    <p class="text-slate-500 text-xs leading-relaxed mt-1 font-semibold">
                      Shop đang xử lý yêu cầu trả hàng của quý khách. Ngay khi được phê duyệt, mã vận đơn thu hồi tự động kích hoạt và gửi tới bưu cục GHN.
                    </p>
                  </div>
                </div>
              }
            </div>
          </div>
        </div>
      </div>
    }

    @* CASE 3: Return Form (Show Side-by-Side 50/50: Policy/Guide vs Form) *@
    @if (Model.CanReturn && (rr is null || hasRejected))
    {
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-6">
        
        @* Left Column (50%): Guide, Address details *@
        <div class="flex flex-col gap-6">
          
          @* Policy Guidelines card *@
          <div class="premium-card">
            <div class="card-header-indigo text-white p-5">
              <h4 class="font-black flex items-center gap-2.5 text-base lg:text-lg text-white m-0">
                <i class="hgi hgi-stroke hgi-help-circle text-2xl text-white"></i>
                Chính sách & Quy trình trả hàng
              </h4>
            </div>
            
            <div class="p-6 flex flex-col gap-5">
              <div class="flex gap-4 items-start">
                <div class="flex items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 font-extrabold text-sm w-9 h-9 flex-shrink-0 border border-indigo-100 shadow-sm">
                  <i class="hgi hgi-stroke hgi-bubble-chat"></i>
                </div>
                <div>
                  <h5 class="text-sm font-extrabold text-indigo-950">Gửi mô tả & Bằng chứng lỗi</h5>
                  <p class="text-[12.5px] text-slate-500 mt-1 leading-relaxed font-semibold">Tải lên hình ảnh sản phẩm thực tế, video bóc hộp để Shop tiến hành xác minh nhanh chóng.</p>
                </div>
              </div>

              <div class="flex gap-4 items-start">
                <div class="flex items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 font-extrabold text-sm w-9 h-9 flex-shrink-0 border border-indigo-100 shadow-sm">
                  <i class="hgi hgi-stroke hgi-delivery-truck"></i>
                </div>
                <div>
                  <h5 class="text-sm font-extrabold text-indigo-950">Shop duyệt & Bàn giao bưu tá</h5>
                  <p class="text-[12.5px] text-slate-500 mt-1 leading-relaxed font-semibold">Hệ thống đẩy thông tin sang GHN, bưu tá sẽ qua tận nơi thu hồi sản phẩm. Quý khách hoàn toàn miễn phí vận chuyển hoàn.</p>
                </div>
              </div>

              <div class="flex gap-4 items-start">
                <div class="flex items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 font-extrabold text-sm w-9 h-9 flex-shrink-0 border border-indigo-100 shadow-sm">
                  <i class="hgi hgi-stroke hgi-wallet-01"></i>
                </div>
                <div>
                  <h5 class="text-sm font-extrabold text-indigo-950">Xác nhận nhận hàng & Hoàn tiền</h5>
                  <p class="text-[12.5px] text-slate-500 mt-1 leading-relaxed font-semibold">Khi bưu tá giao trả hàng về Shop thành công, tiền sẽ lập tức được hoàn vào Ví tài khoản của quý khách.</p>
                </div>
              </div>

              <div class="p-4 bg-amber-50 border border-amber-100 rounded-2xl mt-2 text-amber-900 text-xs leading-relaxed font-bold shadow-xs flex gap-2">
                <i class="hgi hgi-stroke hgi-alert-circle text-lg text-amber-600 flex-shrink-0"></i>
                <span><strong>Lưu ý quan trọng:</strong> Bằng chứng bằng hình ảnh hoặc video mở gói hàng là căn cứ quan trọng nhất để shop thực hiện phê duyệt nhanh nhất.</span>
              </div>
            </div>
          </div>

          @* Pickup Address detail *@
          <div class="premium-card">
            <div class="card-header-violet text-white p-5">
              <h4 class="font-black flex items-center gap-2.5 text-base lg:text-lg text-white m-0">
                <i class="hgi hgi-stroke hgi-location-user-01 text-2xl text-white"></i>
                Địa chỉ bưu tá qua thu hồi hàng
              </h4>
            </div>
            
            <div class="p-6 flex flex-col gap-4">
              <div>
                <span class="text-xs text-violet-900 font-extrabold block uppercase tracking-wider">Người gửi hoàn trả</span>
                <span class="text-sm font-extrabold text-violet-950 block mt-1.5">@Model.RecipientName — @Model.RecipientPhone</span>
              </div>
              <div class="border-t border-gray-100 pt-3.5">
                <span class="text-xs text-violet-900 font-extrabold block uppercase tracking-wider">Địa chỉ thu hồi</span>
                <p class="text-xs text-slate-600 leading-relaxed mt-1.5 font-bold">@Model.ShippingAddress</p>
              </div>
              <div class="text-[11px] text-violet-850 font-semibold bg-violet-50 p-3.5 rounded-xl border border-violet-100/50 mt-1">
                * Địa chỉ này được đồng bộ cố định theo địa chỉ giao nhận gốc để bưu tá GHN thực hiện tuyến thu hồi.
              </div>
            </div>
          </div>
        </div>

        @* Right Column (50%): Form submission & Products details *@
        <div class="flex flex-col gap-6">
          
          @* Products to return section *@
          <div class="premium-card">
            <div class="card-header-slate text-white p-5">
              <h4 class="font-black flex items-center gap-2 text-base text-white m-0">
                <i class="hgi hgi-stroke hgi-shopping-bag text-xl text-white"></i>
                Sản phẩm sẽ được hoàn trả
              </h4>
            </div>
            
            <div class="p-6 flex flex-col gap-4">
              @foreach (var item in orderItems)
              {
                var imgUrl = item.Variant?.Product?.Images?.FirstOrDefault()?.ImageUrl ?? "/assets/images/no-image.png";
                <div class="flex gap-3.5 items-center pb-3 border-b border-gray-100 last:border-0 last:pb-0 animate-fade-in">
                  <img src="@imgUrl" class="w-14 h-14 rounded-xl object-cover border border-gray-200 flex-shrink-0 prod-thumb" alt="@item.ProductName" />
                  <div class="flex-grow min-w-0">
                    <h5 class="text-xs font-extrabold text-slate-800 truncate">@item.ProductName</h5>
                    <div class="flex gap-2 mt-1.5">
                      @if (!string.IsNullOrEmpty(item.ColorName))
                      {
                        <span class="text-[10px] font-bold bg-slate-50 text-slate-500 px-2 py-0.5 rounded border border-slate-200">Màu: @item.ColorName</span>
                      }
                      @if (!string.IsNullOrEmpty(item.SizeName))
                      {
                        <span class="text-[10px] font-bold bg-slate-50 text-slate-500 px-2 py-0.5 rounded border border-slate-200">Size: @item.SizeName</span>
                      }
                    </div>
                  </div>
                  <div class="text-right flex-shrink-0">
                    <div class="text-xs font-black text-indigo-600">@item.LineTotal.ToString("N0")đ</div>
                    <div class="text-[10px] text-slate-400 font-bold">x@item.Quantity</div>
                  </div>
                </div>
              }
            </div>
          </div>

          @* Form body *@
          <div class="premium-card">
            <div class="card-header-indigo text-white p-5">
              <h4 class="font-black flex items-center gap-2 text-base text-white m-0">
                <i class="hgi hgi-stroke hgi-note-01 text-xl text-white"></i>
                Biểu mẫu gửi yêu cầu trả hàng
              </h4>
            </div>
            
            <div class="p-6">
              <form id="returnForm" action="/my-orders/return/submit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.OrderId" />
                <input type="hidden" name="mediaUrlsJson" id="mediaUrlsJson" />

                @* Reason *@
                <div class="mb-5">
                  <label class="font-bold text-slate-700 text-sm mb-2 block">
                    Mô tả cụ thể lý do trả hàng <span class="text-red-500">*</span>
                  </label>
                  <textarea name="reason" id="reasonInput" class="reason-textarea"
                    placeholder="Quý khách vui lòng mô tả kỹ sản phẩm bị lỗi như thế nào hoặc không đúng với mô tả gì..."
                    maxlength="500" required></textarea>
                  <div class="text-right text-xs text-slate-400 mt-1.5"><span id="charCount" class="font-bold text-indigo-600">0</span>/500 ký tự</div>
                </div>

                @* Media upload *@
                <div class="mb-6">
                  <label class="font-bold text-slate-700 text-sm mb-2 block">
                    Hình ảnh / Video bằng chứng thực tế <span class="text-red-500">*</span>
                  </label>
                  <div class="upload-area flex flex-col items-center justify-center border-2 border-dashed border-slate-300 rounded-3xl p-8 bg-slate-50/50 hover:bg-indigo-50/30 hover:border-indigo-500 transition-all duration-300 group" id="uploadArea" onclick="document.getElementById('fileInput').click();">
                    <div class="upload-area-icon w-14 h-14 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-600 mb-3 group-hover:scale-110 group-hover:bg-indigo-100 transition-all duration-300">
                      <i class="hgi hgi-stroke hgi-cloud-upload text-3xl"></i>
                    </div>
                    <div class="font-extrabold text-slate-800 text-sm mb-1">Chọn tệp bằng chứng hoặc kéo thả vào đây</div>
                    <div class="text-[11.5px] text-slate-500 leading-relaxed font-semibold max-w-sm">Hỗ trợ hình ảnh (JPG, PNG, WEBP) & video (MP4, MOV), tối đa 20MB mỗi tệp.</div>
                  </div>

                  <input type="file" id="fileInput" accept="image/*,video/*" multiple style="display:none;" />
                  <div id="uploadError" class="text-red-600 text-xs mt-2.5 font-bold" style="display:none;"></div>

                  <div class="media-grid" id="mediaPreview"></div>
                </div>

                <button type="submit" class="btn-submit-return w-full flex items-center justify-center gap-2.5 py-4 px-6 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 text-white font-extrabold text-[15.5px] shadow-lg shadow-indigo-600/20 transition-all duration-300" id="submitBtn">
                  <i class="hgi hgi-stroke hgi-sent text-xl"></i>
                  <span>Gửi yêu cầu hoàn trả & hoàn tiền</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    }

  </div>
</section>

<!-- Beautiful Lightbox Modal for Images and Videos -->
<div id="lightboxModal" class="custom-lightbox" onclick="closeLightbox()">
  <div class="lightbox-content" onclick="event.stopPropagation()">
    <button class="lightbox-close" onclick="closeLightbox()">✕</button>
    <div id="lightboxMediaContainer"></div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const fileInput = document.getElementById('fileInput');
  const uploadArea = document.getElementById('uploadArea');
  const mediaPreview = document.getElementById('mediaPreview');
  const mediaUrlsJsonInput = document.getElementById('mediaUrlsJson');
  const submitBtn = document.getElementById('submitBtn');
  const uploadError = document.getElementById('uploadError');
  const reasonInput = document.getElementById('reasonInput');
  const charCount = document.getElementById('charCount');

  let uploadedUrls = [];

  // Lightbox handles
  window.openLightbox = function(url, isVideo) {
    const modal = document.getElementById('lightboxModal');
    const container = document.getElementById('lightboxMediaContainer');
    if (!modal || !container) return;

    if (isVideo) {
      container.innerHTML = `<video src="${url}" controls autoplay style="max-width:100%; max-height:80vh; border-radius:12px;"></video>`;
    } else {
      container.innerHTML = `<img src="${url}" alt="Bằng chứng phóng to" />`;
    }
    
    modal.style.display = 'flex';
    setTimeout(() => {
      modal.classList.add('show');
    }, 10);
  };

  window.closeLightbox = function() {
    const modal = document.getElementById('lightboxModal');
    const container = document.getElementById('lightboxMediaContainer');
    if (!modal) return;
    
    modal.classList.remove('show');
    setTimeout(() => {
      modal.style.display = 'none';
      if (container) container.innerHTML = '';
    }, 300);
  };

  // Close lightbox on escape keypress
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeLightbox();
    }
  });

  // Char count
  if (reasonInput && charCount) {
    reasonInput.addEventListener('input', function() {
      charCount.textContent = this.value.length;
      if (this.value.length >= 450) {
        charCount.className = 'font-bold text-rose-500';
      } else {
        charCount.className = 'font-bold text-indigo-600';
      }
    });
  }

  if (!fileInput) return;

  // Drag and drop
  if (uploadArea) {
    uploadArea.addEventListener('dragover', function(e) {
      e.preventDefault();
      uploadArea.classList.add('dragover');
    });
    uploadArea.addEventListener('dragleave', function() {
      uploadArea.classList.remove('dragover');
    });
    uploadArea.addEventListener('drop', function(e) {
      e.preventDefault();
      uploadArea.classList.remove('dragover');
      const files = e.dataTransfer.files;
      if (files.length > 0) handleFiles(files);
    });
  }

  fileInput.addEventListener('change', function() {
    if (this.files.length > 0) handleFiles(this.files);
    this.value = '';
  });

  function handleFiles(files) {
    for (let i = 0; i < files.length; i++) {
      uploadFile(files[i]);
    }
  }

  function uploadFile(file) {
    if (file.size > 20 * 1024 * 1024) {
      showError('Tệp "' + file.name + '" quá dung lượng. Tối đa 20MB.');
      return;
    }

    // Create thumb placeholder
    const thumbId = 'thumb-' + Date.now() + '-' + Math.random().toString(36).substr(2, 6);
    const thumb = document.createElement('div');
    thumb.className = 'media-thumb';
    thumb.id = thumbId;
    thumb.innerHTML = `
      <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f5f3ff;">
        <div style="color:#4f46e5;font-size:12px;font-weight:700;" class="animate-pulse">Đang tải...</div>
      </div>
      <div class="upload-progress"><div class="upload-progress-bar" id="prog-${thumbId}" style="width:0%"></div></div>
    `;
    mediaPreview.appendChild(thumb);
    submitBtn.disabled = true;

    const formData = new FormData();
    formData.append('file', file);

    const xhr = new XMLHttpRequest();
    xhr.open('POST', '/my-orders/return/upload-media', true);

    xhr.upload.onprogress = function(e) {
      if (e.lengthComputable) {
        const pct = (e.loaded / e.total * 100).toFixed(0);
        const bar = document.getElementById('prog-' + thumbId);
        if (bar) bar.style.width = pct + '%';
      }
    };

    xhr.onload = function() {
      const el = document.getElementById(thumbId);
      if (xhr.status === 200) {
        const data = JSON.parse(xhr.responseText);
        const url = data.url;
        uploadedUrls.push(url);
        syncUrlsInput();

        const isVideo = /\.(mp4|mov|avi|webm)$/i.test(url);
        const mediaHtml = isVideo
          ? `<video src="${url}" controls style="width:100%;height:100%;object-fit:cover;"></video>`
          : `<img src="${url}" alt="Bằng chứng" loading="lazy" style="cursor:zoom-in;" onclick="openLightbox('${url}', false)" />`;

        el.innerHTML = `
          ${mediaHtml}
          <button type="button" class="remove-btn" onclick="removeMedia('${url}', '${thumbId}')">✕</button>
        `;
      } else {
        const err = JSON.parse(xhr.responseText);
        showError(err?.message || 'Lỗi tải tệp tin.');
        el.remove();
      }
      checkSubmitBtn();
    };

    xhr.onerror = function() {
      showError('Lỗi kết nối khi tải tệp tin.');
      const el = document.getElementById(thumbId);
      if (el) el.remove();
      checkSubmitBtn();
    };

    xhr.send(formData);
  }

  window.removeMedia = function(url, thumbId) {
    uploadedUrls = uploadedUrls.filter(u => u !== url);
    syncUrlsInput();
    const el = document.getElementById(thumbId);
    if (el) el.remove();
  };

  function syncUrlsInput() {
    mediaUrlsJsonInput.value = JSON.stringify(uploadedUrls);
  }

  function showError(msg) {
    if (!uploadError) return;
    uploadError.textContent = msg;
    uploadError.style.display = 'block';
    setTimeout(() => { uploadError.style.display = 'none'; }, 5000);
  }

  function checkSubmitBtn() {
    if (!submitBtn) return;
    submitBtn.disabled = false;
  }

  const returnForm = document.getElementById('returnForm');
  if (returnForm) {
    returnForm.addEventListener('submit', function(e) {
      const reason = reasonInput?.value?.trim();
      if (!reason) {
        e.preventDefault();
        showError('Vui lòng mô tả cụ thể lý do trả hàng.');
        reasonInput?.focus();
        return;
      }
      if (uploadedUrls.length === 0) {
        e.preventDefault();
        showError('Vui lòng tải lên ít nhất 1 ảnh hoặc video làm bằng chứng.');
        return;
      }
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>⏳ Đang gửi yêu cầu...</span>';
    });
  }
});
</script>
