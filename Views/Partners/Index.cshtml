  }

  #partner-ghn-address .nice-select .current {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  #partner-ghn-address .nice-select .list {
    max-height: 260px;
    overflow-y: auto;
    overflow-x: hidden;
    z-index: 9999;
  }
</style>

<script>
  window.togglePartnerTier = function (tier) {
    const isMall = (tier === 'Mall');
    const legalSec = document.getElementById('mall-legal-section');
    const lblStd = document.getElementById('lbl-tier-standard');
    const lblMall = document.getElementById('lbl-tier-mall');

    if (legalSec) legalSec.style.display = isMall ? 'flex' : 'none';
    if (lblStd) lblStd.classList.toggle('active-standard', !isMall);
    if (lblMall) lblMall.classList.toggle('active-mall', isMall);
  };

  (() => {
    const endpoints = {
      provinces: '/api/ghn/provinces',
      districts: (provinceId) => `/api/ghn/districts?provinceId=${encodeURIComponent(provinceId)}`,
      wards: (districtId) => `/api/ghn/wards?districtId=${encodeURIComponent(districtId)}`
    };

    const debugEl = document.getElementById('partner_ghn_debug');

    function hasQueryFlag(name) {
      try {
        const q = new URLSearchParams(window.location.search);
        if (!q.has(name)) return false;
        const v = (q.get(name) || '').trim().toLowerCase();
        return v === '' || v === '1' || v === 'true' || v === 'yes' || v === 'on';
      } catch {
        return false;
      }
    }

    const debugEnabled = hasQueryFlag('ghnDebug') || hasQueryFlag('ghnTest');

    function debugLine(message) {
      if (!debugEnabled || !(debugEl instanceof HTMLElement)) return;
      debugEl.classList.remove('hidden');
      const div = document.createElement('div');
      div.textContent = message;
      debugEl.appendChild(div);
    }

    debugLine('[GHN] Partner script started');

    let initPartnerFormRunning = false;
    function isEmptyOptions(select) {
      try {
        return !(select instanceof HTMLSelectElement) || select.options.length <= 1;
      } catch {
        return true;
      }
    }

    const cache = {
      provinces: null,
      districtsByProvince: new Map(),
      wardsByDistrict: new Map()
    };

    async function getJson(url) {
      debugLine(`GET ${url}`);
      const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
      if (!res.ok) {
        const text = await res.text();
        debugLine(`↳ HTTP ${res.status}: ${text ? text.slice(0, 120) : ''}`);
        throw new Error(text || `HTTP ${res.status}`);
      }
      const json = await res.json();
      if (!Array.isArray(json)) {
        debugLine('↳ ERROR: response is not an array');
        throw new Error('Unexpected GHN response shape');
      }
      if (Array.isArray(json)) {
        debugLine(`↳ OK (${json.length} items)`);
      } else {
        debugLine('↳ OK');
      }
      return json;
    }

    async function runGhnSmokeTest() {
      if (!debugEnabled) return;
      debugLine('[GHN] Smoke test: START');

      try {
        const provinces = await ensureProvincesLoaded();
        const p0 = Array.isArray(provinces) && provinces.length ? provinces[0] : null;
        debugLine(`[GHN] provinces: ${Array.isArray(provinces) ? provinces.length : 0} (sample: ${p0 ? `${p0.id} - ${p0.name}` : 'none'})`);

        const provinceId = p0 && p0.id ? parseInt(String(p0.id), 10) : 0;
        if (!provinceId) {
          debugLine('[GHN] Smoke test: STOP (no province id)');
          return;
        }

        const districts = await ensureDistrictsLoaded(provinceId);
        const d0 = Array.isArray(districts) && districts.length ? districts[0] : null;
        debugLine(`[GHN] districts (provinceId=${provinceId}): ${Array.isArray(districts) ? districts.length : 0} (sample: ${d0 ? `${d0.id} - ${d0.name}` : 'none'})`);

        const districtId = d0 && d0.id ? parseInt(String(d0.id), 10) : 0;
        if (!districtId) {
          debugLine('[GHN] Smoke test: STOP (no district id)');
          return;
        }

        const wards = await ensureWardsLoaded(districtId);
        const w0 = Array.isArray(wards) && wards.length ? wards[0] : null;
        debugLine(`[GHN] wards (districtId=${districtId}): ${Array.isArray(wards) ? wards.length : 0} (sample: ${w0 ? `${w0.code} - ${w0.name}` : 'none'})`);

        debugLine('[GHN] Smoke test: OK');
      } catch (e) {
        console.error(e);
        debugLine(`[GHN] Smoke test: FAILED -> ${(e && e.message) ? e.message : String(e)}`);
      }
    }

    function refreshNiceSelect(select) {
      const $ = window.jQuery;
      if (!$ || !$.fn || !$.fn.niceSelect) return;
      try {
        $(select).niceSelect('update');
      } catch {
        // ignore
      }
    }

    function bindChange(select, handler) {
      select.addEventListener('change', handler);
    }

    function attachNiceSelectChangeBridgeOnce() {
      if (window.__ghnNiceSelectBridgeAttached_partner) return;
      window.__ghnNiceSelectBridgeAttached_partner = true;

      document.addEventListener('click', (e) => {
        const raw = e.target;
        const el = (raw instanceof Element)
          ? raw
          : (raw && raw.parentElement ? raw.parentElement : null);
        if (!el) return;

        const opt = el.closest('.nice-select .option');
        if (!opt) return;

        const nice = opt.closest('.nice-select');
        const select = nice ? nice.previousElementSibling : null;
        if (!(select instanceof HTMLSelectElement)) return;

        // Scope only to GHN cascading selects to avoid side-effects.
        const id = select.id || '';
        if (!/^partner_(province|district|ward)$/.test(id)) return;

        // niceSelect updates the underlying <select> value on click;
        // defer dispatch so our handlers see the latest value.
        setTimeout(() => {
          try {
            select.dispatchEvent(new Event('change', { bubbles: true }));
          } catch {
            // ignore
          }
        }, 0);
      }, true);
    }

    function setOptions(select, items, valueKey, textKey, placeholder) {
      select.innerHTML = '';
      const opt0 = document.createElement('option');
      opt0.value = '';
      opt0.textContent = placeholder;
      select.appendChild(opt0);

      for (const it of items) {
        const opt = document.createElement('option');
        opt.value = String(it[valueKey]);
        opt.textContent = String(it[textKey]);
        select.appendChild(opt);
      }

      refreshNiceSelect(select);
    }

    function selectedText(select) {
      const i = select.selectedIndex;
      if (i < 0) return '';
      const opt = select.options[i];
      return opt ? (opt.textContent || '') : '';
    }

    function resetSelect(select, placeholder) {
      select.innerHTML = '';
      const opt0 = document.createElement('option');
      opt0.value = '';
      opt0.textContent = placeholder;
      select.appendChild(opt0);
      select.value = '';
      select.disabled = true;

      refreshNiceSelect(select);
    }

    function showLoadError(select, message) {
      if (!select) return;
      select.innerHTML = '';
      const opt0 = document.createElement('option');
      opt0.value = '';
      opt0.textContent = message;
      select.appendChild(opt0);
      select.value = '';
      select.disabled = true;

      refreshNiceSelect(select);
    }

    async function ensureProvincesLoaded() {
      if (cache.provinces) return cache.provinces;
      cache.provinces = await getJson(endpoints.provinces);
      return cache.provinces;
    }

    async function ensureDistrictsLoaded(provinceId) {
      const key = String(provinceId);
      if (cache.districtsByProvince.has(key)) return cache.districtsByProvince.get(key);
      const data = await getJson(endpoints.districts(provinceId));
      cache.districtsByProvince.set(key, data);
      return data;
    }

    async function ensureWardsLoaded(districtId) {
      const key = String(districtId);
      if (cache.wardsByDistrict.has(key)) return cache.wardsByDistrict.get(key);
      const data = await getJson(endpoints.wards(districtId));
      cache.wardsByDistrict.set(key, data);
      return data;
    }

    function wireCascading(prefix) {
      const province = document.getElementById(`${prefix}_province`);
      const district = document.getElementById(`${prefix}_district`);
      const ward = document.getElementById(`${prefix}_ward`);

      const provinceName = document.getElementById(`${prefix}_province_name`);
      const districtName = document.getElementById(`${prefix}_district_name`);
      const wardName = document.getElementById(`${prefix}_ward_name`);

      if (!province || !district || !ward || !provinceName || !districtName || !wardName) return;

      bindChange(province, async () => {
        provinceName.value = province.value ? selectedText(province) : '';
        districtName.value = '';
        wardName.value = '';
        resetSelect(district, 'Chọn Quận/Huyện');
        resetSelect(ward, 'Chọn Phường/Xã');

        const provinceId = parseInt(province.value || '0', 10);
        if (!provinceId) return;

        try {
          const districts = await ensureDistrictsLoaded(provinceId);
          setOptions(district, districts, 'id', 'name', 'Chọn Quận/Huyện');
          district.disabled = false;
          refreshNiceSelect(district);
        } catch (e) {
          console.error(e);
          showLoadError(district, 'Không tải được Quận/Huyện. Kiểm tra GHN Token.');
        }
      });

      bindChange(district, async () => {
        districtName.value = district.value ? selectedText(district) : '';
        wardName.value = '';
        resetSelect(ward, 'Chọn Phường/Xã');

        const districtId = parseInt(district.value || '0', 10);
        if (!districtId) return;

        try {
          const wards = await ensureWardsLoaded(districtId);
          setOptions(ward, wards, 'code', 'name', 'Chọn Phường/Xã');
          ward.disabled = false;
          refreshNiceSelect(ward);
        } catch (e) {
          console.error(e);
          showLoadError(ward, 'Không tải được Phường/Xã. Kiểm tra GHN Token.');
        }
      });

      bindChange(ward, () => {
        wardName.value = ward.value ? selectedText(ward) : '';
      });
    }

    async function initPartnerForm() {
      if (initPartnerFormRunning) return;
      initPartnerFormRunning = true;

      const province = document.getElementById('partner_province');
      const district = document.getElementById('partner_district');
      const ward = document.getElementById('partner_ward');
      const provinceNameEl = document.getElementById('partner_province_name');
      const districtNameEl = document.getElementById('partner_district_name');
      const wardNameEl = document.getElementById('partner_ward_name');

      if (!province || !district || !ward || !provinceNameEl || !districtNameEl || !wardNameEl) {
        initPartnerFormRunning = false;
        return;
      }

      const provinceId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProvinceId));
      const districtId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DistrictId));
      const wardCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WardCode ?? string.Empty));

      debugLine(`[GHN] initial ids provinceId=${provinceId} districtId=${districtId} wardCode=${wardCode}`);

      try {
        const provinces = await ensureProvincesLoaded();
        if (!Array.isArray(provinces) || provinces.length === 0) {
          showLoadError(province, 'Không tải được Tỉnh/Thành phố. Kiểm tra GHN Token.');
          debugLine('[GHN] provinces empty');
          resetSelect(district, 'Chọn Quận/Huyện');
          resetSelect(ward, 'Chọn Phường/Xã');
          initPartnerFormRunning = false;
          return;
        }
        setOptions(province, provinces, 'id', 'name', 'Chọn Tỉnh/Thành phố');
        debugLine('Rendered provinces options');
        province.disabled = false;
        refreshNiceSelect(province);

        resetSelect(district, 'Chọn Quận/Huyện');
        resetSelect(ward, 'Chọn Phường/Xã');

        province.value = provinceId ? String(provinceId) : '';
        provinceNameEl.value = province.value ? selectedText(province) : (provinceNameEl.value || '');
        refreshNiceSelect(province);

        if (provinceId) {
          const districts = await ensureDistrictsLoaded(provinceId);
          setOptions(district, districts, 'id', 'name', 'Chọn Quận/Huyện');
          district.disabled = false;
          refreshNiceSelect(district);
          district.value = districtId ? String(districtId) : '';
          districtNameEl.value = district.value ? selectedText(district) : (districtNameEl.value || '');
          refreshNiceSelect(district);
        }

        if (districtId) {
          const wards = await ensureWardsLoaded(districtId);
          setOptions(ward, wards, 'code', 'name', 'Chọn Phường/Xã');
          ward.disabled = false;
          refreshNiceSelect(ward);
          ward.value = wardCode || '';
          wardNameEl.value = ward.value ? selectedText(ward) : (wardNameEl.value || '');
          refreshNiceSelect(ward);
        }
      } catch (e) {
        console.error(e);
        showLoadError(province, 'Không tải được Tỉnh/Thành phố. Kiểm tra GHN Token.');
        debugLine(`ERROR: ${(e && e.message) ? e.message : String(e)}`);
        resetSelect(district, 'Chọn Quận/Huyện');
        resetSelect(ward, 'Chọn Phường/Xã');
      } finally {
        initPartnerFormRunning = false;
      }
    }

    // Wire cascading once
    attachNiceSelectChangeBridgeOnce();
    wireCascading('partner');

    // Load provinces eagerly so the form works immediately.
    initPartnerForm();

    // After all vendor scripts load, ensure niceSelect reflects the latest options.
    window.addEventListener('load', () => {
      try {
        const province = document.getElementById('partner_province');
        const district = document.getElementById('partner_district');
        const ward = document.getElementById('partner_ward');
        if (province) refreshNiceSelect(province);
        if (district) refreshNiceSelect(district);
        if (ward) refreshNiceSelect(ward);

        // If provinces didn't load due to race/network, retry once after page load.
        if (province instanceof HTMLSelectElement && isEmptyOptions(province)) {
          initPartnerForm();
        }
      } catch {
        // ignore
      }
    });

    // Lazy-load provinces if the user opens the dropdown and it's still empty.
    document.addEventListener('click', (e) => {
      const raw = e.target;
      const el = (raw instanceof Element)
        ? raw
        : (raw && raw.parentElement ? raw.parentElement : null);
      if (!el) return;

      const nice = el.closest('.nice-select');
      if (!nice) return;

      const select = nice.previousElementSibling;
      if (!(select instanceof HTMLSelectElement)) return;
      if (select.id !== 'partner_province') return;

      if (isEmptyOptions(select)) {
        initPartnerForm();
      }
    }, true);

    // Optional smoke test for debugging: /doi-tac?ghnTest=1
    if (hasQueryFlag('ghnTest')) {
      runGhnSmokeTest();
    }
  })();
</script>

