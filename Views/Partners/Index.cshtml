@model PartnerRegisterVm
@{
    ViewData["Title"] = "Đối tác";
    var isSignedIn = User?.Identity?.IsAuthenticated ?? false;
}

@section Styles {
  <style>
    /* ========== PREMIUM PARTNER REGISTRATION UI ========== */
    .pt-hero-banner {
      background: radial-gradient(circle at 88% 18%, rgba(255, 235, 105, 0.16) 0%, transparent 46%),
                  linear-gradient(135deg, #00262A 0%, #034147 58%, #088178 100%);
      border-radius: 28px;
      padding: 36px 40px;
      margin-bottom: 34px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      color: #ffffff;
      box-shadow: 0 22px 46px -18px rgba(0, 38, 42, 0.36);
      position: relative;
      overflow: hidden;
    }
    @@media (max-width: 767px) {
      .pt-hero-banner { padding: 24px 20px; border-radius: 22px; }
    }
    .pt-crumb {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.72);
      margin-bottom: 10px;
    }
    .pt-crumb a { color: rgba(255, 255, 255, 0.88); transition: color 0.2s; }
    .pt-crumb a:hover { color: #FFEB69; }
    .pt-hero-title {
      font-size: clamp(26px, 2.8vw, 36px);
      font-weight: 800;
      color: #ffffff;
      line-height: 1.2;
      letter-spacing: -0.02em;
      margin: 0 0 8px 0;
    }
    .pt-hero-title span { color: #FFEB69; }
    .pt-hero-sub {
      font-size: 14.5px;
      line-height: 1.65;
      color: rgba(255, 255, 255, 0.84);
      margin: 0;
      max-width: 580px;
    }
    .pt-hero-stats {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .pt-stat-glass {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 18px;
      padding: 12px 18px;
      color: #ffffff;
    }
    .pt-stat-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background-color: rgba(255, 235, 105, 0.18);
      color: #FFEB69;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }

    .pt-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background-color: #E6F4F3;
      color: #088178;
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 5px 13px;
      border-radius: 999px;
      margin-bottom: 10px;
    }

    /* Tier Comparison Cards */
    .pt-tier-compare-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    @@media (max-width: 767px) {
      .pt-tier-compare-grid { grid-template-columns: 1fr; }
    }
    .pt-tier-info-card {
      background: #ffffff;
      border: 1.5px solid #E2E8F0;
      border-radius: 24px;
      padding: 24px 22px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      box-shadow: 0 10px 28px -14px rgba(22, 28, 36, 0.08);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .pt-tier-info-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 34px -14px rgba(22, 28, 36, 0.12);
    }
    .pt-tier-info-card.is-mall {
      background: radial-gradient(circle at 90% 10%, rgba(255, 235, 105, 0.14) 0%, transparent 45%),
                  linear-gradient(155deg, #00262A 0%, #033E44 60%, #065B5E 100%);
      border-color: #088178;
      color: #ffffff;
      box-shadow: 0 20px 40px -14px rgba(0, 38, 42, 0.38);
      position: relative;
    }
    .pt-tier-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11.5px;
      font-weight: 800;
      padding: 5px 12px;
      border-radius: 999px;
      align-self: flex-start;
    }
    .pt-tier-sec-title {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 6px;
    }
    .pt-tier-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 7px;
      font-size: 12.5px;
      line-height: 1.5;
    }
    .pt-tier-list li {
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }
    .pt-tier-list li i {
      flex-shrink: 0;
      font-size: 15px;
    }

    /* Step Cards */
    .pt-step-card {
      background-color: #ffffff;
      border: 1px solid #E5E7EB;
      border-radius: 20px;
      padding: 20px 18px;
      height: 100%;
      position: relative;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .pt-step-card:hover {
      transform: translateY(-3px);
      border-color: #088178;
      box-shadow: 0 14px 28px -12px rgba(8, 129, 120, 0.16);
    }
    .pt-step-icon {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      background-color: #E6F4F3;
      color: #088178;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      margin-bottom: 12px;
    }
    .pt-step-num {
      position: absolute;
      top: 16px;
      right: 18px;
      font-size: 12px;
      font-weight: 800;
      color: #CBD5E1;
    }

    /* Benefit Strip */
    .pt-benefit-strip {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 20px;
    }
    @@media (max-width: 639px) {
      .pt-benefit-strip { grid-template-columns: 1fr; }
    }
    .pt-benefit-item {
      background-color: #ffffff;
      border: 1px solid #E5E7EB;
      border-radius: 18px;
      padding: 16px 14px;
      text-align: center;
      box-shadow: 0 6px 16px -10px rgba(22, 28, 36, 0.08);
    }
    .pt-benefit-ic {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      margin-bottom: 8px;
    }

    /* Form Card */
    .pt-form-card {
      background-color: #ffffff;
      border: 1px solid #E2E8F0;
      border-radius: 26px;
      overflow: hidden;
      box-shadow: 0 22px 46px -18px rgba(22, 28, 36, 0.14);
      position: sticky;
      top: 90px;
    }
    .pt-form-head {
      background: radial-gradient(circle at 90% 20%, rgba(255, 235, 105, 0.18) 0%, transparent 50%),
                  linear-gradient(135deg, #00262A 0%, #055A5B 100%);
      padding: 26px 30px;
      color: #ffffff;
    }
    .pt-form-head h4 {
      color: #ffffff;
      font-size: 21px;
      font-weight: 800;
      margin: 0 0 6px 0;
    }
    .pt-form-head p {
      color: rgba(255, 255, 255, 0.82);
      font-size: 13.5px;
      margin: 0;
    }
    .pt-sec-heading {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 4px;
    }
    .pt-sec-num {
      width: 24px;
      height: 24px;
      border-radius: 8px;
      background-color: #E6F4F3;
      color: #088178;
      font-size: 12px;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* Radio selector inside form */
    .pt-tier-choice-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    @@media (max-width: 575px) {
      .pt-tier-choice-grid { grid-template-columns: 1fr; }
    }
    .pt-tier-choice {
      border: 2px solid #E2E8F0;
      border-radius: 18px;
      padding: 16px;
      cursor: pointer;
      background-color: #F8FAFC;
      transition: all 0.22s ease;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .pt-tier-choice:hover {
      border-color: #94A3B8;
      background-color: #ffffff;
    }
    .pt-tier-choice.active-standard {
      border-color: #088178;
      background-color: #F0FAF9;
      box-shadow: 0 10px 22px -10px rgba(8, 129, 120, 0.28);
    }
    .pt-tier-choice.active-mall {
      border-color: #D97706;
      background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
      box-shadow: 0 10px 22px -10px rgba(217, 119, 6, 0.28);
    }
    .pt-choice-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 4px;
    }
    .pt-choice-left {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }
    .pt-choice-icon {
      width: 28px;
      height: 28px;
      border-radius: 9px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      flex-shrink: 0;
    }
    .pt-choice-icon.is-std {
      background-color: #E6F4F3;
      color: #088178;
    }
    .pt-choice-icon.is-mall {
      background-color: #FEF3C7;
      color: #B45309;
    }
    .pt-choice-name {
      font-size: 15px;
      font-weight: 800;
      color: #161C24;
      line-height: 1.25;
      letter-spacing: -0.01em;
    }
    .pt-choice-tag {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 999px;
      white-space: nowrap;
      flex-shrink: 0;
      line-height: 1.3;
    }
    .pt-choice-tag.is-std {
      background-color: #E6F4F3;
      color: #088178;
    }
    .pt-choice-tag.is-mall {
      background-color: #FEF3C7;
      color: #92400E;
    }
    .pt-choice-desc {
      font-size: 12.5px;
      line-height: 1.5;
      color: #475569;
    }
    .pt-choice-radio {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 2px solid #CBD5E1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }
    .pt-tier-choice.active-standard .pt-choice-radio {
      border-color: #088178;
      background-color: #088178;
      box-shadow: inset 0 0 0 3px #ffffff;
    }
    .pt-tier-choice.active-mall .pt-choice-radio {
      border-color: #B45309;
      background-color: #B45309;
      box-shadow: inset 0 0 0 3px #ffffff;
    }
    .pt-submit-btn {
      background: linear-gradient(135deg, #088178 0%, #055A5B 100%);
      color: #ffffff;
      border: none;
      border-radius: 999px;
      padding: 14px 24px;
      font-size: 15px;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      box-shadow: 0 14px 26px -10px rgba(8, 129, 120, 0.45);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      cursor: pointer;
    }
    .pt-submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 30px -10px rgba(8, 129, 120, 0.55);
      color: #ffffff;
    }

    /* Achievements (Những điều bạn đạt được) */
    .pt-ach-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
    @@media (max-width: 1199px) {
      .pt-ach-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 639px) {
      .pt-ach-grid { grid-template-columns: 1fr; }
    }
    .pt-ach-card {
      background: #ffffff;
      border: 1px solid #E5E7EB;
      border-radius: 22px;
      padding: 26px 22px;
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: 0 10px 28px -16px rgba(22, 28, 36, 0.1);
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .pt-ach-card:hover {
      transform: translateY(-4px);
      border-color: #088178;
      box-shadow: 0 18px 34px -14px rgba(8, 129, 120, 0.18);
    }
    .pt-ach-ic {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
    }
    .pt-ach-title {
      font-size: 16.5px;
      font-weight: 800;
      color: #161C24;
      line-height: 1.35;
      margin: 0;
    }
    .pt-ach-desc {
      font-size: 13.5px;
      line-height: 1.6;
      color: #475569;
      margin: 0;
    }
    .pt-ach-bullets {
      list-style: none;
      padding: 12px 0 0 0;
      margin: auto 0 0 0;
      border-top: 1px solid #F1F5F9;
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 12.5px;
      color: #334155;
    }
    .pt-ach-bullets li {
      display: flex;
      align-items: flex-start;
      gap: 7px;
    }
    .pt-ach-bullets li i {
      color: #088178;
      font-size: 14px;
      margin-top: 2px;
      flex-shrink: 0;
    }

    /* Roadmap (4 Bước để bắt đầu) */
    .pt-roadmap-wrap {
      background: linear-gradient(135deg, #F8FAFC 0%, #F1F8F7 100%);
      border: 1px solid #E2E8F0;
      border-radius: 30px;
      padding: 48px 34px;
    }
    @@media (max-width: 767px) {
      .pt-roadmap-wrap { padding: 32px 18px; border-radius: 22px; }
    }
    .pt-roadmap-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }
    @@media (max-width: 1199px) {
      .pt-roadmap-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (max-width: 639px) {
      .pt-roadmap-grid { grid-template-columns: 1fr; }
    }
    .pt-roadmap-card {
      background: #ffffff;
      border: 1px solid #E5E7EB;
      border-radius: 22px;
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .pt-roadmap-card:hover {
      transform: translateY(-4px);
      border-color: #088178;
      box-shadow: 0 16px 30px -14px rgba(8, 129, 120, 0.16);
    }
    .pt-roadmap-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 4px;
    }
    .pt-roadmap-badge {
      display: inline-flex;
      align-items: center;
      font-size: 11.5px;
      font-weight: 800;
      color: #ffffff;
      background-color: #088178;
      padding: 4px 12px;
      border-radius: 999px;
      letter-spacing: 0.03em;
    }
    .pt-roadmap-ic {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background-color: #E6F4F3;
      color: #088178;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    .pt-roadmap-title {
      font-size: 16px;
      font-weight: 800;
      color: #161C24;
      margin: 0;
      line-height: 1.35;
    }
    .pt-roadmap-desc {
      font-size: 13px;
      line-height: 1.6;
      color: #475569;
      margin: 0;
    }
    .pt-roadmap-note {
      margin-top: auto;
      padding-top: 10px;
      border-top: 1px dashed #E2E8F0;
      font-size: 12px;
      font-weight: 600;
      color: #088178;
      display: flex;
      align-items: center;
      gap: 6px;
    }
  </style>
}

<!-- ========== Top Hero Banner Start ========== -->
<div class="container pt-6">
  <div class="pt-hero-banner">
    <div>
      <nav class="pt-crumb">
        <a href='@Url.Action("Index", "Home")'><i class="hgi hgi-stroke hgi-home-01 mr-1"></i>Trang chủ</a>
        <span>/</span>
        <span style="color: #FFEB69; font-weight: 700;">Đối tác bán hàng</span>
      </nav>
      <h1 class="pt-hero-title">
        Trở Thành Đối Tác Bán Hàng Cùng <span>Sellzy</span>
      </h1>
      <p class="pt-hero-sub">
        Mở gian hàng trực tuyến chỉ trong vài phút, lựa chọn linh hoạt giữa <strong>Shop Thường</strong> và <strong>Sellzy Mall</strong>, vận hành tự động qua Giao Hàng Nhanh (GHN).
      </p>
    </div>
    <div class="pt-hero-stats">
      <div class="pt-stat-glass">
        <span class="pt-stat-icon"><i class="hgi hgi-stroke hgi-store-04"></i></span>
        <div>
          <div class="text-lg font-extrabold leading-tight" style="color: #FFEB69;">0đ</div>
          <div class="text-xs" style="color: rgba(255,255,255,0.8);">Phí mở gian hàng</div>
        </div>
      </div>
      <div class="pt-stat-glass">
        <span class="pt-stat-icon"><i class="hgi hgi-stroke hgi-clock-01"></i></span>
        <div>
          <div class="text-lg font-extrabold leading-tight" style="color: #ffffff;">24h</div>
          <div class="text-xs" style="color: rgba(255,255,255,0.8);">Thẩm định &amp; duyệt đơn</div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- ========== Top Hero Banner End ========== -->

<!-- ========== Partner Hero + Form Start ========== -->
<section class="pb-[70px]">
  <div class="container">
    <div class="grid grid-cols-12 gap-x-[30px] gap-y-10 items-start">
      <div class="lg:col-span-6 col-span-12">
        <div class="mb-6">
          <span class="pt-eyebrow"><i class="hgi hgi-stroke hgi-sparkles"></i> 2 Mô hình Gian hàng</span>
          <h3 class="text-2xl font-extrabold text-light-primary-text mb-2">Chọn Hạng Gian Hàng Phù Hợp Với Bạn</h3>
          <p class="text-sm text-light-secondary-text mb-5">
            Bạn có thể khởi đầu nhanh với <strong>Shop Thường</strong> (và nâng cấp lên Mall sau khi đủ chỉ số vận hành) hoặc đăng ký thẳng <strong>Sellzy Mall</strong> nếu có đầy đủ pháp lý thương hiệu.
          </p>

          <!-- Bảng so sánh 2 lựa chọn: Yêu cầu, Chi phí, Đặc quyền -->
          <div class="pt-tier-compare-grid">
            <!-- Lựa chọn 1: Shop Thường -->
            <div class="pt-tier-info-card">
              <span class="pt-tier-badge" style="background: #E6F4F3; color: #088178;">
                <i class="hgi hgi-stroke hgi-store-02"></i> Lựa chọn 1 • Shop Thường
              </span>
              <div>
                <div class="text-lg font-extrabold text-light-primary-text">Gian Hàng Tiêu Chuẩn</div>
                <div class="text-xs text-light-secondary-text">Dành cho cá nhân, hộ kinh doanh &amp; cửa hàng nhỏ lẻ</div>
              </div>

              <div class="border-t border-gray-100 pt-2.5">
                <div class="pt-tier-sec-title" style="color: #088178;">1. Yêu cầu hồ sơ</div>
                <ul class="pt-tier-list text-light-secondary-text">
                  <li><i class="hgi hgi-stroke hgi-checkmark-circle-02 text-primary mt-0.5"></i> <span>Thông tin liên hệ (Họ tên, Email, SĐT xác thực).</span></li>
                  <li><i class="hgi hgi-stroke hgi-checkmark-circle-02 text-primary mt-0.5"></i> <span>Địa chỉ kho lấy hàng chuẩn GHN.</span></li>
                  <li><i class="hgi hgi-stroke hgi-checkmark-circle-02 text-primary mt-0.5"></i> <span><strong>Không yêu cầu</strong> Giấy phép ĐKKD doanh nghiệp.</span></li>
                </ul>
              </div>

              <div class="border-t border-gray-100 pt-2.5">
                <div class="pt-tier-sec-title" style="color: #B45309;">2. Biểu phí &amp; Chiết khấu</div>
                <ul class="pt-tier-list text-light-secondary-text">
                  <li><i class="hgi hgi-stroke hgi-coins-01 text-warning mt-0.5"></i> <span><strong>Phí mở shop:</strong> 0đ (Miễn phí duy trì).</span></li>
                  <li><i class="hgi hgi-stroke hgi-coins-01 text-warning mt-0.5"></i> <span><strong>Chiết khấu sàn:</strong> Phí ngành hàng cơ bản (<strong>4% – 10%</strong>).</span></li>
                  <li><i class="hgi hgi-stroke hgi-coins-01 text-warning mt-0.5"></i> <span><strong>Thuế khấu trừ tại nguồn:</strong> <strong>1.5%</strong> (1% GTGT + 0.5% TNCN cá nhân).</span></li>
                </ul>
              </div>

              <div class="border-t border-gray-100 pt-2.5">
                <div class="pt-tier-sec-title" style="color: #161C24;">3. Quyền lợi &amp; Nâng cấp</div>
                <ul class="pt-tier-list text-light-secondary-text">
