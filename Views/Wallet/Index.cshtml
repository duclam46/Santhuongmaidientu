@model DOAN_BANHANG.ViewModels.WalletIndexVm

@{
    ViewData["Title"] = "Số dư tài khoản";

    string FormatVnd(decimal amount) => string.Format("{0:N0}đ", amount);

    string GetTxnTypeLabel(string type) => type switch
    {
        "DEPOSIT"  => "Nạp tiền",
        "PAYMENT"  => "Thanh toán đơn hàng",
        "REFUND"   => "Hoàn tiền đơn hủy",
        "CASHBACK" => "Thưởng hoàn tiền",
        _          => type
    };

    string GetTxnTypeIcon(string type) => type switch
    {
        "DEPOSIT"  => "hgi-add-circle",
        "PAYMENT"  => "hgi-shopping-bag-01",
        "REFUND"   => "hgi-money-receive-01",
        "CASHBACK" => "hgi-gift-card",
        _          => "hgi-information-circle"
    };

    string GetTxnColorClass(string type) => type switch
    {
        "DEPOSIT"  or "REFUND" or "CASHBACK" => "text-green-600",
        "PAYMENT"  => "text-red-500",
        _          => "text-gray-500"
    };

    string GetTxnBgClass(string type) => type switch
    {
        "DEPOSIT"  or "REFUND" or "CASHBACK" => "bg-green-50",
        "PAYMENT"  => "bg-red-50",
        _          => "bg-gray-50"
    };
}

<style>
/* ─── Wallet Page Styles ─── */
.wallet-hero {
    background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 50%, #7c3aed 100%);
    border-radius: 24px;
    padding: 36px 32px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 60px -10px rgba(37, 99, 235, 0.4);
}

.wallet-hero::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
}

.wallet-hero::after {
    content: '';
    position: absolute;
    bottom: -80px;
    left: -40px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: rgba(255,255,255,0.04);
}

.wallet-balance-label {
    color: rgba(255,255,255,0.7);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 8px;
}

.wallet-balance-amount {
    font-size: 42px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 4px;
}

.wallet-balance-currency {
    font-size: 22px;
    font-weight: 600;
    color: rgba(255,255,255,0.8);
    vertical-align: super;
    font-size: 20px;
    margin-left: 2px;
}

.wallet-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.15);
    border-radius: 100px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255,255,255,0.95);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.2);
}

.wallet-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px rgba(74, 222, 128, 0.8);
    animation: statusPulse 2s infinite;
}

@@keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.3); }
}

.topup-form-wrapper {
    background: #fff;
    border-radius: 20px;
    border: 1.5px solid #e2e8f0;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}

.topup-presets {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 16px;
}

.topup-preset-btn {
    padding: 10px 8px;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    background: #f8fafc;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
}

.topup-preset-btn:hover,
.topup-preset-btn.active {
    border-color: #2563eb;
    background: #eff6ff;
    color: #2563eb;
}

.topup-input-wrapper {
    position: relative;
}

.topup-input-wrapper input {
    width: 100%;
    padding: 14px 60px 14px 20px;
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 600;
    color: #0f172a;
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
    background: #f8fafc;
}

.topup-input-wrapper input:focus {
    border-color: #2563eb;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
}

.topup-input-suffix {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 15px;
    font-weight: 700;
    color: #64748b;
}

.topup-submit-btn {
    width: 100%;
    padding: 16px;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    border: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 16px;
    box-shadow: 0 4px 15px rgba(37,99,235,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.topup-submit-btn:hover {
    box-shadow: 0 8px 25px rgba(37,99,235,0.4);
    transform: translateY(-1px);
}

.topup-submit-btn:active {
    transform: translateY(0);
}

/* Transaction History */
.txn-list {
    display: flex;
    flex-direction: column;
    gap: 0;
}

.txn-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.15s;
}

.txn-item:last-child {
    border-bottom: none;
}

.txn-icon {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 22px;
}

.txn-info {
    flex: 1;
    min-width: 0;
}

.txn-type {
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 2px;
}

.txn-ref {
    font-size: 12px;
    color: #94a3b8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.txn-meta {
    text-align: right;
    flex-shrink: 0;
}

.txn-amount {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 2px;
}

.txn-date {
    font-size: 12px;
    color: #94a3b8;
}

.txn-balance-after {
    font-size: 11px;
    color: #b0b8c8;
}

.txn-amount-positive {
    color: #10b981 !important; /* Emerald Green */
}
.txn-amount-negative {
    color: #ef4444 !important; /* Red */
}
.txn-color-positive {
    color: #10b981 !important;
}
.txn-bg-positive {
    background: #ecfdf5 !important;
}
.txn-color-negative {
    color: #ef4444 !important;
}
.txn-bg-negative {
    background: #fef2f2 !important;
}

/* Pagination */
.wallet-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding-top: 20px;
}

.wallet-pagination a,
.wallet-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    border: 1.5px solid #e2e8f0;
    color: #334155;
    text-decoration: none;
    transition: all 0.2s;
}

.wallet-pagination a:hover {
    border-color: #2563eb;
    color: #2563eb;
    background: #eff6ff;
}

.wallet-pagination .active-page {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: white;
    border-color: transparent;
    box-shadow: 0 4px 10px rgba(37,99,235,0.3);
}

/* ─── Attendance Feature CSS ─── */
.attendance-card {
    background: linear-gradient(135deg, #ffb800 0%, #ff5722 100%);
    border-radius: 24px;
    padding: 26px;
    color: white;
    box-shadow: 0 12px 36px -4px rgba(255, 87, 34, 0.35);
    position: relative;
    overflow: hidden;
}

.attendance-card::before {
    content: '';
    position: absolute;
    top: -50px;
    left: -50px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
}

.attendance-title-tag {
    background: rgba(255, 255, 255, 0.95);
    color: #ff5722;
    font-size: 15px;
    font-weight: 850;
    padding: 6px 20px;
    border-radius: 100px;
    display: inline-block;
    box-shadow: 0 4px 12px rgba(255, 87, 34, 0.15);
    letter-spacing: 0.03em;
}

.attendance-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;
    margin: 22px 0;
}

.attendance-day-box {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 16px;
    padding: 12px 4px;
    text-align: center;
    color: #334155;
    position: relative;
    border: 2px solid transparent;
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    min-height: 106px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.03);
}

.attendance-day-box.claimed {
    background: rgba(255, 255, 255, 0.55);
    color: #94a3b8;
    box-shadow: none;
}

.attendance-day-box.claimable {
    border-color: #ff3d00;
    animation: claimablePulse 1.6s infinite ease-in-out;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(255, 255, 255, 0.15);
}

.attendance-day-box.claimable:hover {
    transform: translateY(-2px);
    background: #ffffff;
}

.attendance-day-box.locked {
    opacity: 0.85;
}

.attendance-day-box .bonus-tag {
    position: absolute;
    top: -8px;
    background: #ff3d00;
    color: white;
    font-size: 9px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 100px;
    box-shadow: 0 2px 6px rgba(255, 61, 0, 0.3);
}

.attendance-coin-icon {
    font-size: 24px;
    margin: 6px 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
}

.attendance-day-box.claimable:hover .attendance-coin-icon {
    transform: scale(1.18);
}

.attendance-btn {
    width: 100%;
    padding: 15px;
    background: #ffffff;
    color: #ff5722;
    border: none;
    border-radius: 16px;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.attendance-btn:hover {
    background: #fff6f2;
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    color: #ff3d00;
}

.attendance-btn:active {
    transform: translateY(0);
}

.attendance-btn:disabled {
    background: rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.85);
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none;
}

@@keyframes claimablePulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.04); }
}
</style>

<!-- Breadcrumb -->
<div class="container py-12">
    <div class="breadcrumb">
        <ul>
            <li>
                <a href="@Url.Action("Index", "Home")">
                    <span class="inline-flex items-center justify-center">
                        <i class="hgi hgi-stroke hgi-home-01 text-2xl leading-6"></i>
                    </span>
                    Home
                </a>
            </li>
            <li class="text-light-disabled-text">&#8226;</li>
            <li><span class="text-sm leading-[22px]">Số dư tài khoản</span></li>
        </ul>
    </div>
</div>

<section class="pb-[90px]">
    <div class="container">

        @if (TempData["WalletSuccess"] is string okMsg && !string.IsNullOrWhiteSpace(okMsg))
        {
            <!-- Centered Success Modal Popup -->
            <div id="walletSuccessAlert" class="wallet-popup-overlay" style="display: none;" onclick="dismissAlert('walletSuccessAlert')">
                <div class="wallet-popup-card" onclick="event.stopPropagation()">
                    <div class="wallet-popup-icon success">
                        <i class="hgi hgi-stroke hgi-tick-02" style="font-size: 36px !important; color: #ffffff !important;"></i>
                    </div>
                    <h4 class="wallet-popup-title success">GIAO DỊCH THÀNH CÔNG</h4>
                    <div class="wallet-popup-divider"></div>
                    <p class="wallet-popup-message">@okMsg</p>
                    <p class="wallet-popup-sub">Số dư mới đã được cộng vào tài khoản của bạn. Chúc bạn có những trải nghiệm mua sắm tuyệt vời!</p>
                    <button class="wallet-popup-btn success" onclick="dismissAlert('walletSuccessAlert')">Tuyệt vời! Đã hiểu</button>
                </div>
            </div>
        }
        @if (TempData["WalletError"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
        {
            <!-- Centered Error Modal Popup -->
            <div id="walletErrorAlert" class="wallet-popup-overlay" style="display: none;" onclick="dismissAlert('walletErrorAlert')">
                <div class="wallet-popup-card" onclick="event.stopPropagation()">
                    <div class="wallet-popup-icon error">
                        <i class="hgi hgi-stroke hgi-alert-circle" style="font-size: 36px !important; color: #ffffff !important;"></i>
                    </div>
                    <h4 class="wallet-popup-title error">GIAO DỊCH THẤT BẠI</h4>
                    <div class="wallet-popup-divider"></div>
                    <p class="wallet-popup-message">@errMsg</p>
                    <p class="wallet-popup-sub">Đã xảy ra sự cố trong quá trình giao dịch. Vui lòng kiểm tra lại tài khoản hoặc thử lại sau.</p>
                    <button class="wallet-popup-btn error" onclick="dismissAlert('walletErrorAlert')">Đã hiểu</button>
                </div>
            </div>
        }

        <style>
            /* ─── Premium Centered Modal Popup Styles ─── */
            .wallet-popup-overlay {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: 100vw !important;
                height: 100vh !important;
                background: rgba(15, 23, 42, 0.6) !important;
                backdrop-filter: blur(8px) !important;
                -webkit-backdrop-filter: blur(8px) !important;
                z-index: 999999 !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                opacity: 0 !important;
                transition: opacity 0.4s ease !important;
            }
            .wallet-popup-overlay.show {
                opacity: 1 !important;
            }
            .wallet-popup-card {
                background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%) !important;
                padding: 40px 36px !important;
                border-radius: 28px !important;
                max-width: 440px !important;
                width: 90% !important;
                box-shadow: 0 30px 70px -15px rgba(15, 23, 42, 0.3) !important;
                border: 1px solid rgba(255, 255, 255, 0.8) !important;
                text-align: center !important;
                transform: scale(0.85) translateY(20px) !important;
                transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
            }
            .wallet-popup-overlay.show .wallet-popup-card {
                transform: scale(1) translateY(0) !important;
            }
            .wallet-popup-icon {
                width: 72px !important;
                height: 72px !important;
                border-radius: 50% !important;
                margin: 0 auto 20px auto !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                font-size: 32px !important;
                font-weight: bold !important;
                color: #ffffff !important;
            }
            .wallet-popup-icon.success {
                background: #22c55e !important;
                box-shadow: 0 10px 25px rgba(34, 197, 94, 0.35) !important;
                animation: popIconScale 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
            }
            .wallet-popup-icon.error {
                background: #ef4444 !important;
                box-shadow: 0 10px 25px rgba(239, 68, 68, 0.35) !important;
            }
            .wallet-popup-title {
                font-size: 16px !important;
                font-weight: 850 !important;
                letter-spacing: 0.08em !important;
                margin: 0 0 12px 0 !important;
            }
            .wallet-popup-title.success {
                color: #16a34a !important;
            }
            .wallet-popup-title.error {
                color: #dc2626 !important;
            }
            .wallet-popup-divider {
                width: 40px !important;
                height: 3px !important;
                background: #e2e8f0 !important;
                border-radius: 9999px !important;
                margin: 0 auto 16px auto !important;
            }
            .wallet-popup-message {
                font-size: 19px !important;
                font-weight: 800 !important;
                color: #0f172a !important;
                line-height: 1.3 !important;
                margin: 0 0 10px 0 !important;
            }
            .wallet-popup-sub {
                font-size: 13px !important;
                font-weight: 500 !important;
                color: #64748b !important;
                line-height: 1.5 !important;
                margin: 0 0 28px 0 !important;
            }
            .wallet-popup-btn {
                width: 100% !important;
                padding: 15px !important;
                border: none !important;
                border-radius: 16px !important;
                font-size: 15px !important;
                font-weight: 800 !important;
                color: #ffffff !important;
                cursor: pointer !important;
                transition: all 0.25s ease !important;
                outline: none !important;
            }
            .wallet-popup-btn.success {
                background: linear-gradient(135deg, #22c55e, #16a34a) !important;
                box-shadow: 0 8px 20px rgba(34, 197, 94, 0.25) !important;
            }
            .wallet-popup-btn.success:hover {
                box-shadow: 0 12px 25px rgba(34, 197, 94, 0.35) !important;
                transform: translateY(-1.5px) !important;
            }
            .wallet-popup-btn.error {
                background: linear-gradient(135deg, #ef4444, #dc2626) !important;
                box-shadow: 0 8px 20px rgba(239, 68, 68, 0.25) !important;
            }
            .wallet-popup-btn.error:hover {
                box-shadow: 0 12px 25px rgba(239, 68, 68, 0.35) !important;
                transform: translateY(-1.5px) !important;
            }
            .wallet-popup-btn:active {
                transform: translateY(0.5px) !important;
            }

            @@keyframes popIconScale {
                0% { transform: scale(0.6); opacity: 0; }
                100% { transform: scale(1); opacity: 1; }
            }
        </style>

        <script>
            function dismissAlert(alertId) {
                var overlayEl = document.getElementById(alertId);
                if (overlayEl && overlayEl.classList.contains('show')) {
                    overlayEl.classList.remove('show');
                    setTimeout(function() {
                        overlayEl.style.display = 'none';
                    }, 400);
                }
            }

            document.addEventListener("DOMContentLoaded", function() {
                var successPopup = document.getElementById('walletSuccessAlert');
                var errorPopup = document.getElementById('walletErrorAlert');
                
                if (successPopup) {
                    successPopup.style.display = 'flex';
                    setTimeout(function() {
                        successPopup.classList.add('show');
                    }, 50);
                }
                
                if (errorPopup) {
                    errorPopup.style.display = 'flex';
                    setTimeout(function() {
                        errorPopup.classList.add('show');
                    }, 50);
                }

                // Tự động đóng sau 5 giây
                setTimeout(function() {
                    dismissAlert('walletSuccessAlert');
                    dismissAlert('walletErrorAlert');
                }, 5000);
            });
        </script>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- Left Column: Wallet Card + Top-up Form -->
            <div class="lg:col-span-1 flex flex-col gap-6">

                <!-- Wallet Hero Card -->
                <div class="wallet-hero">
                    <div class="relative z-10">
                        <div class="flex items-start justify-between mb-6">
                            <div class="wallet-status-badge">
                                <div class="wallet-status-dot"></div>
                                Đang hoạt động
                            </div>
                            <div style="opacity:0.5">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none">
                                    <rect x="2" y="6" width="20" height="14" rx="3" fill="rgba(255,255,255,0.2)"/>
                                    <path d="M16 13C16 13.5523 15.5523 14 15 14C14.4477 14 14 13.5523 14 13C14 12.4477 14.4477 12 15 12C15.5523 12 16 12.4477 16 13Z" fill="white"/>
                                    <path d="M2 10H22" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>
                                </svg>
                            </div>
                        </div>

                        <div>
                            <p class="wallet-balance-label">Số dư hiện tại</p>
                            <div class="wallet-balance-amount">
                                @string.Format("{0:N0}", Model.Balance)<span class="wallet-balance-currency">đ</span>
                            </div>
                        </div>

                        <div class="mt-6 pt-5 border-t border-white/15">
                            <p style="color:rgba(255,255,255,0.55); font-size:12px;">
                                💡 Dùng số dư để thanh toán đơn hàng nhanh hơn
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Top-up Form -->
                <div class="topup-form-wrapper">
                    <h5 style="font-size:17px;font-weight:700;color:#0f172a;margin-bottom:18px;">
                        <i class="hgi hgi-stroke hgi-add-circle mr-1" style="color:#2563eb"></i>
                        Nạp tiền vào số dư
                    </h5>

                    <div class="topup-presets" id="presetButtons">
                        @{
                            var presets = new[] { 50_000m, 100_000m, 200_000m, 500_000m, 1_000_000m, 2_000_000m };
                        }
                        @foreach (var preset in presets)
                        {
                            <button type="button" class="topup-preset-btn" data-value="@preset" onclick="selectPreset(this)">
                                @string.Format("{0:N0}đ", preset)
                            </button>
                        }
                    </div>

                    <form method="post" action="/my-wallet/topup" id="topupForm">
                        @Html.AntiForgeryToken()
                        <div class="topup-input-wrapper mb-3">
                            <!-- Input hiển thị định dạng phân cách hàng nghìn bằng dấu chấm -->
                            <input type="text" id="topupAmountText" placeholder="Nhập số tiền muốn nạp"
                                   oninput="formatAmountInput(this)"
                                   required autocomplete="off" />
                            <!-- Input ẩn thực tế để gửi giá trị số thuần túy về controller -->
                            <input type="hidden" id="topupAmount" name="amount" required />
                            <span class="topup-input-suffix">VNĐ</span>
                        </div>
                        <p style="font-size:12px;color:#94a3b8;margin-bottom:4px;">Tối thiểu: 10.000đ &nbsp;|&nbsp; Tối đa: 50.000.000đ</p>
                        <p style="font-size:12px;color:#94a3b8;margin-bottom:0;">Thanh toán qua cổng <strong>VNPAY</strong> an toàn, bảo mật.</p>
                        <button type="submit" class="topup-submit-btn" id="topupSubmitBtn">
                            <i class="hgi hgi-stroke hgi-bank-card" style="font-size:20px"></i>
                            Nạp tiền qua VNPAY
                        </button>
                    </form>
                </div>

                <!-- Info Box -->
                <div style="background:#f0f9ff;border:1.5px solid #bae6fd;border-radius:16px;padding:18px;">
                    <p style="font-size:13px;font-weight:700;color:#0369a1;margin-bottom:10px;">
                        ℹ️ Lưu ý về Số dư tài khoản
                    </p>
                    <ul style="font-size:12.5px;color:#0369a1;line-height:1.8;padding-left:16px;margin:0;">
                        <li>Số dư chỉ dùng để mua sắm tại website</li>
                        <li>Đơn hủy sẽ được hoàn tiền ngay vào số dư</li>
                        <li>Không hỗ trợ rút tiền mặt</li>
                        <li>Số dư không có thời hạn sử dụng</li>
                    </ul>
                </div>
            </div>

            <!-- Right Column: Attendance & Transaction History -->
            <div class="lg:col-span-2 flex flex-col gap-6">
                <!-- Premium Daily Attendance Card -->
                <div class="attendance-card" id="attendanceCard" style="display:none;">
                    <div class="flex flex-wrap items-center justify-between gap-4">
                        <div>
                            <span class="attendance-title-tag">⭐ Điểm Danh Nhận Xu</span>
                            <p class="text-sm text-white/90 mt-2 font-semibold">Tích luỹ xu thưởng mua sắm mỗi ngày!</p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-white/75 font-semibold uppercase tracking-wider">Chuỗi hiện tại</p>
                            <p class="text-2xl font-black text-white" id="attendanceStreak">0 ngày</p>
                        </div>
                    </div>

                    <!-- 7 Days Grid -->
                    <div class="attendance-grid" id="attendanceGrid">
                        <!-- JS Render daily boxes -->
                    </div>

                    <!-- Action Button -->
                    <button class="attendance-btn" id="attendanceClaimBtn" onclick="claimDailyAttendance()" disabled>
                        <span id="attendanceBtnText">💰 Đang tải dữ liệu điểm danh...</span>
                    </button>
                </div>

                <div style="background:#fff;border-radius:20px;border:1.5px solid #e2e8f0;padding:28px;box-shadow:0 4px 20px rgba(0,0,0,0.05); margin-top:0;">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;">
                        <h5 style="font-size:17px;font-weight:700;color:#0f172a;margin:0;">
                            <i class="hgi hgi-stroke hgi-time-02 mr-1" style="color:#7c3aed"></i>
                            Lịch sử giao dịch
                        </h5>
                        <span style="font-size:13px;color:#94a3b8;">@Model.TotalCount giao dịch</span>
                    </div>

                    @if (Model.Transactions.Count == 0)
                    {
                        <div style="text-align:center;padding:60px 20px;">
                            <div style="width:72px;height:72px;background:#f1f5f9;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                                <i class="hgi hgi-stroke hgi-transfer-horizontal" style="font-size:32px;color:#94a3b8"></i>
                            </div>
                            <p style="color:#64748b;font-size:15px;font-weight:500;">Chưa có giao dịch nào.</p>
                            <p style="color:#94a3b8;font-size:13px;">Hãy nạp tiền để bắt đầu!</p>
                        </div>
                    }
                    else
                    {
                        <div class="txn-list">
                            @foreach (var txn in Model.Transactions)
                            {
                                var isPositive = txn.Amount >= 0;
                                var amountPrefix = isPositive ? "+" : "-";
                                var colorClass = isPositive ? "txn-color-positive" : "txn-color-negative";
                                var bgClass = isPositive ? "txn-bg-positive" : "txn-bg-negative";
                                var amountColorClass = isPositive ? "txn-amount-positive" : "txn-amount-negative";

                                <div class="txn-item">
                                    <div class="txn-icon @bgClass">
                                        <i class="hgi hgi-stroke @GetTxnTypeIcon(txn.TransactionType) @colorClass"></i>
                                    </div>
                                    <div class="txn-info">
                                        <div class="txn-type">@GetTxnTypeLabel(txn.TransactionType)</div>
                                        @if (!string.IsNullOrWhiteSpace(txn.Description))
                                        {
                                            <div class="txn-ref" title="@txn.Description">@txn.Description</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(txn.ReferenceId))
                                        {
                                            <div class="txn-ref">Ref: @txn.ReferenceId</div>
                                        }
                                    </div>
                                    <div class="txn-meta">
                                        <div class="txn-amount @amountColorClass">@amountPrefix@FormatVnd(Math.Abs(txn.Amount))</div>
                                        <div class="txn-date">@txn.CreatedAt.ToLocalTime().ToString("HH:mm, dd/MM/yy")</div>
                                        <div class="txn-balance-after">Số dư: @FormatVnd(txn.BalanceAfter)</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="wallet-pagination">
                                @if (Model.Page > 1)
                                {
                                    <a href="?page=@(Model.Page - 1)">&#8249;</a>
                                }
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    if (p == Model.Page)
                                    {
                                        <span class="active-page">@p</span>
                                    }
                                    else if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.Page) <= 2)
                                    {
                                        <a href="?page=@p">@p</a>
                                    }
                                    else if (Math.Abs(p - Model.Page) == 3)
                                    {
                                        <span style="border:none;color:#94a3b8;">…</span>
                                    }
                                }
                                @if (Model.Page < Model.TotalPages)
                                {
                                    <a href="?page=@(Model.Page + 1)">&#8250;</a>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
// Định dạng chuỗi số nguyên thành dạng có dấu chấm phân cách hàng nghìn (VD: 50000 -> 50.000)
function formatNumberWithDots(val) {
    if (!val) return '';
    return new Intl.NumberFormat('vi-VN').format(val);
}

// Xử lý định dạng khi người dùng tự gõ vào input
function formatAmountInput(input) {
    // Chỉ giữ lại các chữ số
    let cleanVal = input.value.replace(/[^0-9]/g, '');
    
    if (!cleanVal) {
        input.value = '';
        document.getElementById('topupAmount').value = '';
        onAmountInput();
        return;
    }
    
    let numVal = parseInt(cleanVal, 10);
    
    // Lưu giá trị số thuần túy vào input ẩn để gửi đi
    document.getElementById('topupAmount').value = numVal;
    
    // Hiển thị giá trị đã định dạng bằng dấu chấm vào input text
    input.value = formatNumberWithDots(numVal);
    
    // Đồng bộ trạng thái active của các nút Preset
    onAmountInput();
}

function selectPreset(btn) {
    document.querySelectorAll('.topup-preset-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    
    let presetVal = parseInt(btn.getAttribute('data-value'), 10);
    
    // Cập nhật cả input ẩn và input hiển thị đã được định dạng dấu chấm
    document.getElementById('topupAmount').value = presetVal;
    document.getElementById('topupAmountText').value = formatNumberWithDots(presetVal);
}

function onAmountInput() {
    document.querySelectorAll('.topup-preset-btn').forEach(b => b.classList.remove('active'));
    const val = parseInt(document.getElementById('topupAmount').value, 10) || 0;
    
    document.querySelectorAll('.topup-preset-btn').forEach(b => {
        if (parseInt(b.getAttribute('data-value'), 10) === val) {
            b.classList.add('active');
        }
    });
}

// Kiểm tra form trước khi gửi đi
document.getElementById('topupForm').addEventListener('submit', function(e) {
    const amt = parseInt(document.getElementById('topupAmount').value, 10) || 0;
    if (!amt || amt < 10000) {
        e.preventDefault();
        alert('Vui lòng nhập số tiền tối thiểu 10.000đ');
        return;
    }
    if (amt > 50000000) {
        e.preventDefault();
        alert('Số tiền tối đa là 50.000.000đ');
        return;
    }
    document.getElementById('topupSubmitBtn').disabled = true;
    document.getElementById('topupSubmitBtn').innerHTML = '<i class="hgi hgi-stroke hgi-loading-02" style="font-size:18px;animation:spin 1s linear infinite"></i> Đang chuyển hướng...';
});

// ─── Xử lý Điểm Danh Nhận Xu Hàng Ngày ───
document.addEventListener('DOMContentLoaded', function() {
    loadAttendanceData();
});

async function loadAttendanceData() {
    const card = document.getElementById('attendanceCard');
    const grid = document.getElementById('attendanceGrid');
    const streakEl = document.getElementById('attendanceStreak');
    const claimBtn = document.getElementById('attendanceClaimBtn');
    const btnText = document.getElementById('attendanceBtnText');

    try {
        const res = await fetch('/my-wallet/attendance');
        if (!res.ok) {
            card.style.display = 'none';
            return;
        }
        const state = await res.json();
        
        card.style.display = 'block';
        streakEl.textContent = `${state.streakCount} ngày`;
        
        grid.innerHTML = '';
        state.dailyRewards.forEach(item => {
            const box = document.createElement('div');
            box.className = `attendance-day-box ${item.status}`;
            
            if (item.status === 'claimable') {
                box.onclick = claimDailyAttendance;
            }
            
            const dayLabel = document.createElement('span');
            dayLabel.className = 'text-[11px] font-bold text-gray-500 uppercase';
            dayLabel.textContent = item.dayNumber === 7 ? 'Ngày 7' : `Ngày ${item.dayNumber}`;
            box.appendChild(dayLabel);
            
            const coinIcon = document.createElement('span');
            coinIcon.className = 'attendance-coin-icon';
            if (item.status === 'claimed') {
                coinIcon.innerHTML = '✔️';
                coinIcon.style.color = '#ff5722';
            } else if (item.dayNumber === 7) {
                coinIcon.innerHTML = '🎁'; 
            } else {
                coinIcon.innerHTML = '🟡';
            }
            box.appendChild(coinIcon);
            
            const rewardLabel = document.createElement('span');
            rewardLabel.className = 'text-[12px] font-black text-gray-800';
            rewardLabel.textContent = `+${item.rewardFormatted}`;
            box.appendChild(rewardLabel);
            
            if (item.dayNumber === 7) {
                const bonus = document.createElement('span');
                bonus.className = 'bonus-tag';
                bonus.textContent = 'XU KHỦNG';
                box.appendChild(bonus);
            }
            
            grid.appendChild(box);
        });
        
        if (state.hasCheckedInToday) {
            claimBtn.disabled = true;
            btnText.innerHTML = '🎉 Đã điểm danh hôm nay! Hẹn gặp lại ngày mai';
        } else {
            claimBtn.disabled = false;
            btnText.innerHTML = `🌟 Điểm danh nhận ngay +${state.nextRewardFormatted}đ hôm nay!`;
        }
        
    } catch (err) {
        console.error('Lỗi khi tải dữ liệu điểm danh:', err);
        card.style.display = 'none';
    }
}

async function claimDailyAttendance() {
    const claimBtn = document.getElementById('attendanceClaimBtn');
    const btnText = document.getElementById('attendanceBtnText');
    
    claimBtn.disabled = true;
    btnText.innerHTML = '<i class="hgi hgi-stroke hgi-loading-02" style="font-size:18px;animation:spin 1s linear infinite"></i> Đang điểm danh nhận xu...';
    
    try {
        const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        const headers = { 'Content-Type': 'application/json' };
        if (tokenEl) {
            headers['RequestVerificationToken'] = tokenEl.value;
        }

        const res = await fetch('/my-wallet/attendance/claim', {
            method: 'POST',
            headers: headers
        });
        
        const data = await res.json();
        if (!res.ok) {
            alert(data.message || 'Điểm danh thất bại. Vui lòng thử lại sau.');
            await loadAttendanceData();
            return;
        }
        
        showCelebrationPopup(data.rewardFormatted);
        await loadAttendanceData();
        await updateWalletHeroBalance();
        
    } catch (err) {
        console.error('Lỗi khi điểm danh:', err);
        alert('Có lỗi xảy ra. Vui lòng thử lại sau.');
        claimBtn.disabled = false;
    }
}

async function updateWalletHeroBalance() {
    try {
        const res = await fetch('/my-wallet/balance');
        if (res.ok) {
            const data = await res.json();
            const balanceEl = document.querySelector('.wallet-balance-amount');
            if (balanceEl) {
                balanceEl.innerHTML = `${data.balanceFormatted}<span class="wallet-balance-currency">đ</span>`;
            }
        }
    } catch (err) {
        console.error('Lỗi khi cập nhật số dư ví:', err);
    }
}

function showCelebrationPopup(rewardFormatted) {
    const overlay = document.createElement('div');
    overlay.style.position = 'fixed';
    overlay.style.top = '0';
    overlay.style.left = '0';
    overlay.style.width = '100vw';
    overlay.style.height = '100vh';
    overlay.style.backgroundColor = 'rgba(15, 23, 42, 0.75)';
    overlay.style.backdropFilter = 'blur(8px)';
    overlay.style.zIndex = '99999';
    overlay.style.display = 'flex';
    overlay.style.alignItems = 'center';
    overlay.style.justifyContent = 'center';
    overlay.style.transition = 'opacity 0.3s ease';
    
    const content = document.createElement('div');
    content.style.background = 'linear-gradient(135deg, #ffffff 0%, #fff8f5 100%)';
    content.style.padding = '40px 32px';
    content.style.borderRadius = '32px';
    content.style.textAlign = 'center';
    content.style.maxWidth = '400px';
    content.style.width = '90%';
    content.style.boxShadow = '0 25px 50px -12px rgba(255, 87, 34, 0.4)';
    content.style.transform = 'scale(0.8)';
    content.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
    
    content.innerHTML = `
        <div style="font-size: 72px; margin-bottom: 16px; animation: bounce 1s infinite alternate;">🎉</div>
        <h3 style="font-size: 24px; font-weight: 850; color: #ff5722; margin-bottom: 8px;">ĐIỂM DANH THÀNH CÔNG!</h3>
        <p style="font-size: 15px; color: #475569; margin-bottom: 24px; font-weight: 500;">Bạn đã nhận được phần quà xu thưởng trị giá:</p>
        <div style="font-size: 42px; font-weight: 900; color: #ff5722; margin-bottom: 24px; letter-spacing: -0.02em;">
            +${rewardFormatted}đ
        </div>
        <button id="closeCelebrationBtn" style="width: 100%; padding: 14px; background: linear-gradient(135deg, #ff9800, #ff5722); color: white; border: none; border-radius: 16px; font-size: 16px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 15px rgba(255, 87, 34, 0.3);">
            Tuyệt vời! Nhận ngay
        </button>
    `;
    
    overlay.appendChild(content);
    document.body.appendChild(overlay);
    
    setTimeout(() => {
        content.style.transform = 'scale(1)';
    }, 10);
    
    const closePopup = () => {
        overlay.style.opacity = '0';
        content.style.transform = 'scale(0.8)';
        setTimeout(() => {
            document.body.removeChild(overlay);
        }, 300);
    };
    
    document.getElementById('closeCelebrationBtn').onclick = closePopup;
}
</script>

<style>
@@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>
